{"_id": "Academic--research_data--n--69345", "text": "{\n    \"dataset_name\": \"Global Forest Cover\",\n    \"creator\": {\n        \"name\": \"Forestry Research Institute\",\n        \"affiliation\": \"Global Environmental Agency\"\n    },\n    \"date_collected\": \"2022-12-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Forest Area\",\n            \"units\": \"km²\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/km²\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC-4.0\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deforestation Rates Worldwide\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_cover.csv\",\n    \"metadata\": {\n        \"data_size\": \"2.5 MB\",\n        \"annotations\": \"Derived from Landsat imagery.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69346", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the Twenty-First Century\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Temperature anomalies relative to a baseline period\"\n    }\n}"}
