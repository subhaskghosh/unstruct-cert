{"_id": "Academic--research_data--p--71760", "text": "{\n    \"dataset_name\": \"Atmospheric CO2 Measurements in Arctic Region\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Alaska Fairbanks\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration (ppm)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature (°C)\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Altitude (m)\",\n            \"units\": \"m\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring with automated sensors\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Arctic Warming on CO2 Levels\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Johnson, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/arctic_co2_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"32.5MB\",\n        \"annotations\": \"Data is quality controlled and includes metadata for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71760", "text": "{\n    \"dataset_name\": \"Global Ocean Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"Oceanographic Data Center\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature Anomaly (°C)\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Ocean Depth (m)\",\n            \"units\": \"m\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Satellite and buoy measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in Ocean Warming\",\n            \"authors\": [\n                \"Smith, R.\",\n                \"Jones, P.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_temp_anomalies.nc\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Raw data with minimal processing.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71761", "text": "{\n    \"dataset_name\": \"National River Water Quality Database\",\n    \"creator\": {\n        \"name\": \"US Geological Survey\",\n        \"affiliation\": \"US Department of the Interior\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"unit\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"unit\": \"standard units\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Regular monitoring stations along major US rivers.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Water Quality in the United States\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://www.usgs.gov/data/national-river-water-quality-database\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Includes quality control flags and metadata on sampling locations.\"\n    }\n}"}
