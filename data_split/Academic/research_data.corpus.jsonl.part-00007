{"_id": "Academic--research_data--n--67350", "text": "{\n    \"dataset_name\": \"Rural Ecosystem Carbon Flux\",\n    \"creator\": {\n        \"name\": \"National Forest Service\",\n        \"affiliation\": \"Ecology Research Division\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Flux\",\n            \"units\": \"µmol/m²/s\"\n        },\n        {\n            \"name\": \"Soil Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Eddy covariance measurements in forested areas\",\n    \"related_publications\": [\n        {\n            \"title\": \"Carbon Sequestration in National Forests\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://forestdata.gov/carbonflux.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data represents net ecosystem exchange.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67351", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis (GSTA)\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"Latitude\",\n            \"units\": \"Degrees North\"\n        },\n        {\n            \"variable_name\": \"Longitude\",\n            \"units\": \"Degrees East\"\n        },\n        {\n            \"variable_name\": \"Altitude\",\n            \"units\": \"Meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global gridded data, station data blended\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the 21st Century: An Imperative to Change Course\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/gsta_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"High-resolution temperature data\"\n    }\n}"}
{"_id": "Academic--research_data--n--67351", "text": "{\n    \"dataset_name\": \"Local Rainfall Data - UK\",\n    \"creator\": {\n        \"name\": \"Met Office\",\n        \"affiliation\": \"UK Government\"\n    },\n    \"date_collected\": \"2019-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Rainfall Amount\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Open Government License\",\n    \"sampling_method\": \"Automated weather stations\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/uk_rainfall.json\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Rainfall data for UK weather stations\"\n    }\n}"}
{"_id": "Academic--research_data--p--67352", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Imperial College London Environmental Research Group\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Concentration of particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in parts per billion.\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Concentration of nitrogen dioxide.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations with hourly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data has been quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67352", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey - Amazon\",\n    \"creator\": {\n        \"name\": \"National Institute of Amazonian Research\",\n        \"affiliation\": \"INPA\"\n    },\n    \"date_collected\": \"2022-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Species\",\n            \"units\": \"N/A\",\n            \"description\": \"Identified tree species in the survey area.\"\n        },\n        {\n            \"name\": \"Tree Diameter\",\n            \"units\": \"cm\",\n            \"description\": \"Diameter of trees at breast height.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random plot sampling in designated forest areas\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in the Amazon Rainforest\",\n            \"authors\": [\n                \"Silva, M.\",\n                \"Oliveira, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"850 MB\",\n        \"annotations\": \"Species identification was confirmed by expert botanists.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67353", "text": "{\n    \"dataset_name\": \"Air Quality in Urban Environments\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Fine particulate matter concentration\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppm\",\n            \"description\": \"Nitrogen Dioxide concentration, a common pollutant from vehicle emissions\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality_berkeley.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data cleaned and validated against EPA standards\"\n    }\n}"}
{"_id": "Academic--research_data--n--67353", "text": "{\n    \"dataset_name\": \"Plant Biodiversity in Amazon Rainforest\",\n    \"creator\": {\n        \"name\": \"Dr. Ricardo Silva\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2023-08-20T14:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\",\n            \"description\": \"Number of plant species observed in a plot\"\n        },\n        {\n            \"name\": \"Canopy Height\",\n            \"units\": \"meters\",\n            \"description\": \"Average height of the forest canopy\"\n        },\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"m²/m²\",\n            \"description\": \"Total leaf area per unit ground area\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Randomly selected forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment of the Amazon Basin\",\n            \"year\": 2025\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Species identification verified by expert botanists\"\n    }\n}"}
{"_id": "Academic--research_data--p--67354", "text": "{\n    \"dataset_name\": \"Brain Tumor MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Massachusetts General Hospital\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image ID\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"Patient Age\",\n            \"unit\": \"years\"\n        },\n        {\n            \"name\": \"Tumor Size\",\n            \"unit\": \"mm^3\"\n        },\n        {\n            \"name\": \"Tumor Location\",\n            \"unit\": \"anatomical region\"\n        },\n        {\n            \"name\": \"MRI Sequence\",\n            \"unit\": \"type of scan\"\n        },\n        {\n            \"name\": \"Contrast Enhancement\",\n            \"unit\": \"boolean\"\n        },\n        {\n            \"name\": \"Peritumoral Edema\",\n            \"unit\": \"boolean\"\n        },\n        {\n            \"name\": \"Tumor Grade\",\n            \"unit\": \"WHO grade\"\n        },\n        {\n            \"name\": \"Ki-67 Index\",\n            \"unit\": \"percentage\"\n        },\n        {\n            \"name\": \"Isocitrate Dehydrogenase Mutation Status\",\n            \"unit\": \"boolean\"\n        },\n        {\n            \"name\": \"IDH1 Mutation Status\",\n            \"unit\": \"boolean\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Prospective cohort study\",\n    \"related_publications\": [\n        {\n            \"title\": \"MRI-based Radiomics for Brain Tumor Grading\",\n            \"authors\": \"Carter et al.\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_tumor_mri\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Expert radiologist annotations provided.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67354", "text": "{\n    \"dataset_name\": \"Chest X-ray Pneumonia Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-05-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image ID\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"Patient Age\",\n            \"unit\": \"years\"\n        },\n        {\n            \"name\": \"Pneumonia Diagnosis\",\n            \"unit\": \"boolean\"\n        },\n        {\n            \"name\": \"Laterality\",\n            \"unit\": \"left/right/bilateral\"\n        },\n        {\n            \"name\": \"Image Quality\",\n            \"unit\": \"scale of 1-5\"\n        }\n    ],\n    \"data_format\": \"JPEG\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Retrospective analysis of hospital records\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Pneumonia Detection in Chest X-rays\",\n            \"authors\": \"Lee et al.\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray_pneumonia\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Automated diagnosis labels.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67355", "text": "{\n    \"dataset_name\": \"Coastal Climate Change Impact Assessment\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Oceanographic Institute\"\n    },\n    \"date_collected\": \"2022-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Level\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Buoy Measurements and Satellite Data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Rising Sea Levels on Coastal Ecosystems\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67355", "text": "{\n    \"dataset_name\": \"Global Temperature Records\",\n    \"creator\": {\n        \"name\": \"Global Historical Climatology Network\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2018-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Average Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Restricted - requires request\",\n    \"sampling_method\": \"Ground Station Measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Global Temperature Trends\",\n            \"authors\": [\n                \"Jones, P.\",\n                \"Smith, R.\"\n            ]\n        }\n    ],\n    \"download_url\": null,\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data quality assessed using standard methods.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67356", "text": "{\n    \"dataset_name\": \"Freshwater Lake Monitoring Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Environmental Sciences\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly from various lake locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on Freshwater Lake Ecosystems\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/freshwater_lake_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"2.5MB\",\n        \"annotations\": \"Data includes quality control flags for each variable.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67356", "text": "{\n    \"dataset_name\": \"Atmospheric Pollution in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Dr. David Chen\",\n        \"affiliation\": \"City Institute of Public Health\"\n    },\n    \"date_collected\": \"2022-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Continuous monitoring using air quality sensors.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Pollution and Respiratory Health in Metropolitan Cities\",\n            \"authors\": [\n                \"Chen, D.\",\n                \"Garcia, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_pollution_data.json\",\n    \"metadata\": {\n        \"data_size\": \"1.8MB\",\n        \"annotations\": \"Data is preprocessed and includes missing value imputation.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67357", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring Dataset\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency Research Team\",\n        \"affiliation\": \"US EPA\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations across major cities\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Quality on Public Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/airqualitydata.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data is quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67357", "text": "{\n    \"dataset_name\": \"Historical Temperature Records\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2018-12-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Average Temperature\",\n            \"units\": \"°F\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Global weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Climate Trends\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/temperaturedata.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes temperature readings from 1880 to 2020.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67358", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"units\": \"percent\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"units\": \"year\"\n        },\n        {\n            \"name\": \"gain\",\n            \"units\": \"percent\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote sensing data from Landsat satellites\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2012\",\n            \"authors\": \"Hansen et al.\",\n            \"year\": 2013\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/users/UMD/fc2020\",\n    \"metadata\": {\n        \"data_size\": \"500GB\",\n        \"annotations\": \"Dataset includes annual tree cover loss and gain from 2000-2020.\"\n    }\n}"}
