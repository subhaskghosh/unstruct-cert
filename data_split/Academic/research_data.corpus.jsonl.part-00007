{"_id": "Academic--research_data--p--71014", "text": "{\n    \"dataset_name\": \"Arctic Sea Ice Extent and Thickness\",\n    \"creator\": {\n        \"name\": \"National Snow and Ice Data Center (NSIDC)\",\n        \"affiliation\": \"University of Colorado Boulder\"\n    },\n    \"date_collected\": \"2023-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Ice Extent\",\n            \"units\": \"square kilometers\"\n        },\n        {\n            \"name\": \"Sea Ice Thickness\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Ice Age\",\n            \"units\": \"days\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite observations (ICESat-2, CryoSat-2) combined with model data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Recent changes in Arctic sea ice extent and thickness\",\n            \"authors\": [\n                \"Meier\",\n                \"Stroeve\",\n                \"Fassnacht\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://nsidc.org/data/seaice/arctic_sea_ice_extent_thickness\",\n    \"metadata\": {\n        \"data_size\": \"15 GB\",\n        \"annotations\": \"Data quality flags included; spatial resolution 25km x 25km\"\n    }\n}"}
