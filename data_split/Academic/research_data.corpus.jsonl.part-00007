{"_id": "Academic--research_data--p--68301", "text": "{\n    \"dataset_name\": \"Twitter US Political Sentiment 2024\",\n    \"creator\": {\n        \"name\": \"Center for Public Opinion Research\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2024-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"tweet_id\",\n            \"description\": \"Unique identifier for each tweet.\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"variable_name\": \"text\",\n            \"description\": \"Full text of the tweet.\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"variable_name\": \"sentiment_score\",\n            \"description\": \"Sentiment score ranging from -1 (negative) to 1 (positive).\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"variable_name\": \"topic\",\n            \"description\": \"Primary political topic discussed in the tweet (e.g., economy, healthcare).\",\n            \"units\": \"N/A\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Random sampling of public tweets using the Twitter API.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Analyzing Public Sentiment Towards Political Candidates on Twitter\",\n            \"authors\": [\n                \"Jane Doe\",\n                \"John Smith\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/twitter_sentiment_2024.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Sentiment scores were generated using a pre-trained BERT model.\"\n    }\n}"}
