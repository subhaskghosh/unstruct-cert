{"_id": "Academic--research_data--p--70134", "text": "{\n    \"dataset_name\": \"Atmospheric Composition and Cloud Data - ACE\",\n    \"creator\": {\n        \"name\": \"Environment Canada\",\n        \"affiliation\": \"Canadian Department of Environment and Climate Change\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Aerosol Optical Depth\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Cloud Fraction\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Kelvin\"\n        },\n        {\n            \"name\": \"Pressure\",\n            \"units\": \"Pa\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"Ground-based remote sensing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Characterizing aerosol properties using ground-based measurements\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ace_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--70134", "text": "{\n    \"dataset_name\": \"Soil Moisture Measurements - Global\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Space Flight Center\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-05-20T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"m3/m3\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Soil Type\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"Satellite remote sensing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global soil moisture estimation from satellite data\",\n            \"authors\": [\n                \"Brown, R.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/soil_moisture_data.json\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data is gridded and interpolated.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70135", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"United States Department of Commerce\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global weather stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Trends\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--70135", "text": "{\n    \"dataset_name\": \"Historical Crop Yields\",\n    \"creator\": {\n        \"name\": \"Food and Agriculture Organization (FAO)\",\n        \"affiliation\": \"United Nations\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"wheat_yield\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"corn_yield\",\n            \"units\": \"tons/hectare\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC-SA 3.0 IGO\",\n    \"sampling_method\": \"National agricultural surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Food Security\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/crop_yields.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Yield data for major crops\"\n    }\n}"}
{"_id": "Academic--research_data--p--70136", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Department\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London 2023\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data validated against EU standards\"\n    }\n}"}
{"_id": "Academic--research_data--n--70136", "text": "{\n    \"dataset_name\": \"Rural Forest Ecosystem Data - Scotland\",\n    \"creator\": {\n        \"name\": \"Scottish Environmental Protection Agency\",\n        \"affiliation\": \"Forestry Research Division\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"Biodiversity Index\",\n            \"units\": \"Shannon Index\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Forest Health Assessment in Scotland\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, K.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/scotland_forest_data.xml\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes tree species identification\"\n    }\n}"}
{"_id": "Academic--research_data--p--70137", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"University of Maryland, Google\",\n        \"affiliation\": \"Global Forest Watch\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"unit\": \"percentage\"\n        },\n        {\n            \"name\": \"gain\",\n            \"unit\": \"hectares\"\n        },\n        {\n            \"name\": \"loss\",\n            \"unit\": \"hectares\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Landsat satellite imagery\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2012\",\n            \"authors\": \"Hansen, M. C., et al.\",\n            \"year\": 2013\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/UMD/HANSEN_GLOBAL_FOREST_CHANGE_2023_V1_8\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Provides annual tree cover loss and gain data.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70137", "text": "{\n    \"dataset_name\": \"Aerosol Optical Depth (AOD)\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Space Flight Center\",\n        \"affiliation\": \"Earth Science Data and Information System (ESDIS)\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"AOD\",\n            \"unit\": \"dimensionless\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"unit\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"MODIS satellite sensor\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global aerosol data set from MODIS\",\n            \"authors\": \"Levy, R. C., et al.\",\n            \"year\": 2007\n        }\n    ],\n    \"download_url\": \"https://earthdata.nasa.gov/data/aerosol-optical-depth\",\n    \"metadata\": {\n        \"data_size\": \"200 MB\",\n        \"annotations\": \"AOD measurements from MODIS sensors.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70138", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"Degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"Degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the Twenty-First Century\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data includes monthly averages and anomalies.\"\n    }\n}"}
