{"_id": "Academic--research_data--p--70918", "text": "{\n    \"dataset_name\": \"Rare Disease Retinal Image Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Eye Institute\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_width\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"name\": \"image_height\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"name\": \"diagnosis\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"TIFF\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Prospective clinical study of patients with rare retinal diseases.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Retinal Imaging in Rare Genetic Disorders\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/raredisease_retinal_images.zip\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Expert-verified diagnoses provided.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70918", "text": "{\n    \"dataset_name\": \"Common Cold X-Ray Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. John Smith\",\n        \"affiliation\": \"Local Hospital\"\n    },\n    \"date_collected\": \"2023-11-20T14:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"patient_age\",\n            \"units\": \"years\"\n        },\n        {\n            \"name\": \"xray_quality\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"PNG\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Routine chest X-rays for patients presenting with cold symptoms.\",\n    \"related_publications\": [\n        {\n            \"title\": \"X-Ray Findings in Common Respiratory Illnesses\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/common_cold_xrays.zip\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Automated diagnosis based on image analysis.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70919", "text": "{\n    \"dataset_name\": \"River Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US EPA\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly from 20 river locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Assessing Water Quality in Major US Rivers\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
