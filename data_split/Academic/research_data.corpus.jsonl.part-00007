{"_id": "Academic--research_data--p--67669", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset with Biomass Estimates\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"biomass\",\n            \"units\": \"Mg/ha\"\n        },\n        {\n            \"name\": \"gain\",\n            \"units\": \"area\"\n        },\n        {\n            \"name\": \"loss\",\n            \"units\": \"area\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote sensing data processed with algorithms to detect forest change\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2012\",\n            \"authors\": [\n                \"Matthew Hansen\",\n                \"Peter Potapov\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://developers.google.com/earth-engine/datasets/catalog/UMD_HANSEN_GLOBAL_FOREST_CHANGE_2021_V1_8\",\n    \"metadata\": {\n        \"data_size\": \"500 GB\",\n        \"annotations\": \"Includes data on forest loss, gain, and biomass changes. Processed from Landsat imagery.\"\n    }\n}"}
