{"_id": "Academic--research_data--p--71515", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2024\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University College London\"\n    },\n    \"date_collected\": \"2024-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\",\n            \"description\": \"Concentration of Ozone in the air\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\",\n            \"description\": \"Air temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban Environments\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Jones, P.\"\n            ],\n            \"year\": 2024,\n            \"journal\": \"Environmental Science & Technology\"\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71515", "text": "{\n    \"dataset_name\": \"Rural Soil Composition - Scotland 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Alistair McGregor\",\n        \"affiliation\": \"University of Edinburgh\"\n    },\n    \"date_collected\": \"2023-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"unit\": \"unitless\",\n            \"description\": \"Soil pH level\"\n        },\n        {\n            \"name\": \"Nitrogen\",\n            \"unit\": \"mg/kg\",\n            \"description\": \"Nitrogen content in soil\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Random sampling across rural areas\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/scottish_soil.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Limited metadata available\"\n    }\n}"}
{"_id": "Academic--research_data--p--71516", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Science Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations with hourly readings\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urbanization on Air Quality\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data includes quality control flags and metadata about station locations.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71516", "text": "{\n    \"dataset_name\": \"Soil Composition Analysis\",\n    \"creator\": {\n        \"name\": \"Agricultural Research Center\",\n        \"affiliation\": \"State University\"\n    },\n    \"date_collected\": \"2022-12-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Nitrogen\",\n            \"units\": \"mg/kg\"\n        },\n        {\n            \"name\": \"Phosphorus\",\n            \"units\": \"mg/kg\"\n        },\n        {\n            \"name\": \"Potassium\",\n            \"units\": \"mg/kg\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random soil samples collected from agricultural fields\",\n    \"related_publications\": [\n        {\n            \"title\": \"Soil Fertility and Crop Yield\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/soil_data.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data includes geographical coordinates of sampling locations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71517", "text": "{\n    \"dataset_name\": \"Global Air Quality Monitoring - 2023\",\n    \"creator\": {\n        \"name\": \"National Center for Atmospheric Research (NCAR)\",\n        \"affiliation\": \"University Corporation for Atmospheric Research\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations across major cities\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Trends in Air Pollution\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"8.2MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
