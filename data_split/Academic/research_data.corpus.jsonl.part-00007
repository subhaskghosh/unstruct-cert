{"_id": "Academic--research_data--n--70037", "text": "{\n    \"dataset_name\": \"Marine Ecosystem Survey - 2023\",\n    \"creator\": {\n        \"name\": \"Dr. James Wilson\",\n        \"affiliation\": \"Oceanographic Institute\"\n    },\n    \"date_collected\": \"2023-05-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Research vessel transects\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coral Reef Health Assessment\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/marine_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Geolocation data provided\"\n    }\n}"}
{"_id": "Academic--research_data--p--70038", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2020-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of weather stations, satellite observations, and sea surface temperature measurements. Data is quality controlled and gridded to a 0.25-degree resolution.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Includes uncertainty estimates\"\n    }\n}"}
{"_id": "Academic--research_data--n--70038", "text": "{\n    \"dataset_name\": \"Coral Reef Biodiversity\",\n    \"creator\": {\n        \"name\": \"Australian Institute of Marine Science\",\n        \"affiliation\": \"AIMS\"\n    },\n    \"date_collected\": \"2017-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Coral Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Fish Abundance\",\n            \"units\": \"individuals/m^2\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Visual surveys conducted by scuba divers at designated reef sites.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coral Reef Health Assessment\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://aims.gov.au/reef-data\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data includes metadata on reef location and survey conditions.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70039", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"units\": \"percent\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"units\": \"year\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote sensing data from Landsat satellites\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2012\",\n            \"authors\": [\n                \"Hansen\",\n                \"Potapov\",\n                \"Moore\",\n                \"Hurlbert\",\n                \"Carroll\",\n                \"De Alban\",\n                \"Tyukavina\",\n                \"Baccini\",\n                \"Chapin\",\n                \"Petrov\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://glad.umd.edu/data/globalforestchange\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes tree cover, forest loss, and gain.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70039", "text": "{\n    \"dataset_name\": \"Air Quality Measurements in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2022-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"ozone\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"pm25\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Air Quality\",\n            \"authors\": [\n                \"Smith\",\n                \"Jones\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.epa.gov/airdata\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Hourly measurements of common air pollutants.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70040", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-11-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"wind_speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"solar_radiation\",\n            \"units\": \"W/m^2\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global weather stations and satellite observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Global Temperature\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data is quality controlled and gap-filled.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70040", "text": "{\n    \"dataset_name\": \"Local Bird Migration Patterns\",\n    \"creator\": {\n        \"name\": \"Ornithological Society of America\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2019-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"bird_species\",\n            \"units\": \"species name\"\n        },\n        {\n            \"name\": \"migration_date\",\n            \"units\": \"YYYY-MM-DD\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Citizen science observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Bird Migration in California\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/bird_migration.json\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data submitted by amateur birdwatchers.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70041", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Environments\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Fine particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in parts per billion.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature in Celsius.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations with hourly measurements.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data quality flags are included.\"\n    }\n}"}
