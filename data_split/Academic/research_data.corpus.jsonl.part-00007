{"_id": "Academic--research_data--p--66221", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"Latitude\",\n            \"units\": \"Degrees North\"\n        },\n        {\n            \"variable_name\": \"Longitude\",\n            \"units\": \"Degrees East\"\n        },\n        {\n            \"variable_name\": \"Altitude\",\n            \"units\": \"Meters\"\n        },\n        {\n            \"variable_name\": \"Year\",\n            \"units\": \"Year\"\n        },\n        {\n            \"variable_name\": \"Month\",\n            \"units\": \"Month\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global grid sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"authors\": [\n                \"Hansen et al.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temperature.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Contains monthly average temperatures\"\n    }\n}"}
