{"_id": "Academic--research_data--n--69091", "text": "{\n    \"dataset_name\": \"Ocean Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute\",\n        \"affiliation\": \"Coastal Research Center\"\n    },\n    \"date_collected\": \"2019-12-20T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees West\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Satellite remote sensing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Warming and Climate Change\",\n            \"authors\": [\n                \"Brown, C.\",\n                \"Davis, D.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_temp.csv\",\n    \"metadata\": {\n        \"data_size\": \"800 MB\",\n        \"annotations\": \"Data interpolated from raw satellite readings\"\n    }\n}"}
