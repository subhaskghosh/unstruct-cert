{"_id": "Academic--research_data--n--69375", "text": "{\n    \"dataset_name\": \"WeatherPatterns_California_2024\",\n    \"creator\": {\n        \"name\": \"California Climate Institute\",\n        \"affiliation\": \"University of California\"\n    },\n    \"date_collected\": \"2024-05-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"inches\"\n        },\n        {\n            \"name\": \"wind_speed\",\n            \"units\": \"mph\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Automated weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"California Weather Patterns 2024\",\n            \"authors\": [\n                \"Alice Johnson\",\n                \"Bob Williams\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ca_weather_2024.csv\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data includes daily average temperatures and precipitation amounts.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69376", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Anomaly\",\n            \"units\": \"Degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature in 2023\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Contains annual and monthly temperature anomalies.\"\n    }\n}"}
