{"_id": "Academic--research_data--p--71006", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Dataset\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"Department of Earth and Planetary Science\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"average_temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"total_precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Global weather station network\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Global Temperature and Precipitation\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71006", "text": "{\n    \"dataset_name\": \"Historical Climate Reconstructions\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"Paleoclimate Program\"\n    },\n    \"date_collected\": \"2018-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"sea_surface_temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"ice_core_data\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Paleoclimate proxy records\",\n    \"related_publications\": [\n        {\n            \"title\": \"Reconstructing Past Climates\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/paleoclimate.nc\",\n    \"metadata\": {\n        \"data_size\": \"1.2GB\",\n        \"annotations\": \"Uncertainty estimates provided\"\n    }\n}"}
{"_id": "Academic--research_data--p--71007", "text": "{\n    \"dataset_name\": \"Global Atmospheric Composition Dataset\",\n    \"creator\": {\n        \"name\": \"National Center for Atmospheric Research (NCAR)\",\n        \"affiliation\": \"UCAR\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Dioxide Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"DU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations globally\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Trends in Atmospheric Composition\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/atmospheric_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--71007", "text": "{\n    \"dataset_name\": \"Arctic Ice Core Data\",\n    \"creator\": {\n        \"name\": \"British Antarctic Survey\",\n        \"affiliation\": \"NERC\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Deuterium Isotope Ratio\",\n            \"units\": \"permil\"\n        },\n        {\n            \"name\": \"Oxygen-18 Isotope Ratio\",\n            \"units\": \"permil\"\n        },\n        {\n            \"name\": \"Ice Layer Age\",\n            \"units\": \"Years BP\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Ice core drilling and analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Paleoclimate Reconstruction from Arctic Ice Cores\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/arctic_ice_cores.json\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data calibrated against international standards\"\n    }\n}"}
{"_id": "Academic--research_data--p--71008", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - Boston 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/boston_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"75MB\",\n        \"annotations\": \"Detailed documentation on sensor calibration and data processing available at https://example.com/documentation\"\n    }\n}"}
{"_id": "Academic--research_data--n--71008", "text": "{\n    \"dataset_name\": \"Global Forest Change 2020\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2021-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Cover Loss\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Gain\",\n            \"units\": \"ha\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Forest Change from 2000 to 2020\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_change.tif\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Metadata available but lacks detailed methodological explanations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71009", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis 2021-2023\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Time\",\n            \"units\": \"days since 1900-01-01\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data, monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"2.5GB\",\n        \"annotations\": \"High-quality temperature data suitable for time series analysis and climate modeling.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71009", "text": "{\n    \"dataset_name\": \"Atmospheric Chemical Composition Measurements\",\n    \"creator\": {\n        \"name\": \"Susan Solomon\",\n        \"affiliation\": \"MIT\"\n    },\n    \"date_collected\": \"2022-06-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Chlorofluorocarbon Levels\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Altitude\",\n            \"units\": \"km\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Balloon-borne measurements of atmospheric gases\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ozone Depletion and Recovery\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/chemical_data.json\",\n    \"metadata\": {\n        \"data_size\": \"800MB\",\n        \"annotations\": \"Detailed measurements of atmospheric chemical composition.\"\n    }\n}"}
