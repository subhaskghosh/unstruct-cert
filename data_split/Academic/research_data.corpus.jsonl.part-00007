{"_id": "Academic--research_data--p--71242", "text": "{\n    \"dataset_name\": \"Social Media Sentiment Analysis - User Reactions to News\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"user_id\",\n            \"description\": \"Unique identifier for each user.\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"variable_name\": \"post_id\",\n            \"description\": \"Unique identifier for each news post.\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"variable_name\": \"sentiment_score\",\n            \"description\": \"Sentiment score of user reaction to the post (-1 to 1).\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"variable_name\": \"reaction_type\",\n            \"description\": \"Type of user reaction (like, dislike, comment, share).\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Stratified Sampling based on demographic groups\",\n    \"related_publications\": [\n        {\n            \"title\": \"Sentiment Analysis of Social Media Reactions\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/social_media_sentiment.csv\",\n    \"metadata\": {\n        \"data_size\": \"2.5MB\",\n        \"annotations\": \"Data is anonymized and contains only aggregated sentiment scores.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71242", "text": "{\n    \"dataset_name\": \"Large-Scale Human Activity Recognition\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2022-11-01T14:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"sensor_id\",\n            \"description\": \"ID of the sensor used.\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"variable_name\": \"activity\",\n            \"description\": \"The detected human activity.\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Random sampling from publicly available sensor data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Human Activity Recognition using Sensor Data\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/activity_recognition.json\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Raw sensor data, requiring preprocessing.\"\n    }\n}"}
