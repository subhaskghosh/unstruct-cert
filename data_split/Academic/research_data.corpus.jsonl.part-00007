{"_id": "Academic--research_data--p--70575", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Dr. Elena Ramirez\",\n        \"affiliation\": \"University of Sao Paulo\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"species_count\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"forest_cover_percentage\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Random stratified sampling across the Amazon basin\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in the Amazon Rainforest\",\n            \"authors\": [\n                \"Ramirez, E.\",\n                \"Silva, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes species identification and location.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70575", "text": "{\n    \"dataset_name\": \"Industrial Pollution Levels in China\",\n    \"creator\": {\n        \"name\": \"Li Wei\",\n        \"affiliation\": \"Beijing Environmental Monitoring Center\"\n    },\n    \"date_collected\": \"2023-05-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pm2.5_concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"so2_concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"nox_concentration\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Assessment in Beijing\",\n            \"authors\": [\n                \"Wei, L.\",\n                \"Zhang, Q.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/china_pollution.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data includes air pollutant concentrations and meteorological conditions.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70576", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Air Pollution on Respiratory Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70576", "text": "{\n    \"dataset_name\": \"Global Forest Cover Change\",\n    \"creator\": {\n        \"name\": \"Global Land Analysis & Discovery\",\n        \"affiliation\": \"Independent Research Group\"\n    },\n    \"date_collected\": \"2022-12-20T18:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Forest Cover\",\n            \"units\": \"Percentage\"\n        },\n        {\n            \"name\": \"Gain\",\n            \"units\": \"Hectares\"\n        },\n        {\n            \"name\": \"Loss\",\n            \"units\": \"Hectares\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Satellite-Based Assessment of Global Forest Dynamics\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_cover_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data derived from Landsat imagery.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70577", "text": "{\n    \"dataset_name\": \"Lake Michigan Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US EPA\"\n    },\n    \"date_collected\": \"2023-07-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"unit\": \"unitless\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"unit\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"unit\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly at designated monitoring stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Michigan water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Doe, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lakemichigan_waterquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70577", "text": "{\n    \"dataset_name\": \"Forest Biomass Inventory - Pacific Northwest\",\n    \"creator\": {\n        \"name\": \"USDA Forest Service\",\n        \"affiliation\": \"USFS\"\n    },\n    \"date_collected\": \"2023-03-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Height\",\n            \"unit\": \"meters\"\n        },\n        {\n            \"name\": \"Diameter at Breast Height\",\n            \"unit\": \"cm\"\n        },\n        {\n            \"name\": \"Species\",\n            \"unit\": \"scientific name\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Systematic sampling plots established across the region.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Estimating forest biomass in the Pacific Northwest\",\n            \"authors\": [\n                \"Jones, A.\",\n                \"Brown, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/pnw_forestbiomass.csv\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Data includes species classifications.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70578", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset 2020-2023\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2023-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Cover Density\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Gain Area\",\n            \"units\": \"hectares\"\n        },\n        {\n            \"name\": \"Loss Area\",\n            \"units\": \"hectares\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite Imagery - Landsat and Sentinel-2\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2020\",\n            \"authors\": [\n                \"Hansen, M. C.\",\n                \"Potapov, P. V.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://glad.umd.edu/data/globalforestchange\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Data includes annual tree cover loss and gain.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70578", "text": "{\n    \"dataset_name\": \"Climate Model Output - CMIP6\",\n    \"creator\": {\n        \"name\": \"Various\",\n        \"affiliation\": \"World Climate Research Programme\"\n    },\n    \"date_collected\": \"2022-05-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm/day\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY-SA 3.0\",\n    \"sampling_method\": \"Global Climate Model Simulations\",\n    \"related_publications\": [\n        {\n            \"title\": \"The CMIP6 archive\",\n            \"authors\": [\n                \"Eyring, V.\",\n                \"Bony, S.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://esgf-node.llnl.gov/cmip6/\",\n    \"metadata\": {\n        \"data_size\": \"200GB\",\n        \"annotations\": \"Data represents future climate projections.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70579", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Center for Limnology\",\n        \"affiliation\": \"UW-Madison\"\n    },\n    \"date_collected\": \"2023-06-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Phosphorus\",\n            \"units\": \"ug/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Discrete water samples collected weekly from multiple depths.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Mendota water quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lakemendota_waterquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70579", "text": "{\n    \"dataset_name\": \"Air Quality in California\",\n    \"creator\": {\n        \"name\": \"California Air Resources Board\",\n        \"affiliation\": \"CARB\"\n    },\n    \"date_collected\": \"2023-08-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"ug/m3\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations throughout California.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in California air pollution\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/ca_airquality.json\",\n    \"metadata\": {\n        \"data_size\": \"2.5MB\",\n        \"annotations\": \"Data is hourly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70580", "text": "{\n    \"dataset_name\": \"Global Atmospheric Composition Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"NASA Goddard Space Flight Center\"\n    },\n    \"date_collected\": \"2023-05-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Dioxide Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"DU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite and ground-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Trends in Atmospheric Gases\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/atmospheric_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--70580", "text": "{\n    \"dataset_name\": \"Historical Weather Records - Europe\",\n    \"creator\": {\n        \"name\": \"European Climate Archive\",\n        \"affiliation\": \"University of Zurich\"\n    },\n    \"date_collected\": \"2021-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Sunshine Duration\",\n            \"units\": \"hours\"\n        }\n    ],\n    \"data_format\": \"TXT\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Ground-based weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"European Climate Variability\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://archive.example.com/weather_data.txt\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Missing values present.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70581", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Center for Limnology\",\n        \"affiliation\": \"University of Wisconsin-Madison\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Nitrate\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Carbon Dioxide\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Weekly grab samples collected from multiple depths.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Mendota water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lakemendota_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70581", "text": "{\n    \"dataset_name\": \"Atmospheric Pollution in Beijing\",\n    \"creator\": {\n        \"name\": \"Beijing Municipal Environmental Monitoring Center\",\n        \"affiliation\": \"Beijing Municipality\"\n    },\n    \"date_collected\": \"2022-12-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air quality assessment in Beijing\",\n            \"authors\": [\n                \"Li, W.\",\n                \"Zhang, Y.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/beijing_air_data.json\",\n    \"metadata\": {\n        \"data_size\": \"800 KB\",\n        \"annotations\": \"Data includes hourly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70582", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Global network of weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the Twenty-First Century\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Temperature anomalies relative to a baseline period.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70582", "text": "{\n    \"dataset_name\": \"Historical Rainfall Patterns\",\n    \"creator\": {\n        \"name\": \"Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2019-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"millimeters\"\n        },\n        {\n            \"name\": \"Elevation\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Rain gauges across California\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Rainfall Trends in California\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/rainfall_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Daily rainfall measurements.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70583", "text": "{\n    \"dataset_name\": \"Coastal Water Temperature and Salinity Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Oceanographic Institute, University of California\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"temperature\",\n            \"units\": \"degrees Celsius\",\n            \"description\": \"Water temperature at 1 meter depth.\"\n        },\n        {\n            \"variable_name\": \"salinity\",\n            \"units\": \"PSU\",\n            \"description\": \"Salinity of the water column.\"\n        },\n        {\n            \"variable_name\": \"depth\",\n            \"units\": \"meters\",\n            \"description\": \"Depth of the measurement\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-4.0\",\n    \"sampling_method\": \"Regular ship-based transects with CTD casts.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coastal Ocean Dynamics\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Johnson, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70583", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"AirQual Ltd.\",\n        \"affiliation\": \"Environmental Monitoring Company\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"variable_name\": \"ozone\",\n            \"description\": \"Concentration of ozone in parts per billion.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC-SA-4.0\",\n    \"sampling_method\": \"Continuous monitoring stations.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/air_quality_london.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data is subject to quality control procedures.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70584", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA Great Lakes Environmental Research Laboratory\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Regular grab samples collected at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70584", "text": "{\n    \"dataset_name\": \"Atmospheric Pollution in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"EPA Air Quality Division\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Particulate Matter (PM2.5)\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of urbanization on air quality\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data has been corrected for meteorological conditions.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70585", "text": "{\n    \"dataset_name\": \"Remote Forest Air Quality Data\",\n    \"creator\": {\n        \"name\": \"Dr. Evelyn Reed\",\n        \"affiliation\": \"National Institute of Forest Ecology\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"ozone_concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"particulate_matter_2.5\",\n            \"units\": \"ug/m3\"\n        },\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations in remote forest locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Forest Ecosystems on Regional Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data cleaned and quality controlled.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70585", "text": "{\n    \"dataset_name\": \"New York City Air Quality Monitoring\",\n    \"creator\": {\n        \"name\": \"NYC Department of Environmental Protection\",\n        \"affiliation\": \"City of New York\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"ozone_concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"carbon_monoxide\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"sulfur_dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Fixed monitoring stations throughout New York City\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in New York City\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/nyc_air_quality.json\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Real-time data with hourly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70586", "text": "{\n    \"dataset_name\": \"Arctic Sea Ice Extent and Thickness 2021-2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Alaska Fairbanks\"\n    },\n    \"date_collected\": \"2021-07-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Ice Extent\",\n            \"units\": \"km^2\",\n            \"description\": \"Area of ocean covered by at least 15% sea ice concentration.\"\n        },\n        {\n            \"name\": \"Sea Ice Thickness\",\n            \"units\": \"meters\",\n            \"description\": \"Average thickness of sea ice, indicating significant decline due to warming temperatures.\"\n        },\n        {\n            \"name\": \"Surface Temperature Anomaly\",\n            \"units\": \"degrees Celsius\",\n            \"description\": \"Difference from the long-term average temperature, showing a dramatic warming trend.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite Remote Sensing (NSIDC)\",\n    \"related_publications\": [\n        {\n            \"title\": \"Rapid Arctic Sea Ice Loss and its Global Implications\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/arctic_sea_ice.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70586", "text": "{\n    \"dataset_name\": \"Local Park Bird Species Counts\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"State University of New York\"\n    },\n    \"date_collected\": \"2022-05-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Bird Species A\",\n            \"units\": \"count\",\n            \"description\": \"Number of individuals observed.\"\n        },\n        {\n            \"name\": \"Bird Species B\",\n            \"units\": \"count\",\n            \"description\": \"Number of individuals observed.\"\n        },\n        {\n            \"name\": \"Observation Location\",\n            \"units\": \"latitude, longitude\",\n            \"description\": \"Coordinates of the observation point.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Visual Surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Bird Diversity in New York State\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/bird_counts.csv\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Data includes observer notes.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70587", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Breathe London\",\n        \"affiliation\": \"Environmental Monitoring Ltd.\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations across the city\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health in Urban Populations\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes hourly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70587", "text": "{\n    \"dataset_name\": \"Campus Air Quality Study\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Mobile sensor measurements around campus\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Assessment of University Campus\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/campus_air_quality.json\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data collected during a one-week period.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70588", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"unit\": \"Degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"unit\": \"Degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"unit\": \"Degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global gridded data, interpolated from station data\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISTEMP v4: Global Surface Temperature Analysis\",\n            \"authors\": [\n                \"Gavin Schmidt\",\n                \"Drew Shindell\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Contains monthly and annual global surface temperature anomalies\"\n    }\n}"}
{"_id": "Academic--research_data--n--70588", "text": "{\n    \"dataset_name\": \"Social Media Sentiment on Climate Change\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"UC Berkeley\"\n    },\n    \"date_collected\": \"2021-05-15T08:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tweet Text\",\n            \"unit\": \"String\"\n        },\n        {\n            \"name\": \"Sentiment Score\",\n            \"unit\": \"Scale of -1 to 1\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Twitter API streaming data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Analyzing Public Opinion on Climate Change Using Social Media\",\n            \"authors\": [\n                \"Jane Doe\",\n                \"John Smith\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/social_media_climate_data\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Contains tweets related to climate change and their associated sentiment scores.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70589", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter less than 2.5 micrometers in diameter.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature.\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\",\n            \"description\": \"Relative humidity.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Public Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70589", "text": "{\n    \"dataset_name\": \"Forest Inventory Data\",\n    \"creator\": {\n        \"name\": \"Department of Forestry\",\n        \"affiliation\": \"State University\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Diameter at Breast Height\",\n            \"units\": \"cm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random sampling plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Forest Growth and Biomass Estimation\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Basic tree measurements.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70590", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global weather station network\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the Twenty-First Century\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Quality control flags included for each data point.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70590", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data\",\n    \"creator\": {\n        \"name\": \"Maria Rodriguez\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2022-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"millimeters\"\n        },\n        {\n            \"name\": \"Location\",\n            \"units\": \"city name\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Rain gauges across California\",\n    \"related_publications\": [\n        {\n            \"title\": \"California Drought Patterns\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/rainfall_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Limited documentation available.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70591", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Great Lakes Environmental Research Laboratory\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0: Public Domain\",\n    \"sampling_method\": \"Regular sampling buoys and laboratory analysis.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70591", "text": "{\n    \"dataset_name\": \"Atmospheric Pollution in Urban Areas\",\n    \"creator\": {\n        \"name\": \"European Environment Agency (EEA)\",\n        \"affiliation\": \"Environmental Monitoring and Assessment Programme\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"Fixed monitoring stations across major European cities.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air quality trends in Europe\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, K.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data includes metadata about station locations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70592", "text": "{\n    \"dataset_name\": \"European River Water Quality Monitoring\",\n    \"creator\": {\n        \"name\": \"European Environment Agency\",\n        \"affiliation\": \"EEA\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Regular interval sampling at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Assessment of European River Water Quality\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/european_river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70592", "text": "{\n    \"dataset_name\": \"US Streamflow Data\",\n    \"creator\": {\n        \"name\": \"US Geological Survey\",\n        \"affiliation\": \"USGS\"\n    },\n    \"date_collected\": \"2023-10-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Streamflow\",\n            \"units\": \"m^3/s\"\n        },\n        {\n            \"name\": \"Water Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Water-Quality Assessment Program\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/us_streamflow_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Data includes provisional status flags.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70593", "text": "{\n    \"dataset_name\": \"Cardiac MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"LV_Volume\",\n            \"units\": \"mL\"\n        },\n        {\n            \"name\": \"EF\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wall_Thickness\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Retrospective analysis of patient MRI scans\",\n    \"related_publications\": [\n        {\n            \"title\": \"Improved Cardiac Function Assessment with MRI\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/cardiac_mri_dataset.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Expert cardiologist annotations included\"\n    }\n}"}
{"_id": "Academic--research_data--n--70593", "text": "{\n    \"dataset_name\": \"Patient Demographic Data\",\n    \"creator\": {\n        \"name\": \"John Doe\",\n        \"affiliation\": \"Private Healthcare Clinic\"\n    },\n    \"date_collected\": \"2022-12-20T15:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Age\",\n            \"units\": \"years\"\n        },\n        {\n            \"name\": \"Gender\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Patient intake forms\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/demographic_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500 KB\",\n        \"annotations\": \"None\"\n    }\n}"}
{"_id": "Academic--research_data--p--70594", "text": "{\n    \"dataset_name\": \"Global Historical Climatology Network Daily\",\n    \"creator\": {\n        \"name\": \"NOAA National Centers for Environmental Information\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Maximum Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Minimum Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Daily observations from weather stations worldwide\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Variability and Change\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/global-historical-climatology-network-daily/\",\n    \"metadata\": {\n        \"data_size\": \"200GB\",\n        \"annotations\": \"Quality control flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--70594", "text": "{\n    \"dataset_name\": \"Avian Migration Patterns in North America\",\n    \"creator\": {\n        \"name\": \"Cornell Lab of Ornithology\",\n        \"affiliation\": \"Cornell University\"\n    },\n    \"date_collected\": \"2022-05-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Bird Species\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Citizen science observations and radar data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Tracking Avian Migration with eBird\",\n            \"authors\": [\n                \"Finch, B.\",\n                \"Sparrow, C.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://ebird.org/data/download\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Observation timestamps included\"\n    }\n}"}
{"_id": "Academic--research_data--p--70595", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"GISTEMP Team\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Land Coverage\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"Ocean Temperature\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global station data and satellite observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Contains monthly and annual temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70595", "text": "{\n    \"dataset_name\": \"Coral Reef Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"ReefCheck Foundation\",\n        \"affiliation\": \"University of Queensland\"\n    },\n    \"date_collected\": \"2019-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Coral Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Fish Biomass\",\n            \"units\": \"kg/m^2\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Underwater visual census\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coral Reef Health Assessment\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://reefcheck.org/data/\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Data from multiple coral reef locations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70596", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis - 2021 Update\",\n    \"creator\": {\n        \"name\": \"GISS Surface Temperature Analysis Team\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2021-07-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data, monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"authors\": [\n                \"Hansen\",\n                \"Sato\",\n                \"Ruedy\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Contains temperature anomalies from 1880 to present.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70596", "text": "{\n    \"dataset_name\": \"Historical Weather Records - Europe\",\n    \"creator\": {\n        \"name\": \"National Meteorological Archives\",\n        \"affiliation\": \"European Meteorological Society\"\n    },\n    \"date_collected\": \"2019-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Restricted - Academic Use Only\",\n    \"sampling_method\": \"Daily observations from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"European Climate Variability\",\n            \"authors\": [\n                \"Jones\",\n                \"Dyer\",\n                \"Hulme\"\n            ]\n        }\n    ],\n    \"download_url\": \"http://www.metoffice.gov.uk/research/climate/historical-data\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Detailed daily weather records across Europe.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70597", "text": "{\n    \"dataset_name\": \"Regional Temperature Trends\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"unit\": \"Percentage\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"unit\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Daily measurements from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Regional Climate Change Impacts\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/regional_temperature.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
