{"_id": "Academic--research_data--p--66913", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - 2020 Onwards\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2020-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"Degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"Degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global gridded dataset, monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Update 2020\",\n            \"authors\": [\n                \"Schmidt, G.A.\",\n                \"Ruedy, R.\"\n            ],\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/tabledata_v4/\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Contains temperature anomalies relative to a baseline period.\"\n    }\n}"}
{"_id": "Academic--research_data--n--66913", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Biodiversity\",\n    \"creator\": {\n        \"name\": \"National Institute of Amazonian Research (INPA)\",\n        \"affiliation\": \"Brazil\"\n    },\n    \"date_collected\": \"2019-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Count\",\n            \"units\": \"Number of individuals\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"Meters\"\n        },\n        {\n            \"name\": \"Location\",\n            \"units\": \"Coordinates\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Field surveys and remote sensing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity assessment in the Amazon basin\",\n            \"authors\": [\n                \"Silva, J.C.\",\n                \"Oliveira, M.\"\n            ],\n            \"year\": 2018\n        }\n    ],\n    \"download_url\": \"https://inpa.gov.br/biodiversitydata\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Contains data on plant and animal species found in the Amazon rainforest.\"\n    }\n}"}
