{"_id": "Academic--research_data--p--68682", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - Boston 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    },\n    \"date_collected\": \"2023-11-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter less than 2.5 micrometers in diameter.\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring using fixed sensors\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Green Spaces on Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/boston_air_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data has been quality-controlled and missing values imputed using linear interpolation.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68682", "text": "{\n    \"dataset_name\": \"Global Forest Cover Change 1990-2020\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2020-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Treecover2000\",\n            \"units\": \"%\",\n            \"description\": \"Percentage of tree cover in the year 2000\"\n        },\n        {\n            \"variable_name\": \"Lossyear\",\n            \"units\": \"Year\",\n            \"description\": \"Year of forest loss\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC-BY-SA\",\n    \"sampling_method\": \"Remote sensing using Landsat imagery\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Forest Change from 1990 to 2020\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/global_forest_change.tif\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data is based on a 30-meter resolution analysis.\"\n    }\n}"}
