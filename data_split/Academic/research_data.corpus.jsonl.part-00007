{"_id": "Academic--research_data--n--65977", "text": "{\n    \"dataset_name\": \"Complex Oceanographic Data Set\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute\",\n        \"affiliation\": \"National Institute of Oceanography\"\n    },\n    \"date_collected\": \"2023-05-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Eddy Kinetic Energy\",\n            \"units\": \"m²/s²\",\n            \"description\": \"Kinetic energy associated with ocean eddies, calculated using a complex spectral analysis.\"\n        },\n        {\n            \"name\": \"Salinity Gradient\",\n            \"units\": \"psu/m\",\n            \"description\": \"Rate of change of salinity with depth, requiring advanced interpretation.\"\n        },\n        {\n            \"name\": \"Dissolved Organic Carbon Flux\",\n            \"units\": \"mol/m²/day\",\n            \"description\": \"Flux of dissolved organic carbon across the sediment-water interface, derived from isotopic analysis.\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Research vessel deployments\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Circulation and Biogeochemical Cycles\",\n            \"authors\": [\n                \"Brown, R.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Requires specialized software for analysis.\"\n    }\n}"}
{"_id": "Academic--research_data--p--65978", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency Research Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-11-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
