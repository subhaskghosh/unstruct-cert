{"_id": "Academic--research_data--n--69800", "text": "{\n    \"dataset_name\": \"Social Media Sentiment on Environmental Issues\",\n    \"creator\": {\n        \"name\": \"Pew Research Center\",\n        \"affiliation\": \"Independent Research Organization\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sentiment Score\",\n            \"units\": \"Scale of -1 to 1\"\n        },\n        {\n            \"name\": \"Post Text\",\n            \"units\": \"Text\"\n        },\n        {\n            \"name\": \"User Demographics\",\n            \"units\": \"Categorical\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution-NonCommercial 4.0 International\",\n    \"sampling_method\": \"API scraping of Twitter data.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Public Opinion on Climate Change\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/social_media_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Sentiment analysis performed using a pre-trained model.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69801", "text": "{\n    \"dataset_name\": \"Brain Tumor MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University Medical Center\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"ImageID\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"ImageType\",\n            \"units\": \"MRI\"\n        },\n        {\n            \"name\": \"TumorGrade\",\n            \"units\": \"I-IV\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Prospective cohort study\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Brain Tumor Segmentation\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_tumor_mri.csv\",\n    \"metadata\": {\n        \"data_size\": \"2.5 GB\",\n        \"annotations\": \"Manual segmentation by radiologists\"\n    }\n}"}
{"_id": "Academic--research_data--n--69801", "text": "{\n    \"dataset_name\": \"Patient Demographics and Health Records\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"General Hospital\"\n    },\n    \"date_collected\": \"2022-12-20T14:45:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PatientID\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"Age\",\n            \"units\": \"years\"\n        },\n        {\n            \"name\": \"Gender\",\n            \"units\": \"Male/Female\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Retrospective chart review\",\n    \"related_publications\": [\n        {\n            \"title\": \"Analysis of Patient Demographics\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/patient_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"De-identified patient data\"\n    }\n}"}
