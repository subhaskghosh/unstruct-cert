{"_id": "Academic--research_data--n--67772", "text": "{\n    \"dataset_name\": \"Rural Ecosystem Monitoring - Scotland\",\n    \"creator\": {\n        \"name\": \"Professor Alistair MacLeod\",\n        \"affiliation\": \"University of Edinburgh\"\n    },\n    \"date_collected\": \"2022-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Periodic field measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ecosystem Dynamics in Scottish Highlands\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/scotland_ecosystem.json\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Detailed site descriptions provided.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67773", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"units\": \"year\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2012\",\n            \"year\": 2013\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/UMD/HANSEN_GLOBAL_FOREST_CHANGE_2020_V1_8\",\n    \"metadata\": {\n        \"data_size\": \"50 GB\",\n        \"annotations\": \"Globally mapped forest loss and gain events.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67773", "text": "{\n    \"dataset_name\": \"North Pacific Marine Ecosystem Data\",\n    \"creator\": {\n        \"name\": \"North Pacific Marine Science Organization\",\n        \"affiliation\": \"NPMCO\"\n    },\n    \"date_collected\": \"2022-06-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"sea_surface_temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Ship-based oceanographic surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Oceanographic Conditions in the North Pacific\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.npmco.org/data-downloads\",\n    \"metadata\": {\n        \"data_size\": \"10 GB\",\n        \"annotations\": \"Oceanographic measurements from the North Pacific Ocean.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67774", "text": "{\n    \"dataset_name\": \"US Water Quality Monitoring Dataset\",\n    \"creator\": {\n        \"name\": \"US Environmental Protection Agency\",\n        \"affiliation\": \"EPA\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected from rivers and lakes across the US.\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Water Quality Assessment Program\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.example.com/water_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67774", "text": "{\n    \"dataset_name\": \"Air Pollution in Beijing\",\n    \"creator\": {\n        \"name\": \"Beijing Municipal Environmental Monitoring Center\",\n        \"affiliation\": \"BMEPC\"\n    },\n    \"date_collected\": \"2022-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"SO2\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Restricted Use - Government Only\",\n    \"sampling_method\": \"Continuous monitoring stations throughout Beijing.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Beijing\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://www.example.com/beijing_air_data.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data is hourly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67775", "text": "{\n    \"dataset_name\": \"River Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"River Depth\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Water Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"River Width\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Flow Rate\",\n            \"units\": \"m^3/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Regular interval sampling at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on River Water Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/river_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67775", "text": "{\n    \"dataset_name\": \"Air Pollution Levels in Urban Areas\",\n    \"creator\": {\n        \"name\": \"City Environmental Monitoring Department\",\n        \"affiliation\": \"Local Government\"\n    },\n    \"date_collected\": \"2022-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide Concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Continuous monitoring at air quality stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Urban Air Pollution\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Calibration data included\"\n    }\n}"}
{"_id": "Academic--research_data--p--67776", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations with hourly readings\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Li, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data includes quality control flags and station metadata.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67776", "text": "{\n    \"dataset_name\": \"Forest Fire Emissions\",\n    \"creator\": {\n        \"name\": \"Robert Davis\",\n        \"affiliation\": \"National Forestry Service\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Emissions\",\n            \"units\": \"tons\"\n        },\n        {\n            \"name\": \"Burned Area\",\n            \"units\": \"hectares\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Satellite imagery and ground-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Trends in Forest Fire Activity\",\n            \"authors\": [\n                \"Davis, R.\",\n                \"Wilson, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/fire_emissions.json\",\n    \"metadata\": {\n        \"data_size\": \"800 MB\",\n        \"annotations\": \"Data is preprocessed for climate modeling.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67777", "text": "{\n    \"dataset_name\": \"Global Air Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"World Meteorological Organization\",\n        \"affiliation\": \"UN Environment Programme\"\n    },\n    \"date_collected\": \"2022-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Air Quality Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67777", "text": "{\n    \"dataset_name\": \"Historical Weather Patterns\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°F\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Weather station network\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate Variability in North America\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/weather_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Missing values indicated by -999\"\n    }\n}"}
{"_id": "Academic--research_data--p--67778", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67778", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Dr. David Miller\",\n        \"affiliation\": \"Smithsonian Institution\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species\",\n            \"units\": \"N/A\",\n            \"description\": \"Identified plant species.\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"m\",\n            \"description\": \"Height of the tree.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in Temperate Forests\",\n            \"authors\": [\n                \"Miller, D.\",\n                \"Brown, A.\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Species identification confidence scores.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67779", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"O3\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Data Commons Attribution License\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data includes hourly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67779", "text": "{\n    \"dataset_name\": \"GlobalForestWatch\",\n    \"creator\": {\n        \"name\": \"University of Maryland\",\n        \"affiliation\": \"Remote Sensing Lab\"\n    },\n    \"date_collected\": \"2023-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"TreeCover\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Biomass\",\n            \"units\": \"tons/hectare\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Forest Change\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://globalforestwatch.org/data.csv\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data includes annual forest cover change.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67780", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis - Land and Ocean\",\n    \"creator\": {\n        \"name\": \"NOAA National Centers for Environmental Information\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Land Area\",\n            \"units\": \"square kilometers\"\n        },\n        {\n            \"name\": \"Ocean Area\",\n            \"units\": \"square kilometers\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global surface measurements from land stations and ocean buoys.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Update 2023\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/global-surface-temperature/access/\",\n    \"metadata\": {\n        \"data_size\": \"1.2GB\",\n        \"annotations\": \"Contains quality control flags for data reliability.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67780", "text": "{\n    \"dataset_name\": \"Historical Climate Model Simulations\",\n    \"creator\": {\n        \"name\": \"IPCC Data Distribution Centre\",\n        \"affiliation\": \"IPCC\"\n    },\n    \"date_collected\": \"2018-05-15T08:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Kelvin\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm/day\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Climate model simulations based on various scenarios.\",\n    \"related_publications\": [\n        {\n            \"title\": \"CMIP6 Model Output\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://esgf-node.llnl.gov/cmip6/\",\n    \"metadata\": {\n        \"data_size\": \"5TB\",\n        \"annotations\": \"Model output requires significant post-processing.\"\n    }\n}"}
