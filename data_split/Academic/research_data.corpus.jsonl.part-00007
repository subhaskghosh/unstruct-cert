{"_id": "Academic--research_data--p--67316", "text": "{\n    \"dataset_name\": \"Lung Nodule Progression Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image ID\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"Nodule Diameter\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Time to Scan\",\n            \"units\": \"months\"\n        },\n        {\n            \"name\": \"Stage\",\n            \"units\": \"clinical stage\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Prospective cohort study with annual follow-up scans.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Longitudinal Analysis of Lung Nodule Growth\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lung_nodule_dataset\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Radiologist-verified nodule segmentations\"\n    }\n}"}
{"_id": "Academic--research_data--n--67316", "text": "{\n    \"dataset_name\": \"Chest X-Ray Diagnostic Images\",\n    \"creator\": {\n        \"name\": \"John Doe\",\n        \"affiliation\": \"General Hospital\"\n    },\n    \"date_collected\": \"2023-05-20T12:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image ID\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"Diagnosis\",\n            \"units\": \"ICD-10 code\"\n        },\n        {\n            \"name\": \"Image Quality\",\n            \"units\": \"score (1-5)\"\n        }\n    ],\n    \"data_format\": \"JPEG\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Retrospective collection of clinical X-rays.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Accuracy of AI in Chest X-Ray Interpretation\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray_dataset\",\n    \"metadata\": {\n        \"data_size\": \"20GB\",\n        \"annotations\": \"Radiologist-provided diagnoses\"\n    }\n}"}
{"_id": "Academic--research_data--p--67317", "text": "{\n    \"dataset_name\": \"Global Atmospheric Composition Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Center for Atmospheric Research\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Dioxide Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"DU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in atmospheric greenhouse gases\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Johnson, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality flags and uncertainty estimates are included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67317", "text": "{\n    \"dataset_name\": \"Ocean Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"Dr. Robert Davis\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2019-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Buoy measurements and oceanographic surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Regional variations in ocean temperature\",\n            \"authors\": [\n                \"Davis, R.\",\n                \"Smith, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_temp.nc\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Data processed for outlier removal.\"\n    }\n}"}
