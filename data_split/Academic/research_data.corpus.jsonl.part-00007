{"_id": "Academic--research_data--n--70470", "text": "{\n    \"dataset_name\": \"Atmospheric CO2 Measurements\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"NOAA Global Monitoring Laboratory\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Kelvin\"\n        },\n        {\n            \"name\": \"Pressure\",\n            \"units\": \"Pa\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous measurements from a fixed monitoring station.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global trends in atmospheric CO2\",\n            \"authors\": [\n                \"Jones, A.\",\n                \"Brown, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/co2data.json\",\n    \"metadata\": {\n        \"data_size\": \"500 KB\",\n        \"annotations\": \"Data is calibrated and quality-controlled.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70471", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"Imperial College London\",\n        \"affiliation\": \"Department of Civil and Environmental Engineering\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations deployed across the city.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of traffic emissions on urban air quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Doe, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70471", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey - Amazon 2021\",\n    \"creator\": {\n        \"name\": \"Rainforest Conservation Alliance\",\n        \"affiliation\": \"Non-profit Organization\"\n    },\n    \"date_collected\": \"2021-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Species\",\n            \"units\": \"Count\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Canopy Cover\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"m²/m²\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random plots within the Amazon rainforest.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity hotspots in the Amazon basin\",\n            \"authors\": [\n                \"Jones, B.\",\n                \"Williams, C.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Species classifications verified by experts.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70472", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Environmental Monitoring Group, University College London\",\n        \"affiliation\": \"University College London\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-4.0\",\n    \"sampling_method\": \"Continuous monitoring using calibrated sensors at fixed locations. Data quality control procedures included regular calibration and outlier removal.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes timestamps, coordinates, and sensor IDs.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70472", "text": "{\n    \"dataset_name\": \"Soil Composition in Agricultural Lands\",\n    \"creator\": {\n        \"name\": \"Agricultural Research Institute\",\n        \"affiliation\": \"Ministry of Agriculture\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"name\": \"Organic Matter\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Nitrogen Content\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC-SA-4.0\",\n    \"sampling_method\": \"Random sampling of soil cores from agricultural fields.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Soil Health and Crop Yields\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/soil_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes location coordinates and soil type.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70473", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - 2023-2024\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Oceanic and Atmospheric Administration (NOAA)\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        },\n        {\n            \"name\": \"Altitude\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Timestamp\",\n            \"units\": \"ISO 8601\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of weather stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Recent Trends in Global Temperature Anomalies\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Johnson, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Quality controlled and gap-filled temperature data.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70473", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data - 1980-2000\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2000-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Location ID\",\n            \"units\": \"integer\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Rain gauge measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Rainfall Patterns in California\",\n            \"authors\": [\n                \"Lee, D.\",\n                \"Smith, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/rainfall_data_1980_2000.csv\",\n    \"metadata\": {\n        \"data_size\": \"80MB\",\n        \"annotations\": \"Raw rainfall data with minimal processing.\"\n    }\n}"}
