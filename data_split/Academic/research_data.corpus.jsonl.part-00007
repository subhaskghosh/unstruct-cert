{"_id": "Academic--research_data--p--71064", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"NASA GISS\",\n        \"affiliation\": \"Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"surface_temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Quality controlled temperature data\"\n    }\n}"}
{"_id": "Academic--research_data--n--71064", "text": "{\n    \"dataset_name\": \"Historical Climate Reconstruction\",\n    \"creator\": {\n        \"name\": \"University of Arizona\",\n        \"affiliation\": \"Laboratory of Tree-Ring Research\"\n    },\n    \"date_collected\": \"2021-05-15T08:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tree_ring_width\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Tree-ring analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Reconstructing Past Climates\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/tree_rings.json\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"High-resolution tree-ring data\"\n    }\n}"}
{"_id": "Academic--research_data--p--71065", "text": "{\n    \"dataset_name\": \"Atmospheric Composition Measurements - Urban Area\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations located throughout the city.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Emissions on Local Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/datasets/urban_atmosphere.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data quality flags included for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71065", "text": "{\n    \"dataset_name\": \"Global Forest Cover Change 1990-2020\",\n    \"creator\": {\n        \"name\": \"Global Land Analysis & Discovery (GLAD)\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Forest Cover\",\n            \"units\": \"Percentage\"\n        },\n        {\n            \"name\": \"Gain/Loss Area\",\n            \"units\": \"Hectares\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Satellite imagery analysis using Landsat data.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Mapping Global Forest Change\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/datasets/forest_cover.tif\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Metadata includes confidence intervals for forest cover estimates.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71066", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - Land & Ocean\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Year\",\n            \"unit\": \"Year\"\n        },\n        {\n            \"name\": \"Mean Global Temperature Anomaly\",\n            \"unit\": \"Degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global temperature measurements from land and ocean stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISS Surface Temperature Analysis (GISTEMP)\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Includes annual and monthly mean temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71066", "text": "{\n    \"dataset_name\": \"Coral Reef Health Monitoring\",\n    \"creator\": {\n        \"name\": \"Australian Institute of Marine Science\",\n        \"affiliation\": \"AIMS\"\n    },\n    \"date_collected\": \"2022-07-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Coral Cover\",\n            \"unit\": \"Percentage\"\n        },\n        {\n            \"name\": \"Water Temperature\",\n            \"unit\": \"Degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Underwater visual surveys of coral reefs.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term Monitoring of Coral Reefs\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://www.aims.gov.au/data\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data from the Great Barrier Reef.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71067", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University, Department of Environmental Engineering\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter less than 2.5 micrometers in diameter\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Continuous monitoring at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urbanization on Air Quality\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data has been quality controlled and calibrated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71067", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"National Forest Service\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"SpeciesCount\",\n            \"units\": \"count\",\n            \"description\": \"Number of individual species observed\"\n        },\n        {\n            \"variable_name\": \"TreeHeight\",\n            \"units\": \"meters\",\n            \"description\": \"Average height of trees in the plot\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary License\",\n    \"sampling_method\": \"Random sampling of forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Trends in National Forests\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"600MB\",\n        \"annotations\": \"Preliminary data - requires further processing.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71068", "text": "{\n    \"dataset_name\": \"Coastal Water Quality Data\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute\",\n        \"affiliation\": \"University of California, San Diego\"\n    },\n    \"date_collected\": \"2023-05-10T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Sediment Weight\",\n            \"units\": \"kilograms\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Regular transect sampling at fixed locations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Coastal Runoff on Marine Ecosystems\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/coastal_water_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Data has been quality controlled and flagged for outliers.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71068", "text": "{\n    \"dataset_name\": \"Urban Air Pollution Measurements\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"City of Los Angeles\"\n    },\n    \"date_collected\": \"2023-11-15T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Continuous monitoring at urban air quality stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Major Cities\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_pollution_data.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data has been validated against EPA standards.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71069", "text": "{\n    \"dataset_name\": \"Urban Air and Water Quality Monitoring - 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"dimensionless\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations with hourly readings.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Spatial and Temporal Variations in Urban Air Pollution\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_water_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.5 GB\",\n        \"annotations\": \"Data quality flags included for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71069", "text": "{\n    \"dataset_name\": \"Glacial Meltwater Composition - 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Alex Thompson\",\n        \"affiliation\": \"University of Colorado, Boulder\"\n    },\n    \"date_collected\": \"2023-06-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Water Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Sediment Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Glacial Melt Rate\",\n            \"units\": \"m/year\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Weekly sampling of meltwater streams.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impacts of Climate Change on Glacial Hydrology\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/glacial_meltwater_2023.json\",\n    \"metadata\": {\n        \"data_size\": \"800 MB\",\n        \"annotations\": \"Data includes isotopic analysis.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71070", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"Emily Carter\",\n        \"affiliation\": \"University of Wisconsin-Madison\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"Weekly grab samples from multiple locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Changes in Lake Mendota\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lakemendota_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data quality flags included for each measurement\"\n    }\n}"}
{"_id": "Academic--research_data--n--71070", "text": "{\n    \"dataset_name\": \"Ocean Salinity Measurements\",\n    \"creator\": {\n        \"name\": \"James Olsen\",\n        \"affiliation\": \"Oceanographic Institute\"\n    },\n    \"date_collected\": \"2023-07-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC 4.0\",\n    \"sampling_method\": \"Continuous measurements from a research vessel\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Ocean Salinity Patterns\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_salinity_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data processed with a standard calibration procedure\"\n    }\n}"}
{"_id": "Academic--research_data--p--71071", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Environmental Monitoring Group, University College London\",\n        \"affiliation\": \"UCL\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Systematic grid-based monitoring\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5.2MB\",\n        \"annotations\": \"Data has been quality controlled and missing values are flagged.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71071", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey - Amazon\",\n    \"creator\": {\n        \"name\": \"Amazon Research Institute\",\n        \"affiliation\": \"ARI\"\n    },\n    \"date_collected\": \"2022-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"units\": \"trees/ha\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random stratified sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment of Amazon Rainforest\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"12.5MB\",\n        \"annotations\": \"Requires significant data cleaning and taxonomic expertise.\"\n    }\n}"}
