{"_id": "Academic--research_data--p--70819", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"Hansen, Matthew C.\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2020-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"units\": \"percent\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"units\": \"year\"\n        },\n        {\n            \"name\": \"gain\",\n            \"units\": \"hectares\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote sensing data from Landsat satellites\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Forest Change 2000–2020\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://glad.umd.edu/data\",\n    \"metadata\": {\n        \"data_size\": \"250 GB\",\n        \"annotations\": \"Provides information about forest loss and gain globally.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70819", "text": "{\n    \"dataset_name\": \"CMIP6 Climate Model Output\",\n    \"creator\": {\n        \"name\": \"Various\",\n        \"affiliation\": \"World Climate Research Programme\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tas\",\n            \"units\": \"Kelvin\"\n        },\n        {\n            \"name\": \"pr\",\n            \"units\": \"kg m-2 s-1\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY-SA 3.0\",\n    \"sampling_method\": \"Climate model simulations\",\n    \"related_publications\": [\n        {\n            \"title\": \"The Coupled Model Intercomparison Project Phase 6 (CMIP6) experimental design\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://esgf-node.llnl.gov/cmip6/\",\n    \"metadata\": {\n        \"data_size\": \"10 TB\",\n        \"annotations\": \"Comprehensive climate model output for various scenarios.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70820", "text": "{\n    \"dataset_name\": \"Chest X-Ray Images (NIH)\",\n    \"creator\": {\n        \"name\": \"National Institutes of Health\",\n        \"affiliation\": \"Clinical Center\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image Filename\",\n            \"unit\": \"string\"\n        },\n        {\n            \"name\": \"Findings\",\n            \"unit\": \"string\"\n        }\n    ],\n    \"data_format\": \"PNG\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Retrospective collection from hospital records\",\n    \"related_publications\": [\n        {\n            \"title\": \"CheXpert: A Large Chest X-ray Dataset with Annotation and Reporting Capabilities\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://nihcc.app.box.com/v/CheXpert-v1.0\",\n    \"metadata\": {\n        \"data_size\": \"1.1TB\",\n        \"annotations\": \"Present/Absent of 14 common chest pathologies\"\n    }\n}"}
{"_id": "Academic--research_data--n--70820", "text": "{\n    \"dataset_name\": \"Medical Report Data\",\n    \"creator\": {\n        \"name\": \"HealthTech Solutions\",\n        \"affiliation\": \"Private Research Lab\"\n    },\n    \"date_collected\": \"2023-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Patient ID\",\n            \"unit\": \"integer\"\n        },\n        {\n            \"name\": \"Report Text\",\n            \"unit\": \"string\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"De-identified reports from partner hospitals\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Diagnosis using Natural Language Processing\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/medical_reports.json\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"NLP tags for medical concepts\"\n    }\n}"}
