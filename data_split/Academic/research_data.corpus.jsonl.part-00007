{"_id": "Academic--research_data--p--66333", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"GISS Surface Temperature Analysis Team\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2020-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"unit\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"unit\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global meteorological station data\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISTEMP v4: Global Surface Temperature Analysis\",\n            \"authors\": [\n                \"James Hansen\",\n                \"Makiko Sato\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Contains monthly mean temperature anomalies.\"\n    }\n}"}
