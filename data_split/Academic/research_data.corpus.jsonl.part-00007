{"_id": "Academic--research_data--p--65966", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset 2020-2024\",\n    \"creator\": {\n        \"name\": \"University of Maryland\",\n        \"affiliation\": \"Global Land Analysis & Discovery (GLAD)\"\n    },\n    \"date_collected\": \"2023-10-26T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"units\": \"percent\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"units\": \"year\"\n        },\n        {\n            \"name\": \"gain\",\n            \"units\": \"hectares\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Remote sensing data from Landsat and Sentinel satellites\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from Landsat 8 data\",\n            \"authors\": [\n                \"Hansen\",\n                \"Potapov\",\n                \"Moore\",\n                \"Hegger\",\n                \"Krause\",\n                \"Shen\",\n                \"Baldwin\",\n                \"Huaman\",\n                \"Herold\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://glad.umd.edu/dataset/globalforestchange\",\n    \"metadata\": {\n        \"data_size\": \"250GB\",\n        \"annotations\": \"Maps of forest loss and gain globally\"\n    }\n}"}
{"_id": "Academic--research_data--n--65966", "text": "{\n    \"dataset_name\": \"Global Ocean Temperature and Salinity Database\",\n    \"creator\": {\n        \"name\": \"National Oceanographic Data Center\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2022-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"depth\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ship-based measurements and buoy data\",\n    \"related_publications\": [\n        {\n            \"title\": \"A global ocean temperature and salinity climatology\",\n            \"authors\": [\n                \"Boyer\",\n                \"Antonov\",\n                \"Locarnini\",\n                \"Garcia\",\n                \"Baranova\",\n                \"Seidel\",\n                \"Johnson\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.nodc.noaa.gov/OC5/WOA/\",\n    \"metadata\": {\n        \"data_size\": \"100GB\",\n        \"annotations\": \"Comprehensive oceanographic data\"\n    }\n}"}
