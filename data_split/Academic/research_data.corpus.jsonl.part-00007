{"_id": "Academic--research_data--p--68652", "text": "{\n    \"dataset_name\": \"Urban Bird Diversity Study\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"species\",\n            \"unit\": \"N/A\"\n        },\n        {\n            \"name\": \"count\",\n            \"unit\": \"individuals\"\n        },\n        {\n            \"name\": \"location_latitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"location_longitude\",\n            \"unit\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Point counts along transects\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urbanization on Bird Communities\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_bird_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data includes verified bird species identifications.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68652", "text": "{\n    \"dataset_name\": \"Global Forest Cover Change\",\n    \"creator\": {\n        \"name\": \" Hansen/UMD Global Forest Change Team\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2018-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"unit\": \"percent\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"unit\": \"year\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Forest Change from 2000 to 2018\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_cover.tif\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Raster data representing forest cover change.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68653", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis - 2021 Update\",\n    \"creator\": {\n        \"name\": \"GISTEMP Team\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Land Mask\",\n            \"units\": \"boolean\"\n        },\n        {\n            \"name\": \"Anomaly\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data, monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Surface Temperature Analysis (GISTEMP) v4\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Contains data from land and ocean stations.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68653", "text": "{\n    \"dataset_name\": \"Complex Ecosystem Dynamics in the Amazon Rainforest\",\n    \"creator\": {\n        \"name\": \"Dr. Elena Ramirez\",\n        \"affiliation\": \"Amazon Research Institute\"\n    },\n    \"date_collected\": \"2022-05-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Species Abundance\",\n            \"units\": \"trees/hectare\"\n        },\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"m^2/m^2\"\n        },\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Canopy Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Biodiversity Index\",\n            \"units\": \"Shannon Index\"\n        },\n        {\n            \"name\": \"Carbon Sequestration Rate\",\n            \"units\": \"tons/hectare/year\"\n        },\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Solar Radiation\",\n            \"units\": \"W/m^2\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution-NonCommercial 4.0 International\",\n    \"sampling_method\": \"Random plots within the Amazon basin\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term Ecosystem Monitoring in the Amazon\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://amazonresearch.org/dataset/ecosystem\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Detailed ecological data from long-term monitoring sites.\"\n    }\n}"}
