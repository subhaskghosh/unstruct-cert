{"_id": "Academic--research_data--p--67576", "text": "{\n    \"dataset_name\": \"LongTermEcologyData_Yellowstone\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Montana, Ecology Department\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"unit\": \"mm\"\n        },\n        {\n            \"name\": \"VegetationIndex\",\n            \"unit\": \"NDVI\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Fixed-point monitoring, annual surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term Ecological Changes in Yellowstone\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/yellowstone_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"12MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67576", "text": "{\n    \"dataset_name\": \"AirQuality_London\",\n    \"creator\": {\n        \"name\": \"London Environmental Agency\",\n        \"affiliation\": \"Greater London Authority\"\n    },\n    \"date_collected\": \"2022-01-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/london_airquality.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Real-time air quality data.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67577", "text": "{\n    \"dataset_name\": \"Global Atmospheric Composition Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Center for Atmospheric Research\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Dioxide Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous measurements from global monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Atmospheric Changes and Global Warming\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Smith, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/atmospheric_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"15 GB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67577", "text": "{\n    \"dataset_name\": \"Ocean Temperature and Salinity Data\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2022-07-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Ocean Current Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Ship-based measurements and buoy data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Oceanographic Studies of the Atlantic\",\n            \"authors\": [\n                \"Lee, D.\",\n                \"Brown, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"20 GB\",\n        \"annotations\": \"Quality control performed\"\n    }\n}"}
{"_id": "Academic--research_data--p--67578", "text": "{\n    \"dataset_name\": \"Chest X-Ray Images (Pneumonia)\",\n    \"creator\": {\n        \"name\": \"NIH Clinical Center\",\n        \"affiliation\": \"National Institutes of Health\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"image_file\",\n            \"units\": \"JPEG\"\n        },\n        {\n            \"name\": \"pneumonia_status\",\n            \"units\": \"boolean\"\n        }\n    ],\n    \"data_format\": \"JPEG\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Retrospective analysis of clinical data\",\n    \"related_publications\": [\n        {\n            \"title\": \"ChestX-ray8: Dataset and baseline classification\",\n            \"year\": 2017\n        }\n    ],\n    \"download_url\": \"https://nihcc.app.box.com/v/ChestXray-NIHCC\",\n    \"metadata\": {\n        \"data_size\": \"100GB\",\n        \"annotations\": \"Expert radiologists\"\n    }\n}"}
{"_id": "Academic--research_data--n--67578", "text": "{\n    \"dataset_name\": \"Human Brain Atlas\",\n    \"creator\": {\n        \"name\": \"Allen Institute for Brain Science\",\n        \"affiliation\": \"Allen Institute\"\n    },\n    \"date_collected\": \"2022-01-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"brain_region\",\n            \"units\": \"anatomical location\"\n        },\n        {\n            \"name\": \"cell_type\",\n            \"units\": \"neuronal or glial\"\n        },\n        {\n            \"name\": \"gene_expression\",\n            \"units\": \"RNA sequence data\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Post-mortem tissue collection\",\n    \"related_publications\": [\n        {\n            \"title\": \"A high-resolution atlas of the adult human brain\",\n            \"year\": 2016\n        }\n    ],\n    \"download_url\": \"http://www.brain-map.org/\",\n    \"metadata\": {\n        \"data_size\": \"500GB\",\n        \"annotations\": \"Automated segmentation and labeling\"\n    }\n}"}
{"_id": "Academic--research_data--p--67579", "text": "{\n    \"dataset_name\": \"Regional Air Quality Monitoring - Eastern US\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency - Region 3\",\n        \"affiliation\": \"US EPA\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Continuous monitoring stations across multiple states\",\n    \"related_publications\": [\n        {\n            \"title\": \"Regional Trends in Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/regional_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67579", "text": "{\n    \"dataset_name\": \"NYC Urban Air Pollution Study\",\n    \"creator\": {\n        \"name\": \"Columbia University Environmental Lab\",\n        \"affiliation\": \"Columbia University\"\n    },\n    \"date_collected\": \"2023-07-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"CO\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Black Carbon\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Mobile monitoring van traversing Manhattan\",\n    \"related_publications\": [\n        {\n            \"title\": \"Spatial Distribution of Air Pollutants in NYC\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/nyc_pollution.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data has been corrected for meteorological factors.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67580", "text": "{\n    \"dataset_name\": \"Global Air Quality Monitoring\",\n    \"creator\": {\n        \"name\": \"World Health Organization\",\n        \"affiliation\": \"WHO Headquarters\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Air Quality Database\",\n            \"authors\": \"WHO Team\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67580", "text": "{\n    \"dataset_name\": \"Coral Reef Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute\",\n        \"affiliation\": \"University of Marine Biology\"\n    },\n    \"date_collected\": \"2022-01-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Coral Species Count\",\n            \"units\": \"Count\"\n        },\n        {\n            \"name\": \"Fish Species Diversity\",\n            \"units\": \"Shannon Index\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Underwater visual census\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coral Reef Health Assessment\",\n            \"authors\": \"Dr. Emily Carter\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/coral_reef_data.json\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Geographic coordinates included\"\n    }\n}"}
{"_id": "Academic--research_data--p--67581", "text": "{\n    \"dataset_name\": \"National Water Quality Monitoring Database\",\n    \"creator\": {\n        \"name\": \"US Environmental Protection Agency\",\n        \"affiliation\": \"EPA\"\n    },\n    \"date_collected\": \"2023-06-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Systematic grab samples collected weekly at designated monitoring stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Water Quality Assessment Program\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://www.example.com/waterqualitydata.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67581", "text": "{\n    \"dataset_name\": \"Coastal Ecosystem Biodiversity Survey\",\n    \"creator\": {\n        \"name\": \"Marine Research Institute\",\n        \"affiliation\": \"MRI\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Coral Cover\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Random transects within designated coastal areas.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Marine Biodiversity in Coastal Regions\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://www.example.com/biodiversitydata.json\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data includes species identification codes.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67582", "text": "{\n    \"dataset_name\": \"Global Temperature and Ecosystem Response Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Eleanor Vance\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Species Abundance\",\n            \"units\": \"Individuals per square meter\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"Degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"Degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Random stratified sampling across biomes\",\n    \"related_publications\": [\n        {\n            \"title\": \"Temperature-driven shifts in ecosystem composition\",\n            \"authors\": [\n                \"Vance, E.\",\n                \"Smith, J.\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_ecosystem_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2GB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67582", "text": "{\n    \"dataset_name\": \"Historical Rainfall Patterns in the Amazon\",\n    \"creator\": {\n        \"name\": \"Dr. Ricardo Silva\",\n        \"affiliation\": \"National Institute for Amazonian Research\"\n    },\n    \"date_collected\": \"2021-12-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"millimeters\"\n        },\n        {\n            \"name\": \"Month\",\n            \"units\": \"Integer (1-12)\"\n        },\n        {\n            \"name\": \"Year\",\n            \"units\": \"Integer\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"CC-BY-SA 4.0\",\n    \"sampling_method\": \"Data from weather stations across the Amazon basin\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Amazonian rainfall\",\n            \"authors\": [\n                \"Silva, R.\",\n                \"Oliveira, M.\"\n            ],\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_rainfall.xml\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data has been cleaned for outliers.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67583", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset 2020-2023\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2023-11-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"gain\",\n            \"units\": \"hectares\"\n        },\n        {\n            \"name\": \"loss\",\n            \"units\": \"hectares\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite imagery from Landsat 5, 7, 8 and Sentinel-2 missions, processed with a standardized algorithm to detect forest cover change.  Change detection conducted annually, with quality assessment performed using independent validation datasets and expert review. Stratified random sampling used for validation.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2012\",\n            \"authors\": [\n                \"Hansen\",\n                \"Potapov\",\n                \"Moore\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/glad/gee-v1-4\",\n    \"metadata\": {\n        \"data_size\": \"150 GB\",\n        \"annotations\": \"Contains information on tree cover gain and loss globally.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67583", "text": "{\n    \"dataset_name\": \"Simulated Weather Data - Small Region\",\n    \"creator\": {\n        \"name\": \"Jane Doe\",\n        \"affiliation\": \"Example University\"\n    },\n    \"date_collected\": \"2021-05-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Data generated using a basic weather model.\",\n    \"related_publications\": [],\n    \"download_url\": \"http://example.com/weatherdata.csv\",\n    \"metadata\": {\n        \"data_size\": \"10 MB\",\n        \"annotations\": \"Small dataset for testing purposes.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67584", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter less than 2.5 micrometers in diameter\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppb\",\n            \"description\": \"Nitrogen dioxide concentration\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes readings from 100 monitoring stations.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67584", "text": "{\n    \"dataset_name\": \"SoilComposition_Amazon\",\n    \"creator\": {\n        \"name\": \"National Institute of Amazonian Research\",\n        \"affiliation\": \"Manaus, Brazil\"\n    },\n    \"date_collected\": \"2022-11-01T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\",\n            \"description\": \"Soil pH level\"\n        },\n        {\n            \"name\": \"OrganicMatter\",\n            \"units\": \"%\",\n            \"description\": \"Percentage of organic matter in the soil\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Random sampling across the Amazon rainforest\",\n    \"related_publications\": [\n        {\n            \"title\": \"Soil Characteristics of the Amazon\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://amazondata.org/soil.json\",\n    \"metadata\": {\n        \"data_size\": \"30MB\",\n        \"annotations\": \"Data represents samples from 50 different locations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67585", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA Great Lakes Environmental Research Laboratory\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Automated buoys and ship-based sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67585", "text": "{\n    \"dataset_name\": \"Atmospheric Pollutant Levels in Urban Areas\",\n    \"creator\": {\n        \"name\": \"City Environmental Agency\",\n        \"affiliation\": \"Local Government\"\n    },\n    \"date_collected\": \"2022-01-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide Concentration\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Restricted Use - Non-Commercial\",\n    \"sampling_method\": \"Fixed monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Index trends in the city\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data has undergone basic validation.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67586", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"National Centers for Environmental Information (NCEI)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"surface_temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees East\"\n        },\n        {\n            \"name\": \"time\",\n            \"units\": \"YYYY-MM-DD\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Global land and ocean surface measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temperature.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Quality control flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67586", "text": "{\n    \"dataset_name\": \"Social Media Sentiment Analysis\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"Social Science Research Center\"\n    },\n    \"date_collected\": \"2023-03-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tweet_text\",\n            \"units\": \"text\"\n        },\n        {\n            \"name\": \"user_id\",\n            \"units\": \"integer\"\n        },\n        {\n            \"name\": \"sentiment_score\",\n            \"units\": \"dimensionless\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Twitter API stream\",\n    \"related_publications\": [\n        {\n            \"title\": \"Sentiment Analysis on Twitter\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/social_media_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Sentiment analysis labels\"\n    }\n}"}
{"_id": "Academic--research_data--p--67587", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Center for Limnology\",\n        \"affiliation\": \"University of Wisconsin-Madison\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"µg/L\"\n        },\n        {\n            \"name\": \"Total Phosphorus\",\n            \"units\": \"µg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Regular depth profile measurements taken weekly during the growing season.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in water quality of Lake Mendota\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lakemendota_wq.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
