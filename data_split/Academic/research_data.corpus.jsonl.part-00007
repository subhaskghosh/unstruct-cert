{"_id": "Academic--research_data--n--71827", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data - 1980-2000\",\n    \"creator\": {\n        \"name\": \"Dr. Robert Jones\",\n        \"affiliation\": \"National Weather Service\"\n    },\n    \"date_collected\": \"2000-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Rain gauge measurements, daily\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term Rainfall Patterns\",\n            \"year\": 2002\n        }\n    ],\n    \"download_url\": \"https://example.com/historical_rainfall.csv\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Some missing data values\"\n    }\n}"}
