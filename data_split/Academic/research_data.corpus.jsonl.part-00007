{"_id": "Academic--research_data--p--69167", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Science Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--69167", "text": "{\n    \"dataset_name\": \"Water Quality Assessment of Rivers\",\n    \"creator\": {\n        \"name\": \"Hydrology Research Group\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Grab samples collected weekly\",\n    \"related_publications\": [\n        {\n            \"title\": \"Effects of Agricultural Runoff on River Ecosystems\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/water_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Sample locations mapped\"\n    }\n}"}
{"_id": "Academic--research_data--p--69168", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Environments\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Li, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes hourly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69168", "text": "{\n    \"dataset_name\": \"Soil Moisture Levels in Agricultural Fields\",\n    \"creator\": {\n        \"name\": \"Prof. David Miller\",\n        \"affiliation\": \"Iowa State University\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Soil Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Nitrogen Levels\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Weekly soil samples\",\n    \"related_publications\": [\n        {\n            \"title\": \"Optimizing Irrigation Schedules for Corn\",\n            \"authors\": [\n                \"Miller, D.\",\n                \"Garcia, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/soil_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data represents average weekly measurements.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69169", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Year\",\n            \"units\": \"year\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global average temperature calculation\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"authors\": [\n                \"Hansen\",\n                \"Sato\",\n                \"Ruedy\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"1.2MB\",\n        \"annotations\": \"Monthly and annual temperature anomalies\"\n    }\n}"}
{"_id": "Academic--research_data--n--69169", "text": "{\n    \"dataset_name\": \"Ocean Acidification Measurements\",\n    \"creator\": {\n        \"name\": \"NOAA Pacific Marine Environmental Laboratory\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2022-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"pH units\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Ship-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Acidification Impacts\",\n            \"authors\": [\n                \"Feely\",\n                \"Alin\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.pmel.noaa.gov/co2/\",\n    \"metadata\": {\n        \"data_size\": \"2.5MB\",\n        \"annotations\": \"Measurements of ocean pH and carbon dioxide levels\"\n    }\n}"}
{"_id": "Academic--research_data--p--69170", "text": "{\n    \"dataset_name\": \"Urban Temperature Monitoring - Boston\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    },\n    \"date_collected\": \"2023-02-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"unit\": \"percentage\"\n        },\n        {\n            \"name\": \"wind_speed\",\n            \"unit\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Hourly measurements from fixed sensors\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Heat Island Effect in Boston\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/boston_temp.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Sensor locations are geocoded.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69170", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey - Amazon\",\n    \"creator\": {\n        \"name\": \"Dr. Ricardo Silva\",\n        \"affiliation\": \"University of Sao Paulo\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"species_count\",\n            \"unit\": \"count\"\n        },\n        {\n            \"name\": \"tree_height\",\n            \"unit\": \"meters\"\n        },\n        {\n            \"name\": \"temperature\",\n            \"unit\": \"Fahrenheit\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Random sampling plots within the Amazon rainforest\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in the Amazon\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_bio.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Species identification validated by experts.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69171", "text": "{\n    \"dataset_name\": \"UCI Machine Learning Repository - Iris Dataset\",\n    \"creator\": {\n        \"name\": \"Jeffrey Mark Siskind\",\n        \"affiliation\": \"UCI Department of Information and Computer Science\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"sepal_length\",\n            \"units\": \"cm\"\n        },\n        {\n            \"name\": \"sepal_width\",\n            \"units\": \"cm\"\n        },\n        {\n            \"name\": \"petal_length\",\n            \"units\": \"cm\"\n        },\n        {\n            \"name\": \"petal_width\",\n            \"units\": \"cm\"\n        },\n        {\n            \"name\": \"species\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0: Public Domain\",\n    \"sampling_method\": \"Collected from measurements of Iris flowers\",\n    \"related_publications\": [\n        {\n            \"title\": \"Fisher, R. A. (1936). The use of multiple measurements in taxonomic problems.\",\n            \"year\": 1936\n        }\n    ],\n    \"download_url\": \"https://archive.ics.uci.edu/ml/datasets/iris\",\n    \"metadata\": {\n        \"data_size\": \"64KB\",\n        \"annotations\": \"150 samples with 4 features\"\n    }\n}"}
{"_id": "Academic--research_data--n--69171", "text": "{\n    \"dataset_name\": \"Proprietary Customer Data - Marketing Campaign\",\n    \"creator\": {\n        \"name\": \"Acme Marketing Solutions\",\n        \"affiliation\": \"Acme Corp\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"customer_id\",\n            \"units\": \"integer\"\n        },\n        {\n            \"name\": \"purchase_amount\",\n            \"units\": \"USD\"\n        },\n        {\n            \"name\": \"age\",\n            \"units\": \"years\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Customer transaction logs\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/proprietary_data\",\n    \"metadata\": {\n        \"data_size\": \"1MB\",\n        \"annotations\": \"1000 customer records\"\n    }\n}"}
{"_id": "Academic--research_data--p--69172", "text": "{\n    \"dataset_name\": \"Human Brain Imaging Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, San Francisco\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"fMRI signal\",\n            \"units\": \"arbitrary units\"\n        },\n        {\n            \"name\": \"Reaction Time\",\n            \"units\": \"milliseconds\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"fMRI scanning during cognitive tasks\",\n    \"related_publications\": [\n        {\n            \"title\": \"Neural Correlates of Decision Making\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Brown, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_imaging_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Region of Interest (ROI) masks included\"\n    }\n}"}
{"_id": "Academic--research_data--n--69172", "text": "{\n    \"dataset_name\": \"Rodent Olfactory System Data\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Firing Rate\",\n            \"units\": \"Hz\"\n        },\n        {\n            \"name\": \"Odor Concentration\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Single-unit recording in the olfactory bulb\",\n    \"related_publications\": [\n        {\n            \"title\": \"Encoding of Odor Identity in the Rodent Olfactory Bulb\",\n            \"authors\": [\n                \"Lee, D.\",\n                \"Wilson, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/olfactory_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Spike sorting results provided\"\n    }\n}"}
{"_id": "Academic--research_data--p--69173", "text": "{\n    \"dataset_name\": \"Atmospheric Composition and Climate Impacts Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Center for Atmospheric Research\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Pressure\",\n            \"units\": \"Pascals\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"Percentage\"\n        },\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Atmospheric Composition on Regional Climate\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Johnson, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2GB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
