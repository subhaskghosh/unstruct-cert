{"_id": "Academic--research_data--p--69317", "text": "{\n    \"dataset_name\": \"Oxford Climate Temperature Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Oxford, Department of Earth Sciences\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature_celsius\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"pressure\",\n            \"units\": \"hPa\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Automated weather station readings, hourly intervals\",\n    \"related_publications\": [\n        {\n            \"title\": \"Recent Trends in Regional Temperature\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/oxford_climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Quality controlled data, missing values filled using linear interpolation\"\n    }\n}"}
{"_id": "Academic--research_data--n--69317", "text": "{\n    \"dataset_name\": \"Global Precipitation Measurements\",\n    \"creator\": {\n        \"name\": \"Dr. James Lee\",\n        \"affiliation\": \"NASA Goddard Space Flight Center\"\n    },\n    \"date_collected\": \"2022-11-01T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"precipitation_mm\",\n            \"units\": \"millimeters\"\n        },\n        {\n            \"name\": \"wind_speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Satellite-based measurements, daily averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Spatial Distribution of Precipitation\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/global_precipitation.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data collected from multiple satellite missions\"\n    }\n}"}
