{"_id": "Academic--research_data--p--71025", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring - 2023\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Windsor, Great Lakes Institute for Environmental Research\"\n    },\n    \"date_collected\": \"2023-05-15T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"unit\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"unit\": \"unitless\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"unit\": \"NTU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly at 5 monitoring stations around the lake.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Recent Trends in Lake Erie Water Quality\",\n            \"year\": 2023,\n            \"authors\": [\n                \"Carter, E.\",\n                \"Li, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lakeerie_wq_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"8.5MB\",\n        \"annotations\": \"Data includes quality control flags. Missing values are indicated by 'NA'.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71025", "text": "{\n    \"dataset_name\": \"Global Soil Nutrient Levels - 1990-2010\",\n    \"creator\": {\n        \"name\": \"FAO Land and Water Division\",\n        \"affiliation\": \"Food and Agriculture Organization of the United Nations\"\n    },\n    \"date_collected\": \"2010-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Nitrogen Content\",\n            \"unit\": \"ppm\"\n        },\n        {\n            \"name\": \"Phosphorus Content\",\n            \"unit\": \"ppm\"\n        },\n        {\n            \"name\": \"Potassium Content\",\n            \"unit\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"FAO Data License\",\n    \"sampling_method\": \"Composite soil samples collected from agricultural regions worldwide.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Assessment of Soil Nutrient Depletion\",\n            \"year\": 2012,\n            \"authors\": [\n                \"Smith, P.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_soil_nutrients.xml\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data is aggregated by country.  Accuracy varies by region.\"\n    }\n}"}
