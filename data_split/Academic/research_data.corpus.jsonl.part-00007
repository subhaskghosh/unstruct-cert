{"_id": "Academic--research_data--p--66026", "text": "{\n    \"dataset_name\": \"Chest X-Ray Images for Pneumonia Detection\",\n    \"creator\": {\n        \"name\": \"Radiology Department, Massachusetts General Hospital\",\n        \"affiliation\": \"Harvard Medical School\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image Filename\",\n            \"units\": \"string\"\n        },\n        {\n            \"name\": \"Pneumonia Status\",\n            \"units\": \"binary (0/1)\"\n        },\n        {\n            \"name\": \"Patient Age\",\n            \"units\": \"years\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Retrospective cohort study of patients presenting with respiratory symptoms.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Pneumonia Detection on Chest X-Rays\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray_pneumonia\",\n    \"metadata\": {\n        \"data_size\": \"50 GB\",\n        \"annotations\": \"Expert radiologists labeled each image for pneumonia presence.\"\n    }\n}"}
{"_id": "Academic--research_data--n--66026", "text": "{\n    \"dataset_name\": \"Brain MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Neuroimaging Research Group, Stanford University\",\n        \"affiliation\": \"Stanford School of Medicine\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image ID\",\n            \"units\": \"string\"\n        },\n        {\n            \"name\": \"MRI Sequence\",\n            \"units\": \"categorical\"\n        },\n        {\n            \"name\": \"Patient Gender\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Prospective study of healthy adults and patients with neurological disorders.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Machine Learning for Brain Tumor Segmentation\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_mri\",\n    \"metadata\": {\n        \"data_size\": \"100 GB\",\n        \"annotations\": \"Automated segmentation masks available for specific brain structures.\"\n    }\n}"}
