{"_id": "Academic--research_data--p--66900", "text": "{\n    \"dataset_name\": \"Chest X-Ray Images (COVID-19)\",\n    \"creator\": {\n        \"name\": \"Stanford Machine Learning Group\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image Filename\",\n            \"units\": \"string\"\n        },\n        {\n            \"name\": \"Patient Age\",\n            \"units\": \"years\"\n        },\n        {\n            \"name\": \"COVID-19 Status\",\n            \"units\": \"boolean\"\n        }\n    ],\n    \"data_format\": \"JPEG\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Retrospective cohort study from hospital records\",\n    \"related_publications\": [\n        {\n            \"title\": \"COVID-19 Detection using Chest X-Ray Images\",\n            \"authors\": [\n                \"Wang, L.\",\n                \"Zhang, Y.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray_covid19.zip\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"bounding boxes around lung regions\"\n    }\n}"}
