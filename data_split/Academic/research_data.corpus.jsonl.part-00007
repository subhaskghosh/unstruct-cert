{"_id": "Academic--research_data--n--69538", "text": "{\n    \"dataset_name\": \"Global Precipitation Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Stanford University, Department of Civil and Environmental Engineering\"\n    },\n    \"date_collected\": \"2022-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Satellite imagery and ground-based radar\",\n    \"related_publications\": [\n        {\n            \"title\": \"Analyzing Precipitation Patterns Worldwide\",\n            \"authors\": [\n                \"Lee, D.\",\n                \"Brown, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_precipitation.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes quality control flags\"\n    }\n}"}
