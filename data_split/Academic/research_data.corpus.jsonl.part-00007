{"_id": "Academic--research_data--p--69347", "text": "{\n    \"dataset_name\": \"Lung Image Dataset for Pneumonia Detection\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Massachusetts Institute of Technology\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"image_path\",\n            \"unit\": \"file path\"\n        },\n        {\n            \"name\": \"diagnosis\",\n            \"unit\": \"categorical: pneumonia, normal, covid-19\"\n        }\n    ],\n    \"data_format\": \"PNG\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Retrospective cohort study with data from multiple hospitals\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Pneumonia Detection\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/lung_images.zip\",\n    \"metadata\": {\n        \"data_size\": \"8GB\",\n        \"annotations\": \"Radiologist-verified diagnoses\",\n        \"data_points\": 6250\n    }\n}"}
