{"_id": "Academic--research_data--p--66407", "text": "{\n    \"dataset_name\": \"Cardiovascular MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University Medical Center\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Patient ID\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"MRI Image\",\n            \"units\": \"DICOM\"\n        },\n        {\n            \"name\": \"Left Ventricle Volume\",\n            \"units\": \"mL\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Retrospective cohort study\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Cardiac Function Assessment using MRI\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/cardio_mri.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Expert cardiologist annotations included\"\n    }\n}"}
