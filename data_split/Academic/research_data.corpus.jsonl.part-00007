{"_id": "Academic--research_data--p--69964", "text": "{\n    \"dataset_name\": \"ImageNet-2024\",\n    \"creator\": {\n        \"name\": \"Deng, Jia\",\n        \"affiliation\": \"Princeton University\"\n    },\n    \"date_collected\": \"2024-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"image_id\",\n            \"description\": \"Unique identifier for each image.\",\n            \"units\": \"string\"\n        },\n        {\n            \"variable_name\": \"label\",\n            \"description\": \"Image category label.\",\n            \"units\": \"string\"\n        },\n        {\n            \"variable_name\": \"pixel_data\",\n            \"description\": \"Raw pixel data of the image.\",\n            \"units\": \"integer\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0\",\n    \"sampling_method\": \"Web scraping and manual annotation\",\n    \"related_publications\": [\n        {\n            \"title\": \"ImageNet: A Large-Scale Visual Recognition Challenge\",\n            \"year\": 2012,\n            \"authors\": [\n                \"Deng, Jia\",\n                \"Dong, Wei\",\n                \"Socher, Rui\"\n            ]\n        },\n        {\n            \"title\": \"Advances in Machine Learning for Image Classification\",\n            \"year\": 2023,\n            \"authors\": [\n                \"Smith, John\",\n                \"Jones, Alice\"\n            ]\n        }\n    ],\n    \"download_url\": \"http://www.example.com/imagenet2024.csv\",\n    \"metadata\": {\n        \"data_size\": \"100GB\",\n        \"annotations\": \"Bounding boxes, segmentation masks\"\n    }\n}"}
{"_id": "Academic--research_data--n--69964", "text": "{\n    \"dataset_name\": \"Medical Records - 2023\",\n    \"creator\": {\n        \"name\": \"Brown, Emily\",\n        \"affiliation\": \"City Hospital\"\n    },\n    \"date_collected\": \"2023-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"patient_id\",\n            \"description\": \"Unique patient identifier.\",\n            \"units\": \"string\"\n        },\n        {\n            \"variable_name\": \"age\",\n            \"description\": \"Patient age in years.\",\n            \"units\": \"years\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"HIPAA Compliant\",\n    \"sampling_method\": \"Electronic Health Records\",\n    \"related_publications\": [\n        {\n            \"title\": \"Analysis of Patient Demographics\",\n            \"year\": 2024,\n            \"authors\": [\n                \"Brown, Emily\",\n                \"Davis, Robert\"\n            ]\n        }\n    ],\n    \"download_url\": \"http://www.example.com/medicalrecords.json\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Diagnoses, treatment plans\"\n    }\n}"}
