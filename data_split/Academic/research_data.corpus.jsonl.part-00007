{"_id": "Academic--research_data--p--67800", "text": "{\n    \"dataset_name\": \"Brain Tumor MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Massachusetts General Hospital\"\n    },\n    \"date_collected\": \"2023-06-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"MRI Image\",\n            \"units\": \"DICOM\"\n        },\n        {\n            \"name\": \"Tumor Grade\",\n            \"units\": \"1-4\"\n        },\n        {\n            \"name\": \"Patient Age\",\n            \"units\": \"years\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Prospective cohort study\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Brain Tumor Segmentation\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_tumor_mri\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Expert Radiologist annotations\"\n    }\n}"}
{"_id": "Academic--research_data--n--67800", "text": "{\n    \"dataset_name\": \"Synthetic CT Scans\",\n    \"creator\": {\n        \"name\": \"AI Research Labs\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-11-20T14:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CT Image\",\n            \"units\": \"DICOM\"\n        },\n        {\n            \"name\": \"Organ Label\",\n            \"units\": \"Categorical\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Generative Adversarial Network (GAN)\",\n    \"related_publications\": [\n        {\n            \"title\": \"Generating Realistic Medical Images\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/synthetic_ct\",\n    \"metadata\": {\n        \"data_size\": \"20GB\",\n        \"annotations\": \"Automatically generated labels\"\n    }\n}"}
{"_id": "Academic--research_data--p--67801", "text": "{\n    \"dataset_name\": \"Lung Nodule Analysis Dataset\",\n    \"creator\": {\n        \"name\": \"Radiology Research Group\",\n        \"affiliation\": \"University of California, San Francisco\"\n    },\n    \"date_collected\": \"2023-06-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"image_resolution_x\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"name\": \"image_resolution_y\",\n            \"units\": \"pixels\"\n        },\n        {\n            \"name\": \"nodule_presence\",\n            \"units\": \"boolean\"\n        },\n        {\n            \"name\": \"nodule_size\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Random sampling from chest CT scans\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Lung Nodule Detection using Deep Learning\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lung_nodule_dataset\",\n    \"metadata\": {\n        \"data_size\": \"100GB\",\n        \"annotations\": \"Radiologist-verified nodule annotations\"\n    }\n}"}
