{"_id": "Academic--research_data--p--67363", "text": "{\n    \"dataset_name\": \"Water Quality Monitoring in the Chesapeake Bay\",\n    \"creator\": {\n        \"name\": \"Chesapeake Bay Program\",\n        \"affiliation\": \"US Environmental Protection Agency\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Phosphate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"µg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Grab samples collected weekly at fixed stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Nutrient Trends in the Chesapeake Bay\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/chesapeake_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data has been quality controlled and validated.\"\n    }\n}"}
