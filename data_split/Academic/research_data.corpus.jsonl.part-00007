{"_id": "Academic--research_data--n--68929", "text": "{\n    \"dataset_name\": \"Global Forest Biomass\",\n    \"creator\": {\n        \"name\": \"NASA Earth Exchange\",\n        \"affiliation\": \"Global Modeling and Assimilation Office\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Aboveground Biomass Density\",\n            \"units\": \"Mg/ha\"\n        },\n        {\n            \"name\": \"Belowground Biomass Density\",\n            \"units\": \"Mg/ha\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC-BY-SA\",\n    \"sampling_method\": \"Satellite remote sensing and ground measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Assessment of Forest Biomass\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://earthdata.nasa.gov/forestbiomass\",\n    \"metadata\": {\n        \"data_size\": \"600MB\",\n        \"annotations\": \"Data covers the entire globe.\"\n    }\n}"}
