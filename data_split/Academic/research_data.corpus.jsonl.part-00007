{"_id": "Academic--research_data--p--69437", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Anomalies Dataset\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2020-02-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"unit\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"unit\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data, monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature in 2020\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ],\n            \"journal\": \"Nature Climate Change\"\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Contains annual temperature anomalies relative to a baseline period.\"\n    }\n}"}
