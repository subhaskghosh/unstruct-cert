{"_id": "Academic--research_data--p--66625", "text": "{\n    \"dataset_name\": \"Brain MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Massachusetts General Hospital\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"age\",\n            \"unit\": \"years\"\n        },\n        {\n            \"name\": \"scan_type\",\n            \"unit\": \"MRI sequence\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Random sampling of patients undergoing routine MRI scans\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Brain Tumor Segmentation\",\n            \"authors\": \"Carter et al.\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_mri_dataset\",\n    \"metadata\": {\n        \"data_size\": \"100GB\",\n        \"annotations\": \"Tumor segmentations provided\"\n    }\n}"}
{"_id": "Academic--research_data--n--66625", "text": "{\n    \"dataset_name\": \"Chest X-Ray Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"age\",\n            \"unit\": \"years\"\n        },\n        {\n            \"name\": \"view\",\n            \"unit\": \"AP or PA\"\n        }\n    ],\n    \"data_format\": \"PNG\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Prospective collection from patients presenting with respiratory symptoms\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Pneumonia Detection\",\n            \"authors\": \"Lee et al.\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray_dataset\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Pneumonia classifications provided\"\n    }\n}"}
{"_id": "Academic--research_data--p--66626", "text": "{\n    \"dataset_name\": \"Beijing Air Quality Dataset\",\n    \"creator\": {\n        \"name\": \"Wang, Li\",\n        \"affiliation\": \"Tsinghua University\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"μg/m³\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"units\": \"μg/m³\"\n        },\n        {\n            \"name\": \"SO2\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Beijing\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/beijing_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data is quality-controlled and missing values are imputed using linear interpolation.\"\n    }\n}"}
{"_id": "Academic--research_data--n--66626", "text": "{\n    \"dataset_name\": \"London Air Pollution Data\",\n    \"creator\": {\n        \"name\": \"Smith, John\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"O3\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"CO\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Mobile monitoring vans\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Air Pollution in London\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_pollution.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Raw data with minimal processing.\"\n    }\n}"}
{"_id": "Academic--research_data--p--66627", "text": "{\n    \"dataset_name\": \"Brain Tumor MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Massachusetts General Hospital\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"tumor_grade\",\n            \"unit\": \"I-IV\"\n        },\n        {\n            \"name\": \"image_resolution\",\n            \"unit\": \"pixels\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Prospective cohort study\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Brain Tumor Segmentation\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/braintumor_mri.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Expert radiologist annotations included\"\n    }\n}"}
{"_id": "Academic--research_data--n--66627", "text": "{\n    \"dataset_name\": \"Chest X-Ray Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2022-12-20T14:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"pneumonia_status\",\n            \"unit\": \"positive/negative\"\n        },\n        {\n            \"name\": \"image_quality\",\n            \"unit\": \"scale of 1-5\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Retrospective analysis of hospital records\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Pneumonia Detection\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/chestxray.csv\",\n    \"metadata\": {\n        \"data_size\": \"800 MB\",\n        \"annotations\": \"Automated annotations with manual verification\"\n    }\n}"}
{"_id": "Academic--research_data--p--66628", "text": "{\n    \"dataset_name\": \"ImageNet-2023\",\n    \"creator\": {\n        \"name\": \"Deng Jiong\",\n        \"affiliation\": \"Princeton University\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"label\",\n            \"units\": \"category\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0\",\n    \"sampling_method\": \"Web scraping and manual annotation\",\n    \"related_publications\": [\n        {\n            \"title\": \"ImageNet: A Large-Scale Visual Recognition Challenge\",\n            \"year\": 2012\n        },\n        {\n            \"title\": \"Deep Learning for Image Recognition\",\n            \"year\": 2015\n        }\n    ],\n    \"download_url\": \"https://imagenet.org/download\",\n    \"metadata\": {\n        \"data_size\": \"150 GB\",\n        \"annotations\": \"Bounding boxes and object categories\"\n    }\n}"}
{"_id": "Academic--research_data--n--66628", "text": "{\n    \"dataset_name\": \"Medical Records - 2022\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"Healthcare Institute\"\n    },\n    \"date_collected\": \"2022-12-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"patient_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"diagnosis\",\n            \"units\": \"medical condition\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"HIPAA compliant\",\n    \"sampling_method\": \"Electronic Health Records\",\n    \"related_publications\": [\n        {\n            \"title\": \"Predictive Modeling in Healthcare\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://healthcare.org/data\",\n    \"metadata\": {\n        \"data_size\": \"50 GB\",\n        \"annotations\": \"Patient demographics and medical history\"\n    }\n}"}
{"_id": "Academic--research_data--p--66629", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"NASA GISS\",\n        \"affiliation\": \"Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Year\",\n            \"units\": \"year\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global average from station data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Monthly data\"\n    }\n}"}
{"_id": "Academic--research_data--n--66629", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Rainfall\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Location\",\n            \"units\": \"latitude/longitude\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Daily measurements from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Rainfall Patterns in the US\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://www.ncdc.noaa.gov/cdo-web/\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Daily data for the US\"\n    }\n}"}
