{"_id": "Academic--research_data--n--69780", "text": "{\n    \"dataset_name\": \"Arctic Sea Ice Extent\",\n    \"creator\": {\n        \"name\": \"National Snow and Ice Data Center\",\n        \"affiliation\": \"University of Colorado Boulder\"\n    },\n    \"date_collected\": \"2023-05-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Ice Extent\",\n            \"units\": \"square kilometers\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Satellite-derived sea ice concentration, daily averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Arctic Sea Ice Trends\",\n            \"authors\": [\n                \"Meier, W.\",\n                \"Stroeve, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/arctic_sea_ice.nc\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Daily sea ice extent measurements for the Arctic region.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69781", "text": "{\n    \"dataset_name\": \"Urban Heat Island Effect - Temperature Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\",\n            \"description\": \"Ambient air temperature\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"%\",\n            \"description\": \"Relative humidity\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Fixed-interval measurements from urban and rural sensors.\",\n    \"related_publications\": [\n        {\n            \"title\": \"The Impact of Urbanization on Local Temperatures\",\n            \"authors\": \"Carter, E. et al.\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_heat_island_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69781", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Study\",\n    \"creator\": {\n        \"name\": \"Professor David Lee\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"species_count\",\n            \"units\": \"count\",\n            \"description\": \"Number of tree species observed.\"\n        },\n        {\n            \"name\": \"leaf_area\",\n            \"units\": \"m^2\",\n            \"description\": \"Total leaf area per plot\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Randomly selected forest plots.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in Redwood Forests\",\n            \"authors\": \"Lee, D. et al.\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Coordinates of sampling locations included.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69782", "text": "{\n    \"dataset_name\": \"Human Brain Connectivity Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Region A Activation\",\n            \"units\": \"arbitrary units\"\n        },\n        {\n            \"name\": \"Region B Activation\",\n            \"units\": \"arbitrary units\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"fMRI scans during resting state\",\n    \"related_publications\": [\n        {\n            \"title\": \"Connectivity Patterns in the Human Brain\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_connectivity.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2GB\",\n        \"annotations\": \"Data includes age and gender information\"\n    }\n}"}
{"_id": "Academic--research_data--n--69782", "text": "{\n    \"dataset_name\": \"Mouse Olfactory Receptor Data\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"MIT\"\n    },\n    \"date_collected\": \"2022-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Receptor Type\",\n            \"units\": \"categorical\"\n        },\n        {\n            \"name\": \"Odor Response\",\n            \"units\": \"mV\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Patch-clamp recordings\",\n    \"related_publications\": [\n        {\n            \"title\": \"Odorant Receptor Responses in Mice\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/mouse_olfactory.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data includes strain information\"\n    }\n}"}
{"_id": "Academic--research_data--p--69783", "text": "{\n    \"dataset_name\": \"Urban Temperature Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"unit\": \"percentage\"\n        },\n        {\n            \"name\": \"location_id\",\n            \"unit\": \"integer\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Hourly readings from automated sensors\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Heat Island Effect in London\",\n            \"authors\": \"Carter, E., et al.\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_temperature.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data cleaned and validated for accuracy\"\n    }\n}"}
{"_id": "Academic--research_data--n--69783", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Study - Amazon\",\n    \"creator\": {\n        \"name\": \"Dr. Ricardo Silva\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"species_count\",\n            \"unit\": \"integer\"\n        },\n        {\n            \"name\": \"tree_height\",\n            \"unit\": \"meters\"\n        },\n        {\n            \"name\": \"canopy_cover\",\n            \"unit\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Random plot sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment in the Amazon Rainforest\",\n            \"authors\": \"Silva, R., et al.\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Species identified to the genus level\"\n    }\n}"}
{"_id": "Academic--research_data--p--69784", "text": "{\n    \"dataset_name\": \"Brain Tumor MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Institute of Health\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"image_path\",\n            \"units\": \"path to image file\"\n        },\n        {\n            \"name\": \"tumor_type\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Retrospective study of anonymized patient data\",\n    \"related_publications\": [\n        {\n            \"title\": \"MRI-based diagnosis of brain tumors\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Smith, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_tumor_mri_dataset.csv\",\n    \"metadata\": {\n        \"data_size\": \"2.5 GB\",\n        \"annotations\": \"Tumor boundaries are manually annotated by radiologists.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69784", "text": "{\n    \"dataset_name\": \"Chest X-Ray Images\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"University Hospital\"\n    },\n    \"date_collected\": \"2022-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"image_path\",\n            \"units\": \"path to image file\"\n        },\n        {\n            \"name\": \"pneumonia_status\",\n            \"units\": \"binary\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Prospective study of patients admitted to the emergency department\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated detection of pneumonia in chest X-rays\",\n            \"authors\": [\n                \"Lee, D.\",\n                \"Brown, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray_dataset.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.8 GB\",\n        \"annotations\": \"Pneumonia status is confirmed by a board-certified radiologist.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69785", "text": "{\n    \"dataset_name\": \"Brain Tumor MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Institute of Health\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"image_resolution\",\n            \"unit\": \"pixels\"\n        },\n        {\n            \"name\": \"tumor_grade\",\n            \"unit\": \"1-4\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Random sampling from hospital records\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Brain Tumor Segmentation\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_tumor_mri.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Tumor masks provided\"\n    }\n}"}
{"_id": "Academic--research_data--n--69785", "text": "{\n    \"dataset_name\": \"Chest X-Ray Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"University Medical Center\"\n    },\n    \"date_collected\": \"2023-02-28T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"image_quality\",\n            \"unit\": \"subjective scale\"\n        },\n        {\n            \"name\": \"diagnosis\",\n            \"unit\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Convenience sampling from radiology department\",\n    \"related_publications\": [\n        {\n            \"title\": \"Automated Pneumonia Detection\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/chest_xray.csv\",\n    \"metadata\": {\n        \"data_size\": \"3GB\",\n        \"annotations\": \"Radiologist reports included\"\n    }\n}"}
{"_id": "Academic--research_data--p--69786", "text": "{\n    \"dataset_name\": \"Air Quality and Temperature Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"ozone_level\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Continuous monitoring at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Heat Islands on Air Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--69786", "text": "{\n    \"dataset_name\": \"Marine Ecosystem Survey\",\n    \"creator\": {\n        \"name\": \"Oceanographic Research Group\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"salinity\",\n            \"units\": \"psu\"\n        },\n        {\n            \"name\": \"depth\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"chlorophyll_a\",\n            \"units\": \"mg/m^3\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Ship-based sampling at various locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coastal Ecosystem Dynamics\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/marine_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Geolocation data included\"\n    }\n}"}
{"_id": "Academic--research_data--p--69787", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring Dataset\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency Research Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Doe, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
