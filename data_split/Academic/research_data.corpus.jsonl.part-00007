{"_id": "Academic--research_data--p--68762", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Imperial College London Environmental Research Group\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic on Urban Air Quality\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data has been quality controlled and calibrated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68762", "text": "{\n    \"dataset_name\": \"Rural Soil Composition - Scotland\",\n    \"creator\": {\n        \"name\": \"Scottish Environmental Protection Agency\",\n        \"affiliation\": \"SEPA\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"units\"\n        },\n        {\n            \"name\": \"Nitrogen Content\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Phosphorus Content\",\n            \"units\": \"ppm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random soil samples across rural Scotland\",\n    \"related_publications\": [\n        {\n            \"title\": \"Soil Health in Scottish Highlands\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/scottish_soil.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Preliminary soil analysis data.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68763", "text": "{\n    \"dataset_name\": \"National River Water Quality Database\",\n    \"creator\": {\n        \"name\": \"US Environmental Protection Agency\",\n        \"affiliation\": \"National Aquatic Resource Surveys\"\n    },\n    \"date_collected\": \"2024-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Phosphate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"E. coli Count\",\n            \"units\": \"CFU/100mL\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected monthly at fixed stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Assessment of National River Water Quality Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.example.com/riverdata.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
