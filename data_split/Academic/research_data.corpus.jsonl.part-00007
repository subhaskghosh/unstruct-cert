{"_id": "Academic--research_data--n--69174", "text": "{\n    \"dataset_name\": \"Global Forest Cover Change\",\n    \"creator\": {\n        \"name\": \"FAO Forestry Department\",\n        \"affiliation\": \"Food and Agriculture Organization of the United Nations\"\n    },\n    \"date_collected\": \"2022-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"forest_area\",\n            \"units\": \"hectares\"\n        },\n        {\n            \"name\": \"change_rate\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC-SA 3.0 IGO\",\n    \"sampling_method\": \"Remote sensing data analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global assessment of forest resource\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_cover_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"800MB\",\n        \"annotations\": \"Data is derived from Landsat imagery.\"\n    }\n}"}
