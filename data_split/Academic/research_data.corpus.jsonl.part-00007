{"_id": "Academic--research_data--p--68341", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - 2023\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"unit\": \"Degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"unit\": \"Degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"unit\": \"Degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global Surface Temperature Analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends in 2023\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.nasa.gov/temp/2023\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Contains monthly temperature anomalies.\"\n    }\n}"}
