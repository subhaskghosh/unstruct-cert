{"_id": "Academic--research_data--n--69295", "text": "{\n    \"dataset_name\": \"Rodent Behavior Tracking Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"MIT\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"movement_speed\",\n            \"units\": \"cm/s\"\n        },\n        {\n            \"name\": \"distance_traveled\",\n            \"units\": \"cm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Video tracking of rodent behavior\",\n    \"related_publications\": [\n        {\n            \"title\": \"Locomotion and Exploration in Rodents\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/rodent_behavior.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2GB\",\n        \"annotations\": \"Raw tracking data.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69296", "text": "{\n    \"dataset_name\": \"Global Atmospheric Temperature Dataset\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Altitude\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Global network of weather stations and buoys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--69296", "text": "{\n    \"dataset_name\": \"Ocean Salinity Measurements\",\n    \"creator\": {\n        \"name\": \"Woods Hole Oceanographic Institution\",\n        \"affiliation\": \"MIT\"\n    },\n    \"date_collected\": \"2022-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Ship-based conductivity, temperature, and depth (CTD) casts\",\n    \"related_publications\": [\n        {\n            \"title\": \"Ocean Salinity Variations\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, K.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_salinity_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Calibration information available\"\n    }\n}"}
{"_id": "Academic--research_data--p--69297", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Anomalies\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Global gridded data based on station measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Contains monthly and annual temperature anomalies\"\n    }\n}"}
{"_id": "Academic--research_data--n--69297", "text": "{\n    \"dataset_name\": \"Air Quality in Major Cities\",\n    \"creator\": {\n        \"name\": \"World Health Organization (WHO)\",\n        \"affiliation\": \"UN\"\n    },\n    \"date_collected\": \"2022-12-31T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Continuous monitoring stations in urban areas\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Air Quality Report\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://www.who.int/airpollutiondata\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Real-time air quality data\"\n    }\n}"}
{"_id": "Academic--research_data--p--69298", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"unit\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISTEMP v4: Global Surface Temperature Analysis\",\n            \"authors\": [\n                \"James Hansen\",\n                \"Makiko Sato\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Contains monthly and annual temperature data from 1880 to present.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69298", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Biodiversity\",\n    \"creator\": {\n        \"name\": \"National Institute of Amazonian Research (INPA)\",\n        \"affiliation\": \"Brazil\"\n    },\n    \"date_collected\": \"2022-11-01T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"unit\": \"count\"\n        },\n        {\n            \"name\": \"Canopy Height\",\n            \"unit\": \"meters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution-ShareAlike 4.0 International\",\n    \"sampling_method\": \"Random forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment of the Amazon Rainforest\",\n            \"authors\": [\n                \"Carlos Nobre\",\n                \"Maria Silva\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.inpa.gov.br/biodiversity/\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Contains species count and canopy height information within the Amazon rainforest.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69299", "text": "{\n    \"dataset_name\": \"Healthcare ML Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Alice Smith\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Patient ID\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"Age\",\n            \"units\": \"years\"\n        },\n        {\n            \"name\": \"Blood Pressure\",\n            \"units\": \"mmHg\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Random sampling from hospital records\",\n    \"related_publications\": [\n        {\n            \"title\": \"Machine Learning for Early Disease Detection\",\n            \"authors\": [\n                \"Smith, A.\",\n                \"Jones, B.\"\n            ],\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/healthcare_ml_dataset.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data is anonymized.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69299", "text": "{\n    \"dataset_name\": \"Financial Transaction Data\",\n    \"creator\": {\n        \"name\": \"John Doe\",\n        \"affiliation\": \"Acme Corp\"\n    },\n    \"date_collected\": \"2022-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Transaction ID\",\n            \"units\": \"unique identifier\"\n        },\n        {\n            \"name\": \"Transaction Amount\",\n            \"units\": \"USD\"\n        },\n        {\n            \"name\": \"Merchant Category\",\n            \"units\": \"category\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"All transactions from November 2022\",\n    \"related_publications\": [\n        {\n            \"title\": \"Fraud Detection using Rule-Based Systems\",\n            \"authors\": [\n                \"Doe, J.\"\n            ],\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/financial_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Sensitive data, access restricted.\"\n    }\n}"}
{"_id": "Academic--research_data--p--69300", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Environments\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Public Health\",\n            \"authors\": [\n                \"Jane Doe\",\n                \"John Smith\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data cleaned and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--69300", "text": "{\n    \"dataset_name\": \"Primate Social Interactions\",\n    \"creator\": {\n        \"name\": \"Primate Behavior Research Group\",\n        \"affiliation\": \"Smithsonian Institution\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Grooming Frequency\",\n            \"units\": \"counts/hour\"\n        },\n        {\n            \"name\": \"Aggressive Interactions\",\n            \"units\": \"counts/day\"\n        },\n        {\n            \"name\": \"Group Size\",\n            \"units\": \"individuals\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Direct observation\",\n    \"related_publications\": [\n        {\n            \"title\": \"Social Dynamics of Macaque Monkeys\",\n            \"authors\": [\n                \"Alice Brown\",\n                \"Bob Green\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/primate_behavior.json\",\n    \"metadata\": {\n        \"data_size\": \"30MB\",\n        \"annotations\": \"Behavioral data coded by experts.\"\n    }\n}"}
