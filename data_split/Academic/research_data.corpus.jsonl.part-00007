{"_id": "Academic--research_data--p--68950", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - Seattle 2023\",\n    \"creator\": {\n        \"name\": \"University of Washington Atmospheric Sciences Department\",\n        \"affiliation\": \"University of Washington\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ozone Concentration (ppm)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"PM2.5 Concentration (µg/m³)\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Temperature (°C)\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity (%)\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Heat Islands on Air Quality\",\n            \"authors\": [\n                \"Jane Doe\",\n                \"John Smith\"\n            ],\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/seattle_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data has been quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68950", "text": "{\n    \"dataset_name\": \"Global Atmospheric Composition - 2020\",\n    \"creator\": {\n        \"name\": \"National Center for Atmospheric Research\",\n        \"affiliation\": \"NCAR\"\n    },\n    \"date_collected\": \"2020-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration (ppm)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Concentration (ppb)\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrous Oxide Concentration (ppb)\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Water Vapor Concentration (ppm)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature (°C)\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Pressure (hPa)\",\n            \"units\": \"hPa\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Altitude (m)\",\n            \"units\": \"m\"\n        },\n        {\n            \"name\": \"Solar Radiation (W/m²)\",\n            \"units\": \"W/m²\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY-NC 4.0 International\",\n    \"sampling_method\": \"Satellite remote sensing and ground-based measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Trends in Greenhouse Gas Concentrations\",\n            \"authors\": [\n                \"Alice Brown\",\n                \"Bob Green\"\n            ],\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/global_atmosphere.nc\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data may contain some known calibration errors.\"\n    }\n}"}
