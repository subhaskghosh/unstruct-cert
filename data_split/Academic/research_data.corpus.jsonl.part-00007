{"_id": "Academic--research_data--p--66758", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies 2020-2023\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global Surface Temperature Analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends: A 21st Century Perspective\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes annual temperature anomalies from 1880 to 2023.\"\n    }\n}"}
{"_id": "Academic--research_data--n--66758", "text": "{\n    \"dataset_name\": \"Historical Climate Data - 1950-2019\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2019-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Weather station network\",\n    \"related_publications\": [\n        {\n            \"title\": \"Climate Variability in the 20th Century\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/historical_climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Daily climate data from various locations worldwide.\"\n    }\n}"}
{"_id": "Academic--research_data--p--66759", "text": "{\n    \"dataset_name\": \"GLUE Benchmark\",\n    \"creator\": {\n        \"name\": \"Alex Wang\",\n        \"affiliation\": \"Allen Institute for AI\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"sentence_1\",\n            \"unit\": \"text\"\n        },\n        {\n            \"name\": \"sentence_2\",\n            \"unit\": \"text\"\n        },\n        {\n            \"name\": \"label\",\n            \"unit\": \"integer\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Crowdsourced annotation\",\n    \"related_publications\": [\n        {\n            \"title\": \"GLUE: A Multi-Task Benchmark and Resource for Natural Language Understanding\",\n            \"year\": 2018\n        }\n    ],\n    \"download_url\": \"https://gluebenchmark.com/download.html\",\n    \"metadata\": {\n        \"data_size\": \"1.5GB\",\n        \"annotations\": \"Human-annotated labels for various NLP tasks\"\n    }\n}"}
{"_id": "Academic--research_data--n--66759", "text": "{\n    \"dataset_name\": \"IMDB Movie Reviews\",\n    \"creator\": {\n        \"name\": \"Andrew Maas\",\n        \"affiliation\": \"University of Toronto\"\n    },\n    \"date_collected\": \"2012-11-26T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"review\",\n            \"unit\": \"text\"\n        },\n        {\n            \"name\": \"sentiment\",\n            \"unit\": \"integer\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"BSD\",\n    \"sampling_method\": \"Web scraping\",\n    \"related_publications\": [\n        {\n            \"title\": \"Learning Word Embeddings from Text using Word2Vec\",\n            \"year\": 2013\n        }\n    ],\n    \"download_url\": \"http://ai.stanford.edu/~amaas/data/sentiment/\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Binary sentiment labels (positive/negative)\"\n    }\n}"}
{"_id": "Academic--research_data--p--66760", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - 2021-2023\",\n    \"creator\": {\n        \"name\": \"NASA GISS\",\n        \"affiliation\": \"Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Report 2023\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_anomalies.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Contains monthly average temperature anomalies.\"\n    }\n}"}
