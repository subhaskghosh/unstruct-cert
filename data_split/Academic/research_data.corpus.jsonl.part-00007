{"_id": "Academic--research_data--p--68556", "text": "{\n    \"dataset_name\": \"Air Quality in California - 2023\",\n    \"creator\": {\n        \"name\": \"California Environmental Protection Agency\",\n        \"affiliation\": \"CalEPA\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less\"\n        },\n        {\n            \"variable_name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature at the measurement location.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in California\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Doe, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/california_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--68556", "text": "{\n    \"dataset_name\": \"Global Forest Cover Change\",\n    \"creator\": {\n        \"name\": \"University of Maryland\",\n        \"affiliation\": \"UMD Global Land Analysis & Discovery\"\n    },\n    \"date_collected\": \"2022-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"treecover2000\",\n            \"units\": \"%\",\n            \"description\": \"Percentage of tree cover in the year 2000.\"\n        },\n        {\n            \"variable_name\": \"lossyear\",\n            \"units\": \"year\",\n            \"description\": \"Year of forest loss.\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Forest Change\",\n            \"authors\": [\n                \"Hansen, M.C.\",\n                \"Potapov, P.V.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_forest_cover.tif\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Pixel-level accuracy assessments included\"\n    }\n}"}
{"_id": "Academic--research_data--p--68557", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis 2020-2023\",\n    \"creator\": {\n        \"name\": \"National Centers for Environmental Information (NCEI)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2023-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Elevation\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global station network with quality control\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/global-surface-summary-of-the-month/access/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Comprehensive temperature data with metadata for each station.\"\n    }\n}"}
