{"_id": "Academic--research_data--n--66341", "text": "{\n    \"dataset_name\": \"Brain MRI Scans\",\n    \"creator\": {\n        \"name\": \"Neuroimaging Lab, University of California, Berkeley\",\n        \"affiliation\": \"UC Berkeley\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"SubjectID\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"BrainVolume\",\n            \"unit\": \"cm^3\"\n        },\n        {\n            \"name\": \"CognitiveScore\",\n            \"unit\": \"scale of 1-100\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Random sampling of healthy adults\",\n    \"related_publications\": [\n        {\n            \"title\": \"MRI-based biomarkers for cognitive decline\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_mri.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"segmentation maps of brain regions\"\n    }\n}"}
{"_id": "Academic--research_data--p--66342", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2021-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Location\",\n            \"units\": \"Latitude, Longitude\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global temperature station network\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the 21st Century\",\n            \"authors\": [\n                \"James Hansen\",\n                \"Makiko Sato\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Contains temperature anomalies from 1880-2023\"\n    }\n}"}
