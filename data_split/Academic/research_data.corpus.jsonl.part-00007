{"_id": "Academic--research_data--p--69747", "text": "{\n    \"dataset_name\": \"Lung Image Database\",\n    \"creator\": {\n        \"name\": \"Radiology Research Group\",\n        \"affiliation\": \"University Hospital Zurich\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Nodule Diameter\",\n            \"unit\": \"mm\"\n        },\n        {\n            \"name\": \"Tumor Volume\",\n            \"unit\": \"mm^3\"\n        },\n        {\n            \"name\": \"Lung Capacity\",\n            \"unit\": \"mL\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Retrospective analysis of patient CT scans\",\n    \"related_publications\": [\n        {\n            \"title\": \"Early Detection of Lung Nodules using Deep Learning\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lung_image_db.zip\",\n    \"metadata\": {\n        \"data_size\": \"50GB\",\n        \"annotations\": \"Radiologist-verified nodule locations\"\n    }\n}"}
