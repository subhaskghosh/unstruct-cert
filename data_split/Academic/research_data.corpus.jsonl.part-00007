{"_id": "Academic--research_data--n--69123", "text": "{\n    \"dataset_name\": \"Historical CO2 Concentrations\",\n    \"creator\": {\n        \"name\": \"NOAA ESRL\",\n        \"affiliation\": \"Earth System Research Laboratories\"\n    },\n    \"date_collected\": \"2022-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        },\n        {\n            \"name\": \"Altitude\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Measurement Date\",\n            \"units\": \"YYYY-MM-DD\"\n        },\n        {\n            \"name\": \"Sensor Type\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Standard Deviation\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Measurement Quality Flag\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Data Source\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Location Description\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Processing Version\",\n            \"units\": \"N/A\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Continuous monitoring at global stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Atmospheric Carbon Dioxide\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/co2_concentrations.csv\",\n    \"metadata\": {\n        \"data_size\": \"5.5 MB\",\n        \"annotations\": \"Long-term records of CO2 levels.\"\n    }\n}"}
