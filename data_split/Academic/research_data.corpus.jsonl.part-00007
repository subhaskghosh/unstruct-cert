{"_id": "Academic--research_data--p--69278", "text": "{\n    \"dataset_name\": \"Human Connectome Project - Young Adult\",\n    \"creator\": {\n        \"name\": \"Van Essen Lab\",\n        \"affiliation\": \"Washington University in St. Louis\"\n    },\n    \"date_collected\": \"2023-06-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"functional connectivity\",\n            \"units\": \"correlation coefficient\"\n        },\n        {\n            \"name\": \"brain volume\",\n            \"units\": \"cm^3\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"fMRI resting-state\",\n    \"related_publications\": [\n        {\n            \"title\": \"The Human Connectome Project: A decade of discovering brain connectivity\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.humanconnectome.org/\",\n    \"metadata\": {\n        \"data_size\": \"10 TB\",\n        \"annotations\": \"Preprocessed fMRI data\"\n    }\n}"}
