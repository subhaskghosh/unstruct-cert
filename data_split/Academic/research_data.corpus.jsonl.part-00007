{"_id": "Academic--research_data--n--67866", "text": "{\n    \"dataset_name\": \"Social Media Sentiment on Environmental Issues\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"Department of Sociology\"\n    },\n    \"date_collected\": \"2022-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tweet Text\",\n            \"units\": \"text\"\n        },\n        {\n            \"name\": \"Sentiment Score\",\n            \"units\": \"scale of -1 to 1\"\n        },\n        {\n            \"name\": \"User Location\",\n            \"units\": \"coordinates\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Attribution-NonCommercial 4.0 International\",\n    \"sampling_method\": \"Twitter API streaming data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Public Opinion on Climate Change\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/social_media_data.json\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Sentiment analysis labels generated using a machine learning model.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67867", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis 2021-2023\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"surface_temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"variable_name\": \"longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of weather stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the 21st Century: An Updated Analysis\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Quality controlled temperature data with anomaly calculations\"\n    }\n}"}
{"_id": "Academic--research_data--n--67867", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data - 1990-2000\",\n    \"creator\": {\n        \"name\": \"Sarah Johnson\",\n        \"affiliation\": \"University of Arizona\"\n    },\n    \"date_collected\": \"2000-07-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"rainfall\",\n            \"units\": \"mm\"\n        },\n        {\n            \"variable_name\": \"month\",\n            \"units\": \"integer\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Rain gauge network across Arizona\",\n    \"related_publications\": [\n        {\n            \"title\": \"Rainfall Patterns in the Southwestern United States\",\n            \"year\": 2001\n        }\n    ],\n    \"download_url\": \"https://example.com/rainfall_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Raw rainfall data with some missing values.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67868", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Monoxide\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Particulate Matter 2.5\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urbanization on Air Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67868", "text": "{\n    \"dataset_name\": \"Soil Moisture Levels in Agricultural Fields\",\n    \"creator\": {\n        \"name\": \"Agricultural Research Group\",\n        \"affiliation\": \"Iowa State University\"\n    },\n    \"date_collected\": \"2022-11-01T14:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Nitrogen Levels\",\n            \"units\": \"mg/kg\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Periodic soil sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Optimizing Irrigation Strategies\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/soil_data.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Sensor calibration data provided\"\n    }\n}"}
{"_id": "Academic--research_data--p--67869", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_NYC_2023\",\n    \"creator\": {\n        \"name\": \"NYC Department of Environmental Protection\",\n        \"affiliation\": \"City of New York\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Fine particulate matter concentration\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ozone concentration\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in New York City\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/nyc_airquality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data is quality controlled and validated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67869", "text": "{\n    \"dataset_name\": \"HistoricalWeatherData_Europe\",\n    \"creator\": {\n        \"name\": \"European Climate Assessment & Data Centre\",\n        \"affiliation\": \"ECAD\"\n    },\n    \"date_collected\": \"2018-07-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-SA\",\n    \"sampling_method\": \"Interpolated from weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"European Climate Variability\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/europe_weather.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data is archived for historical climate studies.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67870", "text": "{\n    \"dataset_name\": \"Global Air Quality and Climate Change Dataset\",\n    \"creator\": {\n        \"name\": \"Environmental Science Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"ozone_concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"pm25\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Climate Change\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Includes data quality flags and metadata about monitoring stations.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67870", "text": "{\n    \"dataset_name\": \"Agricultural Yields and Rainfall Data\",\n    \"creator\": {\n        \"name\": \"National Agricultural Research Center\",\n        \"affiliation\": \"Ministry of Agriculture\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"wheat_yield\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"rainfall\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"fertilizer_use\",\n            \"units\": \"kg/hectare\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Farm surveys and weather station data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Rainfall on Wheat Yields\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/agricultural_data.json\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Includes information about farm location and soil type.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67871", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies (GISS)\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2023-10-26T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Temperature anomalies relative to a baseline period.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67871", "text": "{\n    \"dataset_name\": \"Historical Weather Records - US\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2018-05-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Fahrenheit\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"inches\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Station-based observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"US Climate Variability\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://www.ncdc.noaa.gov/cdo-web/\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Daily weather observations from US stations.\"\n    }\n}"}
