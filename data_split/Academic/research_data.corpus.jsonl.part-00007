{"_id": "Academic--research_data--n--68382", "text": "{\n    \"dataset_name\": \"SoilComposition_RuralFrance\",\n    \"creator\": {\n        \"name\": \"Institut National de la Recherche Agronomique\",\n        \"affiliation\": \"Soil Science Department\"\n    },\n    \"date_collected\": \"2023-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Organic Matter\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Nitrogen Content\",\n            \"units\": \"mg/kg\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Random soil samples\",\n    \"related_publications\": [\n        {\n            \"title\": \"Soil Characteristics in French Agriculture\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/french_soil.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data collected from multiple farms.\"\n    }\n}"}
