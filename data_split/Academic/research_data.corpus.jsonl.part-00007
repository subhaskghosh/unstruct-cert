{"_id": "Academic--research_data--n--68842", "text": "{\n    \"dataset_name\": \"GlobalForestCarbon_2020\",\n    \"creator\": {\n        \"name\": \"Remote Sensing Institute\",\n        \"affiliation\": \"University of Washington\"\n    },\n    \"date_collected\": \"2020-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CarbonStock\",\n            \"units\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"ForestCover\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC-BY-NC-SA 4.0\",\n    \"sampling_method\": \"Satellite imagery analysis.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Forest Carbon Mapping\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_carbon.tif\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Data derived from Landsat imagery.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68843", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Center for Limnology\",\n        \"affiliation\": \"UW-Madison\"\n    },\n    \"date_collected\": \"2023-07-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"µg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Weekly grab samples at fixed locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in lake water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Doe, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lakemendota_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data quality flags included. Locations are GPS coordinates.\",\n        \"number_of_samples\": 1000\n    }\n}"}
{"_id": "Academic--research_data--n--68843", "text": "{\n    \"dataset_name\": \"Air Quality in Urban Centers\",\n    \"creator\": {\n        \"name\": \"City Environmental Agency\",\n        \"affiliation\": \"Local Government\"\n    },\n    \"date_collected\": \"2022-01-10T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Particulate Matter 2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/airquality_data.json\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Data is pre-processed and averaged hourly.\",\n        \"number_of_samples\": 500\n    }\n}"}
{"_id": "Academic--research_data--p--68844", "text": "{\n    \"dataset_name\": \"National Water Quality Monitoring Database\",\n    \"creator\": {\n        \"name\": \"US Environmental Protection Agency\",\n        \"affiliation\": \"EPA\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"unitless\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Regular monitoring stations across major rivers and lakes.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Water Quality in the US\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://www.epa.gov/waterdata/national-water-quality-monitoring-database\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68844", "text": "{\n    \"dataset_name\": \"Small Stream Insect Survey\",\n    \"creator\": {\n        \"name\": \"Local University Biology Department\",\n        \"affiliation\": \"University X\"\n    },\n    \"date_collected\": \"2018-07-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Insect Species\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Stream Depth\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random sampling of insect populations in local streams.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Insect Biodiversity in Local Streams\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"http://universityx.edu/stream_insects.json\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Limited metadata available.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68845", "text": "{\n    \"dataset_name\": \"US EPA Air Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"United States Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"ozone\",\n            \"unit\": \"ppb\"\n        },\n        {\n            \"name\": \"pm25\",\n            \"unit\": \"µg/m³\"\n        },\n        {\n            \"name\": \"temperature\",\n            \"unit\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in the United States\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://www.epa.gov/airdata/download-daily-air-quality-data\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Includes data from over 4,000 monitoring stations.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68845", "text": "{\n    \"dataset_name\": \"Urban Tree Canopy Cover\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2021-08-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tree_canopy_cover\",\n            \"unit\": \"percentage\"\n        },\n        {\n            \"name\": \"land_use\",\n            \"unit\": \"category\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Remote sensing and ground validation\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Trees on Air Quality\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://berkeley.edu/treedata\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"High-resolution data for several US cities.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68846", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - Recent Data\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley - Earth Lab\",\n        \"affiliation\": \"UC Berkeley\"\n    },\n    \"date_collected\": \"2023-11-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Anomaly\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global surface temperature measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Recent Trends in Global Temperature Anomalies\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Quality controlled temperature data.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68846", "text": "{\n    \"dataset_name\": \"Historical Air Quality Data - Europe\",\n    \"creator\": {\n        \"name\": \"European Environment Agency\",\n        \"affiliation\": \"EEA\"\n    },\n    \"date_collected\": \"2018-05-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"Air quality monitoring stations across Europe\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Europe\",\n            \"year\": 2019\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Air quality measurements from European monitoring stations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68847", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_California\",\n    \"creator\": {\n        \"name\": \"California Air Resources Board\",\n        \"affiliation\": \"CARB\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"OzoneConcentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"California Air Quality Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality_ca.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--68847", "text": "{\n    \"dataset_name\": \"OceanTemperature_Global\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2023-06-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"SeaSurfaceTemperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"m\"\n        },\n        {\n            \"name\": \"ChlorophyllConcentration\",\n            \"units\": \"mg/m³\"\n        },\n        {\n            \"name\": \"DissolvedOxygen\",\n            \"units\": \"mL/L\"\n        },\n        {\n            \"name\": \"CurrentSpeed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"CurrentDirection\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"PhytoplanktonBiomass\",\n            \"units\": \"g/m³\"\n        },\n        {\n            \"name\": \"ZooplanktonAbundance\",\n            \"units\": \"count/m³\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Ship-based measurements and satellite data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Ocean Heat Content\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_temp.nc\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data includes quality control information.\"\n    }\n}"}
