{"_id": "Academic--research_data--n--68878", "text": "{\n    \"dataset_name\": \"Global Forest Biomass\",\n    \"creator\": {\n        \"name\": \"NASA Earth Science Data and Information System\",\n        \"affiliation\": \"NASA Goddard Space Flight Center\"\n    },\n    \"date_collected\": \"2022-12-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Aboveground Biomass\",\n            \"units\": \"tons/hectare\"\n        },\n        {\n            \"name\": \"Forest Cover\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY 4.0\",\n    \"sampling_method\": \"Satellite remote sensing data\",\n    \"related_publications\": [\n        {\n            \"title\": \"Mapping Global Forest Biomass\",\n            \"authors\": \"Hansen et al.\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biomass.json\",\n    \"metadata\": {\n        \"data_size\": \"250MB\",\n        \"annotations\": \"Processed data derived from LiDAR and optical imagery.\"\n    }\n}"}
