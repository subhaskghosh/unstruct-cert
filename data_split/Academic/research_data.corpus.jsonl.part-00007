{"_id": "Academic--research_data--p--70048", "text": "{\n    \"dataset_name\": \"Global Forest Watch - Tree Cover Loss\",\n    \"creator\": {\n        \"name\": \"Global Forest Watch\",\n        \"affiliation\": \"World Resources Institute\"\n    },\n    \"date_collected\": \"2022-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover_loss\",\n            \"units\": \"hectares\"\n        },\n        {\n            \"name\": \"gain\",\n            \"units\": \"hectares\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from Landsat imagery\",\n            \"authors\": [\n                \"Hansen\",\n                \"Potapov\",\n                \"Moore\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.globalforestwatch.org/data/\",\n    \"metadata\": {\n        \"data_size\": \"10 GB\",\n        \"annotations\": \"Provides data on tree cover loss and gain globally.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70048", "text": "{\n    \"dataset_name\": \"CMIP6 Climate Model Output\",\n    \"creator\": {\n        \"name\": \"CMIP6 Teams\",\n        \"affiliation\": \"Various International Institutions\"\n    },\n    \"date_collected\": \"2021-12-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"mm/day\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Climate model simulations\",\n    \"related_publications\": [\n        {\n            \"title\": \"The CMIP6 experimental design\",\n            \"authors\": [\n                \"Eyring\",\n                \"Bony\",\n                \"Boer\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://esgf-node.llnl.gov/cmip6/\",\n    \"metadata\": {\n        \"data_size\": \"500 GB\",\n        \"annotations\": \"Output from global climate models.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70049", "text": "{\n    \"dataset_name\": \"Amazon Rainforest Biodiversity Monitoring\",\n    \"creator\": {\n        \"name\": \"Dr. Isabella Rossi\",\n        \"affiliation\": \"National Institute of Amazonian Research\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Abundance\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Canopy Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"dimensionless\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Stratified Random Sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Patterns in Central Amazonia\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/amazon_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Detailed species identification and habitat information included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70049", "text": "{\n    \"dataset_name\": \"Global Air Quality Measurements\",\n    \"creator\": {\n        \"name\": \"World Air Quality Index\",\n        \"affiliation\": \"WAQI\"\n    },\n    \"date_collected\": \"2022-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-SA 3.0\",\n    \"sampling_method\": \"Continuous Monitoring Stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Trends in Air Pollution\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Real-time air quality data from around the world.\"\n    }\n}"}
