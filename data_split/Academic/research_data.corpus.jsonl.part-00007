{"_id": "Academic--research_data--p--66239", "text": "{\n    \"dataset_name\": \"Chest X-Ray Images for Pneumonia Detection\",\n    \"creator\": {\n        \"name\": \"National Institutes of Health\",\n        \"affiliation\": \"Clinical Center\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image File Name\",\n            \"units\": \"string\"\n        },\n        {\n            \"name\": \"Pneumonia Diagnosis\",\n            \"units\": \"boolean\"\n        }\n    ],\n    \"data_format\": \"JPEG\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Retrospective collection from hospital archives\",\n    \"related_publications\": [\n        {\n            \"title\": \"ChestX-ray8: Dataset and Benchmarks for Large-Scale Pneumonia Detection\",\n            \"authors\": [\n                \"Wang, Xiaohua\",\n                \"Peng, Yifan\",\n                \"Shi, Yifan\",\n                \"Xu, Peng\",\n                \"Li, Xulong\",\n                \"Ye, Ling\",\n                \"Guo, Bin\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://nihcc.app.box.com/v/ChestXray-NIHCC\",\n    \"metadata\": {\n        \"data_size\": \"1.02 GB\",\n        \"annotations\": \"Diagnosis labels provided\"\n    }\n}"}
