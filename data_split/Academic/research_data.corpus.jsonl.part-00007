{"_id": "Academic--research_data--p--70926", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas - 2023-2024\",\n    \"creator\": {\n        \"name\": \"Environmental Science Research Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations with hourly readings\",\n    \"related_publications\": [\n        {\n            \"title\": \"Urban Air Quality Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data has been quality controlled and missing values imputed using linear interpolation.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70926", "text": "{\n    \"dataset_name\": \"Forest Ecosystem Health Assessment\",\n    \"creator\": {\n        \"name\": \"National Forestry Service\",\n        \"affiliation\": \"US Department of Agriculture\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Diameter at Breast Height\",\n            \"units\": \"cm\"\n        },\n        {\n            \"name\": \"Species\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary - Government Use Only\",\n    \"sampling_method\": \"Random forest plots sampled annually\",\n    \"related_publications\": [\n        {\n            \"title\": \"Forest Health Report\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_data.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data requires specialized software for processing.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70927", "text": "{\n    \"dataset_name\": \"Long-Term Forest Monitoring - Pacific Northwest\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Washington, Forest Ecology Department\"\n    },\n    \"date_collected\": \"2023-05-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"TreeDiameter\",\n            \"units\": \"cm\"\n        },\n        {\n            \"name\": \"Species\",\n            \"units\": \"categorical\"\n        },\n        {\n            \"name\": \"Elevation\",\n            \"units\": \"m\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Random stratified sampling within established plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Forest Dynamics in a Changing Climate\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"12.5MB\",\n        \"annotations\": \"Data includes tree measurements collected annually over 20 years.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70927", "text": "{\n    \"dataset_name\": \"Urban Air Quality Measurements - London\",\n    \"creator\": {\n        \"name\": \"AirQual Ltd.\",\n        \"affiliation\": \"Private Environmental Consulting\"\n    },\n    \"date_collected\": \"2023-08-20T14:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM25\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Continuous monitoring at fixed locations\",\n    \"related_publications\": [],\n    \"download_url\": \"https://airqual.co.uk/data.json\",\n    \"metadata\": {\n        \"data_size\": \"5.2MB\",\n        \"annotations\": \"Hourly measurements from air quality sensors across London.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70928", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas - 2023-2024\",\n    \"creator\": {\n        \"name\": \"Environmental Science Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"PM10\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Sulfur Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Carbon Monoxide\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Wind Speed\",\n            \"units\": \"m/s\"\n        },\n        {\n            \"name\": \"Wind Direction\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Atmospheric Pressure\",\n            \"units\": \"hPa\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Public Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
