{"_id": "Academic--research_data--p--67798", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis 2021-2023\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"NCEI\"\n    },\n    \"date_collected\": \"2023-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"surface_temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global network of weather stations and buoys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends: 2021-2023 Update\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_2021_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Quality control flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67798", "text": "{\n    \"dataset_name\": \"Historical Rainfall Data - Southeast Asia\",\n    \"creator\": {\n        \"name\": \"Southeast Asian Regional Climate Center\",\n        \"affiliation\": \"SERCC\"\n    },\n    \"date_collected\": \"2018-01-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"rainfall\",\n            \"units\": \"millimeters\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Rain gauge network across Southeast Asia\",\n    \"related_publications\": [\n        {\n            \"title\": \"Rainfall Patterns in Southeast Asia\",\n            \"authors\": [\n                \"Lee, K.\",\n                \"Tan, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/rainfall_sea_historical.json\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data contains gaps due to sensor failures\"\n    }\n}"}
