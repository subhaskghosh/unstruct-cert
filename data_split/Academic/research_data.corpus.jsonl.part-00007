{"_id": "Academic--research_data--p--71184", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_2023\",\n    \"creator\": {\n        \"name\": \"Environmental Solutions Inc.\",\n        \"affiliation\": \"Private Research Firm\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO_concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"NO2_concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"O3_concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"PM2.5_concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"Percentage\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Urban Emissions on Air Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/airquality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"8.5MB\",\n        \"annotations\": \"Data validated against EPA standards.\"\n    }\n}"}
