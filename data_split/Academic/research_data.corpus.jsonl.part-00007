{"_id": "Academic--research_data--n--68660", "text": "{\n    \"dataset_name\": \"Rural Soil Composition - Iowa\",\n    \"creator\": {\n        \"name\": \"Iowa State University Agronomy Department\",\n        \"affiliation\": \"Iowa State University\"\n    },\n    \"date_collected\": \"2023-06-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Nitrogen\",\n            \"units\": \"mg/kg\"\n        },\n        {\n            \"name\": \"Phosphorus\",\n            \"units\": \"mg/kg\"\n        },\n        {\n            \"name\": \"Potassium\",\n            \"units\": \"mg/kg\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Field sampling at 50 locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Soil Health and Crop Yields\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/iowa_soil_data.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Data represents average values across samples.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68661", "text": "{\n    \"dataset_name\": \"London Air Quality Monitoring 2023-2024\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\",\n            \"description\": \"Concentration of ozone in parts per billion.\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"unit\": \"µg/m³\",\n            \"description\": \"Nitrogen Dioxide concentration.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality.csv\",\n    \"metadata\": {\n        \"data_size\": \"12.5MB\",\n        \"annotations\": \"Data is quality controlled and validated.\"\n    }\n}"}
