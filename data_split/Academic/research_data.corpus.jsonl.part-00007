{"_id": "Academic--research_data--p--66730", "text": "{\n    \"dataset_name\": \"Air Quality in California - 2023-2024\",\n    \"creator\": {\n        \"name\": \"California Air Resources Board\",\n        \"affiliation\": \"CARB\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"ozone\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"pm2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in California\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/ca_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes hourly averages.\"\n    }\n}"}
