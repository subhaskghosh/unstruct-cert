{"_id": "Academic--research_data--p--70129", "text": "{\n    \"dataset_name\": \"BRATS 2024 MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Medical Imaging Data Collaboration\",\n        \"affiliation\": \"National Institutes of Health\"\n    },\n    \"date_collected\": \"2024-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image Resolution\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Tumor Location\",\n            \"units\": \"Coordinates\"\n        },\n        {\n            \"name\": \"Patient Age\",\n            \"units\": \"years\"\n        }\n    ],\n    \"data_format\": \"NIfTI\",\n    \"license\": \"CC BY-NC-SA 4.0\",\n    \"sampling_method\": \"Multi-institutional retrospective study\",\n    \"related_publications\": [\n        {\n            \"title\": \"BRATS 2024: Brain Tumor Segmentation Challenge\",\n            \"authors\": [\n                \"Smith\",\n                \"Jones\",\n                \"Brown\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/brats2024\",\n    \"metadata\": {\n        \"data_size\": \"100GB\",\n        \"annotations\": \"Expert radiologist segmentations\"\n    }\n}"}
