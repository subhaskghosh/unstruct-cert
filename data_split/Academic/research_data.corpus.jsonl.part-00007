{"_id": "Academic--research_data--n--66361", "text": "{\n    \"dataset_name\": \"Coral Reef Biodiversity\",\n    \"creator\": {\n        \"name\": \"Australian Institute of Marine Science\",\n        \"affiliation\": \"AIMS\"\n    },\n    \"date_collected\": \"2023-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Coral Species Richness\",\n            \"units\": \"number of species\"\n        },\n        {\n            \"name\": \"Coral Cover\",\n            \"units\": \"percentage\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Underwater visual surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coral Reef Status Report\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.aims.gov.au/data\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data on coral reef health and biodiversity\"\n    }\n}"}
