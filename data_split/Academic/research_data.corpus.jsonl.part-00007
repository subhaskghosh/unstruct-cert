{"_id": "Academic--research_data--n--66717", "text": "{\n    \"dataset_name\": \"Historical Climate Reconstruction\",\n    \"creator\": {\n        \"name\": \"Michael Mann\",\n        \"affiliation\": \"University of Pennsylvania\"\n    },\n    \"date_collected\": \"2018-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Year\",\n            \"units\": \"year\"\n        }\n    ],\n    \"data_format\": \"TXT\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Tree ring data and ice core samples\",\n    \"related_publications\": [\n        {\n            \"title\": \"Proxy-based reconstructions of hemispheric and global surface temperature variations over the past six centuries\",\n            \"authors\": [\n                \"Michael Mann\",\n                \"Raymond Bradley\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.meteo.psu.edu/holocene/data/\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Reconstructed temperature values\"\n    }\n}"}
{"_id": "Academic--research_data--p--66718", "text": "{\n    \"dataset_name\": \"COVID-19 Radiography Database\",\n    \"creator\": {\n        \"name\": \"Peng-Yuan Chen\",\n        \"affiliation\": \"National Taiwan University Hospital\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"image_id\",\n            \"unit\": \"unique identifier\"\n        },\n        {\n            \"name\": \"image_type\",\n            \"unit\": \"X-Ray or CT scan\"\n        },\n        {\n            \"name\": \"finding\",\n            \"unit\": \"presence/absence of pneumonia\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Retrospective collection from hospital archives\",\n    \"related_publications\": [\n        {\n            \"title\": \"COVID-19 Radiography Database: A Publicly Available Resource\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://www.kaggle.com/tawsifurrahman/covid19-radiography-database\",\n    \"metadata\": {\n        \"data_size\": \"128 GB\",\n        \"annotations\": \"Radiologist-verified presence of COVID-19 related findings\"\n    }\n}"}
