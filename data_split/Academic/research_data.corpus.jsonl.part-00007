{"_id": "Academic--research_data--n--69053", "text": "{\n    \"dataset_name\": \"Arctic Ice Extent 2018-2022\",\n    \"creator\": {\n        \"name\": \"National Snow and Ice Data Center (NSIDC)\",\n        \"affiliation\": \"University of Colorado Boulder\"\n    },\n    \"date_collected\": \"2022-09-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Ice Extent\",\n            \"units\": \"square kilometers\"\n        },\n        {\n            \"name\": \"Sea Ice Thickness\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Satellite remote sensing\",\n    \"related_publications\": [\n        {\n            \"title\": \"Changes in Arctic Sea Ice\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://example.com/arctic_ice_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Daily measurements of sea ice extent\"\n    }\n}"}
