{"_id": "Academic--research_data--p--68004", "text": "{\n    \"dataset_name\": \"Global Forest Change and Carbon Fluxes\",\n    \"creator\": {\n        \"name\": \"University of Maryland, Hansen et al.\",\n        \"affiliation\": \"University of Maryland Global Land Cover Facility\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"units\": \"percent\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"units\": \"year\"\n        },\n        {\n            \"name\": \"carbon_flux\",\n            \"units\": \"tonnes CO2/hectare/year\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite imagery analysis (Landsat, Sentinel)\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2020\",\n            \"authors\": [\n                \"Hansen\",\n                \"Potapov\",\n                \"Moore\",\n                \"Hurlbert\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://glad.umd.edu/data\",\n    \"metadata\": {\n        \"data_size\": \"500GB\",\n        \"annotations\": \"Provides detailed maps of forest loss and gain globally\"\n    }\n}"}
{"_id": "Academic--research_data--n--68004", "text": "{\n    \"dataset_name\": \"Global Historical Climatology Network - Daily\",\n    \"creator\": {\n        \"name\": \"National Centers for Environmental Information\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2018-12-31T23:59:59Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tmax\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"tmin\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Ground-based weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"GHCN Daily Dataset\",\n            \"authors\": [\n                \"Menne\",\n                \"Durre\",\n                \"Vose\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/ghcn-daily/\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Daily temperature data from weather stations globally\"\n    }\n}"}
{"_id": "Academic--research_data--p--68005", "text": "{\n    \"dataset_name\": \"Air Quality in Urban Centers\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Fine particulate matter concentration\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--68005", "text": "{\n    \"dataset_name\": \"Lake Ecosystem Health\",\n    \"creator\": {\n        \"name\": \"Freshwater Research Institute\",\n        \"affiliation\": \"University of Alberta\"\n    },\n    \"date_collected\": \"2022-07-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\",\n            \"description\": \"Concentration of dissolved oxygen\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"pH units\",\n            \"description\": \"Acidity of the water\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Weekly water samples\",\n    \"related_publications\": [\n        {\n            \"title\": \"Nutrient Dynamics in Lakes\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Sample locations provided\"\n    }\n}"}
{"_id": "Academic--research_data--p--68006", "text": "{\n    \"dataset_name\": \"National River Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"US Environmental Protection Agency\",\n        \"affiliation\": \"USEPA\"\n    },\n    \"date_collected\": \"2023-05-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Nitrate Concentration\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Regular grab samples from fixed monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Assessment of River Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://www.example.com/river_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68006", "text": "{\n    \"dataset_name\": \"Agricultural Drainage Water Quality\",\n    \"creator\": {\n        \"name\": \"State Department of Agriculture\",\n        \"affiliation\": \"State DOA\"\n    },\n    \"date_collected\": \"2023-07-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Pesticide Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Fertilizer Runoff\",\n            \"units\": \"kg/ha\"\n        },\n        {\n            \"name\": \"Sediment Load\",\n            \"units\": \"tons/acre\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Sampling from agricultural drainage ditches\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Fertilizer on Water Quality\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://www.example.com/ag_drainage.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Includes land use classifications.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68007", "text": "{\n    \"dataset_name\": \"Forest Biodiversity and Climate Change Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"tree_density\",\n            \"units\": \"trees/hectare\"\n        },\n        {\n            \"name\": \"species_richness\",\n            \"units\": \"number of species\"\n        },\n        {\n            \"name\": \"temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Random stratified sampling across forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Climate Change on Forest Ecosystems\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Li, W.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data includes quality control flags for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68007", "text": "{\n    \"dataset_name\": \"Coral Reef Health Monitoring Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. David Miller\",\n        \"affiliation\": \"Oceanographic Institute of Hawaii\"\n    },\n    \"date_collected\": \"2023-07-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"coral_cover\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"water_temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"fish_biomass\",\n            \"units\": \"kg/m^2\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"SCUBA diving surveys along transects\",\n    \"related_publications\": [\n        {\n            \"title\": \"Coral Bleaching and Ocean Warming\",\n            \"authors\": [\n                \"Miller, D.\",\n                \"Nguyen, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/coral_reef_data.json\",\n    \"metadata\": {\n        \"data_size\": \"2MB\",\n        \"annotations\": \"Images and video recordings available upon request.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68008", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Research Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\",\n            \"description\": \"Ambient air temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68008", "text": "{\n    \"dataset_name\": \"Marine Ecosystem Monitoring - Pacific Ocean\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute\",\n        \"affiliation\": \"Woods Hole Oceanographic Institution\"\n    },\n    \"date_collected\": \"2023-08-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"unit\": \"PSU\",\n            \"description\": \"Salinity of the seawater.\"\n        },\n        {\n            \"name\": \"Water Temperature\",\n            \"unit\": \"°C\",\n            \"description\": \"Temperature of the seawater.\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"unit\": \"µg/L\",\n            \"description\": \"Concentration of chlorophyll-a, a proxy for phytoplankton biomass.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Research vessel deployments\",\n    \"related_publications\": [\n        {\n            \"title\": \"Effects of Climate Change on Marine Ecosystems\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, K.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/marine_data.json\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Sensor calibration data included.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68009", "text": "{\n    \"dataset_name\": \"RiverWaterQualityMonitoring\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US EPA\"\n    },\n    \"date_collected\": \"2023-06-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"pH units\"\n        },\n        {\n            \"name\": \"DissolvedOxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Grab samples collected weekly at designated monitoring stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Agricultural Runoff on River Water Quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/river_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
