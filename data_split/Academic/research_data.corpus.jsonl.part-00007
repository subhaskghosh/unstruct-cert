{"_id": "Academic--research_data--n--68452", "text": "{\n    \"dataset_name\": \"Air Quality Measurements in Beijing\",\n    \"creator\": {\n        \"name\": \"Beijing Municipal Environmental Monitoring Center\",\n        \"affiliation\": \"Beijing Government\"\n    },\n    \"date_collected\": \"2021-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Open Data License\",\n    \"sampling_method\": \"Ground-based monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air pollution in Beijing\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"http://www.bjmemc.com.cn/\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Limited documentation available.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68453", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis - 2021 Update\",\n    \"creator\": {\n        \"name\": \"GISS Surface Temperature Analysis Team\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2021-12-31T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Global network of weather stations, satellite observations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"85MB\",\n        \"annotations\": \"Contains monthly and annual temperature anomalies.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68453", "text": "{\n    \"dataset_name\": \"CMIP6 Climate Model Projections\",\n    \"creator\": {\n        \"name\": \"CMIP6 Community\",\n        \"affiliation\": \"Various International Institutions\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature Projection\",\n            \"units\": \"Kelvin\"\n        },\n        {\n            \"name\": \"Precipitation Projection\",\n            \"units\": \"mm/day\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY-NC-SA 4.0\",\n    \"sampling_method\": \"Climate model simulations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Future Climate Scenarios\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://esgf-node.llnl.gov/cmip6/\",\n    \"metadata\": {\n        \"data_size\": \"500GB\",\n        \"annotations\": \"Contains outputs from various climate models.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68454", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London\",\n    \"creator\": {\n        \"name\": \"Imperial College London Environmental Research Group\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring using calibrated electrochemical sensors at fixed locations. Data validated against laboratory measurements.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Traffic Emissions on Urban Air Quality\",\n            \"year\": 2022\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data includes timestamps, latitude, and longitude for each measurement.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68454", "text": "{\n    \"dataset_name\": \"Coastal Water Quality - California\",\n    \"creator\": {\n        \"name\": \"California Department of Fish and Wildlife\",\n        \"affiliation\": \"CDFW\"\n    },\n    \"date_collected\": \"2022-07-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"units\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Discrete water samples collected monthly at designated coastal monitoring stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Assessing the Health of California's Coastal Ecosystems\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/california_water_quality.json\",\n    \"metadata\": {\n        \"data_size\": \"800 MB\",\n        \"annotations\": \"Data includes station IDs, sample depths, and analysis dates.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68455", "text": "{\n    \"dataset_name\": \"Global High-Resolution Temperature Dataset\",\n    \"creator\": {\n        \"name\": \"Climate Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"temperature\",\n            \"unit\": \"Celsius\",\n            \"description\": \"Average daily temperature\"\n        },\n        {\n            \"name\": \"humidity\",\n            \"unit\": \"percentage\",\n            \"description\": \"Average daily relative humidity\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite-based remote sensing with ground station validation\",\n    \"related_publications\": [\n        {\n            \"title\": \"High-Resolution Temperature Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/temperature_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data has been quality controlled and bias corrected.\"\n    }\n}"}
