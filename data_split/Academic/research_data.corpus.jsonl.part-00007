{"_id": "Academic--research_data--p--70510", "text": "{\n    \"dataset_name\": \"Atmospheric Composition and Climate Change\",\n    \"creator\": {\n        \"name\": \"National Center for Atmospheric Research (NCAR)\",\n        \"affiliation\": \"University Corporation for Atmospheric Research\"\n    },\n    \"date_collected\": \"2023-03-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"DU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"MIT\",\n    \"sampling_method\": \"Continuous monitoring stations and satellite measurements.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Atmospheric Composition on Global Climate\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70510", "text": "{\n    \"dataset_name\": \"Historical Temperature Records\",\n    \"creator\": {\n        \"name\": \"Global Historical Climatology Network\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2018-11-20T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC-BY-NC-4.0\",\n    \"sampling_method\": \"Weather station measurements.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Temperature Trends\",\n            \"authors\": [\n                \"Brown, K.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/temp_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Data gaps may exist.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70511", "text": "{\n    \"dataset_name\": \"Global Forest Change Dataset\",\n    \"creator\": {\n        \"name\": \"Matthew Hansen\",\n        \"affiliation\": \"University of Maryland\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover2000\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"lossyear\",\n            \"units\": \"year\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Remote sensing data from Landsat satellites\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest change detection from 2000 to 2012\",\n            \"authors\": [\n                \"Matthew Hansen\",\n                \"Peter Potapov\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://earthengine.google.com/datasets/catalog/UMD_hansen_global_forest_change_2020_v1_8\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Global map of forest loss and gain\"\n    }\n}"}
{"_id": "Academic--research_data--n--70511", "text": "{\n    \"dataset_name\": \"Ocean Temperature Readings\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2018-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"sea_surface_temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Buoy measurements and satellite observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Ocean Surface Temperature Analysis\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_temp_data.json\",\n    \"metadata\": {\n        \"data_size\": \"200 MB\",\n        \"annotations\": \"Daily ocean temperature and salinity readings\"\n    }\n}"}
{"_id": "Academic--research_data--p--70512", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring Data\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Toronto\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Regularly spaced sampling buoys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Erie water quality\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"85MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70512", "text": "{\n    \"dataset_name\": \"Atmospheric Pollution in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Dr. David Brown\",\n        \"affiliation\": \"Environmental Protection Agency\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Fixed monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of traffic on urban air quality\",\n            \"authors\": [\n                \"Brown, D.\",\n                \"Smith, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"120MB\",\n        \"annotations\": \"Data includes hourly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70513", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Monitoring - Eastern US\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"National Ecological Observatory Network (NEON)\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Abundance\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"Tree Diameter\",\n            \"units\": \"cm\"\n        },\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"m2/m2\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Random stratified sampling within established forest plots.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term forest dynamics in the eastern United States\",\n            \"authors\": [\n                \"Carter, E.\",\n                \"Smith, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biodiversity_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data includes species identification verified by expert botanists.\"\n    }\n}"}
{"_id": "Academic--research_data--n--70513", "text": "{\n    \"dataset_name\": \"Global Air Quality Index\",\n    \"creator\": {\n        \"name\": \"OpenAQ\",\n        \"affiliation\": \"OpenAQ\"\n    },\n    \"date_collected\": \"2023-05-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5 Concentration\",\n            \"units\": \"µg/m3\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Data aggregated from publicly available air quality monitoring stations worldwide.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global trends in air pollution\",\n            \"authors\": [\n                \"Jones, A.\",\n                \"Lee, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500 MB\",\n        \"annotations\": \"Data includes quality control flags from contributing stations.\"\n    }\n}"}
{"_id": "Academic--research_data--p--70514", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Center for Limnology\",\n        \"affiliation\": \"UW-Madison\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Weekly grab samples from multiple depths\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in Lake Mendota water quality\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Doe, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/lakemendota_wq.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
