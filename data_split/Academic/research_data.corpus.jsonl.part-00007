{"_id": "Academic--research_data--p--67038", "text": "{\n    \"dataset_name\": \"River Water Quality Monitoring Data - USA\",\n    \"creator\": {\n        \"name\": \"US Environmental Protection Agency\",\n        \"affiliation\": \"EPA\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"pH units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Regular sampling at fixed locations along major rivers.\",\n    \"related_publications\": [\n        {\n            \"title\": \"National Rivers and Streams Assessment\",\n            \"year\": 2018\n        }\n    ],\n    \"download_url\": \"https://www.epa.gov/waterdata/river-water-quality-data\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67038", "text": "{\n    \"dataset_name\": \"Air Quality Data - London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"GLA\"\n    },\n    \"date_collected\": \"2022-12-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Government License\",\n    \"sampling_method\": \"Continuous monitoring stations across London.\",\n    \"related_publications\": [\n        {\n            \"title\": \"London Air Quality Strategy\",\n            \"year\": 2018\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/dataset/air-quality-data\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Real-time data feeds available.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67039", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Public Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67039", "text": "{\n    \"dataset_name\": \"Forest Bird Species Distribution\",\n    \"creator\": {\n        \"name\": \"National Audubon Society\",\n        \"affiliation\": \"Non-profit organization\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Name\",\n            \"units\": \"\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Citizen science observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Avian Biodiversity in North American Forests\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/bird_data.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Observations reported by volunteers\"\n    }\n}"}
{"_id": "Academic--research_data--p--67040", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Environments\",\n    \"creator\": {\n        \"name\": \"Environmental Science Research Group\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2021-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient air temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations with hourly data collection.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/air_quality_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67040", "text": "{\n    \"dataset_name\": \"Historical Climate Data - Global Temperature\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2015-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"AverageTemperature\",\n            \"units\": \"Celsius\",\n            \"description\": \"Global average temperature.\"\n        },\n        {\n            \"name\": \"CO2Concentration\",\n            \"units\": \"ppm\",\n            \"description\": \"Concentration of carbon dioxide in the atmosphere.\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Data compiled from various sources over decades.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-Term Climate Trends\",\n            \"authors\": [\n                \"Brown, R.\",\n                \"Davis, L.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.xml\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Includes data from 1880 to 2020.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67041", "text": "{\n    \"dataset_name\": \"Global Precipitation and Temperature Analysis\",\n    \"creator\": {\n        \"name\": \"National Centers for Environmental Information (NCEI)\",\n        \"affiliation\": \"NOAA\"\n    },\n    \"date_collected\": \"2021-05-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Average Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Total Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Sea Surface Temperature\",\n            \"units\": \"Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global gauge network and satellite observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"A global gridded dataset of monthly land surface precipitation\",\n            \"authors\": [\n                \"X. Chen\",\n                \"M. Xie\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://www.ncei.noaa.gov/data/global-precipitation-temperature/\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Quality control flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67041", "text": "{\n    \"dataset_name\": \"Bird Migration Patterns in North America\",\n    \"creator\": {\n        \"name\": \"Cornell Lab of Ornithology\",\n        \"affiliation\": \"Cornell University\"\n    },\n    \"date_collected\": \"2018-11-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Bird Species\",\n            \"units\": \"N/A\"\n        },\n        {\n            \"name\": \"Migration Distance\",\n            \"units\": \"km\"\n        },\n        {\n            \"name\": \"Altitude\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Citizen science observations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Tracking Bird Migration with eBird\",\n            \"authors\": [\n                \"V. Hu\",\n                \"S. Wood\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://ebird.org/data/download\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Observation counts and locations\"\n    }\n}"}
{"_id": "Academic--research_data--p--67042", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - 2023-2024\",\n    \"creator\": {\n        \"name\": \"Environmental Research Institute\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Ground-level ozone concentration\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppb\",\n            \"description\": \"Nitrogen dioxide concentration\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Ambient temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/urban_air_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67042", "text": "{\n    \"dataset_name\": \"Forest Ecosystem Health - 2022-2023\",\n    \"creator\": {\n        \"name\": \"National Forestry Service\",\n        \"affiliation\": \"US Department of Agriculture\"\n    },\n    \"date_collected\": \"2022-12-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"TreeHeight\",\n            \"units\": \"meters\",\n            \"description\": \"Average tree height in the surveyed plot\"\n        },\n        {\n            \"name\": \"LeafAreaIndex\",\n            \"units\": \"dimensionless\",\n            \"description\": \"Measure of the leaf area per unit ground area\"\n        },\n        {\n            \"name\": \"SoilMoisture\",\n            \"units\": \"%\",\n            \"description\": \"Percentage of water in the soil\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Randomly selected forest plots\",\n    \"related_publications\": [\n        {\n            \"title\": \"Forest Carbon Sequestration Rates\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_health.json\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Geographic coordinates included\"\n    }\n}"}
{"_id": "Academic--research_data--p--67043", "text": "{\n    \"dataset_name\": \"BRCA1/2 Mutation Carrier MRI Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Massachusetts General Hospital\"\n    },\n    \"date_collected\": \"2024-03-15T10:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"MRI Scan Image\",\n            \"units\": \"DICOM\"\n        },\n        {\n            \"name\": \"Patient Age\",\n            \"units\": \"years\"\n        },\n        {\n            \"name\": \"BRCA1/2 Mutation Status\",\n            \"units\": \"boolean\"\n        }\n    ],\n    \"data_format\": \"DICOM\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Prospective cohort study\",\n    \"related_publications\": [\n        {\n            \"title\": \"MRI Findings in BRCA1/2 Mutation Carriers\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/brca_mri_dataset\",\n    \"metadata\": {\n        \"data_size\": \"500GB\",\n        \"annotations\": \"Radiologist reports included\"\n    }\n}"}
{"_id": "Academic--research_data--n--67043", "text": "{\n    \"dataset_name\": \"Skin Lesion Image Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. David Lee\",\n        \"affiliation\": \"Stanford University\"\n    },\n    \"date_collected\": \"2023-11-20T14:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dermoscopic Image\",\n            \"units\": \"JPG\"\n        },\n        {\n            \"name\": \"Lesion Diameter\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Diagnosis\",\n            \"units\": \"categorical\"\n        }\n    ],\n    \"data_format\": \"JPG\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Retrospective analysis of clinical images\",\n    \"related_publications\": [\n        {\n            \"title\": \"Deep Learning for Skin Cancer Detection\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/skin_lesion_dataset\",\n    \"metadata\": {\n        \"data_size\": \"100GB\",\n        \"annotations\": \"Dermatologist diagnoses provided\"\n    }\n}"}
{"_id": "Academic--research_data--p--67044", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_London\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Data Commons Open Database License\",\n    \"sampling_method\": \"Continuous monitoring stations across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Air Pollution on Respiratory Health in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://data.london.gov.uk/airquality\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Data includes hourly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67044", "text": "{\n    \"dataset_name\": \"MarineSpeciesAbundance_Pacific\",\n    \"creator\": {\n        \"name\": \"Oceanographic Institute\",\n        \"affiliation\": \"Coastal Research Division\"\n    },\n    \"date_collected\": \"2023-05-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"FishCount\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"WaterTemperature\",\n            \"units\": \"°C\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Research vessel transects across the Pacific Ocean\",\n    \"related_publications\": [\n        {\n            \"title\": \"Distribution of Marine Species in the Pacific\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://oceaninstitute.org/data\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data represents species counts observed during research cruises.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67045", "text": "{\n    \"dataset_name\": \"Global Temperature Anomalies - Updated 2023\",\n    \"creator\": {\n        \"name\": \"GISS Surface Temperature Analysis (GSTA) Team\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-10-26T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Surface Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Anomaly\",\n            \"units\": \"Degrees Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"Degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"Degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global gridded data derived from station measurements.\",\n    \"related_publications\": [\n        {\n            \"title\": \"GISTEMP v4: Global Surface Temperature Analysis\",\n            \"authors\": [\n                \"James E. Hansen\",\n                \"Reto Ruedy\",\n                \"Makiko Sato\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Contains monthly and annual temperature anomalies.  Includes land-ocean temperature index.\",\n        \"number_of_variables\": 4\n    }\n}"}
{"_id": "Academic--research_data--n--67045", "text": "{\n    \"dataset_name\": \"Arctic Sea Ice Extent\",\n    \"creator\": {\n        \"name\": \"National Snow and Ice Data Center (NSIDC)\",\n        \"affiliation\": \"University of Colorado Boulder\"\n    },\n    \"date_collected\": \"2022-09-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Sea Ice Extent\",\n            \"units\": \"square kilometers\"\n        },\n        {\n            \"name\": \"Ice Concentration\",\n            \"units\": \"percentage\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"Degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"Degrees East\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"Unrestricted\",\n    \"sampling_method\": \"Satellite-based observations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Sea Ice Index\",\n            \"authors\": [\n                \"Walt Meier\",\n                \"Julienne Stroeve\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://nsidc.org/data/seaice_index\",\n    \"metadata\": {\n        \"data_size\": \"20MB\",\n        \"annotations\": \"Daily and monthly sea ice extent data. Includes data from various satellite sensors.\",\n        \"number_of_variables\": 4\n    }\n}"}
{"_id": "Academic--research_data--p--67046", "text": "{\n    \"dataset_name\": \"River Water Quality Monitoring - Colorado\",\n    \"creator\": {\n        \"name\": \"Colorado Department of Public Health & Environment\",\n        \"affiliation\": \"CDPHE\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"pH\",\n            \"units\": \"standard units\"\n        },\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Grab samples collected weekly from 20 monitoring sites.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Colorado River Basin Water Quality Assessment\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/colorado_river_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67046", "text": "{\n    \"dataset_name\": \"Air Quality in Denver\",\n    \"creator\": {\n        \"name\": \"Denver Regional Council of Governments\",\n        \"affiliation\": \"DRCOG\"\n    },\n    \"date_collected\": \"2023-08-20T09:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Denver Air Quality Trends\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/denver_air_quality.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Real-time data updates.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67047", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Data\",\n    \"creator\": {\n        \"name\": \"NASA Goddard Institute for Space Studies\",\n        \"affiliation\": \"NASA\"\n    },\n    \"date_collected\": \"2021-05-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"variable_name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Creative Commons Attribution 4.0 International\",\n    \"sampling_method\": \"Satellite observation and ground station measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Climate Change Trends\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/climate_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data includes quality control flags.\"\n    }\n}"}
