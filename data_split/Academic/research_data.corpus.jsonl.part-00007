{"_id": "Academic--research_data--p--68443", "text": "{\n    \"dataset_name\": \"Global Forest Watch Tree Cover Loss Data\",\n    \"creator\": {\n        \"name\": \"Global Forest Watch\",\n        \"affiliation\": \"World Resources Institute\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"treecover_loss\",\n            \"unit\": \"hectares\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"unit\": \"degrees\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"unit\": \"degrees\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Satellite imagery analysis\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global forest watch annual report\",\n            \"year\": 2021\n        }\n    ],\n    \"download_url\": \"https://www.globalforestwatch.org/datasets/tree-cover-loss\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data provides annual tree cover loss globally.\"\n    }\n}"}
