{"_id": "Academic--research_data--n--67891", "text": "{\n    \"dataset_name\": \"Forest Biodiversity Survey - Amazon Rainforest\",\n    \"creator\": {\n        \"name\": \"National Institute of Amazonian Research\",\n        \"affiliation\": \"Biodiversity Department\"\n    },\n    \"date_collected\": \"2022-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Species Richness\",\n            \"unit\": \"count\"\n        },\n        {\n            \"name\": \"Tree Density\",\n            \"unit\": \"trees/hectare\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Random stratified sampling within designated plots.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Biodiversity Assessment of Amazonian Forests\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://amazoniainstitute.org/biodiversity.json\",\n    \"metadata\": {\n        \"data_size\": \"200MB\",\n        \"annotations\": \"Data includes species identification and abundance.\"\n    }\n}"}
