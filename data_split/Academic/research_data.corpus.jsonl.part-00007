{"_id": "Academic--research_data--p--66138", "text": "{\n    \"dataset_name\": \"Human Brain Connectivity Dataset\",\n    \"creator\": {\n        \"name\": \"Dr. Anya Sharma\",\n        \"affiliation\": \"National Institute of Neurological Disorders and Stroke\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Connectivity Strength\",\n            \"units\": \"Correlation Coefficient\"\n        },\n        {\n            \"name\": \"Brain Region\",\n            \"units\": \"Anatomical Label\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"fMRI resting-state scans\",\n    \"related_publications\": [\n        {\n            \"title\": \"Functional Connectivity in Healthy Adults\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/brain_connectivity.csv\",\n    \"metadata\": {\n        \"data_size\": \"1.2 GB\",\n        \"annotations\": \"Data is preprocessed and quality controlled.\"\n    }\n}"}
