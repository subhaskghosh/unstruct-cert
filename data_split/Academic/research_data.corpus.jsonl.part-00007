{"_id": "Academic--research_data--n--67220", "text": "{\n    \"dataset_name\": \"Historical Stock Prices\",\n    \"creator\": {\n        \"name\": \"Yahoo Finance\",\n        \"affiliation\": \"Verizon\"\n    },\n    \"date_collected\": \"2018-05-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Open\",\n            \"units\": \"USD\"\n        },\n        {\n            \"name\": \"High\",\n            \"units\": \"USD\"\n        },\n        {\n            \"name\": \"Low\",\n            \"units\": \"USD\"\n        },\n        {\n            \"name\": \"Close\",\n            \"units\": \"USD\"\n        },\n        {\n            \"name\": \"Volume\",\n            \"units\": \"shares\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Proprietary\",\n    \"sampling_method\": \"Daily stock market data\",\n    \"related_publications\": [],\n    \"download_url\": \"https://finance.yahoo.com/historical_data\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Daily stock price data for major companies.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67221", "text": "{\n    \"dataset_name\": \"Global Surface Temperature Analysis (GSTA)\",\n    \"creator\": {\n        \"name\": \"James Hansen\",\n        \"affiliation\": \"NASA Goddard Institute for Space Studies\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"surface_temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Global gridded data, monthly averages\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Warming in the 21st Century\",\n            \"authors\": [\n                \"James Hansen\",\n                \"Makiko Sato\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://data.giss.nasa.gov/gistemp/\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Includes uncertainty estimates and data quality flags.\"\n    }\n}"}
