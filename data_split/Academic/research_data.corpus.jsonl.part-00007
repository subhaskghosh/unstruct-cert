{"_id": "Academic--research_data--p--67947", "text": "{\n    \"dataset_name\": \"Lake Mendota Water Quality Data\",\n    \"creator\": {\n        \"name\": \"University of Wisconsin-Madison Center for Limnology\",\n        \"affiliation\": \"UW-Madison\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"degrees Celsius\"\n        },\n        {\n            \"variable_name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"variable_name\": \"pH\",\n            \"units\": \"dimensionless\"\n        },\n        {\n            \"variable_name\": \"Chlorophyll-a\",\n            \"units\": \"ug/L\"\n        },\n        {\n            \"variable_name\": \"Total Phosphorus\",\n            \"units\": \"ug/L\"\n        },\n        {\n            \"variable_name\": \"Turbidity\",\n            \"units\": \"NTU\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Regular vertical profiles at multiple locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term trends in water quality of Lake Mendota\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_mendota_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
