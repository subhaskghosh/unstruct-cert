{"_id": "Academic--research_data--n--66385", "text": "{\n    \"dataset_name\": \"Soil Moisture Levels - California\",\n    \"creator\": {\n        \"name\": \"University of California, Berkeley\",\n        \"affiliation\": \"Department of Environmental Science\"\n    },\n    \"date_collected\": \"2022-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Soil Moisture\",\n            \"units\": \"%\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Field measurements at various locations\",\n    \"related_publications\": [\n        {\n            \"title\": \"California Drought Study\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://berkeley.edu/soilmoisture.json\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data collected during the 2022 drought\"\n    }\n}"}
