{"_id": "Academic--research_data--p--68243", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2024\",\n    \"creator\": {\n        \"name\": \"Environmental Monitoring Group, Imperial College London\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2024-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"unit\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"unit\": \"ppb\",\n            \"description\": \"Concentration of ozone in parts per billion.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°C\",\n            \"description\": \"Air temperature.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0\",\n    \"sampling_method\": \"Automated sensors deployed across London boroughs, data logged every hour.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality_2024.csv\",\n    \"metadata\": {\n        \"data_size\": \"15MB\",\n        \"annotations\": \"Data is quality controlled and calibrated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68243", "text": "{\n    \"dataset_name\": \"Historical Pollen Counts - UK 1990-2000\",\n    \"creator\": {\n        \"name\": \"National Pollen Database\",\n        \"affiliation\": \"University of Exeter\"\n    },\n    \"date_collected\": \"2000-07-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Birch Pollen\",\n            \"unit\": \"grains/m³\",\n            \"description\": \"Concentration of birch pollen.\"\n        },\n        {\n            \"name\": \"Grass Pollen\",\n            \"unit\": \"grains/m³\",\n            \"description\": \"Concentration of grass pollen.\"\n        }\n    ],\n    \"data_format\": \"XML\",\n    \"license\": \"Creative Commons Attribution-NonCommercial-ShareAlike 4.0 International\",\n    \"sampling_method\": \"Manual pollen traps in various locations across the UK.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Pollen Seasonality in the UK\",\n            \"year\": 2001\n        }\n    ],\n    \"download_url\": \"https://example.com/uk_pollen_1990_2000.xml\",\n    \"metadata\": {\n        \"data_size\": \"5MB\",\n        \"annotations\": \"Data requires significant cleaning and pre-processing.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68244", "text": "{\n    \"dataset_name\": \"Coastal Ecosystem Health Monitoring - Puget Sound\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"University of Washington, School of Aquatic and Fishery Sciences\"\n    },\n    \"date_collected\": \"2023-05-15T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Chlorophyll-a\",\n            \"units\": \"µg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Regular transect surveys with water samples collected at varying depths.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impacts of Nutrient Runoff on Puget Sound Ecosystems\",\n            \"authors\": \"Carter, E. et al.\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/puget_sound_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data is quality-controlled and includes flags for potential outliers.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68244", "text": "{\n    \"dataset_name\": \"Global Forest Biomass Estimates\",\n    \"creator\": {\n        \"name\": \"FAO Forestry Division\",\n        \"affiliation\": \"Food and Agriculture Organization of the United Nations\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Aboveground Biomass\",\n            \"units\": \"tonnes/hectare\"\n        },\n        {\n            \"name\": \"Belowground Biomass\",\n            \"units\": \"tonnes/hectare\"\n        }\n    ],\n    \"data_format\": \"GeoTIFF\",\n    \"license\": \"CC BY-SA 4.0\",\n    \"sampling_method\": \"Remote sensing data combined with ground-based measurements.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Global Forest Resources Assessment 2020\",\n            \"authors\": \"FAO\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_biomass.tif\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data represents estimates based on modeling and may contain uncertainties.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68245", "text": "{\n    \"dataset_name\": \"Atmospheric Composition Measurements in the Arctic\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Polar Research Institute\"\n    },\n    \"date_collected\": \"2023-05-10T12:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Carbon Dioxide Concentration\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Methane Concentration\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Ozone Concentration\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring with automated sensors\",\n    \"related_publications\": [\n        {\n            \"title\": \"Arctic Atmospheric Trends\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/arctic_atmosphere.csv\",\n    \"metadata\": {\n        \"data_size\": \"500MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68245", "text": "{\n    \"dataset_name\": \"Historical Temperature Records of Europe\",\n    \"creator\": {\n        \"name\": \"Professor David Lee\",\n        \"affiliation\": \"University of Climate Studies\"\n    },\n    \"date_collected\": \"2018-11-15T08:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Average Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Data aggregated from national weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"European Climate History\",\n            \"year\": 2020\n        }\n    ],\n    \"download_url\": \"https://example.com/europe_temp.json\",\n    \"metadata\": {\n        \"data_size\": \"2GB\",\n        \"annotations\": \"Data completeness varies by station.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68246", "text": "{\n    \"dataset_name\": \"Air Quality Monitoring in Urban Areas - 2024\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency\",\n        \"affiliation\": \"US Government\"\n    },\n    \"date_collected\": \"2024-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Air temperature\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of PM2.5 on Respiratory Health\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/airqualitydata.csv\",\n    \"metadata\": {\n        \"data_size\": \"10MB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
