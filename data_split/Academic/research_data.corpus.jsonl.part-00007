{"_id": "Academic--research_data--n--71743", "text": "{\n    \"dataset_name\": \"Industrial Emissions Monitoring - Ruhr Area\",\n    \"creator\": {\n        \"name\": \"Environmental Protection Agency of North Rhine-Westphalia\",\n        \"affiliation\": \"State Government\"\n    },\n    \"date_collected\": \"2023-11-01T14:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"SO2 Emissions\",\n            \"units\": \"kg/hour\"\n        },\n        {\n            \"name\": \"NOx Emissions\",\n            \"units\": \"kg/hour\"\n        },\n        {\n            \"name\": \"Particulate Matter Emissions\",\n            \"units\": \"kg/hour\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY 4.0\",\n    \"sampling_method\": \"Direct stack emission measurements\",\n    \"related_publications\": [\n        {\n            \"title\": \"Industrial Pollution Control in the Ruhr Area\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/ruhr_emissions.json\",\n    \"metadata\": {\n        \"data_size\": \"800MB\",\n        \"annotations\": \"Emission source IDs included.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71744", "text": "{\n    \"dataset_name\": \"Urban Air Quality Monitoring - London 2023\",\n    \"creator\": {\n        \"name\": \"Imperial College London Environmental Research Group\",\n        \"affiliation\": \"Imperial College London\"\n    },\n    \"date_collected\": \"2023-05-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\"\n        },\n        {\n            \"name\": \"Nitrogen Dioxide\",\n            \"units\": \"ppb\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Continuous monitoring stations throughout Greater London\",\n    \"related_publications\": [\n        {\n            \"title\": \"Air Quality Trends in Urban London\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"25MB\",\n        \"annotations\": \"Data has been quality controlled and missing values are interpolated.\"\n    }\n}"}
{"_id": "Academic--research_data--n--71744", "text": "{\n    \"dataset_name\": \"National Forest Health Survey\",\n    \"creator\": {\n        \"name\": \"GreenTech Solutions Inc.\",\n        \"affiliation\": \"GreenTech Solutions Inc.\"\n    },\n    \"date_collected\": \"2023-11-20T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Tree Species\",\n            \"units\": \"Categorical\"\n        },\n        {\n            \"name\": \"Tree Height\",\n            \"units\": \"meters\"\n        },\n        {\n            \"name\": \"Leaf Area Index\",\n            \"units\": \"dimensionless\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Proprietary - Research Use Only\",\n    \"sampling_method\": \"Random forest plots across the United States\",\n    \"related_publications\": [\n        {\n            \"title\": \"Forest Ecosystem Dynamics\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/forest_health_survey.json\",\n    \"metadata\": {\n        \"data_size\": \"60MB\",\n        \"annotations\": \"Dataset requires a paid license for commercial use.\"\n    }\n}"}
{"_id": "Academic--research_data--p--71745", "text": "{\n    \"dataset_name\": \"Lake Erie Water Quality Monitoring 2022-2023\",\n    \"creator\": {\n        \"name\": \"University of Michigan Water Research Institute\",\n        \"affiliation\": \"University of Michigan\"\n    },\n    \"date_collected\": \"2022-05-10T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Dissolved Oxygen\",\n            \"units\": \"mg/L\",\n            \"description\": \"Concentration of dissolved oxygen in water, a key indicator of water health.\"\n        },\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"Celsius\",\n            \"description\": \"Water temperature measured in Celsius.\"\n        },\n        {\n            \"variable_name\": \"Phosphate\",\n            \"units\": \"mg/L\",\n            \"description\": \"Phosphate levels in the water sample, contributing to eutrophication.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Systematic sampling at fixed locations bi-weekly during the monitoring season.\",\n    \"related_publications\": [\n        {\n            \"title\": \"Impact of Nutrient Runoff on Lake Erie Ecosystem\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/lake_erie_water_quality.csv\",\n    \"metadata\": {\n        \"data_size\": \"5.5MB\",\n        \"annotations\": \"Data quality flags are included in a separate column.\"\n    }\n}"}
