{"_id": "Academic--research_data--n--68215", "text": "{\n    \"dataset_name\": \"Indoor Environmental Quality - Residential Homes\",\n    \"creator\": {\n        \"name\": \"John Smith\",\n        \"affiliation\": \"Independent Researcher\"\n    },\n    \"date_collected\": \"2022-11-01T14:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2\",\n            \"unit\": \"ppm\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"unit\": \"%\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"unit\": \"°F\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"MIT License\",\n    \"sampling_method\": \"Sensor data collected from smart home devices.\",\n    \"related_publications\": [],\n    \"download_url\": \"https://example.com/indoor_eq_homes.json\",\n    \"metadata\": {\n        \"data_size\": \"8MB\",\n        \"annotations\": \"Raw sensor data, minimal processing.\"\n    }\n}"}
{"_id": "Academic--research_data--p--68216", "text": "{\n    \"dataset_name\": \"Ocean Temperature and Salinity Data - North Pacific\",\n    \"creator\": {\n        \"name\": \"Dr. Emily Carter\",\n        \"affiliation\": \"Scripps Institution of Oceanography\"\n    },\n    \"date_collected\": \"2022-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"variable_name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"variable_name\": \"Depth\",\n            \"units\": \"meters\"\n        },\n        {\n            \"variable_name\": \"Oxygen\",\n            \"units\": \"mg/L\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Autonomous Underwater Vehicle (AUV) surveys\",\n    \"related_publications\": [\n        {\n            \"title\": \"Long-term changes in North Pacific Ocean properties\",\n            \"year\": 2023,\n            \"authors\": [\n                \"Carter, E.\",\n                \"Lee, J.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10 GB\",\n        \"annotations\": \"Quality control flags included for each data point.\"\n    }\n}"}
{"_id": "Academic--research_data--n--68216", "text": "{\n    \"dataset_name\": \"Global Precipitation Patterns\",\n    \"creator\": {\n        \"name\": \"Rainfall Research Group\",\n        \"affiliation\": \"National Meteorological Institute\"\n    },\n    \"date_collected\": \"2021-11-01T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"variable_name\": \"Precipitation\",\n            \"units\": \"mm/day\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"CC BY-NC 4.0\",\n    \"sampling_method\": \"Satellite-based remote sensing\",\n    \"related_publications\": [\n        {\n            \"title\": \"A statistical model for global precipitation\",\n            \"year\": 2018,\n            \"authors\": [\n                \"Smith, A.\",\n                \"Jones, B.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/precipitation.json\",\n    \"metadata\": {\n        \"data_size\": \"5 GB\",\n        \"annotations\": \"Data gaps may exist due to cloud cover.\"\n    }\n}"}
