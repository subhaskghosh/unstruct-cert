{"_id": "Academic--research_data--p--68630", "text": "{\n    \"dataset_name\": \"Twitter COVID-19 Engagement Metrics\",\n    \"creator\": {\n        \"name\": \"Jane Doe\",\n        \"affiliation\": \"University of California, Berkeley\"\n    },\n    \"date_collected\": \"2024-01-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"retweet_count\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"favorite_count\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"reply_count\",\n            \"units\": \"count\"\n        },\n        {\n            \"name\": \"sentiment_score\",\n            \"units\": \"dimensionless\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"CC0 1.0 Universal\",\n    \"sampling_method\": \"Random sampling of tweets containing COVID-19 keywords\",\n    \"related_publications\": [\n        {\n            \"title\": \"Public Sentiment Towards COVID-19 Vaccination\",\n            \"year\": 2024\n        }\n    ],\n    \"download_url\": \"https://example.com/covid_tweets.csv\",\n    \"metadata\": {\n        \"data_size\": \"50MB\",\n        \"annotations\": \"Sentiment analysis performed using VADER.\"\n    }\n}"}
