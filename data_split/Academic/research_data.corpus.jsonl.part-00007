{"_id": "Academic--research_data--p--67984", "text": "{\n    \"dataset_name\": \"Atmospheric Carbon Dioxide Measurements - Global\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"Earth System Research Laboratories\"\n    },\n    \"date_collected\": \"2021-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"CO2 Concentration (ppm)\",\n            \"units\": \"ppm\"\n        },\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Latitude\",\n            \"units\": \"degrees North\"\n        },\n        {\n            \"name\": \"Longitude\",\n            \"units\": \"degrees East\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Continuous monitoring at fixed stations and flask sampling\",\n    \"related_publications\": [\n        {\n            \"title\": \"Advances in Carbon Capture Technology\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/carbon_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"10GB\",\n        \"annotations\": \"Data quality flags included.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67984", "text": "{\n    \"dataset_name\": \"Ocean Temperature and Salinity Profiles\",\n    \"creator\": {\n        \"name\": \"Woods Hole Oceanographic Institution\",\n        \"affiliation\": \"Department of Oceanography\"\n    },\n    \"date_collected\": \"2018-11-20T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\"\n        },\n        {\n            \"name\": \"Depth\",\n            \"units\": \"meters\"\n        }\n    ],\n    \"data_format\": \"NetCDF\",\n    \"license\": \"CC-BY-NC\",\n    \"sampling_method\": \"Ship-based CTD casts\",\n    \"related_publications\": [\n        {\n            \"title\": \"Oceanic Heat Content Changes\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, R.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/ocean_data.nc\",\n    \"metadata\": {\n        \"data_size\": \"5GB\",\n        \"annotations\": \"Data calibrated to standard oceanographic practices.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67985", "text": "{\n    \"dataset_name\": \"AirQualityMonitoring_London_2023\",\n    \"creator\": {\n        \"name\": \"Greater London Authority\",\n        \"affiliation\": \"Environmental Monitoring Team\"\n    },\n    \"date_collected\": \"2023-03-15T10:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"PM2.5\",\n            \"units\": \"µg/m³\",\n            \"description\": \"Particulate matter with a diameter of 2.5 micrometers or less, a key air quality indicator.\"\n        },\n        {\n            \"name\": \"Ozone\",\n            \"units\": \"ppb\",\n            \"description\": \"Concentration of ozone in the air.\"\n        },\n        {\n            \"name\": \"NO2\",\n            \"units\": \"ppb\",\n            \"description\": \"Nitrogen dioxide concentration.\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Open Data Commons Attribution License\",\n    \"sampling_method\": \"Continuous monitoring stations across London\",\n    \"related_publications\": [\n        {\n            \"title\": \"London Air Quality Report 2023\",\n            \"authors\": [\n                \"Smith, J.\",\n                \"Jones, A.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/london_air_quality_2023.csv\",\n    \"metadata\": {\n        \"data_size\": \"55MB\",\n        \"annotations\": \"Data includes hourly averages.\"\n    }\n}"}
{"_id": "Academic--research_data--n--67985", "text": "{\n    \"dataset_name\": \"OceanTemperatureReadings_Pacific\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration\",\n        \"affiliation\": \"Pacific Marine Research Division\"\n    },\n    \"date_collected\": \"2024-01-20T15:30:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"°C\",\n            \"description\": \"Water temperature at various depths.\"\n        },\n        {\n            \"name\": \"Salinity\",\n            \"units\": \"PSU\",\n            \"description\": \"Salinity levels.\"\n        }\n    ],\n    \"data_format\": \"JSON\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Research vessel deployments\",\n    \"related_publications\": [\n        {\n            \"title\": \"Pacific Ocean Temperature Trends\",\n            \"authors\": [\n                \"Brown, L.\",\n                \"Davis, M.\"\n            ]\n        }\n    ],\n    \"download_url\": \"https://example.com/pacific_ocean_temps.json\",\n    \"metadata\": {\n        \"data_size\": \"150MB\",\n        \"annotations\": \"Data collected from various depths.\"\n    }\n}"}
{"_id": "Academic--research_data--p--67986", "text": "{\n    \"dataset_name\": \"Global Temperature and Precipitation Data\",\n    \"creator\": {\n        \"name\": \"National Oceanic and Atmospheric Administration (NOAA)\",\n        \"affiliation\": \"US Department of Commerce\"\n    },\n    \"date_collected\": \"2022-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Temperature\",\n            \"units\": \"Celsius\"\n        },\n        {\n            \"name\": \"Precipitation\",\n            \"units\": \"mm\"\n        },\n        {\n            \"name\": \"Humidity\",\n            \"units\": \"%\"\n        }\n    ],\n    \"data_format\": \"CSV\",\n    \"license\": \"Public Domain\",\n    \"sampling_method\": \"Global network of weather stations\",\n    \"related_publications\": [\n        {\n            \"title\": \"Trends in Global Temperatures\",\n            \"year\": 2023\n        }\n    ],\n    \"download_url\": \"https://example.com/global_temp_data.csv\",\n    \"metadata\": {\n        \"data_size\": \"100MB\",\n        \"annotations\": \"Data quality flags included\"\n    }\n}"}
