{"_id": "Academic--research_data--p--70652", "text": "{\n    \"dataset_name\": \"Chest X-Ray Images (NIH)\",\n    \"creator\": {\n        \"name\": \"National Institutes of Health\",\n        \"affiliation\": \"NIH Clinical Center\"\n    },\n    \"date_collected\": \"2023-03-15T00:00:00Z\",\n    \"variable_descriptions\": [\n        {\n            \"name\": \"Image Filename\",\n            \"units\": \"string\"\n        },\n        {\n            \"name\": \"Findings\",\n            \"units\": \"text\"\n        },\n        {\n            \"name\": \"Follow-up\",\n            \"units\": \"string\"\n        }\n    ],\n    \"data_format\": \"JPEG\",\n    \"license\": \"Apache 2.0\",\n    \"sampling_method\": \"Retrospective collection from patient records\",\n    \"related_publications\": [\n        {\n            \"title\": \"The NIH Chest X-ray Dataset\",\n            \"year\": 2018\n        }\n    ],\n    \"download_url\": \"https://nihcc.app.box.com/v/ChestXray-NIHCC\",\n    \"metadata\": {\n        \"data_size\": \"320MB\",\n        \"annotations\": \"Radiologist reports\"\n    }\n}"}
