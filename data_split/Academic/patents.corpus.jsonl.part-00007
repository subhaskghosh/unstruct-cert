{"_id": "Academic--patents--p--66894", "text": "{\n    \"patent_title\": \"System and Method for Image Recognition using Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for image recognition using deep neural networks. The system is capable of identifying objects and scenes within images with high accuracy. The core of the system relies on a convolutional neural network trained on a large dataset of labeled images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760987B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising a convolutional neural network...\",\n        \"A method for training a neural network for image recognition...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66894", "text": "{\n    \"patent_title\": \"Method for Enhanced Object Detection in Video Streams\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method for enhancing object detection in video streams. It utilizes a combination of Kalman filtering and background subtraction techniques to improve the accuracy and efficiency of object tracking.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for object detection in video streams comprising Kalman filtering...\",\n        \"A system for real-time object tracking...\"\n    ]\n}"}
