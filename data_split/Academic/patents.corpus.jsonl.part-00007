{"_id": "Academic--patents--p--66965", "text": "{\n    \"patent_title\": \"Method and System for Image Recognition Using Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for image recognition utilizing deep neural networks. The system employs convolutional neural networks to analyze image data and identify objects with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Classification System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising:...\",\n        \"A system for image recognition comprising:...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66965", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2009-12-01\",\n    \"filing_date\": \"2009-12-01\",\n    \"issue_date\": \"2011-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel algorithm for data compression, offering increased efficiency and reduced storage requirements. It utilizes a combination of Huffman coding and run-length encoding.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"title\": \"Data Compression Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising:...\",\n        \"A system for data compression comprising:...\"\n    ]\n}"}
