{"_id": "Academic--patents--p--66863", "text": "{\n    \"patent_title\": \"Deep Learning for Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        },\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-03-15\",\n    \"filing_date\": \"2015-06-20\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep learning system and method for improved image recognition accuracy using convolutional neural networks.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8766954B1\"\n        },\n        {\n            \"patent_number\": \"US9025423B2\"\n        },\n        {\n            \"patent_number\": \"US9123456B1\"\n        },\n        {\n            \"patent_number\": \"US9234567B2\"\n        },\n        {\n            \"patent_number\": \"US9345678B1\"\n        },\n        {\n            \"patent_number\": \"US9456789B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a neural network...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
