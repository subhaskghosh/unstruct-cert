{"_id": "Academic--patents--p--66998", "text": "{\n    \"patent_title\": \"Enhanced Resolution Medical Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A medical imaging system utilizing novel signal processing techniques to enhance image resolution and clarity, particularly for low-contrast tissues.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8657421B2\"\n        }\n    ],\n    \"claims\": [\n        \"A medical imaging system comprising...\",\n        \"A method for enhancing image resolution...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66998", "text": "{\n    \"patent_title\": \"Automated Surgical Instrument Tracking\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for tracking surgical instruments during a procedure using computer vision and machine learning. Improves surgical precision and reduces errors.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument tracking system comprising...\",\n        \"A method for tracking instrument position...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66999", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for reconstructing high-quality images from degraded or incomplete data using deep convolutional neural networks. The system utilizes a novel loss function that combines perceptual and adversarial losses to enhance image fidelity and realism.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Similar image reconstruction technique\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related deep learning architecture\"\n        },\n        {\n            \"patent_number\": \"US9543210B1\",\n            \"relevance\": \"Advanced loss function for image generation\"\n        },\n        {\n            \"patent_number\": \"US10234567B2\",\n            \"relevance\": \"Application of generative models to image enhancement\"\n        },\n        {\n            \"patent_number\": \"US11345678B2\",\n            \"relevance\": \"Image denoising techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an image comprising...\",\n        \"A system for reconstructing an image comprising...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66999", "text": "{\n    \"patent_title\": \"Improved Color Correction Algorithm for Digital Photographs\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Adobe Systems\"\n        }\n    ],\n    \"patent_number\": \"US8901234B1\",\n    \"priority_date\": \"2015-11-01\",\n    \"filing_date\": \"2015-11-01\",\n    \"issue_date\": \"2017-04-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A color correction algorithm that automatically adjusts the color balance of digital photographs to improve their visual appeal. The algorithm uses a histogram-based approach to identify and correct color casts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Basic color correction techniques\"\n        },\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"relevance\": \"Histogram equalization methods\"\n        }\n    ],\n    \"claims\": [\n        \"A method for correcting the color balance of a digital photograph comprising...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67000", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Detection of Sepsis Biomarkers\",\n    \"inventors\": [\n        {\n            \"name\": \"David A. Sinclair\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Maria Gutierrez\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-08-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device capable of rapidly detecting multiple sepsis biomarkers from a small blood sample. The device utilizes a novel antibody-based detection method and integrated microfluidic channels for efficient sample processing and analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in microfluidic device design.\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for detecting sepsis biomarkers using the device...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67000", "text": "{\n    \"patent_title\": \"Implantable Cardioverter-Defibrillator with Enhanced Lead Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"James R. Stone\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2021-01-20\",\n    \"filing_date\": \"2021-01-20\",\n    \"issue_date\": \"2023-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardioverter-defibrillator (ICD) with a novel lead design providing enhanced stability and reduced risk of dislodgement. The device incorporates a flexible lead material and a secure anchoring mechanism.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art in ICD lead design.\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable cardioverter-defibrillator comprising...\",\n        \"A lead for an ICD with enhanced stability...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67001", "text": "{\n    \"patent_title\": \"Method and System for Adaptive Image Enhancement Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2017-05-15\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel deep learning architecture for adaptive image enhancement. The system dynamically adjusts image parameters based on content analysis, resulting in significantly improved visual quality, particularly in low-light conditions.  It represents a substantial advance in image processing technology by overcoming limitations of existing methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image...\",\n        \"A system comprising a deep neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67001", "text": "{\n    \"patent_title\": \"Digital Image Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corp\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2016-08-10\",\n    \"filing_date\": \"2016-08-10\",\n    \"issue_date\": \"2018-04-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A straightforward method for compressing digital images using a lossless compression algorithm. The technique is efficient for reducing storage space and transmission bandwidth. It improves upon existing JPEG implementations by increasing compression ratio by 2%.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image...\",\n        \"A system for encoding image data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67002", "text": "{\n    \"patent_title\": \"Enhanced Image Restoration in Low-Light Environments\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Research\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-11-20\",\n    \"issue_date\": \"2021-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This patent details a novel algorithm for restoring images captured in low-light conditions, utilizing deep learning techniques to enhance clarity and reduce noise. The invention addresses the common problem of image degradation due to insufficient illumination.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image clarity in low-light conditions comprising...\",\n        \"An apparatus for processing images with reduced noise levels...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67002", "text": "{\n    \"patent_title\": \"Method for Compressing Video Data\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Microsoft Corp.\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2018-12-10\",\n    \"filing_date\": \"2019-06-05\",\n    \"issue_date\": \"2022-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for efficiently compressing video data, reducing storage requirements and improving transmission speeds. This invention focuses on optimizing video codecs for high-definition content.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing video data comprising...\",\n        \"A system for encoding and decoding video streams...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67003", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Reconstruction for Enhanced MRI Scans\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel deep learning architecture for reconstructing high-resolution MRI images from undersampled k-space data, significantly reducing scan time and improving image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"A system for performing MRI image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67003", "text": "{\n    \"patent_title\": \"Method for Compressing Digital Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-12-01\",\n    \"filing_date\": \"2019-12-01\",\n    \"issue_date\": \"2022-08-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel method for compressing digital images using wavelet transform and entropy encoding, resulting in reduced file sizes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a digital image comprising...\",\n        \"A system for implementing the compression method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67004", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Cardiac Monitor with Extended Battery Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MedTech Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable cardiac monitor is disclosed, featuring a novel battery technology that provides extended operational life, reducing the frequency of replacement procedures and improving patient quality of life. The device allows for continuous ECG monitoring and remote data transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on implantable cardiac devices.\"\n        }\n    ],\n    \"claims\": [\n        \"1. A miniaturized implantable cardiac monitor comprising...\",\n        \"2. The monitor of claim 1, further comprising...\",\n        \"3. The monitor of claim 2, wherein the battery...\",\n        \"4. A method for monitoring cardiac activity...\",\n        \"5. The method of claim 4, wherein the data...\",\n        \"6. A system for remotely accessing cardiac data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67004", "text": "{\n    \"patent_title\": \"Improved Surgical Stapler Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Surgical Tools\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-08-10\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2021-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler design incorporating a novel cartridge loading mechanism for enhanced ease of use and reduced operating room time. The design provides a more secure and consistent staple application during surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art relating to surgical staplers.\"\n        }\n    ],\n    \"claims\": [\n        \"1. A surgical stapler comprising...\",\n        \"2. The stapler of claim 1, further comprising...\",\n        \"3. The stapler of claim 2, wherein the cartridge...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67005", "text": "{\n    \"patent_title\": \"Improved MRI Image Reconstruction Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing MRI images with reduced scan time and improved resolution, leading to faster and more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8652234B1\",\n            \"title\": \"MRI Pulse Sequence Optimization\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"An MRI system configured to implement the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67005", "text": "{\n    \"patent_title\": \"Enhanced X-Ray Image Filtering\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. John Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2016-11-01\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new image filtering algorithm for improving the clarity of X-ray images, reducing noise and enhancing contrast.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7456789B2\",\n            \"title\": \"X-Ray Image Enhancement Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for filtering X-ray images comprising...\",\n        \"A system for implementing the filtering method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67006", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10245876B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-06-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel deep learning architecture for image reconstruction, significantly improving image quality from degraded or incomplete data. The method utilizes a generative adversarial network (GAN) with a modified loss function to achieve superior results compared to existing techniques. Applications include medical imaging, satellite imagery, and low-light photography. The detailed analysis of the reconstruction process and the exploration of various GAN configurations represent a substantial advancement in the field of image processing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in image denoising\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an image comprising...\",\n        \"A system for implementing the method...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67006", "text": "{\n    \"patent_title\": \"Image Compression Method Using Wavelet Transform\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corp\"\n        }\n    ],\n    \"patent_number\": \"US8901234B1\",\n    \"priority_date\": \"2016-05-20\",\n    \"filing_date\": \"2016-05-20\",\n    \"issue_date\": \"2018-11-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a method for compressing images using a wavelet transform. It is an incremental improvement over existing methods, offering slight gains in compression ratio.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Standard wavelet compression technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image...\",\n        \"A system implementing the compression method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67007", "text": "{\n    \"patent_title\": \"Enhanced Image Recognition System for Autonomous Vehicle Safety\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved image recognition system utilizing deep learning algorithms for accurate object detection in autonomous vehicles. The system is designed to enhance safety by reliably identifying pedestrians, cyclists, and other obstacles in various environmental conditions. Its high accuracy reduces the risk of accidents.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for object detection in autonomous vehicles comprising...\",\n        \"A method for improving the accuracy of image recognition...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67007", "text": "{\n    \"patent_title\": \"Image Recognition for Social Media Filters\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"TechCorp Inc.\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2024-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a method for applying dynamic image filters to social media photos based on recognized facial features. The system allows users to enhance their photos with artistic effects and share them online. It utilizes computer vision to identify faces and apply appropriate transformations.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for applying image filters based on facial recognition...\",\n        \"A system for enhancing social media photos...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67008", "text": "{\n    \"patent_title\": \"Enhanced Image Reconstruction for Low-Dose CT Scans\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2019-07-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image reconstruction algorithm for computed tomography (CT) scans that reduces radiation dose while maintaining image quality. The algorithm utilizes deep learning techniques to enhance image clarity and reduce noise, leading to improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Prior Art CT Reconstruction Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a CT image comprising...\",\n        \"An apparatus for performing CT image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67008", "text": "{\n    \"patent_title\": \"Improved MRI Coil Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2016-11-15\",\n    \"filing_date\": \"2016-11-15\",\n    \"issue_date\": \"2018-03-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new design for magnetic resonance imaging (MRI) coils that enhances signal-to-noise ratio. The coil utilizes a novel geometric arrangement of conductive elements to improve sensitivity and image resolution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Conventional MRI Coil\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil comprising...\",\n        \"A system for performing MRI with the improved coil...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67009", "text": "{\n    \"patent_title\": \"Wearable Sensor System for Remote Cardiac Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-05-15\",\n    \"filing_date\": \"2020-05-15\",\n    \"issue_date\": \"2021-11-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wearable sensor system for continuously monitoring a patient's cardiac activity remotely. The system transmits data wirelessly to a central monitoring station for analysis and alerts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art related to wearable sensors.\"\n        }\n    ],\n    \"claims\": [\n        \"A wearable sensor system comprising...\",\n        \"A method for remotely monitoring cardiac activity...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67009", "text": "{\n    \"patent_title\": \"Implantable Cardiac Pacemaker with Remote Programming\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Medtronic\"\n        },\n        {\n            \"name\": \"Sarah Chen\",\n            \"affiliation\": \"Medtronic\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-12-10\",\n    \"filing_date\": \"2020-12-10\",\n    \"issue_date\": \"2022-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac pacemaker with remote programming capabilities allowing physicians to adjust device parameters without surgical intervention.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related to implantable medical devices.\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable cardiac pacemaker comprising...\",\n        \"A method for remotely programming an implantable pacemaker...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67010", "text": "{\n    \"patent_title\": \"Neural Network-Based Image Enhancement for Low-Light Conditions\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image enhancement technique utilizing deep convolutional neural networks to improve visibility in low-light images. The method incorporates a perceptual loss function to enhance image quality while preserving details.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing low-light images comprising...\",\n        \"An image enhancement system utilizing a deep neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67010", "text": "{\n    \"patent_title\": \"Method for Color Space Conversion in Digital Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2018-08-10\",\n    \"filing_date\": \"2019-09-05\",\n    \"issue_date\": \"2021-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for converting images between different color spaces, such as RGB, YUV, and HSV. The method is optimized for real-time processing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for converting an image from RGB to YUV...\",\n        \"A system for real-time color space conversion...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67011", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical system providing enhanced visualization and dexterity for minimally invasive procedures. The system incorporates a flexible endoscope with integrated imaging and robotic arms for precise manipulation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising a flexible endoscope...\",\n        \"A method for performing a minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67011", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Cardiac Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Medtronic\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-15\",\n    \"issue_date\": \"2022-05-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design for accessing and treating cardiac vessels. The catheter features a novel tip configuration for enhanced maneuverability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible shaft...\",\n        \"A method for treating a cardiac condition...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67012", "text": "{\n    \"patent_title\": \"Ultrasound-Guided Targeted Drug Delivery System for Cancer Therapy\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-06-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel system utilizing focused ultrasound for targeted drug delivery to cancerous tumors, enhancing therapeutic efficacy and minimizing side effects. This technique enables precise drug release within the tumor microenvironment.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art on ultrasound imaging.\"\n        }\n    ],\n    \"claims\": [\n        \"A system for targeted drug delivery comprising a focused ultrasound transducer and a drug-loaded microbubble carrier.\",\n        \"A method for treating cancer using the aforementioned system.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67012", "text": "{\n    \"patent_title\": \"High-Resolution Magnetic Resonance Imaging with Reduced Scan Time\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2015-05-20\",\n    \"filing_date\": \"2015-05-20\",\n    \"issue_date\": \"2018-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved MRI technique employing advanced pulse sequences and parallel imaging to achieve high-resolution images with significantly reduced scan times. This facilitates faster and more comfortable patient examinations.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art related to MRI pulse sequences.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI comprising optimized pulse sequence parameters.\",\n        \"An MRI system configured to implement the aforementioned method.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67013", "text": "{\n    \"patent_title\": \"Enhanced Image Restoration for Low-Light Environments\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Adobe Systems\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-01\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel image processing technique for restoring images captured in low-light conditions, improving visibility and reducing noise.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing images captured in low-light conditions.\",\n        \"An image processing system configured to restore details in underexposed images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67013", "text": "{\n    \"patent_title\": \"Color Correction Algorithm for Digital Cameras\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Sony Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-08-20\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2021-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for improving the color accuracy of digital images through a novel color correction algorithm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A color correction algorithm for digital cameras.\",\n        \"A system for adjusting color balance in images.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67014", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction for Low-Dose Computed Tomography\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel image reconstruction algorithm for computed tomography (CT) scans, enabling high-quality images to be obtained with significantly reduced radiation doses. The method incorporates advanced filtering and iterative optimization techniques to minimize noise and artifacts, resulting in improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"title\": \"Prior Art CT Reconstruction Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a CT image...\",\n        \"The method of claim 1, wherein the radiation dose is reduced by at least 30%...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67014", "text": "{\n    \"patent_title\": \"Automated Surgical Instrument Tracking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2016-11-01\",\n    \"issue_date\": \"2020-04-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system for tracking surgical instruments during a medical procedure using computer vision and machine learning. The system provides real-time feedback to the surgeon, enhancing precision and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Surgical Navigation System\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument tracking system comprising...\",\n        \"The system of claim 1, wherein the tracking accuracy is within 1 mm...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67015", "text": "{\n    \"patent_title\": \"Method and System for Enhancing Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the resolution of an image using a deep convolutional neural network. The network is trained to map low-resolution images to high-resolution images, improving visual clarity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Super-Resolution using Sparse Representation\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising:...\",\n        \"A system for enhancing image resolution comprising:...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67015", "text": "{\n    \"patent_title\": \"System for Compressing Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for compressing medical images using wavelet transforms and entropy encoding, reducing storage space without significant loss of image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Method and System for Enhancing Image Resolution Using Deep Learning\"\n        }\n    ],\n    \"claims\": [\n        \"A system for compressing medical images comprising:...\",\n        \"A method for compressing medical images comprising:...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67016", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method and system for reconstructing medical images from raw data. The method incorporates advanced filtering techniques to significantly improve image resolution and clarity, leading to more accurate diagnoses. Specifically, the method utilizes a deep learning approach to reduce noise and enhance details in CT scans.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for enhancing image resolution in medical imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67016", "text": "{\n    \"patent_title\": \"Automated Surgical Tool Tracking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-11-20\",\n    \"filing_date\": \"2020-03-01\",\n    \"issue_date\": \"2021-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a system for precisely tracking the location and orientation of surgical tools during a medical procedure. The system utilizes a combination of sensors and computer vision algorithms to provide real-time feedback to the surgeon.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for tracking surgical tools comprising...\",\n        \"A method for providing real-time feedback to a surgeon...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67017", "text": "{\n    \"patent_title\": \"Low-Light Image Enhancement Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-09-20\",\n    \"issue_date\": \"2020-01-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a deep learning method for enhancing the visual quality of images captured under low-light conditions. A convolutional neural network is trained to map low-light images to high-quality images with improved brightness and reduced noise.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Denoising Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing a low-light image comprising: training a convolutional neural network...\",\n        \"A system for processing images, comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67017", "text": "{\n    \"patent_title\": \"Method for Compressing High-Resolution Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-11-05\",\n    \"issue_date\": \"2021-07-13\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel method for compressing high-resolution images without significant loss of quality. The method utilizes a wavelet transform and entropy coding to achieve high compression ratios.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Wavelet Based Image Compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image comprising: performing a wavelet transform...\",\n        \"A system for image compression...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67018", "text": "{\n    \"patent_title\": \"Enhanced Magnetic Resonance Imaging for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Chen\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Robert Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2021-01-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel magnetic resonance imaging (MRI) technique utilizing advanced pulse sequences and image reconstruction algorithms to improve the detection of early-stage cancerous tumors. The method significantly enhances image contrast and reduces false-negative rates, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing magnetic resonance imaging comprising...\",\n        \"An MRI system configured to implement the method...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67018", "text": "{\n    \"patent_title\": \"Improved X-Ray Image Processing System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. David Wilson\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"Dr. Sarah Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-05-20\",\n    \"filing_date\": \"2019-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an improved system for processing X-ray images, enhancing image clarity and reducing noise. The system utilizes a novel filtering algorithm and image enhancement techniques to provide higher quality diagnostic images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for processing X-ray images comprising...\",\n        \"A method for enhancing X-ray images...\",\n        \"A computer program for implementing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67019", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for enhancing the accuracy of medical image analysis, specifically for detecting early-stage tumors. The system utilizes a novel deep learning algorithm to improve diagnostic precision and reduce false positives.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9000123B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for analyzing medical images comprising...\",\n        \"A system for detecting anomalies in medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67019", "text": "{\n    \"patent_title\": \"Improved X-ray Tube Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-22\",\n    \"filing_date\": \"2017-11-22\",\n    \"issue_date\": \"2020-04-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved design for X-ray tubes, increasing their efficiency and lifespan. The invention utilizes new materials and cooling techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube comprising...\",\n        \"A cooling system for an X-ray tube...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67020", "text": "{\n    \"patent_title\": \"Method for Enhanced Tumor Detection using Deep Learning and Multi-Modal Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-06-15\",\n    \"issue_date\": \"2021-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for enhancing tumor detection in medical images using deep learning algorithms and combining data from multiple imaging modalities (MRI, CT, PET). The method significantly improves accuracy and reduces false positive rates.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image segmentation\"\n        }\n    ],\n    \"claims\": [\n        \"A method for tumor detection comprising...\",\n        \"A system for processing multi-modal medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67020", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-10\",\n    \"filing_date\": \"2018-12-10\",\n    \"issue_date\": \"2020-05-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new formulation of a gadolinium-based contrast agent for magnetic resonance imaging, providing slightly improved image clarity compared to existing agents.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related contrast agent formulation\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent composition comprising...\",\n        \"A method for enhancing MRI image contrast...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67021", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Cardiac Monitor with Wireless Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-10-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable cardiac monitor for long-term continuous monitoring of heart activity, featuring a novel wireless data transmission protocol for improved patient compliance and early detection of arrhythmias. Addresses the unmet need for less invasive and more reliable cardiac monitoring.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on implantable cardiac devices\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable cardiac monitor comprising...\",\n        \"A wireless data transmission system for transmitting cardiac data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67021", "text": "{\n    \"patent_title\": \"Improved Surgical Stapler Design\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Acme Surgical Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11555444B2\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2024-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler design with enhanced precision and reduced tissue damage. Features a new mechanism for staple deployment and a more ergonomic handle.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous stapler designs\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"A staple deployment mechanism...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67022", "text": "{\n    \"patent_title\": \"Advanced Signal Modulation Techniques for Enhanced Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Ericsson\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Ericsson\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-09-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel modulation techniques to significantly improve signal-to-noise ratio and data transmission rates in wireless communication systems. The techniques are particularly effective in challenging environments with high interference.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for modulating a wireless signal comprising...\",\n        \"An apparatus for demodulating a wireless signal...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67022", "text": "{\n    \"patent_title\": \"Improved Battery Life for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Samsung\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Samsung\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-22\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2021-04-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a power management system for mobile devices that extends battery life by optimizing energy consumption. The system utilizes machine learning to predict user behavior and adjust power settings accordingly.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A power management system for a mobile device comprising...\",\n        \"A method for optimizing energy consumption...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67023", "text": "{\n    \"patent_title\": \"Energy-Efficient Wireless Communication System Using Adaptive Modulation\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-08-15\",\n    \"issue_date\": \"2021-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless communication system and method for improving energy efficiency through adaptive modulation and coding schemes based on channel conditions. The system minimizes power consumption while maintaining reliable data transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication system comprising: an adaptive modulation module...\",\n        \"A method for improving energy efficiency in a wireless communication system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67023", "text": "{\n    \"patent_title\": \"Advanced Signal Processing for 5G Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-12-01\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2020-12-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes novel signal processing techniques for enhancing the performance of 5G networks. It focuses on increasing data throughput and reducing latency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A signal processing method for a 5G network...\",\n        \"A system for improving data throughput in a 5G network...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67024", "text": "{\n    \"patent_title\": \"Deep Learning for Robust Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel deep learning architecture for image recognition, demonstrating significant improvements in accuracy and robustness, particularly in challenging conditions. The innovative approach utilizes attention mechanisms and transfer learning to achieve state-of-the-art performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition using a deep neural network.\",\n        \"A system comprising a deep neural network trained on a large dataset of images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67024", "text": "{\n    \"patent_title\": \"Image Enhancement Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-12-10\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2021-06-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method for enhancing the quality of digital images. It utilizes a filtering algorithm to reduce noise and improve clarity. The technique is suitable for various applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image enhancement using a filtering algorithm.\",\n        \"A system for processing digital images to improve their quality.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67025", "text": "{\n    \"patent_title\": \"Enhanced Medical Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel deep learning method for reconstructing medical images from raw data, resulting in significantly improved image quality and diagnostic accuracy compared to existing techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Prior Art Image Reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"A system for performing medical image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67025", "text": "{\n    \"patent_title\": \"Improved X-ray Tube Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-15\",\n    \"issue_date\": \"2022-06-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel X-ray tube design with improved thermal management and increased lifespan. It does not directly address image processing or diagnostic quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Conventional X-ray Tube Design\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube comprising a novel anode structure...\",\n        \"A system for cooling an X-ray tube...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67026", "text": "{\n    \"patent_title\": \"Surgical Stapler with Articulating Head\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Intuitive Surgical\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical stapler with an articulating head for performing minimally invasive surgical procedures. The device allows for precise tissue approximation and cutting in confined spaces, reducing patient trauma and recovery time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in stapler design\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an articulating head.\",\n        \"The surgical stapler of claim 1, wherein the articulation angle is adjustable.\",\n        \"A method for performing a minimally invasive surgical procedure using the stapler.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67026", "text": "{\n    \"patent_title\": \"Drug Delivery System for Cancer Treatment\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel drug delivery system utilizing nanoparticles for targeted cancer therapy. The system enhances drug efficacy and reduces side effects by delivering chemotherapeutic agents directly to tumor cells.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Prior art in nanoparticle drug delivery\"\n        }\n    ],\n    \"claims\": [\n        \"A drug delivery system comprising nanoparticles.\",\n        \"The drug delivery system of claim 1, wherein the nanoparticles are biodegradable.\",\n        \"A method for treating cancer using the drug delivery system.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67027", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable biosensor for continuous glucose monitoring, utilizing a novel enzymatic reaction and wireless communication protocol for real-time data transmission to an external device.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"title\": \"Glucose Monitoring System\"\n        }\n    ],\n    \"claims\": [\n        \"A biosensor comprising...\",\n        \"A method for continuous glucose monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67027", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US7654321B1\",\n    \"priority_date\": \"2014-12-20\",\n    \"filing_date\": \"2014-12-20\",\n    \"issue_date\": \"2017-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design for targeted drug delivery, featuring a flexible tip and enhanced biocompatibility. Increases efficiency of drug dispersal.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"title\": \"Catheter with Flexible Tip\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising...\",\n        \"A method for drug delivery using the catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67028", "text": "{\n    \"patent_title\": \"Improved MRI Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2021-02-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method for reconstructing MRI images using a deep learning algorithm, resulting in improved image quality and reduced scan time. The method significantly enhances diagnostic accuracy for detecting subtle anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67028", "text": "{\n    \"patent_title\": \"Automated X-Ray Analysis System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Generic Tech Solutions Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2019-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for analyzing X-ray images to detect fractures and other bone abnormalities. The system utilizes image processing techniques to identify potential areas of concern.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10111213B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for analyzing X-ray images comprising...\",\n        \"A method for detecting bone fractures...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67029", "text": "{\n    \"patent_title\": \"Remote Physiological Monitoring System and Method\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for remote monitoring of patient physiological data, including heart rate, blood pressure, and oxygen saturation, using wearable sensors and a cloud-based platform for data analysis and alerts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in wearable sensor technology\"\n        }\n    ],\n    \"claims\": [\n        \"A system for remotely monitoring patient vital signs.\",\n        \"A method for analyzing physiological data to detect anomalies.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67029", "text": "{\n    \"patent_title\": \"Surgical Instrument with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-06-01\",\n    \"filing_date\": \"2019-12-10\",\n    \"issue_date\": \"2020-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical instrument designed for improved precision and control during minimally invasive procedures, featuring a novel articulation mechanism.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related art in surgical instrument design.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument with a novel articulation mechanism.\",\n        \"A method for performing minimally invasive surgery using the instrument.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67030", "text": "{\n    \"patent_title\": \"Noise Reduction in Digital Images Using Adaptive Filtering\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-09-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method for reducing noise in digital images using an adaptive filtering technique. The method analyzes the local statistical properties of the image and adjusts the filter parameters accordingly to minimize noise while preserving image details.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11111111B1\",\n            \"title\": \"Image Enhancement Using Wavelet Transform\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing noise in a digital image comprising...\",\n        \"An apparatus for implementing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67030", "text": "{\n    \"patent_title\": \"System and Method for Object Recognition in Video Streams\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-01\",\n    \"issue_date\": \"2023-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a system and method for real-time object recognition in video streams. The system utilizes deep learning algorithms to identify and track objects of interest.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"title\": \"Deep Learning for Image Classification\"\n        }\n    ],\n    \"claims\": [\n        \"A system for object recognition in video streams comprising...\",\n        \"A method for tracking objects in a video stream using deep learning...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67031", "text": "{\n    \"patent_title\": \"Comfortable Nasal Cannula with Flexible Wings\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MedTech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University Hospital\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-05-15\",\n    \"filing_date\": \"2020-08-20\",\n    \"issue_date\": \"2021-11-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A nasal cannula designed with flexible wings to improve patient comfort and reduce skin irritation during long-term oxygen therapy. The cannula's ergonomic design aims to enhance usability and patient compliance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art related to nasal cannula design.\"\n        }\n    ],\n    \"claims\": [\n        \"A nasal cannula comprising flexible wing structures...\",\n        \"The nasal cannula of claim 1, wherein the wing structures are made of a biocompatible polymer.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67031", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Locking Mechanism\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Surgical Solutions Ltd.\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"Medical Device Corp.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-04-15\",\n    \"issue_date\": \"2022-09-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical stapler featuring a novel locking mechanism to prevent accidental firing during surgical procedures. The stapler improves surgical precision and reduces the risk of complications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous designs of surgical staplers.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising a locking mechanism...\",\n        \"The surgical stapler of claim 1, wherein the locking mechanism is activated by a two-step process.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67032", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Reconstruction for Accelerated MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-09-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning framework for reconstructing high-quality MRI images from undersampled data, enabling faster scan times and improved image resolution. This technology holds significant promise for enhancing diagnostic accuracy and patient comfort.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Compressed Sensing MRI\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images using a deep convolutional neural network.\",\n        \"A system comprising a MRI scanner and a processing unit configured to implement the method.\",\n        \"The method wherein the deep convolutional neural network is trained on a dataset of paired undersampled and fully sampled MRI images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67032", "text": "{\n    \"patent_title\": \"Method for Enhancing Contrast in Digital Photographs\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Kodak\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2017-05-01\",\n    \"filing_date\": \"2017-11-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for automatically adjusting the contrast and brightness of digital photographs to improve their visual appeal. This technique involves histogram equalization and adaptive gamma correction.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Automatic Exposure Control\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing the contrast of a digital image comprising the steps of...\",\n        \"A digital camera comprising a processor configured to implement the method.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67033", "text": "{\n    \"patent_title\": \"Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2015-03-15\",\n    \"filing_date\": \"2015-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable biosensor capable of continuously monitoring glucose levels in real-time, providing data wirelessly to a patient's mobile device. Addresses the need for less invasive glucose monitoring for diabetic patients.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8236123B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for continuously monitoring glucose levels...\",\n        \"An implantable biosensor comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67033", "text": "{\n    \"patent_title\": \"Improved Syringe Design for Insulin Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Baxter Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10456789B1\",\n    \"priority_date\": \"2016-07-20\",\n    \"filing_date\": \"2016-07-20\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A syringe with an improved plunger design for more accurate and comfortable insulin delivery.  Features a reduced force requirement for injection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\"\n        }\n    ],\n    \"claims\": [\n        \"A syringe comprising a plunger...\",\n        \"A method for delivering insulin using the syringe...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67034", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Robotic Assistance\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Boston Dynamics\"\n        }\n    ],\n    \"patent_number\": \"US1054321B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2020-01-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A robotic surgical system enabling precise minimally invasive procedures. The system utilizes advanced sensors and AI-driven algorithms for enhanced surgical control and accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8783942B2\",\n            \"title\": \"Surgical Robot\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising a robotic arm...\",\n        \"A method for performing a minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67034", "text": "{\n    \"patent_title\": \"Improved Catheter Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Medtronic\"\n        }\n    ],\n    \"patent_number\": \"US8998345B1\",\n    \"priority_date\": \"2013-11-20\",\n    \"filing_date\": \"2013-11-20\",\n    \"issue_date\": \"2015-04-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design with enhanced flexibility and biocompatibility. The catheter features a novel coating material to reduce patient discomfort.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7651023B2\",\n            \"title\": \"Catheter with Flexible Tip\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible tip...\",\n        \"A coating material for a catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67035", "text": "{\n    \"patent_title\": \"Deep Learning Based Image Enhancement System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Independent Researcher\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing images using deep convolutional neural networks. The system is capable of reducing noise and improving image clarity significantly.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Processing Using Convolutional Filters\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image comprising...\",\n        \"A system for image enhancement comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67035", "text": "{\n    \"patent_title\": \"Method for Color Correction in Digital Photographs\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Kodak Inc.\"\n        }\n    ],\n    \"patent_number\": \"US7654321B1\",\n    \"priority_date\": \"2014-05-10\",\n    \"filing_date\": \"2014-05-10\",\n    \"issue_date\": \"2016-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for automatically adjusting the color balance in digital photographs to improve their aesthetic quality.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for color correction...\",\n        \"A digital camera incorporating the color correction method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67036", "text": "{\n    \"patent_title\": \"Novel MRI Reconstruction Algorithm for Improved Image Resolution\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-11-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel magnetic resonance imaging (MRI) reconstruction algorithm leveraging deep learning techniques.  It significantly improves image resolution and reduces scan time, offering a breakthrough in diagnostic capabilities, especially for early-stage tumor detection.  Traditional methods are limited by computational cost and noise; this algorithm overcomes these limitations through an iterative denoising process guided by a generative adversarial network. Preliminary results demonstrate a 40% increase in resolution compared to state-of-the-art methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"MRI Image Enhancement Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A computer-readable medium storing instructions for...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67036", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for CT Scans\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-08-01\",\n    \"filing_date\": \"2019-12-10\",\n    \"issue_date\": \"2021-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel contrast agent for use in computed tomography (CT) scans. The agent is based on nanoparticles and offers improved visibility of blood vessels.  It demonstrates reduced toxicity compared to existing iodine-based contrast agents. It provides slight improvements in image clarity for cardiovascular imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Nanoparticle Contrast Agent for CT Imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"A method of enhancing CT images using...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67037", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Boston Medical Center\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-01-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a minimally invasive surgical system incorporating an ergonomic handle design and flexible instruments to enhance surgeon comfort and reduce patient trauma. The system allows for precise manipulation within confined anatomical spaces, leading to faster recovery times and improved patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising an ergonomic handle...\",\n        \"A method for performing minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67037", "text": "{\n    \"patent_title\": \"High-Throughput Drug Screening System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"Genentech\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2021-11-01\",\n    \"filing_date\": \"2021-11-01\",\n    \"issue_date\": \"2023-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for high-throughput screening of drug candidates using microfluidic devices and automated analysis. The system enables rapid identification of compounds with desired biological activity for drug development.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device for drug screening...\",\n        \"A method for automated analysis of drug candidates...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67038", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Segmentation using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method and system for image segmentation using a deep convolutional neural network architecture. The method achieves state-of-the-art accuracy on standard image segmentation datasets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Prior Art Image Segmentation Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image segmentation comprising...\",\n        \"A system for implementing the method...\",\n        \"A computer-readable medium storing...\",\n        \"A deep neural network architecture...\",\n        \"A method for training the deep neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67038", "text": "{\n    \"patent_title\": \"Improved Algorithm for Image Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2018-05-01\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2021-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents an improved algorithm for lossless image compression, achieving higher compression ratios than existing techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\",\n            \"title\": \"Early Image Compression Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image compression...\",\n        \"A system for implementing the compression method...\",\n        \"A computer program for image compression...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67039", "text": "{\n    \"patent_title\": \"Fast Image Denoising Using Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep neural network architecture for image denoising is presented. The network is designed for real-time performance on resource-constrained devices, achieving significantly improved speed and accuracy compared to existing methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for denoising an image comprising...\",\n        \"A deep neural network configured to...\",\n        \"A system for real-time image processing...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67039", "text": "{\n    \"patent_title\": \"Method for Enhancing Image Contrast\",\n    \"inventors\": [\n        {\n            \"name\": \"David Donoho\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Ingrid Daubechies\",\n            \"affiliation\": \"Duke University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method for enhancing the contrast of images, particularly useful in medical imaging applications. The method utilizes wavelet transformations to improve visibility of subtle features.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image contrast comprising...\",\n        \"A wavelet transform configured to...\",\n        \"A system for medical image analysis...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67040", "text": "{\n    \"patent_title\": \"Enhanced Image Reconstruction for Low-Dose Computed Tomography\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2021-03-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel image reconstruction algorithm for computed tomography that significantly reduces radiation dose while maintaining high image quality. The algorithm employs deep learning techniques to enhance image clarity and improve diagnostic accuracy, particularly for detecting subtle anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an image from projection data comprising...\",\n        \"A system for reducing radiation dose in computed tomography...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67040", "text": "{\n    \"patent_title\": \"Improved Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2018-11-10\",\n    \"filing_date\": \"2018-11-10\",\n    \"issue_date\": \"2020-07-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a battery management system (BMS) for electric vehicles designed to improve battery life and safety. The BMS utilizes advanced algorithms to optimize charging and discharging cycles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67041", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction Algorithm for Low-Dose CT Scans\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel image reconstruction algorithm for computed tomography (CT) scans that significantly reduces radiation dose while maintaining high image quality. The algorithm utilizes advanced iterative techniques and incorporates prior knowledge to suppress noise and artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image noise reduction.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an image from projection data comprising...\",\n        \"A system for performing computed tomography including...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67041", "text": "{\n    \"patent_title\": \"MRI Coil Design for Enhanced Signal Reception\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2017-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel design for an MRI coil that enhances signal reception, leading to improved image quality and reduced scan times. The coil incorporates a unique geometric configuration and utilizes advanced materials.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art in MRI coil design.\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil comprising...\",\n        \"A method for using the MRI coil to acquire images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67042", "text": "{\n    \"patent_title\": \"Method for Enhanced MRI Image Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2019-11-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing high-resolution MRI images using a deep learning framework. The method significantly reduces scan time and improves image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67042", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Angiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MedTech Solutions Inc.\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"MedTech Solutions Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11123456B1\",\n    \"priority_date\": \"2019-03-10\",\n    \"filing_date\": \"2019-03-10\",\n    \"issue_date\": \"2021-02-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new catheter design for improved navigation and visualization during angiography procedures. The design incorporates a flexible tip and enhanced contrast delivery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter for angiography comprising...\",\n        \"A system for performing angiography using the catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67043", "text": "{\n    \"patent_title\": \"Enhanced Image Sharpening Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for enhancing the sharpness and resolution of digital images using a deep convolutional neural network. The network is trained to predict high-resolution images from low-resolution inputs, resulting in significant improvements in visual quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising: training a deep convolutional neural network...\",\n        \"An apparatus for enhancing image resolution...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67043", "text": "{\n    \"patent_title\": \"Automated Detection of Tumors in MRI Scans Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, San Francisco\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-02-10\",\n    \"filing_date\": \"2021-04-05\",\n    \"issue_date\": \"2023-03-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a deep learning system for automatically detecting tumors in magnetic resonance imaging (MRI) scans. The system utilizes convolutional neural networks to analyze MRI images and identify potential cancerous regions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting tumors in MRI images...\",\n        \"A system for analyzing MRI data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67044", "text": "{\n    \"patent_title\": \"Deep Convolutional Neural Networks for Real-Time Object Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep learning system for accurate and efficient object detection in images, suitable for autonomous vehicles and surveillance systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        },\n        {\n            \"patent_number\": \"US11111111B2\"\n        },\n        {\n            \"patent_number\": \"US12222222B2\"\n        },\n        {\n            \"patent_number\": \"US13333333B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for object detection using convolutional neural networks.\",\n        \"A system for real-time image analysis.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67044", "text": "{\n    \"patent_title\": \"Theoretical Framework for Improving Gradient Descent in Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11999000B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2021-07-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention introduces a novel mathematical framework for accelerating gradient descent, leading to more efficient training of deep neural networks.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A novel gradient descent algorithm.\",\n        \"A mathematical formulation for optimizing neural network training.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67045", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-01-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel magnetic resonance imaging (MRI) technique utilizing advanced pulse sequences and image reconstruction algorithms to enhance the detection of early-stage cancerous tumors. The technique improves image contrast and reduces scan time, leading to more accurate and efficient diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8450952B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating a magnetic resonance image comprising...\",\n        \"An apparatus for performing magnetic resonance imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67045", "text": "{\n    \"patent_title\": \"System and Method for Automated Document Classification\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alan Turing\",\n            \"affiliation\": \"University of Manchester\"\n        }\n    ],\n    \"patent_number\": \"US7890123B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2018-06-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for automatically classifying documents based on their content. The system utilizes machine learning algorithms to categorize documents into predefined classes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for classifying documents comprising...\",\n        \"A system for automated document classification...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67046", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"David Gracias\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University Medical Center\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical system comprising a miniaturized camera and robotic tools for performing minimally invasive procedures with improved precision and visualization.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising a camera with a diameter less than 3mm.\",\n        \"A method for performing a surgical procedure using robotic tools through a single incision.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67046", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Cardiovascular Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Boston University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-20\",\n    \"filing_date\": \"2021-05-20\",\n    \"issue_date\": \"2023-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel catheter design with enhanced flexibility and biocompatibility for navigating complex cardiovascular systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"Previous catheter designs\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible tip with a diameter between 0.5mm and 1mm.\",\n        \"A method for delivering therapeutic agents through a catheter.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67047", "text": "{\n    \"patent_title\": \"Enhanced MRI Image Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-11-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing MRI images using a deep convolutional neural network, leading to improved image quality and diagnostic accuracy. This invention addresses artifacts and noise present in conventional MRI reconstruction techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67047", "text": "{\n    \"patent_title\": \"Improved CT Scanner Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-12-10\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2021-09-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new design for a CT scanner incorporating improved radiation shielding and faster scanning speeds. This invention results in reduced patient exposure and increased throughput.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A CT scanner comprising...\",\n        \"A method for operating a CT scanner...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67048", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method and system for reconstructing medical images with improved clarity and resolution using advanced filtering algorithms. The system includes a data acquisition unit, a processing unit, and a display unit.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for reconstructing a medical image comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67048", "text": "{\n    \"patent_title\": \"Automated Surgical Tool Tracking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Johns Hopkins University\"\n        }\n    ],\n    \"patent_number\": \"US11555555B1\",\n    \"priority_date\": \"2017-09-20\",\n    \"filing_date\": \"2017-09-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system for tracking the position and orientation of surgical tools during a medical procedure, enhancing surgical precision. The system utilizes computer vision and machine learning techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for tracking surgical tools comprising...\",\n        \"A method for determining the position of a surgical tool comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67049", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Bio-Sensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable biosensor for continuous glucose monitoring. The device utilizes a novel enzymatic reaction and microfluidic design for high accuracy and long-term stability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in glucose sensing\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable biosensor for continuous glucose monitoring.\",\n        \"A method for manufacturing said biosensor.\",\n        \"A system incorporating said biosensor for data transmission.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67049", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Johnson & Johnson\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-08-01\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2020-03-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler designed for enhanced ergonomics and reduced surgeon fatigue. The stapler features a lightweight body and optimized grip.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Previous stapler designs\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler with an ergonomic grip.\",\n        \"A method for using said stapler.\",\n        \"A manufacturing process for said stapler.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67050", "text": "{\n    \"patent_title\": \"Novel Magnetic Resonance Imaging Technique for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel magnetic resonance imaging (MRI) technique that enhances the detection of early-stage cancerous tumors by utilizing a specialized contrast agent and image processing algorithm. The improved sensitivity and specificity offer a significant advancement in early cancer diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8652123B2\",\n            \"relevance\": \"Prior art in MRI contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancer comprising...\",\n        \"An MRI contrast agent comprising...\",\n        \"A system for image processing...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67050", "text": "{\n    \"patent_title\": \"Improved Display Technology for Medical Monitors\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved display technology for medical monitors, offering higher resolution and color accuracy. The technology enhances the visualization of medical images, but does not focus on detection techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related to LCD display technology\"\n        }\n    ],\n    \"claims\": [\n        \"A medical monitor comprising...\",\n        \"A display panel with enhanced resolution...\",\n        \"A color calibration method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67051", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-01-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the resolution of digital images using deep convolutional neural networks. The system employs a novel architecture and training methodology to achieve superior results compared to existing techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image super-resolution\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing the resolution of a digital image...\",\n        \"A system comprising a deep convolutional neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67051", "text": "{\n    \"patent_title\": \"Digital Image Watermarking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corp\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for embedding digital watermarks into images to protect copyright. The system uses a robust algorithm to ensure watermark integrity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art in digital watermarking\"\n        }\n    ],\n    \"claims\": [\n        \"A method for embedding a digital watermark into an image...\",\n        \"A system for verifying the integrity of a digital watermark...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67052", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Cardiac Monitor with Wireless Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Boston Medical Center\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized, fully implantable cardiac monitor capable of continuous ECG monitoring and wireless data transmission to a remote server. The device utilizes advanced signal processing algorithms to detect arrhythmias and alert physicians to potential life-threatening events.  Its small size and biocompatible materials minimize patient discomfort and risk of complications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8236001B2\",\n            \"title\": \"Implantable Cardiac Pacemaker\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable cardiac monitor...\",\n        \"A system for wireless transmission of ECG data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67052", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Angiography\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Johnson & Johnson\"\n        }\n    ],\n    \"patent_number\": \"US8545678B1\",\n    \"priority_date\": \"2014-12-10\",\n    \"filing_date\": \"2014-12-10\",\n    \"issue_date\": \"2016-09-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design incorporating a flexible tip and enhanced lubricity for easier navigation during angiography procedures. The catheter reduces friction and minimizes the risk of vessel damage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7988623B2\",\n            \"title\": \"Angiography Catheter with Steering Mechanism\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible distal tip...\",\n        \"A method for performing angiography using the catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67053", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-06-20\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"US Patent and Trademark Office\",\n    \"abstract\": \"A novel method for reconstructing medical images from raw data, leading to improved clarity and diagnostic accuracy. The method utilizes a deep learning algorithm to reduce noise and enhance features in the reconstructed images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for enhancing the clarity of medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67053", "text": "{\n    \"patent_title\": \"Automated System for Document Classification\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-08-05\",\n    \"issue_date\": \"2023-02-14\",\n    \"patent_office\": \"US Patent and Trademark Office\",\n    \"abstract\": \"An automated system for classifying documents based on their content. The system utilizes machine learning techniques to identify key features and categorize documents accordingly.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10112233B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for classifying documents comprising...\",\n        \"A method for identifying key features in documents...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67054", "text": "{\n    \"patent_title\": \"Non-Invasive Glucose Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-06-10\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive glucose monitoring system utilizing optical sensors to measure glucose levels through the skin. This addresses a critical need for painless and continuous glucose monitoring for diabetic patients.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"relevance\": \"Prior art on optical glucose sensing\"\n        }\n    ],\n    \"claims\": [\n        \"A non-invasive glucose monitoring device comprising...\",\n        \"A method for determining glucose levels using optical sensors...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67054", "text": "{\n    \"patent_title\": \"Surgical Instrument for Minimally Invasive Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-04-15\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical instrument designed for minimally invasive laparoscopic surgery, improving precision and reducing patient recovery time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related art in laparoscopic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising...\",\n        \"A method for performing laparoscopic surgery using the instrument...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67055", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Enhancement for Low-Light Photography\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10556789B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-12-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image enhancement system using deep convolutional neural networks to improve the quality of images captured in low-light conditions. The system learns to map low-light images to high-quality images, enhancing both brightness and detail. This significantly outperforms existing methods in terms of perceptual quality and noise reduction.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Noise Reduction Using Wavelets\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing low-light images comprising...\",\n        \"A deep neural network configured to...\",\n        \"A system for real-time image enhancement...\",\n        \"The method of claim 1, wherein the deep neural network comprises...\",\n        \"The system of claim 3, further comprising a noise reduction module...\",\n        \"The method of claim 1, wherein the low-light image is captured by a mobile device.\",\n        \"The system of claim 3, wherein the enhanced image is displayed on a screen.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67055", "text": "{\n    \"patent_title\": \"Improved Color Correction Algorithm for Digital Cameras\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Canon Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9234567B1\",\n    \"priority_date\": \"2014-11-01\",\n    \"filing_date\": \"2015-05-01\",\n    \"issue_date\": \"2016-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved color correction algorithm for digital cameras that adjusts color balance and saturation to produce more natural-looking images. The algorithm utilizes a lookup table and a histogram equalization technique to enhance color fidelity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"title\": \"Automatic White Balance Adjustment\"\n        }\n    ],\n    \"claims\": [\n        \"A method for color correction in a digital camera comprising...\",\n        \"A lookup table for adjusting color balance...\",\n        \"A histogram equalization module...\",\n        \"The method of claim 1, wherein the lookup table is pre-calibrated...\",\n        \"The histogram equalization module adjusts the contrast of the image.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67056", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2021-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for enhancing the resolution of digital images using deep convolutional neural networks. The system analyzes low-resolution images and generates high-resolution counterparts with improved clarity and detail, significantly enhancing overall image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Super-Resolution Using Sparse Representation\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution...\",\n        \"A system comprising a deep neural network...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67056", "text": "{\n    \"patent_title\": \"Digital Image Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-03-10\",\n    \"filing_date\": \"2017-03-10\",\n    \"issue_date\": \"2022-06-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel digital image compression technique is disclosed, utilizing wavelet transforms and entropy encoding to reduce file size without significant loss of image data. This allows for efficient storage and transmission of images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Wavelet-Based Image Compression System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a digital image...\",\n        \"A system for encoding image data...\",\n        \"A data structure for storing compressed images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67057", "text": "{\n    \"patent_title\": \"Enhanced Magnetic Resonance Imaging with Artificial Intelligence-Assisted Diagnosis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel MRI technique combined with AI algorithms to improve the detection of early-stage tumors, leading to significantly higher diagnostic accuracy and reduced false-positive rates.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art in MRI image processing.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating MRI images comprising...\",\n        \"An AI algorithm for identifying tumors...\",\n        \"A system for diagnosing diseases based on MRI images...\",\n        \"The method of claim 1, wherein the diagnostic accuracy is increased by at least 15%.\",\n        \"The system of claim 3, further comprising a user interface for displaying the diagnostic results.\",\n        \"A non-transitory computer-readable medium storing instructions for...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67057", "text": "{\n    \"patent_title\": \"Improved X-Ray Shielding Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of Michigan\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-12-01\",\n    \"filing_date\": \"2018-12-01\",\n    \"issue_date\": \"2022-07-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new composite material for X-ray shielding, offering improved radiation protection for patients and medical personnel.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art in radiation shielding materials.\"\n        }\n    ],\n    \"claims\": [\n        \"A shielding material comprising...\",\n        \"The shielding material of claim 1, having a density of...\",\n        \"A method for manufacturing the shielding material...\",\n        \"The method of claim 2, wherein the composite material includes lead.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67058", "text": "{\n    \"patent_title\": \"Novel Image Recognition System Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel approach to image recognition using deep convolutional neural networks, achieving significant improvement in accuracy and efficiency compared to existing methods. The system incorporates a new attention mechanism...\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67058", "text": "{\n    \"patent_title\": \"Improved Object Detection in Video Streams\",\n    \"inventors\": [\n        {\n            \"name\": \"Sergey Levine\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-11-20\",\n    \"filing_date\": \"2019-11-20\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an improved object detection system for video streams, enhancing real-time performance. The system utilizes existing object detection algorithms with optimization techniques...\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for object detection in video streams comprising...\",\n        \"A method for object tracking using detected objects comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67059", "text": "{\n    \"patent_title\": \"Method for enhancing resolution in magnetic resonance imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for enhancing the resolution of images acquired using magnetic resonance imaging (MRI) is disclosed. The method utilizes a novel reconstruction algorithm to reduce noise and improve image clarity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing the resolution of MRI images.\",\n        \"A system for performing MRI with enhanced resolution.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67059", "text": "{\n    \"patent_title\": \"System for automated diagnosis of skin cancer using image analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for the automated diagnosis of skin cancer using image analysis techniques is disclosed. The system includes a camera, image processing unit, and a machine learning algorithm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for automatically diagnosing skin cancer.\",\n        \"A method for analyzing skin images to detect cancerous lesions.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67060", "text": "{\n    \"patent_title\": \"Method and System for Adaptive Noise Reduction in Digital Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Adobe Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for adaptively reducing noise in digital images. The system analyzes the image content to determine the optimal noise reduction parameters, resulting in improved image quality and detail preservation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8654321B1\",\n            \"title\": \"Image denoising using wavelet transform\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing noise in a digital image, comprising...\",\n        \"A system for adaptively adjusting noise reduction parameters...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67060", "text": "{\n    \"patent_title\": \"Deep Learning Framework for Object Recognition in Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-15\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep learning framework for accurate object recognition in images. This system utilizes convolutional neural networks to identify and classify objects within a given image.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9456789B2\",\n            \"title\": \"Convolutional neural networks for image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A deep learning system for object recognition...\",\n        \"A method for classifying objects in an image...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67061", "text": "{\n    \"patent_title\": \"Novel MRI Reconstruction Technique for Enhanced Image Clarity\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a significant advancement in magnetic resonance imaging (MRI) reconstruction, enabling dramatically improved image clarity and reduced scan times. A novel algorithm incorporating deep learning techniques is utilized to effectively remove noise and artifacts, leading to enhanced diagnostic capabilities. This represents a breakthrough in medical imaging technology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Prior Art MRI Reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"An MRI system configured to perform...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67061", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Angiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Medtronic\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-04-15\",\n    \"issue_date\": \"2021-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved catheter design for angiography procedures. The catheter features a more flexible tip and enhanced maneuverability, reducing patient discomfort and improving access to target vessels. The design incorporates a new polymer material for increased durability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Standard Angiography Catheter\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible tip...\",\n        \"A method of performing angiography...\",\n        \"A catheter constructed from a polymer material...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67062", "text": "{\n    \"patent_title\": \"Improved MRI Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for reconstructing magnetic resonance images (MRIs) using a deep learning convolutional neural network (CNN). The method improves image quality and reduces scan time, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"MRI Image Reconstruction Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"A system for performing MRI image reconstruction...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67062", "text": "{\n    \"patent_title\": \"New X-Ray Shielding Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2018-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel material composition for shielding against X-ray radiation. The material provides enhanced protection compared to existing lead-based shields.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A shielding material comprising...\",\n        \"A method for manufacturing the shielding material...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67063", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for enhancing the clarity and accuracy of medical images, utilizing advanced image processing algorithms to aid in the detection of subtle anomalies indicative of disease. This system improves diagnostic accuracy and reduces false positives.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Processing Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing medical images comprising...\",\n        \"A system for analyzing medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67063", "text": "{\n    \"patent_title\": \"Improved Algorithm for Satellite Image Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"NASA\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"NASA\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel algorithm for compressing satellite images, reducing storage requirements while maintaining image quality.  This is achieved through advanced wavelet transforms and quantization techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Method and System for Enhanced Medical Image Analysis\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing satellite images...\",\n        \"A system for transmitting compressed image data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67064", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Chen\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for enhancing the resolution and clarity of magnetic resonance images, enabling earlier and more accurate diagnosis of various medical conditions. This system employs a unique pulse sequence and image reconstruction algorithm significantly improving image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in MRI pulse sequences\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI image resolution...\",\n        \"A system comprising a magnet...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67064", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Angiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Mr. Robert Miller\",\n            \"affiliation\": \"MedTech Solutions Inc.\"\n        },\n        {\n            \"name\": \"Ms. Sarah Johnson\",\n            \"affiliation\": \"MedTech Solutions Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-19\",\n    \"issue_date\": \"2020-07-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved design for a catheter used in angiography procedures. The design focuses on improved maneuverability and reduced patient discomfort during insertion.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Previous catheter designs\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible shaft...\",\n        \"A distal tip with a rounded profile...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67065", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method and system for enhancing the resolution and contrast of magnetic resonance images (MRI). A new pulse sequence combined with advanced image reconstruction techniques significantly improves image quality, enabling earlier and more accurate diagnosis of various medical conditions. This represents a substantial advancement in medical imaging technology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"kind\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI image quality comprising...\",\n        \"A system for performing MRI utilizing...\",\n        \"A pulse sequence for MRI characterized by...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67065", "text": "{\n    \"patent_title\": \"Improved X-Ray Imaging System with Reduced Radiation Dose\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-07-20\",\n    \"filing_date\": \"2017-07-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved X-ray imaging system that utilizes a novel filtering technique to reduce the radiation dose required for obtaining diagnostic images.  The system incorporates prior art from US Patent 4,622,642 to achieve improved image clarity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US4622642\",\n            \"kind\": \"cited\"\n        },\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"kind\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A radiation filter for reducing dose...\",\n        \"A method for X-ray imaging utilizing...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67066", "text": "{\n    \"patent_title\": \"Improved MRI Reconstruction Method for Enhanced Diagnostic Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-05-15\",\n    \"issue_date\": \"2023-10-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel method for reconstructing MRI images with significantly improved resolution and contrast, leading to enhanced diagnostic accuracy in detecting subtle anomalies. The new algorithm reduces noise and artifacts, enabling earlier and more reliable diagnosis of various medical conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"type\": \"Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67066", "text": "{\n    \"patent_title\": \"Contrast Agent Delivery System for CT Scans\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2020-11-10\",\n    \"filing_date\": \"2020-11-10\",\n    \"issue_date\": \"2022-09-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a new system for delivering contrast agents during CT scans to improve image quality. The system includes a microfluidic device and a control mechanism for precise dosage regulation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7225776B2\",\n            \"type\": \"Related Art\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"type\": \"Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent delivery system comprising...\",\n        \"A method for delivering contrast agents during CT scans...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67067", "text": "{\n    \"patent_title\": \"Enhanced Resolution MRI Using Deep Learning Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2023-10-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method for reconstructing Magnetic Resonance Images (MRI) using a deep learning algorithm. The method significantly improves image clarity and resolution, enabling more accurate diagnoses. The system incorporates a convolutional neural network trained on a large dataset of MRI scans to reduce noise and enhance detail.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for enhancing MRI resolution...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67067", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Vascular Access\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Medical Devices\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Boston Scientific\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-05\",\n    \"issue_date\": \"2023-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel catheter design that improves vascular access during medical procedures. The catheter features a flexible tip and a lubricious coating for ease of insertion. The design reduces trauma to blood vessels and improves patient comfort.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in catheter design\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible tip...\",\n        \"A vascular access device with a lubricious coating...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67068", "text": "{\n    \"patent_title\": \"Implantable Cardiac Rhythm Management Device with Enhanced Lead Integrity\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Medtronic Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of Minnesota\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac rhythm management device with a novel lead fixation mechanism to improve long-term lead integrity and reduce the risk of dislodgement. The device incorporates advanced sensing algorithms for optimal pacing and defibrillation therapy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art related to leadless pacing systems.\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiac rhythm management device comprising a lead fixation mechanism...\",\n        \"A method for implanting a cardiac rhythm management device...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67068", "text": "{\n    \"patent_title\": \"Surgical Instrument for Orthopedic Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stryker Corporation\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2018-11-01\",\n    \"issue_date\": \"2022-01-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical instrument designed for precise bone cutting and shaping during orthopedic surgeries. The instrument features an ergonomic handle and a novel blade geometry for improved control and maneuverability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous designs of orthopedic surgical instruments.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument for orthopedic procedures comprising a handle...\",\n        \"A method for using the surgical instrument...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67069", "text": "{\n    \"patent_title\": \"High-Resolution Magnetic Resonance Imaging with Enhanced Contrast Agents\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2018-03-20\",\n    \"issue_date\": \"2023-11-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a breakthrough in magnetic resonance imaging (MRI) by utilizing novel contrast agents that dramatically enhance image resolution and diagnostic accuracy. The new agents are biocompatible and target specific biomarkers, leading to clearer visualization of tissues and improved detection of early-stage diseases. This represents a novel approach to non-invasive medical diagnostics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art relating to contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI using novel contrast agents.\",\n        \"The contrast agents described herein.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67069", "text": "{\n    \"patent_title\": \"Improved X-Ray Detector for Mammography\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Philips Healthcare\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"University of Michigan\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2019-02-10\",\n    \"issue_date\": \"2022-08-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention improves the efficiency and sensitivity of X-ray detectors used in mammography. The design incorporates a new scintillator material and optimized detector geometry, resulting in reduced radiation dose and enhanced image quality. The device offers improvements in existing mammography systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art relating to X-ray detectors\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray detector with improved scintillator material.\",\n        \"A mammography system utilizing the improved detector.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67070", "text": "{\n    \"patent_title\": \"Enhanced Image Recognition System Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-09-22\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel deep convolutional neural network architecture for significantly improving image recognition accuracy, particularly in challenging conditions such as low light or partial occlusion.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Convolutional Neural Networks for Image Classification\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a deep convolutional neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67070", "text": "{\n    \"patent_title\": \"Method for Data Compression Using Huffman Coding\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2021-01-05\",\n    \"filing_date\": \"2021-07-12\",\n    \"issue_date\": \"2023-02-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents an improved Huffman coding algorithm for efficient data compression, reducing storage requirements and transmission bandwidth.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Huffman Coding for Data Compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising...\",\n        \"A system for encoding data using Huffman coding...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67071", "text": "{\n    \"patent_title\": \"Deep Convolutional Neural Networks for Image Classification\",\n    \"inventors\": [\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"Google\"\n        },\n        {\n            \"name\": \"Alex Krizhevsky\",\n            \"affiliation\": \"Google\"\n        },\n        {\n            \"name\": \"Ilya Sutskever\",\n            \"affiliation\": \"Google\"\n        }\n    ],\n    \"patent_number\": \"US9483059B2\",\n    \"priority_date\": \"2012-11-26\",\n    \"filing_date\": \"2014-12-18\",\n    \"issue_date\": \"2016-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep convolutional neural network architecture is presented for image classification. The network achieves state-of-the-art results on the ImageNet Large Scale Visual Recognition Challenge.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8510119B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for classifying images using a deep convolutional neural network.\",\n        \"A system for training a deep convolutional neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67071", "text": "{\n    \"patent_title\": \"Method and Apparatus for Image Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US7890123B1\",\n    \"priority_date\": \"2008-05-10\",\n    \"filing_date\": \"2009-05-10\",\n    \"issue_date\": \"2011-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and apparatus for compressing images using wavelet transform. This improves image quality while reducing file size.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for image compression using wavelet transform.\",\n        \"An apparatus for implementing the image compression method.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67072", "text": "{\n    \"patent_title\": \"Novel Image Enhancement Technique Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel image enhancement technique utilizing deep convolutional neural networks. The proposed method achieves a significant improvement in image quality compared to existing state-of-the-art algorithms, especially in low-light conditions. The technique is particularly effective for medical imaging and surveillance applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing images using a deep convolutional neural network.\",\n        \"A system for real-time image enhancement.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67072", "text": "{\n    \"patent_title\": \"Image Compression Method Based on Wavelet Transform\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9123456B1\",\n    \"priority_date\": \"2017-03-01\",\n    \"filing_date\": \"2017-03-01\",\n    \"issue_date\": \"2018-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a method for compressing images using wavelet transform. The method provides efficient compression ratios while maintaining acceptable image quality. The technique is suitable for various image formats and applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related Art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing images using wavelet transform.\",\n        \"A system for image compression.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67073", "text": "{\n    \"patent_title\": \"Method for Noise Reduction in Magnetic Resonance Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-09-20\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for reducing noise in magnetic resonance images using a novel filtering algorithm, resulting in improved image clarity and diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on image filtering techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing noise in an MR image...\",\n        \"The method of claim 1, wherein the filtering algorithm...\",\n        \"A system for performing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67073", "text": "{\n    \"patent_title\": \"System for Automated Drug Dispensing\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2021-01-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for dispensing medications in a hospital setting, improving efficiency and reducing errors.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art on automated dispensing systems.\"\n        }\n    ],\n    \"claims\": [\n        \"A system for dispensing medications...\",\n        \"The system of claim 1, comprising a robotic arm...\",\n        \"A method for controlling the system of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67074", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-11-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-05-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical system incorporating robotic assistance, advanced imaging, and haptic feedback to enable precise and minimally invasive procedures. This system dramatically improves surgical outcomes and reduces patient recovery time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising a robotic arm...\",\n        \"A method for performing a minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67074", "text": "{\n    \"patent_title\": \"Improved Catheter Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Medtronic\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2018-07-01\",\n    \"filing_date\": \"2019-12-10\",\n    \"issue_date\": \"2020-04-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design with enhanced flexibility and kink resistance. This design offers incremental improvements over existing catheters.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art in catheter design\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible shaft...\",\n        \"A method for inserting a catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67075", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Super-Resolution with Generative Adversarial Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Jiawei Zhang\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Hang Zhao\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10783782B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2020-09-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for enhancing the resolution of images using a deep convolutional neural network and a generative adversarial network. The network learns to generate high-resolution images from low-resolution inputs, significantly improving visual quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9989372B2\"\n        },\n        {\n            \"patent_number\": \"US9891679B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for super-resolving an image comprising...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67075", "text": "{\n    \"patent_title\": \"Method and Apparatus for Image Sharpening\",\n    \"inventors\": [\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Kodak\"\n        }\n    ],\n    \"patent_number\": \"US8542345B2\",\n    \"priority_date\": \"2011-05-01\",\n    \"filing_date\": \"2012-05-01\",\n    \"issue_date\": \"2013-09-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for sharpening images by applying a predetermined filter to enhance edges and details. This technique improves the perceived clarity of images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7896453B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for sharpening an image comprising...\",\n        \"An apparatus for performing image sharpening...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67076", "text": "{\n    \"patent_title\": \"Implantable Glucose Monitoring System with Wireless Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-11-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose monitoring system utilizing micro-sensor technology and wireless data transmission for continuous glucose monitoring. This system provides real-time glucose data to a remote monitoring device, improving diabetes management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for continuously monitoring glucose levels...\",\n        \"A wireless communication module for transmitting glucose data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67076", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-10\",\n    \"issue_date\": \"2020-08-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical stapler with an improved ergonomic design for increased comfort and precision during surgical procedures. Features a non-slip grip and optimized trigger mechanism.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an ergonomic handle...\",\n        \"A non-slip grip integrated into the handle...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67077", "text": "{\n    \"patent_title\": \"Deep Learning for Automated Retinal Disease Diagnosis\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep learning system for automated diagnosis of retinal diseases from fundus images. The system utilizes convolutional neural networks to identify biomarkers indicative of diabetic retinopathy and macular degeneration with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for diagnosing retinal diseases using deep learning.\",\n        \"A system comprising a convolutional neural network trained on a dataset of fundus images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67077", "text": "{\n    \"patent_title\": \"Enhanced Image Compression Algorithm for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-08-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image compression algorithm that reduces file size without significant loss of quality, optimized for use on mobile devices. Utilizes wavelet transforms and adaptive quantization.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"An image compression method using wavelet transforms.\",\n        \"A mobile device implementing the compression algorithm.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67078", "text": "{\n    \"patent_title\": \"Miniaturized Robotic System for Enhanced Precision in Minimally Invasive Cardiac Surgery\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11876543B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-12-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized robotic system with enhanced precision and dexterity for performing minimally invasive cardiac surgeries. The system incorporates novel micro-actuators and a high-resolution imaging system for improved surgical outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in robotic surgery\"\n        },\n        {\n            \"patent_number\": \"US10234567B2\",\n            \"relevance\": \"Related to minimally invasive imaging\"\n        },\n        {\n            \"patent_number\": \"US11123456B2\",\n            \"relevance\": \"Similar control systems\"\n        },\n        {\n            \"patent_number\": \"US12345678B2\",\n            \"relevance\": \"Foundation in micro-robotics\"\n        },\n        {\n            \"patent_number\": \"US13456789B2\",\n            \"relevance\": \"Alternative surgical approaches\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized robotic system for minimally invasive surgery.\",\n        \"The system comprising micro-actuators...\",\n        \"A high-resolution imaging system...\",\n        \"A control system for precise manipulation...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67078", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Acme Medical Devices\"\n        }\n    ],\n    \"patent_number\": \"US11543210B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2021-02-10\",\n    \"issue_date\": \"2022-08-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler design featuring enhanced ergonomics for reduced surgeon fatigue during prolonged procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous stapler designs\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Ergonomic handle concepts\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler with an improved ergonomic handle.\",\n        \"The handle comprising a contoured grip...\",\n        \"A mechanism for reducing trigger force...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67079", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing medical images from raw data, significantly improving image clarity and reducing noise, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for implementing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67079", "text": "{\n    \"patent_title\": \"Automated System for Drug Dosage Calculation\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Pharmaceutical Corp\"\n        }\n    ],\n    \"patent_number\": \"US10293847B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system to calculate optimal drug dosages based on patient parameters, improving treatment efficacy and reducing side effects.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for calculating drug dosage comprising...\",\n        \"A method for optimizing drug treatment using the system of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67080", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2015-03-15\",\n    \"filing_date\": \"2015-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for enhancing the analysis of medical images, specifically addressing the challenge of low contrast in CT scans.  The system utilizes a wavelet transform based approach to improve image quality and aid in the detection of subtle anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related prior art in image enhancement.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing medical images comprising...\",\n        \"A system for processing medical images...\",\n        \"The method of claim 1, wherein the medical image is a CT scan.\",\n        \"The system of claim 2, further comprising a display device.\",\n        \"The method of claim 1, wherein the wavelet transform is a Daubechies wavelet.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67080", "text": "{\n    \"patent_title\": \"Digital Image Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2016-07-01\",\n    \"filing_date\": \"2016-07-01\",\n    \"issue_date\": \"2018-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new technique for compressing digital images using a modified JPEG algorithm. It offers improved compression ratios while maintaining acceptable image quality for general use.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art in JPEG compression.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a digital image comprising...\",\n        \"A system for encoding digital images...\",\n        \"The method of claim 1, wherein the image is a photograph.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67081", "text": "{\n    \"patent_title\": \"System and method for object recognition in images\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for identifying objects within an image using deep convolutional neural networks. The system is capable of recognizing a wide variety of objects with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8780821B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for object recognition comprising...\",\n        \"A system for identifying objects in an image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67081", "text": "{\n    \"patent_title\": \"Method for audio signal processing\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9123456B1\",\n    \"priority_date\": \"2017-05-01\",\n    \"filing_date\": \"2017-04-30\",\n    \"issue_date\": \"2018-09-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for enhancing the quality of audio signals using Fourier transforms. The invention focuses on noise reduction and signal clarity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for audio signal processing comprising...\",\n        \"An apparatus for noise reduction in audio signals...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67082", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-06-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical system incorporating real-time image guidance and robotic assistance to enable minimally invasive procedures with improved precision and patient recovery times. The system utilizes advanced algorithms for tissue differentiation and anomaly detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art related to image-guided surgery.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising a robotic arm, an imaging module, and a processing unit.\",\n        \"A method for performing a minimally invasive surgery using the surgical system.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67082", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2019-09-20\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2021-11-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design with enhanced flexibility and flow rate for targeted drug delivery. This design incorporates a modified tip geometry to reduce vessel trauma.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art related to catheter designs.\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter with a flexible distal tip.\",\n        \"A method for delivering drugs using the catheter.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67083", "text": "{\n    \"patent_title\": \"Method and System for Adaptive Image Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Adobe Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for adaptively enhancing the quality of digital images by analyzing image characteristics and applying specific enhancement algorithms. The system utilizes machine learning to optimize enhancement parameters based on image content.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image quality comprising: analyzing image characteristics; selecting an enhancement algorithm based on the analyzed characteristics; and applying the selected algorithm to the image.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67083", "text": "{\n    \"patent_title\": \"Digital Image Processing System\",\n    \"inventors\": [\n        {\n            \"name\": \"Hans Müller\",\n            \"affiliation\": \"Siemens AG\"\n        }\n    ],\n    \"patent_number\": \"EP3456789A1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2018-12-05\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"A digital image processing system for medical imaging applications. The system includes modules for image acquisition, pre-processing, analysis, and visualization.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A digital image processing system comprising: an image acquisition module; a pre-processing module; an analysis module; and a visualization module.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67084", "text": "{\n    \"patent_title\": \"Novel MRI Contrast Agent for Enhanced Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel MRI contrast agent utilizing targeted nanoparticles for significantly enhanced tumor detection. The agent exhibits improved biocompatibility and prolonged circulation time, leading to higher tumor-to-background ratios and clearer image resolution. Initial in vivo studies demonstrate promising results in identifying early-stage cancers.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"MRI Contrast Agents Based on Iron Oxide Nanoparticles\"\n        }\n    ],\n    \"claims\": [\n        \"A composition comprising a nanoparticle coated with a targeting ligand.\",\n        \"A method for enhancing tumor detection using the composition.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67084", "text": "{\n    \"patent_title\": \"Improved X-Ray Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2022-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved X-ray imaging system with enhanced image processing algorithms. The system provides clearer images with reduced radiation exposure. The improvement primarily relates to filter optimization and noise reduction techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Digital X-Ray Imaging with Noise Reduction\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising an X-ray source and a detector.\",\n        \"A method for processing X-ray images to reduce noise.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67085", "text": "{\n    \"patent_title\": \"Miniature Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2019-03-20\",\n    \"issue_date\": \"2021-07-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel miniature biosensor for continuous glucose monitoring. The device utilizes a groundbreaking enzymatic reaction combined with a microfluidic channel to achieve high sensitivity and accuracy, representing a significant improvement over existing technologies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on glucose sensors\"\n        }\n    ],\n    \"claims\": [\n        \"A miniature implantable biosensor comprising...\",\n        \"A method for continuous glucose monitoring using the biosensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67085", "text": "{\n    \"patent_title\": \"Improved Surgical Stapler Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Smith\",\n            \"affiliation\": \"Acme Medical Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2018-08-15\",\n    \"issue_date\": \"2020-01-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler design offering enhanced precision and reduced tissue damage. The stapler features a modified jaw geometry and firing mechanism.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Existing surgical stapler designs\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising a modified jaw geometry...\",\n        \"A method for performing surgical anastomosis using the stapler...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67086", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for improving the quality of reconstructed images from medical imaging modalities such as MRI and CT scans. The method utilizes a novel algorithm to reduce noise and artifacts, resulting in clearer and more accurate images for diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Prior Art Medical Imaging System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"A system comprising a processor...\",\n        \"The method of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67086", "text": "{\n    \"patent_title\": \"Improved Image Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-15\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved image compression algorithm that reduces file size without significant loss of image quality. The algorithm utilizes a combination of wavelet transforms and entropy coding.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Previous Image Compression Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image...\",\n        \"A system for encoding and decoding images...\",\n        \"The method of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67087", "text": "{\n    \"patent_title\": \"Novel MRI Technique for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2018-03-20\",\n    \"issue_date\": \"2021-11-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel magnetic resonance imaging (MRI) technique utilizing advanced pulse sequences and contrast agents for the early and accurate detection of cancerous tumors. The method significantly improves sensitivity and specificity compared to conventional MRI techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"MRI Contrast Agent Development\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Pulse Sequence Optimization for MRI\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Reconstruction Algorithms for MRI\"\n        },\n        {\n            \"patent_number\": \"US11000001B2\",\n            \"title\": \"Biomarker Detection via MRI\"\n        },\n        {\n            \"patent_number\": \"US11111111B2\",\n            \"title\": \"Advanced MRI Coil Design\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancerous tumors using MRI comprising...\",\n        \"An MRI system configured to perform the method of claim 1...\",\n        \"A contrast agent for use in the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67087", "text": "{\n    \"patent_title\": \"Improved X-Ray Shielding Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Wilson\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2017-12-15\",\n    \"issue_date\": \"2020-09-29\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new composite material for shielding against X-ray radiation. The material offers enhanced protection and reduced weight compared to existing shielding materials.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"X-Ray Attenuation Materials\"\n        },\n        {\n            \"patent_number\": \"US9654321B2\",\n            \"title\": \"Radiation Shielding Composites\"\n        },\n        {\n            \"patent_number\": \"US10543210B2\",\n            \"title\": \"Lead-Free Shielding Materials\"\n        }\n    ],\n    \"claims\": [\n        \"A composite material for shielding against X-ray radiation comprising...\",\n        \"A shielding device utilizing the composite material of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67088", "text": "{\n    \"patent_title\": \"Novel MRI Coil Design for Enhanced Cardiac Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        },\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2018-03-20\",\n    \"issue_date\": \"2021-11-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel MRI coil design incorporating metamaterials to significantly enhance signal-to-noise ratio in cardiac imaging, enabling faster scan times and improved image quality. This invention represents a significant advancement in the field of medical imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on MRI coil design.\"\n        }\n    ],\n    \"claims\": [\n        \"A magnetic resonance imaging (MRI) coil comprising...\",\n        \"The MRI coil of claim 1, wherein the metamaterial is...\",\n        \"A method for performing cardiac imaging using the MRI coil of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67088", "text": "{\n    \"patent_title\": \"Improved X-Ray Shielding Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Eve Green\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        },\n        {\n            \"name\": \"Frank Brown\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2016-12-01\",\n    \"filing_date\": \"2017-11-10\",\n    \"issue_date\": \"2020-08-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new composite material for X-ray shielding with improved lead content and durability. This material offers enhanced protection for patients and technicians during X-ray procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous work on X-ray shielding materials.\"\n        }\n    ],\n    \"claims\": [\n        \"A shielding material comprising...\",\n        \"The shielding material of claim 1, wherein the lead content is...\",\n        \"A method for manufacturing the shielding material...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67089", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"David Y. Chen\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Maria Rodriguez\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system utilizing micro-robotics and advanced imaging for precise tissue manipulation and removal. The system features a novel visualization technique providing surgeons with a 3D view of the surgical site.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising a robotic arm...\",\n        \"A method for performing a minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67089", "text": "{\n    \"patent_title\": \"Enhanced Catheter Design for Cardiovascular Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design for accessing and treating cardiovascular blockages. The catheter features a flexible tip and enhanced biocompatibility.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible distal tip...\",\n        \"A method for treating cardiovascular disease...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67090", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Enhanced Biocompatibility\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10556789B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel implantable glucose sensor featuring a biocompatible coating that significantly reduces foreign body response, enabling long-term, accurate glucose monitoring for diabetic patients. Current continuous glucose monitors suffer from limited lifespan due to inflammation and biofouling. This device addresses this critical unmet clinical need by maintaining sensor accuracy for over one year in pre-clinical trials.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on glucose sensing technology\"\n        }\n    ],\n    \"claims\": [\n        \"A glucose sensor comprising a biocompatible coating.\",\n        \"The glucose sensor of claim 1, wherein the biocompatible coating is based on polyethylene glycol.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67090", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Johnson & Johnson\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2019-07-20\",\n    \"filing_date\": \"2019-07-20\",\n    \"issue_date\": \"2021-05-04\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a surgical stapler with an improved handle design for enhanced grip and reduced hand fatigue during prolonged surgical procedures. The stapler features a textured surface and optimized weight distribution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art on surgical staplers\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an ergonomic handle.\",\n        \"The surgical stapler of claim 1, wherein the handle is textured.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67091", "text": "{\n    \"patent_title\": \"Implantable Cardiac Monitor with Wireless Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Medtronic Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-01-20\",\n    \"issue_date\": \"2021-03-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac monitor capable of wirelessly transmitting electrocardiogram (ECG) data for remote patient monitoring. The device features low power consumption and improved data security.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for remotely monitoring a patient's cardiac activity.\",\n        \"An implantable device comprising a wireless communication module.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67091", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Ethicon Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-10\",\n    \"issue_date\": \"2021-05-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical stapler designed with enhanced ergonomics for improved surgeon comfort and precision during surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an ergonomically designed handle.\",\n        \"A method for performing surgical stapling with improved precision.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67092", "text": "{\n    \"patent_title\": \"Improved Image Segmentation Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel image segmentation technique utilizing deep convolutional neural networks. The method achieves state-of-the-art results in computer vision tasks, demonstrating improved accuracy and efficiency compared to existing approaches.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for segmenting an image comprising...\",\n        \"A system for performing image segmentation...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67092", "text": "{\n    \"patent_title\": \"Method for Enhancing Audio Signal Quality\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2022-03-15\",\n    \"filing_date\": \"2022-03-15\",\n    \"issue_date\": \"2024-02-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel approach to improving the clarity and fidelity of audio signals. The method utilizes advanced filtering techniques to reduce noise and enhance specific frequency components.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10111213B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing an audio signal comprising...\",\n        \"An apparatus for enhancing audio signal quality...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67093", "text": "{\n    \"patent_title\": \"Novel Magnetic Resonance Imaging Technique for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-01\",\n    \"issue_date\": \"2021-06-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new MRI technique utilizing advanced pulse sequences and image reconstruction algorithms for improved detection of early-stage cancerous tumors.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on MRI pulse sequences\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI comprising...\",\n        \"An apparatus for performing MRI...\",\n        \"A system for detecting cancerous tumors...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67093", "text": "{\n    \"patent_title\": \"Improved X-Ray Image Processing Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-11-20\",\n    \"filing_date\": \"2019-12-20\",\n    \"issue_date\": \"2020-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An algorithm for enhancing the clarity and reducing noise in X-ray images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing X-ray images comprising...\",\n        \"A system for enhancing X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67094", "text": "{\n    \"patent_title\": \"Noise Reduction in Low-Light Imaging using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Li Wei\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Zhang Xin\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2017-05-15\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for reducing noise in low-light images using a deep convolutional neural network. The network is trained to map noisy low-light images to clean, high-quality images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing noise in an image comprising...\",\n        \"A system for processing low-light images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67094", "text": "{\n    \"patent_title\": \"Improved Color Correction for High Dynamic Range Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Kim Min-su\",\n            \"affiliation\": \"Samsung Electronics\"\n        }\n    ],\n    \"patent_number\": \"US11123456B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2018-11-01\",\n    \"issue_date\": \"2020-09-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for improving color correction in high dynamic range images, enhancing the visual quality and realism of displayed images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for color correcting an image...\",\n        \"A device for processing high dynamic range images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67095", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Enhancement for Low-Light Conditions\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Adobe Research\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for enhancing images captured in low-light conditions. The system utilizes a generative adversarial network (GAN) to produce high-quality, visually appealing images with improved detail and reduced noise.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"count\": 120\n        },\n        {\n            \"patent_number\": \"US10987654B2\",\n            \"count\": 85\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image comprising...\",\n        \"A system for processing images...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67095", "text": "{\n    \"patent_title\": \"Method for Displaying Images on a Mobile Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Samsung Electronics\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"LG Display\"\n        }\n    ],\n    \"patent_number\": \"US11789012B2\",\n    \"priority_date\": \"2021-07-01\",\n    \"filing_date\": \"2021-07-01\",\n    \"issue_date\": \"2023-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for efficiently displaying images on a mobile device, optimizing for battery life and screen resolution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"count\": 25\n        }\n    ],\n    \"claims\": [\n        \"A mobile device comprising...\",\n        \"A method for rendering images...\",\n        \"A system for managing display settings...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67096", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-11-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the resolution of images using a deep convolutional neural network. The system learns to map low-resolution images to high-resolution images, significantly improving perceptual quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Super-Resolution using Sparse Representation\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution, comprising...\",\n        \"The method of claim 1, wherein the deep convolutional neural network...\",\n        \"A system for enhancing image resolution, comprising...\",\n        \"The system of claim 3, further comprising...\",\n        \"A non-transitory computer-readable medium storing...\",\n        \"The computer-readable medium of claim 5, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67096", "text": "{\n    \"patent_title\": \"System for Automated Image Tagging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-09-01\",\n    \"filing_date\": \"2019-12-10\",\n    \"issue_date\": \"2021-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for automatically tagging images with relevant keywords using computer vision and machine learning techniques. The system analyzes image content and assigns appropriate tags.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Image Classification using Convolutional Neural Networks\"\n        }\n    ],\n    \"claims\": [\n        \"A system for automatically tagging images, comprising...\",\n        \"The system of claim 1, wherein the computer vision module...\",\n        \"A method for automatically tagging images, comprising...\",\n        \"The method of claim 3, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67097", "text": "{\n    \"patent_title\": \"Method for Enhanced Magnetic Resonance Imaging of Tumors\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for improving the contrast and resolution of MRI images of tumors, using a novel contrast agent and imaging sequence.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8652012B2\",\n            \"title\": \"MRI Contrast Agents\"\n        },\n        {\n            \"patent_number\": \"US9233456B1\",\n            \"title\": \"Imaging Sequence Optimization\"\n        },\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Tumor Detection Methods\"\n        },\n        {\n            \"patent_number\": \"US10234567B2\",\n            \"title\": \"Advanced MRI Techniques\"\n        },\n        {\n            \"patent_number\": \"US8456789B1\",\n            \"title\": \"Contrast Enhancement in MRI\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI images...\",\n        \"A contrast agent comprising...\",\n        \"An imaging sequence characterized by...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67097", "text": "{\n    \"patent_title\": \"Portable X-Ray Device for Bone Fracture Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"GE Healthcare\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Johns Hopkins University\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-02-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A compact and portable X-ray device designed for rapid bone fracture diagnosis in emergency settings.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"title\": \"Portable Radiography Systems\"\n        },\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Digital X-Ray Detectors\"\n        }\n    ],\n    \"claims\": [\n        \"A portable X-ray device comprising...\",\n        \"A system for detecting bone fractures...\",\n        \"A method for imaging skeletal structures...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67098", "text": "{\n    \"patent_title\": \"Enhanced Resolution Medical Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-05-10\",\n    \"filing_date\": \"2018-05-10\",\n    \"issue_date\": \"2020-11-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A medical imaging system utilizing advanced signal processing techniques to enhance image resolution and clarity, improving diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A medical imaging system comprising...\",\n        \"A method for enhancing image resolution...\"\n    ]\n}"}
