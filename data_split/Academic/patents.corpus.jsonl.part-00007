{"_id": "Academic--patents--p--66518", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition Using Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for improving image recognition accuracy using deep neural networks. The invention leverages convolutional neural networks and transfer learning to achieve state-of-the-art results in various image classification tasks. This invention is applicable to autonomous driving, object detection, and other computer vision applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Convolutional Neural Network Architecture\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66518", "text": "{\n    \"patent_title\": \"Implantable Medical Device with Neural Network Control System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"MedTech Innovations\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2023-06-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable medical device that utilizes a neural network for precise control of drug delivery. The system continuously monitors patient vital signs and adjusts medication dosage based on neural network predictions. The device is designed for chronic pain management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Implantable Drug Delivery System\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable medical device comprising...\",\n        \"A control system based on a neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66519", "text": "{\n    \"patent_title\": \"System and method for dynamic content delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-05-15\",\n    \"filing_date\": \"2010-03-20\",\n    \"issue_date\": \"2018-07-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for dynamically delivering content based on user preferences and network conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Content delivery network\"\n        },\n        {\n            \"patent_number\": \"US8212345B2\",\n            \"title\": \"Adaptive streaming\"\n        },\n        {\n            \"patent_number\": \"US9123456B1\",\n            \"title\": \"Personalized content recommendation\"\n        },\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Network congestion control\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"User preference profiling\"\n        }\n    ],\n    \"claims\": [\n        \"A system for dynamic content delivery...\",\n        \"A method for determining user preferences...\"\n    ]\n}"}
