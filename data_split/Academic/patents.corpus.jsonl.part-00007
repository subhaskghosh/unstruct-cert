{"_id": "Academic--patents--p--66971", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2021-11-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel system and method for image recognition using deep learning techniques. The system is capable of identifying objects with high accuracy even in challenging conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Classification Algorithm\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Convolutional Neural Network Architecture\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Object Detection System\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for identifying objects in an image...\",\n        \"The system of claim 1, wherein the deep learning model is a convolutional neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66971", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2021-01-10\",\n    \"issue_date\": \"2022-05-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system that enhances battery life and safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10987654B1\",\n            \"title\": \"Battery Monitoring Techniques\"\n        },\n        {\n            \"patent_number\": \"US11000001B2\",\n            \"title\": \"Lithium-Ion Battery Optimization\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for monitoring battery health...\",\n        \"The system of claim 1, wherein the battery is a lithium-ion battery.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66972", "text": "{\n    \"patent_title\": \"Novel Carbon Nanotube Composites for High-Strength Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"SLAC National Accelerator Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2018-03-01\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel carbon nanotube composites exhibiting superior tensile strength and conductivity. The materials are suitable for a wide range of applications, including aerospace and electronics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A composite material comprising carbon nanotubes and a polymer matrix.\",\n        \"The composite material of claim 1, wherein the carbon nanotubes are aligned.\",\n        \"A method for manufacturing the composite material of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66972", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Wilson\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2018-02-15\",\n    \"issue_date\": \"2019-08-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to improved electrode materials for lithium-ion batteries, enhancing energy density and cycle life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"An electrode material comprising a lithium metal oxide.\",\n        \"The electrode material of claim 1, further comprising a conductive additive.\",\n        \"A lithium-ion battery comprising the electrode material of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66973", "text": "{\n    \"patent_title\": \"AI-Powered Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-11-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an image recognition system powered by artificial intelligence algorithms. The system can identify objects with high accuracy and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition using artificial intelligence.\",\n        \"A method for training an artificial intelligence model for image recognition.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66973", "text": "{\n    \"patent_title\": \"Novel Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-07-01\",\n    \"filing_date\": \"2019-12-10\",\n    \"issue_date\": \"2021-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new type of lithium-ion battery with improved energy density and lifespan. It utilizes a novel electrode material and electrolyte composition.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery with increased energy density.\",\n        \"A novel electrolyte composition for lithium-ion batteries.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66974", "text": "{\n    \"patent_title\": \"System and method for personalized search results\",\n    \"inventors\": [\n        {\n            \"name\": \"Sergey Brin\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Larry Page\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-03-15\",\n    \"filing_date\": \"2010-02-10\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for providing personalized search results based on user profiles and search history.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for ranking search results...\",\n        \"A system for personalizing search results...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66974", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Elon Musk\",\n            \"affiliation\": \"Tesla, Inc.\"\n        },\n        {\n            \"name\": \"J.B. Straubel\",\n            \"affiliation\": \"Tesla, Inc.\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2008-11-20\",\n    \"filing_date\": \"2009-12-01\",\n    \"issue_date\": \"2017-09-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery technology designed to improve energy density and lifespan for electric vehicles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising...\",\n        \"A battery pack using the cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66975", "text": "{\n    \"patent_title\": \"Miniature Pressure Sensor with Integrated Signal Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2018-03-20\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature pressure sensor is disclosed, integrating signal processing circuitry for improved accuracy and reduced power consumption. The sensor is designed for use in wearable devices and IoT applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"1. A pressure sensor comprising...\",\n        \"2. The pressure sensor of claim 1, further comprising...\",\n        \"3. The pressure sensor of claim 2, wherein...\",\n        \"4. A system comprising the pressure sensor of claim 1...\",\n        \"5. The system of claim 4, wherein...\",\n        \"6. A method for manufacturing a pressure sensor...\"\n    ]\n}"}
