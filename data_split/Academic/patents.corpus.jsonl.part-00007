{"_id": "Academic--patents--p--66056", "text": "{\n    \"patent_title\": \"Method for Efficient Genome Editing using CRISPR-Cas9\",\n    \"inventors\": [\n        {\n            \"name\": \"Jennifer Doudna\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emmanuelle Charpentier\",\n            \"affiliation\": \"Max Planck Unit for the Science of Pathogens\"\n        }\n    ],\n    \"patent_number\": \"US10723893B2\",\n    \"priority_date\": \"2012-05-02\",\n    \"filing_date\": \"2019-04-15\",\n    \"issue_date\": \"2020-07-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"The invention provides methods and compositions for genome editing using CRISPR-Cas9 technology, offering improved efficiency and specificity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8697359B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for modifying a target DNA sequence in a cell comprising...\",\n        \"A CRISPR-Cas9 complex comprising...\"\n    ]\n}"}
