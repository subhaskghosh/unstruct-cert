{"_id": "Academic--patents--p--66230", "text": "{\n    \"patent_title\": \"System and Method for Personalized Recommendation Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for providing personalized recommendations to users based on their past behavior and preferences, using a deep learning model.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Recommendation Engine based on Collaborative Filtering\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Personalized Content Delivery System\"\n        },\n        {\n            \"patent_number\": \"US11000001B2\",\n            \"title\": \"Deep Neural Networks for Recommendation\"\n        },\n        {\n            \"patent_number\": \"US10234567B2\",\n            \"title\": \"User Preference Modeling using Machine Learning\"\n        },\n        {\n            \"patent_number\": \"US9999999B2\",\n            \"title\": \"Context-Aware Recommendation System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating personalized recommendations...\",\n        \"A system comprising a deep learning model...\"\n    ]\n}"}
