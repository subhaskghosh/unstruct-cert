{"_id": "Academic--patents--p--65883", "text": "{\n    \"patent_title\": \"Micro-Robotic System for Targeted Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a micro-robotic system for targeted drug delivery within the human body. The system utilizes biocompatible materials and magnetic guidance to navigate to specific target sites, enabling minimally invasive treatment of diseases such as cancer and cardiovascular disorders. The system demonstrates significantly improved drug efficacy and reduced side effects compared to conventional methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art on micro-robotics\"\n        }\n    ],\n    \"claims\": [\n        \"A micro-robotic system for targeted drug delivery comprising...\",\n        \"A method for navigating a micro-robot...\",\n        \"A biocompatible material for micro-robot construction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65883", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Angiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-07-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents an improved catheter design for angiography procedures. The catheter features a flexible tip and enhanced visualization capabilities. This design aids in clearer imaging of blood vessels and improved diagnostic accuracy. The device reduces procedure time and increases patient comfort.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related prior art on catheter design\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible tip...\",\n        \"A method for visualizing blood vessels...\",\n        \"A catheter with enhanced imaging capabilities...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65884", "text": "{\n    \"patent_title\": \"Miniaturized Robotic Surgical System with Enhanced Dexterity\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-09\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel miniaturized robotic surgical system designed for enhanced dexterity in minimally invasive procedures. The system incorporates advanced sensor feedback and remote control capabilities, enabling precise and controlled movements within confined surgical spaces.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art in robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system comprising a miniaturized robotic arm...\",\n        \"A method for performing minimally invasive surgery using the robotic system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65884", "text": "{\n    \"patent_title\": \"Implantable Cardiac Pacemaker with Wireless Charging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2022-03-15\",\n    \"filing_date\": \"2022-03-14\",\n    \"issue_date\": \"2023-05-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac pacemaker with a wireless charging capability to improve patient convenience and reduce the need for invasive battery replacements.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art related to implantable pacemakers\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable cardiac pacemaker comprising a wireless charging coil...\",\n        \"A method for wirelessly charging the pacemaker...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65885", "text": "{\n    \"patent_title\": \"High-Performance Lithium-Ion Battery with Silicon Nanowire Anode\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"SLAC National Accelerator Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US10549782B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-02-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery comprising a silicon nanowire anode, a lithium metal oxide cathode, and a novel electrolyte formulation exhibiting improved ionic conductivity and stability. This battery demonstrates significantly enhanced energy density and cycle life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"count\": 150\n        },\n        {\n            \"patent_number\": \"US9234567B2\",\n            \"count\": 80\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising: a silicon nanowire anode...\",\n        \"The battery of claim 1, wherein the silicon nanowire anode has a diameter of between 50 nm and 100 nm.\"\n    ]\n}"}
{"_id": "Academic--patents--n--65885", "text": "{\n    \"patent_title\": \"Improved Lead-Acid Battery Design for Automotive Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Brown\",\n            \"affiliation\": \"Exide Technologies\"\n        }\n    ],\n    \"patent_number\": \"US8999876B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lead-acid battery incorporating a novel plate geometry and electrolyte additive to enhance charge acceptance and reduce sulfation. This design improves the performance and lifespan of automotive lead-acid batteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"count\": 25\n        }\n    ],\n    \"claims\": [\n        \"A lead-acid battery comprising: a plurality of positive plates...\",\n        \"The battery of claim 1, wherein the electrolyte additive is a phosphate compound.\"\n    ]\n}"}
{"_id": "Academic--patents--p--65886", "text": "{\n    \"patent_title\": \"Deep Learning Enhanced MRI Reconstruction for Improved Diagnostic Accuracy\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-07-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for MRI image reconstruction utilizing deep convolutional neural networks. The system achieves significantly improved image quality and resolution, leading to enhanced diagnostic accuracy for detecting subtle anomalies in medical imaging. The application of artificial intelligence techniques streamlines image processing and reduces artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"MRI Image Reconstruction using Compressed Sensing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for enhancing MRI image quality using...\",\n        \"A deep learning model trained for...\",\n        \"A computer-readable medium storing instructions for...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65886", "text": "{\n    \"patent_title\": \"Improved X-Ray Tube Design for Enhanced Image Clarity\",\n    \"inventors\": [\n        {\n            \"name\": \"Mr. John Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"Ms. Jane Doe\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2016-11-01\",\n    \"issue_date\": \"2019-05-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention focuses on a redesigned X-ray tube with improved filament geometry and cooling systems. The result is a significant increase in X-ray flux and image clarity, reducing patient exposure and enhancing diagnostic capabilities. The innovation primarily addresses hardware improvements in X-ray imaging technology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"X-Ray Tube with Enhanced Cooling\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube comprising...\",\n        \"A filament geometry optimized for...\",\n        \"A cooling system for maintaining...\",\n        \"A method of manufacturing an X-ray tube...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65887", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-09\",\n    \"issue_date\": \"2023-01-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system incorporating enhanced 3D visualization and robotic assistance to improve surgical precision and reduce patient trauma, leading to faster recovery times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in robotic surgical systems.\"\n        }\n    ],\n    \"claims\": [\n        \"A minimally invasive surgical system comprising a robotic arm...\",\n        \"A method for performing surgery using the surgical system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65887", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-01-14\",\n    \"issue_date\": \"2022-05-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler with a more ergonomic handle design for increased surgeon comfort and control during open surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related to prior art in surgical stapler designs.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an ergonomic handle...\",\n        \"A method for using the surgical stapler...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65888", "text": "{\n    \"patent_title\": \"Method for Enhancing MRI Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for enhancing magnetic resonance imaging (MRI) image resolution using a deep convolutional neural network. The method improves image clarity and allows for more accurate diagnosis of subtle anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI image resolution comprising...\",\n        \"A system for performing MRI image enhancement...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65888", "text": "{\n    \"patent_title\": \"Image Processing Technique for X-ray Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Kenji Tanaka\",\n            \"affiliation\": \"Hitachi, Ltd.\"\n        }\n    ],\n    \"patent_number\": \"JP2018123456A\",\n    \"priority_date\": \"2016-09-20\",\n    \"filing_date\": \"2016-09-20\",\n    \"issue_date\": \"2018-04-10\",\n    \"patent_office\": \"JPO\",\n    \"abstract\": \"An image processing technique for improving the contrast in X-ray images. This method reduces noise and enhances the visibility of details in medical X-rays.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"An image processing method for X-ray images comprising...\",\n        \"A system for processing X-ray images to enhance contrast...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65889", "text": "{\n    \"patent_title\": \"High-Resolution Magnetic Resonance Imaging with Optimized Contrast Agents\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel MRI technique utilizing enhanced contrast agents to achieve significantly improved image resolution, leading to more accurate diagnosis of early-stage tumors.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on contrast agent delivery\"\n        }\n    ],\n    \"claims\": [\n        \"A method for magnetic resonance imaging comprising...\",\n        \"The method of claim 1, wherein the contrast agent...\",\n        \"A system for performing magnetic resonance imaging...\",\n        \"The system of claim 3, further comprising...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65889", "text": "{\n    \"patent_title\": \"Automated X-Ray Image Analysis System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-07-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for analyzing X-ray images to detect fractures and other abnormalities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Early X-ray image processing techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A system for analyzing X-ray images...\",\n        \"The system of claim 1, wherein the image analysis...\",\n        \"A method for detecting fractures...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65890", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Pathogen Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for rapid and sensitive detection of pathogens in biological samples. The device utilizes a novel amplification method to enhance signal detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for detecting a pathogen...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65890", "text": "{\n    \"patent_title\": \"Cardiovascular Stent with Drug Eluting Coating\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"St. Jude Medical\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Boston Scientific\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-01-15\",\n    \"filing_date\": \"2022-01-15\",\n    \"issue_date\": \"2023-11-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A cardiovascular stent with a novel drug-eluting coating for preventing restenosis after angioplasty. The coating releases a controlled amount of anti-proliferative drugs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiovascular stent comprising...\",\n        \"A drug-eluting coating for a stent...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65891", "text": "{\n    \"patent_title\": \"Enhanced Medical Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-09-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method for reconstructing medical images from raw data, utilizing deep learning techniques to significantly improve image clarity and reduce noise. This allows for more accurate diagnosis of diseases and improved patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing medical images comprising...\",\n        \"A system for improving image clarity using deep learning...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65891", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Cardiovascular Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel catheter design that enhances maneuverability and reduces patient discomfort during cardiovascular procedures. The catheter incorporates a flexible tip and improved materials for reduced friction.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art in catheter design\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible tip...\",\n        \"A method for performing cardiovascular procedures using the catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65892", "text": "{\n    \"patent_title\": \"Enhanced Resolution Ultrasound Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel ultrasound imaging system capable of achieving significantly enhanced resolution, leading to improved visualization of internal organs and tissues. The system utilizes advanced signal processing techniques to reduce noise and artifacts, providing clearer images for diagnostic purposes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in ultrasound signal processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating a high-resolution ultrasound image comprising...\",\n        \"An ultrasound imaging system configured to...\",\n        \"A signal processing algorithm for reducing noise in ultrasound data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65892", "text": "{\n    \"patent_title\": \"Method for Early Cancer Detection Using PET Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2016-11-01\",\n    \"issue_date\": \"2018-09-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel method for the early detection of cancer using Positron Emission Tomography (PET) imaging. The method employs a new radiotracer that specifically targets cancer cells, allowing for highly sensitive and accurate detection of tumors at an early stage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art in PET imaging tracers\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancer comprising...\",\n        \"A radiotracer for targeting cancer cells...\",\n        \"A PET imaging system configured for early cancer detection...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65893", "text": "{\n    \"patent_title\": \"Ultrasound-based Shear Wave Elastography for Liver Fibrosis Assessment\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2020-04-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for non-invasively assessing liver fibrosis using ultrasound-based shear wave elastography. The system provides quantitative measurements of liver stiffness, enabling early detection of fibrosis and aiding in disease management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Ultrasound Imaging System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for assessing liver fibrosis...\",\n        \"A system comprising an ultrasound transducer...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65893", "text": "{\n    \"patent_title\": \"Improved Gradient Coil Design for High-Resolution MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"GE Healthcare\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US11123456B2\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2021-05-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved gradient coil design for magnetic resonance imaging (MRI) systems, enabling faster scanning times and higher resolution images. The coil incorporates novel winding patterns to minimize eddy currents and enhance performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"MRI System with Improved Signal-to-Noise Ratio\"\n        }\n    ],\n    \"claims\": [\n        \"A gradient coil for an MRI system...\",\n        \"An MRI system comprising the gradient coil...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65894", "text": "{\n    \"patent_title\": \"Ultrasound Image Enhancement Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2018-03-01\",\n    \"issue_date\": \"2021-05-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing ultrasound images using a deep learning model to improve resolution and clarity for diagnostic purposes. The system utilizes convolutional neural networks trained on a large dataset of ultrasound images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an ultrasound image...\",\n        \"A system comprising a processor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65894", "text": "{\n    \"patent_title\": \"Targeted Drug Delivery System for Cancer Treatment Using MRI Guidance\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2018-02-10\",\n    \"issue_date\": \"2022-01-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A drug delivery system utilizing MRI guidance for precise targeting of cancerous tumors. The system employs nanoparticles that release therapeutic agents directly into the tumor site.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A drug delivery system comprising nanoparticles...\",\n        \"A method for treating cancer...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65895", "text": "{\n    \"patent_title\": \"Magnetic Resonance Imaging Enhancement for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for enhancing magnetic resonance imaging (MRI) contrast, enabling earlier detection of cancerous tumors. The technique utilizes targeted nanoparticles to amplify signal from tumor cells, leading to improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in nanoparticle contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI contrast...\",\n        \"The use of targeted nanoparticles for tumor detection...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65895", "text": "{\n    \"patent_title\": \"Improved X-ray Imaging System with Reduced Radiation Dose\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved X-ray imaging system that minimizes radiation exposure to patients while maintaining image quality. It incorporates advanced filtering techniques and detector technology to achieve a lower dose.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous X-ray imaging improvements\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system with reduced radiation...\",\n        \"A method for filtering X-ray radiation...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65896", "text": "{\n    \"patent_title\": \"Enhanced MRI Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2022-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing MRI images using deep learning techniques, significantly improving image clarity and diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for enhancing MRI image quality...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65896", "text": "{\n    \"patent_title\": \"Automated X-ray Analysis System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-11-20\",\n    \"filing_date\": \"2020-11-20\",\n    \"issue_date\": \"2023-07-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for analyzing X-ray images to detect fractures and anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for automated X-ray analysis comprising...\",\n        \"A method for detecting fractures in X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65897", "text": "{\n    \"patent_title\": \"Method and System for Early Cancer Detection Using Multi-Modal Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2023-11-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for early cancer detection utilizing a combination of MRI and PET imaging techniques. The system incorporates advanced image processing algorithms to identify subtle anomalies indicative of early-stage tumors, improving diagnostic accuracy and patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in MRI image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancer comprising...\",\n        \"A system for analyzing medical images...\",\n        \"A computer-readable medium storing...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65897", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Angiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Boston Scientific\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2022-08-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design for angiography procedures, featuring enhanced maneuverability and reduced patient discomfort. The catheter incorporates a novel tip configuration and biocompatible coating.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Previous catheter designs\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising...\",\n        \"A tip configuration for...\",\n        \"A biocompatible coating...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65898", "text": "{\n    \"patent_title\": \"Comfortable Patient Interface for Respiratory Therapy\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology, Biomedical Engineering Department\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"Boston Medical Devices Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel patient interface for respiratory therapy designed to enhance comfort and reduce skin irritation. The interface utilizes a dynamic pressure distribution system and biocompatible materials.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Improved Nasal Mask Design\"\n        }\n    ],\n    \"claims\": [\n        \"A patient interface comprising a flexible mask...\",\n        \"The mask further comprising a pressure distribution system...\",\n        \"The pressure distribution system is configured to dynamically adjust...\",\n        \"A biocompatible material...\",\n        \"The patient interface is designed for respiratory therapy...\",\n        \"The interface is configured for long-term use...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65898", "text": "{\n    \"patent_title\": \"Surgical Instrument Tracking System\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University, Computer Science Department\"\n        },\n        {\n            \"name\": \"Emily Wilson\",\n            \"affiliation\": \"Tech Solutions Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-08-20\",\n    \"filing_date\": \"2017-08-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for tracking surgical instruments during medical procedures using RFID technology. This enhances efficiency and reduces the risk of lost instruments.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"RFID-Based Asset Management\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument tracking system comprising an RFID tag...\",\n        \"The system further comprising a reader...\",\n        \"The reader is configured to identify...\",\n        \"A database for storing instrument information...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65899", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-06-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical system providing improved visualization and precision for minimally invasive procedures. The system utilizes advanced imaging techniques and robotic assistance to enhance surgical outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\",\n            \"relevance\": \"Prior art related to surgical robotics\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising an imaging module, a robotic arm, and a control interface.\",\n        \"A method for performing a minimally invasive surgical procedure using the system.\"\n    ]\n}"}
{"_id": "Academic--patents--n--65899", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Vascular Access\",\n    \"inventors\": [\n        {\n            \"name\": \"Li Wei\",\n            \"affiliation\": \"Beijing University of Technology\"\n        }\n    ],\n    \"patent_number\": \"CN108765432A\",\n    \"priority_date\": \"2018-12-10\",\n    \"filing_date\": \"2019-03-01\",\n    \"issue_date\": \"2020-08-15\",\n    \"patent_office\": \"SIPO\",\n    \"abstract\": \"A new catheter design featuring improved flow rates and reduced risk of thrombosis during vascular access procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related to previous catheter designs\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a lumen for fluid delivery.\",\n        \"A method for accessing a blood vessel using the catheter.\"\n    ]\n}"}
{"_id": "Academic--patents--p--65900", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Detection of Circulating Tumor Cells\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-15\",\n    \"issue_date\": \"2023-03-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device is disclosed for the rapid and efficient capture and detection of circulating tumor cells (CTCs) from whole blood. The device utilizes a novel surface chemistry and hydrodynamic focusing to enhance CTC capture rates and improve diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"highly relevant\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"relevant\"\n        },\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"relevance\": \"moderate\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for detecting CTCs...\",\n        \"A system for analyzing CTCs...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65900", "text": "{\n    \"patent_title\": \"Improved Syringe Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Generic Medical Supplies Inc.\"\n        }\n    ],\n    \"patent_number\": \"US7654321B1\",\n    \"priority_date\": \"2022-11-18\",\n    \"filing_date\": \"2022-11-22\",\n    \"issue_date\": \"2024-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved syringe design featuring a modified plunger mechanism for smoother fluid delivery. It offers enhanced user comfort and reduced force requirements.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"relevance\": \"slightly relevant\"\n        }\n    ],\n    \"claims\": [\n        \"A syringe comprising...\",\n        \"A plunger mechanism...\",\n        \"A fluid delivery system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65901", "text": "{\n    \"patent_title\": \"Non-Invasive Glucose Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-09-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive glucose monitoring system utilizing optical sensors for real-time glucose level detection. This system improves patient care by providing continuous glucose monitoring without the need for frequent blood samples.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in optical glucose sensing.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for non-invasively monitoring glucose levels...\",\n        \"An optical sensor configured to detect glucose concentration...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65901", "text": "{\n    \"patent_title\": \"Robotic Surgical Instrument with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2022-05-10\",\n    \"filing_date\": \"2022-11-01\",\n    \"issue_date\": \"2024-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A robotic surgical instrument designed for minimally invasive procedures, featuring enhanced precision and dexterity. This allows surgeons to perform complex operations with greater control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art in robotic surgery.\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical instrument comprising...\",\n        \"A control system for manipulating the surgical instrument...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65902", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Cardiac Monitor with Remote Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"MedTech Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized, fully implantable cardiac monitor capable of continuous ECG monitoring and remote data transmission via Bluetooth to a patient's smartphone and a secure cloud platform. Designed for early detection of arrhythmias and improved patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art related to implantable cardiac devices\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable cardiac monitor comprising...\",\n        \"A system for remotely transmitting cardiac data...\",\n        \"A method for detecting arrhythmias using said monitor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65902", "text": "{\n    \"patent_title\": \"Method for Enhancing Signal Processing in Cardiac Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-11-22\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2022-09-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel algorithm for enhancing signal processing in cardiac imaging techniques, leading to improved image clarity and diagnostic accuracy. Focuses on computational improvements to existing imaging modalities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art in image processing algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing cardiac image signal processing comprising...\",\n        \"A system for implementing said method...\",\n        \"A computer-readable medium storing instructions for...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65903", "text": "{\n    \"patent_title\": \"AI-Powered Diagnostic System for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Chen\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Bob Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-08-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an AI-powered diagnostic system utilizing deep learning algorithms to analyze medical images for early cancer detection. The system demonstrates significantly improved accuracy and speed compared to traditional methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on image analysis\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancer using artificial intelligence.\",\n        \"A system comprising a deep learning model for image analysis.\",\n        \"A diagnostic tool for early cancer detection with improved accuracy.\"\n    ]\n}"}
{"_id": "Academic--patents--n--65903", "text": "{\n    \"patent_title\": \"Improved Algorithm for Stock Market Prediction\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-03-15\",\n    \"filing_date\": \"2022-03-15\",\n    \"issue_date\": \"2024-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents an improved algorithm for predicting stock market trends using machine learning. The algorithm offers enhanced accuracy in short-term predictions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Existing stock prediction models\"\n        }\n    ],\n    \"claims\": [\n        \"An algorithm for stock market prediction.\",\n        \"A system for analyzing financial data.\",\n        \"A method for improving prediction accuracy.\"\n    ]\n}"}
{"_id": "Academic--patents--p--65904", "text": "{\n    \"patent_title\": \"Lithium-Sulfur Battery with Graphene-Enhanced Cathode for Extended Cycle Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-08-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-sulfur battery incorporating a graphene-enhanced cathode structure exhibiting improved sulfur utilization and prolonged cycle life. The graphene framework mitigates polysulfide shuttling, leading to enhanced battery performance in portable electronic devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on lithium-sulfur battery cathodes.\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-sulfur battery comprising a cathode with a graphene-sulfur composite structure.\",\n        \"The battery of claim 1, wherein the graphene framework comprises reduced graphene oxide.\",\n        \"A portable electronic device powered by the lithium-sulfur battery of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--65904", "text": "{\n    \"patent_title\": \"Adaptive Power Management System for Smartphones Using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Elena Rodriguez\",\n            \"affiliation\": \"Qualcomm Technologies Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-01-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A power management system for smartphones that utilizes machine learning algorithms to dynamically adjust power consumption based on user behavior and application usage.  The system optimizes battery life by predicting and proactively managing energy demands.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Previous work in dynamic voltage and frequency scaling.\"\n        }\n    ],\n    \"claims\": [\n        \"A power management system for a smartphone, comprising a machine learning module configured to predict application power usage.\",\n        \"The system of claim 1, wherein the machine learning module is trained on historical user data.\",\n        \"A method for optimizing battery life in a smartphone using the system of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--65905", "text": "{\n    \"patent_title\": \"High-Density Solid-State Battery for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Princeton University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"QuantumScape Corporation\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A solid-state battery with a novel electrolyte composition enabling high energy density and improved safety for electric vehicle applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art on solid-state electrolytes.\"\n        }\n    ],\n    \"claims\": [\n        \"A solid-state battery comprising...\",\n        \"An electrolyte composition...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65905", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery Recycling Method\",\n    \"inventors\": [\n        {\n            \"name\": \"Wang Wei\",\n            \"affiliation\": \"Contemporary Amperex Technology Co. Limited (CATL)\"\n        },\n        {\n            \"name\": \"Li Mei\",\n            \"affiliation\": \"CATL\"\n        }\n    ],\n    \"patent_number\": \"CN111122333A\",\n    \"priority_date\": \"2020-06-15\",\n    \"filing_date\": \"2020-06-15\",\n    \"issue_date\": \"2021-02-05\",\n    \"patent_office\": \"SIPO\",\n    \"abstract\": \"A method for efficiently recycling lithium-ion batteries, recovering valuable materials like cobalt and nickel.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10000000B2\",\n            \"relevance\": \"Prior art on battery disassembly processes.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for recycling lithium-ion batteries comprising...\",\n        \"A system for recovering battery materials...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65906", "text": "{\n    \"patent_title\": \"Miniature Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2020-06-23\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A miniaturized implantable biosensor for continuous glucose monitoring. The device utilizes a novel enzymatic reaction and microfluidic channel design for accurate and reliable glucose detection in vivo.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on implantable sensors.\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable biosensor comprising...\",\n        \"A method for continuous glucose monitoring using the biosensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65906", "text": "{\n    \"patent_title\": \"Improved Surgical Stapler with Enhanced Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"Johnson & Johnson\"\n        },\n        {\n            \"name\": \"Emily Wilson\",\n            \"affiliation\": \"Johnson & Johnson\"\n        }\n    ],\n    \"patent_number\": \"EP3845987A1\",\n    \"priority_date\": \"2020-09-01\",\n    \"filing_date\": \"2020-09-01\",\n    \"issue_date\": \"2021-11-10\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"An improved surgical stapler design incorporating ergonomic handles and a self-adjusting anvil for consistent staple placement during surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related art on surgical staplers.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an ergonomic handle...\",\n        \"A method for performing surgical stapling using the device...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65907", "text": "{\n    \"patent_title\": \"High-Resolution Optical Coherence Tomography System for In-Vivo Biomedical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Jian Li\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel optical coherence tomography (OCT) system capable of achieving sub-micron resolution for in-vivo biomedical imaging. The system utilizes a new wavelength tunable laser source and a real-time image processing algorithm for enhanced visualization of tissue microstructure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art OCT system\"\n        }\n    ],\n    \"claims\": [\n        \"A system for generating high-resolution images of biological tissue comprising...\",\n        \"A method for processing OCT signals to enhance image clarity...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65907", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for MRI Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Chen\",\n            \"affiliation\": \"Generic Pharma Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2018-07-01\",\n    \"filing_date\": \"2018-07-01\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved formulation of a gadolinium-based contrast agent for magnetic resonance imaging (MRI). The formulation enhances image contrast and reduces toxicity compared to existing agents.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Previous contrast agent formulation\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent composition comprising gadolinium and a chelating agent...\",\n        \"A method for enhancing MRI image contrast using the composition...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65908", "text": "{\n    \"patent_title\": \"Improved MRI Reconstruction with Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"11234567\",\n    \"priority_date\": \"2018-05-10\",\n    \"filing_date\": \"2018-05-10\",\n    \"issue_date\": \"2021-01-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel deep learning approach for reconstructing high-resolution MRI images from undersampled k-space data, leading to improved diagnostic accuracy and reduced scan times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"8765432\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images using a convolutional neural network.\",\n        \"A system for performing MRI with reduced scan time.\"\n    ]\n}"}
{"_id": "Academic--patents--n--65908", "text": "{\n    \"patent_title\": \"Contrast Agent for CT Scans\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Generic Pharmaceuticals Inc.\"\n        }\n    ],\n    \"patent_number\": \"9876543\",\n    \"priority_date\": \"2014-11-15\",\n    \"filing_date\": \"2014-11-15\",\n    \"issue_date\": \"2017-03-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new contrast agent for use in computed tomography (CT) scans, providing enhanced visualization of blood vessels.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"7654321\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising a novel iodine-based compound.\",\n        \"A method for enhancing CT images using the contrast agent.\"\n    ]\n}"}
{"_id": "Academic--patents--p--65909", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Sepsis Diagnosis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-09-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for rapid and accurate diagnosis of sepsis using a single drop of blood. The device integrates microfluidic channels, antibody-based detection, and optical sensors to provide results within 30 minutes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for diagnosing sepsis...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65909", "text": "{\n    \"patent_title\": \"Improved Design for Industrial Water Filters\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2016-11-01\",\n    \"issue_date\": \"2019-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved water filter design for industrial applications, utilizing a novel membrane material for enhanced filtration efficiency and reduced clogging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A water filter comprising...\",\n        \"A membrane material with a pore size...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65910", "text": "{\n    \"patent_title\": \"High-Resolution Magnetic Resonance Imaging with Adaptive Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel magnetic resonance imaging (MRI) technique utilizing adaptive reconstruction algorithms to achieve significantly improved image resolution, enhancing diagnostic capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating high-resolution MRI images...\",\n        \"An MRI system comprising an adaptive reconstruction module...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65910", "text": "{\n    \"patent_title\": \"Improved X-ray Imaging System with Reduced Radiation Dosage\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2023-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved X-ray imaging system designed to minimize radiation exposure while maintaining diagnostic image quality. Focuses on novel filtering techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous work in X-ray filtering.\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising a radiation filter...\",\n        \"A method for reducing radiation dosage in X-ray imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65911", "text": "{\n    \"patent_title\": \"High-Capacity Lithium-Ion Battery with Enhanced Energy Density\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-05-20\",\n    \"issue_date\": \"2023-11-07\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"This invention discloses a novel lithium-ion battery with a modified electrolyte composition and electrode materials, resulting in significantly enhanced energy density and cycle life. The improved battery is suitable for electric vehicles and portable electronic devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"Prior art in lithium-ion battery technology\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising a cathode material...\",\n        \"An electrolyte composition for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65911", "text": "{\n    \"patent_title\": \"Improved Lead-Acid Battery Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charles Davis\",\n            \"affiliation\": \"Robert Bosch GmbH\"\n        }\n    ],\n    \"patent_number\": \"EP3210987B1\",\n    \"priority_date\": \"2019-12-01\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-08-17\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"This invention provides an improved lead-acid battery with enhanced durability and reduced internal resistance. It focuses on optimizing the grid structure and electrolyte composition for extended battery life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related to lead-acid battery construction\"\n        }\n    ],\n    \"claims\": [\n        \"A lead-acid battery comprising a grid structure...\",\n        \"An electrolyte composition for a lead-acid battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65912", "text": "{\n    \"patent_title\": \"Magnetic Resonance Imaging with Artificial Intelligence Enhancement for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-05-10\",\n    \"filing_date\": \"2018-05-10\",\n    \"issue_date\": \"2022-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel magnetic resonance imaging (MRI) technique incorporating artificial intelligence (AI) algorithms to enhance image resolution and detect subtle indicators of early-stage cancer, improving diagnostic accuracy and patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in MRI image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI images using AI algorithms.\",\n        \"A system for early cancer detection based on enhanced MRI images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--65912", "text": "{\n    \"patent_title\": \"Improved X-Ray Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2016-11-22\",\n    \"filing_date\": \"2016-11-22\",\n    \"issue_date\": \"2020-09-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved X-ray imaging system with reduced radiation exposure and enhanced image clarity. This system provides higher quality images with a lower dose of radiation compared to traditional X-ray systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Existing X-ray technology\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system with reduced radiation exposure.\",\n        \"A method for improving image clarity in X-ray imaging.\"\n    ]\n}"}
{"_id": "Academic--patents--p--65913", "text": "{\n    \"patent_title\": \"Artificial Intelligence-Enhanced MRI for Early-Stage Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Jian Li\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10542876B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2020-01-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for improving the accuracy of cancer detection using magnetic resonance imaging (MRI) and artificial intelligence algorithms. The system utilizes deep learning to identify subtle anomalies in MRI scans, leading to earlier and more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in MRI image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for analyzing MRI data using a deep neural network.\",\n        \"A system for providing a diagnostic assessment based on MRI data.\",\n        \"A computer-readable medium storing instructions for performing the method.\"\n    ]\n}"}
{"_id": "Academic--patents--n--65913", "text": "{\n    \"patent_title\": \"AI-Driven Analysis of Cardiac MRI for Predicting Heart Failure Risk\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Chen\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Maria Rodriguez\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An artificial intelligence system and method for analyzing cardiac magnetic resonance imaging (MRI) data to predict the risk of heart failure in patients. The system utilizes machine learning algorithms to identify patterns in MRI scans indicative of cardiac dysfunction.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior work in cardiac MRI analysis\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predicting heart failure risk based on cardiac MRI data.\",\n        \"A method for identifying cardiac dysfunction using machine learning.\",\n        \"A computer-readable medium storing instructions for the system.\"\n    ]\n}"}
{"_id": "Academic--patents--p--65914", "text": "{\n    \"patent_title\": \"Miniaturized Neural Stimulator with Wireless Power Transfer\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized neural stimulator designed for targeted drug delivery and nerve stimulation. The device utilizes wireless power transfer to eliminate the need for batteries and invasive procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Similar neural stimulation techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized neural stimulator comprising...\",\n        \"A wireless power transfer system for the neural stimulator...\",\n        \"A method for targeted drug delivery using the neural stimulator...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65914", "text": "{\n    \"patent_title\": \"Improved Stent Design for Coronary Artery Disease\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-01-10\",\n    \"filing_date\": \"2022-01-10\",\n    \"issue_date\": \"2024-05-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved stent design featuring a bioresorbable polymer coating to enhance biocompatibility and reduce the risk of restenosis in patients with coronary artery disease.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous stent designs\"\n        }\n    ],\n    \"claims\": [\n        \"A stent comprising a bioresorbable polymer coating...\",\n        \"A method for treating coronary artery disease using the stent...\",\n        \"A composition for the bioresorbable polymer coating...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65915", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Electrolyte for Improved Cycle Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery incorporating a novel electrolyte composition resulting in significantly improved cycle life and energy efficiency. The electrolyte contains a unique additive that enhances ion conductivity and reduces degradation over extended use.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related to lithium-ion battery technology but with a different electrolyte composition.\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrolyte containing a specific additive.\",\n        \"The battery of claim 1, wherein the additive increases ion conductivity.\",\n        \"The battery of claim 1, wherein the battery exhibits an extended cycle life.\"\n    ]\n}"}
{"_id": "Academic--patents--n--65915", "text": "{\n    \"patent_title\": \"Solid Oxide Fuel Cell with Enhanced Durability\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-03-10\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2023-08-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A solid oxide fuel cell (SOFC) with improved durability and performance. The SOFC incorporates a novel ceramic material for the electrolyte and electrode, enhancing its resistance to degradation at high temperatures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related to SOFC technology and materials.\"\n        }\n    ],\n    \"claims\": [\n        \"A solid oxide fuel cell comprising a ceramic electrolyte.\",\n        \"The fuel cell of claim 1, wherein the electrolyte exhibits enhanced durability.\",\n        \"The fuel cell of claim 1, wherein the fuel cell operates at high temperatures.\"\n    ]\n}"}
{"_id": "Academic--patents--p--65916", "text": "{\n    \"patent_title\": \"Deep Learning-Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-09-20\",\n    \"issue_date\": \"2020-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for medical image reconstruction utilizing deep learning techniques. The method improves image quality and reduces noise, potentially enhancing diagnostic accuracy. This has potential clinical applications in early cancer detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising: training a deep neural network...\",\n        \"The method of claim 1, wherein the medical image is a CT scan.\"\n    ]\n}"}
{"_id": "Academic--patents--n--65916", "text": "{\n    \"patent_title\": \"Improved Contrast Agents for MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2016-05-01\",\n    \"filing_date\": \"2016-11-10\",\n    \"issue_date\": \"2019-04-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to novel contrast agents for magnetic resonance imaging (MRI). These agents provide enhanced contrast and improved visibility of tissues, aiding in diagnostic imaging. The method is applicable to various medical imaging scenarios.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent for MRI comprising...\",\n        \"The contrast agent of claim 1, wherein the agent is biocompatible.\"\n    ]\n}"}
{"_id": "Academic--patents--p--65917", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Boston Medical Center\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-05-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system comprising a high-resolution endoscopic camera and robotic surgical arms for precise tissue manipulation. The system provides enhanced visualization and dexterity, leading to improved surgical outcomes and reduced patient recovery times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in endoscopic imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising an endoscope and robotic arms.\",\n        \"A method for performing minimally invasive surgery using said system.\"\n    ]\n}"}
{"_id": "Academic--patents--n--65917", "text": "{\n    \"patent_title\": \"Automated Drug Delivery System for Chronic Disease Management\",\n    \"inventors\": [\n        {\n            \"name\": \"Li Wei\",\n            \"affiliation\": \"Beijing University of Technology\"\n        },\n        {\n            \"name\": \"Zhang Hong\",\n            \"affiliation\": \"Peking Union Medical College Hospital\"\n        }\n    ],\n    \"patent_number\": \"CN123456789A\",\n    \"priority_date\": \"2022-03-10\",\n    \"filing_date\": \"2022-03-10\",\n    \"issue_date\": \"2023-09-05\",\n    \"patent_office\": \"SIPO\",\n    \"abstract\": \"An automated drug delivery system designed for continuous monitoring and precise administration of medication to patients with chronic diseases. The system incorporates a microfluidic pump and remote monitoring capabilities for improved patient compliance and therapeutic efficacy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Prior art in microfluidic drug delivery.\"\n        }\n    ],\n    \"claims\": [\n        \"A drug delivery system comprising a microfluidic pump and monitoring unit.\",\n        \"A method for automatically administering medication using said system.\"\n    ]\n}"}
{"_id": "Academic--patents--p--65918", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Cardiac Monitor with Wireless Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Chen\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-05-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable cardiac monitor for long-term heart rhythm monitoring with wireless data transmission to a physician's office. The device aims to improve early detection of cardiac arrhythmias and enhance patient care.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art relating to implantable cardiac devices.\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable cardiac monitor comprising...\",\n        \"A wireless data transmission system for transmitting cardiac rhythm data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65918", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Johnson & Johnson\"\n        },\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"Johnson & Johnson\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2020-10-01\",\n    \"filing_date\": \"2020-10-01\",\n    \"issue_date\": \"2022-06-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler with enhanced ergonomics for increased surgeon comfort and precision during surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art relating to surgical staplers.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an ergonomic handle...\",\n        \"A stapling mechanism capable of precise tissue approximation...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65919", "text": "{\n    \"patent_title\": \"High-Resolution Microscopic Imaging Using Structured Illumination\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Jian Li\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10876321B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-06-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for high-resolution microscopic imaging utilizing structured illumination techniques to overcome the diffraction limit. This provides enhanced image clarity for biological samples.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8542379B2\",\n            \"title\": \"Optical coherence tomography system and method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution in microscopy using structured illumination.\",\n        \"A microscopic imaging system comprising a light source and an image processing unit.\"\n    ]\n}"}
{"_id": "Academic--patents--n--65919", "text": "{\n    \"patent_title\": \"Method for Automated Image Analysis in Medical Diagnosis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2021-03-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for automated analysis of medical images using deep learning algorithms for disease detection and diagnosis. Focuses on image processing and analysis software.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Machine learning for medical image classification\"\n        }\n    ],\n    \"claims\": [\n        \"A computer-implemented method for automated medical image analysis.\",\n        \"A software system for disease detection based on medical image data.\"\n    ]\n}"}
{"_id": "Academic--patents--p--65920", "text": "{\n    \"patent_title\": \"Magnetic Resonance Imaging with Accelerated Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        },\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel approach to accelerate magnetic resonance image reconstruction, significantly reducing scan times while maintaining image quality. The method utilizes a deep learning algorithm to enhance image resolution and reduce artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8569872B1\"\n        },\n        {\n            \"patent_number\": \"US9234567B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for accelerating MRI reconstruction...\",\n        \"A system comprising a MRI scanner and a processing unit...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65920", "text": "{\n    \"patent_title\": \"Improved X-ray Imaging System with Enhanced Contrast\",\n    \"inventors\": [\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Philips Healthcare\"\n        },\n        {\n            \"name\": \"Emily Brown\",\n            \"affiliation\": \"Siemens Healthineers\"\n        },\n        {\n            \"name\": \"Frank Garcia\",\n            \"affiliation\": \"University of Pennsylvania\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-01-20\",\n    \"filing_date\": \"2017-01-20\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses improvements to X-ray imaging systems, focusing on enhanced contrast and reduced radiation dose. The system incorporates a novel detector array and image processing algorithms to achieve superior image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\"\n        },\n        {\n            \"patent_number\": \"US8901234B1\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising a detector array...\",\n        \"A method for enhancing contrast in X-ray images...\",\n        \"A radiation reduction algorithm for X-ray systems...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65921", "text": "{\n    \"patent_title\": \"Solid-State Electrolyte for Sodium-Ion Batteries with Enhanced Safety and Performance\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel solid-state electrolyte composition for sodium-ion batteries, exhibiting improved ionic conductivity and enhanced safety characteristics. The electrolyte utilizes a ceramic framework designed to mitigate dendrite formation and improve thermal stability, addressing key environmental and safety concerns associated with traditional lithium-ion batteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on solid-state electrolytes\"\n        }\n    ],\n    \"claims\": [\n        \"A solid-state electrolyte composition comprising...\",\n        \"A sodium-ion battery cell comprising said electrolyte composition...\",\n        \"A method for manufacturing a sodium-ion battery cell...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65921", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Cathode Material with Enhanced Energy Density\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Robert Wilson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2022-03-15\",\n    \"filing_date\": \"2022-03-15\",\n    \"issue_date\": \"2024-02-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new cathode material for lithium-ion batteries, utilizing a novel doping strategy to increase energy density and cycle life. The material exhibits improved electrochemical performance compared to existing lithium-ion battery cathode materials.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Previous work on lithium-ion cathode materials\"\n        }\n    ],\n    \"claims\": [\n        \"A cathode material for a lithium-ion battery comprising...\",\n        \"A lithium-ion battery cell comprising said cathode material...\",\n        \"A method for manufacturing a lithium-ion battery cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65922", "text": "{\n    \"patent_title\": \"Remote Diagnostic System Utilizing Acoustic Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A remote diagnostic system leveraging acoustic analysis of bodily sounds for non-invasive patient monitoring. The system transmits data wirelessly to a central hub for analysis and reporting, improving access to healthcare in remote locations.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for remote diagnosis comprising an acoustic sensor...\",\n        \"A method for analyzing acoustic data to identify...\",\n        \"A wireless communication module for transmitting diagnostic data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65922", "text": "{\n    \"patent_title\": \"Wearable Physiological Monitoring Patch\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2022-03-15\",\n    \"filing_date\": \"2022-03-15\",\n    \"issue_date\": \"2024-02-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A flexible, wearable patch for continuous monitoring of vital signs including heart rate, respiration rate, and body temperature. The patch utilizes integrated sensors and a wireless communication module.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\"\n        }\n    ],\n    \"claims\": [\n        \"A wearable patch comprising a flexible substrate...\",\n        \"A sensor array for measuring physiological signals...\",\n        \"A wireless transceiver for transmitting data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65923", "text": "{\n    \"patent_title\": \"Enhanced MRI Contrast Agents for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"Novel MRI contrast agents based on iron oxide nanoparticles are disclosed, improving early detection rates of cancerous tumors. The agents exhibit enhanced biocompatibility and targeted delivery to tumor sites.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on iron oxide nanoparticles.\"\n        }\n    ],\n    \"claims\": [\n        \"A composition comprising iron oxide nanoparticles coated with a targeting ligand.\",\n        \"A method for imaging tumors comprising administering the composition.\"\n    ]\n}"}
{"_id": "Academic--patents--n--65923", "text": "{\n    \"patent_title\": \"MRI-Guided Drug Delivery System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2023-05-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An MRI-guided system for precisely delivering therapeutic drugs to targeted tissues. The system utilizes magnetic nanoparticles to carry drugs and steer them to the desired location.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related prior art on magnetic drug delivery.\"\n        }\n    ],\n    \"claims\": [\n        \"A system for delivering drugs comprising magnetic nanoparticles and an MRI scanner.\",\n        \"A method for treating diseases using the system.\"\n    ]\n}"}
{"_id": "Academic--patents--p--65924", "text": "{\n    \"patent_title\": \"Remote Physiological Monitoring System and Method\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-09\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for remotely monitoring a patient's physiological parameters, including heart rate, blood pressure, and oxygen saturation, using wearable sensors and a cloud-based data analysis platform.  The system provides alerts to healthcare providers when critical thresholds are exceeded.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A system for remote physiological monitoring comprising a wearable sensor...\",\n        \"A method for analyzing physiological data remotely...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65924", "text": "{\n    \"patent_title\": \"Surgical Instrument with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Johnson & Johnson\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Johnson & Johnson\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2022-03-15\",\n    \"filing_date\": \"2022-03-14\",\n    \"issue_date\": \"2023-05-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical instrument with enhanced precision and control for minimally invasive procedures.  The instrument incorporates advanced feedback mechanisms to provide surgeons with real-time guidance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising a handle, a shaft, and a cutting tip...\",\n        \"A method for performing a surgical procedure using the instrument...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65925", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable glucose sensor for continuous glucose monitoring with wireless data transmission to a mobile device. The sensor utilizes a novel enzyme-based electrochemical detection method and a biocompatible coating for long-term implantation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art on glucose sensing technology\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable glucose sensor comprising...\",\n        \"A wireless communication module for transmitting glucose data...\",\n        \"A biocompatible coating for long-term implantation...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65925", "text": "{\n    \"patent_title\": \"Method for Enhanced MRI Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Charles Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Rodriguez\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2022-01-10\",\n    \"filing_date\": \"2022-01-10\",\n    \"issue_date\": \"2023-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing high-resolution images from MRI data using advanced signal processing techniques. This method improves image clarity and reduces scan time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Prior art related to MRI image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A signal processing algorithm for improving image resolution...\",\n        \"A system for reducing MRI scan time...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65926", "text": "{\n    \"patent_title\": \"Lithium-ion Battery with Enhanced Electrolyte for Extended Cycle Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-06-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery utilizing a novel electrolyte composition to significantly improve cycle life and reduce degradation, resulting in extended battery performance in portable electronic devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition including...\",\n        \"A method for improving the cycle life of a lithium-ion battery...\",\n        \"The battery of claim 1, wherein...\",\n        \"The electrolyte composition of claim 2, further comprising...\",\n        \"A portable electronic device incorporating the battery of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--65926", "text": "{\n    \"patent_title\": \"Method for Cooling Computer Processors\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Intel Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2022-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A thermal management system for cooling computer processors using a liquid cooling solution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A cooling system for a computer processor comprising...\",\n        \"A liquid cooling loop...\",\n        \"A method for maintaining processor temperature...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65927", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Bio-Sensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-09-20\",\n    \"issue_date\": \"2023-05-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized, implantable biosensor for continuous glucose monitoring, utilizing novel nanomaterial technology for improved accuracy and biocompatibility. The device provides real-time glucose data transmission via Bluetooth to a user's smartphone.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on glucose sensing technology.\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable biosensor comprising...\",\n        \"A method for continuous glucose monitoring using the biosensor...\",\n        \"A system for wirelessly transmitting glucose data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65927", "text": "{\n    \"patent_title\": \"Improved Surgical Stapler Design\",\n    \"inventors\": [\n        {\n            \"name\": \"John Davis\",\n            \"affiliation\": \"Acme Medical Devices Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-01-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler design featuring a more ergonomic handle and enhanced staple cartridge loading mechanism. The stapler is intended for use in general surgery procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art related to surgical staplers.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an ergonomic handle...\",\n        \"A staple cartridge loading mechanism for the stapler...\",\n        \"A method of using the stapler in a surgical procedure...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65928", "text": "{\n    \"patent_title\": \"Novel Convolutional Neural Network Architecture for Object Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel convolutional neural network (CNN) architecture is presented for improved object detection in images. The architecture utilizes a new attention mechanism and a dynamic filter size to achieve state-of-the-art results. The system employs deep learning techniques to achieve higher accuracy and faster processing times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Prior Art CNN Architecture\"\n        }\n    ],\n    \"claims\": [\n        \"A method for object detection using a convolutional neural network.\",\n        \"A system comprising a CNN with an attention mechanism.\"\n    ]\n}"}
{"_id": "Academic--patents--n--65928", "text": "{\n    \"patent_title\": \"Automated Diagnosis of Lung Cancer using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for automated diagnosis of lung cancer from medical images using deep learning techniques. The system utilizes a convolutional neural network trained on a large dataset of X-ray and CT scan images. The method provides early and accurate cancer detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Medical Image Analysis System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for diagnosing lung cancer using a deep learning model.\",\n        \"A system comprising a deep neural network trained on medical images.\"\n    ]\n}"}
{"_id": "Academic--patents--p--65929", "text": "{\n    \"patent_title\": \"AI-Powered Early Detection of Lung Nodules in CT Scans\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-11-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel system and method for the early detection of lung nodules in computed tomography (CT) scans using deep learning algorithms. The system is designed to reduce false positives and improve diagnostic accuracy, addressing a critical unmet need in lung cancer screening.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in image segmentation\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting lung nodules in CT scans comprising...\",\n        \"A system for analyzing CT scan images...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65929", "text": "{\n    \"patent_title\": \"Improved MRI Coil Design for Enhanced Image Resolution\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-07-01\",\n    \"filing_date\": \"2018-07-01\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved magnetic resonance imaging (MRI) coil design that enhances image resolution and signal-to-noise ratio. The new coil configuration reduces artifacts and allows for faster scan times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous coil designs\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil comprising a novel winding pattern...\",\n        \"A method for manufacturing an MRI coil...\",\n        \"An MRI system incorporating the improved coil...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65930", "text": "{\n    \"patent_title\": \"High-Resolution Magnetic Resonance Imaging with Artificial Intelligence Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel approach to magnetic resonance imaging (MRI) utilizing deep learning algorithms to enhance image resolution beyond current limitations. The system incorporates a generative adversarial network (GAN) to reconstruct images with significantly improved detail, leading to earlier and more accurate disease detection.  Initial trials demonstrate a 30% increase in resolution compared to state-of-the-art MRI techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in MRI reconstruction\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related work on deep learning in medical imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing the resolution of MRI images using a generative adversarial network.\",\n        \"An MRI system comprising a scanner and a processing unit configured to implement the method.\",\n        \"The method wherein the improvement in resolution is at least 20%.\"\n    ]\n}"}
{"_id": "Academic--patents--n--65930", "text": "{\n    \"patent_title\": \"Improved X-ray Imaging System with Reduced Radiation Dose\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Klaus Schmidt\",\n            \"affiliation\": \"Siemens Healthcare\"\n        }\n    ],\n    \"patent_number\": \"DE102018000123A1\",\n    \"priority_date\": \"2018-01-10\",\n    \"filing_date\": \"2018-01-10\",\n    \"issue_date\": \"2020-11-05\",\n    \"patent_office\": \"DPMA\",\n    \"abstract\": \"This invention relates to an improved X-ray imaging system that minimizes radiation exposure to patients while maintaining image quality. The system employs advanced filtering techniques and optimized scanning parameters to achieve a lower radiation dose without compromising diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in X-ray image processing\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system with a radiation dose reduction of at least 15%.\",\n        \"A method for controlling the X-ray beam to minimize exposure.\",\n        \"The system comprising a radiation shield.\"\n    ]\n}"}
{"_id": "Academic--patents--p--65931", "text": "{\n    \"patent_title\": \"Deep Learning for Enhanced Image Resolution and Detail\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This patent describes a novel deep learning architecture for enhancing the resolution and detail of images, resulting in significantly improved visual quality. The method is applicable to a wide range of image types and has potential applications in various fields.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11111111B2\",\n            \"relevance\": \"Prior art in image super-resolution.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising...\",\n        \"A deep learning model configured to...\",\n        \"A system for processing images...\",\n        \"The method of claim 1, wherein...\",\n        \"The system of claim 3, further comprising...\",\n        \"An image enhancement apparatus...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65931", "text": "{\n    \"patent_title\": \"Medical Image Analysis using Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Mayo Clinic\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"IBM Watson Health\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2022-01-15\",\n    \"filing_date\": \"2022-01-15\",\n    \"issue_date\": \"2023-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system and method for analyzing medical images, such as X-rays and MRIs, using convolutional neural networks to detect anomalies and assist in diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"relevance\": \"Related to medical image segmentation.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for analyzing medical images...\",\n        \"A system for detecting anomalies...\",\n        \"The method of claim 1, wherein the medical image is an MRI...\",\n        \"The system of claim 2, further comprising a user interface...\",\n        \"A computer-readable medium containing code...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65932", "text": "{\n    \"patent_title\": \"Miniaturized Optical Coherence Tomography System for Retinal Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-08-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized optical coherence tomography (OCT) system for high-resolution retinal imaging. The system utilizes a swept-source laser and a micro-electro-mechanical system (MEMS) scanner to achieve compact size and high imaging speed. This allows for early detection of retinal diseases like macular degeneration and glaucoma.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"High-Speed OCT Imaging System\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized optical coherence tomography (OCT) system comprising...\",\n        \"A MEMS scanner for achieving high imaging speed...\",\n        \"A method for detecting retinal diseases using the OCT system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65932", "text": "{\n    \"patent_title\": \"Implantable Cardiac Pacemaker with Remote Monitoring Capabilities\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, San Francisco\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-01-15\",\n    \"filing_date\": \"2022-01-15\",\n    \"issue_date\": \"2024-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac pacemaker with remote monitoring capabilities. The pacemaker utilizes wireless communication to transmit data to a remote monitoring station, allowing for real-time monitoring of cardiac function and early detection of arrhythmias.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Wireless Cardiac Monitoring System\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable cardiac pacemaker comprising...\",\n        \"A wireless communication module for transmitting data...\",\n        \"A method for remote monitoring of cardiac function...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65933", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Endoscope System for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2022-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized wireless endoscope system utilizing advanced imaging and sensor technologies for early detection of cancerous tissues. The system allows for minimally invasive diagnostics and improved patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in wireless endoscopy\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless endoscope comprising...\",\n        \"A method for detecting cancerous tissues using the wireless endoscope...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65933", "text": "{\n    \"patent_title\": \"Implantable Cardiac Pacemaker with Adaptive Stimulation\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-01-15\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2023-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac pacemaker with adaptive stimulation capabilities, designed to optimize heart function and improve patient quality of life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art in implantable pacemakers\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable cardiac pacemaker comprising...\",\n        \"A method for adaptively stimulating the heart using the pacemaker...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65934", "text": "{\n    \"patent_title\": \"Miniature Implantable Device for Targeted Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11254321B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-11-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A micro-implantable device for controlled release of therapeutic agents directly to targeted tissues, minimizing systemic side effects. The device incorporates a biocompatible polymer matrix and a microfluidic system.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art on microfluidic drug delivery systems\"\n        }\n    ],\n    \"claims\": [\n        \"A micro-implantable device comprising a biocompatible polymer matrix.\",\n        \"The device of claim 1, further comprising a microfluidic system.\",\n        \"The device of claim 2, wherein the microfluidic system is configured for controlled release of a therapeutic agent.\",\n        \"A method of treating a disease comprising implanting the device of claim 3 into a patient.\",\n        \"The method of claim 4, wherein the therapeutic agent is an anti-cancer drug.\",\n        \"The device of claim 1, where the polymer matrix is biodegradable.\",\n        \"The microfluidic system of claim 2 is powered by external magnetic fields.\",\n        \"The device is less than 5mm in size.\",\n        \"The device is coated with a cell-adhesive peptide.\",\n        \"The device includes a biosensor for real-time monitoring.\",\n        \"The device's drug release is triggered by pH changes.\",\n        \"The device is designed for minimally invasive insertion.\"\n    ]\n}"}
{"_id": "Academic--patents--n--65934", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Acme Surgical Instruments Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-11-15\",\n    \"filing_date\": \"2020-11-15\",\n    \"issue_date\": \"2022-07-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler with a more ergonomic handle and enhanced firing mechanism for increased precision and reduced surgeon fatigue.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art on surgical stapler designs\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising a handle and a firing mechanism.\",\n        \"The stapler of claim 1, wherein the handle is ergonomically designed.\",\n        \"The stapler of claim 2, wherein the firing mechanism is configured for precise staple placement.\",\n        \"The stapler of claim 1 including a safety lock.\"\n    ]\n}"}
{"_id": "Academic--patents--p--65935", "text": "{\n    \"patent_title\": \"Remote Patient Monitoring System with Wireless Sensor Integration\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for continuous remote patient monitoring using a network of wireless sensors. The system transmits physiological data to a central processing unit for analysis and alerts medical personnel to critical changes in patient condition. This enables proactive intervention and reduces hospital readmissions, particularly for patients with chronic conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10234567B1\",\n            \"relevance\": \"Prior art on wireless sensor networks.\"\n        }\n    ],\n    \"claims\": [\n        \"A remote patient monitoring system comprising...\",\n        \"A method for analyzing physiological data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65935", "text": "{\n    \"patent_title\": \"Improved Surgical Stapler Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Johnson & Johnson\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel design for a surgical stapler that improves precision and reduces tissue damage during surgical procedures. The stapler features an ergonomic handle and a self-adjusting anvil. This invention helps surgeons improve the outcome of complex operations.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"relevance\": \"Existing surgical stapler technology.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"An anvil assembly for a surgical stapler...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65936", "text": "{\n    \"patent_title\": \"Implantable Cardiac Rhythm Management System with Enhanced Lead Stabilization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Boston Scientific\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-10-26\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2021-05-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac rhythm management system with a novel lead stabilization mechanism, improving long-term device performance and reducing the risk of dislodgement. The system includes advanced sensing capabilities for accurate arrhythmia detection and tailored therapy delivery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on cardiac pacing\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiac rhythm management system comprising...\",\n        \"A lead stabilization mechanism for implantable devices...\",\n        \"A method for detecting and treating arrhythmias...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65936", "text": "{\n    \"patent_title\": \"Drug-Eluting Stent with Biodegradable Polymer Coating\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Medtronic\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-01-10\",\n    \"filing_date\": \"2019-07-01\",\n    \"issue_date\": \"2020-11-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A drug-eluting stent comprising a metallic scaffold coated with a biodegradable polymer matrix containing a therapeutic agent for preventing restenosis following percutaneous coronary intervention.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous stent designs\"\n        }\n    ],\n    \"claims\": [\n        \"A drug-eluting stent comprising...\",\n        \"A biodegradable polymer coating...\",\n        \"A method for treating coronary artery disease...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65937", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Reconstruction for Accelerated MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2023-11-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing magnetic resonance images using deep convolutional neural networks, enabling significantly faster scan times without compromising image quality. This represents a major advance in MRI technology, potentially increasing patient throughput and reducing healthcare costs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on compressed sensing MRI\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"A system for performing MRI comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65937", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for X-Ray Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2016-05-20\",\n    \"filing_date\": \"2016-05-20\",\n    \"issue_date\": \"2022-04-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved formulation of an iodinated contrast agent for use in X-ray computed tomography, offering slightly enhanced image clarity compared to existing agents. This is achieved through a minor modification of the chemical structure and increased solubility.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art on iodinated contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent composition comprising...\",\n        \"A method of using the contrast agent in X-ray imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65938", "text": "{\n    \"patent_title\": \"Lithium-ion Battery with Enhanced Electrolyte and Improved Cycling Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"MIT Lincoln Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2021-12-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery incorporating a novel electrolyte composition and a modified electrode structure exhibiting improved cycling stability and enhanced energy density. The electrolyte additive enhances ion conductivity and reduces dendrite formation, leading to a longer battery lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on electrolyte additives\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising: ... an electrolyte comprising a specific additive to improve energy density.\",\n        \"The lithium-ion battery of claim 1, wherein the electrolyte additive reduces dendrite formation.\",\n        \"The lithium-ion battery of claim 1, exhibiting a cycling stability of at least 80% after 500 cycles.\"\n    ]\n}"}
{"_id": "Academic--patents--n--65938", "text": "{\n    \"patent_title\": \"Theoretical Model for Novel Solid-State Electrolytes\",\n    \"inventors\": [\n        {\n            \"name\": \"Charles Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emily Wilson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2020-03-10\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-07-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A theoretical model describing the ionic conductivity of a novel solid-state electrolyte material. The model predicts enhanced performance but has not been experimentally validated.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Fundamental theory of solid-state electrolytes\"\n        }\n    ],\n    \"claims\": [\n        \"A theoretical model for predicting the ionic conductivity of a solid-state electrolyte.\",\n        \"The model of claim 1, based on density functional theory.\",\n        \"The model of claim 1, predicting an ionic conductivity greater than 1e-3 S/cm.\"\n    ]\n}"}
{"_id": "Academic--patents--p--65939", "text": "{\n    \"patent_title\": \"MRI Comfort System Utilizing Dynamic Patient Positioning and Real-time Feedback\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for improving patient comfort during MRI scans. The system utilizes a dynamic patient positioning system combined with real-time feedback based on physiological signals to optimize comfort and minimize anxiety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"citation_type\": \"cited_by\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"citation_type\": \"cited_by\"\n        },\n        {\n            \"patent_number\": \"US11223344B1\",\n            \"citation_type\": \"cited_by\"\n        },\n        {\n            \"patent_number\": \"US11334455B2\",\n            \"citation_type\": \"cited_by\"\n        },\n        {\n            \"patent_number\": \"US11445566B1\",\n            \"citation_type\": \"cited_by\"\n        }\n    ],\n    \"claims\": [\n        \"A method for improving patient comfort during MRI scanning comprising...\",\n        \"An MRI system comprising a dynamic positioning mechanism...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65939", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for X-Ray Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Clara Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2017-08-22\",\n    \"filing_date\": \"2017-08-22\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel contrast agent for enhancing image quality in X-ray imaging, providing improved visualization of internal structures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"citation_type\": \"cited_by\"\n        },\n        {\n            \"patent_number\": \"US9654321B2\",\n            \"citation_type\": \"cited_by\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"A method of using the contrast agent for X-ray imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65940", "text": "{\n    \"patent_title\": \"Implantable Bioelectronic Device for Targeted Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2012-05-15\",\n    \"filing_date\": \"2012-05-15\",\n    \"issue_date\": \"2015-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable device for controlled release of therapeutic agents directly to affected tissues, improving treatment efficacy and reducing systemic side effects.  Addresses the unmet need for localized and sustained drug delivery in chronic diseases.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art on implantable materials\"\n        }\n    ],\n    \"claims\": [\n        \"A method for targeted drug delivery using an implantable bioelectronic device.\",\n        \"An implantable device comprising a drug reservoir and a microchip for controlled release.\"\n    ]\n}"}
{"_id": "Academic--patents--n--65940", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging Coil Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Emily Wilson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2011-11-20\",\n    \"filing_date\": \"2011-11-20\",\n    \"issue_date\": \"2014-08-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel design for a magnetic resonance imaging (MRI) coil, providing enhanced signal-to-noise ratio and improved image resolution. This invention improves the clarity of medical imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8210123B2\",\n            \"relevance\": \"Previous MRI coil designs\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil with a modified winding pattern.\",\n        \"A method for manufacturing an MRI coil with improved performance.\"\n    ]\n}"}
{"_id": "Academic--patents--p--65941", "text": "{\n    \"patent_title\": \"High-Resolution Magnetic Resonance Imaging with Compressed Sensing\",\n    \"inventors\": [\n        {\n            \"name\": \"David A. Feinberg\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John M. Pauly\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for high-resolution magnetic resonance imaging (MRI) utilizing compressed sensing techniques to reduce scan time and improve image quality. The method includes novel pulse sequence designs and image reconstruction algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8542231B2\",\n            \"relevance\": \"Prior art in compressed sensing MRI\"\n        },\n        {\n            \"patent_number\": \"US9235347B2\",\n            \"relevance\": \"Related work on parallel imaging\"\n        },\n        {\n            \"patent_number\": \"US10451562B2\",\n            \"relevance\": \"Further advancements in image reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI comprising...\",\n        \"An MRI system configured to...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65941", "text": "{\n    \"patent_title\": \"Improved X-ray Detector for Mammography\",\n    \"inventors\": [\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"Robert Jones\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2021-11-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved X-ray detector for mammography featuring enhanced signal-to-noise ratio and reduced radiation dose. The detector utilizes a novel scintillator material and readout electronics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"relevance\": \"Existing mammography detector technology\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray detector comprising...\",\n        \"A mammography system including...\",\n        \"A method for detecting breast cancer...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65942", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Capsule Endoscope for Targeted Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"MIT Lincoln Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-05-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized wireless capsule endoscope capable of targeted drug delivery within the gastrointestinal tract. The device incorporates micro-robotics and precise navigation capabilities for localized treatment.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Wireless Capsule Endoscopy System\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless capsule endoscope comprising a micro-robotic delivery system.\",\n        \"A method for targeted drug delivery using a wirelessly controlled capsule endoscope.\"\n    ]\n}"}
{"_id": "Academic--patents--n--65942", "text": "{\n    \"patent_title\": \"Improved Cardiovascular Stent with Drug-Eluting Coating\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emily Chen\",\n            \"affiliation\": \"Stanford Hospital\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2022-06-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel cardiovascular stent design incorporating a biocompatible drug-eluting coating to reduce restenosis following angioplasty.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Drug-Eluting Stent Design\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiovascular stent with a drug-eluting coating.\",\n        \"A method for preventing restenosis using the described stent.\"\n    ]\n}"}
{"_id": "Academic--patents--p--65943", "text": "{\n    \"patent_title\": \"Improved MRI Image Reconstruction Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method for reconstructing Magnetic Resonance Images (MRI) with improved clarity and reduced noise, leading to enhanced diagnostic accuracy. The technique utilizes a wavelet-based compression algorithm to reduce artifacts and improve image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"The method of claim 1, wherein the wavelet transform is a Daubechies wavelet.\",\n        \"The method of claim 1, further comprising a noise reduction step.\"\n    ]\n}"}
{"_id": "Academic--patents--n--65943", "text": "{\n    \"patent_title\": \"Complex Multi-Modal Diagnostic System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A comprehensive diagnostic system integrating multiple imaging modalities including PET, CT, and MRI with advanced AI-driven analysis and reporting. This system provides a holistic patient assessment for various complex disease states.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        },\n        {\n            \"patent_number\": \"US8123456B1\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A diagnostic system comprising a PET scanner, a CT scanner, an MRI scanner, and a central processing unit.\",\n        \"The system of claim 1, wherein the central processing unit is configured to run a deep learning algorithm.\",\n        \"The system of claim 1, further comprising a data storage module.\",\n        \"The system of claim 2, wherein the deep learning algorithm is trained on a dataset of patient images.\",\n        \"The system of claim 2, wherein the deep learning algorithm performs image segmentation.\",\n        \"The system of claim 2, wherein the deep learning algorithm performs disease classification.\",\n        \"The system of claim 2, wherein the deep learning algorithm provides a risk assessment.\"\n    ]\n}"}
{"_id": "Academic--patents--p--65944", "text": "{\n    \"patent_title\": \"Miniature Wireless Endoscope for Enhanced Diagnostics\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized wireless endoscope capable of providing high-resolution imaging for minimally invasive diagnostic procedures. The device utilizes advanced optics and low-power communication protocols for real-time data transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in endoscopic imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless endoscope comprising a miniature imaging sensor.\",\n        \"A system for real-time transmission of endoscopic images.\",\n        \"A method for performing minimally invasive diagnostic procedures using the wireless endoscope.\"\n    ]\n}"}
{"_id": "Academic--patents--n--65944", "text": "{\n    \"patent_title\": \"Improved Pacemaker Lead with Enhanced Biocompatibility\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Boston Scientific\"\n        },\n        {\n            \"name\": \"Emily Chen\",\n            \"affiliation\": \"University of Minnesota\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2020-11-15\",\n    \"filing_date\": \"2020-11-15\",\n    \"issue_date\": \"2024-02-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved pacemaker lead design incorporating a novel biocompatible coating to reduce tissue inflammation and enhance long-term device performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Previous pacemaker lead designs\"\n        }\n    ],\n    \"claims\": [\n        \"A pacemaker lead comprising a biocompatible coating.\",\n        \"A method for reducing tissue inflammation around a pacemaker lead.\",\n        \"A pacemaker system incorporating the improved lead design.\"\n    ]\n}"}
{"_id": "Academic--patents--p--65945", "text": "{\n    \"patent_title\": \"Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable biosensor for continuous glucose monitoring, utilizing a novel enzymatic reaction and wireless communication protocol. The device provides real-time glucose readings to a mobile application.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in glucose sensing technology\"\n        }\n    ],\n    \"claims\": [\n        \"A biosensor comprising...\",\n        \"A method for continuous glucose monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65945", "text": "{\n    \"patent_title\": \"Improved Scalpel Handle with Ergonomic Grip\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Medical Devices\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2022-01-10\",\n    \"filing_date\": \"2022-01-10\",\n    \"issue_date\": \"2024-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved scalpel handle designed for enhanced grip and reduced hand fatigue during surgical procedures. The handle features a textured surface and optimized weight distribution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Previous scalpel handle designs\"\n        }\n    ],\n    \"claims\": [\n        \"A scalpel handle comprising...\",\n        \"A method of using the scalpel handle...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65946", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging Technique for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel MRI technique using contrast agents to enhance the detection of early-stage cancerous tumors. The method has demonstrated improved accuracy in pre-clinical studies and is ready for clinical translation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on contrast agents for MRI.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancerous tumors using MRI...\",\n        \"A contrast agent composition for enhancing MRI signal...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65946", "text": "{\n    \"patent_title\": \"Theoretical Framework for Advanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alan Turing\",\n            \"affiliation\": \"University of Cambridge\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-09-20\",\n    \"filing_date\": \"2017-09-20\",\n    \"issue_date\": \"2020-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This patent describes a novel mathematical framework for reconstructing images from limited data in medical imaging. The invention is purely theoretical and does not include a practical implementation or demonstration of clinical utility.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related work on image reconstruction algorithms.\"\n        }\n    ],\n    \"claims\": [\n        \"A mathematical framework for image reconstruction...\",\n        \"An algorithm for optimizing image quality...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65947", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Chen\",\n            \"affiliation\": \"Boston Medical Center\"\n        }\n    ],\n    \"patent_number\": \"US11245678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel minimally invasive surgical system incorporating advanced imaging techniques and robotic assistance to improve surgical precision and patient outcomes. The system provides real-time feedback to the surgeon, reducing the risk of complications and shortening recovery times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Robotic Surgical System\"\n        }\n    ],\n    \"claims\": [\n        \"A minimally invasive surgical system comprising a robotic arm, a high-resolution imaging device, and a control console.\",\n        \"A method for performing a surgical procedure using the surgical system, wherein the procedure is performed through small incisions.\"\n    ]\n}"}
{"_id": "Academic--patents--n--65947", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Miller\",\n            \"affiliation\": \"Acme Surgical Instruments Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2020-11-15\",\n    \"filing_date\": \"2020-11-15\",\n    \"issue_date\": \"2022-05-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler featuring an ergonomic handle design and enhanced staple delivery mechanism. The stapler is designed to reduce surgeon fatigue and improve surgical efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Surgical Stapling Device\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an ergonomic handle, a staple cartridge, and a firing mechanism.\",\n        \"A method for stapling tissue using the surgical stapler.\"\n    ]\n}"}
{"_id": "Academic--patents--p--65948", "text": "{\n    \"patent_title\": \"Deep Learning System for Early Detection of Diabetic Retinopathy\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI Healthcare\"\n        },\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"National Eye Institute\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-12-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep learning system for automated detection of diabetic retinopathy from retinal fundus images. The system utilizes a convolutional neural network trained on a large dataset of labeled images to identify early signs of the disease with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image processing for medical applications\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related work on convolutional neural networks\"\n        },\n        {\n            \"patent_number\": \"US11345678B2\",\n            \"relevance\": \"Previous attempts at automated diabetic retinopathy detection\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting diabetic retinopathy...\",\n        \"A system comprising a convolutional neural network...\",\n        \"A computer-readable medium storing a program...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65948", "text": "{\n    \"patent_title\": \"Improved Image Enhancement Technique for Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"Eve Brown\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-01-10\",\n    \"filing_date\": \"2018-01-10\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel image enhancement algorithm for improving the visibility of features in medical images. It's a refinement of existing techniques and provides slight improvements in image clarity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Basic image enhancement techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image contrast...\",\n        \"A system for applying the image enhancement algorithm...\",\n        \"A device implementing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65949", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Cardiac Monitor with Wireless Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable cardiac monitor capable of continuous ECG monitoring and wireless data transmission to a remote patient monitoring system. The device utilizes low-power circuitry and a biocompatible housing for long-term implantation, improving the detection of cardiac arrhythmias and enhancing patient care.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in implantable cardiac devices.\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable cardiac monitor...\",\n        \"A system for wireless transmission of ECG data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65949", "text": "{\n    \"patent_title\": \"Improved Scalpel Handle Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Medical Device Corp.\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Medical Device Corp.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-01-25\",\n    \"filing_date\": \"2021-03-10\",\n    \"issue_date\": \"2023-04-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved scalpel handle design incorporating ergonomic features for enhanced grip and reduced hand fatigue during surgical procedures. The handle utilizes a textured surface and optimized weight distribution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous scalpel handle designs.\"\n        }\n    ],\n    \"claims\": [\n        \"A scalpel handle with an ergonomic grip...\",\n        \"A scalpel handle with a textured surface...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65950", "text": "{\n    \"patent_title\": \"Enhanced MRI Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-10-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel deep learning approach for reconstructing high-resolution MRI images from undersampled data. The method utilizes a convolutional neural network trained on a large dataset of MRI scans to significantly improve image quality and reduce scan time, leading to enhanced diagnostic accuracy. The technique is applicable to various MRI modalities and body regions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"MRI Reconstruction with Compressed Sensing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65950", "text": "{\n    \"patent_title\": \"Improved X-Ray Image Enhancement Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-01-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new method for enhancing the contrast and clarity of X-ray images. The technique involves applying a spatial filtering algorithm to reduce noise and improve the visibility of subtle anatomical features. It is designed to improve the efficiency of radiographic diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Digital Radiography System\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray image enhancement method comprising...\",\n        \"A system for enhancing X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65951", "text": "{\n    \"patent_title\": \"Portable Diagnostic Device for Early Detection of Cardiac Biomarkers\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a portable diagnostic device for the rapid and accurate detection of cardiac biomarkers in whole blood. The device utilizes a microfluidic chip and electrochemical sensors to provide results within minutes, enabling early detection of heart conditions and improving patient outcomes. The device is designed for point-of-care use and requires minimal training. It offers significant advantages over existing laboratory-based diagnostic methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art related to microfluidic devices.\"\n        }\n    ],\n    \"claims\": [\n        \"A portable diagnostic device comprising a microfluidic chip and electrochemical sensors.\",\n        \"A method for detecting cardiac biomarkers using the portable diagnostic device.\",\n        \"The device as claimed in claim 1, wherein the detection time is less than 10 minutes.\"\n    ]\n}"}
{"_id": "Academic--patents--n--65951", "text": "{\n    \"patent_title\": \"Improved Syringe Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2022-11-15\",\n    \"filing_date\": \"2022-11-15\",\n    \"issue_date\": \"2024-02-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A syringe with a modified plunger for smoother injection.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A syringe comprising a plunger with a specific geometry.\",\n        \"The syringe as claimed in claim 1, wherein the plunger is made of polypropylene.\"\n    ]\n}"}
{"_id": "Academic--patents--p--65952", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction Algorithm for Enhanced MRI Diagnostic Accuracy\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2023-11-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image reconstruction algorithm for Magnetic Resonance Imaging (MRI) that significantly improves diagnostic accuracy by reducing noise and enhancing contrast. The algorithm utilizes deep learning techniques and is particularly effective in identifying small lesions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in MRI image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"An MRI system configured to implement the method...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65952", "text": "{\n    \"patent_title\": \"Advanced CT Scanning System with Reduced Radiation Dose\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Siemens Healthineers\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2022-09-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new CT scanning system that minimizes radiation exposure to patients while maintaining high image quality. The system incorporates advanced filtering techniques and iterative reconstruction algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous work on radiation reduction in CT\"\n        }\n    ],\n    \"claims\": [\n        \"A CT scanning system comprising...\",\n        \"A method for reducing radiation dose in CT...\",\n        \"A control system for adjusting radiation parameters...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65953", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Sepsis Biomarker Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for the rapid and accurate detection of sepsis biomarkers in whole blood. The device integrates sample preparation, amplification, and detection on a single chip, enabling point-of-care diagnostics with improved sensitivity and specificity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in microfluidic device design\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for detecting sepsis biomarkers...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65953", "text": "{\n    \"patent_title\": \"Implantable Cardioverter-Defibrillator with Enhanced Battery Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Medtronic\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Boston Scientific\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-11-15\",\n    \"filing_date\": \"2022-11-15\",\n    \"issue_date\": \"2024-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardioverter-defibrillator (ICD) with a novel battery technology that extends battery life by 50%. The device includes improved algorithms for arrhythmia detection and pacing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art in ICD battery technology\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable cardioverter-defibrillator comprising...\",\n        \"A battery for an ICD...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65954", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10555555B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-02-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system utilizing advanced optical coherence tomography for real-time tissue differentiation, improving surgical precision and reducing patient recovery time. The system is designed for a variety of surgical procedures including cardiac and neurological applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9888888B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising an optical coherence tomography module...\",\n        \"A method for performing minimally invasive surgery using the system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65954", "text": "{\n    \"patent_title\": \"Dermal Filler Injection Device with Controlled Release\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Allergan Aesthetics\"\n        }\n    ],\n    \"patent_number\": \"US11222222B1\",\n    \"priority_date\": \"2018-05-20\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2021-09-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An injection device designed for precise delivery of dermal fillers for cosmetic enhancement. The device features a controlled release mechanism to minimize patient discomfort and optimize filler distribution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7777777B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"An injection device comprising a controlled release mechanism...\",\n        \"A method for injecting dermal fillers using the device...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65955", "text": "{\n    \"patent_title\": \"MRI Reconstruction Using Deep Learning for Enhanced Image Quality\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Robert Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A novel deep learning method for reconstructing magnetic resonance images (MRI) with improved resolution and reduced artifacts. This technique enhances diagnostic accuracy by providing clearer images of anatomical structures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images using a convolutional neural network.\",\n        \"A system for enhancing MRI image quality.\",\n        \"A method for reducing artifacts in MRI images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--65955", "text": "{\n    \"patent_title\": \"X-Ray Imaging System with Improved Radiation Shielding\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"EP3876543B1\",\n    \"priority_date\": \"2020-01-20\",\n    \"filing_date\": \"2020-01-20\",\n    \"issue_date\": \"2021-07-14\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"An X-ray imaging system designed to minimize radiation exposure to patients and operators. The system utilizes advanced shielding materials and techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising a radiation source and a shielding enclosure.\",\n        \"A shielding material for reducing radiation exposure.\"\n    ]\n}"}
{"_id": "Academic--patents--p--65956", "text": "{\n    \"patent_title\": \"Method and System for Enhanced CT Image Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-09-20\",\n    \"issue_date\": \"2021-05-04\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing CT images utilizing deep convolutional neural networks to reduce noise and improve image quality. This system enhances image clarity and reduces radiation exposure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a CT image comprising...\",\n        \"A system for processing CT scan data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65956", "text": "{\n    \"patent_title\": \"Improved MRI Sequence for Enhanced Cardiac Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-07-15\",\n    \"issue_date\": \"2022-03-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new MRI sequence designed to improve the visualization of cardiac structures. The sequence enhances contrast and reduces imaging time for cardiac patients.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI sequence characterized by...\",\n        \"A method for imaging cardiac tissue...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65957", "text": "{\n    \"patent_title\": \"Improved MRI Coil Design for Enhanced Patient Comfort and Image Quality\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel MRI coil design that utilizes flexible materials and optimized geometry to improve patient comfort and reduce motion artifacts, leading to higher diagnostic image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8785764B2\"\n        }\n    ],\n    \"claims\": [\n        \"A magnetic resonance imaging coil comprising...\",\n        \"A method for reducing patient discomfort during MRI scanning...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65957", "text": "{\n    \"patent_title\": \"Contrast Agent Delivery System for Enhanced CT Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"GE Healthcare\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2019-07-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for delivering contrast agents during CT scans to improve visualization of blood vessels and tissues. The system includes a microfluidic pump and a targeted delivery catheter.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent delivery system comprising...\",\n        \"A method for enhancing CT image quality using targeted contrast agents...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65958", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Sensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2022-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized wireless sensor for continuous glucose monitoring is disclosed. The sensor is designed to be minimally invasive and provide real-time glucose data to patients and healthcare providers, improving diabetes management and patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in glucose sensing technology\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless glucose sensor comprising...\",\n        \"A method for continuous glucose monitoring using the sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65958", "text": "{\n    \"patent_title\": \"Improved Cardiovascular Stent with Drug-Eluting Coating\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved cardiovascular stent with a drug-eluting coating is disclosed. This stent is designed to prevent restenosis and improve blood flow in patients with coronary artery disease, enhancing cardiovascular health.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art in stent technology\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiovascular stent comprising a drug-eluting coating...\",\n        \"A method for treating coronary artery disease using the stent...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65959", "text": "{\n    \"patent_title\": \"Ultrasound-guided focused ultrasound surgery system and method\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for performing focused ultrasound surgery (FUS) using ultrasound guidance for non-invasive thermal ablation of target tissue. The system includes an ultrasound transducer array and a focused ultrasound transducer.  The ultrasound guidance system provides real-time imaging of the target tissue, allowing for precise targeting and monitoring of the ablation process.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Method and apparatus for focused ultrasound therapy\"\n        }\n    ],\n    \"claims\": [\n        \"A system for performing focused ultrasound surgery, comprising...\",\n        \"A method for non-invasively ablating target tissue...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65959", "text": "{\n    \"patent_title\": \"X-ray imaging apparatus with enhanced contrast\",\n    \"inventors\": [\n        {\n            \"name\": \"Peter Jones\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9123456B2\",\n    \"priority_date\": \"2014-11-01\",\n    \"filing_date\": \"2014-11-01\",\n    \"issue_date\": \"2016-09-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An x-ray imaging apparatus with improved contrast resolution utilizing a novel filter and detector arrangement. The system provides enhanced visualization of internal structures for diagnostic purposes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Digital X-ray imaging system\"\n        }\n    ],\n    \"claims\": [\n        \"An x-ray imaging apparatus comprising...\",\n        \"A method for enhancing contrast in x-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65960", "text": "{\n    \"patent_title\": \"High-Capacity Solid-State Battery with Enhanced Energy Density\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11254321B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2021-12-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A solid-state battery design utilizing a novel electrolyte material to achieve significantly improved energy storage density and cycle life. The battery is suitable for portable electronics and grid-scale energy storage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art in solid-state electrolytes\"\n        }\n    ],\n    \"claims\": [\n        \"A solid-state battery comprising...\",\n        \"An electrolyte material characterized by...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65960", "text": "{\n    \"patent_title\": \"Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Tesla, Inc.\"\n        },\n        {\n            \"name\": \"Sarah Chen\",\n            \"affiliation\": \"Tesla, Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11567890B1\",\n    \"priority_date\": \"2020-03-10\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-06-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A sophisticated battery management system (BMS) designed to optimize the performance and lifespan of lithium-ion batteries in electric vehicles. The system features advanced thermal management and cell balancing algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10458765B2\",\n            \"relevance\": \"Prior art in electric vehicle BMS\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for an electric vehicle comprising...\",\n        \"A thermal management module configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65961", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the resolution and clarity of medical images reconstructed from raw data. The system utilizes a novel algorithm to reduce noise and artifacts, leading to improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"title\": \"Prior Art Medical Imaging System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for enhancing medical image clarity...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65961", "text": "{\n    \"patent_title\": \"Cosmetic Skin Analysis System Using Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anna Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10456789B1\",\n    \"priority_date\": \"2017-01-10\",\n    \"filing_date\": \"2017-01-10\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for analyzing skin conditions using medical imaging techniques. The system provides assessments of wrinkles, age spots, and other cosmetic concerns.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Skin Imaging Device\"\n        }\n    ],\n    \"claims\": [\n        \"A system for assessing cosmetic skin features comprising...\",\n        \"A method for identifying wrinkles using image analysis...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65962", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method and system for enhancing the resolution of digital images using a deep convolutional neural network. The system is trained on a large dataset of high- and low-resolution image pairs to learn a mapping function that can effectively upscale images while preserving details. The method incorporates a perceptual loss function to ensure the generated images are visually appealing and realistic. Applications include enhancing satellite imagery, improving the quality of digital photographs, and enhancing video streams.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Image Super-Resolution using Convolutional Neural Networks\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing the resolution of a digital image comprising: training a deep convolutional neural network on a dataset of image pairs...\",\n        \"A system for enhancing the resolution of a digital image comprising: a training module, an inference module...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65962", "text": "{\n    \"patent_title\": \"Medical Image Analysis System for Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Mayo Clinic\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Johns Hopkins University\"\n        }\n    ],\n    \"patent_number\": \"US11890123B1\",\n    \"priority_date\": \"2022-01-10\",\n    \"filing_date\": \"2022-01-10\",\n    \"issue_date\": \"2023-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for automatically detecting tumors in medical images, such as MRI and CT scans. The system utilizes machine learning algorithms to identify regions of interest and classify them as cancerous or benign. The method includes pre-processing steps to enhance image quality and reduce noise.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10567890B2\",\n            \"title\": \"Automated Cancer Detection System\"\n        }\n    ],\n    \"claims\": [\n        \"A medical image analysis system comprising: a module for receiving medical images...\",\n        \"A method for detecting tumors in medical images comprising: preprocessing the images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65963", "text": "{\n    \"patent_title\": \"Minimally Invasive Robotic Surgical System with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"Boston Dynamics\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A robotic surgical system enabling precise and minimally invasive procedures. The system incorporates advanced haptic feedback and real-time image guidance for improved surgical outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in robotic surgery.\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system comprising a robotic arm with at least seven degrees of freedom.\",\n        \"A method for performing minimally invasive surgery using the robotic surgical system.\"\n    ]\n}"}
{"_id": "Academic--patents--n--65963", "text": "{\n    \"patent_title\": \"Improved Scalpel Design for Traditional Surgery\",\n    \"inventors\": [\n        {\n            \"name\": \"Hans Schmidt\",\n            \"affiliation\": \"University of Heidelberg\"\n        }\n    ],\n    \"patent_number\": \"EP3876543B1\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2022-09-07\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"A novel scalpel design with an ergonomic handle and improved blade sharpness for enhanced surgical precision during open surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art scalpel designs.\"\n        }\n    ],\n    \"claims\": [\n        \"A scalpel comprising an ergonomic handle and a high-strength blade.\",\n        \"A method for performing surgical incisions using the scalpel.\"\n    ]\n}"}
{"_id": "Academic--patents--p--65964", "text": "{\n    \"patent_title\": \"AI-Enhanced MRI Reconstruction for Improved Diagnostic Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for reconstructing MRI images using deep learning algorithms. The AI-driven approach significantly reduces scan time and improves diagnostic accuracy, particularly in detecting subtle anomalies. It leverages convolutional neural networks to enhance image resolution and clarity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images using a deep learning algorithm.\",\n        \"A system comprising a MRI scanner and a processor configured to implement the method.\"\n    ]\n}"}
{"_id": "Academic--patents--n--65964", "text": "{\n    \"patent_title\": \"Improved X-Ray Tube Design for Reduced Radiation Exposure\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Carol Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"Dr. David Evans\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2019-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved X-ray tube design incorporating novel filament and anode materials. The design reduces radiation exposure while maintaining high image quality, enhancing patient safety. The new materials and design provide higher efficiency and longer tube life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube comprising a novel filament material.\",\n        \"A system for generating X-rays using the improved tube.\"\n    ]\n}"}
{"_id": "Academic--patents--p--65965", "text": "{\n    \"patent_title\": \"Miniaturized Robotic Surgical System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Chen\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized robotic surgical system enabling precise and minimally invasive surgical procedures. The system incorporates advanced imaging and control algorithms for enhanced surgical outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system comprising...\",\n        \"A method for performing minimally invasive surgery using...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65965", "text": "{\n    \"patent_title\": \"Surgical Stapler with Enhanced Closure\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Johnson & Johnson\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-15\",\n    \"issue_date\": \"2022-04-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler with enhanced closure mechanisms for more secure tissue sealing.  Designed for open surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"A method for sealing tissue using...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65966", "text": "{\n    \"patent_title\": \"High-Resolution Optical Coherence Tomography System for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-12-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel optical coherence tomography (OCT) system achieving significantly improved resolution and penetration depth for enhanced early cancer detection in tissue samples. This system utilizes a swept-source laser and advanced signal processing algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in OCT technology\"\n        }\n    ],\n    \"claims\": [\n        \"A method for imaging biological tissue using OCT with a resolution of less than 10 microns.\",\n        \"An OCT system comprising a swept-source laser and a signal processing unit.\"\n    ]\n}"}
{"_id": "Academic--patents--n--65966", "text": "{\n    \"patent_title\": \"Improved MRI Contrast Agent Formulation\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"Pfizer Inc.\"\n        },\n        {\n            \"name\": \"Dr. Emily Wilson\",\n            \"affiliation\": \"Pfizer Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-07-01\",\n    \"filing_date\": \"2020-07-01\",\n    \"issue_date\": \"2023-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel formulation of gadolinium-based contrast agent for magnetic resonance imaging (MRI) offering enhanced signal intensity and reduced toxicity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art in MRI contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A gadolinium-based contrast agent formulation with a reduced toxicity profile.\",\n        \"A method for enhancing MRI image quality using the contrast agent.\"\n    ]\n}"}
{"_id": "Academic--patents--p--65967", "text": "{\n    \"patent_title\": \"AI-Powered Diagnostic System for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-10-26\",\n    \"filing_date\": \"2020-05-15\",\n    \"issue_date\": \"2021-08-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel AI system for the early detection of cancer using medical imaging analysis. The system utilizes deep learning algorithms to identify subtle patterns indicative of malignancy with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for diagnosing cancer comprising: obtaining a medical image; applying a deep learning algorithm to the medical image; and generating a diagnostic report based on the algorithm's output.\"\n    ]\n}"}
{"_id": "Academic--patents--n--65967", "text": "{\n    \"patent_title\": \"Improved Method for Calibrating Medical Imaging Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-03-10\",\n    \"filing_date\": \"2019-09-22\",\n    \"issue_date\": \"2020-12-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an improved method for calibrating medical imaging devices, leading to more accurate and reliable image quality. It builds upon existing calibration techniques with minor adjustments.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for calibrating a medical imaging device comprising: adjusting the device settings based on a predetermined calibration protocol.\"\n    ]\n}"}
{"_id": "Academic--patents--p--65968", "text": "{\n    \"patent_title\": \"Automated Lung Nodule Detection Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2021-07-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for automated detection of lung nodules in CT scans using deep convolutional neural networks. The system is designed for improved accuracy and efficiency in early lung cancer diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image segmentation\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting lung nodules...\",\n        \"A system comprising a deep learning model...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65968", "text": "{\n    \"patent_title\": \"Method for Enhancing Color Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2022-05-15\",\n    \"issue_date\": \"2024-02-29\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel algorithm for enhancing the color saturation and contrast of digital images. It finds applications in consumer photography and image editing software.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10111213B2\",\n            \"relevance\": \"Related to color space transformations\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing color saturation...\",\n        \"A digital image processing apparatus...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65969", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Compression Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-09-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for compressing images using deep convolutional neural networks, achieving higher compression ratios with minimal loss of image quality. The system is suitable for various applications including video streaming and image storage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image comprising:...\",\n        \"A system for compressing an image comprising:...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65969", "text": "{\n    \"patent_title\": \"Automated Diagnosis of Retinal Diseases Using Image Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Wilson\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2016-11-01\",\n    \"issue_date\": \"2018-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for automatically diagnosing retinal diseases such as diabetic retinopathy and macular degeneration using image analysis techniques. The system analyzes retinal images to detect signs of disease and provide a diagnostic report.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related art in medical image analysis\"\n        }\n    ],\n    \"claims\": [\n        \"A method for diagnosing a retinal disease comprising:...\",\n        \"A system for diagnosing a retinal disease comprising:...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65970", "text": "{\n    \"patent_title\": \"Method and System for Dynamically Adjusting Display Refresh Rate to Extend Battery Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Qualcomm Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for dynamically adjusting the display refresh rate of a mobile device based on the content being displayed and user interaction. By reducing the refresh rate when high-speed visuals are not needed, significant power savings are achieved, thereby extending battery life. The system utilizes machine learning algorithms to predict optimal refresh rates, ensuring a seamless user experience. This approach represents a significant advancement in power management for mobile devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for dynamically adjusting a display refresh rate...\",\n        \"A system for extending battery life in a mobile device...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65970", "text": "{\n    \"patent_title\": \"Improved Casing Design for Mobile Phones\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Apple Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2022-09-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a new casing design for mobile phones, focusing on improved shock absorption and aesthetic appeal. The casing is constructed from a novel polymer blend that provides enhanced protection against drops and impacts. The design also incorporates ergonomic features for improved grip and comfort. The casing design is relatively simple and does not claim to improve battery life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A casing for a mobile phone comprising...\",\n        \"A polymer blend for shock absorption...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65971", "text": "{\n    \"patent_title\": \"Enhanced Image Reconstruction Method for Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image reconstruction algorithm for MRI that significantly reduces scan time and improves image quality.  The method utilizes deep learning techniques to enhance image resolution and reduce noise.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"The method of claim 1, wherein the deep learning model is a convolutional neural network.\",\n        \"The method of claim 2, further comprising...\",\n        \"A system for performing MRI reconstruction...\",\n        \"The system of claim 4, wherein the processor is configured...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65971", "text": "{\n    \"patent_title\": \"Slight Modification to X-ray Tube Cooling System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2016-09-20\",\n    \"filing_date\": \"2016-09-20\",\n    \"issue_date\": \"2018-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minor improvement to the cooling system of an X-ray tube, preventing overheating during extended use.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A cooling system for an X-ray tube comprising...\",\n        \"The cooling system of claim 1, wherein the fan speed is adjustable.\"\n    ]\n}"}
{"_id": "Academic--patents--p--65972", "text": "{\n    \"patent_title\": \"Remote Physiological Monitoring System and Method\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"MIT Lincoln Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US10543216B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-01-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for remote monitoring of a patient's physiological parameters, including heart rate, blood pressure, and oxygen saturation. The system transmits data wirelessly to a central monitoring station for analysis and alerts. Utilizes novel signal processing techniques to improve accuracy and reduce false alarms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8226624B2\",\n            \"relevance\": \"Prior art in wireless medical devices\"\n        }\n    ],\n    \"claims\": [\n        \"A method for remotely monitoring a patient's physiological parameters comprising...\",\n        \"A system for transmitting physiological data wirelessly...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65972", "text": "{\n    \"patent_title\": \"Improved Surgical Instrument Handle\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Acme Corporation\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2019-05-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved handle design for surgical instruments, providing enhanced grip and control during surgical procedures. The handle incorporates ergonomic features and utilizes advanced materials to reduce fatigue for the surgeon.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7540521B2\",\n            \"relevance\": \"Prior art in surgical instrument handles\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument handle comprising...\",\n        \"A handle with an ergonomic grip...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65973", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Electrolyte for Improved Performance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-11-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery incorporating a novel electrolyte composition exhibiting enhanced ionic conductivity and thermal stability, resulting in improved battery performance and lifespan. The electrolyte utilizes a blend of lithium salts and organic solvents optimized for high-energy-density applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on electrolyte materials\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrolyte composition...\",\n        \"The electrolyte composition comprising a blend of lithium salts and organic solvents...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65973", "text": "{\n    \"patent_title\": \"Proton Exchange Membrane Fuel Cell with Improved Catalyst Layer\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Bloom Energy\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2023-02-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A proton exchange membrane fuel cell featuring an improved catalyst layer architecture designed to enhance power density and durability. The catalyst layer incorporates a novel nanomaterial support structure for optimal catalyst dispersion.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related fuel cell technology\"\n        }\n    ],\n    \"claims\": [\n        \"A proton exchange membrane fuel cell comprising a catalyst layer...\",\n        \"The catalyst layer comprising a nanomaterial support structure...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65974", "text": "{\n    \"patent_title\": \"Solid-State Electrolyte for Sodium-Ion Batteries with Enhanced Ionic Conductivity\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-05-10\",\n    \"filing_date\": \"2018-05-10\",\n    \"issue_date\": \"2021-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel solid-state electrolyte composition for sodium-ion batteries exhibiting significantly improved ionic conductivity and electrochemical stability, leading to enhanced battery performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art on solid electrolytes\"\n        }\n    ],\n    \"claims\": [\n        \"A solid-state electrolyte composition comprising...\",\n        \"A sodium-ion battery comprising the solid-state electrolyte...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65974", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Cathode Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-02-29\",\n    \"filing_date\": \"2016-02-29\",\n    \"issue_date\": \"2019-08-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery cathode material with enhanced energy density and cycle life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related prior art on lithium-ion cathodes\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery cathode material comprising...\",\n        \"A lithium-ion battery comprising the cathode material...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65975", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2020-03-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable glucose sensor utilizing microfabrication techniques and wireless communication for continuous glucose monitoring. The device aims to improve diabetes management by providing real-time glucose data to patients and healthcare providers, thereby improving patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in glucose sensing technology.\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable glucose sensor comprising...\",\n        \"A wireless communication module for transmitting glucose data...\",\n        \"A method for continuous glucose monitoring using the sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65975", "text": "{\n    \"patent_title\": \"Complex Robotic Surgical System with Advanced Imaging Capabilities\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Emily Wilson\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US99876543B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2019-04-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A highly complex robotic surgical system integrating advanced imaging modalities, haptic feedback, and artificial intelligence for minimally invasive surgical procedures. Designed for complex surgeries, it enhances precision and control for surgeons.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Early robotic surgery systems.\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system comprising a multi-arm robotic manipulator...\",\n        \"An advanced imaging system providing real-time 3D visualization...\",\n        \"A control system utilizing artificial intelligence algorithms...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65976", "text": "{\n    \"patent_title\": \"Enhanced Lithium-Ion Battery Electrode Materials for Prolonged Portable Device Lifespan\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology - Materials Science and Engineering\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University - Chemical Engineering\"\n        }\n    ],\n    \"patent_number\": \"US11250987B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2021-12-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel electrode materials for lithium-ion batteries, significantly improving energy density and cycle life, leading to extended battery performance in portable electronic devices such as smartphones and laptops. The materials exhibit enhanced ionic conductivity and reduced degradation over repeated charge-discharge cycles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode material with a specific chemical composition.\",\n        \"A portable electronic device powered by the lithium-ion battery of claim 1.\",\n        \"A method for manufacturing the lithium-ion battery of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--65976", "text": "{\n    \"patent_title\": \"Battery Management System for Electric Vehicle Traction Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Carlos Rodriguez\",\n            \"affiliation\": \"Tesla, Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11345678B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2022-03-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a battery management system (BMS) for large-scale lithium-ion battery packs used in electric vehicles. The BMS provides accurate state-of-charge estimation, thermal management, and fault detection to ensure safe and reliable operation of the vehicle's traction batteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for a lithium-ion battery pack.\",\n        \"A method for controlling the charging and discharging of the battery pack.\",\n        \"An electric vehicle incorporating the battery management system.\"\n    ]\n}"}
{"_id": "Academic--patents--p--65977", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Blood Glucose Sensor\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-15\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable sensor for continuous glucose monitoring. The sensor utilizes a novel enzymatic reaction and wireless communication for real-time data transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable glucose sensor comprising...\",\n        \"A method for continuous glucose monitoring using the sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65977", "text": "{\n    \"patent_title\": \"Improved Surgical Robot Arm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2022-03-15\",\n    \"filing_date\": \"2022-03-20\",\n    \"issue_date\": \"2023-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical robot arm with enhanced precision and dexterity. The arm utilizes advanced control algorithms and force feedback sensors.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robot arm comprising...\",\n        \"A control system for the surgical robot arm...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65978", "text": "{\n    \"patent_title\": \"Miniature Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2018-05-10\",\n    \"filing_date\": \"2018-05-10\",\n    \"issue_date\": \"2019-12-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature implantable glucose sensor is disclosed. The sensor utilizes a novel enzymatic reaction and a wireless communication protocol for real-time glucose monitoring, addressing the need for continuous and less invasive glucose measurement in diabetic patients.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8246851B2\",\n            \"relevance\": \"Prior art in glucose sensing technology\"\n        }\n    ],\n    \"claims\": [\n        \"A miniature implantable glucose sensor comprising...\",\n        \"A wireless communication module for transmitting glucose data...\",\n        \"A method for continuous glucose monitoring using the sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65978", "text": "{\n    \"patent_title\": \"Improved Stent Design for Coronary Artery Disease\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"University of California, San Francisco\"\n        },\n        {\n            \"name\": \"Emily Chen\",\n            \"affiliation\": \"Boston Scientific\"\n        }\n    ],\n    \"patent_number\": \"US10458921B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-15\",\n    \"issue_date\": \"2020-02-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel stent design is presented, incorporating a biocompatible coating and improved mechanical properties to reduce the risk of restenosis in patients with coronary artery disease. This improves upon existing stent technologies by providing enhanced long-term patency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"relevance\": \"Previous generation stent designs\"\n        }\n    ],\n    \"claims\": [\n        \"A stent comprising a biocompatible coating...\",\n        \"A method for treating coronary artery disease using the stent...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65979", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11254321B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-03-20\",\n    \"issue_date\": \"2021-12-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable biosensor for continuous glucose monitoring, designed to improve patient outcomes through real-time data analysis and personalized insulin delivery recommendations. The device utilizes a novel enzymatic reaction and wireless communication protocol.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A biosensor comprising a glucose oxidase enzyme immobilized on a microelectrode array.\",\n        \"A wireless communication module for transmitting glucose level data to a remote monitoring device.\"\n    ]\n}"}
{"_id": "Academic--patents--n--65979", "text": "{\n    \"patent_title\": \"Surgical Robotic System with Enhanced Precision and Dexterity\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11300897B1\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-07-15\",\n    \"issue_date\": \"2022-04-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical robotic system designed for minimally invasive procedures, offering enhanced precision, dexterity, and control to surgeons.  The system incorporates advanced image guidance and haptic feedback technologies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10234567B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic arm comprising multiple degrees of freedom.\",\n        \"An image guidance system for real-time visualization of surgical procedures.\"\n    ]\n}"}
{"_id": "Academic--patents--p--65980", "text": "{\n    \"patent_title\": \"Non-Invasive Glucose Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-11\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive system for continuous glucose monitoring utilizing optical sensors. The system provides real-time glucose levels without the need for blood draws, improving patient comfort and compliance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A non-invasive glucose monitoring system comprising...\",\n        \"A method for continuously measuring glucose levels...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65980", "text": "{\n    \"patent_title\": \"Surgical Robotic Arm with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US98765432B2\",\n    \"priority_date\": \"2022-03-15\",\n    \"filing_date\": \"2022-03-16\",\n    \"issue_date\": \"2024-02-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A robotic arm designed for surgical procedures with improved precision and dexterity. The system allows surgeons to perform minimally invasive surgeries with greater control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic arm comprising...\",\n        \"A control system for precise movements...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65981", "text": "{\n    \"patent_title\": \"High-Resolution Optical Coherence Tomography for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2023-12-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel optical coherence tomography system providing significantly enhanced resolution for early cancer detection in tissue samples. Utilizes advanced signal processing and adaptive optics techniques to minimize scattering and improve image clarity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in OCT imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating a high-resolution image of a tissue sample using optical coherence tomography.\",\n        \"An optical coherence tomography system comprising an interferometer, a light source, and a signal processing unit.\"\n    ]\n}"}
{"_id": "Academic--patents--n--65981", "text": "{\n    \"patent_title\": \"Improved X-ray Imaging System with Reduced Radiation Dose\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Williams\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-02-15\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2022-08-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An X-ray imaging system designed to minimize radiation exposure to patients while maintaining diagnostic image quality. Incorporates advanced filtering and dose modulation techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous X-ray dose reduction methods\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system with reduced radiation dose.\",\n        \"A method for controlling radiation exposure during X-ray imaging.\"\n    ]\n}"}
{"_id": "Academic--patents--p--65982", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Pathogen Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for rapid and sensitive detection of pathogens in biological samples. The device utilizes a novel surface modification technique to enhance capture efficiency and reduce false positives.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B1\",\n            \"relevance\": \"Related to microfluidic devices\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for detecting pathogens...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65982", "text": "{\n    \"patent_title\": \"Implantable Cardiac Pacemaker with Advanced Rhythm Management\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac pacemaker that provides advanced rhythm management capabilities, including atrial fibrillation detection and pacing. The device utilizes closed-loop feedback control to optimize pacing parameters.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related to cardiac pacing technology\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable cardiac pacemaker...\",\n        \"A method for pacing a heart...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65983", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2023-03-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable glucose sensor with wireless communication capabilities for continuous glucose monitoring. The sensor utilizes a novel enzymatic reaction and a biocompatible power source.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable glucose sensor comprising...\",\n        \"A wireless communication module for transmitting glucose data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65983", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Johnson & Johnson\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-12-01\",\n    \"filing_date\": \"2017-12-01\",\n    \"issue_date\": \"2022-10-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical stapler with an improved ergonomic handle design for enhanced comfort and precision during surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an ergonomic handle...\",\n        \"A staple cartridge configured for precise staple delivery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65984", "text": "{\n    \"patent_title\": \"Enhanced MRI Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-04-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning approach for reconstructing high-resolution MRI images from undersampled k-space data, leading to improved image clarity and reduced scan time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images...\",\n        \"A system for performing MRI reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65984", "text": "{\n    \"patent_title\": \"X-Ray Image Enhancement System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2013-11-20\",\n    \"filing_date\": \"2013-11-20\",\n    \"issue_date\": \"2016-02-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An X-ray image enhancement system utilizing contrast agents to improve image visibility. This is a standard implementation of X-ray technology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US5432109B2\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US4321098B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray image enhancement system...\",\n        \"A method for enhancing X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65985", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Drug Delivery System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized, wirelessly controlled drug delivery system for targeted therapeutic intervention. The system improves patient outcomes by providing precise dosage and reducing systemic side effects.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on implantable devices\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable drug delivery system comprising...\",\n        \"A method for wirelessly controlling the release of a drug...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65985", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging Coil Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2023-01-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved design for magnetic resonance imaging coils, resulting in higher image resolution and reduced scan times.  The invention focuses on signal acquisition and image clarity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous MRI coil designs\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil comprising a modified loop geometry...\",\n        \"A method for enhancing image resolution using the improved coil...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65986", "text": "{\n    \"patent_title\": \"Micro-Robotic System for Targeted Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-05-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A micro-robotic system for precise and targeted delivery of therapeutic agents within the human body. The system utilizes biocompatible materials and a novel navigation algorithm to enhance treatment efficacy and minimize side effects.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in micro-robotics\"\n        }\n    ],\n    \"claims\": [\n        \"A micro-robotic device comprising...\",\n        \"A method for targeted drug delivery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65986", "text": "{\n    \"patent_title\": \"Improved Stethoscope Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Emily Davis\",\n            \"affiliation\": \"Acme Medical Devices\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2022-11-01\",\n    \"filing_date\": \"2022-11-01\",\n    \"issue_date\": \"2024-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved stethoscope design incorporating noise cancellation technology and enhanced amplification for more accurate auscultation. Provides clearer sound for medical diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Existing stethoscope technology\"\n        }\n    ],\n    \"claims\": [\n        \"A stethoscope comprising...\",\n        \"A method for enhancing sound clarity...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65987", "text": "{\n    \"patent_title\": \"Biodegradable Polymer Scaffolds for Bone Regeneration\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-08-20\",\n    \"issue_date\": \"2023-02-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A biodegradable polymer scaffold for promoting bone regeneration, exhibiting enhanced biocompatibility through surface modification with hydroxyapatite.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Similar scaffold design\"\n        }\n    ],\n    \"claims\": [\n        \"A biodegradable polymer scaffold comprising...\",\n        \"A method for promoting bone regeneration...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65987", "text": "{\n    \"patent_title\": \"Implantable Cardiovascular Defibrillator with Enhanced Lead Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-01-10\",\n    \"filing_date\": \"2022-04-05\",\n    \"issue_date\": \"2024-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiovascular defibrillator featuring a novel lead design for improved signal transmission and reduced tissue damage. Highly biocompatible materials utilized.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"relevance\": \"Previous defibrillator technologies\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable cardiovascular defibrillator...\",\n        \"A lead design for...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65988", "text": "{\n    \"patent_title\": \"Non-Invasive Glucose Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive glucose monitoring system using optical sensors and machine learning algorithms to provide real-time glucose levels without the need for blood samples. This system improves patient comfort and allows for continuous monitoring.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\",\n            \"relation\": \"Related\"\n        }\n    ],\n    \"claims\": [\n        \"A non-invasive glucose monitoring device comprising...\",\n        \"A method for continuously monitoring glucose levels...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65988", "text": "{\n    \"patent_title\": \"Improved Scalpel Handle Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2022-05-10\",\n    \"filing_date\": \"2022-05-10\",\n    \"issue_date\": \"2024-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new scalpel handle design offering improved ergonomics and grip for surgeons, leading to increased precision and reduced hand fatigue during surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"relation\": \"Related\"\n        }\n    ],\n    \"claims\": [\n        \"A scalpel handle comprising...\",\n        \"A surgical instrument incorporating the scalpel handle...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65989", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Implantable Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-08-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized wireless implantable pressure sensor system for continuous monitoring of intracranial pressure. The system utilizes biocompatible materials and low-power communication protocols.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"kind\": \"cited_by\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless implantable pressure sensor comprising...\",\n        \"A method for continuously monitoring intracranial pressure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65989", "text": "{\n    \"patent_title\": \"Improved Catheter Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US4500001B1\",\n    \"priority_date\": \"1978-01-01\",\n    \"filing_date\": \"1978-01-01\",\n    \"issue_date\": \"1985-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design with enhanced flexibility and reduced trauma during insertion.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US4500000\",\n            \"kind\": \"cited_by\"\n        },\n        {\n            \"patent_number\": \"US5678901B1\",\n            \"kind\": \"cited_by\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible distal tip...\",\n        \"A method for inserting a catheter into a blood vessel...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65990", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Neural Stimulator for Chronic Pain Management\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable neural stimulator is disclosed for the treatment of chronic pain. The device provides targeted electrical stimulation to modulate nerve activity, offering a non-pharmacological alternative for pain management. Improved battery life and biocompatible materials are key features.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related prior art on neural stimulation techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable neural stimulator comprising...\",\n        \"A method for treating chronic pain using the stimulator...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65990", "text": "{\n    \"patent_title\": \"Improved Stent Design for Coronary Artery Disease\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2022-03-15\",\n    \"filing_date\": \"2022-03-15\",\n    \"issue_date\": \"2024-02-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved stent design for the treatment of coronary artery disease is disclosed. The stent features a novel expandable structure and biocompatible coating to reduce the risk of restenosis. The design aims to provide enhanced blood flow and improved patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art regarding stent materials and designs\"\n        }\n    ],\n    \"claims\": [\n        \"A stent comprising a novel expandable structure...\",\n        \"A method for treating coronary artery disease using the stent...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65991", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Glucose Sensor\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"MIT Lincoln Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable glucose sensor for continuous glucose monitoring. The sensor utilizes a novel enzymatic reaction and wireless communication for real-time data transmission. Designed for improved patient comfort and accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on glucose sensing technology\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable glucose sensor comprising...\",\n        \"A method for continuous glucose monitoring using the sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65991", "text": "{\n    \"patent_title\": \"Complex Robotic Surgical System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Davies\",\n            \"affiliation\": \"Acme Robotics Corp.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-11-15\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2022-05-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A highly advanced robotic surgical system featuring multiple arms, 3D visualization, and AI-assisted precision. Designed for complex surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art on robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system comprising multiple robotic arms...\",\n        \"A method for performing surgical procedures using the system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65992", "text": "{\n    \"patent_title\": \"High-Density Solid-State Battery with Enhanced Safety Features\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-01-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel solid-state battery design utilizing a ceramic electrolyte, offering increased energy density, improved safety characteristics, and reduced environmental impact compared to conventional lithium-ion batteries. The design minimizes the use of rare earth materials and promotes recyclability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in solid-state electrolyte materials.\"\n        }\n    ],\n    \"claims\": [\n        \"A solid-state battery comprising a ceramic electrolyte...\",\n        \"A method for manufacturing a solid-state battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65992", "text": "{\n    \"patent_title\": \"Improved Lead-Acid Battery for Automotive Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Exide Technologies\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2013-11-20\",\n    \"filing_date\": \"2013-11-20\",\n    \"issue_date\": \"2017-09-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved lead-acid battery design featuring enhanced plate construction and electrolyte additives for increased cycle life and performance in automotive applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art in lead-acid battery electrode design.\"\n        }\n    ],\n    \"claims\": [\n        \"A lead-acid battery comprising a modified plate structure...\",\n        \"A method for assembling a lead-acid battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65993", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the resolution of digital images using a deep learning model. The system employs a generative adversarial network (GAN) to generate high-resolution images from low-resolution inputs, improving image clarity and detail.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Super-Resolution Using Convolutional Neural Networks\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising...\",\n        \"The method of claim 1, wherein the deep learning model is a GAN.\",\n        \"A system for enhancing image resolution...\",\n        \"The system of claim 3, further comprising a user interface.\",\n        \"The system of claim 3, adapted for real-time processing.\"\n    ]\n}"}
{"_id": "Academic--patents--n--65993", "text": "{\n    \"patent_title\": \"Medical Image Analysis System for Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Mayo Clinic\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-05-10\",\n    \"filing_date\": \"2022-05-10\",\n    \"issue_date\": \"2024-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for analyzing medical images, such as MRI and CT scans, to detect tumors and other anomalies. The system uses machine learning algorithms to identify potential areas of concern.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Automated Cancer Detection in Medical Images\"\n        }\n    ],\n    \"claims\": [\n        \"A medical image analysis system comprising...\",\n        \"The system of claim 1, wherein the medical images are MRI scans.\",\n        \"A method for detecting tumors in medical images...\",\n        \"The method of claim 3, further comprising displaying the detected tumors to a user.\"\n    ]\n}"}
{"_id": "Academic--patents--p--65994", "text": "{\n    \"patent_title\": \"High-Performance Solid-State Lithium-Ion Battery with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel solid-state lithium-ion battery design utilizing a ceramic electrolyte and a high-capacity cathode material, resulting in significantly improved energy density, stability, and safety compared to conventional lithium-ion batteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"prior art\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US11000001B2\",\n            \"relevance\": \"cited by\"\n        }\n    ],\n    \"claims\": [\n        \"A solid-state lithium-ion battery comprising...\",\n        \"A ceramic electrolyte with a lithium-ion conductivity...\",\n        \"A cathode material capable of storing at least 400 mAh/g...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65994", "text": "{\n    \"patent_title\": \"Incremental Improvement to Lithium-Ion Battery Electrode Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Charles Davis\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2022-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A slight modification to the chemical composition of a conventional lithium-ion battery electrode material, resulting in a minor improvement in cycle life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrode material comprising...\",\n        \"A modified chemical composition of lithium cobalt oxide...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65995", "text": "{\n    \"patent_title\": \"Miniature Implantable Drug Delivery System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Chen\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized, implantable device for controlled drug release, enabling targeted therapy and improved patient compliance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on implantable devices.\"\n        }\n    ],\n    \"claims\": [\n        \"A drug delivery system comprising...\",\n        \"The system of claim 1, wherein...\",\n        \"A method of treating a disease...\",\n        \"The method of claim 3, wherein...\",\n        \"The drug delivery system of claim 1, further comprising...\",\n        \"The method of claim 3, further comprising...\",\n        \"The system of claim 1, where the drug is released...\",\n        \"A method for controlling release rate...\",\n        \"A system for remote monitoring...\",\n        \"The system of claim 1, wherein the implant is biocompatible...\",\n        \"A method of manufacturing the system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65995", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Johnson & Johnson\"\n        },\n        {\n            \"name\": \"David Evans\",\n            \"affiliation\": \"Johnson & Johnson\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-09-20\",\n    \"filing_date\": \"2017-09-20\",\n    \"issue_date\": \"2020-06-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler designed for enhanced precision and comfort during surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Previous designs of surgical staplers.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"The stapler of claim 1, wherein...\",\n        \"A method of using the stapler...\",\n        \"The method of claim 3, wherein...\",\n        \"The stapler of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--65996", "text": "{\n    \"patent_title\": \"Implantable Cardiac Rhythm Management System with Adaptive Stimulation\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Boston University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac rhythm management system including a pulse generator and leads for delivering stimulation to the heart. The system adapts stimulation parameters based on real-time physiological data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related prior art on cardiac pacing\"\n        }\n    ],\n    \"claims\": [\n        \"1. A cardiac rhythm management system comprising: a pulse generator configured to deliver electrical stimulation pulses to the heart; and a lead coupled to the pulse generator and configured to deliver the electrical stimulation pulses to cardiac tissue.\",\n        \"2. The system of claim 1, wherein the pulse generator is configured to adjust stimulation parameters based on sensed physiological data.\"\n    ]\n}"}
{"_id": "Academic--patents--n--65996", "text": "{\n    \"patent_title\": \"Drug-Eluting Stent with Biodegradable Polymer Coating\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-01-10\",\n    \"filing_date\": \"2017-01-10\",\n    \"issue_date\": \"2019-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A drug-eluting stent comprising a metal scaffold and a biodegradable polymer coating containing a therapeutic agent for preventing restenosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art on stent design\"\n        }\n    ],\n    \"claims\": [\n        \"1. A drug-eluting stent comprising: a metal scaffold; and a biodegradable polymer coating disposed on the metal scaffold, wherein the coating comprises a therapeutic agent.\",\n        \"2. The stent of claim 1, wherein the therapeutic agent is a drug for preventing restenosis.\"\n    ]\n}"}
{"_id": "Academic--patents--p--65997", "text": "{\n    \"patent_title\": \"Deep Learning-Based System for Automated Cancer Detection in MRI Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Radiology Associates\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2020-06-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for automatically detecting cancerous tissues in medical images, specifically MRI scans, using a deep convolutional neural network. The system improves diagnostic accuracy and reduces radiologist workload.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Medical Image Analysis Using Convolutional Neural Networks\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancer in MRI images comprising...\",\n        \"A system for automated cancer detection...\"\n    ]\n}"}
{"_id": "Academic--patents--n--65997", "text": "{\n    \"patent_title\": \"Efficient JPEG2000 Compression for Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2018-11-01\",\n    \"issue_date\": \"2021-02-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for highly efficient compression of medical images using the JPEG2000 standard, reducing storage and transmission bandwidth requirements.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Wavelet-Based Image Compression Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing medical images using JPEG2000...\",\n        \"A system for reducing the size of medical image files...\"\n    ]\n}"}
