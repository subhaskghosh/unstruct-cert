{"_id": "Academic--patents--p--66355", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-14\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications. The system utilizes a MEMS pressure sensor and a low-power radio transmitter to wirelessly transmit pressure data. This invention provides a compact and accurate means for monitoring physiological pressure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"1. A wireless pressure sensor system...\",\n        \"2. The system of claim 1, wherein the sensor is a MEMS sensor...\",\n        \"3. The system of claim 1, further comprising a power source...\",\n        \"4. The system of claim 3, wherein the power source is a battery...\",\n        \"5. The system of claim 1, wherein the radio transmitter operates in the 2.4 GHz band...\",\n        \"6. A method for measuring pressure...\",\n        \"7. The method of claim 6, wherein the pressure is physiological pressure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66355", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-12-01\",\n    \"filing_date\": \"2009-12-01\",\n    \"issue_date\": \"2018-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved bicycle brake system utilizing a novel cable mechanism for enhanced stopping power and modulation. The system offers increased reliability and reduced maintenance requirements.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"1. A bicycle brake system comprising...\",\n        \"2. The system of claim 1, wherein the cable mechanism includes...\",\n        \"3. The system of claim 1, further comprising a lever...\"\n    ]\n}"}
