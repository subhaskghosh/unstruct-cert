{"_id": "Academic--patents--p--66614", "text": "{\n    \"patent_title\": \"Neural Network Architecture for Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel neural network architecture for improved image recognition accuracy and efficiency, utilizing a combination of convolutional and recurrent layers.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in convolutional neural networks\"\n        }\n    ],\n    \"claims\": [\n        \"A neural network comprising at least one convolutional layer.\",\n        \"A neural network comprising at least one recurrent layer.\",\n        \"A method for training a neural network using backpropagation.\",\n        \"A system for image recognition utilizing a trained neural network.\",\n        \"A computer-readable medium storing instructions for implementing the method.\",\n        \"The neural network of claim 1, wherein the convolutional layer utilizes a 3x3 kernel.\",\n        \"The method of claim 3, wherein backpropagation is performed with a learning rate of 0.01.\"\n    ]\n}"}
