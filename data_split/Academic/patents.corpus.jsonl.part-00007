{"_id": "Academic--patents--p--66212", "text": "{\n    \"patent_title\": \"Improved Electrode Material for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel electrode material for lithium-ion batteries, improving energy density and cycle life. The material is a composite of nickel, manganese, and cobalt oxides with a unique structural arrangement.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode material...\",\n        \"The electrode material of claim 1, wherein the material is a composite...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66212", "text": "{\n    \"patent_title\": \"Battery Management System for Lithium-Ion Battery Packs\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10456789B1\",\n    \"priority_date\": \"2012-05-10\",\n    \"filing_date\": \"2012-05-10\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A sophisticated battery management system (BMS) for lithium-ion battery packs, ensuring safe and efficient operation. The system includes voltage monitoring, temperature control, and cell balancing features.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for a lithium-ion battery pack, comprising...\",\n        \"The battery management system of claim 1, further comprising a temperature sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66213", "text": "{\n    \"patent_title\": \"System and Method for Predictive Maintenance Using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for predicting equipment failure using machine learning algorithms.  The system analyzes sensor data to identify patterns indicative of impending failure, allowing for proactive maintenance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Predictive Maintenance System\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for predicting equipment failure comprising...\",\n        \"2. The system of claim 1, wherein the machine learning algorithm...\",\n        \"3. A method for predicting equipment failure...\",\n        \"4. The method of claim 3, wherein the sensor data...\",\n        \"5. The system of claim 1, further comprising a user interface...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66213", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Independent Inventor\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved braking system for bicycles, providing enhanced stopping power and modulation.\",\n    \"citations\": [],\n    \"claims\": [\n        \"1. A bicycle braking system comprising...\",\n        \"2. The braking system of claim 1, wherein the brake lever...\",\n        \"3. A method of braking a bicycle...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66214", "text": "{\n    \"patent_title\": \"Method and system for enhanced image processing using deep learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for enhancing image processing capabilities using deep learning algorithms. The system is designed to improve image quality, object recognition, and overall visual analysis. Applications include medical imaging and autonomous vehicles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in image segmentation\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing an image using a deep neural network.\",\n        \"A system comprising a processor and a memory configured to implement the method.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66214", "text": "{\n    \"patent_title\": \"Novel Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Motors\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-07-01\",\n    \"filing_date\": \"2017-07-01\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a battery management system for electric vehicles. The system aims to optimize battery life, improve safety, and enhance overall vehicle performance. It incorporates advanced thermal management and cell balancing techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Prior art in battery thermal management\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for an electric vehicle comprising a thermal management module.\",\n        \"A method for controlling battery charging and discharging.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66215", "text": "{\n    \"patent_title\": \"Miniature Implantable Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-11-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature implantable pressure sensor system for monitoring intracranial pressure. The system comprises a MEMS pressure sensor, a wireless communication module, and a biocompatible housing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Implantable Biomedical Devices\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Wireless Pressure Sensing\"\n        },\n        {\n            \"patent_number\": \"US10456789B1\",\n            \"title\": \"Biocompatible Coatings\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Micro-Electro-Mechanical Systems\"\n        },\n        {\n            \"patent_number\": \"US11987654B2\",\n            \"title\": \"Data Transmission Protocols\"\n        }\n    ],\n    \"claims\": [\n        \"A miniature implantable pressure sensor system...\",\n        \"The system of claim 1, comprising a wireless communication module...\",\n        \"The system of claim 1, wherein the housing is biocompatible...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66215", "text": "{\n    \"patent_title\": \"Novel Surgical Instrument\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2020-01-20\",\n    \"filing_date\": \"2020-04-15\",\n    \"issue_date\": \"2022-05-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical instrument for precise tissue dissection. It features an ergonomic handle and a rotating blade.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Surgical Instruments\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Ergonomic Handles\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising an ergonomic handle...\",\n        \"The instrument of claim 1, comprising a rotating blade...\"\n    ]\n}"}
