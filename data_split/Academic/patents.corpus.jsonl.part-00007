{"_id": "Academic--patents--p--66023", "text": "{\n    \"patent_title\": \"AI-Powered Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-05-04\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel image recognition system utilizing artificial intelligence and deep learning algorithms to achieve state-of-the-art accuracy in object detection and classification. The system is designed for use in autonomous vehicles and security applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for classifying objects in an image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66023", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Independent Inventor\"\n        }\n    ],\n    \"patent_number\": \"US11345678B2\",\n    \"priority_date\": \"2019-11-20\",\n    \"filing_date\": \"2020-03-01\",\n    \"issue_date\": \"2021-06-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details an enhanced braking system for bicycles, utilizing a novel cable tension mechanism to provide more responsive and reliable braking performance. It is designed for both road and mountain bikes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Previous braking system designs\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle braking system comprising...\",\n        \"A cable tensioning mechanism for a bicycle brake...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66024", "text": "{\n    \"patent_title\": \"System and Method for Personalized Recommendation Using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Sergey Brin\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Larry Page\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2008-03-15\",\n    \"filing_date\": \"2008-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for providing personalized recommendations to users based on machine learning algorithms. The system analyzes user data to identify patterns and predict user preferences, and then provides recommendations accordingly.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating personalized recommendations...\",\n        \"A system comprising a processor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66024", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Portable Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"California Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2007-05-10\",\n    \"filing_date\": \"2007-05-10\",\n    \"issue_date\": \"2015-11-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery design featuring enhanced energy density and improved cycle life for use in portable electronic devices. This battery utilizes a new electrolyte composition and a unique electrode structure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising an electrolyte...\",\n        \"An electrode structure for a battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66025", "text": "{\n    \"patent_title\": \"System for Automated Image Recognition Using Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-05-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system for automated image recognition using deep neural networks. The system employs convolutional neural networks to classify images with high accuracy, demonstrating advances in artificial intelligence applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in image processing.\"\n        }\n    ],\n    \"claims\": [\n        \"A system for automated image recognition comprising...\",\n        \"A method for training a neural network...\"\n    ]\n}"}
