{"_id": "Academic--patents--n--69733", "text": "{\n    \"patent_title\": \"Image Recognition System Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Visual Insights Corp.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-08-15\",\n    \"filing_date\": \"2017-08-15\",\n    \"issue_date\": \"2020-01-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An image recognition system utilizing deep learning techniques to identify objects within images. The system achieves high accuracy in object detection and classification.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"highly related - image processing\"\n        }\n    ],\n    \"claims\": [\n        \"An image recognition system comprising...\",\n        \"A method for object detection in images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69734", "text": "{\n    \"patent_title\": \"Method and system for generating personalized recommendations\",\n    \"inventors\": [\n        {\n            \"name\": \"Sergey Brin\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Larry Page\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for generating personalized recommendations based on user preferences and historical data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        },\n        {\n            \"patent_number\": \"US10234567B2\"\n        },\n        {\n            \"patent_number\": \"US11345678B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating personalized recommendations comprising...\",\n        \"A system for generating personalized recommendations...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69734", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2011-01-10\",\n    \"filing_date\": \"2011-01-10\",\n    \"issue_date\": \"2017-05-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery design improving energy density and lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        },\n        {\n            \"patent_number\": \"US8123456B2\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery comprising...\",\n        \"A method for manufacturing a battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69735", "text": "{\n    \"patent_title\": \"High-Capacity Lithium-Ion Battery with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a high-capacity lithium-ion battery with improved stability and cycle life. A novel electrolyte composition and electrode material are utilized to achieve superior performance characteristics. The battery is suitable for electric vehicles and portable electronic devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Highly Relevant\"\n        },\n        {\n            \"patent_number\": \"US8987654B2\",\n            \"relevance\": \"Relevant\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related\"\n        },\n        {\n            \"patent_number\": \"US9456789B2\",\n            \"relevance\": \"Related\"\n        },\n        {\n            \"patent_number\": \"US9789012B2\",\n            \"relevance\": \"Relevant\"\n        },\n        {\n            \"patent_number\": \"US10234567B2\",\n            \"relevance\": \"Highly Relevant\"\n        },\n        {\n            \"patent_number\": \"US11345678B2\",\n            \"relevance\": \"Related\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition for a lithium-ion battery...\",\n        \"A method of manufacturing a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69735", "text": "{\n    \"patent_title\": \"Improved Lead-Acid Battery Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Exide Technologies\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2011-05-10\",\n    \"filing_date\": \"2011-05-10\",\n    \"issue_date\": \"2017-02-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a new design for lead-acid batteries, enhancing their performance and lifespan through improved plate geometry and electrolyte management.  It addresses issues of sulfation and corrosion.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"relevance\": \"Highly Relevant\"\n        },\n        {\n            \"patent_number\": \"US7890123B1\",\n            \"relevance\": \"Relevant\"\n        }\n    ],\n    \"claims\": [\n        \"A lead-acid battery comprising...\",\n        \"A plate design for a lead-acid battery...\",\n        \"A method for reducing sulfation in a lead-acid battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69736", "text": "{\n    \"patent_title\": \"Neural Network Based Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2018-02-10\",\n    \"issue_date\": \"2020-05-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel system for image recognition utilizing a deep neural network architecture. The system achieves state-of-the-art accuracy on benchmark datasets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\",\n        \"A neural network architecture...\",\n        \"A computer-readable medium storing instructions...\",\n        \"A device for performing image recognition...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69736", "text": "{\n    \"patent_title\": \"Method for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2018-01-15\",\n    \"issue_date\": \"2019-11-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new method for compressing data using Huffman coding. This algorithm achieves a higher compression ratio compared to existing methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising...\",\n        \"A system for data compression comprising...\",\n        \"A data compression algorithm...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69737", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Electrolyte Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-10\",\n    \"filing_date\": \"2014-05-10\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to lithium-ion batteries with an improved electrolyte formulation that enhances stability and extends cycle life. The new electrolyte incorporates a novel additive to prevent dendrite formation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"relevance\": \"Similar electrolyte composition\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte formulation for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69737", "text": "{\n    \"patent_title\": \"Nickel-Metal Hydride Battery Improvements\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention focuses on improving the performance of nickel-metal hydride batteries by optimizing the electrode materials and cell design.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related electrode materials\"\n        }\n    ],\n    \"claims\": [\n        \"A nickel-metal hydride battery comprising...\",\n        \"An electrode structure for a nickel-metal hydride battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69738", "text": "{\n    \"patent_title\": \"Microfluidic Sensor with Enhanced Sensitivity\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2008-11-15\",\n    \"filing_date\": \"2009-05-20\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic sensor for detecting biomolecules with high sensitivity and specificity. The device integrates a novel detection mechanism and a microfluidic channel for efficient sample delivery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Similar microfluidic design\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic sensor comprising...\",\n        \"The sensor of claim 1, wherein...\",\n        \"A method for detecting...\",\n        \"The method of claim 3, wherein...\",\n        \"A system for analyzing...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69738", "text": "{\n    \"patent_title\": \"Wireless Communication System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2007-02-28\",\n    \"filing_date\": \"2008-08-10\",\n    \"issue_date\": \"2015-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless communication system utilizing advanced modulation techniques for improved data transmission rates.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related wireless communication technology\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication system...\",\n        \"The system of claim 1, wherein...\",\n        \"A method for transmitting data...\",\n        \"The method of claim 3, comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69739", "text": "{\n    \"patent_title\": \"Improved Electrolyte for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-07-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel electrolyte composition for lithium-ion batteries, enhancing their energy density and cycle life. The electrolyte incorporates a new additive that improves ionic conductivity and reduces dendrite formation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Lithium-ion Battery Separator\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrolyte composition...\",\n        \"The electrolyte composition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69739", "text": "{\n    \"patent_title\": \"Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Inc.\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-14\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) for electric vehicles, designed to optimize performance and safety. The BMS utilizes advanced algorithms for cell balancing and thermal management within a lithium-ion battery pack used in automotive applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Improved Electrolyte for Lithium-Ion Batteries\"\n        },\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Vehicle Battery Cooling System\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for an electric vehicle comprising...\",\n        \"The BMS utilizing algorithms for cell balancing...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69740", "text": "{\n    \"patent_title\": \"Miniaturized Electrochemical Sensor for Real-Time Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-14\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized electrochemical sensor for real-time glucose monitoring is disclosed. The sensor utilizes a novel enzyme-modified electrode and a wireless communication module for continuous glucose level detection and transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Glucose Sensor with Improved Stability\"\n        }\n    ],\n    \"claims\": [\n        \"A sensor comprising an enzyme-modified electrode.\",\n        \"The sensor of claim 1, further comprising a wireless communication module.\",\n        \"A method for detecting glucose levels using the sensor of claim 1.\",\n        \"The method of claim 3, wherein the glucose levels are transmitted wirelessly.\",\n        \"The sensor of claim 1, with a response time of less than 5 seconds.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69740", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2009-12-10\",\n    \"filing_date\": \"2009-12-09\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system is described, featuring enhanced charging and discharging algorithms for prolonged battery life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"title\": \"Battery Management System with Temperature Compensation\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising a charging controller.\",\n        \"The system of claim 1, further comprising a discharging controller.\",\n        \"A method for managing battery charging and discharging using the system of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69741", "text": "{\n    \"patent_title\": \"Method and System for Image Recognition Using Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for image recognition using deep neural networks. The system utilizes convolutional neural networks to analyze images and identify objects with high accuracy. The method involves training the neural network with a large dataset of labeled images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69741", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2019-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel algorithm for data compression that achieves higher compression ratios compared to existing methods. The algorithm utilizes Huffman coding and run-length encoding.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising...\",\n        \"A system for data compression comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69742", "text": "{\n    \"patent_title\": \"Wireless Power Transfer System and Method\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless power transfer system and method for efficiently charging electronic devices. The system utilizes resonant inductive coupling to transmit power wirelessly over a short distance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8759832B2\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless power transfer system comprising...\",\n        \"A method for wirelessly charging a device...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69742", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Google\"\n        },\n        {\n            \"name\": \"Eve Green\",\n            \"affiliation\": \"Apple\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new battery technology providing increased energy density and faster charging times for mobile devices. The new battery chemistry allows for significant improvements in performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising...\",\n        \"A method for manufacturing a battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69743", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for enhancing image recognition accuracy using deep learning algorithms, specifically convolutional neural networks. The system applies artificial intelligence techniques to process image data and identify objects with improved precision.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for processing image data using a convolutional neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69743", "text": "{\n    \"patent_title\": \"Automated Diagnostic System Using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"MedTech Solutions\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2023-05-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated diagnostic system utilizing machine learning algorithms to analyze medical images and detect anomalies. This system incorporates artificial intelligence to assist in the early diagnosis of diseases.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"type\": \"prior_art\"\n        },\n        {\n            \"patent_number\": \"US91234567B1\",\n            \"type\": \"medical_device\"\n        }\n    ],\n    \"claims\": [\n        \"A diagnostic system comprising...\",\n        \"A method for analyzing medical images using machine learning...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69744", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for image recognition using artificial intelligence and machine learning techniques. The system efficiently identifies objects within images with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for identifying objects in an image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69744", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Independent Inventor\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Cycling Dynamics Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved braking system for bicycles featuring enhanced stopping power and modulation. The system utilizes a novel cable tensioning mechanism and durable brake pads.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle braking system comprising...\",\n        \"A cable tensioning mechanism for bicycles...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69745", "text": "{\n    \"patent_title\": \"Method and System for Image Recognition using Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for image recognition utilizing deep neural networks. The system employs convolutional neural networks to analyze image data and identify objects with high accuracy. The method includes preprocessing, feature extraction, and classification stages.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The method of claim 1, wherein the neural network...\",\n        \"The system of claim 2, wherein the convolutional neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69745", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Independent Inventor\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2017-07-01\",\n    \"filing_date\": \"2017-07-01\",\n    \"issue_date\": \"2018-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved bicycle brake system offering enhanced stopping power and reliability. The system utilizes a novel cable tensioning mechanism and improved brake pad material.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A bicycle brake system comprising...\",\n        \"A cable tensioning mechanism for a bicycle brake...\",\n        \"A brake pad material for a bicycle brake...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69746", "text": "{\n    \"patent_title\": \"Deep Learning System for Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep learning system utilizing convolutional neural networks for improved image recognition accuracy. The system employs a novel architecture and training methodology to achieve state-of-the-art results.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Classification using Support Vector Machines\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising a convolutional neural network.\",\n        \"The system of claim 1, wherein the neural network has at least 10 layers.\",\n        \"A method for training a neural network for image recognition.\",\n        \"The method of claim 3, comprising backpropagation.\",\n        \"A computer-readable medium storing instructions for implementing the system of claim 1.\",\n        \"The computer-readable medium of claim 5, wherein the instructions are encoded in Python.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69746", "text": "{\n    \"patent_title\": \"Method for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"IBM\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-11-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel data compression algorithm utilizing Huffman coding and run-length encoding to achieve efficient data storage and transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Deep Learning System for Image Recognition\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data using Huffman coding.\",\n        \"The method of claim 1, further comprising run-length encoding.\",\n        \"A system for data compression implementing the method of claim 1.\",\n        \"A computer-readable medium storing instructions for the method of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69747", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Detail\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for enhancing the detail in digital images through advanced image processing techniques. The system utilizes a novel algorithm to improve contrast and reduce noise, resulting in clearer and more visually appealing images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Image Enhancement Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing the detail of a digital image, comprising...\",\n        \"A system for processing images, comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69747", "text": "{\n    \"patent_title\": \"Medical Image Reconstruction Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2012-03-10\",\n    \"filing_date\": \"2012-03-10\",\n    \"issue_date\": \"2018-11-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel technique for reconstructing medical images from raw data. It utilizes advanced image processing algorithms to produce high-resolution images for diagnostic purposes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Medical Image Processing System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing medical images, comprising...\",\n        \"A system for processing medical images, comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69748", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-11-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a miniaturized wireless pressure sensor system for biomedical applications. The system utilizes a novel MEMS pressure sensor and a low-power communication protocol.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in MEMS sensors\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising...\",\n        \"A method for measuring pressure using...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69748", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Jones\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Emily Smith\",\n            \"affiliation\": \"Caltech\"\n        }\n    ],\n    \"patent_number\": \"US11890123B2\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-01\",\n    \"issue_date\": \"2022-09-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a battery management system designed to optimize the performance and lifespan of lithium-ion batteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10543210B1\",\n            \"relevance\": \"Related to battery charging algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery performance...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69749", "text": "{\n    \"patent_title\": \"Method and System for Neural Network-Based Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for image recognition utilizing a deep neural network architecture. The system improves accuracy and efficiency in identifying objects within images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for image recognition...\",\n        \"2. A system comprising a neural network...\",\n        \"3. The method of claim 1, wherein...\",\n        \"4. The system of claim 2, wherein...\",\n        \"5. A computer-readable medium storing...\",\n        \"6. A method of training a neural network...\",\n        \"7. The method of claim 6, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69749", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-06-01\",\n    \"filing_date\": \"2019-11-20\",\n    \"issue_date\": \"2021-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An efficient algorithm for compressing data using a novel entropy encoding technique.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for data compression...\",\n        \"2. A system for implementing the method...\",\n        \"3. The method of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69750", "text": "{\n    \"patent_title\": \"Deep Learning System for Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep learning system for image recognition that utilizes convolutional neural networks to achieve state-of-the-art accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8474908B2\",\n            \"title\": \"System and method for generating images using a generative adversarial network\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69750", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2008-11-20\",\n    \"filing_date\": \"2008-11-20\",\n    \"issue_date\": \"2010-05-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel algorithm for data compression that achieves higher compression ratios than existing methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8474908B2\",\n            \"title\": \"System and method for generating images using a generative adversarial network\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising...\",\n        \"A system for data compression comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69751", "text": "{\n    \"patent_title\": \"Improved Electrolyte Composition for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel electrolyte composition for lithium-ion batteries, improving their energy density and cycle life. The composition utilizes a new lithium salt and solvent mixture.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"type\": \"related\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition consisting of...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69751", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Motors\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Ford Motor Company\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system designed for lithium-ion batteries in electric vehicles, focusing on thermal control and charge optimization.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"type\": \"cited by\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"type\": \"cited by\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for an electric vehicle...\",\n        \"A method for controlling the charge of a lithium-ion battery in an electric vehicle...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69752", "text": "{\n    \"patent_title\": \"Improved Electrolyte for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel electrolyte composition for lithium-ion batteries, enhancing their energy density and cycle life. The electrolyte contains a unique additive that improves ion conductivity and reduces dendrite formation, leading to safer and more efficient battery performance. This is applicable to energy storage in grid systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"title\": \"Lithium-Ion Battery with Enhanced Stability\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrolyte composition...\",\n        \"The electrolyte composition according to claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69752", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Motors\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Tesla Motors\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-14\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) for lithium-ion batteries used in electric vehicles. The BMS monitors and controls the battery's voltage, current, and temperature to optimize performance and ensure safety during operation. The system includes algorithms for state-of-charge estimation and cell balancing to extend battery life within automotive applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Advanced Battery Monitoring Techniques\"\n        },\n        {\n            \"patent_number\": \"US9123456B1\",\n            \"title\": \"Electric Vehicle Power Train Control\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for an electric vehicle comprising...\",\n        \"The battery management system according to claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69753", "text": "{\n    \"patent_title\": \"Wireless Sensor Network for Environmental Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless sensor network for monitoring environmental conditions such as temperature, humidity, and air quality. The system utilizes low-power sensors and a mesh network topology for reliable data transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8546789B1\",\n            \"field\": \"Environmental Science\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor network comprising a plurality of sensor nodes.\",\n        \"A method for monitoring environmental conditions using a wireless sensor network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69753", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor that wirelessly transmits data to an external device for monitoring blood glucose levels in diabetic patients.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"field\": \"Medical Device\"\n        },\n        {\n            \"patent_number\": \"US8901234B1\",\n            \"field\": \"Biomedical Engineering\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable glucose sensor comprising a sensing element and a wireless transmitter.\",\n        \"A method for monitoring blood glucose levels using an implantable sensor.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69754", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel electrode materials for lithium-ion batteries, enhancing energy density and cycle life. The materials comprise a composite structure with improved ionic conductivity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrode material...\",\n        \"A method for manufacturing...\",\n        \"The lithium-ion battery of claim 1...\",\n        \"The electrode material of claim 2...\",\n        \"The method of claim 3...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69754", "text": "{\n    \"patent_title\": \"Novel Polymer Electrolyte for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Caltech\"\n        }\n    ],\n    \"patent_number\": \"US11223344B2\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new polymer electrolyte for use in lithium-ion batteries, exhibiting high ionic conductivity and thermal stability.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A polymer electrolyte comprising...\",\n        \"A lithium-ion battery including...\",\n        \"A method for preparing...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69755", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2014-03-15\",\n    \"filing_date\": \"2015-05-20\",\n    \"issue_date\": \"2017-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel data compression system utilizing advanced algorithms to achieve higher compression ratios and faster processing speeds.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\"\n        },\n        {\n            \"patent_number\": \"US87654321B2\"\n        },\n        {\n            \"patent_number\": \"US76543210B1\"\n        },\n        {\n            \"patent_number\": \"US65432109B2\"\n        },\n        {\n            \"patent_number\": \"US54321098B1\"\n        },\n        {\n            \"patent_number\": \"US43210987B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data comprising...\",\n        \"A system for decompressing data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69755", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2016-04-01\",\n    \"filing_date\": \"2016-10-15\",\n    \"issue_date\": \"2018-06-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A bicycle brake system offering enhanced stopping power and improved safety features.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\"\n        },\n        {\n            \"patent_number\": \"US76543210B1\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle brake system comprising...\",\n        \"A braking mechanism for a bicycle...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69756", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized wireless pressure sensor system is presented. The system incorporates a novel MEMS pressure sensor and a low-power wireless communication module for remote data acquisition. This sensor is designed for biomedical applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising...\",\n        \"A method for remote pressure monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69756", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emily White\",\n            \"affiliation\": \"California Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system designed to optimize battery life and performance. The system incorporates advanced charging algorithms and temperature monitoring capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69757", "text": "{\n    \"patent_title\": \"Method and System for Image Enhancement using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing images using deep convolutional neural networks. The system learns to map low-resolution images to high-resolution images, improving visual quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760521B1\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        },\n        {\n            \"patent_number\": \"US9234567B1\"\n        },\n        {\n            \"patent_number\": \"US9345678B2\"\n        },\n        {\n            \"patent_number\": \"US9456789B1\"\n        },\n        {\n            \"patent_number\": \"US9567890B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image comprising...\",\n        \"A system for enhancing an image comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69757", "text": "{\n    \"patent_title\": \"Digital Image Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"David A. Ross\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US8901234B2\",\n    \"priority_date\": \"2015-02-15\",\n    \"filing_date\": \"2015-02-13\",\n    \"issue_date\": \"2018-05-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel digital image compression technique based on wavelet transforms and entropy coding. The method reduces image file size while maintaining acceptable image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        },\n        {\n            \"patent_number\": \"US8543210B2\"\n        },\n        {\n            \"patent_number\": \"US8654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a digital image comprising...\",\n        \"An apparatus for compressing a digital image comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69758", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for improved image recognition using deep learning algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Processing Techniques\"\n        },\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"title\": \"Machine Learning Algorithms\"\n        },\n        {\n            \"patent_number\": \"US9234567B1\",\n            \"title\": \"Convolutional Neural Networks\"\n        },\n        {\n            \"patent_number\": \"US9456789B2\",\n            \"title\": \"Data Analysis Methods\"\n        },\n        {\n            \"patent_number\": \"US9678901B1\",\n            \"title\": \"Pattern Recognition Systems\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for enhancing image recognition accuracy...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69758", "text": "{\n    \"patent_title\": \"Improved Battery Charging Circuit\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery charging circuit with increased efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B1\",\n            \"title\": \"Battery Technology\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Power Management Systems\"\n        },\n        {\n            \"patent_number\": \"US9345678B1\",\n            \"title\": \"Circuit Design\"\n        }\n    ],\n    \"claims\": [\n        \"A battery charging circuit...\",\n        \"A method for charging a battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69759", "text": "{\n    \"patent_title\": \"Method and System for Deep Learning-Based Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for image recognition using deep convolutional neural networks. The system is trained on a large dataset of labeled images and can accurately classify images into different categories.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8766804B2\",\n            \"relevance\": \"Prior art in convolutional neural networks\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising:\",\n        \"  receiving an input image;\",\n        \"  processing the image using a convolutional neural network;\",\n        \"  generating an output classification;\",\n        \"  displaying the output classification.\",\n        \"The method of claim 1, wherein the convolutional neural network comprises multiple layers.\",\n        \"The method of claim 2, wherein each layer comprises a plurality of filters.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69759", "text": "{\n    \"patent_title\": \"Improved Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2015-05-20\",\n    \"filing_date\": \"2016-05-20\",\n    \"issue_date\": \"2017-11-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved algorithm for compressing data, providing higher compression ratios with lower computational cost.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Previous work in data compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising:\",\n        \"  receiving input data;\",\n        \"  applying a compression algorithm to the data;\",\n        \"  outputting compressed data.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69760", "text": "{\n    \"patent_title\": \"Micro-Electromechanical Systems Based Pressure Sensor with Integrated Signal Conditioning\",\n    \"inventors\": [\n        {\n            \"name\": \"James A. Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice B. Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2008-05-15\",\n    \"filing_date\": \"2009-03-20\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a micro-electromechanical systems (MEMS) based pressure sensor with integrated signal conditioning circuitry. The sensor utilizes capacitive sensing and provides high sensitivity and accuracy. The application focuses on precise environmental sensor measurements.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A pressure sensor comprising...\",\n        \"A method for measuring pressure using...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69760", "text": "{\n    \"patent_title\": \"Wireless Communication System for Remote Data Acquisition\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert C. Williams\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emily D. Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2007-11-01\",\n    \"filing_date\": \"2008-07-10\",\n    \"issue_date\": \"2015-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a wireless communication system designed for remote data acquisition and transmission. The system employs low-power radio frequency technology and is suitable for various applications. Data is transferred securely and efficiently.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication system comprising...\",\n        \"A method for transmitting data remotely using...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69761", "text": "{\n    \"patent_title\": \"Microfluidic Device with Integrated Sensor\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device incorporating an integrated sensor for real-time analysis of fluid flow. The sensor provides accurate and reliable measurements of various parameters, enabling precise control and monitoring of microfluidic processes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising:...\",\n        \"The device of claim 1, further comprising:...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69761", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2009-12-01\",\n    \"filing_date\": \"2009-12-01\",\n    \"issue_date\": \"2017-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery design offering improved energy density and cycle life. The technology utilizes a new electrolyte material to enhance performance and stability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A battery comprising:...\",\n        \"The battery of claim 1, wherein:...\"\n    ]\n}"}
