{"_id": "Academic--patents--p--66680", "text": "{\n    \"patent_title\": \"Miniature Implantable Cardiac Monitor\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MedTech Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature implantable cardiac monitor for long-term heart rhythm monitoring.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Similar cardiac monitoring technology\"\n        }\n    ],\n    \"claims\": [\n        \"A miniature implantable cardiac monitor comprising...\",\n        \"A method for monitoring heart rhythm using said monitor...\",\n        \"A system for transmitting cardiac data...\",\n        \"The monitor having a battery life of at least 5 years...\",\n        \"The monitor capable of detecting atrial fibrillation...\",\n        \"The monitor providing real-time alerts...\"\n    ]\n}"}
