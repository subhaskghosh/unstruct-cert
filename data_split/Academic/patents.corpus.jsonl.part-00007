{"_id": "Academic--patents--p--66019", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2020-07-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to improved electrode materials for lithium-ion batteries, enhancing energy density and cycle life. The new material comprises a novel composite structure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrode material comprising...\",\n        \"The electrode material of claim 1, further comprising...\",\n        \"A lithium-ion battery cell including the electrode material...\",\n        \"A method of manufacturing the electrode material...\",\n        \"The method of claim 4, wherein...\",\n        \"A device powered by the lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66019", "text": "{\n    \"patent_title\": \"Novel Solar Cell Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2019-03-10\",\n    \"filing_date\": \"2019-03-10\",\n    \"issue_date\": \"2021-01-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new design for a high-efficiency solar cell. The design utilizes a unique light-trapping structure to improve performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A solar cell comprising...\",\n        \"The solar cell of claim 1, further comprising...\",\n        \"A method of manufacturing the solar cell...\",\n        \"A solar panel including the solar cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66020", "text": "{\n    \"patent_title\": \"System and Method for Dynamic Resource Allocation in Cloud Computing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2018-06-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for dynamically allocating resources in a cloud computing environment based on real-time demand and resource availability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for dynamically allocating resources in a cloud computing environment.\",\n        \"A system comprising a resource manager and a plurality of computing nodes.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66020", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Samsung Electronics\"\n        },\n        {\n            \"name\": \"Eve Davis\",\n            \"affiliation\": \"LG Corp\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-05-20\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery technology that provides increased energy density and improved lifespan for mobile devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising a novel electrolyte composition.\",\n        \"A mobile device powered by the battery cell.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66021", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-07-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for improving image recognition accuracy using deep neural networks. The system employs a novel training algorithm to enhance feature extraction and classification.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Similar approach to image processing.\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a deep neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66021", "text": "{\n    \"patent_title\": \"Improved Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system designed to optimize energy efficiency and prolong battery life in electric vehicles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related technology in battery control.\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling battery charge and discharge...\"\n    ]\n}"}
