{"_id": "Academic--patents--n--69325", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2009-11-01\",\n    \"filing_date\": \"2010-01-15\",\n    \"issue_date\": \"2017-02-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery design using new materials for enhanced energy density.\",\n    \"citations\": [],\n    \"claims\": [\n        \"Claim 1: A battery cell comprising...\",\n        \"Claim 2: A method for manufacturing...\",\n        \"Claim 3: A battery pack including...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69326", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Samuel Chen\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-14\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel electrode materials for lithium-ion batteries, enhancing energy density and cycle life. The materials comprise a modified lithium metal oxide composition with improved structural stability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Lithium-Ion Battery Separator\"\n        }\n    ],\n    \"claims\": [\n        \"1. A lithium-ion battery comprising an electrode...\",\n        \"2. The lithium-ion battery of claim 1, wherein the electrode...\",\n        \"3. An electrolyte for use in a lithium-ion battery...\",\n        \"4. The electrolyte of claim 3, further comprising...\",\n        \"5. A method of manufacturing a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69326", "text": "{\n    \"patent_title\": \"Novel Polymer Electrolyte for Solid-State Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2012-05-20\",\n    \"filing_date\": \"2012-05-18\",\n    \"issue_date\": \"2020-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new polymer electrolyte material designed for solid-state battery applications. The electrolyte exhibits high ionic conductivity and improved safety characteristics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Solid-State Electrolyte Composition\"\n        }\n    ],\n    \"claims\": [\n        \"1. A solid-state battery comprising a polymer electrolyte...\",\n        \"2. The solid-state battery of claim 1, wherein the polymer...\",\n        \"3. A method of fabricating a solid-state battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69327", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized wireless pressure sensor system is disclosed. The system utilizes MEMS technology for accurate pressure measurement and incorporates a low-power wireless communication module for data transmission. Applications include medical devices and industrial monitoring.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in MEMS pressure sensors\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for measuring pressure using a MEMS device...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69327", "text": "{\n    \"patent_title\": \"Advanced Image Processing Techniques\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"California Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9123456B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2018-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to advanced image processing techniques for enhancing image quality and object recognition. Algorithms are presented for noise reduction and feature extraction.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B1\",\n            \"relevance\": \"Related work in image enhancement\"\n        }\n    ],\n    \"claims\": [\n        \"An image processing system comprising...\",\n        \"A method for enhancing image quality...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69328", "text": "{\n    \"patent_title\": \"Novel Cathode Material for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel cathode material for lithium-ion batteries is disclosed, exhibiting improved energy density and cycle life. The material comprises a layered structure of lithium, nickel, manganese, and cobalt oxides with a specific stoichiometric ratio.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Electrolyte for Lithium-Ion Batteries\"\n        }\n    ],\n    \"claims\": [\n        \"A cathode material comprising...\",\n        \"A lithium-ion battery comprising said cathode material...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69328", "text": "{\n    \"patent_title\": \"Advanced Battery Management System for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Texas Instruments\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An advanced battery management system (BMS) for lithium-ion batteries is presented. The BMS includes sophisticated algorithms for state-of-charge estimation, thermal management, and fault diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Battery Management System with Cell Balancing\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Electrolyte for Lithium-Ion Batteries\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for managing a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69329", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to improved electrode materials for lithium-ion batteries, offering enhanced energy density and cycle life. The materials are based on a novel composite structure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Similar electrode material composition\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode material...\",\n        \"The electrode material according to claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69329", "text": "{\n    \"patent_title\": \"Advanced Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Eve Evans\",\n            \"affiliation\": \"Yale University\"\n        }\n    ],\n    \"patent_number\": \"US10246813B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-03-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery management system for optimizing the performance and safety of lithium-ion batteries. The system utilizes advanced algorithms for cell balancing and thermal control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related battery management techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising a cell balancing circuit...\",\n        \"The battery management system according to claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69330", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor for use in biomedical applications. The sensor utilizes a MEMS pressure transducer and a low-power Bluetooth transmitter to provide real-time pressure data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising...\",\n        \"A method for measuring pressure using the sensor...\"\n    ]\n}"}
