{"_id": "Academic--patents--p--66668", "text": "{\n    \"patent_title\": \"System and method for dynamic power management in wireless communication devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Qualcomm Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-03-15\",\n    \"filing_date\": \"2015-04-20\",\n    \"issue_date\": \"2019-07-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for dynamically managing power consumption in wireless communication devices by adjusting the transmission power based on channel conditions and device activity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Power Saving Mode for Mobile Devices\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Adaptive Power Control in Wireless Networks\"\n        },\n        {\n            \"patent_number\": \"US9543210B1\",\n            \"title\": \"Energy Efficient Communication Protocols\"\n        },\n        {\n            \"patent_number\": \"US8987654B2\",\n            \"title\": \"Wireless Power Transfer Techniques\"\n        },\n        {\n            \"patent_number\": \"US9210123B1\",\n            \"title\": \"Dynamic Voltage and Frequency Scaling\"\n        }\n    ],\n    \"claims\": [\n        \"A system for managing power in a wireless communication device...\",\n        \"A method for dynamically adjusting transmission power...\",\n        \"The system of claim 1, wherein the channel conditions are estimated based on signal-to-noise ratio.\"\n    ]\n}"}
