{"_id": "Academic--patents--p--66431", "text": "{\n    \"patent_title\": \"System and method for enhanced image processing using deep learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for enhancing image processing capabilities using deep learning algorithms. The system is designed to improve image clarity, reduce noise, and automatically identify objects within images. It includes a convolutional neural network trained on a large dataset of images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image enhancement method\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image processing comprising...\",\n        \"A method for enhancing image clarity...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66431", "text": "{\n    \"patent_title\": \"Method for efficient data compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"IBM\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new method for efficiently compressing digital data. The method utilizes a novel algorithm to reduce file sizes without significant loss of quality. It is applicable to various data types including text, images, and video.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Data Compression Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing digital data comprising...\",\n        \"A system for data compression utilizing a novel algorithm...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66432", "text": "{\n    \"patent_title\": \"Neural Network Architecture for Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-12-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel neural network architecture for improved image recognition accuracy. The network utilizes a unique combination of convolutional and recurrent layers, resulting in state-of-the-art performance on benchmark datasets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in convolutional neural networks\"\n        }\n    ],\n    \"claims\": [\n        \"A neural network comprising a convolutional layer and a recurrent layer.\",\n        \"The neural network of claim 1, wherein the convolutional layer...\",\n        \"The neural network of claim 2, wherein the recurrent layer...\",\n        \"A method for image recognition using the neural network of claim 1.\",\n        \"A system for image recognition utilizing the neural network of claim 4.\",\n        \"The system of claim 5, further comprising a display interface.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66432", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2021-01-01\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2022-09-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel battery management system designed to optimize energy efficiency and prolong battery life in electric vehicles. It incorporates advanced algorithms for monitoring and controlling battery parameters.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"Prior art in battery management systems\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising a monitoring module and a control module.\",\n        \"The battery management system of claim 1, wherein the monitoring module...\",\n        \"The battery management system of claim 2, wherein the control module...\",\n        \"A method for managing battery charge using the system of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66433", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery with Enhanced Thermal Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-04-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved lithium-ion battery with enhanced thermal stability and cycle life. The battery incorporates a novel electrolyte formulation and a modified electrode structure to prevent dendrite formation and improve overall performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Lithium-Ion Battery with Solid Electrolyte\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte formulation comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66433", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery Electrode Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-06-20\",\n    \"issue_date\": \"2019-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel electrode material for lithium-ion batteries offering improved energy density. This material is based on a new metal oxide composition.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"title\": \"Metal Oxide Cathode Material\"\n        }\n    ],\n    \"claims\": [\n        \"An electrode material comprising...\",\n        \"A metal oxide composition comprising...\"\n    ]\n}"}
