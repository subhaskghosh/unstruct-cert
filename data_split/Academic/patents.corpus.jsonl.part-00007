{"_id": "Academic--patents--p--66192", "text": "{\n    \"patent_title\": \"Miniature Pressure Sensor with Integrated Signal Conditioning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-12-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature pressure sensor is disclosed, incorporating integrated signal conditioning circuitry for improved accuracy and reliability. The sensor utilizes a MEMS diaphragm and is suitable for a variety of applications including medical devices and industrial monitoring. This innovative sensor design offers enhanced sensitivity and reduced power consumption.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related Art\"\n        }\n    ],\n    \"claims\": [\n        \"A pressure sensor comprising: a MEMS diaphragm...\",\n        \"The pressure sensor of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66192", "text": "{\n    \"patent_title\": \"Wireless Communication System for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-10\",\n    \"issue_date\": \"2021-08-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless communication system for mobile devices is disclosed, providing high-speed data transfer and reliable connectivity. The system utilizes advanced modulation techniques and error correction codes to ensure optimal performance. The technology improves battery life and data throughput.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related Art\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication system comprising: a transmitter...\",\n        \"The wireless communication system of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66193", "text": "{\n    \"patent_title\": \"Microfluidic Device for Cell Sorting\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2019-03-20\",\n    \"issue_date\": \"2021-07-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for high-throughput cell sorting based on size and deformability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for sorting cells using said device...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66193", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2018-09-05\",\n    \"issue_date\": \"2022-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler design with enhanced ergonomics for improved surgical precision.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"A method for using said stapler...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66194", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2015-03-15\",\n    \"filing_date\": \"2015-03-15\",\n    \"issue_date\": \"2018-06-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for industrial applications. The sensor utilizes MEMS technology and communicates via Bluetooth. It is designed for high accuracy and low power consumption.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Similar sensor technology\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising...\",\n        \"A MEMS device for pressure detection...\",\n        \"A communication module for transmitting sensor data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66194", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-05-20\",\n    \"filing_date\": \"2016-05-20\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor designed for continuous monitoring of blood sugar levels. The sensor utilizes enzymatic reactions and wireless communication to transmit data to a external receiver for analysis and diabetes management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Previous glucose sensor designs\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable glucose sensor comprising...\",\n        \"A biocompatible housing for the sensor...\",\n        \"A data transmission module for communicating with a medical device...\",\n        \"A method for diabetes management using the sensor data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66195", "text": "{\n    \"patent_title\": \"System and Method for Anomaly Detection Using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-01\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for detecting anomalies in data streams using machine learning algorithms. The system utilizes a recurrent neural network to identify patterns and predict future behavior, flagging deviations as anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for anomaly detection comprising...\",\n        \"2. The system of claim 1, wherein the machine learning algorithm is a recurrent neural network.\",\n        \"3. A method for anomaly detection...\",\n        \"4. The method of claim 3, further comprising...\",\n        \"5. The system of claim 1, wherein the data stream is financial data.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66195", "text": "{\n    \"patent_title\": \"Improved Image Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2021-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents an improved technique for image compression, achieving higher compression ratios with minimal loss of image quality. It builds upon existing JPEG standards.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for image compression comprising...\",\n        \"2. The method of claim 1, wherein the compression ratio is at least 2:1.\",\n        \"3. A system for image compression...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66196", "text": "{\n    \"patent_title\": \"System and Method for Image Recognition Using Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-06-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition using deep neural networks is disclosed. The system comprises a convolutional neural network trained to identify objects in images. This technology provides improved accuracy and speed in image recognition tasks.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for identifying objects in an image comprising:...\",\n        \"A system for image recognition comprising:...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66196", "text": "{\n    \"patent_title\": \"Advanced Control Systems for Robotic Arms\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10293847B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-12-01\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to advanced control systems for robotic arms, enabling precise and efficient manipulation of objects in complex environments. The system utilizes feedback loops and adaptive algorithms to improve performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A control system for a robotic arm comprising:...\",\n        \"A method for controlling a robotic arm comprising:...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66197", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Improved Electrolyte Composition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2021-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery featuring an improved electrolyte composition that enhances energy density and cycle life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art in electrolyte materials\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrolyte composition...\",\n        \"The lithium-ion battery of claim 1, wherein the electrolyte composition includes...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66197", "text": "{\n    \"patent_title\": \"Solar Panel Design with Enhanced Efficiency\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-15\",\n    \"issue_date\": \"2020-11-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved solar panel design featuring a novel light-trapping structure for increased energy conversion efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous work on light-trapping technologies\"\n        }\n    ],\n    \"claims\": [\n        \"A solar panel comprising a light-trapping structure...\",\n        \"The solar panel of claim 1, wherein the light-trapping structure is...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66198", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications. The system utilizes a MEMS pressure sensor and a low-power transceiver for remote data transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Similar sensor technology\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising a MEMS pressure sensor...\",\n        \"A method for remote monitoring of pressure using a wireless sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66198", "text": "{\n    \"patent_title\": \"Advanced Multi-Sensor Data Fusion Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        },\n        {\n            \"name\": \"Eve Foster\",\n            \"affiliation\": \"Georgia Tech\"\n        },\n        {\n            \"name\": \"Frank Garcia\",\n            \"affiliation\": \"Purdue University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This patent describes a novel data fusion algorithm for combining data from multiple sensors, including temperature, pressure, and humidity sensors. The algorithm improves accuracy and reliability of sensor measurements.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related data fusion techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A data fusion algorithm comprising...\",\n        \"A system for sensor data analysis...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66199", "text": "{\n    \"patent_title\": \"System and Method for Real-Time Anomaly Detection in Industrial Control Systems\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-15\",\n    \"filing_date\": \"2015-02-20\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for detecting anomalies in real-time within industrial control systems using machine learning algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related art\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for real-time anomaly detection...\",\n        \"2. The system of claim 1, comprising...\",\n        \"3. A method for detecting anomalies...\",\n        \"4. The method of claim 3, wherein...\",\n        \"5. The system of claim 1, further comprising...\",\n        \"6. The method of claim 3, further comprising...\",\n        \"7. A computer-readable medium storing...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66199", "text": "{\n    \"patent_title\": \"Improved Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-03-10\",\n    \"filing_date\": \"2016-09-01\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system designed to improve the efficiency and lifespan of batteries in electric vehicles.\",\n    \"citations\": [],\n    \"claims\": [\n        \"1. A battery management system comprising...\",\n        \"2. The system of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66200", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor continuously monitors glucose levels and wirelessly transmits data to an external device.  The sensor utilizes a novel enzyme-based electrochemical detection method.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art relating to glucose sensing.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for continuously monitoring glucose levels in a patient.\",\n        \"An implantable glucose sensor comprising an enzyme-based electrochemical detector.\",\n        \"A wireless communication module for transmitting glucose data.\",\n        \"A system for analyzing glucose data and providing alerts.\",\n        \"A device for calibrating the glucose sensor.\",\n        \"A method for improving the stability of the enzyme-based electrochemical detector.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66200", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Intuitive Surgical\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2021-01-05\",\n    \"filing_date\": \"2021-07-12\",\n    \"issue_date\": \"2022-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical stapler with an improved handle design for enhanced user comfort and control during surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related to surgical stapler mechanisms.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an improved handle design.\",\n        \"A handle with an ergonomic grip for enhanced user comfort.\",\n        \"A stapler with a force-limiting mechanism.\",\n        \"A stapler with a safety interlock.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66201", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery design with increased energy density and lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A battery comprising a novel electrode material.\",\n        \"A method for manufacturing the battery.\"\n    ]\n}"}
