{"_id": "Academic--patents--p--66567", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system and method for enhanced image recognition using deep convolutional neural networks. The system is capable of identifying objects and scenes with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"kind\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66567", "text": "{\n    \"patent_title\": \"Improved Object Detection Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-01\",\n    \"issue_date\": \"2023-05-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved algorithm for object detection in images. It builds upon existing techniques to achieve faster and more accurate results.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"kind\": \"cited\"\n        },\n        {\n            \"patent_number\": \"US10456789B1\",\n            \"kind\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"An object detection algorithm comprising...\",\n        \"A computer system implementing the algorithm...\"\n    ]\n}"}
