{"_id": "Academic--patents--p--66424", "text": "{\n    \"patent_title\": \"Enhanced Battery Life Method for Mobile Devices Using Dynamic Power Management\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Apple Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-12-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for dynamically adjusting power consumption in portable electronic devices to extend battery life. The method utilizes machine learning algorithms to predict user behavior and optimize power allocation to different components.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in power management\"\n        }\n    ],\n    \"claims\": [\n        \"A method for extending battery life in a portable electronic device, comprising: predicting user behavior using a machine learning algorithm; allocating power to device components based on the predicted user behavior; and dynamically adjusting power consumption based on the allocated power.\",\n        \"The method of claim 1, wherein the machine learning algorithm is a recurrent neural network.\",\n        \"The method of claim 1, wherein the portable electronic device is a smartphone.\",\n        \"The method of claim 1, wherein the power allocation is optimized to minimize energy consumption.\",\n        \"The method of claim 1, further comprising: monitoring battery level and adjusting power allocation accordingly.\",\n        \"A system for extending battery life in a portable electronic device, comprising a processor configured to execute the method of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66424", "text": "{\n    \"patent_title\": \"Wireless Charging System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Motors\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-09-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless charging system for electric vehicles using resonant inductive coupling. The system allows for efficient and convenient charging without the need for physical cables.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related to wireless power transfer\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless charging system for an electric vehicle, comprising: a transmitting coil configured to generate a magnetic field; a receiving coil in the electric vehicle configured to receive the magnetic field; and a power conversion circuit configured to convert the received magnetic energy into electrical energy.\",\n        \"The system of claim 1, wherein the transmitting coil and receiving coil operate at a resonant frequency.\",\n        \"The system of claim 1, further comprising a control system to optimize power transfer.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66425", "text": "{\n    \"patent_title\": \"System and Method for Dynamic Resource Allocation in Cloud Computing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-15\",\n    \"filing_date\": \"2015-03-10\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for dynamically allocating resources in a cloud computing environment based on real-time demand and predictive modeling.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method comprising...\",\n        \"A system comprising...\"\n    ]\n}"}
