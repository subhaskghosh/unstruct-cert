{"_id": "Academic--patents--p--66266", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-12-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for improved image recognition using deep convolutional neural networks. The system incorporates attention mechanisms to focus on relevant features within an image, enhancing accuracy and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Convolutional Neural Networks for Image Classification\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Attention Mechanisms in Deep Learning\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising a convolutional neural network...\",\n        \"A method for enhancing image recognition accuracy...\"\n    ]\n}"}
