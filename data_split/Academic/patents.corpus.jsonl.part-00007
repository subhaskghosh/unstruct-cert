{"_id": "Academic--patents--n--66168", "text": "{\n    \"patent_title\": \"Advanced Solar Panel Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Caltech\"\n        },\n        {\n            \"name\": \"Peter Jones\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-06-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new design for solar panels with increased energy conversion efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10112233B2\",\n            \"relevance\": \"Related to solar energy harvesting\"\n        }\n    ],\n    \"claims\": [\n        \"A solar panel design including...\",\n        \"The design of claim 1, characterized by...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66169", "text": "{\n    \"patent_title\": \"Neural Network Architecture for Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2018-03-01\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel neural network architecture for improved image recognition accuracy. The network utilizes a convolutional layer followed by a recurrent neural network to process image data, enhancing feature extraction and classification.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A neural network comprising a convolutional layer.\",\n        \"The neural network of claim 1, further comprising a recurrent neural network.\",\n        \"A method for image recognition using the neural network of claim 1.\",\n        \"The method of claim 3, wherein the image recognition accuracy is improved.\",\n        \"A system for image processing comprising the neural network of claim 1.\",\n        \"The system of claim 5, adapted to identify objects in real-time.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66169", "text": "{\n    \"patent_title\": \"Improved Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"IBM Research\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2018-02-15\",\n    \"issue_date\": \"2019-09-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new data compression algorithm that achieves higher compression ratios with lower computational complexity. It utilizes a combination of Huffman coding and Lempel-Ziv techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A data compression method comprising Huffman coding.\",\n        \"The data compression method of claim 1, further comprising Lempel-Ziv coding.\",\n        \"A system for data storage utilizing the data compression method of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66170", "text": "{\n    \"patent_title\": \"Method for Enhanced Drug Delivery Using Nanoparticles\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for delivering drugs using nanoparticles to improve efficacy and reduce side effects.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method comprising...\",\n        \"The method of claim 1, wherein...\"\n    ]\n}"}
