{"_id": "Academic--patents--p--66630", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Predictive Maintenance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Data Solutions Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-01-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for predictive maintenance using artificial intelligence techniques. The system analyzes sensor data to predict equipment failures, reducing downtime and maintenance costs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predictive maintenance comprising...\",\n        \"A method for analyzing sensor data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66630", "text": "{\n    \"patent_title\": \"Improved Battery Charging Circuit\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Energy Corp.\"\n        }\n    ],\n    \"patent_number\": \"US9123456B1\",\n    \"priority_date\": \"2015-05-20\",\n    \"filing_date\": \"2015-05-20\",\n    \"issue_date\": \"2017-09-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents an improved battery charging circuit with enhanced efficiency and reduced heat dissipation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A battery charging circuit comprising...\",\n        \"A method for regulating voltage...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66631", "text": "{\n    \"patent_title\": \"System and Method for Object Recognition in Video Streams\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"TechCorp Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2018-06-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for real-time object recognition in video streams utilizing convolutional neural networks. This invention improves accuracy in identifying objects in dynamic environments, such as autonomous vehicles and surveillance systems. The method includes pre-processing of video frames, feature extraction, and classification using a trained model. This is not related to medical image analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in feature extraction\"\n        }\n    ],\n    \"claims\": [\n        \"A system for object recognition comprising...\",\n        \"A method for processing video streams...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66631", "text": "{\n    \"patent_title\": \"Medical Image Analysis System Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"HealthTech Solutions\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Mayo Clinic\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for analyzing medical images, specifically X-rays and CT scans, using deep learning algorithms to detect anomalies and assist in diagnosis. The system employs convolutional neural networks to identify regions of interest and provide quantitative measurements. This invention utilizes image recognition techniques applied to medical imagery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Prior art in medical image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A system for medical image analysis comprising...\",\n        \"A method for detecting anomalies in medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66632", "text": "{\n    \"patent_title\": \"System and method for enhanced image recognition using deep learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-10\",\n    \"filing_date\": \"2015-03-15\",\n    \"issue_date\": \"2019-02-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing image recognition accuracy using deep convolutional neural networks. The system employs a novel training algorithm and architecture to improve performance on challenging image datasets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for image recognition comprising...\",\n        \"2. The system of claim 1, wherein...\",\n        \"3. A method for training an image recognition model...\",\n        \"4. The method of claim 3, wherein...\",\n        \"5. A computer-readable medium storing...\",\n        \"6. The computer-readable medium of claim 5, wherein...\",\n        \"7. The system of claim 1, further comprising...\"\n    ]\n}"}
