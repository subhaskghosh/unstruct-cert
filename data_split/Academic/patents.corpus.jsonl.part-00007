{"_id": "Academic--patents--p--69656", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2018-04-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications. The system comprises a MEMS pressure sensor, a low-power transceiver, and a battery. This sensor is used for continuous blood pressure monitoring.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"The system of claim 1, wherein the sensor is a MEMS device.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69656", "text": "{\n    \"patent_title\": \"Improved Battery Life for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9123456B1\",\n    \"priority_date\": \"2009-11-01\",\n    \"filing_date\": \"2009-11-01\",\n    \"issue_date\": \"2017-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to methods for extending battery life in mobile electronic devices by optimizing power consumption.  The system includes a processor and memory.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for extending battery life comprising...\",\n        \"The method of claim 1, wherein power consumption is reduced by...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69657", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to novel electrode materials for lithium-ion batteries, exhibiting enhanced energy density and cycle life. The materials comprise a unique nanostructure that improves ion transport and reduces degradation.\",\n    \"citations\": [\n        {\n            \"title\": \"High-Performance Anode Materials\",\n            \"patent_number\": \"US8652412B2\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode material...\",\n        \"The electrode material according to claim 1, wherein the nanostructure comprises...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69657", "text": "{\n    \"patent_title\": \"Advanced Battery Management System for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Texas Instruments\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel battery management system (BMS) for lithium-ion batteries, providing improved safety and performance monitoring. The system utilizes advanced algorithms for cell balancing and fault detection.\",\n    \"citations\": [\n        {\n            \"title\": \"Lithium-Ion Battery Cell Balancing Techniques\",\n            \"patent_number\": \"US9123456B2\"\n        },\n        {\n            \"title\": \"Battery Management System Control Algorithms\",\n            \"patent_number\": \"US8789012B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for a lithium-ion battery...\",\n        \"The battery management system according to claim 1, comprising a cell balancing circuit...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69658", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2019-04-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system is disclosed. The system comprises a pressure sensor, a wireless communication module, and a power supply. The sensor is used for monitoring pressure in various applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A pressure sensor system comprising...\",\n        \"A wireless communication module configured to transmit...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69658", "text": "{\n    \"patent_title\": \"Advanced Data Encryption Method\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Jones\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Emily White\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"patent_number\": \"US11890123B2\",\n    \"priority_date\": \"2019-01-20\",\n    \"filing_date\": \"2019-01-20\",\n    \"issue_date\": \"2020-11-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel data encryption method is presented, utilizing complex algorithms to secure sensitive information. The method improves data security and confidentiality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for encrypting data comprising...\",\n        \"An encryption algorithm configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69659", "text": "{\n    \"patent_title\": \"Advanced Microfluidic Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel microfluidic sensor system for detecting biological agents. The system utilizes a network of microchannels and integrated sensors for rapid and accurate analysis. It provides significantly improved sensitivity and specificity compared to existing technologies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic sensor system comprising...\",\n        \"The sensor system of claim 1, wherein...\",\n        \"A method for detecting a biological agent...\",\n        \"The method of claim 3, wherein...\",\n        \"The system of claim 1 further comprising...\",\n        \"The method of claim 3 further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69659", "text": "{\n    \"patent_title\": \"Novel Method for Sensor Calibration\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new method for calibrating sensors is presented. This method utilizes a feedback loop and machine learning algorithms to optimize sensor performance. The invention addresses the problem of sensor drift and provides improved accuracy over time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for calibrating a sensor comprising...\",\n        \"The method of claim 1, wherein...\",\n        \"A system for implementing the method...\",\n        \"The system of claim 3, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69660", "text": "{\n    \"patent_title\": \"Method and System for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for image recognition using artificial intelligence and deep learning techniques. The system is capable of accurately identifying objects in images with high precision and speed.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69660", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-08-20\",\n    \"filing_date\": \"2017-08-20\",\n    \"issue_date\": \"2019-06-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles, focusing on thermal regulation and lifespan extension. This system utilizes advanced algorithms for optimal charging and discharging cycles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for thermal regulation in a battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69661", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-10-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for enhancing the resolution of digital images using a deep learning model. The model is trained on a large dataset of high-resolution images and is capable of accurately reconstructing fine details in low-resolution images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Super-Resolution using Convolutional Neural Networks\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Deep Learning for Image Recognition\"\n        },\n        {\n            \"patent_number\": \"US11000001B2\",\n            \"title\": \"Generative Adversarial Networks for Image Synthesis\"\n        },\n        {\n            \"patent_number\": \"US10500500B2\",\n            \"title\": \"Attention Mechanisms in Neural Networks\"\n        },\n        {\n            \"patent_number\": \"US11300300B2\",\n            \"title\": \"Image Denoising using Deep Convolutional Networks\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing the resolution of a digital image...\",\n        \"A system comprising a deep learning model...\",\n        \"The method of claim 1, wherein the deep learning model is a convolutional neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69661", "text": "{\n    \"patent_title\": \"Novel Image Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11456789B1\",\n    \"priority_date\": \"2021-01-05\",\n    \"filing_date\": \"2021-03-10\",\n    \"issue_date\": \"2023-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a new image compression technique based on wavelet transforms. It achieves high compression ratios while maintaining acceptable image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Wavelet-Based Image Compression\"\n        },\n        {\n            \"patent_number\": \"US9654321B1\",\n            \"title\": \"Lossy Image Compression Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a digital image...\",\n        \"A system for encoding and decoding compressed images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69662", "text": "{\n    \"patent_title\": \"Neural Network Based Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-14\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image recognition system utilizing a deep neural network architecture is presented. This system improves accuracy and efficiency in identifying objects within images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition using a neural network.\",\n        \"A system for processing images using a deep learning algorithm.\",\n        \"A computer-readable medium storing instructions for performing image recognition.\",\n        \"The method of claim 1, wherein the neural network is a convolutional neural network.\",\n        \"The system of claim 2, wherein the deep learning algorithm is trained on a large dataset of images.\",\n        \"The method of claim 1 further comprising preprocessing the image before inputting it to the neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69662", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corp\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2012-05-20\",\n    \"filing_date\": \"2012-05-19\",\n    \"issue_date\": \"2018-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This patent describes an improved algorithm for lossless data compression, significantly reducing file sizes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression.\",\n        \"A system for compressing data.\",\n        \"A computer-readable medium storing instructions for data compression.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69663", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2021-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the resolution of digital images using deep convolutional neural networks. The system learns a mapping function to upscale images while preserving details.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"title\": \"Image Super-Resolution using Convolutional Neural Networks\"\n        },\n        {\n            \"patent_number\": \"US1012345678B2\",\n            \"title\": \"Generative Adversarial Networks for Image Synthesis\"\n        },\n        {\n            \"patent_number\": \"US1122334455B2\",\n            \"title\": \"Deep Residual Learning for Image Recognition\"\n        },\n        {\n            \"patent_number\": \"US1233445566B2\",\n            \"title\": \"Attention Mechanisms in Neural Networks\"\n        },\n        {\n            \"patent_number\": \"US1344556677B2\",\n            \"title\": \"Image Processing Techniques for Medical Imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution...\",\n        \"A system comprising a deep neural network...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69663", "text": "{\n    \"patent_title\": \"Improved Algorithm for Audio Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2019-07-01\",\n    \"filing_date\": \"2019-09-10\",\n    \"issue_date\": \"2020-12-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel algorithm for compressing digital audio signals, reducing file size without significant loss of quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"title\": \"Data Compression Techniques\"\n        },\n        {\n            \"patent_number\": \"US96543210B2\",\n            \"title\": \"Audio Encoding Standards\"\n        },\n        {\n            \"patent_number\": \"US105432198B2\",\n            \"title\": \"Signal Processing Methods\"\n        }\n    ],\n    \"claims\": [\n        \"An algorithm for compressing audio data...\",\n        \"A system for encoding audio signals...\",\n        \"A method for reducing audio file size...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69664", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2020-06-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications. The system incorporates a low-power sensor and a wireless communication module.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A pressure sensor system comprising...\",\n        \"A wireless communication module...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69664", "text": "{\n    \"patent_title\": \"Advanced Image Processing for Medical Diagnostics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Eve Green\",\n            \"affiliation\": \"Johns Hopkins University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2021-05-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to advanced image processing techniques for enhancing the accuracy of medical diagnostics.  It utilizes novel algorithms for noise reduction and feature extraction.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image processing comprising...\",\n        \"A system for medical diagnostics...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69665", "text": "{\n    \"patent_title\": \"High-Performance Lithium-Ion Battery with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel lithium-ion battery design featuring a modified electrolyte composition and a unique electrode structure, resulting in enhanced stability and increased energy density.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in electrolyte composition\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"The battery of claim 1, wherein...\",\n        \"An electrolyte composition for a lithium-ion battery...\",\n        \"A method of manufacturing a lithium-ion battery...\",\n        \"The method of claim 4, further comprising...\",\n        \"The battery of claim 1, wherein the electrolyte...\",\n        \"An electrode structure for a lithium-ion battery...\",\n        \"The electrode structure of claim 7, comprising...\",\n        \"A system incorporating the lithium-ion battery...\",\n        \"The system of claim 9, wherein the system...\",\n        \"The battery of claim 1, having a capacity greater than 2000 mAh.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69665", "text": "{\n    \"patent_title\": \"Improved Sodium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel electrode materials for sodium-ion batteries, exhibiting high capacity and cycle life. The materials are based on layered oxides and polyanionic compounds.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related sodium-ion battery technology\"\n        }\n    ],\n    \"claims\": [\n        \"A sodium-ion battery electrode material comprising...\",\n        \"The electrode material of claim 1, wherein...\",\n        \"A sodium-ion battery comprising the electrode material...\",\n        \"A method of preparing the electrode material...\",\n        \"The method of claim 4, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69666", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Pressure Sensor for Intracranial Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized wireless pressure sensor is disclosed for intracranial monitoring. The sensor utilizes MEMS technology and a biocompatible coating, providing real-time pressure data for diagnosing and treating neurological conditions. It is particularly suited for use in medical devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"cited_by\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising...\",\n        \"A method for intracranial pressure monitoring using the sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69666", "text": "{\n    \"patent_title\": \"Improved Automotive Radar Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Motors\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved radar sensor system for automotive applications is disclosed, enhancing object detection and collision avoidance capabilities. The system employs advanced signal processing techniques to improve accuracy and reliability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"kind\": \"cited_by\"\n        }\n    ],\n    \"claims\": [\n        \"A radar sensor system for automotive vehicles comprising...\",\n        \"A method for object detection using the radar sensor system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69667", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications. The system comprises a MEMS pressure sensor, a low-power transceiver, and a biocompatible package.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising...\",\n        \"A method for measuring pressure using the sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69667", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-11-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery with increased energy density and lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Cited as Background Art\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery characterized by...\",\n        \"A method for manufacturing the battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69668", "text": "{\n    \"patent_title\": \"System and Method for Personalized Recommendations Using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for providing personalized recommendations to users based on machine learning algorithms. The system analyzes user behavior and preferences to identify items of interest.  This utilizes artificial intelligence to improve recommendation accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating personalized recommendations comprising:...\",\n        \"A system for implementing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69668", "text": "{\n    \"patent_title\": \"Implantable Medical Device with AI-Powered Diagnostics\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"MedTech Solutions\"\n        }\n    ],\n    \"patent_number\": \"US11334455B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2021-02-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable medical device utilizing artificial intelligence for real-time diagnostics and treatment monitoring. This device analyzes physiological data and adjusts treatment parameters automatically.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable medical device comprising:...\",\n        \"A diagnostic system utilizing artificial intelligence...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69669", "text": "{\n    \"patent_title\": \"Improved Electrolyte Composition for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel electrolyte composition for lithium-ion batteries, enhancing their energy density and cycle life. The electrolyte includes a new additive that improves ion conductivity and reduces dendrite formation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrolyte composition...\",\n        \"The electrolyte composition comprising a novel additive...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69669", "text": "{\n    \"patent_title\": \"Advanced Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla, Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-10\",\n    \"filing_date\": \"2017-03-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a battery management system (BMS) for electric vehicles, optimized for lithium-ion battery packs. The BMS improves safety and extends battery life through advanced algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for an electric vehicle...\",\n        \"The system comprising algorithms for charge control...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69670", "text": "{\n    \"patent_title\": \"System and Method for Personalized Recommendation Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10500000B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-06-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for providing personalized recommendations to users based on their past behavior and preferences using deep learning algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Collaborative Filtering System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating recommendations comprising: receiving user data; applying a deep learning model to the user data; and generating a personalized recommendation.\",\n        \"The method of claim 1, wherein the deep learning model is a neural network.\",\n        \"The method of claim 1, wherein the user data comprises purchase history.\",\n        \"The method of claim 1, wherein the user data comprises browsing history.\",\n        \"The method of claim 1, further comprising displaying the personalized recommendation to the user.\",\n        \"The method of claim 1, wherein the deep learning model is trained on a large dataset of user data.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69670", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Independent Inventor\"\n        }\n    ],\n    \"patent_number\": \"US8999999B1\",\n    \"priority_date\": \"2015-02-10\",\n    \"filing_date\": \"2015-02-10\",\n    \"issue_date\": \"2017-05-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved braking system for bicycles utilizing a novel cable tensioning mechanism.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A bicycle braking system comprising: a brake lever; a cable connected to the brake lever; and a brake caliper connected to the cable.\",\n        \"The bicycle braking system of claim 1, wherein the cable tensioning mechanism comprises a spring.\",\n        \"The bicycle braking system of claim 1, wherein the brake caliper is a disc brake.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69671", "text": "{\n    \"patent_title\": \"Advanced Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Tesla, Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an advanced battery management system (BMS) for electric vehicles, improving battery life and safety through optimized charging and discharging algorithms. The system utilizes predictive analytics to anticipate battery degradation and adjust operational parameters accordingly.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Battery Monitoring System\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery performance...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69671", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Design\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2022-12-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery design with enhanced energy density and cycle life. The battery utilizes a new electrode material and electrolyte composition to improve performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Electrolyte Composition for Lithium-Ion Batteries\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrode material for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69672", "text": "{\n    \"patent_title\": \"System and method for personalized recommendations using artificial intelligence\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2018-02-10\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for providing personalized recommendations to users based on their past behavior and preferences, leveraging artificial intelligence techniques such as machine learning and deep neural networks.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for providing personalized recommendations comprising...\",\n        \"A method for training a machine learning model...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69672", "text": "{\n    \"patent_title\": \"Improved Method for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2017-08-01\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents an enhanced method for lossless data compression, achieving higher compression ratios compared to existing algorithms. It utilizes a novel entropy encoding scheme.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data comprising...\",\n        \"A system for encoding data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69673", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Processing Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2014-06-15\",\n    \"filing_date\": \"2015-03-10\",\n    \"issue_date\": \"2017-09-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for enhancing image processing capabilities using deep learning techniques. The system utilizes convolutional neural networks to improve image resolution, reduce noise, and perform object recognition with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Similar image processing techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising...\",\n        \"A system for object recognition using a convolutional neural network...\",\n        \"The system of claim 1, wherein the convolutional neural network is trained on a large dataset of images.\",\n        \"The method of claim 1, further comprising a noise reduction step.\",\n        \"A computer-readable medium storing instructions for performing the method of claim 1.\",\n        \"An apparatus comprising a processor configured to execute the method of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69673", "text": "{\n    \"patent_title\": \"Digital Image Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"IBM Research\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2009-12-01\",\n    \"filing_date\": \"2010-05-15\",\n    \"issue_date\": \"2013-02-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new digital image compression technique that reduces file size while maintaining acceptable image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related image compression methods\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a digital image comprising...\",\n        \"A system for decompressing a digital image...\",\n        \"The method of claim 1, wherein the compression ratio is adjustable.\",\n        \"An apparatus for performing image compression.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69674", "text": "{\n    \"patent_title\": \"Improved Electrode Material for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel electrode material for lithium-ion batteries, enhancing energy density and cycle life. The material comprises a modified lithium metal oxide with improved structural stability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Lithium Metal Oxide Composition\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode material...\",\n        \"The electrode material of claim 1, wherein the material comprises a lithium metal oxide...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69674", "text": "{\n    \"patent_title\": \"Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11123456B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) for electric vehicles, including advanced algorithms for cell balancing and thermal management to improve lithium-ion battery performance and safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Cell Balancing Techniques for Lithium-Ion Batteries\"\n        },\n        {\n            \"patent_number\": \"US10987654B1\",\n            \"title\": \"Thermal Management System for Battery Packs\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Battery Management Systems Overview\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"The battery management system of claim 1, further comprising a cell balancing circuit...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69675", "text": "{\n    \"patent_title\": \"Neural Network Architecture for Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-09-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel neural network architecture designed for highly accurate image recognition. The network utilizes a deep convolutional structure with attention mechanisms to improve performance on challenging datasets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Convolutional Neural Networks\"\n        }\n    ],\n    \"claims\": [\n        \"A neural network comprising...\",\n        \"The neural network of claim 1, wherein...\",\n        \"A method for image recognition...\",\n        \"The method of claim 3, further comprising...\",\n        \"A system for implementing the method of claim 3.\",\n        \"The system of claim 5, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69675", "text": "{\n    \"patent_title\": \"Data Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11789012B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2021-10-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new data compression algorithm that significantly reduces file sizes. The technique is based on Huffman coding and run-length encoding.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Huffman Coding Methods\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data...\",\n        \"The method of claim 1, wherein...\",\n        \"A system for compressing data...\",\n        \"The system of claim 3, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69676", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-03-15\",\n    \"filing_date\": \"2014-09-20\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel electrode materials for lithium-ion batteries with enhanced energy density and cycle life. The materials comprise a unique composite structure that improves ion transport and reduces degradation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8216789B2\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode material...\",\n        \"The electrode material according to claim 1, wherein the composite structure...\",\n        \"A method of manufacturing a lithium-ion battery...\",\n        \"The method according to claim 3, wherein the composite structure...\",\n        \"An electrolyte composition for use in a lithium-ion battery...\",\n        \"The electrolyte composition according to claim 5...\",\n        \"A device powered by a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69676", "text": "{\n    \"patent_title\": \"Novel Polymer Electrolyte for Lithium Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2009-11-01\",\n    \"filing_date\": \"2010-05-10\",\n    \"issue_date\": \"2018-06-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new polymer electrolyte is described for use in lithium batteries, exhibiting high ionic conductivity and improved safety characteristics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7541234B2\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A polymer electrolyte comprising...\",\n        \"The polymer electrolyte according to claim 1, wherein...\",\n        \"A lithium battery comprising the polymer electrolyte...\",\n        \"A method of fabricating a lithium battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69677", "text": "{\n    \"patent_title\": \"Deep Learning Architecture for Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture utilizing convolutional neural networks for accurate image recognition. The system achieves state-of-the-art results on benchmark datasets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in convolutional neural networks.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"An apparatus for image recognition...\",\n        \"A system for training a neural network...\",\n        \"The system of claim 1, wherein the neural network...\",\n        \"The method of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69677", "text": "{\n    \"patent_title\": \"Wireless Communication System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Qualcomm\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-08-04\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless communication system with improved signal processing techniques for increased data throughput.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related to signal processing.\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication device comprising...\",\n        \"A method for transmitting data...\",\n        \"A system for receiving signals...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69678", "text": "{\n    \"patent_title\": \"System and Method for Intelligent Data Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for intelligent data analysis using artificial intelligence techniques, specifically focusing on pattern recognition and anomaly detection in large datasets. The system is applicable to various fields including finance and cybersecurity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Data Mining Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A system for intelligent data analysis comprising...\",\n        \"A method for identifying anomalies in a dataset...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69678", "text": "{\n    \"patent_title\": \"Medical Diagnostic Device with AI Assistance\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Medical Tech Corp.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-02-15\",\n    \"filing_date\": \"2017-02-15\",\n    \"issue_date\": \"2019-04-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A medical diagnostic device utilizing artificial intelligence algorithms to analyze medical images and assist physicians in diagnosing diseases. The device improves accuracy and speed of diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"title\": \"Medical Imaging System\"\n        },\n        {\n            \"patent_number\": \"US9123456B1\",\n            \"title\": \"AI-Powered Diagnostic Tool\"\n        }\n    ],\n    \"claims\": [\n        \"A medical diagnostic device comprising...\",\n        \"A method for analyzing medical images using AI...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69679", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery Electrode Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel lithium-ion battery electrode material with improved energy density and cycle life. The material comprises a composite of lithium metal oxide and a conductive polymer.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Lithium Metal Anode\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrode comprising...\",\n        \"A method for manufacturing the electrode...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69679", "text": "{\n    \"patent_title\": \"Battery Management System for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Texas Instruments\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-10\",\n    \"filing_date\": \"2017-03-10\",\n    \"issue_date\": \"2020-04-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a battery management system (BMS) designed to monitor and control lithium-ion battery packs. The BMS includes voltage, current, and temperature sensing circuits.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Lithium-Ion Battery Cell\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Battery Balancing Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for balancing the voltage of battery cells...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69680", "text": "{\n    \"patent_title\": \"Method and System for Adaptive Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for adaptive machine learning that utilizes reinforcement learning to optimize model parameters. The system incorporates artificial intelligence algorithms to dynamically adjust learning rates and feature selection based on real-time performance metrics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Deep Learning Architecture\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for adaptive machine learning comprising...\",\n        \"2. A system for implementing the method of claim 1...\",\n        \"3. The method of claim 1, wherein...\",\n        \"4. The system of claim 2, further comprising...\",\n        \"5. A computer-readable medium storing...\",\n        \"6. The method of claim 1, wherein the artificial intelligence algorithms include...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69680", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2021-01-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system utilizing advanced control algorithms for optimizing battery life and performance in electric vehicles. This system enhances charging efficiency and prevents overcharging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Lithium-Ion Battery Protection Circuit\"\n        }\n    ],\n    \"claims\": [\n        \"1. A battery management system comprising...\",\n        \"2. The system of claim 1, wherein...\",\n        \"3. A method for controlling charging...\",\n        \"4. The method of claim 3, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69681", "text": "{\n    \"patent_title\": \"Miniaturized Optical Sensor for Biomedical Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized optical sensor is described for detecting biomarkers in biological fluids. The sensor utilizes a novel plasmonic structure to enhance sensitivity and is suitable for point-of-care diagnostics. The sensor's small size and low power consumption make it ideal for wearable applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A sensor comprising...\",\n        \"A method of detecting...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69681", "text": "{\n    \"patent_title\": \"Improved Chemical Sensor Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-02-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel chemical sensor for detecting gaseous compounds. The sensor utilizes a new material with high selectivity and sensitivity. It is intended for environmental monitoring and industrial safety applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Relevant prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A chemical sensor comprising...\",\n        \"A method for detecting...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69682", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Processing Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10500000B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-12-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method and system for enhancing image quality using deep learning techniques. The system utilizes convolutional neural networks to reduce noise and improve image resolution, resulting in clearer and more detailed images. Applications include medical imaging, satellite imagery, and consumer photography. The core of the invention lies in a new loss function that optimizes for perceptual quality, rather than pixel-wise error.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Enhancement Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for enhancing an image...\",\n        \"2. The method of claim 1, wherein the deep learning model comprises a convolutional neural network...\",\n        \"3. A system for enhancing an image...\",\n        \"4. The system of claim 3, wherein the loss function optimizes for perceptual quality...\",\n        \"5. The method of claim 1, further comprising a pre-processing step...\",\n        \"6. The system of claim 3, wherein the image source is a medical imaging device...\",\n        \"7. The method of claim 1, further comprising a post-processing step...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69682", "text": "{\n    \"patent_title\": \"A New Type of Bicycle Brake\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Independent Inventor\"\n        }\n    ],\n    \"patent_number\": \"US8999999B2\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2017-05-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel braking system for bicycles, offering improved stopping power and modulation. The system utilizes a unique lever mechanism and disc rotor design.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7666666B1\",\n            \"title\": \"Bicycle Brake System\"\n        }\n    ],\n    \"claims\": [\n        \"1. A bicycle brake system comprising...\",\n        \"2. The brake system of claim 1, wherein the lever mechanism...\",\n        \"3. A disc rotor for use with the brake system of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69683", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-08-20\",\n    \"issue_date\": \"2021-02-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing high-quality images from incomplete or noisy data, utilizing deep learning techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image reconstruction comprising...\",\n        \"A system for implementing the method...\",\n        \"The method according to claim 1, wherein...\",\n        \"The system according to claim 2, further comprising...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The method according to claim 1, wherein the image is a medical image.\",\n        \"The system according to claim 2, wherein the deep learning model is a convolutional neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69683", "text": "{\n    \"patent_title\": \"Improved Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2019-03-10\",\n    \"filing_date\": \"2019-07-01\",\n    \"issue_date\": \"2020-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An efficient algorithm for compressing digital data, achieving high compression ratios with minimal loss of information.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for data compression...\",\n        \"A system for implementing the method...\",\n        \"The method according to claim 1, wherein...\",\n        \"The system according to claim 2, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69684", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a miniature wireless pressure sensor system for biomedical applications. The system incorporates a MEMS pressure sensor, a low-power microcontroller, and a wireless communication module. The sensor data is transmitted wirelessly to a remote monitoring station.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for measuring pressure using a wireless sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69684", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emily Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2016-11-01\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved battery management system for electric vehicles. The system features advanced algorithms for optimizing battery charging and discharging, extending battery life, and enhancing safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery performance...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69685", "text": "{\n    \"patent_title\": \"Method for Training Deep Neural Networks with Adaptive Learning Rates\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-04-20\",\n    \"issue_date\": \"2022-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel method for training deep neural networks using adaptive learning rates. The method improves convergence speed and generalization performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B1\",\n            \"title\": \"Deep Learning Framework\"\n        },\n        {\n            \"patent_number\": \"US98765432B2\",\n            \"title\": \"Adaptive Optimization Algorithms\"\n        },\n        {\n            \"patent_number\": \"US1012345678B1\",\n            \"title\": \"Neural Network Architectures\"\n        },\n        {\n            \"patent_number\": \"US1123456789B2\",\n            \"title\": \"Regularization Techniques for Deep Learning\"\n        },\n        {\n            \"patent_number\": \"US1234567890B1\",\n            \"title\": \"Distributed Training of Neural Networks\"\n        }\n    ],\n    \"claims\": [\n        \"A method for training a deep neural network comprising...\",\n        \"The method of claim 1, wherein the adaptive learning rate is...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69685", "text": "{\n    \"patent_title\": \"System for Enhanced Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2021-01-05\",\n    \"filing_date\": \"2021-02-10\",\n    \"issue_date\": \"2023-05-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system for compressing data efficiently using a novel algorithm. It reduces storage space and transmission bandwidth.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Data Compression Techniques\"\n        },\n        {\n            \"patent_number\": \"US87654321B1\",\n            \"title\": \"Lossless Data Compression\"\n        }\n    ],\n    \"claims\": [\n        \"A system for compressing data comprising...\",\n        \"The system of claim 1, wherein the compression algorithm...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69686", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized wireless sensor system for environmental monitoring. This invention utilizes novel sensor technology and a low-power communication protocol to enable long-term data collection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor system comprising...\",\n        \"A method for monitoring environmental parameters...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69686", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details improvements to lithium-ion battery technology, focusing on increased energy density and cycle life. The new materials and manufacturing processes enhance battery performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"relevance\": \"Prior art in battery materials\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery cell comprising...\",\n        \"A method for manufacturing a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69687", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-15\",\n    \"issue_date\": \"2013-09-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for image recognition using artificial intelligence algorithms, specifically convolutional neural networks. The system can accurately identify objects in images with high speed and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"Prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training an image recognition model...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69687", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"CycleTech Ltd.\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"CycleTech Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2009-12-01\",\n    \"filing_date\": \"2009-12-01\",\n    \"issue_date\": \"2012-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel bicycle brake system offering enhanced stopping power and improved modulation. The system utilizes a hydraulic mechanism for efficient braking performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"relevance\": \"Existing bicycle brake designs\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle brake system comprising...\",\n        \"A hydraulic braking mechanism...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69688", "text": "{\n    \"patent_title\": \"High-Efficiency Perovskite Solar Cell with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Li Wei\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Maria Hernandez\",\n            \"affiliation\": \"National Renewable Energy Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2019-03-20\",\n    \"issue_date\": \"2020-06-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel perovskite solar cell architecture is disclosed, exhibiting enhanced efficiency and long-term stability. The device incorporates a unique interface layer that minimizes charge recombination and improves moisture resistance. This technology significantly advances the field of renewable energy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9988654B2\",\n            \"relevance\": \"Prior art on perovskite materials\"\n        }\n    ],\n    \"claims\": [\n        \"A perovskite solar cell comprising...\",\n        \"The solar cell of claim 1, wherein...\",\n        \"An interface layer for a perovskite solar cell...\",\n        \"A method of fabricating a perovskite solar cell...\",\n        \"The method of claim 4, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69688", "text": "{\n    \"patent_title\": \"Improved Wind Turbine Blade Design\",\n    \"inventors\": [\n        {\n            \"name\": \"David Chen\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2017-11-22\",\n    \"filing_date\": \"2018-05-10\",\n    \"issue_date\": \"2021-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new design for wind turbine blades that improves aerodynamic efficiency and reduces noise pollution. The blade incorporates a unique airfoil shape and a modified twist distribution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous wind turbine blade designs\"\n        }\n    ],\n    \"claims\": [\n        \"A wind turbine blade comprising...\",\n        \"The wind turbine blade of claim 1, wherein...\",\n        \"An airfoil shape for a wind turbine blade...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69689", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Predictive Maintenance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"TechCorp Inc.\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"University of Innovation\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-06-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for predictive maintenance utilizing artificial intelligence algorithms to analyze sensor data and predict equipment failures. The system leverages machine learning to optimize maintenance schedules and reduce downtime.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Data Analysis Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predictive maintenance comprising...\",\n        \"A method for predicting equipment failure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69689", "text": "{\n    \"patent_title\": \"Automated Insulin Delivery System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Williams\",\n            \"affiliation\": \"MedTech Solutions\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-12-10\",\n    \"filing_date\": \"2017-12-10\",\n    \"issue_date\": \"2020-05-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated insulin delivery system using artificial intelligence to personalize dosage based on glucose monitoring. The device provides closed-loop control for improved diabetes management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Glucose Monitoring Devices\"\n        },\n        {\n            \"patent_number\": \"US76543210B1\",\n            \"title\": \"Implantable Medical Devices\"\n        }\n    ],\n    \"claims\": [\n        \"An automated insulin delivery system comprising...\",\n        \"A method for personalized insulin dosage...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69690", "text": "{\n    \"patent_title\": \"Method and System for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for image recognition utilizing artificial intelligence and deep learning techniques. The system accurately identifies objects within images and provides real-time analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Prior Art Image Processing System\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for image recognition comprising...\",\n        \"2. A system for image recognition...\",\n        \"3. The method of claim 1, wherein...\",\n        \"4. The system of claim 2, wherein...\",\n        \"5. A computer-readable medium storing...\",\n        \"6. The method of claim 1, further comprising...\",\n        \"7. The system of claim 2, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69690", "text": "{\n    \"patent_title\": \"Improved Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-05-20\",\n    \"issue_date\": \"2018-12-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a novel data compression algorithm utilizing Huffman coding and run-length encoding. It achieves significant compression ratios for various data types.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"title\": \"Early Data Compression Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for data compression comprising...\",\n        \"2. A system for data compression...\",\n        \"3. The method of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69691", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Predictive Maintenance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for predictive maintenance using artificial intelligence algorithms to analyze sensor data and predict equipment failures. The system utilizes machine learning models to identify patterns and anomalies, enabling proactive maintenance scheduling and reducing downtime.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predictive maintenance comprising...\",\n        \"A method for analyzing sensor data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69691", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2021-02-28\",\n    \"filing_date\": \"2021-04-15\",\n    \"issue_date\": \"2023-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved battery management system for electric vehicles. It optimizes charging and discharging cycles to extend battery life and improve overall performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US1012345678B1\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing charging cycles...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69692", "text": "{\n    \"patent_title\": \"System and Method for Intelligent Data Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-01-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for intelligent data analysis utilizing artificial intelligence techniques. The system analyzes large datasets to identify patterns and anomalies for improved decision-making. It incorporates machine learning algorithms to provide predictive insights. The system is applicable to various industries including finance and marketing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for intelligent data analysis comprising...\",\n        \"A method for identifying patterns in a dataset...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69692", "text": "{\n    \"patent_title\": \"AI-Powered Diagnostic Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Williams\",\n            \"affiliation\": \"Healthcare Solutions Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2015-11-20\",\n    \"filing_date\": \"2015-11-20\",\n    \"issue_date\": \"2019-05-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an AI-powered diagnostic device for early detection of medical conditions. The device utilizes artificial intelligence to analyze medical images and provide diagnostic results. It is specifically designed for use in medical settings and enhances the accuracy of medical diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related\"\n        }\n    ],\n    \"claims\": [\n        \"A diagnostic device comprising an AI module...\",\n        \"A method for analyzing medical images using AI...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69693", "text": "{\n    \"patent_title\": \"Method and System for Neural Network Based Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for image recognition using a deep neural network. The system efficiently processes images and identifies objects with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for processing images using a neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69693", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"IBM Research\"\n        },\n        {\n            \"name\": \"Eve Wilson\",\n            \"affiliation\": \"Microsoft\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2017-01-20\",\n    \"filing_date\": \"2017-01-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details an improved algorithm for lossless data compression, achieving higher compression ratios than existing methods. The algorithm utilizes a novel approach to entropy encoding.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9012345B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising...\",\n        \"A system for encoding data using an improved algorithm...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69694", "text": "{\n    \"patent_title\": \"Method and System for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2012-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for image recognition utilizing artificial intelligence algorithms. The system leverages deep learning techniques to achieve high accuracy in identifying objects within images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"Prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69694", "text": "{\n    \"patent_title\": \"Improved Battery Charging Circuit\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-05-20\",\n    \"issue_date\": \"2013-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel battery charging circuit that optimizes charging speed and efficiency. It utilizes a unique control algorithm to prevent overcharging and prolong battery life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"relevance\": \"Related art in battery technology\"\n        }\n    ],\n    \"claims\": [\n        \"A battery charging circuit comprising...\",\n        \"A method for controlling battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69695", "text": "{\n    \"patent_title\": \"Neural Network Based Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition utilizing a deep neural network architecture. The system efficiently classifies images with high accuracy by leveraging convolutional neural networks and backpropagation algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760789B2\",\n            \"relevance\": \"Prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image classification utilizing...\",\n        \"A neural network architecture...\",\n        \"A non-transitory computer-readable medium...\",\n        \"A device for performing image analysis...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69695", "text": "{\n    \"patent_title\": \"Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An efficient data compression algorithm utilizing Huffman coding and run-length encoding to minimize storage space and transmission bandwidth.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related data compression techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression...\",\n        \"A system for reducing data size...\",\n        \"An algorithm utilizing Huffman coding...\",\n        \"A computer-readable medium storing...\",\n        \"A process for encoding data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69696", "text": "{\n    \"patent_title\": \"Method and System for Intelligent Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for intelligent image recognition utilizing artificial intelligence techniques, specifically convolutional neural networks, to identify objects within images with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760821B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for identifying objects in an image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69696", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"Princeton University\"\n        },\n        {\n            \"name\": \"David Blackwell\",\n            \"affiliation\": \"Princeton University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery management system is disclosed, enhancing efficiency and longevity of lithium-ion batteries. It employs advanced algorithms for charge control and temperature regulation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling battery charge...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69697", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications. The system utilizes a MEMS pressure sensor and a low-power wireless transceiver to transmit pressure data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A pressure sensor system comprising...\",\n        \"The system of claim 1, wherein...\",\n        \"A method for measuring pressure...\",\n        \"The method of claim 3, wherein...\",\n        \"A wireless transceiver for transmitting...\",\n        \"The transceiver of claim 5, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69697", "text": "{\n    \"patent_title\": \"Improved Battery Life for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Apple Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2010-12-01\",\n    \"filing_date\": \"2010-12-01\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method for extending the battery life of mobile devices through optimized power management techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A method for managing power consumption...\",\n        \"The method of claim 1, further comprising...\",\n        \"A mobile device comprising...\",\n        \"The mobile device of claim 3, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69698", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-06-15\",\n    \"issue_date\": \"2020-11-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system and method for performing image recognition using artificial intelligence. The system utilizes convolutional neural networks to analyze image data and identify objects with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising a convolutional neural network.\",\n        \"A method for identifying objects in an image using artificial intelligence.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69698", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Bicycle Dynamics Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2019-02-28\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-07-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved bicycle brake system utilizing a novel cable tensioning mechanism for enhanced stopping power and reliability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle brake system comprising a novel cable tensioning mechanism.\",\n        \"A method for improving the stopping power of a bicycle.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69699", "text": "{\n    \"patent_title\": \"System and Method for Personalized Recommendation Using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Sergey Brin\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Larry Page\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for providing personalized recommendations to users based on machine learning algorithms. The system analyzes user data and preferences to generate tailored recommendations.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"high\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"medium\"\n        },\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"low\"\n        },\n        {\n            \"patent_number\": \"US9876542B2\",\n            \"relevance\": \"high\"\n        },\n        {\n            \"patent_number\": \"US8901234B1\",\n            \"relevance\": \"medium\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating personalized recommendations comprising...\",\n        \"A system for providing personalized recommendations comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69699", "text": "{\n    \"patent_title\": \"Improved Algorithm for Image Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2018-11-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved algorithm for image compression that provides higher compression ratios and better image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"medium\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"low\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"medium\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image comprising...\",\n        \"A system for image compression comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69700", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"James Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications. The system includes a low-power pressure sensor, a wireless transmitter, and a receiver. The sensor is designed for implantable use and provides continuous pressure monitoring.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Wireless Sensor Networks\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system...\",\n        \"The system of claim 1, wherein the sensor is implantable...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69700", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Sarah Chen\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-20\",\n    \"filing_date\": \"2017-03-20\",\n    \"issue_date\": \"2020-02-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system designed to improve the efficiency and lifespan of lithium-ion batteries. The system includes voltage monitoring, temperature control, and charge balancing features.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Lithium-Ion Battery Technology\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system...\",\n        \"The system of claim 1, comprising voltage monitoring circuitry...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69701", "text": "{\n    \"patent_title\": \"Method and System for Neural Network-Based Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2019-12-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for image recognition using a deep neural network architecture. The system utilizes convolutional neural networks to extract features from images, achieving high accuracy in image classification tasks.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for image recognition comprising...\",\n        \"2. The method of claim 1, wherein the neural network is a convolutional neural network.\",\n        \"3. A system for image recognition...\",\n        \"4. The system of claim 3, comprising...\",\n        \"5. The method of claim 1, further comprising...\",\n        \"6. A non-transitory computer-readable medium...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69701", "text": "{\n    \"patent_title\": \"Improved Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"IBM\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-10\",\n    \"filing_date\": \"2017-03-10\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a novel data compression algorithm that achieves higher compression ratios compared to existing methods. It utilizes a combination of Huffman coding and Lempel-Ziv techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related Art\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for data compression comprising...\",\n        \"2. The method of claim 1, wherein the compression ratio is...\",\n        \"3. A system for data compression...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69702", "text": "{\n    \"patent_title\": \"System and method for enhancing image clarity in digital photographs\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-06-15\",\n    \"issue_date\": \"2018-03-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for enhancing image clarity in digital photographs using advanced image processing techniques, including noise reduction and edge sharpening. It improves the visual quality of photographs without introducing artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Enhancement System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image clarity comprising...\",\n        \"A system for processing digital images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69702", "text": "{\n    \"patent_title\": \"Medical Image Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Medical Imaging Corp.\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2015-11-22\",\n    \"filing_date\": \"2016-01-10\",\n    \"issue_date\": \"2019-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention utilizes deep learning techniques for reconstructing medical images from raw data. It significantly improves the quality and resolution of images used in medical diagnosis, such as CT scans and MRIs. The process employs advanced image processing algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"title\": \"MRI Image Reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing medical images using deep learning...\",\n        \"A system for processing medical image data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69703", "text": "{\n    \"patent_title\": \"System and Method for Intelligent Data Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of Innovation\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-06-15\",\n    \"issue_date\": \"2018-08-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for intelligent data analysis using artificial intelligence techniques, including machine learning and deep learning, to identify patterns and anomalies in large datasets. This system provides enhanced data insights for various applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8543210B1\",\n            \"title\": \"Data Mining System\"\n        },\n        {\n            \"patent_number\": \"US9234567B2\",\n            \"title\": \"Machine Learning Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A system for intelligent data analysis comprising...\",\n        \"A method for identifying patterns in data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69703", "text": "{\n    \"patent_title\": \"AI-Powered Diagnostic System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Medical Innovations Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-04-20\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An artificial intelligence-powered diagnostic system for identifying diseases from medical images. The system utilizes deep learning to analyze X-rays and CT scans, providing accurate and efficient diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Medical Imaging Device\"\n        },\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Image Recognition Algorithm for Medical Diagnosis\"\n        }\n    ],\n    \"claims\": [\n        \"A diagnostic system comprising...\",\n        \"A method for identifying diseases using AI...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69704", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Wireless Communication Reliability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for enhancing the reliability of wireless communication by employing adaptive coding and modulation schemes. It improves data throughput and reduces error rates in challenging wireless environments.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8542576B2\",\n            \"title\": \"Adaptive Modulation and Coding for Wireless Systems\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing wireless communication reliability comprising...\",\n        \"A system for implementing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69704", "text": "{\n    \"patent_title\": \"Implantable Wireless Medical Device for Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MedTech Solutions\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-08-20\",\n    \"filing_date\": \"2017-08-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable wireless medical device for continuous glucose monitoring. It transmits data wirelessly to an external receiver for analysis and display.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Implantable Glucose Sensor\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Wireless Data Transmission for Medical Implants\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable medical device comprising...\",\n        \"A method for monitoring glucose levels using the device of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69705", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Recognition using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2020-04-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for improving image recognition accuracy using deep convolutional neural networks. The system includes a pre-processing module, a convolutional neural network, and a post-processing module.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9897564B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\",\n        \"The method of claim 1, wherein...\",\n        \"The system of claim 2, wherein...\",\n        \"The method of claim 3, wherein...\",\n        \"The system of claim 4, wherein...\",\n        \"The method of claim 5, wherein...\"\n    ]\n}"}
