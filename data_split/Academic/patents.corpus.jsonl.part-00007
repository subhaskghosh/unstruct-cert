{"_id": "Academic--patents--p--69530", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2020-05-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to improved electrode materials for lithium-ion batteries, enhancing energy density and cycle life. New composite materials incorporating a novel lithium-ion conductor are described.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrode comprising...\",\n        \"A method for manufacturing said electrode...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69530", "text": "{\n    \"patent_title\": \"Novel Polymer Electrolyte for Solid-State Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2021-12-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel polymer electrolyte designed for use in solid-state batteries, offering improved safety and stability compared to liquid electrolytes. This invention utilizes a unique polymer structure with high ionic conductivity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A polymer electrolyte comprising...\",\n        \"A solid-state battery incorporating said electrolyte...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69531", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US1234567B2\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2018-03-01\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to improved electrode materials for lithium-ion batteries, offering enhanced energy density and cycle life. The materials are designed for use in electric vehicles and grid-scale energy storage applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrode material for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69531", "text": "{\n    \"patent_title\": \"Novel Polymer Electrolyte for Sodium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US7654321B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2018-02-15\",\n    \"issue_date\": \"2021-01-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel polymer electrolyte for sodium-ion batteries, exhibiting high ionic conductivity and electrochemical stability. The electrolyte enables the development of safer and more efficient energy storage devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A sodium-ion battery comprising...\",\n        \"A polymer electrolyte for a sodium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69532", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for industrial monitoring applications. The system utilizes a low-power MEMS sensor and a Bluetooth communication module. This invention enables remote pressure monitoring with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8540219B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"The system of claim 1, wherein the sensor is a MEMS sensor.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69532", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Telemetry\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"UC San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-06-10\",\n    \"filing_date\": \"2017-06-10\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor for continuous glucose monitoring in diabetic patients. The sensor transmits data wirelessly to an external receiver. It utilizes a biocompatible enzyme and a microfluidic channel for accurate glucose detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US8234567B2\",\n            \"relevance\": \"related - medical device\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable glucose sensor comprising...\",\n        \"The sensor of claim 1, wherein the sensor is used for diabetes management.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69533", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Predictive Maintenance\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US1234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for predicting equipment failures using artificial intelligence and machine learning algorithms. The system analyzes sensor data to identify patterns and anomalies indicative of potential failures, enabling proactive maintenance and reducing downtime.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predicting equipment failures comprising...\",\n        \"A method for analyzing sensor data using artificial intelligence...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69533", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Independent Inventor\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US7654321B1\",\n    \"priority_date\": \"2014-12-10\",\n    \"filing_date\": \"2014-12-10\",\n    \"issue_date\": \"2017-05-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved bicycle brake system providing increased stopping power and enhanced rider safety. The system incorporates a novel lever design and cable routing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle brake system comprising...\",\n        \"A lever assembly for a bicycle brake...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69534", "text": "{\n    \"patent_title\": \"Miniaturized Optical Sensor for Biomedical Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-05-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized optical sensor is disclosed for detecting biomarkers in biological fluids. The sensor utilizes a novel plasmonic resonance shift mechanism for enhanced sensitivity. This device offers significant advantages in point-of-care diagnostics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Optical Biosensor\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized optical sensor comprising...\",\n        \"A method for detecting biomarkers...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69534", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10245789B1\",\n    \"priority_date\": \"2017-08-10\",\n    \"filing_date\": \"2017-08-10\",\n    \"issue_date\": \"2019-09-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system is described, utilizing advanced algorithms for optimal charge and discharge cycles. This system enhances battery life and safety in electric vehicles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Battery Control System\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling battery charge...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69535", "text": "{\n    \"patent_title\": \"Method and System for Neural Network-Based Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for image recognition utilizing a deep neural network architecture. The system is capable of identifying objects with high accuracy and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Convolutional Neural Network for Image Classification\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69535", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Eve Edwards\",\n            \"affiliation\": \"IBM Research\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-01-25\",\n    \"filing_date\": \"2019-03-10\",\n    \"issue_date\": \"2021-07-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel data compression algorithm utilizing wavelet transforms and adaptive Huffman coding is presented. This algorithm provides significant improvements in compression ratio and speed.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Wavelet-Based Image Compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising...\",\n        \"A system for data compression comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69536", "text": "{\n    \"patent_title\": \"Wireless Sensor Network for Environmental Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless sensor network is described for monitoring environmental conditions. The system includes a plurality of sensor nodes communicating wirelessly to a central base station. The sensors measure temperature, humidity, and pressure. This network uses low-power communication protocols for extended battery life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Low-Power Wireless Communication Protocol\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor network comprising...\",\n        \"A sensor node configured to measure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69536", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor with wireless communication capabilities is disclosed. The sensor measures glucose levels in the bloodstream and transmits the data to an external receiver. This allows for continuous glucose monitoring for diabetic patients.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Implantable Medical Device Power Management\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Wireless Data Transmission for Biomedical Applications\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable glucose sensor comprising...\",\n        \"A wireless communication module configured to transmit...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69537", "text": "{\n    \"patent_title\": \"System and Method for Image Recognition using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9782345B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for accurate image recognition using deep convolutional neural networks. The system is capable of identifying objects, scenes, and faces in images with high precision.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8675843B2\",\n            \"relevance\": \"Prior art in image classification\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69537", "text": "{\n    \"patent_title\": \"Method for Real-time Object Tracking\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-14\",\n    \"issue_date\": \"2020-07-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a method for real-time object tracking in video streams. It utilizes a Kalman filter and feature matching to maintain accurate object localization.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related to object detection algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"A method for object tracking comprising...\",\n        \"A system for object tracking comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69538", "text": "{\n    \"patent_title\": \"System and Method for Intelligent Route Optimization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"TechForward Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for optimizing routes using artificial intelligence algorithms. The system analyzes real-time traffic data to dynamically adjust routes, minimizing travel time and fuel consumption.  It leverages machine learning to predict traffic patterns and improve route efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for route optimization comprising...\",\n        \"A method for dynamically adjusting routes...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The system of claim 1, further comprising...\",\n        \"The method of claim 2, wherein the traffic data is...\",\n        \"The system of claim 1, wherein the route optimization is based on artificial intelligence.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69538", "text": "{\n    \"patent_title\": \"AI-Powered Diagnostic Tool for Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"MedTech Solutions\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2017-05-22\",\n    \"filing_date\": \"2017-05-22\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An artificial intelligence-based system for early detection of cancerous tumors through image analysis.  The system utilizes deep learning to identify subtle patterns in medical imaging data that may indicate the presence of cancer, improving diagnostic accuracy and patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for cancer detection comprising...\",\n        \"A method for analyzing medical images...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The system of claim 1, wherein the medical images are...\",\n        \"The method of claim 2, wherein the cancer type is...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69539", "text": "{\n    \"patent_title\": \"Novel Cathode Material for High-Performance Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel cathode material comprising lithium-ion conducting polymers is disclosed, exhibiting improved energy density and cycle life for next-generation lithium-ion batteries. The material enhances ion transport and reduces polarization, resulting in superior battery performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"High-Capacity Anode Material\"\n        }\n    ],\n    \"claims\": [\n        \"A cathode material comprising...\",\n        \"A lithium-ion battery including...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69539", "text": "{\n    \"patent_title\": \"Advanced Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-02-10\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-11-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An advanced battery management system (BMS) for electric vehicles is described, incorporating sophisticated algorithms for cell balancing, thermal management, and state-of-charge estimation. This BMS utilizes lithium-ion battery technology for improved performance and safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10112233B2\",\n            \"title\": \"Lithium-Ion Cell Balancing Techniques\"\n        },\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Battery Management System Architecture\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69540", "text": "{\n    \"patent_title\": \"Implantable Glucose Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-15\",\n    \"filing_date\": \"2015-03-10\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose monitoring system with enhanced accuracy and longevity for diabetes management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art related to glucose sensors.\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related to biocompatible materials.\"\n        },\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"Previous designs for implantable devices.\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"relevance\": \"Data processing algorithms for glucose readings.\"\n        },\n        {\n            \"patent_number\": \"US10234567B1\",\n            \"relevance\": \"Wireless communication for medical devices.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for continuously monitoring glucose levels in a patient.\",\n        \"An implantable glucose sensor with a biocompatible coating.\",\n        \"A system for wirelessly transmitting glucose data to a remote monitoring device.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69540", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"California Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2016-01-20\",\n    \"filing_date\": \"2016-04-15\",\n    \"issue_date\": \"2020-11-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel braking system for bicycles that provides enhanced stopping power and control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on bicycle brakes.\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related to hydraulic systems.\"\n        },\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"Previous bicycle designs.\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle braking system utilizing a novel caliper design.\",\n        \"A method for modulating braking force based on rider input.\",\n        \"A bicycle brake lever with ergonomic features.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69541", "text": "{\n    \"patent_title\": \"Improved Electrolyte Composition for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-07-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel electrolyte composition for lithium-ion batteries, enhancing their energy density and cycle life. The composition includes a lithium salt, a solvent mixture, and an additive that improves the stability of the electrolyte at high voltages. It is applicable in portable electronic devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8758812B2\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrolyte...\",\n        \"The electrolyte of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69541", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"Tesla Inc.\"\n        },\n        {\n            \"name\": \"Bob Green\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10233791B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-14\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) for lithium-ion batteries used in electric vehicles. The BMS provides accurate state-of-charge estimation, thermal management, and cell balancing to optimize battery performance and longevity in electric vehicle applications. This invention improves the safety and efficiency of electric vehicles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9124145B2\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for an electric vehicle...\",\n        \"The battery management system of claim 1, comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69542", "text": "{\n    \"patent_title\": \"Method and System for Dynamic Resource Allocation\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2018-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel system and method for dynamically allocating resources in a distributed computing environment is presented. The system utilizes machine learning algorithms to predict resource demand and optimize allocation for improved performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for dynamically allocating resources...\",\n        \"A system comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69542", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9123456B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-02-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new material composition for lithium-ion batteries, resulting in increased energy density and cycle life. The material is synthesized using a novel process.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9012345B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery comprising a novel material composition...\",\n        \"A method for synthesizing...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69543", "text": "{\n    \"patent_title\": \"Wireless Sensor Network for Environmental Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2019-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless sensor network for monitoring environmental conditions such as temperature, humidity, and air quality. The system utilizes low-power sensors and a mesh network topology for reliable data transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Low-Power Wireless Communication Protocol\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor network comprising a plurality of sensor nodes...\",\n        \"A method for monitoring environmental conditions using a wireless sensor network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69543", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2019-03-10\",\n    \"filing_date\": \"2019-03-10\",\n    \"issue_date\": \"2021-05-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor for continuous glucose monitoring in diabetic patients. The sensor wirelessly transmits data to an external receiver.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Miniaturized Implantable Medical Device\"\n        },\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Biocompatible Materials for Medical Implants\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable glucose sensor comprising a biocompatible electrode...\",\n        \"A system for continuous glucose monitoring using an implantable sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69544", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-05-15\",\n    \"filing_date\": \"2010-03-01\",\n    \"issue_date\": \"2018-11-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel battery technology utilizing a new electrolyte composition to improve energy density and cycle life for electric vehicle applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Lithium-ion Battery Electrode Materials\"\n        },\n        {\n            \"patent_number\": \"US8987654B2\",\n            \"title\": \"Solid-State Electrolytes for Batteries\"\n        },\n        {\n            \"patent_number\": \"US9234567B2\",\n            \"title\": \"Battery Management Systems\"\n        },\n        {\n            \"patent_number\": \"US9567890B2\",\n            \"title\": \"High-Capacity Anode Materials\"\n        },\n        {\n            \"patent_number\": \"US9678901B2\",\n            \"title\": \"Battery Cooling Systems\"\n        }\n    ],\n    \"claims\": [\n        \"A battery comprising...\",\n        \"An electrolyte composition...\",\n        \"A method for manufacturing...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69544", "text": "{\n    \"patent_title\": \"Novel Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2011-12-01\",\n    \"filing_date\": \"2012-06-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new data compression algorithm that achieves higher compression ratios with reduced computational complexity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"title\": \"Data Compression Method\"\n        },\n        {\n            \"patent_number\": \"US7890123B1\",\n            \"title\": \"Adaptive Data Encoding\"\n        },\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"title\": \"Lossless Data Compression Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data...\",\n        \"A data compression system...\",\n        \"A computer-readable medium...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69545", "text": "{\n    \"patent_title\": \"Convolutional Neural Network Based Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-05-15\",\n    \"filing_date\": \"2020-05-15\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an image recognition system utilizing convolutional neural networks for improved accuracy and efficiency. The system is designed for real-time applications and offers significant advancements over existing methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising a convolutional neural network.\",\n        \"A method for training a convolutional neural network for image classification.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69545", "text": "{\n    \"patent_title\": \"Object Detection Using Traditional Image Processing Techniques\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2021-03-10\",\n    \"filing_date\": \"2021-03-10\",\n    \"issue_date\": \"2023-04-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method for object detection in images using traditional image processing techniques such as edge detection and feature extraction. It does not involve neural networks.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related to feature extraction algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"A method for object detection using edge detection.\",\n        \"A system for identifying objects based on feature extraction.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69546", "text": "{\n    \"patent_title\": \"Neural Network Based Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2020-05-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image recognition system utilizing a deep convolutional neural network for accurate object detection and classification. The system is trained on a large dataset and achieves state-of-the-art performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69546", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Beta Industries\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2019-01-20\",\n    \"filing_date\": \"2019-01-20\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system designed to improve the lifespan and efficiency of lithium-ion batteries. The system includes advanced charging algorithms and thermal management techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for managing battery charge comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69547", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Glucose Sensor\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a miniaturized implantable glucose sensor for continuous monitoring of blood glucose levels. The device incorporates a novel enzymatic sensor and a wireless communication module.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized glucose sensor comprising...\",\n        \"A method for continuously monitoring glucose levels...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69547", "text": "{\n    \"patent_title\": \"Surgical Instrument with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10293847B1\",\n    \"priority_date\": \"2014-12-20\",\n    \"filing_date\": \"2015-01-10\",\n    \"issue_date\": \"2019-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical instrument designed for enhanced ergonomics and precision during minimally invasive procedures. The handle is designed for comfortable grip and reduced fatigue.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising an ergonomic handle...\",\n        \"A method for performing minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69548", "text": "{\n    \"patent_title\": \"Neural Network Architecture for Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel neural network architecture for improved image recognition accuracy. The network utilizes a convolutional layer followed by a recurrent layer to capture spatial and temporal dependencies within images. This enhances performance in various image classification tasks.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on convolutional neural networks\"\n        }\n    ],\n    \"claims\": [\n        \"A neural network comprising a convolutional layer and a recurrent layer.\",\n        \"The neural network of claim 1, wherein the convolutional layer is a 3D convolutional layer.\",\n        \"The neural network of claim 1, wherein the recurrent layer is a LSTM layer.\",\n        \"A method for image recognition using the neural network of claim 1.\",\n        \"The method of claim 4, wherein the image recognition is performed in real-time.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69548", "text": "{\n    \"patent_title\": \"Improved Method for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob White\",\n            \"affiliation\": \"IBM Research\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-01-15\",\n    \"filing_date\": \"2022-01-15\",\n    \"issue_date\": \"2023-11-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a new data compression algorithm based on Huffman coding. The algorithm achieves higher compression ratios by dynamically adjusting the codebook based on the input data. The algorithm is suitable for use in a variety of applications, including image and video compression.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art on Huffman coding\"\n        }\n    ],\n    \"claims\": [\n        \"A data compression method comprising Huffman coding.\",\n        \"The method of claim 1, wherein the Huffman codebook is dynamically adjusted.\",\n        \"A system for implementing the data compression method of claim 1.\",\n        \"A computer program for performing the data compression method of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69549", "text": "{\n    \"patent_title\": \"Neural Network Accelerator for Edge Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2020-12-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel neural network accelerator designed for low-power edge devices. The accelerator utilizes a sparse matrix representation to reduce memory bandwidth and computational complexity, enabling efficient inference of deep neural networks.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art in neural network hardware\"\n        }\n    ],\n    \"claims\": [\n        \"A neural network accelerator comprising...\",\n        \"A method for accelerating neural network inference...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69549", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2017-12-20\",\n    \"filing_date\": \"2017-12-20\",\n    \"issue_date\": \"2019-07-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system designed to maximize battery life and safety in electric vehicles. The system incorporates advanced charging algorithms and thermal management techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous work on battery charging\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69550", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-05-15\",\n    \"filing_date\": \"2010-03-20\",\n    \"issue_date\": \"2019-07-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery design featuring a solid electrolyte and improved thermal stability. This invention addresses the safety concerns associated with conventional lithium-ion batteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"The battery of claim 1, further comprising...\",\n        \"A method for manufacturing the battery of claim 1...\",\n        \"The method of claim 3, wherein...\",\n        \"The battery of claim 1, exhibiting a cycle life of at least 500 cycles.\",\n        \"The battery of claim 1, with a voltage between 3.6V and 4.2V\"\n    ]\n}"}
{"_id": "Academic--patents--n--69550", "text": "{\n    \"patent_title\": \"Improved Polymer Electrolyte for Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2011-11-01\",\n    \"filing_date\": \"2012-05-10\",\n    \"issue_date\": \"2017-02-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new polymer electrolyte material for use in various battery applications. It shows enhanced ionic conductivity and mechanical strength.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A polymer electrolyte comprising...\",\n        \"The electrolyte of claim 1, having an ionic conductivity...\",\n        \"A battery cell including the electrolyte of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69551", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Recognition Using Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhanced image recognition using deep neural networks is disclosed. The system utilizes a convolutional neural network architecture to identify objects within images with increased accuracy and speed. The method includes pre-processing steps, feature extraction, and classification utilizing multiple layers of neurons.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising:...\",\n        \"A system for image recognition comprising:...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69551", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-12-20\",\n    \"filing_date\": \"2009-12-20\",\n    \"issue_date\": \"2018-01-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved algorithm for lossless data compression is presented. The algorithm utilizes Huffman coding with dynamic tree updates to achieve higher compression ratios. This is suitable for text and binary data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising:...\",\n        \"A system for data compression comprising:...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69552", "text": "{\n    \"patent_title\": \"Machine Learning-Based Predictive Maintenance System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-06-15\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system and method for predictive maintenance using machine learning algorithms. It utilizes sensor data and historical failure data to predict potential equipment failures, optimizing maintenance schedules and reducing downtime. The system employs deep neural networks for improved accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predictive maintenance comprising...\",\n        \"A method for predicting equipment failure comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69552", "text": "{\n    \"patent_title\": \"Expert System for Fault Diagnosis\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"IBM\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-03-10\",\n    \"filing_date\": \"2020-04-10\",\n    \"issue_date\": \"2022-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an expert system for fault diagnosis in complex machinery. It utilizes a knowledge base of rules and inference engine to identify the root cause of malfunctions. The system leverages a rule-based approach for identifying and resolving errors.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"An expert system for fault diagnosis comprising...\",\n        \"A method for diagnosing malfunctions comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69553", "text": "{\n    \"patent_title\": \"Wireless Sensor Network for Industrial Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of Engineering\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2020-09-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a wireless sensor network for monitoring temperature, pressure, and vibration in industrial environments. The network utilizes low-power sensors and a secure communication protocol.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"title\": \"Low-Power Wireless Communication\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor network comprising...\",\n        \"A method for monitoring industrial parameters...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69553", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Medical Devices Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-01-10\",\n    \"filing_date\": \"2019-01-10\",\n    \"issue_date\": \"2021-05-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor for continuous monitoring of blood glucose levels, transmitting data wirelessly to an external device. This system facilitates improved diabetes management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Implantable Medical Devices\"\n        },\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"title\": \"Wireless Communication for Healthcare\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable glucose sensor...\",\n        \"A method for continuous glucose monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69554", "text": "{\n    \"patent_title\": \"System and Method for Object Recognition in Digital Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for identifying objects within digital images using deep convolutional neural networks. The system processes images to extract features and classify objects with high accuracy, enabling applications in robotics, autonomous vehicles, and image search. This is not related to medical imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760844\",\n            \"relevance\": \"prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for object recognition comprising...\",\n        \"A system for processing digital images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69554", "text": "{\n    \"patent_title\": \"Medical Image Analysis System Utilizing Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford Hospital\"\n        }\n    ],\n    \"patent_number\": \"US9987654\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-14\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for analyzing medical images, such as X-rays and MRIs, using deep learning algorithms to detect anomalies and assist in diagnosis. This system utilizes image recognition techniques to identify potential health issues within medical scans.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760844\",\n            \"relevance\": \"prior art in image processing\"\n        },\n        {\n            \"patent_number\": \"US9123456\",\n            \"relevance\": \"prior art in medical imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A method for analyzing medical images...\",\n        \"A system for detecting anomalies...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69555", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-03-15\",\n    \"filing_date\": \"2015-05-20\",\n    \"issue_date\": \"2018-10-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery technology utilizing a new electrolyte composition, resulting in increased energy density and faster charging times for electric vehicles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8652001B2\",\n            \"title\": \"Lithium-Ion Battery Improvements\"\n        },\n        {\n            \"patent_number\": \"US9231234B2\",\n            \"title\": \"Electrolyte Composition for High-Performance Batteries\"\n        },\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Battery Management Systems\"\n        },\n        {\n            \"patent_number\": \"US1234567B2\",\n            \"title\": \"Solid-State Battery Technology\"\n        },\n        {\n            \"patent_number\": \"US4567890B2\",\n            \"title\": \"Charging Circuits for Batteries\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising a novel electrolyte composition...\",\n        \"A method for charging a battery cell...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69555", "text": "{\n    \"patent_title\": \"Wireless Communication System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Robert Brown\",\n            \"affiliation\": \"Qualcomm\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2016-01-10\",\n    \"filing_date\": \"2016-07-05\",\n    \"issue_date\": \"2019-04-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless communication system utilizing advanced modulation techniques for improved data transmission rates.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Modulation Techniques for Wireless Communication\"\n        },\n        {\n            \"patent_number\": \"US9345678B2\",\n            \"title\": \"Error Correction Codes for Wireless Communication\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Antenna Designs for Wireless Systems\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication system comprising a transmitter...\",\n        \"A method for transmitting data wirelessly...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69556", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-15\",\n    \"filing_date\": \"2015-03-20\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved lithium-ion battery electrode with enhanced energy density and cycle life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Lithium-Ion Battery Materials\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Electrode Structures for Batteries\"\n        },\n        {\n            \"patent_number\": \"US9543210B1\",\n            \"title\": \"Solid Electrolyte for Batteries\"\n        },\n        {\n            \"patent_number\": \"US10234567B2\",\n            \"title\": \"Battery Management Systems\"\n        },\n        {\n            \"patent_number\": \"US11345678B1\",\n            \"title\": \"Advanced Battery Technologies\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrode comprising...\",\n        \"The electrode of claim 1, wherein...\",\n        \"A method of manufacturing the electrode of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69556", "text": "{\n    \"patent_title\": \"Wireless Communication System\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Smith\",\n            \"affiliation\": \"California Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2016-11-10\",\n    \"filing_date\": \"2017-05-01\",\n    \"issue_date\": \"2020-12-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel wireless communication system with improved data transmission rates.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"title\": \"Wireless Communication Protocols\"\n        },\n        {\n            \"patent_number\": \"US9456789B1\",\n            \"title\": \"Antenna Design for Wireless Systems\"\n        },\n        {\n            \"patent_number\": \"US10567890B2\",\n            \"title\": \"Signal Processing Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication system comprising...\",\n        \"The system of claim 1, wherein...\",\n        \"A method of transmitting data using the system of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69557", "text": "{\n    \"patent_title\": \"Miniature Wireless Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a miniature wireless sensor system for detecting environmental parameters. The system includes a sensor, a transmitter, and a receiver, enabling real-time monitoring of various conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"Prior art in sensor technology\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor system comprising: a sensor element...\",\n        \"The system of claim 1, wherein the sensor element is a temperature sensor...\",\n        \"The system of claim 1, further comprising a power source...\",\n        \"The system of claim 2, wherein the temperature sensor measures temperature in the range of -40°C to 100°C...\",\n        \"A method of monitoring temperature using the system of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69557", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2012-03-10\",\n    \"filing_date\": \"2012-03-10\",\n    \"issue_date\": \"2018-11-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved battery technology with enhanced energy density and cycle life. It utilizes a novel electrode material and electrolyte composition.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B2\",\n            \"relevance\": \"Related prior art in battery materials\"\n        }\n    ],\n    \"claims\": [\n        \"A battery comprising: an anode...\",\n        \"The battery of claim 1, wherein the anode is made of lithium titanate...\",\n        \"A method of charging the battery of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69558", "text": "{\n    \"patent_title\": \"High-Density Lithium-Ion Battery with Enhanced Thermal Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-04-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A high-density lithium-ion battery with a novel electrolyte composition for improved thermal stability and energy density. The invention details a method for synthesizing a solid-state electrolyte capable of operating at elevated temperatures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9236418B2\",\n            \"relevance\": \"Related prior art on electrolyte materials\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising a solid-state electrolyte.\",\n        \"A method for synthesizing a solid-state electrolyte with enhanced thermal stability.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69558", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Motors\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2017-07-20\",\n    \"filing_date\": \"2017-07-20\",\n    \"issue_date\": \"2021-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) for lithium-ion batteries used in electric vehicles. The system provides advanced monitoring and control features to optimize battery performance and lifespan within automotive applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8546843B2\",\n            \"relevance\": \"Prior art on automotive battery control systems\"\n        },\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related technology for vehicle power systems\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for an electric vehicle.\",\n        \"A method for controlling a lithium-ion battery in an electric vehicle.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69559", "text": "{\n    \"patent_title\": \"Method for High-Throughput Screening of Nanomaterials\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-05-15\",\n    \"filing_date\": \"2010-02-20\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for rapidly screening the properties of nanomaterials using automated microscopy and data analysis techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Nanomaterial Synthesis\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Microscopy Techniques\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Data Analysis Algorithms\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"High-Throughput Screening\"\n        },\n        {\n            \"patent_number\": \"US11123456B2\",\n            \"title\": \"Material Characterization\"\n        }\n    ],\n    \"claims\": [\n        \"A method for high-throughput screening of nanomaterials comprising...\",\n        \"The method of claim 1, wherein the nanomaterials are...\",\n        \"An apparatus for performing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69559", "text": "{\n    \"patent_title\": \"Improved Battery Electrode Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2008-11-01\",\n    \"filing_date\": \"2011-03-10\",\n    \"issue_date\": \"2017-09-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel electrode material for lithium-ion batteries with improved energy density and cycle life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Lithium-Ion Battery Technology\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Electrode Materials\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Battery Management Systems\"\n        }\n    ],\n    \"claims\": [\n        \"An electrode material comprising...\",\n        \"The electrode material of claim 1, wherein...\",\n        \"A lithium-ion battery comprising the electrode material of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69560", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2020-09-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for image recognition using artificial intelligence techniques, specifically deep convolutional neural networks. The system is capable of identifying objects in images with high accuracy and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69560", "text": "{\n    \"patent_title\": \"Method for Optimizing Combustion Engines\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Ford Motor Company\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2021-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method for optimizing combustion engines to improve fuel efficiency and reduce emissions. It involves controlling the air-fuel mixture and ignition timing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for controlling air-fuel mixture...\",\n        \"An engine control unit configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69561", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Wireless Communication Security\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Qualcomm Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing security in wireless communication networks by utilizing advanced encryption techniques and authentication protocols.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for encrypting wireless signals comprising...\",\n        \"A system for authenticating users in a wireless network...\",\n        \"An apparatus for secure data transmission...\",\n        \"The method of claim 1, further comprising...\",\n        \"The system of claim 2, wherein the authentication protocol...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69561", "text": "{\n    \"patent_title\": \"Improved Data Storage Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10293847B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-04-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel data storage method utilizing phase-change memory for increased capacity and reliability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for storing data using phase-change memory...\",\n        \"A storage device comprising phase-change memory...\",\n        \"A system for managing data storage...\",\n        \"The method of claim 1, further comprising error correction...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69562", "text": "{\n    \"patent_title\": \"Method and System for Automated Machine Learning Model Selection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for automatically selecting the best machine learning model for a given dataset. The system utilizes artificial intelligence techniques to evaluate different models and identify the optimal one based on performance metrics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Previous Machine Learning System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for automated machine learning model selection comprising...\",\n        \"A system for identifying optimal machine learning models...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69562", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876544B2\",\n    \"priority_date\": \"2016-11-20\",\n    \"filing_date\": \"2016-11-20\",\n    \"issue_date\": \"2019-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new algorithm for efficiently compressing large datasets. The algorithm utilizes a novel encoding scheme to minimize file size without significant loss of information.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765433B1\",\n            \"title\": \"Early Data Compression Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising...\",\n        \"A system for encoding data using a novel scheme...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69563", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for enhancing the resolution of images using deep learning techniques. The system employs convolutional neural networks to upscale low-resolution images, resulting in high-quality, visually appealing images. The process includes image preprocessing, feature extraction, and image reconstruction.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in image upscaling\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising...\",\n        \"The method of claim 1, wherein the convolutional neural network...\",\n        \"A system for enhancing image resolution comprising...\",\n        \"The system of claim 3, wherein the preprocessing step...\",\n        \"The method of claim 1, further comprising...\",\n        \"The system of claim 3, further comprising...\",\n        \"The method of claim 2, wherein the convolutional neural network...\",\n        \"The system of claim 4, wherein the preprocessing step...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69563", "text": "{\n    \"patent_title\": \"System for Real-Time Object Detection in Video Streams\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Google LLC\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-08-20\",\n    \"filing_date\": \"2017-08-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system for real-time object detection in video streams utilizing machine learning algorithms. The system identifies and tracks objects within a video feed with high accuracy and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related technology in object tracking\"\n        }\n    ],\n    \"claims\": [\n        \"A system for detecting objects in a video stream comprising...\",\n        \"The system of claim 1, wherein the machine learning algorithm...\",\n        \"A method for detecting objects in a video stream comprising...\",\n        \"The method of claim 2, wherein the video stream...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69564", "text": "{\n    \"patent_title\": \"Method for Generating Realistic Synthetic Data for Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for generating realistic synthetic data that can be used to train machine learning models. The method includes steps for data anonymization, data augmentation, and data synthesis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\"\n        },\n        {\n            \"patent_number\": \"US7654321B1\"\n        },\n        {\n            \"patent_number\": \"US6543210B2\"\n        },\n        {\n            \"patent_number\": \"US5432109B1\"\n        },\n        {\n            \"patent_number\": \"US4321098B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating synthetic data...\",\n        \"The method of claim 1, wherein the data is anonymized...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69564", "text": "{\n    \"patent_title\": \"System for Automated Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11223344B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2021-11-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for automatically recognizing images using deep learning techniques. The system is capable of identifying objects, faces, and scenes in images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\"\n        },\n        {\n            \"patent_number\": \"US9987654B2\"\n        },\n        {\n            \"patent_number\": \"US8876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for automated image recognition...\",\n        \"The system of claim 1, wherein the image is processed using a convolutional neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69565", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Data Encryption\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-01-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel system and method for enhancing data encryption using a multi-layered approach. The system utilizes a combination of symmetric and asymmetric encryption algorithms to provide robust data security.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9876543B2\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        },\n        {\n            \"patent_number\": \"US11234567B2\"\n        },\n        {\n            \"patent_number\": \"US12345678B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for encrypting data comprising...\",\n        \"A system for data encryption comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69565", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US98765432B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-07-20\",\n    \"issue_date\": \"2021-12-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery technology featuring enhanced energy density and longer lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\"\n        },\n        {\n            \"patent_number\": \"US9654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising...\",\n        \"A method for manufacturing a battery cell comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69566", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-15\",\n    \"issue_date\": \"2018-05-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system is disclosed. The system comprises a pressure sensor, a wireless transmitter, and a power source. It is designed for remote monitoring applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"The system of claim 1, wherein the sensor is a MEMS pressure sensor.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69566", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"UC Berkeley\"\n        },\n        {\n            \"name\": \"Eve Frank\",\n            \"affiliation\": \"Google\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2009-12-10\",\n    \"filing_date\": \"2009-12-10\",\n    \"issue_date\": \"2017-01-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery management system for lithium-ion batteries is described. The system provides improved charging and discharging control for increased battery life and safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"The system of claim 1, further comprising a temperature sensor.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69567", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved lithium-ion battery with enhanced stability and increased energy density. A novel electrolyte composition and electrode structure contribute to prolonged battery life and reduced risk of thermal runaway.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"The battery of claim 1, wherein the electrolyte...\",\n        \"The battery of claim 1, wherein the electrode...\",\n        \"A method for manufacturing a lithium-ion battery...\",\n        \"The method of claim 4, comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69567", "text": "{\n    \"patent_title\": \"Novel Solar Cell Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Caltech\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a new design for solar cells, increasing efficiency through advanced light trapping techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10112233B2\"\n        }\n    ],\n    \"claims\": [\n        \"A solar cell comprising...\",\n        \"The solar cell of claim 1, wherein...\",\n        \"A method for fabricating the solar cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69568", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-06-15\",\n    \"issue_date\": \"2018-11-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications. The system utilizes a MEMS pressure sensor and a low-power wireless transceiver to transmit pressure data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for measuring pressure using a wireless sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69568", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-10\",\n    \"filing_date\": \"2017-04-10\",\n    \"issue_date\": \"2019-05-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery management system designed to improve the efficiency and lifespan of lithium-ion batteries. This system incorporates advanced charging algorithms and thermal management techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69569", "text": "{\n    \"patent_title\": \"High-Resolution Environmental Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a high-resolution sensor system for detecting and measuring environmental pollutants. The system utilizes a novel sensor array and signal processing algorithms to provide accurate and reliable data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"category\": \"Environmental Monitoring\"\n        }\n    ],\n    \"claims\": [\n        \"A sensor system comprising a sensor array...\",\n        \"A method for detecting pollutants...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69569", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Enhanced Biocompatibility\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"BioMed Innovations\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2021-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an implantable glucose sensor with improved biocompatibility and long-term stability for continuous glucose monitoring in patients with diabetes. The sensor utilizes a novel coating material to minimize immune response.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\",\n            \"category\": \"A61B\"\n        },\n        {\n            \"patent_number\": \"US91234567B1\",\n            \"category\": \"C07K\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable glucose sensor...\",\n        \"A method for monitoring glucose levels...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69570", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Improved Electrolyte Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2014-05-15\",\n    \"filing_date\": \"2015-03-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a lithium-ion battery with an improved electrolyte formulation providing enhanced stability and cycle life. The new electrolyte minimizes dendrite formation and improves safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8784872B2\",\n            \"relevance\": \"Prior art in electrolyte composition\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte formulation...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69570", "text": "{\n    \"patent_title\": \"Nickel-Metal Hydride Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2013-11-01\",\n    \"filing_date\": \"2015-06-12\",\n    \"issue_date\": \"2022-08-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention focuses on advancements in nickel-metal hydride battery technology, specifically regarding electrode materials and charge/discharge cycles. It improves energy density and lifespan for these batteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7541123B2\",\n            \"relevance\": \"Related nickel-metal hydride technology\"\n        }\n    ],\n    \"claims\": [\n        \"A nickel-metal hydride battery comprising...\",\n        \"An electrode material...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69571", "text": "{\n    \"patent_title\": \"Wireless Sensor Network for Structural Health Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2015-03-15\",\n    \"filing_date\": \"2015-03-15\",\n    \"issue_date\": \"2018-05-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless sensor network for monitoring the structural integrity of bridges and buildings. The system utilizes low-power sensors to collect data on strain, vibration, and temperature. The collected data is transmitted wirelessly to a central server for analysis and alerting.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Wireless Communication Protocols\"\n        },\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"title\": \"Data Analytics for Infrastructure\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor network for structural health monitoring...\",\n        \"A sensor node comprising a strain gauge...\",\n        \"A method for analyzing sensor data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69571", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-07-20\",\n    \"filing_date\": \"2016-07-20\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor utilizing wireless communication to transmit data to an external monitoring device. Designed for continuous glucose monitoring in diabetic patients.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"title\": \"Biocompatible Materials for Implants\"\n        },\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Wireless Power Transfer for Medical Devices\"\n        },\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Miniature Medical Sensor Design\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable glucose sensor...\",\n        \"A wireless communication module...\",\n        \"A method for continuous glucose monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69572", "text": "{\n    \"patent_title\": \"Wireless Temperature Sensor Network\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless sensor network for monitoring temperature. This system utilizes low-power sensors and a mesh network topology for reliable data transmission. The system uses a novel calibration technique to improve accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8543210B2\",\n            \"relevance\": \"Related art in wireless communication\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor network comprising...\",\n        \"A method for calibrating sensors in a wireless network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69572", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, San Diego\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor for continuous glucose monitoring in diabetic patients. The sensor utilizes a biocompatible material and transmits data wirelessly to an external receiver.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related to implantable medical devices\"\n        },\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Relevant medical sensor technology\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable glucose sensor comprising...\",\n        \"A method for continuous glucose monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69573", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2022-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for reconstructing images from incomplete data, utilizing deep learning techniques to improve image quality and reduce artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B1\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US98765432B2\",\n            \"relevance\": \"cited\"\n        },\n        {\n            \"patent_number\": \"US10123456B3\",\n            \"relevance\": \"referenced\"\n        },\n        {\n            \"patent_number\": \"US11234567B4\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US12345678B5\",\n            \"relevance\": \"cited\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an image comprising...\",\n        \"A system for implementing the reconstruction method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69573", "text": "{\n    \"patent_title\": \"Digital Image Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2018-11-22\",\n    \"filing_date\": \"2020-03-01\",\n    \"issue_date\": \"2021-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved digital image compression technique based on wavelet transforms and entropy coding.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US87654321B1\",\n            \"relevance\": \"cited\"\n        },\n        {\n            \"patent_number\": \"US91234567B3\",\n            \"relevance\": \"referenced\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a digital image comprising...\",\n        \"An apparatus for implementing the compression method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69574", "text": "{\n    \"patent_title\": \"Method for Enhanced MRI Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2021-02-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for improving the quality of Magnetic Resonance Images (MRI) through advanced reconstruction algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image...\",\n        \"The method of claim 1, wherein the reconstruction algorithm...\",\n        \"The method of claim 2, further comprising...\",\n        \"A system for performing the method of claim 1...\",\n        \"The system of claim 4, wherein the processor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69574", "text": "{\n    \"patent_title\": \"Improved X-Ray Detection System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-07-01\",\n    \"filing_date\": \"2019-09-10\",\n    \"issue_date\": \"2020-11-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved X-ray detection system for faster and more accurate imaging.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A system for detecting X-rays...\",\n        \"The system of claim 1, comprising a detector...\",\n        \"The detector of claim 2, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69575", "text": "{\n    \"patent_title\": \"Lithium-ion Battery with Enhanced Thermal Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery with an improved electrolyte formulation exhibiting enhanced thermal stability and cycle life. The battery is designed for use in electric vehicles and portable electronic devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8455298B2\",\n            \"title\": \"Electrolyte composition for lithium-ion batteries\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte formulation comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69575", "text": "{\n    \"patent_title\": \"Solid Oxide Fuel Cell with Improved Efficiency\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-01-10\",\n    \"filing_date\": \"2017-01-10\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A solid oxide fuel cell with a novel electrode structure designed to improve efficiency and reduce operating temperature. The fuel cell utilizes hydrogen as a fuel source.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Fuel cell system with improved fuel delivery\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Method for fabricating a solid oxide fuel cell\"\n        }\n    ],\n    \"claims\": [\n        \"A solid oxide fuel cell comprising...\",\n        \"An electrode structure for a fuel cell comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69576", "text": "{\n    \"patent_title\": \"System and method for image-based object recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image-based object recognition using deep convolutional neural networks is disclosed. The system receives an image as input and identifies objects present in the image with high accuracy. Applications include autonomous driving and medical image analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760813B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for identifying objects in an image...\",\n        \"A system comprising a processor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69576", "text": "{\n    \"patent_title\": \"Method for improving audio signal clarity\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9213456B1\",\n    \"priority_date\": \"2014-12-01\",\n    \"filing_date\": \"2014-11-28\",\n    \"issue_date\": \"2015-12-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for improving the clarity of audio signals by reducing noise and enhancing speech is disclosed. The method utilizes a novel filtering technique...\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7891234B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for filtering an audio signal...\",\n        \"An apparatus for processing audio...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69577", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to improved electrode materials for lithium-ion batteries, enhancing energy density and cycle life. The materials incorporate a novel coating to improve stability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode material...\",\n        \"The electrode material of claim 1, further comprising a coating...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69577", "text": "{\n    \"patent_title\": \"Novel Flow Battery Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Green\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-15\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new flow battery design utilizing vanadium redox chemistry for large-scale energy storage.  Improves efficiency and cost-effectiveness.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A flow battery comprising a vanadium redox couple...\",\n        \"The flow battery of claim 1, characterized by a membrane...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69578", "text": "{\n    \"patent_title\": \"System and Method for Image Recognition Using Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-05-15\",\n    \"filing_date\": \"2020-06-01\",\n    \"issue_date\": \"2023-11-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition using deep neural networks. The system comprises a convolutional neural network trained to identify objects within images. The system is particularly effective in recognizing complex scenes and multiple objects within a single image. It utilizes a novel loss function to improve accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising:\",\n        \"A system for image recognition comprising:\",\n        \"A computer-readable medium storing instructions for:\",\n        \"The method of claim 1, wherein the neural network is a convolutional neural network.\",\n        \"The system of claim 2, wherein the neural network is trained using a large dataset of labeled images.\",\n        \"The method of claim 3, further comprising:\",\n        \"The system of claim 4, further comprising:\"\n    ]\n}"}
{"_id": "Academic--patents--n--69578", "text": "{\n    \"patent_title\": \"Method for Object Detection in Video Streams\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2021-03-10\",\n    \"filing_date\": \"2021-04-01\",\n    \"issue_date\": \"2023-09-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for detecting objects in video streams utilizing background subtraction and motion analysis. The system is designed for real-time applications and focuses on identifying moving objects within a video frame.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for object detection in a video stream comprising:\",\n        \"A system for object detection in a video stream comprising:\",\n        \"The method of claim 1, wherein the background subtraction is performed using a Gaussian mixture model.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69579", "text": "{\n    \"patent_title\": \"Method and System for Image Recognition Using Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2021-11-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for image recognition using deep neural networks. The system utilizes convolutional neural networks to analyze images and identify objects with high accuracy. Applications include autonomous vehicles and medical image analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Similar CNN architecture\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising:...\",\n        \"A system for image recognition comprising:...\",\n        \"The method of claim 1, wherein...\",\n        \"The system of claim 2, wherein...\",\n        \"The method of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69579", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2017-12-20\",\n    \"filing_date\": \"2018-03-10\",\n    \"issue_date\": \"2020-08-04\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a novel algorithm for lossless data compression, resulting in significant reductions in file size. It leverages Huffman coding and run-length encoding techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in data compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising:...\",\n        \"A system for data compression comprising:...\",\n        \"The method of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69580", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Natural Language Processing using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel system and method for enhancing natural language processing capabilities through the application of deep learning techniques, specifically utilizing transformer networks. The system improves accuracy in sentiment analysis and machine translation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Neural Network Architecture for Text Classification\"\n        }\n    ],\n    \"claims\": [\n        \"A system for natural language processing comprising a deep learning module.\",\n        \"A method for sentiment analysis using a transformer network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69580", "text": "{\n    \"patent_title\": \"Implantable Biosensor with AI-Powered Data Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Boston University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-08-22\",\n    \"filing_date\": \"2017-08-22\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable biosensor designed to monitor physiological parameters and utilize artificial intelligence algorithms for real-time data analysis and anomaly detection. The sensor provides early warnings for potential health issues.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Miniaturized Implantable Medical Device\"\n        },\n        {\n            \"patent_number\": \"US8987654B1\",\n            \"title\": \"Algorithms for Medical Data Processing\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable biosensor comprising an AI data analysis module.\",\n        \"A method for real-time physiological monitoring using an implantable device.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69581", "text": "{\n    \"patent_title\": \"System and method for distributed machine learning\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-15\",\n    \"filing_date\": \"2014-05-15\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for distributed machine learning using a novel data partitioning scheme.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for distributed machine learning comprising...\",\n        \"A method for partitioning data for machine learning...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69581", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emily Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2016-03-10\",\n    \"filing_date\": \"2016-03-10\",\n    \"issue_date\": \"2020-12-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery technology utilizing advanced materials to increase energy density and lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery comprising...\",\n        \"A method for manufacturing a high-density battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69582", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"XYZ Corporation\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"ABC University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-06-15\",\n    \"issue_date\": \"2018-11-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel data compression system utilizing advanced algorithms to achieve higher compression ratios and faster processing speeds.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in data compression.\"\n        }\n    ],\n    \"claims\": [\n        \"A system for compressing data...\",\n        \"A method for decompressing data...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The system of claim 1, wherein...\",\n        \"The method of claim 2, wherein...\",\n        \"The system of claim 3, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69582", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Energy Solutions Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10246813B1\",\n    \"priority_date\": \"2017-03-10\",\n    \"filing_date\": \"2017-04-10\",\n    \"issue_date\": \"2019-05-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new battery design offering increased energy density and improved cycle life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related battery technology.\"\n        }\n    ],\n    \"claims\": [\n        \"A battery comprising...\",\n        \"A method of manufacturing a battery...\",\n        \"An electrochemical cell...\",\n        \"The battery of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69583", "text": "{\n    \"patent_title\": \"System and method for neural network based image recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition utilizing a novel neural network architecture. The system efficiently processes image data and achieves high accuracy in object identification.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"cited_by\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69583", "text": "{\n    \"patent_title\": \"Improved Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-11-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel data compression algorithm utilizing Huffman coding and run-length encoding techniques. The algorithm provides improved compression ratios compared to existing methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"kind\": \"cited_by\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data comprising...\",\n        \"A system for decompressing data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69584", "text": "{\n    \"patent_title\": \"System and Method for Automated Machine Learning Model Selection\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for automated machine learning model selection using artificial intelligence techniques. The system analyzes data characteristics and selects the optimal model from a library of available models.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for automated machine learning model selection, comprising...\",\n        \"A method for identifying the optimal machine learning model...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69584", "text": "{\n    \"patent_title\": \"Improved Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Wilson\",\n            \"affiliation\": \"Tesla, Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-14\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved battery management system for electric vehicles, enhancing energy efficiency and lifespan. The system utilizes advanced algorithms for charge control and thermal management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10987654B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for an electric vehicle, comprising...\",\n        \"A method for optimizing battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69585", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Predictive Maintenance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"TechCorp Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of Innovation\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2017-05-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system and method for predicting equipment failures using artificial intelligence and machine learning algorithms. The system analyzes sensor data to identify patterns indicative of impending failures, allowing for proactive maintenance and reducing downtime.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Predictive Maintenance System\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predicting equipment failures, comprising...\",\n        \"A method for analyzing sensor data...\",\n        \"The system of claim 1, further comprising...\",\n        \"The method of claim 2, wherein the machine learning algorithm is...\",\n        \"The system of claim 3, wherein the sensor data includes...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69585", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Energy Solutions Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2016-11-01\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved battery management system for electric vehicles. The system optimizes charging and discharging cycles to extend battery life and improve performance. It does not use artificial intelligence.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Battery Management System\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling battery charging...\",\n        \"The system of claim 1, further comprising...\",\n        \"The method of claim 2, wherein the charging rate is...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69586", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for enhanced image recognition using deep convolutional neural networks. The system is capable of identifying objects with high accuracy even in challenging conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for identifying objects in an image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69586", "text": "{\n    \"patent_title\": \"Method for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2018-08-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel method for compressing digital data efficiently. It utilizes a combination of Huffman coding and Lempel-Ziv algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data comprising...\",\n        \"An apparatus for data compression...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69587", "text": "{\n    \"patent_title\": \"High-Performance Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-14\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel electrode materials for lithium-ion batteries, exhibiting improved energy density and cycle life. The materials are based on a new composite structure incorporating nickel-manganese-cobalt oxides and graphene.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"keywords\": [\n                \"cathode\",\n                \"electrolyte\",\n                \"energy storage\"\n            ]\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode material...\",\n        \"The electrode material according to claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69587", "text": "{\n    \"patent_title\": \"Battery Management System with Advanced Thermal Control\",\n    \"inventors\": [\n        {\n            \"name\": \"Elena Rodriguez\",\n            \"affiliation\": \"Texas A&M University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2012-05-20\",\n    \"filing_date\": \"2012-05-19\",\n    \"issue_date\": \"2020-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) designed to optimize thermal performance and extend the lifespan of lithium-ion battery packs. The BMS incorporates advanced algorithms for temperature monitoring and control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8987654B2\",\n            \"keywords\": [\n                \"battery management\",\n                \"thermal control\",\n                \"lithium-ion\"\n            ]\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"keywords\": [\n                \"battery management system\",\n                \"temperature sensors\"\n            ]\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"The battery management system according to claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69588", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Processing in Automotive Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-04-15\",\n    \"issue_date\": \"2018-05-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for enhancing image processing in automotive applications, specifically for improved object detection in autonomous vehicles. The system utilizes advanced algorithms to reduce noise and improve image clarity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Filtering Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image enhancement...\",\n        \"A method for object detection...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69588", "text": "{\n    \"patent_title\": \"Medical Image Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Healthcare Innovations Ltd.\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-01-20\",\n    \"filing_date\": \"2017-02-20\",\n    \"issue_date\": \"2019-06-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel approach to medical image reconstruction using deep learning techniques. The method improves the quality and speed of image reconstruction for MRI and CT scans.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Medical Imaging Systems\"\n        },\n        {\n            \"patent_number\": \"US8901234B1\",\n            \"title\": \"Image Analysis for Disease Detection\"\n        }\n    ],\n    \"claims\": [\n        \"A method for medical image reconstruction...\",\n        \"A system for improving image quality...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69589", "text": "{\n    \"patent_title\": \"System and method for training a neural network using adaptive learning rates\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-14\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for training a neural network using adaptive learning rates is disclosed. The system dynamically adjusts the learning rate for each weight in the neural network based on the historical gradients observed during training. This approach improves convergence speed and reduces the risk of getting stuck in local minima.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"Prior art in neural network training\"\n        }\n    ],\n    \"claims\": [\n        \"A method for training a neural network comprising...\",\n        \"A system for training a neural network comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69589", "text": "{\n    \"patent_title\": \"Improved Optical Lens Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Optics\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"XYZ Optics\"\n        },\n        {\n            \"name\": \"Emily Wilson\",\n            \"affiliation\": \"XYZ Optics\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-12-20\",\n    \"filing_date\": \"2010-01-10\",\n    \"issue_date\": \"2018-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved optical lens design with enhanced light transmission and reduced chromatic aberration is presented. The lens utilizes a novel arrangement of refractive elements to achieve superior image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B2\",\n            \"relevance\": \"Prior art in optical lens design\"\n        }\n    ],\n    \"claims\": [\n        \"An optical lens comprising...\",\n        \"A method for manufacturing an optical lens comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69590", "text": "{\n    \"patent_title\": \"High-Performance Lithium-Ion Battery with Novel Electrolyte\",\n    \"inventors\": [\n        {\n            \"name\": \"Yi Cui\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Xiaolin Zheng\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery comprising a novel electrolyte formulation exhibiting improved ionic conductivity and enhanced thermal stability. The battery demonstrates high performance in terms of energy density, power density, and cycle life. This invention significantly improves upon existing lithium-ion battery technology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte formulation...\",\n        \"A method for manufacturing...\",\n        \"The battery according to claim 1...\",\n        \"The electrolyte formulation according to claim 2...\",\n        \"The method according to claim 3...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69590", "text": "{\n    \"patent_title\": \"Improved Lead-Acid Battery Design\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2020-10-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved lead-acid battery design incorporating a novel electrode structure for enhanced charge acceptance and reduced sulfation. This invention aims to extend the lifespan and performance of traditional lead-acid batteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A lead-acid battery comprising...\",\n        \"An electrode structure...\",\n        \"A method for manufacturing...\",\n        \"The battery according to claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69591", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for image recognition utilizing artificial intelligence and deep learning algorithms. The system can accurately identify objects in images with high precision.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training an AI model...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69591", "text": "{\n    \"patent_title\": \"Improved Mechanical Gear Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2014-12-20\",\n    \"filing_date\": \"2014-12-20\",\n    \"issue_date\": \"2018-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel gear design that improves efficiency and reduces wear. The design incorporates a unique tooth profile to minimize friction and enhance durability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A gear comprising...\",\n        \"A method for manufacturing a gear...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69592", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Processing in Autonomous Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Tesla, Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for real-time image processing in autonomous vehicles, utilizing deep learning algorithms to identify objects and navigate complex environments. The system optimizes for low latency and high accuracy in challenging lighting conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"abstract_keywords\": [\n                \"object detection\",\n                \"computer vision\"\n            ]\n        }\n    ],\n    \"claims\": [\n        \"A system for image processing in a vehicle...\",\n        \"A method for object recognition...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69592", "text": "{\n    \"patent_title\": \"Medical Image Analysis System with Enhanced Segmentation\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2018-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A medical image analysis system employing advanced segmentation techniques for improved diagnosis of cancerous tumors. The system utilizes convolutional neural networks for accurate tumor boundary delineation in MRI and CT scans.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"abstract_keywords\": [\n                \"medical imaging\",\n                \"tumor detection\"\n            ]\n        },\n        {\n            \"patent_number\": \"US8901234B1\",\n            \"abstract_keywords\": [\n                \"image segmentation\",\n                \"cancer diagnosis\"\n            ]\n        }\n    ],\n    \"claims\": [\n        \"A system for medical image segmentation...\",\n        \"A method for tumor detection in medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69593", "text": "{\n    \"patent_title\": \"Neural Network Based Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel neural network architecture for image recognition. It achieves state-of-the-art accuracy on benchmark datasets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising a neural network...\",\n        \"A method for training a neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69593", "text": "{\n    \"patent_title\": \"Improved Combustion Engine Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Motors\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2019-11-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved combustion engine design featuring a novel fuel injection system, increasing efficiency and reducing emissions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A combustion engine comprising a novel fuel injection system...\",\n        \"A method for operating a combustion engine...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69594", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Processing using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for enhancing image processing tasks using deep learning algorithms. The system utilizes convolutional neural networks to improve image clarity, reduce noise, and perform object recognition with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Prior Art Image Processing Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image using a convolutional neural network.\",\n        \"A system comprising a processor and a memory for performing image processing tasks.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69594", "text": "{\n    \"patent_title\": \"Novel Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel algorithm for lossless data compression, achieving high compression ratios while maintaining data integrity. It can be applied to various data types, including text, images, and audio.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Existing Data Compression Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data using a novel algorithm.\",\n        \"A system for performing data compression.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69595", "text": "{\n    \"patent_title\": \"Wireless Temperature Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless sensor system for remote temperature monitoring. The system utilizes low-power sensors and a cloud-based data platform for efficient data collection and analysis. This sensor can be used in environmental monitoring and industrial automation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor system comprising...\",\n        \"A method for remote temperature monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69595", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-09\",\n    \"issue_date\": \"2020-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor for continuous monitoring of blood glucose levels. This device aims to improve diabetes management by providing real-time glucose data to patients and healthcare professionals.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"type\": \"cited_by\"\n        },\n        {\n            \"patent_number\": \"US8000001B1\",\n            \"type\": \"related\"\n        },\n        {\n            \"patent_number\": \"US7777777B1\",\n            \"type\": \"medical device\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable glucose sensor comprising...\",\n        \"A method for continuous glucose monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69596", "text": "{\n    \"patent_title\": \"Method and System for Image Enhancement Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing images using deep convolutional neural networks. The system is capable of improving image resolution, reducing noise, and enhancing visual details.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        },\n        {\n            \"patent_number\": \"US9543210B1\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\"\n        },\n        {\n            \"patent_number\": \"US9765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image comprising...\",\n        \"A system for processing images...\",\n        \"A non-transitory computer-readable medium...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69596", "text": "{\n    \"patent_title\": \"System for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2017-09-10\",\n    \"filing_date\": \"2017-09-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A data compression system using Huffman coding and run-length encoding to reduce file sizes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US4567890B1\"\n        },\n        {\n            \"patent_number\": \"US5678901B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data comprising...\",\n        \"A system for encoding and decoding data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69597", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Neural Network Training\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2020-01-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the training of neural networks are disclosed. The invention utilizes a novel backpropagation algorithm to improve convergence speed and accuracy. This leads to more efficient and robust neural network models.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for training a neural network...\",\n        \"A system comprising a processor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69597", "text": "{\n    \"patent_title\": \"Improved Image Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2021-11-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel image compression algorithm that achieves higher compression ratios with minimal loss of image quality. It utilizes wavelet transforms and entropy coding techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image...\",\n        \"A system for decoding a compressed image...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69598", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2013-02-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for image recognition utilizing artificial intelligence techniques, specifically convolutional neural networks. The system achieves high accuracy in identifying objects within images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for identifying objects in an image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69598", "text": "{\n    \"patent_title\": \"Improved Mechanical Gear Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2009-12-10\",\n    \"filing_date\": \"2009-12-10\",\n    \"issue_date\": \"2012-08-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel gear design incorporating optimized tooth profiles to reduce friction and improve efficiency. The gear is manufactured using a precision milling process.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A gear comprising a tooth profile...\",\n        \"A method for manufacturing a gear...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69599", "text": "{\n    \"patent_title\": \"System and Method for Thermal Management of Lithium-Ion Batteries in Portable Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"TechCorp Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"TechCorp Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for thermal management of lithium-ion batteries in portable devices, improving battery life and safety by optimizing cooling and heating strategies. The system includes sensors, a controller, and a thermal management unit.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Battery Cooling Apparatus\"\n        }\n    ],\n    \"claims\": [\n        \"A thermal management system for a battery comprising...\",\n        \"A method for controlling the temperature of a battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69599", "text": "{\n    \"patent_title\": \"Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"AutoTech Solutions\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-04-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system specifically designed for electric vehicles, focusing on efficient energy utilization and extended driving range. This system optimizes charging and discharging cycles for enhanced battery performance in EV applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Electric Vehicle Powertrain Control\"\n        },\n        {\n            \"patent_number\": \"US8987654B1\",\n            \"title\": \"Lithium-Ion Battery Pack for EVs\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for an electric vehicle comprising...\",\n        \"A method for controlling the charging of a battery in an electric vehicle...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69600", "text": "{\n    \"patent_title\": \"High-Efficiency Perovskite Solar Cell with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Li Wei\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Maria Rodriguez\",\n            \"affiliation\": \"National Renewable Energy Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel perovskite solar cell structure with improved long-term stability and efficiency is disclosed. The cell incorporates a modified electron transport layer and a hydrophobic encapsulation method to prevent degradation. The device achieves a power conversion efficiency of 25.2%.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A perovskite solar cell comprising an active layer...\",\n        \"The solar cell of claim 1, further comprising an electron transport layer...\",\n        \"A method for fabricating the solar cell of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69600", "text": "{\n    \"patent_title\": \"Photovoltaic System with Integrated DC-DC Inverter\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"SunPower Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A photovoltaic system is disclosed, comprising a solar panel and an integrated DC-DC inverter for converting the DC power generated by the panel to AC power. The inverter improves system efficiency and reduces overall system cost.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A photovoltaic system comprising a solar panel and a DC-DC inverter...\",\n        \"The photovoltaic system of claim 1, wherein the inverter is integrated with the solar panel...\",\n        \"A method for converting DC power to AC power using the photovoltaic system of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69601", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Fraud Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Data Analytics Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for detecting fraudulent transactions using artificial intelligence and machine learning algorithms. The system analyzes transaction data to identify patterns indicative of fraud.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A system for detecting fraudulent transactions...\",\n        \"A method comprising analyzing transaction data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69601", "text": "{\n    \"patent_title\": \"Automated Medical Diagnosis System Using AI\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Healthcare Innovations\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Medical Research Institute\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-22\",\n    \"filing_date\": \"2017-03-22\",\n    \"issue_date\": \"2018-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an automated system for diagnosing medical conditions using artificial intelligence. The system analyzes medical images and patient data to provide accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Medical Imaging Device\"\n        }\n    ],\n    \"claims\": [\n        \"A system for diagnosing medical conditions...\",\n        \"A method comprising analyzing medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69602", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Jane Doe\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Dr. John Smith\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel electrode materials for lithium-ion batteries exhibiting enhanced energy density and cycle life. The materials comprise a unique nanostructure that facilitates rapid lithium-ion transport.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode material...\",\n        \"The electrode material of claim 1, wherein the nanostructure...\",\n        \"A method for manufacturing the electrode material...\",\n        \"The method of claim 3, further comprising...\",\n        \"A device utilizing the lithium-ion battery...\",\n        \"Claim 6, wherein the device is a portable electronic device.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69602", "text": "{\n    \"patent_title\": \"Advanced Solar Cell Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Bob Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new architecture for solar cells, improving efficiency and reducing manufacturing costs. It employs perovskite materials with enhanced light absorption characteristics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A solar cell comprising a perovskite layer...\",\n        \"The solar cell of claim 1, wherein the perovskite layer...\",\n        \"A method for fabricating the solar cell...\",\n        \"The method of claim 3, further comprising a doping step.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69603", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Enhancement System\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel image enhancement system leveraging deep learning techniques to improve image quality and resolution. The system utilizes convolutional neural networks to remove noise and enhance details in images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B1\",\n            \"title\": \"Image Processing Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing images using a deep neural network.\",\n        \"A system comprising a deep neural network configured to process image data.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69603", "text": "{\n    \"patent_title\": \"Method for Color Space Conversion\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US98765432B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2018-11-01\",\n    \"issue_date\": \"2022-02-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new method for converting images between different color spaces, offering improved accuracy and efficiency.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for converting an image from RGB to YCbCr color space.\",\n        \"A system for real-time color space conversion.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69604", "text": "{\n    \"patent_title\": \"System and method for AI-driven image recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition using artificial intelligence and deep learning techniques. The system utilizes convolutional neural networks to identify objects within images with high accuracy. The system is applicable to a wide range of image recognition tasks including medical image analysis, autonomous driving, and security surveillance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for image recognition comprising...\",\n        \"2. The system of claim 1, wherein the artificial intelligence...\",\n        \"3. A method for performing image recognition...\",\n        \"4. The method of claim 3, further comprising...\",\n        \"5. The system of claim 1, wherein the image is a medical image...\",\n        \"6. The system of claim 5, wherein the artificial intelligence diagnoses...\",\n        \"7. The method of claim 3, wherein the deep learning model...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69604", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Motors\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel battery cell design utilizing improved electrolyte materials and electrode structures to enhance energy density and cycle life for electric vehicle applications. The design optimizes ion transport and minimizes degradation, resulting in a more efficient and durable battery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"1. A battery cell comprising...\",\n        \"2. The battery cell of claim 1, wherein the electrolyte...\",\n        \"3. A battery pack comprising...\",\n        \"4. The battery pack of claim 3, for use in an electric vehicle.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69605", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Predictive Maintenance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Data Solutions Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2018-03-01\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for predictive maintenance using artificial intelligence algorithms. The system analyzes sensor data to predict equipment failure and optimize maintenance schedules.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predicting equipment failure comprising...\",\n        \"A method for optimizing maintenance schedules...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69605", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking Mechanism\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"CycleTech Corp.\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"CycleTech Corp.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2018-02-15\",\n    \"issue_date\": \"2019-11-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved braking mechanism for bicycles, providing enhanced stopping power and rider safety. It features a novel caliper design and pad material.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A bicycle braking mechanism comprising...\",\n        \"A caliper design for improved stopping power...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69606", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a miniaturized wireless pressure sensor system for biomedical applications. The system incorporates a novel MEMS pressure sensor and a low-power communication module. The sensor is highly sensitive and can be used for continuous monitoring of physiological parameters.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A MEMS pressure sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69606", "text": "{\n    \"patent_title\": \"Advanced Image Processing Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-01-10\",\n    \"filing_date\": \"2017-01-10\",\n    \"issue_date\": \"2020-02-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel image processing algorithm for enhancing image quality and reducing noise. It utilizes a combination of wavelet transforms and adaptive filtering techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"An image processing algorithm comprising...\",\n        \"A wavelet transform module...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69607", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system is disclosed. The system comprises a micro-electromechanical system (MEMS) pressure sensor, a wireless communication module, and a power management unit. The sensor is suitable for biomedical applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"similar pressure sensing technology\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"The system of claim 1, wherein the sensor is a MEMS device.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69607", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2019-02-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system is described. This system optimizes charging and discharging cycles to extend battery life and improve safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"related battery technology\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"The system of claim 1, wherein the charging is optimized...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69608", "text": "{\n    \"patent_title\": \"Enhanced Electrolyte Composition for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-14\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel electrolyte composition for lithium-ion batteries is disclosed, enhancing battery performance and safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related art in electrolyte formulation\"\n        },\n        {\n            \"patent_number\": \"US8236549B2\",\n            \"relevance\": \"Previous work on lithium-ion battery stability\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Comparative analysis of electrolyte additives\"\n        },\n        {\n            \"patent_number\": \"US10234567B2\",\n            \"relevance\": \"Impact of electrolyte conductivity on cell performance\"\n        },\n        {\n            \"patent_number\": \"US11345678B2\",\n            \"relevance\": \"Advanced material composition studies\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrolyte composition...\",\n        \"The electrolyte composition of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69608", "text": "{\n    \"patent_title\": \"A Method for Optimizing Lithium-Ion Battery Performance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2012-05-10\",\n    \"filing_date\": \"2012-05-09\",\n    \"issue_date\": \"2018-11-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for dynamically adjusting the charging parameters of a lithium-ion battery to maximize its lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"relevance\": \"Charging algorithm optimization\"\n        },\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"relevance\": \"Battery management systems\"\n        }\n    ],\n    \"claims\": [\n        \"A method for charging a lithium-ion battery comprising...\",\n        \"The method of claim 1, wherein the charging parameters are adjusted...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69609", "text": "{\n    \"patent_title\": \"Method and system for enhanced image processing using deep learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for enhancing image quality using deep learning techniques. It addresses issues in image processing such as noise reduction and edge detection. The method leverages convolutional neural networks to achieve superior results.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for enhancing an image comprising...\",\n        \"2. The method of claim 1, wherein...\",\n        \"3. A system for enhancing an image...\",\n        \"4. The system of claim 3, further comprising...\",\n        \"5. The method of claim 1, wherein the neural network is a convolutional neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69609", "text": "{\n    \"patent_title\": \"Apparatus for Automated Data Storage\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"IBM Corp.\"\n        }\n    ],\n    \"patent_number\": \"US10293847B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An apparatus for automated data storage and retrieval is disclosed. The invention utilizes a novel magnetic storage medium to improve data density and access speeds.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"1. An apparatus for storing data comprising...\",\n        \"2. The apparatus of claim 1, wherein...\",\n        \"3. A method for retrieving data from the apparatus...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69610", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Safety Features\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery design incorporating a solid-state electrolyte and a temperature-sensitive shutdown mechanism for enhanced safety and performance.  The battery exhibits improved energy density and cycle life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art related to lithium-ion battery electrolytes.\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"The battery of claim 1, wherein the electrolyte is solid-state.\",\n        \"The battery of claim 1, further comprising a temperature sensor.\",\n        \"The battery of claim 3, wherein the temperature sensor activates a shutdown mechanism.\",\n        \"A method of manufacturing the lithium-ion battery of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69610", "text": "{\n    \"patent_title\": \"Improved Lead-Acid Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-11-01\",\n    \"filing_date\": \"2009-11-01\",\n    \"issue_date\": \"2017-05-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new lead-acid battery design utilizing a modified electrode structure to improve charge acceptance and reduce sulfation. This design extends battery life and reduces maintenance requirements.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"relevance\": \"Prior art related to lead-acid battery electrodes.\"\n        }\n    ],\n    \"claims\": [\n        \"A lead-acid battery comprising...\",\n        \"The battery of claim 1, wherein the electrode structure is modified.\",\n        \"The battery of claim 2, wherein the modification reduces sulfation.\",\n        \"A method of manufacturing the lead-acid battery of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69611", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for remote monitoring applications. The system utilizes a MEMS pressure sensor and low-power wireless communication.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Wireless Sensor Networks\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for remote pressure monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69611", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Jones\",\n            \"affiliation\": \"Tesla\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-07-22\",\n    \"issue_date\": \"2021-08-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles, enhancing performance and lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"title\": \"Lithium-Ion Battery Technology\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery performance...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69612", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Safety Features\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-06-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery design incorporating a novel solid electrolyte and a thermally stable separator, improving safety and performance. This invention addresses the risk of thermal runaway in high-energy-density batteries, making them suitable for portable electronics and grid-scale energy storage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8236421B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising a solid electrolyte...\",\n        \"A battery separator capable of withstanding temperatures up to 300°C...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69612", "text": "{\n    \"patent_title\": \"Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Motors\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Tesla Motors\"\n        }\n    ],\n    \"patent_number\": \"US10458321B2\",\n    \"priority_date\": \"2017-09-22\",\n    \"filing_date\": \"2017-09-22\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) for electric vehicles, designed to optimize charging and discharging cycles, and extend battery life. The BMS incorporates advanced algorithms for cell balancing and state-of-charge estimation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9124043B2\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US20150315402A1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for an electric vehicle...\",\n        \"A method for optimizing charging cycles in an electric vehicle battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69613", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications. The system utilizes a MEMS pressure sensor and a low-power wireless communication module. It is suitable for in-vivo monitoring of physiological parameters.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Wireless Sensor Network\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"The system of claim 1, wherein the sensor is a MEMS device.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69613", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-15\",\n    \"issue_date\": \"2020-07-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This patent describes a novel lithium-ion battery with increased energy density and cycle life. The improved electrolyte composition enhances ion conductivity and reduces degradation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Lithium-Ion Battery with Enhanced Stability\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"The battery of claim 1, wherein the electrolyte contains...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69614", "text": "{\n    \"patent_title\": \"Method and System for Real-Time Image Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for real-time image enhancement using advanced image processing techniques. The system analyzes images and automatically adjusts contrast, brightness, and sharpness to improve visual clarity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for real-time image enhancement comprising...\",\n        \"A system for implementing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69614", "text": "{\n    \"patent_title\": \"Novel Semiconductor Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US1234567B2\",\n    \"priority_date\": \"2009-12-01\",\n    \"filing_date\": \"2009-12-01\",\n    \"issue_date\": \"2017-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel semiconductor device with improved performance characteristics.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A semiconductor device comprising...\",\n        \"A method for manufacturing the device of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69615", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-14\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel electrode materials for lithium-ion batteries, exhibiting improved energy density and cycle life. The materials are based on a new composite structure and a unique doping process.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Lithium-Ion Battery Cathode Materials\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode material...\",\n        \"The electrode material of claim 1, wherein the material is a composite...\",\n        \"A method for manufacturing a lithium-ion battery...\",\n        \"The method of claim 3, wherein the doping process...\",\n        \"A lithium-ion battery cell...\",\n        \"The battery cell of claim 5, comprising...\",\n        \"An electronic device utilizing the battery cell of claim 5.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69615", "text": "{\n    \"patent_title\": \"Advanced Automotive Fuel Injection System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Motors\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Ford Motor Company\"\n        }\n    ],\n    \"patent_number\": \"US8901234B1\",\n    \"priority_date\": \"2012-04-20\",\n    \"filing_date\": \"2012-04-19\",\n    \"issue_date\": \"2018-11-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a fuel injection system for internal combustion engines, improving fuel efficiency and reducing emissions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"title\": \"Fuel Injection Control System\"\n        }\n    ],\n    \"claims\": [\n        \"A fuel injection system comprising an injector...\",\n        \"The fuel injection system of claim 1, wherein the injector...\",\n        \"A method for controlling fuel injection...\",\n        \"The method of claim 3, wherein the control algorithm...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69616", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2020-06-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to improved electrode materials for lithium-ion batteries, enhancing energy density and cycle life. New composite materials based on lithium metal oxides are disclosed.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrode comprising...\",\n        \"A method of manufacturing...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69616", "text": "{\n    \"patent_title\": \"Novel Fuel Cell Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2021-02-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel fuel cell design utilizing a proton exchange membrane. It offers improved efficiency and reduced cost compared to existing fuel cell technologies.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A fuel cell comprising...\",\n        \"A method for operating...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69617", "text": "{\n    \"patent_title\": \"Improved Catalyst for Polyolefin Production\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Dow Chemical\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel catalyst composition for the production of polyolefins. The catalyst exhibits enhanced activity and selectivity, resulting in polymers with improved properties. The catalyst comprises a metallocene component supported on a modified silica carrier.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A catalyst composition comprising...\",\n        \"A method for producing polyolefins using the catalyst...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69617", "text": "{\n    \"patent_title\": \"System and Method for Dynamic Data Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Google\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-12-10\",\n    \"filing_date\": \"2018-02-01\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for dynamic data analysis using advanced software algorithms. The system allows users to explore and visualize complex datasets in real-time, identifying patterns and trends. The software includes a graphical user interface and a powerful data processing engine.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US12345678B2\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A system for dynamic data analysis comprising a software module...\",\n        \"A method for visualizing data using the system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69618", "text": "{\n    \"patent_title\": \"System and method for neural network based image recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2018-03-01\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system and method for image recognition using a convolutional neural network. The system processes images to identify objects with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"similar image processing technique\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising a convolutional neural network.\",\n        \"A method for processing images using a neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69618", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"California Institute of Technology (Caltech)\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2018-02-15\",\n    \"issue_date\": \"2019-04-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved bicycle brake system utilizing a novel cable tensioning mechanism for enhanced braking performance and safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"prior art brake design\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle brake system comprising a novel cable tensioning mechanism.\",\n        \"A method for enhancing braking performance using a bicycle brake system.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69619", "text": "{\n    \"patent_title\": \"Neural Network Based Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition using a deep neural network architecture. The system is capable of identifying objects with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69619", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"IBM Research\"\n        }\n    ],\n    \"patent_number\": \"US10246813B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An efficient algorithm for lossless data compression. The algorithm utilizes advanced techniques to minimize file size.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising...\",\n        \"A system for encoding data...\"\n    ]\n}"}
