{"_id": "Academic--patents--p--66628", "text": "{\n    \"patent_title\": \"System and method for adaptive image compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-03-15\",\n    \"filing_date\": \"2015-06-20\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An adaptive image compression system and method are disclosed. The system adjusts compression parameters based on image content to optimize image quality and file size.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image compression using wavelet transform\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Lossy image compression technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image comprising...\",\n        \"A system for compressing an image comprising...\"\n    ]\n}"}
