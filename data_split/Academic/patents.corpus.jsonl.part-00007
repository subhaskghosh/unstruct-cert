{"_id": "Academic--patents--p--66924", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized wireless pressure sensor system utilizing MEMS technology for precise and real-time pressure monitoring. The system includes a low-power sensor, a wireless communication module, and a data processing unit. This sensor is suitable for various applications, including medical devices and industrial automation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US11998877B2\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"The system of claim 1, wherein the sensor is a MEMS device...\",\n        \"A method for monitoring pressure using the system of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66924", "text": "{\n    \"patent_title\": \"Advanced Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-01-05\",\n    \"filing_date\": \"2021-06-15\",\n    \"issue_date\": \"2023-02-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An advanced battery management system for electric vehicles. The system optimizes battery performance, extends battery life, and enhances safety by monitoring voltage, current, and temperature. It features sophisticated algorithms for charge and discharge control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US91234567B2\"\n        },\n        {\n            \"patent_number\": \"US10234567B1\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"The system of claim 1, wherein the battery is a lithium-ion battery...\",\n        \"A method for controlling battery charge using the system of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66925", "text": "{\n    \"patent_title\": \"System and Method for Adaptive Beamforming in Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-05-15\",\n    \"filing_date\": \"2010-03-20\",\n    \"issue_date\": \"2019-07-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for adaptive beamforming in wireless communication networks are disclosed. The system dynamically adjusts beam patterns to optimize signal strength and minimize interference.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for adaptive beamforming comprising...\",\n        \"A system for adaptive beamforming comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66925", "text": "{\n    \"patent_title\": \"Improved Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Emily Davis\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2008-11-01\",\n    \"filing_date\": \"2011-06-10\",\n    \"issue_date\": \"2020-02-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles is disclosed, enhancing battery life and safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8907890B2\",\n            \"relevance\": \"similar\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for managing battery charge comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66926", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2019-06-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method and system for enhanced image processing, utilizing advanced algorithms to improve image clarity and resolution. The system includes a preprocessing stage, an image enhancement stage, and a post-processing stage. Applications include medical imaging and satellite imagery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Image Enhancement Technique\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for enhancing an image comprising...\",\n        \"2. The method of claim 1, wherein...\",\n        \"3. A system for enhancing an image...\",\n        \"4. The system of claim 3, wherein...\",\n        \"5. The method of claim 1, further comprising...\",\n        \"6. The system of claim 3, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66926", "text": "{\n    \"patent_title\": \"Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-05-20\",\n    \"issue_date\": \"2018-11-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a new data compression algorithm that reduces file sizes without significant loss of information. It uses a combination of Huffman coding and Lempel-Ziv techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Efficient Data Compression\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for compressing data comprising...\",\n        \"2. The method of claim 1, wherein...\",\n        \"3. A system for compressing data...\",\n        \"4. The system of claim 3, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66927", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for improving image recognition accuracy using deep convolutional neural networks. The system incorporates attention mechanisms and transfer learning techniques to achieve state-of-the-art performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a deep neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66927", "text": "{\n    \"patent_title\": \"Improved Battery Charging Circuit\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-11-20\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2021-04-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery charging circuit that provides faster and more efficient charging for lithium-ion batteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A battery charging circuit comprising...\",\n        \"A method for controlling the charging process...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66928", "text": "{\n    \"patent_title\": \"Neural Network Based Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2019-03-10\",\n    \"issue_date\": \"2021-07-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel neural network architecture for image recognition, achieving state-of-the-art accuracy on benchmark datasets. The system utilizes a convolutional neural network with a unique attention mechanism.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Prior Art Image Processing Method\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A neural network architecture...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66928", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2018-09-05\",\n    \"issue_date\": \"2022-03-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved battery management system for electric vehicles, enhancing energy efficiency and lifespan. The system utilizes advanced control algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Conventional Battery Management System\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system...\",\n        \"A control algorithm...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66929", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-06-20\",\n    \"issue_date\": \"2022-01-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition utilizing artificial intelligence techniques, specifically convolutional neural networks, is disclosed. The system provides improved accuracy and efficiency in identifying objects within images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for identifying objects in an image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66929", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corp\"\n        }\n    ],\n    \"patent_number\": \"US7654321B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-08-12\",\n    \"issue_date\": \"2023-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A bicycle brake system with enhanced stopping power and modulation. The system utilizes a novel hydraulic design and improved brake pad material.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle brake system comprising...\",\n        \"A hydraulic brake line configured...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66930", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Restoration Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2022-08-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the quality of images using a deep learning model. The system utilizes a convolutional neural network to remove noise and artifacts from images, resulting in improved visual clarity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Denoising Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for restoring an image comprising...\",\n        \"The method of claim 1, wherein the deep learning model is a convolutional neural network.\",\n        \"A system for restoring an image comprising...\",\n        \"The system of claim 3, further comprising a user interface.\",\n        \"The method of claim 2, wherein the convolutional neural network includes at least 10 layers.\",\n        \"The system of claim 4, wherein the user interface allows for adjusting parameters of the restoration process.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66930", "text": "{\n    \"patent_title\": \"Digital Image Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-31\",\n    \"issue_date\": \"2021-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel algorithm for compressing digital images, reducing file size while maintaining acceptable image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"JPEG Compression Standard\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image comprising...\",\n        \"The method of claim 1, wherein the image is a grayscale image.\",\n        \"A system for compressing an image comprising...\",\n        \"The system of claim 3, further comprising a storage device.\"\n    ]\n}"}
