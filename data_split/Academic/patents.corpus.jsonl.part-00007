{"_id": "Academic--patents--p--66189", "text": "{\n    \"patent_title\": \"System and method for intelligent data analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system and method for intelligent data analysis utilizing artificial intelligence techniques to identify patterns and anomalies in large datasets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for analyzing data comprising...\",\n        \"A method for identifying patterns in data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66189", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Independent Inventor\"\n        }\n    ],\n    \"patent_number\": \"US9876544B2\",\n    \"priority_date\": \"2015-11-01\",\n    \"filing_date\": \"2015-11-01\",\n    \"issue_date\": \"2018-08-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention is a braking system for bicycles, utilizing a novel cable tension mechanism to provide improved stopping power and reliability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A braking system for a bicycle comprising...\",\n        \"A cable tension mechanism for a bicycle brake...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66190", "text": "{\n    \"patent_title\": \"Method and system for enhanced image restoration using deep learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2020-12-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing image quality by utilizing deep learning techniques to restore degraded images. The system employs a convolutional neural network trained on a large dataset of images to effectively remove noise and artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Denoising Algorithm\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Super-Resolution Image Reconstruction\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Adaptive Image Filtering\"\n        },\n        {\n            \"patent_number\": \"US8901234B1\",\n            \"title\": \"Image Enhancement Using Wavelets\"\n        },\n        {\n            \"patent_number\": \"US11000001B2\",\n            \"title\": \"Deep Learning for Image Segmentation\"\n        }\n    ],\n    \"claims\": [\n        \"A method for restoring an image comprising...\",\n        \"A system for enhancing image quality comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66190", "text": "{\n    \"patent_title\": \"Novel Method for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2019-01-10\",\n    \"filing_date\": \"2019-06-05\",\n    \"issue_date\": \"2021-04-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new data compression algorithm that achieves high compression ratios with minimal loss of information. The method utilizes a combination of entropy encoding and transform coding techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US91234567B2\",\n            \"title\": \"Lossless Data Compression\"\n        },\n        {\n            \"patent_number\": \"US10234567B1\",\n            \"title\": \"Variable Length Coding\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data comprising...\",\n        \"A system for data compression comprising...\"\n    ]\n}"}
