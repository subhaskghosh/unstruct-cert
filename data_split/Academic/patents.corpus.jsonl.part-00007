{"_id": "Academic--patents--n--66606", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-08-01\",\n    \"filing_date\": \"2020-06-15\",\n    \"issue_date\": \"2021-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a braking system for bicycles, utilizing a novel cable tensioning mechanism to improve stopping power and responsiveness. It provides enhanced safety for cyclists.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle braking system comprising...\",\n        \"A cable tensioning mechanism...\"\n    ]\n}"}
