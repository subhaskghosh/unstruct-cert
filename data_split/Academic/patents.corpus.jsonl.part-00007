{"_id": "Academic--patents--n--69800", "text": "{\n    \"patent_title\": \"Improved Battery Charging Circuit\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2010-12-10\",\n    \"filing_date\": \"2010-12-10\",\n    \"issue_date\": \"2018-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel circuit design for improving battery charging efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\"\n        },\n        {\n            \"patent_number\": \"US9123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A charging circuit comprising...\",\n        \"A battery system utilizing the charging circuit...\"\n    ]\n}"}
