{"_id": "Academic--patents--n--66873", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-11-10\",\n    \"filing_date\": \"2019-11-10\",\n    \"issue_date\": \"2022-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system optimized for lithium-ion batteries, improving charging efficiency and lifespan. The system employs advanced algorithms for state-of-charge estimation and thermal management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66874", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Intel Corporation\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system is disclosed. The system utilizes a MEMS pressure sensor and a low-power communication module for remote monitoring of pressure levels. This is useful in a variety of applications including medical devices and industrial control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A pressure sensor system comprising...\",\n        \"A wireless communication module...\"\n    ]\n}"}
