{"_id": "Academic--patents--p--66011", "text": "{\n    \"patent_title\": \"AI-Powered Predictive Maintenance System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for predicting equipment failures using artificial intelligence and machine learning algorithms. The system analyzes sensor data to identify patterns indicative of impending failures, enabling proactive maintenance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Predictive Maintenance Using Sensor Data\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for predicting equipment failures comprising...\",\n        \"2. The system of claim 1, wherein the artificial intelligence algorithm is a deep neural network.\",\n        \"3. A method for predicting equipment failures comprising...\",\n        \"4. The method of claim 3, wherein the sensor data includes vibration data.\",\n        \"5. The method of claim 3, wherein the sensor data includes temperature data.\",\n        \"6. The method of claim 3, wherein the sensor data includes pressure data.\",\n        \"7. A computer-readable medium storing instructions that, when executed, cause a computer to perform the method of claim 3.\"\n    ]\n}"}
