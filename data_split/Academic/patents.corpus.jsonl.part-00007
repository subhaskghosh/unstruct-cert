{"_id": "Academic--patents--p--66593", "text": "{\n    \"patent_title\": \"Method and System for Neural Network-Based Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-11-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for image recognition using a deep neural network. The system utilizes convolutional neural networks to extract features from images and classify them with high accuracy. Applications include autonomous driving and medical image analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for image recognition comprising...\",\n        \"2. A system for image recognition comprising...\",\n        \"3. The method of claim 1, wherein...\",\n        \"4. The system of claim 2, wherein...\",\n        \"5. A computer-readable medium storing instructions...\",\n        \"6. The method of claim 3, further comprising...\",\n        \"7. The system of claim 4, further comprising...\"\n    ]\n}"}
