{"_id": "Academic--patents--p--66068", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2018-03-01\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for improving the accuracy of image recognition using a deep learning architecture. The system employs a novel convolutional neural network (CNN) to extract features from images and classify them with high precision.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for classifying images...\"\n    ]\n}"}
