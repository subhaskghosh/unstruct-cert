{"_id": "Academic--patents--p--66819", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Thermal Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel lithium-ion battery design with enhanced thermal stability achieved through a unique electrolyte composition and electrode material. The battery exhibits improved safety characteristics and extended lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related prior art on electrolyte compositions\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition...\",\n        \"A method of manufacturing a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66819", "text": "{\n    \"patent_title\": \"Advanced Solar Cell Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents an innovative solar cell design utilizing perovskite materials to achieve high energy conversion efficiency. The design incorporates a novel light-trapping structure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Prior art regarding perovskite solar cells\"\n        }\n    ],\n    \"claims\": [\n        \"A solar cell comprising...\",\n        \"A perovskite material...\",\n        \"A light-trapping structure...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66820", "text": "{\n    \"patent_title\": \"Lithium-ion Battery with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a lithium-ion battery with improved thermal stability and cycle life. The battery utilizes a novel electrolyte composition and electrode materials to enhance performance and safety. The battery is suitable for a wide range of applications, including electric vehicles and portable electronics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on lithium-ion battery electrodes\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66820", "text": "{\n    \"patent_title\": \"Wireless Communication System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel wireless communication system utilizing advanced modulation techniques to improve data transmission rates and reduce interference. It provides a robust and reliable communication link for various applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Prior art on wireless communication protocols\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication system comprising...\",\n        \"A modulation method for transmitting data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66821", "text": "{\n    \"patent_title\": \"System and Method for Predictive Maintenance using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for predicting equipment failures using machine learning algorithms. By analyzing sensor data and historical maintenance records, the system accurately forecasts when maintenance is required, minimizing downtime and reducing costs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predictive maintenance comprising: a sensor array...\",\n        \"A method for predicting equipment failure...\",\n        \"The system of claim 1, wherein the machine learning algorithm is a neural network.\",\n        \"The method of claim 2, further comprising...\",\n        \"The system of claim 3, wherein the sensor array comprises...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66821", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Energy Solutions Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-08-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an improved battery management system for electric vehicles, enhancing battery life and safety. The system optimizes charging and discharging cycles and monitors cell performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising: a voltage sensor...\",\n        \"A method for controlling battery charging...\",\n        \"The system of claim 1, wherein the voltage sensor is a high-precision sensor.\",\n        \"The method of claim 2, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66822", "text": "{\n    \"patent_title\": \"System and Method for Personalized Medicine Based on Genomic Data\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for providing personalized medicine based on a patient's genomic data. The system analyzes genomic data to predict drug response and identify potential treatment options.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for predicting drug response based on genomic data.\",\n        \"A system for providing personalized treatment recommendations.\"\n    ]\n}"}
