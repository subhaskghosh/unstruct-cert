{"_id": "Academic--patents--p--66636", "text": "{\n    \"patent_title\": \"System and Method for Low-Latency Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Intel Corporation\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for low-latency wireless communication utilizing a novel modulation scheme. The system is designed to minimize delays in data transmission, improving performance in real-time applications. The abstract is about wireless communication.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related Art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for wireless communication comprising...\",\n        \"A method for reducing latency in wireless data transmission...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66636", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved battery management system for electric vehicles, enhancing battery life and safety. It describes a novel charging and discharging control algorithm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66637", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"MIT Energy Lab\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery design incorporating a polymer electrolyte and a modified cathode material resulting in enhanced stability and cycle life. This invention addresses the limitations of conventional lithium-ion batteries by preventing dendrite formation and improving energy density.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Improved Lithium Battery Cathode\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"A method for manufacturing a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66637", "text": "{\n    \"patent_title\": \"Sodium-Ion Battery with Graphene Additives\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2011-11-01\",\n    \"filing_date\": \"2011-11-01\",\n    \"issue_date\": \"2020-02-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new sodium-ion battery using graphene additives to enhance conductivity and improve performance. This invention offers a cost-effective alternative to lithium-ion batteries using more abundant materials.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8987654B2\",\n            \"title\": \"Graphene Synthesis Methods\"\n        }\n    ],\n    \"claims\": [\n        \"A sodium-ion battery comprising...\",\n        \"A method for preparing a sodium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66638", "text": "{\n    \"patent_title\": \"Microfluidic Device with Integrated Sensor\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-14\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device incorporating a novel sensor for detecting biomolecules. The sensor utilizes a fluorescence-based detection method and provides high sensitivity and specificity. The device is suitable for point-of-care diagnostics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising a sensor...\",\n        \"The sensor of claim 1, wherein the sensor is fluorescence-based...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66638", "text": "{\n    \"patent_title\": \"Wireless Communication System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2010-12-01\",\n    \"filing_date\": \"2010-12-01\",\n    \"issue_date\": \"2018-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless communication system employing advanced modulation techniques for improved data transmission rates. The system is designed for mobile devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication system comprising a transmitter...\",\n        \"The transmitter of claim 1, wherein the modulation technique is QAM...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66639", "text": "{\n    \"patent_title\": \"Method and System for Federated Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Sergey Levine\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Chelsea Finn\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2019-03-01\",\n    \"issue_date\": \"2021-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for performing federated learning, enabling machine learning models to be trained on decentralized datasets without exchanging the data itself.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for federated learning...\",\n        \"A system comprising...\"\n    ]\n}"}
