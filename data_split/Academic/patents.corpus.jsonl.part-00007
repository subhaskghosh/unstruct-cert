{"_id": "Academic--patents--p--69067", "text": "{\n    \"patent_title\": \"Deep Learning System for Enhanced Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-12-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep learning system for image recognition utilizing convolutional neural networks and large-scale datasets. This system achieves state-of-the-art accuracy in identifying objects and scenes within images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Convolutional Neural Network Architecture\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a neural network...\",\n        \"A computer-readable medium storing...\",\n        \"The system of claim 1, wherein...\",\n        \"The method of claim 2, further comprising...\",\n        \"The computer-readable medium of claim 3, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69067", "text": "{\n    \"patent_title\": \"Method for Efficient Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2021-01-15\",\n    \"issue_date\": \"2022-08-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for lossless data compression using Huffman coding and entropy encoding. This method reduces file sizes while maintaining data integrity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Huffman Coding Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data comprising...\",\n        \"A system for encoding data...\",\n        \"A computer-readable medium storing...\",\n        \"The method of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69068", "text": "{\n    \"patent_title\": \"High-Capacity Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel electrode materials for lithium-ion batteries, exhibiting enhanced capacity and cycle life. The materials are based on a unique nano-structured composite.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8785043B2\",\n            \"kind\": \"Non-Patent Literature\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode material...\",\n        \"The electrode material according to claim 1, wherein the material comprises...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69068", "text": "{\n    \"patent_title\": \"Battery Management System for Lithium-Ion Packs\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Texas Instruments\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2015-11-20\",\n    \"filing_date\": \"2015-11-20\",\n    \"issue_date\": \"2019-02-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) is disclosed for optimizing the performance and safety of lithium-ion battery packs. The BMS includes...\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"kind\": \"Patent\"\n        },\n        {\n            \"patent_number\": \"US8902109B2\",\n            \"kind\": \"Patent\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"The system according to claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69069", "text": "{\n    \"patent_title\": \"Electrode Material for High-Performance Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel electrode material for lithium-ion batteries with enhanced energy density and cycle life. The material utilizes a unique composite structure to improve ion conductivity and reduce internal resistance.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode material...\",\n        \"The electrode material according to claim 1, wherein the composite structure includes...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69069", "text": "{\n    \"patent_title\": \"Battery Management System for Lithium-Ion Packs\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) for lithium-ion battery packs, providing precise voltage and temperature monitoring, cell balancing, and overcharge protection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Advanced Cell Balancing Techniques\"\n        },\n        {\n            \"patent_number\": \"US9123456B1\",\n            \"title\": \"Thermal Management of Lithium-Ion Batteries\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising a voltage monitor...\",\n        \"The battery management system according to claim 1, further comprising a temperature sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69070", "text": "{\n    \"patent_title\": \"Method and System for Improved Neural Network Training\",\n    \"inventors\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Ilya Sutskever\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-04-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for training deep neural networks, improving convergence speed and accuracy. The method utilizes a dynamic learning rate adjustment strategy based on the gradient magnitude.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for training a neural network, comprising...\",\n        \"The method of claim 1, wherein...\",\n        \"A system for training a neural network...\",\n        \"The system of claim 3, further comprising...\",\n        \"The method of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69070", "text": "{\n    \"patent_title\": \"Enhanced Image Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a new algorithm for compressing images with minimal loss of quality. It uses a wavelet transform and entropy coding.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image, comprising...\",\n        \"The method of claim 1, wherein...\",\n        \"A system for compressing an image...\",\n        \"The system of claim 3, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69071", "text": "{\n    \"patent_title\": \"High-Performance Lithium-Ion Battery with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel lithium-ion battery design incorporating a unique electrolyte composition for enhanced stability and performance. The battery exhibits improved cycle life and reduced degradation under extreme operating conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"The battery of claim 1, wherein...\",\n        \"An electrolyte composition for a lithium-ion battery...\",\n        \"The electrolyte composition of claim 3...\",\n        \"A method of manufacturing a lithium-ion battery...\",\n        \"The method of claim 5...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69071", "text": "{\n    \"patent_title\": \"A Method for Optimizing Lithium-Ion Battery Performance\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Caltech\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-02-28\",\n    \"filing_date\": \"2017-02-28\",\n    \"issue_date\": \"2020-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method for optimizing the performance of lithium-ion batteries through dynamic charge control algorithms. The method improves battery lifespan and efficiency.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for controlling the charge of a lithium-ion battery...\",\n        \"The method of claim 1, wherein the charge control...\",\n        \"A system for implementing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69072", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Intel Corporation\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing wireless communication utilizing advanced signal processing techniques. This invention improves data throughput and reduces latency in wireless networks.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A method for wireless communication comprising...\",\n        \"A system for enhancing signal quality...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69072", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Texas Instruments\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2017-01-10\",\n    \"filing_date\": \"2017-01-10\",\n    \"issue_date\": \"2020-11-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An innovative battery management system designed to improve energy efficiency and extend battery life. The system utilizes advanced charging algorithms and thermal management techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A charging circuit configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69073", "text": "{\n    \"patent_title\": \"High-Efficiency Perovskite Solar Cell with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Li Wei\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Maria Garcia\",\n            \"affiliation\": \"National Renewable Energy Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel perovskite solar cell structure is disclosed, offering high power conversion efficiency and improved long-term stability. The device incorporates a unique passivation layer and optimized charge transport materials to mitigate degradation mechanisms, resulting in a solar cell with significantly enhanced performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A perovskite solar cell comprising...\",\n        \"A method for fabricating a perovskite solar cell...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69073", "text": "{\n    \"patent_title\": \"Improved Wind Turbine Blade Design\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-03-10\",\n    \"filing_date\": \"2017-03-10\",\n    \"issue_date\": \"2018-07-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new design for wind turbine blades is presented, focusing on aerodynamic efficiency and noise reduction. The blades utilize a novel airfoil shape and a unique surface coating to improve performance in various wind conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A wind turbine blade having...\",\n        \"A method for manufacturing a wind turbine blade...\"\n    ]\n}"}
