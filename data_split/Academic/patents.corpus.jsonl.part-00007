{"_id": "Academic--patents--p--66903", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Natural Language Processing using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2021-08-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for improving natural language processing tasks using a deep learning architecture. The system utilizes a transformer network to achieve state-of-the-art results in machine translation and text summarization.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Neural Machine Translation System\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Attention Mechanism for Sequence-to-Sequence Models\"\n        },\n        {\n            \"patent_number\": \"US11223344B1\",\n            \"title\": \"Deep Learning Framework for Text Analysis\"\n        },\n        {\n            \"patent_number\": \"US12112233B2\",\n            \"title\": \"Generative Pre-trained Transformer\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing natural language comprising...\",\n        \"A system for performing machine translation...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66903", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corp\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-03-01\",\n    \"issue_date\": \"2021-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved bicycle braking system utilizing a novel hydraulic disc brake design. The system provides enhanced stopping power and modulation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Hydraulic Disc Brake System\"\n        },\n        {\n            \"patent_number\": \"US87654320B1\",\n            \"title\": \"Bicycle Brake Lever Design\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle braking system comprising...\",\n        \"A hydraulic disc brake assembly...\",\n        \"A brake lever configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66904", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2018-03-10\",\n    \"issue_date\": \"2020-05-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system that improves charging efficiency and extends battery life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"The battery management system of claim 1, further comprising...\"\n    ]\n}"}
