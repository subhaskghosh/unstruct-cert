{"_id": "Academic--patents--p--66618", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for increasing the resolution of images using a deep convolutional neural network. The system analyzes low-resolution images and generates high-resolution counterparts with improved clarity and detail.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Super-Resolution using Sparse Representation\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising:...\",\n        \"The method of claim 1, wherein the deep convolutional neural network is trained...\",\n        \"A system for enhancing image resolution comprising:...\",\n        \"The system of claim 3, wherein the image processing unit is configured to...\",\n        \"The method of claim 1, further comprising a pre-processing step...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66618", "text": "{\n    \"patent_title\": \"Digital Image Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-05-01\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2021-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel digital image compression technique utilizing wavelet transforms and entropy encoding to achieve high compression ratios.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Wavelet-Based Image Compression with Adaptive Quantization\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a digital image comprising:...\",\n        \"The method of claim 1, wherein the wavelet transform is a Daubechies wavelet...\",\n        \"A system for compressing a digital image comprising:...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66619", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-12-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel system and method for improving image recognition accuracy using deep convolutional neural networks. The system incorporates attention mechanisms and transfer learning techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"type\": \"Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a deep neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66619", "text": "{\n    \"patent_title\": \"Advanced Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Green\",\n            \"affiliation\": \"Tesla, Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-08-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles, focusing on maximizing battery life and safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"type\": \"Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66620", "text": "{\n    \"patent_title\": \"Method and System for Image Recognition Using Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2019-03-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for image recognition utilizing deep neural networks. The system comprises multiple layers of interconnected nodes to analyze and classify image data with high accuracy. This technology allows for improved performance in applications such as object detection and facial recognition.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66620", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10293847B1\",\n    \"priority_date\": \"2017-12-01\",\n    \"filing_date\": \"2017-12-01\",\n    \"issue_date\": \"2019-06-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel battery design utilizing advanced materials to increase energy density and lifespan in mobile devices. The battery incorporates a new electrolyte composition and a unique electrode structure. It addresses the limitations of current lithium-ion batteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery comprising...\",\n        \"An electrolyte composition for a battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66621", "text": "{\n    \"patent_title\": \"Novel Polymer Composites for High-Strength Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT Materials Science Department\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel polymer composite material with enhanced strength and durability is disclosed. The composite utilizes a unique combination of polymer matrices and reinforcing nanoparticles, resulting in superior mechanical properties.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        },\n        {\n            \"patent_number\": \"US8123456B2\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        },\n        {\n            \"patent_number\": \"US9234567B2\"\n        },\n        {\n            \"patent_number\": \"US9345678B2\"\n        }\n    ],\n    \"claims\": [\n        \"A polymer composite comprising...\",\n        \"The polymer composite of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66621", "text": "{\n    \"patent_title\": \"Improved Method for Solar Cell Fabrication\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-05-20\",\n    \"issue_date\": \"2016-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for fabricating high-efficiency solar cells is presented, utilizing a new deposition technique.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        },\n        {\n            \"patent_number\": \"US8123456B2\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for fabricating a solar cell comprising...\",\n        \"The method of claim 1, wherein...\"\n    ]\n}"}
