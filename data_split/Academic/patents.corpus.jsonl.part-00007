{"_id": "Academic--patents--n--69238", "text": "{\n    \"patent_title\": \"Wireless Communication System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-01-05\",\n    \"filing_date\": \"2016-03-10\",\n    \"issue_date\": \"2019-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless communication system utilizing advanced modulation techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication system comprising...\",\n        \"The wireless communication system of claim 1, wherein...\",\n        \"A method for transmitting data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69239", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system is disclosed. The sensor utilizes MEMS technology for high sensitivity and low power consumption, enabling applications in medical monitoring and industrial control. The system incorporates a novel calibration technique to improve accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising...\",\n        \"A method for calibrating a pressure sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69239", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Texas Instruments\"\n        },\n        {\n            \"name\": \"Emily Chen\",\n            \"affiliation\": \"Samsung\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles is described. The system optimizes charging and discharging cycles to extend battery life and improve performance. This system utilizes advanced algorithms for state of charge estimation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69240", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for improving the quality of reconstructed images from incomplete data. The method utilizes a deep learning approach to fill in missing information, resulting in images with enhanced clarity and detail.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Processing Technique\"\n        },\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"title\": \"Reconstruction Algorithm\"\n        },\n        {\n            \"patent_number\": \"US8888888B1\",\n            \"title\": \"Image Enhancement System\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Data Completion Method\"\n        },\n        {\n            \"patent_number\": \"US9111111B1\",\n            \"title\": \"Deep Learning for Image Analysis\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an image...\",\n        \"A system for enhancing image quality...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69240", "text": "{\n    \"patent_title\": \"Automated Fruit Sorting System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"AgriTech Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10222333B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for sorting fruits based on size, color, and shape. The system utilizes computer vision to identify and classify fruits, improving efficiency in packing and distribution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8543210B2\",\n            \"title\": \"Fruit Grading Machine\"\n        },\n        {\n            \"patent_number\": \"US9433344B1\",\n            \"title\": \"Computer Vision System\"\n        },\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Image Classification Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A system for sorting fruits...\",\n        \"A method for classifying fruits...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69241", "text": "{\n    \"patent_title\": \"System and method for fraud detection using machine learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of Data Science\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2018-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for detecting fraudulent transactions using machine learning algorithms. The system analyzes transaction data to identify patterns indicative of fraudulent activity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Fraud detection using statistical analysis\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for detecting fraudulent transactions, comprising...\",\n        \"2. The system of claim 1, wherein the machine learning algorithm is a neural network.\",\n        \"3. A method for detecting fraudulent transactions...\",\n        \"4. The method of claim 3, further comprising...\",\n        \"5. The system of claim 1, wherein the transaction data includes purchase history.\",\n        \"6. The system of claim 1, wherein the transaction data includes location data.\",\n        \"7. The system of claim 1, wherein the transaction data includes user behavior data.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69241", "text": "{\n    \"patent_title\": \"Theoretical Framework for Advanced Machine Learning Algorithms\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Academic Research Institute\"\n        }\n    ],\n    \"patent_number\": \"US9876544B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2018-06-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This patent details a novel theoretical framework for improving the convergence rate of machine learning algorithms. It focuses on mathematical foundations rather than practical implementations.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9012345B1\",\n            \"title\": \"Optimization techniques in machine learning\"\n        }\n    ],\n    \"claims\": [\n        \"1. A theoretical framework for machine learning algorithms, characterized by...\",\n        \"2. The framework of claim 1, wherein the convergence rate is improved.\",\n        \"3. A mathematical model...\",\n        \"4. The mathematical model of claim 3, comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69242", "text": "{\n    \"patent_title\": \"Wireless Sensor Network for Environmental Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless sensor network for monitoring environmental conditions, including temperature, humidity, and air quality. The system utilizes low-power sensors and a mesh network topology for reliable data transmission. The sensors transmit data to a central base station for analysis and visualization. This sensor technology is applicable to agriculture, manufacturing, and urban environments.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Data Aggregation in Wireless Sensor Networks\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor network comprising...\",\n        \"A method for monitoring environmental conditions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69242", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2017-08-10\",\n    \"filing_date\": \"2017-08-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor for continuous monitoring of blood glucose levels. The sensor utilizes a biocompatible material and wireless communication to transmit data to an external receiver. This device is intended for use in diabetes management and provides real-time glucose readings.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Medical Device for Glucose Monitoring\"\n        },\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Wireless Sensor Network for Environmental Monitoring\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable glucose sensor comprising...\",\n        \"A method for continuous glucose monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69243", "text": "{\n    \"patent_title\": \"Advanced Micro-Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California\"\n        },\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-14\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an advanced micro-sensor system for detecting minute changes in pressure and temperature. It utilizes novel materials and fabrication techniques for increased sensitivity and accuracy. The sensor is designed for use in various industrial applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A micro-sensor system comprising...\",\n        \"A method for detecting pressure changes...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69243", "text": "{\n    \"patent_title\": \"Wireless Sensor Network for Environmental Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Robert Jones\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2012-05-20\",\n    \"filing_date\": \"2012-05-19\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless sensor network for real-time environmental monitoring. The system incorporates low-power sensors and a wireless communication protocol for transmitting data to a central server.  This allows for remote data access and analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor network comprising...\",\n        \"A method for transmitting environmental data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69244", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Recognition using Deep Convolutional Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-09-20\",\n    \"issue_date\": \"2019-06-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for image recognition using deep convolutional neural networks. The system incorporates attention mechanisms to improve accuracy and robustness.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        },\n        {\n            \"patent_number\": \"US9543210B2\"\n        },\n        {\n            \"patent_number\": \"US8901234B1\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        },\n        {\n            \"patent_number\": \"US10345678B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition...\",\n        \"A system comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69244", "text": "{\n    \"patent_title\": \"Image Compression Technique Using Wavelet Transform\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2020-04-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved image compression technique based on wavelet transform, achieving higher compression ratios with minimal loss of quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        },\n        {\n            \"patent_number\": \"US9123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image...\",\n        \"An apparatus for image compression...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69245", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Sensor System for Biomedical Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-06-15\",\n    \"filing_date\": \"2015-03-20\",\n    \"issue_date\": \"2019-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized wireless sensor system for continuous biomedical monitoring. The system integrates various sensors to measure physiological parameters such as heart rate, temperature, and blood pressure. The sensor data is transmitted wirelessly to a remote monitoring station for real-time analysis and diagnostics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related prior art in wireless communication.\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor system comprising...\",\n        \"The system of claim 1, further comprising...\",\n        \"A method for monitoring physiological parameters...\",\n        \"The method of claim 3, wherein...\",\n        \"A data transmission module for transmitting sensor data...\",\n        \"The data transmission module of claim 5, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69245", "text": "{\n    \"patent_title\": \"Improved Acoustic Sensor Array\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2009-11-01\",\n    \"filing_date\": \"2010-05-15\",\n    \"issue_date\": \"2020-01-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved acoustic sensor array for enhanced sound detection and localization. The array utilizes advanced signal processing techniques to filter noise and accurately determine the source of sound.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Previous work on acoustic signal processing.\"\n        }\n    ],\n    \"claims\": [\n        \"An acoustic sensor array comprising...\",\n        \"The array of claim 1, further comprising...\",\n        \"A signal processing unit for filtering noise...\",\n        \"The signal processing unit of claim 3, wherein...\",\n        \"A method for localizing a sound source...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69246", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Data Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"University of Data Science\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2020-11-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for utilizing artificial intelligence to analyze large datasets, identify patterns, and provide actionable insights. The system employs machine learning algorithms to improve accuracy and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Data Mining Techniques\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Machine Learning Algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"A system for data analysis comprising...\",\n        \"A method for identifying patterns in data using...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69246", "text": "{\n    \"patent_title\": \"AI-Assisted Medical Diagnostic Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Williams\",\n            \"affiliation\": \"MedTech Solutions\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Hospital Innovation Labs\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2018-03-10\",\n    \"filing_date\": \"2018-03-10\",\n    \"issue_date\": \"2021-02-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An artificial intelligence-powered device for assisting in the diagnosis of medical conditions. The device uses image recognition and machine learning to identify anomalies in medical images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Medical Imaging Technology\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Diagnostic Apparatus\"\n        }\n    ],\n    \"claims\": [\n        \"A medical diagnostic device comprising...\",\n        \"A method for diagnosing medical conditions using...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69247", "text": "{\n    \"patent_title\": \"Method for Enhanced Oil Recovery Using Nanoparticles\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of Texas\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method for improving oil recovery from subterranean reservoirs by injecting nanoparticles into the reservoir fluid. The nanoparticles alter the wettability of the rock surfaces, leading to increased oil mobilization and production.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing oil recovery...\",\n        \"The method of claim 1, wherein the nanoparticles comprise silica.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69247", "text": "{\n    \"patent_title\": \"System and Method for Dynamic Software Allocation\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2012-03-10\",\n    \"filing_date\": \"2012-03-10\",\n    \"issue_date\": \"2020-05-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for dynamically allocating software resources in a cloud computing environment. The system utilizes machine learning algorithms to optimize resource allocation based on real-time demand and user preferences. This software solution improves efficiency and reduces costs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A system for dynamically allocating software resources...\",\n        \"The system of claim 1, further comprising a machine learning module.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69248", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrolyte\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel electrolyte composition for lithium-ion batteries, improving energy density and cycle life. The electrolyte comprises a lithium salt, a solvent, and an additive.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrolyte comprising...\",\n        \"The electrolyte of claim 1, wherein the lithium salt is...\",\n        \"The electrolyte of claim 2, wherein the solvent is...\",\n        \"A lithium-ion battery cell comprising the electrolyte of claim 1.\",\n        \"A method of manufacturing a lithium-ion battery cell...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69248", "text": "{\n    \"patent_title\": \"Novel Polymer for Battery Separators\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2014-11-01\",\n    \"filing_date\": \"2014-11-01\",\n    \"issue_date\": \"2018-02-13\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new polymer material is disclosed for use as a separator in lithium-ion batteries, improving thermal stability and preventing dendrite formation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A polymer separator for a lithium-ion battery comprising...\",\n        \"The polymer separator of claim 1, wherein the polymer is...\",\n        \"A lithium-ion battery cell comprising the polymer separator of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69249", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Cycle Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery design incorporating a solid-state electrolyte is disclosed, resulting in enhanced cycle life and improved safety characteristics. The battery exhibits increased energy density and reduced degradation over repeated charge-discharge cycles. The electrolyte contains a polymer matrix doped with lithium salts to promote ion conductivity. This invention focuses on improving the performance of battery technology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"The battery of claim 1, wherein the electrolyte...\",\n        \"A method for manufacturing the battery of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69249", "text": "{\n    \"patent_title\": \"Improved Wind Turbine Blade Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved aerodynamic profile for wind turbine blades, designed to maximize energy capture and minimize noise pollution. The blade features a novel twist and airfoil shape that optimize performance in varying wind conditions. The invention enhances the efficiency of renewable energy generation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A wind turbine blade comprising...\",\n        \"The blade of claim 1, wherein the airfoil shape...\",\n        \"A wind turbine system incorporating the blade of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69250", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications. The system includes a low-power sensor, a wireless transmitter, and a receiver. The sensor is designed to be implanted or attached to the skin to monitor physiological pressure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising: a pressure sensor...\",\n        \"The system of claim 1, wherein the sensor is miniature...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69250", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10246813B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery management system for electric vehicles. This system optimizes battery life and performance by controlling charging and discharging cycles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising: a charge controller...\",\n        \"The system of claim 1, wherein the controller optimizes...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69251", "text": "{\n    \"patent_title\": \"System and Method for Predictive Maintenance Using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for predicting equipment failure using machine learning algorithms. The system analyzes sensor data to identify patterns indicative of potential failures, enabling proactive maintenance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for predictive maintenance comprising...\",\n        \"2. The system of claim 1, wherein the machine learning algorithm is a neural network.\",\n        \"3. A method for predicting equipment failure...\",\n        \"4. The method of claim 3, further comprising...\",\n        \"5. The method of claim 3, wherein the sensor data includes temperature readings.\",\n        \"6. The method of claim 3, wherein the sensor data includes vibration measurements.\",\n        \"7. The method of claim 3, wherein the sensor data includes pressure readings.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69251", "text": "{\n    \"patent_title\": \"Improved Internal Combustion Engine Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Ford Motor Company\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved internal combustion engine design featuring a novel valve configuration for increased efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"1. An internal combustion engine comprising...\",\n        \"2. The engine of claim 1, wherein the valve configuration...\",\n        \"3. A method for operating an internal combustion engine...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69252", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2015-03-15\",\n    \"filing_date\": \"2015-03-15\",\n    \"issue_date\": \"2018-01-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system and method for enhancing image processing techniques, particularly for improving the clarity and detail in digital images. The system utilizes advanced algorithms to reduce noise and enhance contrast.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8654321B1\",\n            \"kind\": \"non-patent literature\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image clarity.\",\n        \"A system for reducing noise in digital images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69252", "text": "{\n    \"patent_title\": \"Medical Image Analysis System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Medical Solutions Corp.\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2016-05-20\",\n    \"filing_date\": \"2016-05-20\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for analyzing medical images, including X-rays, MRIs, and CT scans. The system provides tools for detecting anomalies and assisting in diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"kind\": \"patent\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"patent\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting anomalies in medical images.\",\n        \"A system for assisting in medical diagnosis.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69253", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Machine Learning Model Training\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-15\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for enhancing machine learning model training using adaptive optimization algorithms is disclosed. The system utilizes a feedback loop to dynamically adjust learning rates based on real-time performance metrics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for training a machine learning model comprising...\",\n        \"A system for implementing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69253", "text": "{\n    \"patent_title\": \"Improved Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob White\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-20\",\n    \"issue_date\": \"2022-07-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved image recognition system utilizing convolutional neural networks for enhanced accuracy and speed. Applicable to various fields including autonomous vehicles and medical diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"An image recognition system comprising...\",\n        \"A convolutional neural network configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69254", "text": "{\n    \"patent_title\": \"System and method for image-based object recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image-based object recognition utilizing convolutional neural networks to identify objects within an image. The system processes images and provides a confidence score for each detected object.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9012345B2\"\n        },\n        {\n            \"patent_number\": \"US9234567B1\"\n        },\n        {\n            \"patent_number\": \"US9345678B2\"\n        },\n        {\n            \"patent_number\": \"US9456789B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for recognizing objects in an image.\",\n        \"A system comprising a convolutional neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69254", "text": "{\n    \"patent_title\": \"Method for improved data compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9871234B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-02-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel data compression technique utilizing wavelet transforms to reduce file sizes. The method is efficient and lossless.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8761234B1\"\n        },\n        {\n            \"patent_number\": \"US9016789B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data.\",\n        \"A system for lossless data compression.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69255", "text": "{\n    \"patent_title\": \"Miniature Implantable Medical Device for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-11-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature implantable medical device for continuous glucose monitoring utilizing a biocompatible sensor and wireless communication capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Glucose Sensor\"\n        },\n        {\n            \"patent_number\": \"US9120876B2\",\n            \"title\": \"Implantable Wireless Communication System\"\n        },\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Biocompatible Materials\"\n        },\n        {\n            \"patent_number\": \"US10234567B2\",\n            \"title\": \"Microfluidic Glucose Sensing\"\n        },\n        {\n            \"patent_number\": \"US11234567B2\",\n            \"title\": \"Power Management for Implantable Devices\"\n        }\n    ],\n    \"claims\": [\n        \"A miniature implantable medical device for continuous glucose monitoring...\",\n        \"The device comprising a biocompatible sensor...\",\n        \"A system for wirelessly transmitting glucose data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69255", "text": "{\n    \"patent_title\": \"Novel Algorithm for Image Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2021-09-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel algorithm for processing digital images to improve clarity and reduce noise.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8234567B1\",\n            \"title\": \"Image Enhancement Technique\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"title\": \"Noise Reduction Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing digital images...\",\n        \"An algorithm for enhancing image clarity...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69256", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Processing in Autonomous Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"TechCorp Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US16234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for real-time image processing in autonomous vehicles. The system utilizes advanced algorithms to enhance image clarity and identify objects, improving safety and navigation. The core innovation lies in a novel filtering technique that reduces noise and improves object detection accuracy, particularly in low-light conditions.  This is applicable to camera systems, not medical devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543\",\n            \"kind\": \"Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image processing comprising...\",\n        \"A method for enhancing image clarity...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69256", "text": "{\n    \"patent_title\": \"Medical Image Processing System for Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MedTech Solutions\"\n        }\n    ],\n    \"patent_number\": \"US17890123B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2019-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a medical image processing system specifically designed for detecting tumors in MRI scans. It employs a convolutional neural network to analyze medical images and highlight potential areas of concern, assisting radiologists in accurate diagnosis. Image processing techniques optimize the visibility of tumors.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US12345678\",\n            \"kind\": \"Related Application\"\n        }\n    ],\n    \"claims\": [\n        \"A system for medical image analysis...\",\n        \"A method for tumor detection in MRI scans...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69257", "text": "{\n    \"patent_title\": \"Wireless Sensor Network for Environmental Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-06-15\",\n    \"issue_date\": \"2018-03-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless sensor network for monitoring environmental conditions, including temperature, humidity, and air quality. The system utilizes low-power sensors and a mesh network topology to provide reliable data transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related prior art in wireless communication\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor network comprising a plurality of sensor nodes.\",\n        \"A method for monitoring environmental conditions using a wireless sensor network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69257", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2015-11-22\",\n    \"filing_date\": \"2016-01-18\",\n    \"issue_date\": \"2019-04-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor with wireless communication capabilities for continuous glucose monitoring in diabetic patients. The sensor utilizes a biocompatible material and provides real-time data to a mobile device.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Prior art in implantable sensors\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable glucose sensor comprising a biocompatible housing.\",\n        \"A method for continuous glucose monitoring using an implantable sensor.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69258", "text": "{\n    \"patent_title\": \"Method and System for Efficient Neural Network Training\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for efficiently training deep neural networks using a novel optimization algorithm. The algorithm reduces training time and improves model accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Deep Learning Framework\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for training a neural network...\",\n        \"2. The method of claim 1, wherein the neural network...\",\n        \"3. A system comprising...\",\n        \"4. The system of claim 3, wherein...\",\n        \"5. A computer-readable medium...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69258", "text": "{\n    \"patent_title\": \"Improved Data Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2020-01-05\",\n    \"filing_date\": \"2020-04-15\",\n    \"issue_date\": \"2021-07-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel data compression algorithm that provides higher compression ratios with minimal loss of data integrity. It employs a combination of Huffman coding and Lempel-Ziv techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Data Compression Method\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for compressing data...\",\n        \"2. The method of claim 1, wherein the data...\",\n        \"3. A system for implementing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69259", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-10\",\n    \"filing_date\": \"2015-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel data compression system utilizing advanced algorithms for improved efficiency and reduced storage requirements.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"Claim 1: A system for compressing data comprising...\",\n        \"Claim 2: The system of claim 1, wherein...\",\n        \"Claim 3: A method for compressing data...\",\n        \"Claim 4: The method of claim 3, further comprising...\",\n        \"Claim 5: A computer-readable medium...\",\n        \"Claim 6: The computer-readable medium of claim 5...\",\n        \"Claim 7: A device comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69259", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10246813B1\",\n    \"priority_date\": \"2016-02-29\",\n    \"filing_date\": \"2016-08-10\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An innovative battery management system for enhanced performance and longevity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"Claim 1: A battery management system comprising...\",\n        \"Claim 2: The system of claim 1, wherein...\",\n        \"Claim 3: A method for managing battery...\",\n        \"Claim 4: The method of claim 3, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69260", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-04-15\",\n    \"issue_date\": \"2021-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel electrode materials for lithium-ion batteries with enhanced energy density and cycle life. The materials are synthesized using a new method that improves their structural stability and ionic conductivity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode material...\",\n        \"The electrode material of claim 1, wherein...\",\n        \"A method for manufacturing the electrode material...\",\n        \"The method of claim 3, comprising...\",\n        \"A device utilizing the lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69260", "text": "{\n    \"patent_title\": \"New Polymer Composites for Structural Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Carol Davis\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2020-05-20\",\n    \"filing_date\": \"2020-06-20\",\n    \"issue_date\": \"2021-09-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to new polymer composite materials with improved strength and durability. These materials are useful in a variety of structural applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A polymer composite material comprising...\",\n        \"The material of claim 1, wherein...\",\n        \"A structural component made from the polymer composite...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69261", "text": "{\n    \"patent_title\": \"Lithium-ion Battery Electrode with Improved Cycle Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery electrode material is disclosed, exhibiting enhanced cycle life and improved energy density. The electrode comprises a composite material containing lithium metal oxide nanoparticles and a carbon-based conductive matrix.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"1. A lithium-ion battery electrode comprising...\",\n        \"2. The electrode of claim 1, wherein the lithium metal oxide...\",\n        \"3. The electrode of claim 2, wherein the carbon-based...\",\n        \"4. A lithium-ion battery comprising the electrode...\",\n        \"5. The battery of claim 4, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69261", "text": "{\n    \"patent_title\": \"Improved Polymer Electrolyte for Solid-State Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-09\",\n    \"issue_date\": \"2020-11-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel polymer electrolyte for solid-state batteries, exhibiting high ionic conductivity and mechanical stability. The electrolyte is based on a cross-linked polymer matrix with incorporated lithium salts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"1. A polymer electrolyte for solid-state batteries...\",\n        \"2. The electrolyte of claim 1, wherein the polymer...\",\n        \"3. The electrolyte of claim 2, wherein the lithium...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69262", "text": "{\n    \"patent_title\": \"System and Method for Object Recognition in Video Streams\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-03-15\",\n    \"filing_date\": \"2015-05-20\",\n    \"issue_date\": \"2019-01-29\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for real-time object recognition in video streams. The system utilizes convolutional neural networks to identify objects with high accuracy. The application is focused on surveillance and security applications, specifically in public spaces and traffic monitoring. This system focuses on general image recognition and does not relate to medical applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A system for identifying objects in a video stream...\",\n        \"A method for training a convolutional neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69262", "text": "{\n    \"patent_title\": \"Medical Image Analysis System Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Medical Imaging Solutions\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2014-04-20\",\n    \"filing_date\": \"2016-08-10\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for analyzing medical images using deep learning techniques. The system is designed to assist radiologists in detecting anomalies in X-ray, MRI, and CT scans. The system focuses on image recognition within medical imaging, specifically for the detection of tumors and other abnormalities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related work in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A system for analyzing medical images...\",\n        \"A method for detecting anomalies in X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69263", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-05-15\",\n    \"filing_date\": \"2010-02-20\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor with wireless communication capabilities for continuous glucose monitoring.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A glucose sensor comprising a glucose-sensitive electrode.\",\n        \"A wireless communication module for transmitting glucose data.\",\n        \"A power supply for operating the sensor.\",\n        \"A housing for encapsulating the sensor components.\",\n        \"A method for continuously monitoring glucose levels.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69263", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2008-11-01\",\n    \"filing_date\": \"2009-12-15\",\n    \"issue_date\": \"2017-04-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical stapler designed with enhanced ergonomics for improved surgeon comfort and control.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A surgical stapler comprising a handle and a stapling head.\",\n        \"A locking mechanism to secure the stapling head.\",\n        \"A cartridge containing staples.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69264", "text": "{\n    \"patent_title\": \"System and method for AI-powered anomaly detection in industrial processes\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-07-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for detecting anomalies in industrial processes using artificial intelligence techniques, specifically deep learning algorithms. The system analyzes sensor data to identify deviations from normal operating conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A system for anomaly detection comprising...\",\n        \"A method for identifying anomalies...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69264", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Independent Inventor\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2019-12-20\",\n    \"filing_date\": \"2019-12-20\",\n    \"issue_date\": \"2021-05-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel bicycle braking system incorporating improved lever ergonomics and cable routing for enhanced stopping power and rider comfort.  Utilizes a dual-piston caliper design.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle braking system comprising...\",\n        \"A lever assembly for a bicycle brake...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69265", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system and method for enhancing wireless communication efficiency and reliability. The system utilizes advanced signal processing techniques to mitigate interference and improve data throughput. It's particularly useful in crowded wireless environments.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Prior Art Wireless System\"\n        }\n    ],\n    \"claims\": [\n        \"A system for wireless communication comprising...\",\n        \"A method for improving signal quality...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69265", "text": "{\n    \"patent_title\": \"Wireless Medical Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"MedTech Solutions\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-01\",\n    \"filing_date\": \"2017-03-01\",\n    \"issue_date\": \"2020-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless sensor system for continuous medical monitoring of vital signs. The system transmits data wirelessly to a central monitoring station for real-time analysis.  This system incorporates medical diagnostic capabilities and is intended for use in hospital settings.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Early Wireless Monitoring System\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless medical sensor comprising...\",\n        \"A method for remotely monitoring patient data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69266", "text": "{\n    \"patent_title\": \"Neural Network Accelerator Architecture\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2020-12-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel architecture for accelerating neural network computations, utilizing specialized hardware components. This invention improves the efficiency and speed of deep learning algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for accelerating neural network computations...\",\n        \"A method for implementing the accelerated computation...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69266", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2019-05-20\",\n    \"filing_date\": \"2019-05-20\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system designed to enhance the lifespan and performance of lithium-ion batteries. This invention incorporates advanced algorithms for charge control and thermal management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling the charge of a battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69267", "text": "{\n    \"patent_title\": \"Novel Polymer Composites for Enhanced Durability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel polymer composites exhibiting enhanced durability and resistance to wear. The composites are formed by incorporating nanoparticles into a polymer matrix, resulting in improved mechanical properties and extended lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Polymer Blends for Automotive Applications\"\n        }\n    ],\n    \"claims\": [\n        \"A polymer composite comprising a polymer matrix and nanoparticles.\",\n        \"The polymer composite of claim 1, wherein the nanoparticles are carbon nanotubes.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69267", "text": "{\n    \"patent_title\": \"Advanced Cooling System for Microprocessors\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel cooling system for microprocessors utilizing microfluidic channels and a heat sink. The system efficiently removes heat from the processor, preventing overheating and improving performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Microfluidic Devices for Biomedical Applications\"\n        }\n    ],\n    \"claims\": [\n        \"A cooling system comprising microfluidic channels and a heat sink.\",\n        \"The cooling system of claim 1, wherein the microfluidic channels are fabricated from silicon.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69268", "text": "{\n    \"patent_title\": \"Microfluidic Device for Cell Sorting\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2008-11-15\",\n    \"filing_date\": \"2009-05-20\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for high-throughput cell sorting based on size and deformability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"The device of claim 1, wherein...\",\n        \"A method for sorting cells...\",\n        \"The method of claim 3, wherein...\",\n        \"The device of claim 1, further comprising...\",\n        \"The method of claim 3, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69268", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Wilson\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2012-03-10\",\n    \"filing_date\": \"2013-01-15\",\n    \"issue_date\": \"2015-09-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery technology with increased energy density and cycle life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising...\",\n        \"The battery cell of claim 1, wherein...\",\n        \"A method for manufacturing a battery cell...\",\n        \"The method of claim 3, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69269", "text": "{\n    \"patent_title\": \"Microfluidic Device for Cell Sorting\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for high-throughput cell sorting based on size and shape.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for sorting cells...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69269", "text": "{\n    \"patent_title\": \"Surgical Instrument with Enhanced Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876544B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical instrument designed for enhanced precision and reduced fatigue.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising...\",\n        \"A handle configured for ergonomic grip...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69270", "text": "{\n    \"patent_title\": \"Wireless Sensor Network for Structural Health Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless sensor network is disclosed for monitoring the structural health of bridges and buildings. The system utilizes low-power sensors to detect strain, vibration, and temperature changes. Data is transmitted wirelessly to a central server for analysis and visualization.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Remote Monitoring System\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor network comprising a plurality of sensors...\",\n        \"A method for monitoring structural health using a wireless sensor network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69270", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, San Diego\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Qualcomm\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2015-12-20\",\n    \"filing_date\": \"2015-12-20\",\n    \"issue_date\": \"2019-05-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor with wireless communication capabilities is disclosed. The sensor measures glucose levels in the blood and transmits the data to an external device for monitoring and treatment. This device utilizes highly sensitive sensors and sophisticated data analysis techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Continuous Glucose Monitoring System\"\n        },\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Implantable Medical Device for Drug Delivery\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable glucose sensor comprising a glucose sensing element...\",\n        \"A method for monitoring glucose levels in a patient...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69271", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-05-20\",\n    \"issue_date\": \"2018-07-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery design with improved electrolyte composition for enhanced thermal stability and cycle life. The battery utilizes a modified separator and a high-capacity cathode material.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"The battery of claim 1, wherein...\",\n        \"A method for manufacturing...\",\n        \"...\",\n        \"The battery of claim 12, with 11 additional claims.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69271", "text": "{\n    \"patent_title\": \"Improved Nickel-Metal Hydride Battery\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2011-01-25\",\n    \"filing_date\": \"2011-03-10\",\n    \"issue_date\": \"2017-05-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved nickel-metal hydride battery with enhanced energy density and reduced self-discharge. A new alloy composition is utilized for the negative electrode.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7543210B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A nickel-metal hydride battery...\",\n        \"The battery of claim 1, characterized by...\",\n        \"A method for activating...\",\n        \"...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69272", "text": "{\n    \"patent_title\": \"Wireless Sensor Network for Structural Health Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless sensor network is described for monitoring the structural health of bridges and buildings. The system utilizes low-power sensors to detect strain, vibration, and temperature changes. Data is transmitted wirelessly to a central processing unit for analysis and anomaly detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8540219B2\",\n            \"relevance\": \"Related technology in wireless communication\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor network comprising...\",\n        \"A method for detecting structural anomalies...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69272", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor is disclosed, enabling continuous monitoring of glucose levels in diabetic patients. The sensor transmits data wirelessly to an external receiver for real-time analysis and control of insulin delivery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"relevance\": \"Prior art in implantable medical devices\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related technology in glucose sensing\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable glucose sensor comprising...\",\n        \"A method for monitoring glucose levels...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69273", "text": "{\n    \"patent_title\": \"Improved Battery Electrode Material\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Lawrence Livermore National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-10\",\n    \"filing_date\": \"2015-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel electrode material for lithium-ion batteries with improved energy density and cycle life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"title\": \"Lithium-Ion Battery Electrode\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Electrode Coating Method\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Battery Management System\"\n        },\n        {\n            \"patent_number\": \"US8987654B1\",\n            \"title\": \"Solid State Electrolyte\"\n        },\n        {\n            \"patent_number\": \"US7654987B2\",\n            \"title\": \"Electrode Material Composition\"\n        }\n    ],\n    \"claims\": [\n        \"A battery electrode comprising...\",\n        \"The battery electrode of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69273", "text": "{\n    \"patent_title\": \"Wireless Communication System\",\n    \"inventors\": [\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emily White\",\n            \"affiliation\": \"Qualcomm Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-11-20\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-12-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless communication system for improved data transmission rates.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Wireless Communication Protocol\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Signal Processing Technique\"\n        },\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Data Compression Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication system comprising...\",\n        \"The wireless communication system of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69274", "text": "{\n    \"patent_title\": \"Electrode Material for Lithium-Ion Batteries with Enhanced Cycle Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel electrode material for lithium-ion batteries is disclosed, exhibiting improved cycle life and energy density. The material comprises a modified lithium metal oxide with a unique nanostructure. This invention significantly enhances the performance and longevity of lithium-ion batteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Lithium Iron Phosphate Cathode Material\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode material...\",\n        \"The electrode material according to claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69274", "text": "{\n    \"patent_title\": \"Battery Management System with Advanced Cell Balancing\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Texas Instruments\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-09-10\",\n    \"filing_date\": \"2017-09-10\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) is presented, providing advanced cell balancing and thermal management features. The system utilizes a sophisticated algorithm to optimize battery performance and extend its lifespan. The BMS is designed for use in electric vehicles and other high-power applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Cell Balancing Circuit for Lithium-Ion Batteries\"\n        },\n        {\n            \"patent_number\": \"US8234567B1\",\n            \"title\": \"Thermal Management System for Batteries\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising a cell balancing circuit...\",\n        \"The battery management system according to claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69275", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode and Method of Manufacture\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved lithium-ion battery electrode material and a method for manufacturing the same, offering enhanced energy density and cycle life. The material comprises a novel composite structure featuring a lithium-rich layered oxide and a carbon coating.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrode comprising...\",\n        \"A method for manufacturing a lithium-ion battery electrode...\",\n        \"The electrode of claim 1, wherein...\",\n        \"The method of claim 2, wherein...\",\n        \"The lithium-ion battery electrode of claim 3, further comprising...\",\n        \"The method of claim 4, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69275", "text": "{\n    \"patent_title\": \"Novel Polymer Electrolyte for Solid-State Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a new polymer electrolyte for solid-state batteries, offering improved ionic conductivity and safety characteristics. The electrolyte is based on a novel cross-linked polymer network.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A polymer electrolyte for a solid-state battery...\",\n        \"The polymer electrolyte of claim 1, wherein...\",\n        \"A solid-state battery comprising...\",\n        \"The solid-state battery of claim 3, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69276", "text": "{\n    \"patent_title\": \"Novel Polymer Composition for High-Strength Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2018-08-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel polymer composition exhibiting enhanced strength and durability. The polymer utilizes a unique molecular structure resulting in improved mechanical properties. The invention has potential applications in aerospace, automotive, and construction industries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Previous Polymer Composition\"\n        }\n    ],\n    \"claims\": [\n        \"A polymer composition comprising...\",\n        \"A method for manufacturing the polymer composition...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69276", "text": "{\n    \"patent_title\": \"Advanced Ceramic Coating Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876544B2\",\n    \"priority_date\": \"2017-03-10\",\n    \"filing_date\": \"2017-03-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new method for applying ceramic coatings to metal surfaces, improving corrosion resistance and thermal stability. The coatings are particularly effective in high-temperature environments.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"title\": \"Earlier Ceramic Coating Method\"\n        }\n    ],\n    \"claims\": [\n        \"A ceramic coating composition...\",\n        \"A method for applying the ceramic coating...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69277", "text": "{\n    \"patent_title\": \"System and method for predictive maintenance using machine learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for predictive maintenance using machine learning algorithms to analyze sensor data and predict equipment failures. The system utilizes real-time data streams and historical data to identify patterns and anomalies indicative of potential issues.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Data analysis system\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predictive maintenance comprising...\",\n        \"A method for analyzing sensor data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69277", "text": "{\n    \"patent_title\": \"Medical diagnostic device using machine learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Healthcare Solutions Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A medical diagnostic device utilizing machine learning to analyze medical images and detect anomalies. The device is designed for early detection of diseases and provides accurate diagnostic results.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Medical imaging apparatus\"\n        },\n        {\n            \"patent_number\": \"US8234567B1\",\n            \"title\": \"Diagnostic method for heart disease\"\n        }\n    ],\n    \"claims\": [\n        \"A medical diagnostic device comprising...\",\n        \"A method for analyzing medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69278", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-10\",\n    \"filing_date\": \"2015-03-15\",\n    \"issue_date\": \"2018-11-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery management system that improves efficiency and safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"The system of claim 1, further comprising...\",\n        \"A method for managing a battery...\",\n        \"The method of claim 3, wherein...\",\n        \"The battery management system of claim 1, wherein the battery is a lithium-ion battery.\",\n        \"The battery management system of claim 2, wherein the sensor is a temperature sensor.\"\n    ]\n}"}
