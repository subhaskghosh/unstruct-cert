{"_id": "Academic--patents--p--66731", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel lithium-ion battery electrode material with enhanced energy density and cycle life. The material comprises a composite structure with improved ion conductivity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"1. A lithium-ion battery electrode comprising...\",\n        \"2. The electrode of claim 1, wherein...\",\n        \"3. A lithium-ion battery cell comprising...\",\n        \"4. The battery cell of claim 3, wherein...\",\n        \"5. A method of manufacturing...\",\n        \"6. The method of claim 5, wherein...\",\n        \"7. The method of claim 5, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66731", "text": "{\n    \"patent_title\": \"New Polymer Electrolyte for Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel polymer electrolyte for use in batteries, exhibiting high ionic conductivity and electrochemical stability. While applicable to various battery types, it is not specific to lithium-ion technology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"1. A polymer electrolyte comprising...\",\n        \"2. The electrolyte of claim 1, wherein...\",\n        \"3. A battery cell comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66732", "text": "{\n    \"patent_title\": \"Miniature Implantable Cardiac Monitor\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Medtronic Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-14\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature implantable cardiac monitor for long-term monitoring of heart rhythm abnormalities. The device is designed to be fully biocompatible and wirelessly transmit data to an external receiver.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Implantable Defibrillator\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Wireless Data Transmission System\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Biocompatible Materials\"\n        },\n        {\n            \"patent_number\": \"US20050277821A1\",\n            \"title\": \"Cardiac monitoring device\"\n        },\n        {\n            \"patent_number\": \"US20080132910A1\",\n            \"title\": \"Method and apparatus for detecting atrial fibrillation\"\n        }\n    ],\n    \"claims\": [\n        \"A miniature implantable cardiac monitor comprising...\",\n        \"A method for monitoring heart rhythm abnormalities...\"\n    ]\n}"}
