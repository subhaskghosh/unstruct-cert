{"_id": "Academic--patents--p--66969", "text": "{\n    \"patent_title\": \"Wireless Communication System with Beamforming\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Qualcomm\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless communication system utilizing beamforming techniques to improve signal quality and reduce interference.  The system includes a transmitter and receiver configured to dynamically adjust beam patterns based on channel conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Beamforming Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication system comprising: a transmitter configured to generate a beamformed signal.\",\n        \"The system of claim 1, wherein the transmitter adjusts the beam pattern based on channel state information.\",\n        \"A receiver configured to receive the beamformed signal.\",\n        \"The receiver of claim 3, further comprising a signal processor.\",\n        \"A method for beamforming in a wireless communication system.\",\n        \"The method of claim 5, further comprising dynamically adjusting the beam pattern.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66969", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Independent Inventor\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-05-20\",\n    \"filing_date\": \"2019-05-20\",\n    \"issue_date\": \"2021-02-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A braking system for bicycles that utilizes a novel linkage mechanism to provide enhanced stopping power and modulation.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A bicycle braking system comprising a lever and a caliper.\",\n        \"The braking system of claim 1, wherein the caliper is hydraulically actuated.\",\n        \"A linkage mechanism for connecting the lever and caliper.\"\n    ]\n}"}
