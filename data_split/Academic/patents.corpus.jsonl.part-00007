{"_id": "Academic--patents--p--66611", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications. The system utilizes a low-power MEMS pressure sensor and a custom RF transceiver for remote data transmission. This sensor system is highly accurate and reliable.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Similar sensor technology\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for measuring pressure using a wireless sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66611", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2012-03-10\",\n    \"filing_date\": \"2012-03-10\",\n    \"issue_date\": \"2020-04-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery management system for electric vehicles. This system improves battery life and performance by optimizing charging and discharging cycles. The system includes advanced algorithms for state-of-charge estimation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related battery technology\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for managing battery charge...\"\n    ]\n}"}
