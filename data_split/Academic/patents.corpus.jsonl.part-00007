{"_id": "Academic--patents--p--66438", "text": "{\n    \"patent_title\": \"System and method for AI-powered image recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for image recognition utilizing artificial intelligence techniques, specifically deep convolutional neural networks. The system improves accuracy and efficiency in identifying objects within images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for identifying objects in an image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66438", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Acme Corp\"\n        },\n        {\n            \"name\": \"Eve Evans\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2021-07-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a braking system for bicycles, providing enhanced stopping power and improved safety through a novel cable tensioning mechanism. It incorporates lightweight materials and ergonomic design features.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in bicycle braking\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle braking system comprising...\",\n        \"A method for applying brakes to a bicycle...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66439", "text": "{\n    \"patent_title\": \"Neural Network Based Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2021-08-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel image recognition system leveraging a deep neural network architecture. The system significantly improves accuracy and efficiency in identifying objects within images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition using a neural network.\",\n        \"A system comprising a neural network for image analysis.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66439", "text": "{\n    \"patent_title\": \"Improved Combustion Engine Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Ford Motor Company\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-20\",\n    \"filing_date\": \"2020-03-01\",\n    \"issue_date\": \"2022-01-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new internal combustion engine design that improves fuel efficiency and reduces emissions. The design incorporates a novel valve timing mechanism and combustion chamber geometry.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"An internal combustion engine with improved fuel efficiency.\",\n        \"A valve timing mechanism for an engine.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66440", "text": "{\n    \"patent_title\": \"System and method for dynamic spectrum allocation in wireless communication networks\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US8761234B2\",\n    \"priority_date\": \"2008-12-15\",\n    \"filing_date\": \"2009-06-01\",\n    \"issue_date\": \"2014-06-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for dynamically allocating spectrum in wireless communication networks is disclosed. The system optimizes spectrum utilization by considering real-time network conditions and user demands.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7656789B1\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A method for dynamically allocating spectrum...\",\n        \"A system for optimizing spectrum utilization...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66440", "text": "{\n    \"patent_title\": \"Method for enhancing image resolution using deep learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"California Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2016-03-10\",\n    \"filing_date\": \"2017-01-20\",\n    \"issue_date\": \"2019-05-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for enhancing image resolution using deep learning techniques is presented. The method utilizes convolutional neural networks to improve the clarity and detail of images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution...\",\n        \"A system utilizing a convolutional neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66441", "text": "{\n    \"patent_title\": \"System and Method for Neural Network-Based Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2018-03-01\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition utilizing a deep neural network architecture. The system is capable of identifying objects with high accuracy and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66441", "text": "{\n    \"patent_title\": \"Improved Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Motors\"\n        }\n    ],\n    \"patent_number\": \"US11123456B2\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2018-02-10\",\n    \"issue_date\": \"2020-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles. The system optimizes battery performance and extends battery life through advanced control algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66442", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for enhancing the resolution of images using deep learning techniques. The system utilizes a convolutional neural network trained on a large dataset of high-resolution images to predict and reconstruct high-frequency details in low-resolution images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for enhancing image resolution comprising...\",\n        \"2. The method of claim 1, wherein the deep learning model is a convolutional neural network.\",\n        \"3. A system for enhancing image resolution comprising...\",\n        \"4. The system of claim 3, further comprising...\",\n        \"5. The method of claim 1, wherein the training data comprises...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66442", "text": "{\n    \"patent_title\": \"Improved Noise Reduction in Digital Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-01-05\",\n    \"filing_date\": \"2021-03-10\",\n    \"issue_date\": \"2023-06-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel algorithm for reducing noise in digital images. The algorithm utilizes a wavelet transform and adaptive thresholding to effectively remove noise while preserving image details.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for reducing noise in a digital image comprising...\",\n        \"2. The method of claim 1, wherein the wavelet transform is a Daubechies wavelet.\",\n        \"3. A digital image processing system comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66443", "text": "{\n    \"patent_title\": \"System and Method for Image Recognition Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for image recognition utilizing deep convolutional neural networks. The system is capable of accurately identifying objects in images with high precision and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising a deep convolutional neural network.\",\n        \"A method for identifying objects in an image using a convolutional neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66443", "text": "{\n    \"patent_title\": \"Improved Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Motors\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery management system is presented, designed to optimize the performance and longevity of lithium-ion batteries in electric vehicles. The system incorporates advanced algorithms for charge control and thermal management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for an electric vehicle comprising a charge controller and a thermal management unit.\",\n        \"A method for controlling the charging of a lithium-ion battery in an electric vehicle.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66444", "text": "{\n    \"patent_title\": \"System and method for AI-powered image recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system and method for image recognition using artificial intelligence techniques. The system employs convolutional neural networks to analyze images and identify objects with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for processing images...\",\n        \"The system of claim 1, wherein the neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66444", "text": "{\n    \"patent_title\": \"Advanced Control System for Robotics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11112222B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a novel control system for robotics, incorporating advanced algorithms for path planning and obstacle avoidance. The system leverages feedback loops and predictive modeling to achieve highly precise and adaptable robotic movement. The system applies artificial intelligence to optimize trajectory planning.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A control system for a robot comprising...\",\n        \"A method for controlling robotic movement...\",\n        \"The control system of claim 1, wherein the path planning algorithm...\",\n        \"The control system of claim 2, further comprising...\",\n        \"The control system of claim 3, wherein the obstacle avoidance...\",\n        \"The control system of claim 4, wherein the trajectory is optimized...\",\n        \"The control system of claim 5, wherein the feedback loop...\",\n        \"The control system of claim 6, wherein the predictive modeling...\",\n        \"The control system of claim 7, utilizing artificial intelligence...\",\n        \"The control system of claim 8, wherein the optimization uses...\",\n        \"A robotic system utilizing the control system of claim 1.\",\n        \"The robotic system of claim 10, further comprising...\",\n        \"The robotic system of claim 11, capable of...\",\n        \"The robotic system of claim 12, including...\",\n        \"The robotic system of claim 13, integrated with...\",\n        \"The control system of claim 1, used in a manufacturing environment.\",\n        \"The control system of claim 1, implemented in a warehouse automation system.\",\n        \"The control system of claim 1, suitable for use in medical applications.\",\n        \"The control system of claim 1, designed for exploration in hazardous environments.\",\n        \"The control system of claim 1, adapted for use in space exploration.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66445", "text": "{\n    \"patent_title\": \"Neural Network Architecture for Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel neural network architecture for improved image recognition accuracy. The network utilizes a convolutional neural network with a unique pooling layer design to enhance feature extraction. Applications include autonomous vehicles and medical image analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Convolutional Neural Network Implementation\"\n        }\n    ],\n    \"claims\": [\n        \"A neural network comprising a convolutional layer, a pooling layer, and a fully connected layer.\",\n        \"The neural network of claim 1, wherein the pooling layer is a max-pooling layer.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66445", "text": "{\n    \"patent_title\": \"System for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a new algorithm for efficient data compression using Huffman coding and run-length encoding. The system achieves high compression ratios for text and image data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Improved Huffman Coding Method\"\n        }\n    ],\n    \"claims\": [\n        \"A data compression system comprising a Huffman encoder and a run-length encoder.\",\n        \"The data compression system of claim 1, wherein the Huffman encoder uses adaptive coding.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66446", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the resolution of images using a deep learning model. The model is trained on a large dataset of high-resolution images and can be used to increase the resolution of low-resolution images while preserving image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Super-Resolution using Convolutional Neural Networks\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising...\",\n        \"The method of claim 1, wherein the deep learning model is a convolutional neural network.\",\n        \"A system for enhancing image resolution...\",\n        \"The system of claim 3, further comprising...\",\n        \"The method of claim 2, wherein the convolutional neural network is trained using...\",\n        \"The system of claim 4, wherein the image processing unit is configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66446", "text": "{\n    \"patent_title\": \"Improved Color Correction Algorithm for Digital Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Adobe Systems\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-15\",\n    \"issue_date\": \"2021-08-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved color correction algorithm for digital images that automatically adjusts the color balance and contrast of images to produce more natural-looking results.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Automatic Color Balance Adjustment\"\n        }\n    ],\n    \"claims\": [\n        \"A method for color correction comprising...\",\n        \"The method of claim 1, wherein the color balance is adjusted based on...\",\n        \"A system for color correction...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66447", "text": "{\n    \"patent_title\": \"System and method for improved battery charging\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-12-15\",\n    \"filing_date\": \"2015-03-10\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for improving the efficiency and lifespan of batteries using a novel charging algorithm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for charging a battery comprising...\",\n        \"A system for controlling battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66447", "text": "{\n    \"patent_title\": \"Method for producing high-strength alloys\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2015-02-15\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for producing high-strength alloys with improved corrosion resistance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for producing an alloy comprising...\",\n        \"An alloy having a tensile strength of...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66448", "text": "{\n    \"patent_title\": \"System and Method for Adaptive Beamforming in Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-15\",\n    \"filing_date\": \"2015-03-20\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for adaptive beamforming in wireless communication networks are disclosed. The system utilizes real-time channel state information to dynamically adjust beamforming weights, improving signal quality and network capacity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Beamforming Techniques for MIMO Systems\"\n        }\n    ],\n    \"claims\": [\n        \"A system for adaptive beamforming comprising...\",\n        \"A method for adjusting beamforming weights...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66448", "text": "{\n    \"patent_title\": \"Method for Enhanced Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for enhancing image recognition accuracy using deep learning techniques is presented. The method utilizes convolutional neural networks to extract features from images and classify them with improved precision.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US91234567B2\",\n            \"title\": \"Deep Learning for Image Classification\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for classifying images based on features...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66449", "text": "{\n    \"patent_title\": \"System and Method for Personalized Recommendation Using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Sergey Brin\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Larry Page\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2008-03-15\",\n    \"filing_date\": \"2008-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for providing personalized recommendations to users based on machine learning algorithms. The system analyzes user behavior and preferences to generate relevant recommendations.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A method for providing personalized recommendations comprising:...\",\n        \"A system for providing personalized recommendations...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66449", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2007-11-20\",\n    \"filing_date\": \"2007-11-20\",\n    \"issue_date\": \"2015-12-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system designed to improve efficiency and prolong battery life. It incorporates advanced charging algorithms and thermal management techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising:...\",\n        \"A method for controlling battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66450", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-05-15\",\n    \"filing_date\": \"2010-03-01\",\n    \"issue_date\": \"2018-11-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel data compression algorithm utilizing adaptive Huffman coding and run-length encoding.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data comprising...\",\n        \"A system for implementing the compression method...\"\n    ]\n}"}
