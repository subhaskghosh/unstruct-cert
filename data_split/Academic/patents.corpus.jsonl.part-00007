{"_id": "Academic--patents--p--66951", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2021-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing image recognition accuracy using a deep learning model. The model is trained on a large dataset of images and uses convolutional neural networks to extract features. The system can be used for a variety of applications, including object detection, image classification, and facial recognition.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Recognition System\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Deep Learning Framework\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Convolutional Neural Network Architecture\"\n        },\n        {\n            \"patent_number\": \"US11345678B2\",\n            \"title\": \"Image Feature Extraction\"\n        },\n        {\n            \"patent_number\": \"US10456789B1\",\n            \"title\": \"Object Detection Method\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a deep learning model...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66951", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2019-12-01\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery technology designed for electric vehicles, offering increased energy density and faster charging times. The battery utilizes a new electrolyte composition and cell structure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US99876543B1\",\n            \"title\": \"Lithium-Ion Battery Design\"\n        },\n        {\n            \"patent_number\": \"US10234567B2\",\n            \"title\": \"Electrolyte Composition for Batteries\"\n        },\n        {\n            \"patent_number\": \"US88765432B1\",\n            \"title\": \"Battery Management System\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising...\",\n        \"A method for manufacturing a battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66952", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Wireless Communication Security\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Qualcomm\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system and method for enhancing security in wireless communication networks. The system utilizes advanced encryption techniques to protect data transmission and prevent unauthorized access. The system incorporates features for secure key exchange and authentication.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for secure wireless communication comprising...\",\n        \"A system for encrypting data transmissions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66952", "text": "{\n    \"patent_title\": \"Improved Battery Life for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Apple Inc.\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-05-20\",\n    \"issue_date\": \"2017-02-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel technique for extending battery life in mobile devices. The system employs dynamic power management and optimized energy consumption algorithms. It improves the overall user experience by reducing the frequency of battery charging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for dynamic power management in a mobile device comprising...\",\n        \"A system for optimizing energy consumption...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66953", "text": "{\n    \"patent_title\": \"Advanced Lithium-Ion Battery with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved lithium-ion battery with a novel electrolyte composition that enhances its stability and performance at high temperatures. The battery exhibits increased cycle life and reduced risk of thermal runaway.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Lithium-Ion Battery Electrode Materials\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising a novel electrolyte composition.\",\n        \"The battery of claim 1, wherein the electrolyte composition comprises a lithium salt and a solvent.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66953", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2014-12-10\",\n    \"filing_date\": \"2014-12-10\",\n    \"issue_date\": \"2019-03-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system for lithium-ion batteries, designed to optimize charging and discharging processes and prevent overcharge or discharge conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Advanced Lithium-Ion Battery with Enhanced Stability\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising a voltage monitoring circuit.\",\n        \"The system of claim 1, further comprising a current monitoring circuit.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66954", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Improved Electrolyte\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2018-02-10\",\n    \"issue_date\": \"2020-05-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a lithium-ion battery with a novel electrolyte composition that enhances energy density and cycle life. The electrolyte is designed to mitigate dendrite formation and improve safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"kind\": \"cited by\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66954", "text": "{\n    \"patent_title\": \"Sodium-Ion Battery with Organic Electrolyte\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2021-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a sodium-ion battery utilizing an organic electrolyte, offering a cost-effective and environmentally friendly alternative to lithium-ion batteries. The electrolyte is designed for high ionic conductivity and stability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"kind\": \"cited by\"\n        }\n    ],\n    \"claims\": [\n        \"A sodium-ion battery comprising...\",\n        \"An organic electrolyte composition...\"\n    ]\n}"}
