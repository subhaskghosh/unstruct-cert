{"_id": "Academic--patents--p--67099", "text": "{\n    \"patent_title\": \"Improved Nasal Cannula Design for Enhanced Patient Comfort\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2021-11-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel nasal cannula design incorporating flexible materials and ergonomic shaping to minimize discomfort and improve oxygen delivery. The design reduces pressure points and enhances patient acceptance of prolonged oxygen therapy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A nasal cannula comprising a flexible tube...\",\n        \"The nasal cannula of claim 1, wherein the material is silicone.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67099", "text": "{\n    \"patent_title\": \"Automated Surgical Robot with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2021-05-20\",\n    \"filing_date\": \"2021-05-20\",\n    \"issue_date\": \"2022-09-13\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated surgical robot system utilizing advanced sensors and algorithms to achieve superior precision during complex surgical procedures. The system incorporates real-time image guidance and robotic arm control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robot comprising a robotic arm...\",\n        \"The surgical robot of claim 1, further comprising a camera.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67100", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Super-Resolution with Perceptual Loss\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2021-01-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for super-resolution of images using deep convolutional neural networks and perceptual loss functions. This addresses the limitations of traditional methods in preserving perceptual quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on image scaling techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for increasing the resolution of an input image...\",\n        \"A deep learning model configured to perform image super-resolution...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67100", "text": "{\n    \"patent_title\": \"Color Correction Algorithm for Digital Cameras\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2017-03-10\",\n    \"filing_date\": \"2018-03-10\",\n    \"issue_date\": \"2020-12-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved color correction algorithm for digital cameras, enhancing color accuracy and vibrancy. This builds upon existing color space transformation techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Baseline color correction methods\"\n        }\n    ],\n    \"claims\": [\n        \"A method for adjusting the color balance of an image...\",\n        \"A digital camera comprising a color correction module...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67101", "text": "{\n    \"patent_title\": \"Improved Method for Detecting Early-Stage Lung Nodules using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel deep learning algorithm for the detection of early-stage lung nodules in CT scans. The algorithm significantly improves diagnostic accuracy compared to existing methods, particularly for detecting subtle anomalies that are often missed.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting lung nodules in CT scans comprising...\",\n        \"A computer-implemented system for identifying...\",\n        \"The method of claim 1, wherein the deep learning algorithm...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67101", "text": "{\n    \"patent_title\": \"MRI Coil Design for Enhanced Signal Strength\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2016-11-01\",\n    \"issue_date\": \"2018-08-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new design for an MRI coil that provides significantly enhanced signal strength, improving image resolution. The coil utilizes a novel arrangement of conductive elements to maximize signal capture.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil comprising...\",\n        \"The MRI coil of claim 1, wherein the conductive elements...\",\n        \"A method for generating an MRI image using the coil...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67102", "text": "{\n    \"patent_title\": \"Implantable Bioelectronic Device for Targeted Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-09-20\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable bioelectronic device providing localized and controlled drug delivery based on real-time physiological feedback. The device uses a microfabricated sensor and a drug reservoir to modulate therapeutic agent release.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"prior art\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"related work\"\n        },\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"relevance\": \"cited by others\"\n        },\n        {\n            \"patent_number\": \"US12112233B2\",\n            \"relevance\": \"cited by others\"\n        },\n        {\n            \"patent_number\": \"US13113344B2\",\n            \"relevance\": \"cited by others\"\n        }\n    ],\n    \"claims\": [\n        \"A biocompatible implantable device comprising...\",\n        \"A method for controlled drug release using...\",\n        \"A system for monitoring physiological parameters and...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67102", "text": "{\n    \"patent_title\": \"Improved Surgical Stapler Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"Johnson & Johnson\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2019-01-10\",\n    \"filing_date\": \"2019-07-15\",\n    \"issue_date\": \"2020-11-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical stapler with an improved jaw alignment mechanism and a more ergonomic handle. Provides increased precision during surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"prior art\"\n        },\n        {\n            \"patent_number\": \"US8543210B2\",\n            \"relevance\": \"related work\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"A jaw alignment mechanism for...\",\n        \"An ergonomic handle designed to...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67103", "text": "{\n    \"patent_title\": \"Surgical Robotic System with Enhanced Precision Control\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A robotic surgical system allowing for highly precise movements within a confined surgical space, minimizing tissue damage and improving patient outcomes. The system utilizes advanced sensor feedback and AI-powered control algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"type\": \"Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic system comprising...\",\n        \"A method for performing minimally invasive surgery using a robotic system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67103", "text": "{\n    \"patent_title\": \"Improved Stent Design for Coronary Artery Disease\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel stent design with improved biocompatibility and reduced risk of thrombosis. The stent features a unique coating material and a flexible structure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"type\": \"Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A stent comprising...\",\n        \"A method for treating coronary artery disease using a stent...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67104", "text": "{\n    \"patent_title\": \"Noise Reduction in Digital Images Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-11-20\",\n    \"issue_date\": \"2021-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep learning architecture for reducing noise in digital images is presented. The method utilizes convolutional neural networks trained on a large dataset of noisy and clean images, resulting in significant improvements in image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"kind\": \"cited_by\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing noise in a digital image...\",\n        \"A system comprising a deep neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67104", "text": "{\n    \"patent_title\": \"Image Compression Method for Satellite Imagery\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-12-01\",\n    \"filing_date\": \"2019-06-10\",\n    \"issue_date\": \"2020-12-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new image compression algorithm specifically designed for satellite imagery is described. This algorithm utilizes wavelet transforms and entropy coding to achieve high compression ratios with minimal loss of information.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US4543641\",\n            \"kind\": \"cited_by\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"cited_by\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing satellite imagery...\",\n        \"A system utilizing wavelet transforms...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67105", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2015-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for enhancing the resolution and clarity of medical images reconstructed from raw data, using a novel iterative reconstruction algorithm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for enhancing medical image resolution...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67105", "text": "{\n    \"patent_title\": \"Automated Surgical Tool Tracking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2014-11-01\",\n    \"filing_date\": \"2015-11-01\",\n    \"issue_date\": \"2017-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for accurately tracking the position and orientation of surgical tools during minimally invasive procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical tool tracking system comprising...\",\n        \"A method for determining the position of a surgical tool...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67106", "text": "{\n    \"patent_title\": \"Implantable Cardiac Rhythm Management System with Adaptive Pacing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac rhythm management system capable of adaptively pacing based on real-time physiological data, improving patient quality of life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Similar pacing algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"A method for adaptively pacing a heart...\",\n        \"An implantable device comprising a sensor...\",\n        \"A system for optimizing cardiac output...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67106", "text": "{\n    \"patent_title\": \"Improved Stent Design for Coronary Artery Disease\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"University of Valencia\"\n        }\n    ],\n    \"patent_number\": \"EP3876543B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2023-05-10\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"A novel stent design with enhanced biocompatibility and reduced risk of restenosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Previous stent designs\"\n        }\n    ],\n    \"claims\": [\n        \"A stent comprising a biocompatible coating...\",\n        \"A method for deploying a stent...\",\n        \"A device for preventing restenosis...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67107", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging Technique for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel magnetic resonance imaging (MRI) technique that enhances the detection of early-stage cancerous tumors. The technique utilizes a specific pulse sequence combined with a contrast agent that selectively accumulates in tumor cells.  The improved signal-to-noise ratio and contrast provide significantly better image quality, enabling earlier and more accurate diagnoses.  The method includes preprocessing steps to reduce artifacts and enhance image resolution.  Clinical trials have demonstrated increased sensitivity and specificity compared to existing MRI techniques. The system further incorporates machine learning algorithms for automated tumor identification and characterization.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8652012B2\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing the detection of cancerous tumors using MRI.\",\n        \"A contrast agent for use in MRI, designed for selective tumor cell accumulation.\",\n        \"A system comprising an MRI machine, a contrast agent, and a processor for image analysis.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67107", "text": "{\n    \"patent_title\": \"Portable X-Ray Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US7418529B2\",\n    \"priority_date\": \"2015-11-01\",\n    \"filing_date\": \"2015-11-01\",\n    \"issue_date\": \"2017-03-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A portable X-ray device for basic diagnostic imaging. The device is battery powered and lightweight. It is intended for use in field hospitals or remote locations.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6235001B1\"\n        }\n    ],\n    \"claims\": [\n        \"A portable X-ray device comprising a power source and an X-ray emitter.\",\n        \"A battery for powering the X-ray device.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67108", "text": "{\n    \"patent_title\": \"Adaptive Beamforming for Millimeter Wave Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-01\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for adaptive beamforming in millimeter wave wireless communication systems. The invention utilizes machine learning algorithms to dynamically adjust beam patterns to optimize signal quality and minimize interference, addressing the challenges of high path loss and blockage in millimeter wave frequencies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on beamforming techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for adaptive beamforming comprising...\",\n        \"A system for implementing adaptive beamforming...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67108", "text": "{\n    \"patent_title\": \"Improved Antenna Design for Bluetooth Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Electronics Corp.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-08-20\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2020-02-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved antenna design for Bluetooth devices offering enhanced signal strength and reduced power consumption. The antenna utilizes a novel geometry to achieve better performance within the 2.4 GHz frequency band.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Previous antenna designs for Bluetooth.\"\n        }\n    ],\n    \"claims\": [\n        \"An antenna for Bluetooth devices characterized by...\",\n        \"A Bluetooth device incorporating the aforementioned antenna...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67109", "text": "{\n    \"patent_title\": \"Improved MRI Coil Design for Enhanced Image Resolution\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2018-05-10\",\n    \"filing_date\": \"2018-05-10\",\n    \"issue_date\": \"2019-12-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel MRI coil design utilizing a phased array configuration to improve signal-to-noise ratio and enhance image resolution in magnetic resonance imaging. The coil incorporates a metamaterial structure for focused signal reception.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8652001B2\",\n            \"title\": \"MRI Signal Enhancement Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A magnetic resonance imaging coil comprising a phased array of coil elements.\",\n        \"The coil of claim 1, further comprising a metamaterial structure.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67109", "text": "{\n    \"patent_title\": \"Ultrasound Image Processing Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-04-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel algorithm for processing ultrasound images to reduce noise and enhance image clarity. The algorithm utilizes wavelet transforms and adaptive filtering techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Wavelet Based Image Processing\"\n        }\n    ],\n    \"claims\": [\n        \"An ultrasound image processing method comprising applying a wavelet transform.\",\n        \"The method of claim 1, further comprising adaptive filtering.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67110", "text": "{\n    \"patent_title\": \"Enhanced Magnetic Resonance Imaging Contrast Agent\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel contrast agent for MRI that significantly improves image resolution and allows for earlier detection of tumors. The agent utilizes nanoparticles with targeted delivery capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"relevance\": \"Prior art in nanoparticle synthesis\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising nanoparticles...\",\n        \"A method for enhancing MRI image resolution...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67110", "text": "{\n    \"patent_title\": \"Automated X-Ray Analysis System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Siemens Healthineers\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of Michigan\"\n        },\n        {\n            \"name\": \"Eve Franklin\",\n            \"affiliation\": \"Mayo Clinic\"\n        },\n        {\n            \"name\": \"Fred Garcia\",\n            \"affiliation\": \"IBM Research\"\n        }\n    ],\n    \"patent_number\": \"US10245789B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for analyzing X-ray images to detect fractures and other abnormalities. The system uses machine learning algorithms to improve accuracy and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related to early machine learning applications in radiology\"\n        }\n    ],\n    \"claims\": [\n        \"A system for analyzing X-ray images...\",\n        \"A method for detecting fractures using machine learning...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67111", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Robotic Assistance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-08-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A robotic surgical system enabling precise and minimally invasive procedures through enhanced dexterity and visualization. The system incorporates advanced sensor feedback and real-time image guidance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8986432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system comprising...\",\n        \"A method for performing minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67111", "text": "{\n    \"patent_title\": \"Improved Scalpel Design for Traditional Surgery\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Johnson & Johnson\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2014-12-01\",\n    \"filing_date\": \"2014-12-01\",\n    \"issue_date\": \"2017-05-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new scalpel design with an ergonomic handle and improved blade sharpness for conventional open surgical procedures.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A scalpel comprising...\",\n        \"A handle ergonomically designed for surgical use...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67112", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Super-Resolution Using Generative Adversarial Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Ming-Hsuan Yang\",\n            \"affiliation\": \"University of California, Los Angeles\"\n        },\n        {\n            \"name\": \"Jianchao Yang\",\n            \"affiliation\": \"University of California, Los Angeles\"\n        }\n    ],\n    \"patent_number\": \"US10490224B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2020-11-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for improving the resolution of images using a deep learning model based on generative adversarial networks (GANs). The system can generate high-resolution images from low-resolution inputs with enhanced details and realistic textures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9989251B2\",\n            \"relevance\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for super-resolving an image, comprising: training a generative adversarial network (GAN) with a dataset of high-resolution and corresponding low-resolution images; receiving a low-resolution image as input; and applying the trained GAN to generate a high-resolution image from the low-resolution image.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67112", "text": "{\n    \"patent_title\": \"Method for Enhancing Contrast in Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US8560123B2\",\n    \"priority_date\": \"2011-09-20\",\n    \"filing_date\": \"2012-09-20\",\n    \"issue_date\": \"2013-10-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method for improving the contrast of medical images, such as X-rays and CT scans, for better visualization of anatomical structures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7892543B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing the contrast of a medical image, comprising: receiving a medical image; applying a contrast-limited adaptive histogram equalization (CLAHE) algorithm to the medical image; and displaying the enhanced medical image.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67113", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Object Detection in Real-Time Video Streams\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-12-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for object detection in video streams utilizing a novel convolutional neural network architecture for improved accuracy and speed. Applicable to autonomous vehicles, surveillance systems, and industrial automation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Deep Convolutional Neural Networks for Image Classification\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting objects in a video stream comprising...\",\n        \"A system for real-time object detection...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67113", "text": "{\n    \"patent_title\": \"Automated Diagnosis of Pulmonary Nodules Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Martinez\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11345678B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-07-15\",\n    \"issue_date\": \"2022-05-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep learning system for the automated detection and diagnosis of pulmonary nodules in medical images, leveraging convolutional neural networks and image segmentation techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B1\",\n            \"title\": \"Computer-Aided Detection of Lung Cancer\"\n        }\n    ],\n    \"claims\": [\n        \"A method for diagnosing pulmonary nodules comprising...\",\n        \"A system for automated medical image analysis...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67114", "text": "{\n    \"patent_title\": \"Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-15\",\n    \"filing_date\": \"2015-03-20\",\n    \"issue_date\": \"2019-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an implantable biosensor for continuous glucose monitoring. The device utilizes a novel enzymatic reaction to accurately measure glucose levels in interstitial fluid. The system is designed to provide real-time data to patients and healthcare providers, leading to improved patient outcomes and better diabetes management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Miniaturized Glucose Sensor\"\n        }\n    ],\n    \"claims\": [\n        \"A biosensor for continuous glucose monitoring comprising...\",\n        \"A method for measuring glucose levels using the biosensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67114", "text": "{\n    \"patent_title\": \"Surgical Instrument for Laparoscopic Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2017-05-05\",\n    \"issue_date\": \"2020-07-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a surgical instrument designed for use in laparoscopic procedures. The instrument features an articulated tip and enhanced gripping capabilities for precise tissue manipulation. It allows surgeons to perform minimally invasive surgeries with greater control and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Articulated Surgical Instrument\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument with an articulated tip comprising...\",\n        \"A method for performing laparoscopic surgery using the instrument...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67115", "text": "{\n    \"patent_title\": \"Enhanced Resolution Medical Imaging System Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A medical imaging system utilizing deep learning algorithms to enhance the resolution and clarity of medical images, enabling improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing medical image resolution using a convolutional neural network.\",\n        \"A medical imaging system comprising a deep learning module for image processing.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67115", "text": "{\n    \"patent_title\": \"Portable X-Ray Device for Veterinary Use\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"PetScan Technologies\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-08-01\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2021-01-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A compact and portable X-ray device designed for veterinary applications, providing rapid and convenient imaging for animal diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A portable X-ray device for animal imaging.\",\n        \"A system for rapid veterinary diagnosis using X-ray technology.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67116", "text": "{\n    \"patent_title\": \"Remote Physiological Monitoring System and Method\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Boston University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-29\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for remote monitoring of vital signs, including heart rate, blood pressure, and oxygen saturation, using wearable sensors and a cloud-based platform. The system provides real-time alerts to healthcare providers.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in wearable sensor technology\"\n        }\n    ],\n    \"claims\": [\n        \"A system for remotely monitoring a patient's physiological parameters.\",\n        \"A method for transmitting vital sign data to a healthcare provider.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67116", "text": "{\n    \"patent_title\": \"Improved Surgical Instrument\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-05-01\",\n    \"filing_date\": \"2019-11-10\",\n    \"issue_date\": \"2021-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical instrument with enhanced precision and ergonomics. The instrument is designed to minimize tissue damage during surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous surgical instrument designs\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument with an improved handle.\",\n        \"A blade for a surgical instrument.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67117", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Sepsis Diagnosis\",\n    \"inventors\": [\n        {\n            \"name\": \"Manu Prakash\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Zhang\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-08-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A portable, low-cost microfluidic device for the rapid diagnosis of sepsis at the point-of-care. The device utilizes a novel droplet-based approach to detect biomarkers associated with sepsis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on microfluidic devices.\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for detecting sepsis biomarkers...\",\n        \"A system for point-of-care diagnosis...\",\n        \"The device according to claim 1, wherein...\",\n        \"The method according to claim 2, further comprising...\",\n        \"The system according to claim 3, wherein...\",\n        \"A droplet generation module...\",\n        \"A detection module...\",\n        \"A control module...\",\n        \"A data analysis module...\",\n        \"A housing for containing the modules...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67117", "text": "{\n    \"patent_title\": \"Improved Catheter Design\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel design for a central venous catheter with improved kink resistance and reduced risk of infection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art on catheter materials.\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising...\",\n        \"The catheter according to claim 1, wherein...\",\n        \"A method for inserting a catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67118", "text": "{\n    \"patent_title\": \"System and method for object detection in real-time video streams\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for detecting objects in real-time video streams using deep learning techniques. The system is designed for practical applications such as surveillance and autonomous vehicles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for detecting objects in a video stream...\",\n        \"A method for training a deep learning model...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67118", "text": "{\n    \"patent_title\": \"A Novel Mathematical Framework for Image Feature Extraction\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University Research Labs\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-04-01\",\n    \"filing_date\": \"2020-06-10\",\n    \"issue_date\": \"2023-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel mathematical framework for extracting features from images, focusing on theoretical advancements in signal processing and pattern recognition. It introduces a new transform and its properties.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\"\n        }\n    ],\n    \"claims\": [\n        \"A mathematical transform for image feature extraction...\",\n        \"A method for analyzing image data based on the new transform...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67119", "text": "{\n    \"patent_title\": \"Improved Medical Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-08-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel deep learning approach for reconstructing medical images from limited data, resulting in improved diagnostic accuracy and reduced radiation exposure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for processing medical image data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67119", "text": "{\n    \"patent_title\": \"New Contrast Agent for MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Pharmaceutical Corp.\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Pharmaceutical Corp.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2020-04-01\",\n    \"filing_date\": \"2020-06-10\",\n    \"issue_date\": \"2021-12-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel contrast agent for magnetic resonance imaging (MRI) providing enhanced visualization of blood vessels. \",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10111213B1\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"A method for enhancing MRI images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67120", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging Technique for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-12-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel magnetic resonance imaging (MRI) technique that utilizes advanced pulse sequences and image reconstruction algorithms to enhance the detection of early-stage cancerous tumors. Results demonstrate a statistically significant increase in diagnostic accuracy compared to conventional MRI methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"relevance\": \"Prior art in MRI pulse sequences\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI comprising...\",\n        \"An MRI system configured to implement the method...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67120", "text": "{\n    \"patent_title\": \"Advancements in Computed Tomography Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Carl Davis\",\n            \"affiliation\": \"Siemens Healthineers\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        }\n    ],\n    \"patent_number\": \"US10456789B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to improved algorithms for reconstructing images from computed tomography (CT) data. The algorithms reduce noise and artifacts, leading to higher quality images for diagnostic purposes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Previous work on CT image reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing CT images...\",\n        \"A CT system comprising a processor configured...\",\n        \"A computer program product for CT image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67121", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Articulation\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Boston Scientific Corporation\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a surgical stapler with an improved articulation mechanism allowing for minimally invasive surgery procedures with enhanced precision and control. The design reduces patient trauma and recovery time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in surgical stapler design\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an articulation mechanism...\",\n        \"The surgical stapler of claim 1, wherein the articulation mechanism...\",\n        \"A method for performing minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67121", "text": "{\n    \"patent_title\": \"Drug Delivery System for Oncology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10294857B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2016-11-01\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel drug delivery system for targeted cancer therapy, utilizing nanoparticles to encapsulate and release chemotherapeutic agents directly to tumor cells. This system improves efficacy and reduces side effects.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9543210B2\",\n            \"relevance\": \"Previous work on nanoparticle drug delivery\"\n        }\n    ],\n    \"claims\": [\n        \"A drug delivery system comprising nanoparticles...\",\n        \"The drug delivery system of claim 1, wherein the nanoparticles...\",\n        \"A method for treating cancer...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67122", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system incorporating advanced imaging and robotic control to enhance precision and improve patient recovery times following surgical procedures. The system aims to reduce complications and improve overall surgical outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art relating to robotic surgery.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising a robotic arm and a high-resolution imaging module.\",\n        \"A method for performing minimally invasive surgery using the surgical system.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67122", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Angiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Li Wei\",\n            \"affiliation\": \"Shanghai Jiao Tong University\"\n        },\n        {\n            \"name\": \"Zhang Mei\",\n            \"affiliation\": \"Huazhong University of Science and Technology\"\n        }\n    ],\n    \"patent_number\": \"CN107890123B\",\n    \"priority_date\": \"2017-08-15\",\n    \"filing_date\": \"2017-08-15\",\n    \"issue_date\": \"2018-11-20\",\n    \"patent_office\": \"SIPO\",\n    \"abstract\": \"A novel catheter design offering improved maneuverability and reduced trauma during angiography procedures. The catheter utilizes a specialized tip geometry to navigate complex vascular structures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related to prior art in catheter tip designs.\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible shaft and a tapered tip.\",\n        \"A method for performing angiography using the catheter.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67123", "text": "{\n    \"patent_title\": \"Deep Learning for Enhanced Image Resolution\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-05-20\",\n    \"issue_date\": \"2023-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This patent discloses a novel deep learning architecture for enhancing the resolution of digital images. The system utilizes generative adversarial networks (GANs) to produce high-resolution images from low-resolution inputs, significantly improving visual quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution using a deep learning model.\",\n        \"A system comprising a generative adversarial network (GAN) for upscaling images.\",\n        \"An image processing device configured to implement the method of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67123", "text": "{\n    \"patent_title\": \"Method for Compressing Digital Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-12-10\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2022-08-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This patent discloses a method for compressing digital images using a wavelet transform. The method reduces the file size of images while maintaining acceptable image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing digital images using a wavelet transform.\",\n        \"A system for compressing images.\",\n        \"A computer-readable medium storing instructions for implementing the method of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67124", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-04-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system comprising a small diameter endoscope with enhanced imaging capabilities and robotic surgical arms for precise tissue manipulation. This system allows for less traumatic surgical procedures and faster patient recovery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8652000B2\",\n            \"relevance\": \"Related prior art in endoscopic visualization.\"\n        }\n    ],\n    \"claims\": [\n        \"A minimally invasive surgical system comprising...\",\n        \"An endoscope with a diameter less than 5mm...\",\n        \"Robotic surgical arms controlled by a surgeon...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67124", "text": "{\n    \"patent_title\": \"Pharmaceutical Compound for Treating Cardiovascular Disease\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Pfizer Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-03-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel pharmaceutical compound designed to reduce blood pressure and improve cardiovascular health. The compound acts as an ACE inhibitor with increased bioavailability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Prior art relating to ACE inhibitors.\"\n        }\n    ],\n    \"claims\": [\n        \"A pharmaceutical compound having the formula...\",\n        \"A method of treating hypertension comprising administering...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67125", "text": "{\n    \"patent_title\": \"Method and system for adaptive image enhancement using deep learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for adaptively enhancing images using deep convolutional neural networks. The system learns to optimize image quality based on perceptual metrics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"count\": 150\n        },\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"count\": 120\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image comprising:...\",\n        \"A system for processing images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67125", "text": "{\n    \"patent_title\": \"Improved algorithm for JPEG compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-15\",\n    \"issue_date\": \"2020-01-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved algorithm for JPEG image compression, reducing file size without significant loss of quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"count\": 20\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image using JPEG...\",\n        \"A system for encoding image data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67126", "text": "{\n    \"patent_title\": \"Novel MRI Contrast Agent for Enhanced Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"David A. Hauber\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel MRI contrast agent utilizing biocompatible nanoparticles enhances tumor detection sensitivity and specificity, significantly improving diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on MRI contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A composition comprising biocompatible nanoparticles and a paramagnetic metal ion.\",\n        \"A method for enhancing tumor detection using the aforementioned composition.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67126", "text": "{\n    \"patent_title\": \"Improved Method for CT Scan Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-12-20\",\n    \"filing_date\": \"2018-01-10\",\n    \"issue_date\": \"2021-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved algorithm for reconstructing images from CT scan data, resulting in slightly reduced noise and faster processing times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Existing CT scan reconstruction algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing CT scan images using a modified filtering algorithm.\",\n        \"A computer-readable medium storing instructions for performing the aforementioned method.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67127", "text": "{\n    \"patent_title\": \"Enhanced Medical Imaging Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel medical imaging technique utilizing deep learning algorithms to improve diagnostic accuracy and reduce radiation exposure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image reconstruction.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing medical images using a convolutional neural network.\",\n        \"A system for diagnosing diseases based on enhanced medical images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67127", "text": "{\n    \"patent_title\": \"Improved X-Ray Tube Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"GE Healthcare\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2017-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved design for X-ray tubes to increase output power and lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous X-ray tube designs.\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube with a modified anode material.\",\n        \"A method for manufacturing high-power X-ray tubes.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67128", "text": "{\n    \"patent_title\": \"Improved MRI Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel deep learning architecture for significantly improving the speed and accuracy of MRI reconstruction. Initial results demonstrate a breakthrough in image quality and reduced scan times, potentially revolutionizing medical diagnostics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Conventional MRI Reconstruction Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images using a deep convolutional neural network.\",\n        \"A system comprising a MRI scanner and a processing unit implementing the method.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67128", "text": "{\n    \"patent_title\": \"Enhanced X-ray Image Filtering\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new digital filter for reducing noise in X-ray images, improving diagnostic clarity.  It provides incremental improvements over existing filtering methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Standard X-ray Image Filters\"\n        }\n    ],\n    \"claims\": [\n        \"A digital filter for X-ray images.\",\n        \"A system for processing X-ray images using the digital filter.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67129", "text": "{\n    \"patent_title\": \"Improved MRI Image Reconstruction for Enhanced Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides methods and systems for improving the reconstruction of magnetic resonance images (MRI), resulting in enhanced visualization of tumors and improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760654B2\",\n            \"title\": \"MRI Data Processing Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for processing MRI data to enhance tumor visibility...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67129", "text": "{\n    \"patent_title\": \"Automated X-ray Analysis System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system for automating the analysis of X-ray images to detect bone fractures and other anomalies. The system utilizes advanced image processing algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Image Processing for Medical Applications\"\n        }\n    ],\n    \"claims\": [\n        \"A system for analyzing X-ray images comprising...\",\n        \"A method for detecting bone fractures in X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67130", "text": "{\n    \"patent_title\": \"Deep Learning for Automated Diagnosis of Lung Cancer from CT Scans\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-11-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for automated diagnosis of lung cancer using deep convolutional neural networks applied to computed tomography (CT) scans. The system identifies subtle patterns indicative of malignancy with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for diagnosing lung cancer comprising...\",\n        \"A system for analyzing CT scans...\",\n        \"A non-transitory computer-readable medium...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67130", "text": "{\n    \"patent_title\": \"Image Compression Technique for Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-12-01\",\n    \"filing_date\": \"2019-12-28\",\n    \"issue_date\": \"2021-08-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image compression algorithm specifically tailored for medical imaging data. This method reduces file sizes while maintaining diagnostic quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing medical images...\",\n        \"A system for reducing file size...\",\n        \"A computer program product...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67131", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Cancer Detection using Multi-Modal Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for improved cancer detection utilizing the synergistic combination of PET and MRI imaging modalities. The system employs advanced image processing techniques to identify subtle anomalies indicative of cancerous growth.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancer comprising...\",\n        \"A system for enhancing cancer detection using...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67131", "text": "{\n    \"patent_title\": \"Improved Algorithm for General Image Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2014-11-10\",\n    \"filing_date\": \"2014-11-10\",\n    \"issue_date\": \"2017-05-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An efficient algorithm for compressing digital images, reducing storage space and transmission bandwidth. The algorithm utilizes wavelet transforms and entropy coding techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image comprising...\",\n        \"A system for image compression utilizing...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67132", "text": "{\n    \"patent_title\": \"Method and System for Real-Time Image Enhancement in Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for real-time image enhancement in mobile devices is disclosed. The system utilizes a novel algorithm to improve image quality while minimizing computational overhead, enabling practical application in smartphones and tablets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image comprising...\",\n        \"A system for enhancing an image comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67132", "text": "{\n    \"patent_title\": \"Theoretical Framework for Multi-Dimensional Image Representation\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-01-20\",\n    \"filing_date\": \"2021-03-10\",\n    \"issue_date\": \"2023-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This patent describes a novel theoretical framework for representing images in multiple dimensions, exploring the mathematical properties of such representations. The work focuses on the theoretical foundations and does not include implementation details or practical applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"background\"\n        }\n    ],\n    \"claims\": [\n        \"A method for representing an image in a multi-dimensional space comprising...\",\n        \"An apparatus for mathematically transforming an image comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67133", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging Technique with Enhanced Contrast\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel MRI technique utilizing a sequence of gradient echoes to generate images with significantly improved contrast resolution, particularly for soft tissue imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"count\": 22\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"count\": 15\n        },\n        {\n            \"patent_number\": \"US10234567B2\",\n            \"count\": 11\n        }\n    ],\n    \"claims\": [\n        \"A method for generating MRI images...\",\n        \"An MRI apparatus comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67133", "text": "{\n    \"patent_title\": \"Portable X-Ray Device for Field Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A compact and portable X-ray device designed for use in remote locations or emergency situations, offering a lightweight and readily deployable imaging solution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"count\": 3\n        },\n        {\n            \"patent_number\": \"US9012345B1\",\n            \"count\": 5\n        }\n    ],\n    \"claims\": [\n        \"A portable X-ray device comprising...\",\n        \"A method for operating the device...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67134", "text": "{\n    \"patent_title\": \"Novel MRI Technique for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2019-11-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel magnetic resonance imaging (MRI) technique utilizing advanced pulse sequences and image reconstruction algorithms for early detection of cancerous tumors. The technique significantly improves sensitivity and specificity compared to conventional MRI.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relation\": \"Cited as prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for early cancer detection using MRI comprising...\",\n        \"An MRI system configured to implement the method...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67134", "text": "{\n    \"patent_title\": \"Improved X-Ray Shielding for Dental Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Sarah Johnson\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US11123456B1\",\n    \"priority_date\": \"2019-07-01\",\n    \"filing_date\": \"2019-07-01\",\n    \"issue_date\": \"2021-03-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an improved shielding material for X-ray machines used in dental procedures, reducing radiation exposure to both patients and operators. The material is cost-effective and easy to manufacture.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relation\": \"Cited as prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A shielding material for X-ray machines comprising...\",\n        \"A dental X-ray system incorporating the shielding material...\",\n        \"A method for manufacturing the shielding material...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67135", "text": "{\n    \"patent_title\": \"Surgical Instrument with Articulating Tip\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-05-15\",\n    \"issue_date\": \"2022-12-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical instrument comprising an articulating tip for enhanced maneuverability in minimally invasive procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related art in the field of surgical instruments\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising an articulating tip.\",\n        \"The surgical instrument of claim 1, wherein the articulating tip is remotely controlled.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67135", "text": "{\n    \"patent_title\": \"External Cardiac Pacemaker\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2023-01-10\",\n    \"filing_date\": \"2023-01-10\",\n    \"issue_date\": \"2023-08-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An external cardiac pacemaker for regulating heart rhythm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art related to cardiac pacing\"\n        }\n    ],\n    \"claims\": [\n        \"An external cardiac pacemaker.\",\n        \"The external cardiac pacemaker of claim 1, comprising a battery and a control circuit.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67136", "text": "{\n    \"patent_title\": \"Implantable Cardiac Monitor with Enhanced Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac monitor is disclosed, utilizing a novel data transmission protocol to improve signal clarity and reliability. This allows for more accurate monitoring of cardiac activity, ultimately leading to improved patient outcomes and earlier detection of arrhythmias.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8780823B2\",\n            \"relevance\": \"Prior art related to implantable cardiac devices\"\n        }\n    ],\n    \"claims\": [\n        \"A method for monitoring cardiac activity using an implantable device.\",\n        \"A system for transmitting cardiac data with improved signal integrity.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67136", "text": "{\n    \"patent_title\": \"Surgical Instrument for Bone Cutting\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Acme Surgical Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2018-07-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical instrument for precise bone cutting during orthopedic procedures. The instrument features a motorized blade and a laser guidance system for accurate cuts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related to prior art bone cutting tools\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising a motorized blade.\",\n        \"A method for cutting bone using a laser guidance system.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67137", "text": "{\n    \"patent_title\": \"AI-Powered Medical Image Analysis System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel AI-powered system for analyzing medical images, specifically X-rays and MRIs, to detect anomalies indicative of various diseases. The system employs a deep convolutional neural network with a unique attention mechanism, resulting in significantly improved diagnostic accuracy and efficiency compared to existing methods. Applications include early cancer detection, neurological disorder assessment, and monitoring of treatment efficacy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in medical image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A system for automated medical image analysis...\",\n        \"A method for detecting anomalies in medical images using deep learning...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67137", "text": "{\n    \"patent_title\": \"Enhanced Facial Recognition Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-01-20\",\n    \"filing_date\": \"2021-03-10\",\n    \"issue_date\": \"2023-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved facial recognition algorithm based on a novel feature extraction technique. The algorithm enhances accuracy and speed in identifying individuals from images or videos. It is intended for security applications and access control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"relevance\": \"Existing facial recognition technology\"\n        }\n    ],\n    \"claims\": [\n        \"A method for facial recognition...\",\n        \"A system for identifying individuals based on facial features...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67138", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"EP3854712A1\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-09-20\",\n    \"issue_date\": \"2021-08-04\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"A novel method and system for enhancing the resolution of digital images using deep convolutional neural networks. The system learns to predict high-resolution details from low-resolution input, resulting in improved image clarity and sharpness.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Image Super-Resolution using Convolutional Neural Networks\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising:...\",\n        \"A system for enhancing image resolution comprising:...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67138", "text": "{\n    \"patent_title\": \"Digital Image Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"IBM Research\"\n        }\n    ],\n    \"patent_number\": \"US10567890B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2018-05-10\",\n    \"issue_date\": \"2020-02-25\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A new digital image compression technique based on wavelet transform and quantization. This method reduces the file size of images while maintaining acceptable image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Wavelet-based Image Compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing digital images comprising:...\",\n        \"A system for compressing digital images comprising:...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67139", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction with Reduced Radiation Dose\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for reconstructing medical images from reduced radiation dose data, utilizing advanced iterative reconstruction algorithms and noise reduction techniques to improve image clarity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"A system comprising...\",\n        \"The method of claim 1, wherein the radiation dose is reduced by at least 30%...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67139", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Vascular Access\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MedTech Innovations Inc.\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"MedTech Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-01-10\",\n    \"filing_date\": \"2022-01-10\",\n    \"issue_date\": \"2023-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel catheter design that minimizes trauma during vascular access procedures. The catheter features a flexible tip and a lubricious coating to facilitate smooth insertion and reduce the risk of complications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible tip...\",\n        \"The catheter of claim 1, wherein the tip is made of a biocompatible material...\",\n        \"A method for accessing a blood vessel using the catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67140", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical Device with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-06-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel medical device for minimally invasive surgery, incorporating a high-resolution imaging system for enhanced visualization during procedures. The device aims to improve precision and reduce patient recovery times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A medical device comprising an imaging system and a surgical tool.\",\n        \"The device of claim 1, wherein the imaging system is a high-resolution endoscope.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67140", "text": "{\n    \"patent_title\": \"Automated Drug Delivery System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Michael Brown\",\n            \"affiliation\": \"Pharmaceutical Corp\"\n        },\n        {\n            \"name\": \"Sarah Wilson\",\n            \"affiliation\": \"Pharmaceutical Corp\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-22\",\n    \"filing_date\": \"2021-08-10\",\n    \"issue_date\": \"2024-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an automated system for delivering medication to patients. It features a programmable pump and a remote monitoring interface, improving adherence to treatment regimens.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"An automated drug delivery system comprising a pump and a monitoring interface.\",\n        \"The system of claim 1, wherein the pump is programmable.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67141", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel method for reconstructing high-resolution medical images from limited data, significantly reducing scan times and radiation exposure. It utilizes a deep learning approach to fill in missing data points, resulting in images with improved clarity and diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Prior Art Image Reconstruction Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for performing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67141", "text": "{\n    \"patent_title\": \"Slight Improvement to Existing CT Scan Protocol\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-19\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a minor adjustment to the parameters of a standard CT scan protocol, resulting in a slight reduction in image noise. It is a refinement of existing techniques and does not introduce fundamentally new concepts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Method and System for Enhanced Medical Image Reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A CT scan protocol comprising adjusting parameter X by 2%...\",\n        \"A system for performing the CT scan protocol of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67142", "text": "{\n    \"patent_title\": \"Enhanced MRI Coil Design for Reduced Scan Time and Patient Comfort\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2021-01-15\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"This invention relates to an improved MRI coil design that significantly reduces scan time and enhances patient comfort through minimized noise and improved coil conformability. The design also incorporates shielding materials to reduce radiofrequency interference and potentially lower the required radiation dose.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on MRI coil design\"\n        }\n    ],\n    \"claims\": [\n        \"A magnetic resonance imaging coil comprising...\",\n        \"A method for performing MRI using the coil...\",\n        \"The coil is configured to reduce scan time by at least 20%...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67142", "text": "{\n    \"patent_title\": \"Improved X-Ray Tube for Higher Resolution Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"EP3456789A1\",\n    \"priority_date\": \"2017-12-20\",\n    \"filing_date\": \"2017-12-20\",\n    \"issue_date\": \"2019-03-01\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"This invention describes an improved X-ray tube design capable of producing images with significantly higher resolution.  The new tube utilizes a novel filament material and focusing system.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on X-ray tube technology\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube comprising...\",\n        \"A method for generating X-rays using the tube...\",\n        \"The tube is capable of resolving features down to 1 micrometer...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67143", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for enhancing the resolution of digital images using a deep convolutional neural network. The system learns to upscale images while preserving high-frequency details, resulting in visually superior image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image super-resolution\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for enhancing the resolution of a digital image, comprising...\",\n        \"2. The method of claim 1, wherein the deep convolutional neural network...\",\n        \"3. A system for enhancing the resolution of a digital image...\",\n        \"4. The system of claim 3, further comprising...\",\n        \"5. The method of claim 1, wherein the image is a medical image.\",\n        \"6. The method of claim 1, wherein the upscaling factor is greater than 2.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67143", "text": "{\n    \"patent_title\": \"Image Compression Technique Using Wavelet Transform\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corp\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-08-20\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for compressing digital images using wavelet transform. The method efficiently removes redundancy in image data to achieve high compression ratios while maintaining acceptable image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related prior art in image compression\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for compressing a digital image, comprising...\",\n        \"2. The method of claim 1, wherein the wavelet transform is a Daubechies wavelet...\",\n        \"3. A system for compressing a digital image...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67144", "text": "{\n    \"patent_title\": \"Novel MRI Reconstruction Method Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method for reconstructing MRI images using deep learning techniques. The method significantly reduces scan time while maintaining image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"A system for performing MRI reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67144", "text": "{\n    \"patent_title\": \"Improved X-Ray Shielding Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-11-10\",\n    \"filing_date\": \"2019-11-10\",\n    \"issue_date\": \"2022-07-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new composite material for shielding against X-ray radiation, offering improved attenuation and reduced weight.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A shielding material comprising...\",\n        \"A method for manufacturing a shielding material...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67145", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2017-05-15\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for reconstructing medical images using a deep learning algorithm to reduce noise and enhance image clarity. The system utilizes convolutional neural networks trained on a large dataset of medical images to improve diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Prior Art Medical Image Reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising: obtaining raw image data; applying a deep learning algorithm to the raw image data; and generating a reconstructed image with enhanced clarity.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67145", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Minimally Invasive Surgery\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Boston Scientific\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2016-11-01\",\n    \"issue_date\": \"2020-07-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel catheter design with improved flexibility and maneuverability for use in minimally invasive surgical procedures. The catheter incorporates a multi-lumen configuration to facilitate the delivery of fluids and instruments.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Existing Catheter Technology\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising: a flexible shaft; a distal tip; and at least two lumens within the shaft for delivering fluids and instruments.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67146", "text": "{\n    \"patent_title\": \"Miniature Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-12-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature, fully implantable biosensor for continuous glucose monitoring. The device utilizes a novel enzymatic reaction and microfabrication techniques to achieve high sensitivity and long-term stability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on glucose monitoring systems.\"\n        }\n    ],\n    \"claims\": [\n        \"A biosensor comprising a microfabricated substrate...\",\n        \"A method for continuous glucose monitoring using the biosensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67146", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Peripheral Vascular Access\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"General Hospital Corporation\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"General Hospital Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-11-20\",\n    \"filing_date\": \"2019-11-20\",\n    \"issue_date\": \"2022-09-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design for safer and more efficient peripheral vascular access. The catheter incorporates a novel tip geometry to reduce the risk of vessel perforation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Previous catheter designs.\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a distal tip with a rounded geometry...\",\n        \"A method for inserting the catheter into a peripheral vessel...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67147", "text": "{\n    \"patent_title\": \"Deep Learning Framework for Robust Image Classification\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for image classification achieving state-of-the-art accuracy and robustness.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on convolutional neural networks.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image classification using a deep convolutional neural network.\",\n        \"A system comprising a deep convolutional neural network and a processing unit.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67147", "text": "{\n    \"patent_title\": \"Method for Enhancing Image Contrast\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US11123456B2\",\n    \"priority_date\": \"2019-01-10\",\n    \"filing_date\": \"2019-01-10\",\n    \"issue_date\": \"2020-07-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for improving the contrast of images using histogram equalization techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on image processing algorithms.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image contrast using histogram equalization.\",\n        \"An image processing system implementing said method.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67148", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical Instrument with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical instrument for minimally invasive procedures, incorporating a high-resolution camera and robotic articulation for increased precision.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising a camera and robotic arm.\",\n        \"The instrument of claim 1, wherein the camera is high-resolution.\",\n        \"The instrument of claim 1, wherein the robotic arm is remotely controlled.\",\n        \"A method of performing surgery using the instrument of claim 1.\",\n        \"The method of claim 4, wherein the surgery is minimally invasive.\",\n        \"The instrument of claim 1, comprising an energy source for tissue ablation.\",\n        \"The instrument of claim 6, wherein the energy source is laser-based.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67148", "text": "{\n    \"patent_title\": \"Diagnostic Apparatus for Cardiovascular Disease\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"EP3456789A1\",\n    \"priority_date\": \"2019-12-01\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2021-06-30\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"A non-invasive diagnostic device for detecting early signs of cardiovascular disease using advanced imaging techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related diagnostic technologies\"\n        }\n    ],\n    \"claims\": [\n        \"A diagnostic apparatus comprising an imaging module.\",\n        \"The apparatus of claim 1, wherein the imaging module uses ultrasound.\",\n        \"The apparatus of claim 1, further comprising a data processing unit.\",\n        \"A method of diagnosing cardiovascular disease using the apparatus of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67149", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Device for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable device for continuous glucose monitoring is disclosed. The device provides real-time glucose levels to patients, allowing for improved diabetes management and better patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable glucose monitoring device.\",\n        \"A method for continuous glucose monitoring using said device.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67149", "text": "{\n    \"patent_title\": \"Surgical Instrument Handle Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved ergonomic handle design for surgical instruments. The handle aims to reduce surgeon fatigue during long procedures.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A surgical instrument handle with improved ergonomics.\",\n        \"A method of manufacturing said handle.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67150", "text": "{\n    \"patent_title\": \"Miniature Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature implantable biosensor for continuous glucose monitoring. The device utilizes a novel nanomaterial for enhanced sensitivity and biocompatibility, developed through collaborative research at MIT and Harvard.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Implantable Glucose Sensor\"\n        }\n    ],\n    \"claims\": [\n        \"A miniature implantable biosensor...\",\n        \"The biosensor comprising a nanomaterial...\",\n        \"A method for continuous glucose monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67150", "text": "{\n    \"patent_title\": \"Surgical Stapler with Enhanced Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Johnson\",\n            \"affiliation\": \"MedTech Solutions Inc.\"\n        },\n        {\n            \"name\": \"Sarah Williams\",\n            \"affiliation\": \"MedTech Solutions Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-08-01\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2021-03-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler with enhanced ergonomic features for improved surgical precision and reduced surgeon fatigue. Designed for widespread clinical application.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Surgical Stapling Device\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an ergonomic handle...\",\n        \"A stapling mechanism providing consistent staple deployment...\",\n        \"A method of performing surgical anastomosis...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67151", "text": "{\n    \"patent_title\": \"Deep Learning Based Image Enhancement for Low-Light Conditions\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Research\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep learning architecture for enhancing images captured in low-light conditions. The system utilizes a novel loss function to preserve image details while increasing brightness.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image enhancement techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image...\",\n        \"A system comprising a deep neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67151", "text": "{\n    \"patent_title\": \"Image Compression using JPEG Standard\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-15\",\n    \"issue_date\": \"2021-01-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved implementation of the JPEG compression standard for digital images. Focuses on optimizing encoding speed.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Basic JPEG standard.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image using JPEG...\",\n        \"A system for encoding image data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67152", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor for Minimally Invasive Cardiovascular Measurements\",\n    \"inventors\": [\n        {\n            \"name\": \"David S. Watkins\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor is presented for minimally invasive cardiovascular measurements. The sensor incorporates a MEMS pressure transducer and a custom ASIC for signal conditioning and wireless communication, enabling highly accurate and real-time monitoring of blood pressure and flow. Improved diagnostic accuracy in cardiovascular disease is achieved through enhanced signal clarity and reduced invasiveness.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising...\",\n        \"A method for measuring blood pressure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67152", "text": "{\n    \"patent_title\": \"System and Method for Robotic Surgery\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A robotic surgery system with enhanced precision and dexterity. The system includes a master console, a patient-side cart with robotic arms, and a 3D visualization system. The invention enhances surgical procedures through improved control and accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgery system comprising...\",\n        \"A method for performing robotic surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67153", "text": "{\n    \"patent_title\": \"Enhanced MRI Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning algorithm for improving the resolution and reducing noise in MRI images. The algorithm significantly enhances diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A computer-readable medium storing instructions for...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67153", "text": "{\n    \"patent_title\": \"Improved X-ray Detector with Enhanced Sensitivity\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2017-12-20\",\n    \"filing_date\": \"2017-12-20\",\n    \"issue_date\": \"2021-09-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved X-ray detector design that enhances sensitivity and reduces radiation exposure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous X-ray detector designs\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray detector comprising...\",\n        \"A system for reducing radiation dose...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67154", "text": "{\n    \"patent_title\": \"Novel MRI Technique for Early-Stage Breast Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel magnetic resonance imaging (MRI) technique that significantly improves the detection of early-stage breast cancer. The technique utilizes a contrast agent and a specific pulse sequence to enhance the visibility of small tumors.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in MRI contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting breast cancer comprising...\",\n        \"An MRI apparatus configured to implement the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67154", "text": "{\n    \"patent_title\": \"Improved Algorithm for X-ray Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2017-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents an improved algorithm for reconstructing images from X-ray data, reducing noise and improving image quality. It's applicable to a wide range of medical imaging modalities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous image reconstruction techniques\"\n        }\n    ],\n    \"claims\": [\n        \"An algorithm for reconstructing an image...\",\n        \"A computer-readable medium storing the algorithm...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67155", "text": "{\n    \"patent_title\": \"Enhanced Contrast Medical Imaging Using Adaptive Filtering\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"10,456,789\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-06-15\",\n    \"issue_date\": \"2019-02-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for enhancing contrast in medical images using adaptive filtering techniques. The method improves diagnostic accuracy by reducing noise and highlighting subtle features in the images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"9,286,322\",\n            \"type\": \"Cited\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing contrast in a medical image comprising...\",\n        \"An apparatus for processing medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67155", "text": "{\n    \"patent_title\": \"System for Automated Dental X-ray Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"11,223,344\",\n    \"priority_date\": \"2017-08-20\",\n    \"filing_date\": \"2017-09-25\",\n    \"issue_date\": \"2021-01-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for automatically analyzing dental x-ray images to detect cavities and other dental anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"9,286,322\",\n            \"type\": \"Cited\"\n        }\n    ],\n    \"claims\": [\n        \"A system for analyzing dental x-ray images...\",\n        \"A method for detecting cavities in dental images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67156", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Detail using Adaptive Filtering\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the detail in digital images by adaptively applying filtering techniques based on local image characteristics. This improves visual clarity without introducing significant artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image detail comprising...\",\n        \"A system for adaptively filtering digital images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67156", "text": "{\n    \"patent_title\": \"Novel X-Ray Imaging System with Enhanced Sensitivity\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2018-11-01\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel X-ray imaging system utilizing a new detector material and geometry to significantly enhance sensitivity and resolution in medical imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A detector for enhanced X-ray sensitivity...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67157", "text": "{\n    \"patent_title\": \"Novel Image Enhancement Technique Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-01-20\",\n    \"issue_date\": \"2023-11-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image enhancement technique is presented that utilizes deep convolutional neural networks to improve image quality and detail. The method achieves state-of-the-art results in image denoising and super-resolution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Processing System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image comprising...\",\n        \"A system for processing images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67157", "text": "{\n    \"patent_title\": \"Improved Method for JPEG Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-12-01\",\n    \"filing_date\": \"2019-12-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved method for JPEG compression is described, resulting in slightly reduced file sizes. The method builds upon existing JPEG standards.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"JPEG Compression Standard\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image using JPEG...\",\n        \"A system for encoding images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67158", "text": "{\n    \"patent_title\": \"Miniature Implantable Wireless Sensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature implantable wireless sensor for continuous glucose monitoring. The device utilizes a biocompatible material and a low-power communication protocol to transmit glucose readings to an external receiver, enabling improved diabetes management and potentially reducing complications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Implantable Glucose Sensor\"\n        }\n    ],\n    \"claims\": [\n        \"A miniature implantable glucose sensor comprising...\",\n        \"A wireless communication module for transmitting glucose data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67158", "text": "{\n    \"patent_title\": \"Surgical Instrument for Orthopedic Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2018-07-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical instrument designed for precision orthopedic procedures. The instrument features an ergonomic handle and a specialized cutting tip for minimizing tissue damage during bone resection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Orthopedic Surgical Tool\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising an ergonomic handle...\",\n        \"A specialized cutting tip for bone resection...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67159", "text": "{\n    \"patent_title\": \"Vision Transformer for Object Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Ross Girshick\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Kevin He\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-01-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel object detection system based on the Vision Transformer architecture. This approach avoids the inductive biases inherent in convolutional neural networks, leading to improved performance on certain datasets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9891592B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for object detection comprising...\",\n        \"An apparatus for object detection...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67159", "text": "{\n    \"patent_title\": \"Improved Convolutional Neural Network for Image Classification\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10876321B1\",\n    \"priority_date\": \"2019-12-10\",\n    \"filing_date\": \"2019-12-10\",\n    \"issue_date\": \"2020-03-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved convolutional neural network architecture for image classification tasks. The network utilizes novel convolutional filters and pooling layers to achieve state-of-the-art accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9454035B1\"\n        }\n    ],\n    \"claims\": [\n        \"A convolutional neural network comprising...\",\n        \"A method for image classification using a convolutional neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67160", "text": "{\n    \"patent_title\": \"Implantable Cardiac Monitor with Wireless Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2018-03-01\",\n    \"issue_date\": \"2021-05-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac monitor for long-term monitoring of heart rhythm and function. The device wirelessly transmits data to a remote receiver, enabling early detection of arrhythmias and other cardiac events. Addresses the need for continuous, non-invasive cardiac monitoring for patients at high risk.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art relating to wireless data transmission.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for remotely monitoring cardiac function using an implantable device.\",\n        \"An implantable cardiac monitor comprising a sensor and a wireless transmitter.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67160", "text": "{\n    \"patent_title\": \"Surgical Instrument for Orthopedic Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"University Hospital\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2018-02-15\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical instrument designed for precise bone cutting during orthopedic procedures. The instrument features an ergonomic handle and a replaceable blade.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art relating to surgical instrument design.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising a handle and a cutting blade.\",\n        \"A replaceable blade for a surgical instrument.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67161", "text": "{\n    \"patent_title\": \"Automated Lung Nodule Detection Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for automated detection of lung nodules in CT scans using deep convolutional neural networks. The system improves diagnostic accuracy by reducing false positives and negatives compared to traditional methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Medical Image Analysis System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting lung nodules in a CT scan comprising...\",\n        \"A system for automated lung nodule detection...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67161", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression in Medical Image Storage\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2018-11-01\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This patent describes an improved algorithm for compressing medical image data, reducing storage requirements without significant loss of image quality. The algorithm utilizes wavelet transforms and entropy coding techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Medical Image Compression Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing medical image data comprising...\",\n        \"A system for efficient medical image storage...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67162", "text": "{\n    \"patent_title\": \"Method and System for Super-Resolution Image Reconstruction Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Li Wei\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Zhang Peng\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for improving the resolution of digital images using deep convolutional neural networks. The system utilizes a trained network to reconstruct high-resolution images from low-resolution inputs, enhancing image clarity and detail.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760861B2\",\n            \"title\": \"Image Enhancement System and Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for super-resolution image reconstruction...\",\n        \"A system comprising a deep convolutional neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67162", "text": "{\n    \"patent_title\": \"System and Method for Object Detection in Video Streams\",\n    \"inventors\": [\n        {\n            \"name\": \"Kim Min-soo\",\n            \"affiliation\": \"Samsung Electronics\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-11-20\",\n    \"filing_date\": \"2016-11-20\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for detecting objects within video streams in real-time. The system employs machine learning algorithms to identify and track objects of interest.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Video Analytics Platform\"\n        }\n    ],\n    \"claims\": [\n        \"A system for real-time object detection in video...\",\n        \"A method utilizing machine learning to track objects...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67163", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging Technique for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-10-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel magnetic resonance imaging (MRI) technique utilizing advanced pulse sequences and image reconstruction algorithms to enhance the detection of small cancerous tumors at early stages. The improved contrast and resolution allow for more accurate diagnoses and treatment planning.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"title\": \"Prior Art MRI System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI comprising...\",\n        \"An MRI apparatus comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67163", "text": "{\n    \"patent_title\": \"Digital Signal Processing for Audio Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"AudioTech Industries\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"AudioTech Industries\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-08-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method and system for enhancing audio signals using digital signal processing techniques. It improves the clarity and quality of audio recordings.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\",\n            \"title\": \"Early Audio Processing Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing audio signals comprising...\",\n        \"An audio processing system comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67164", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Super-Resolution with Generative Adversarial Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Jiaqi Wang\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Yilun Xu\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-05-15\",\n    \"filing_date\": \"2020-11-20\",\n    \"issue_date\": \"2022-01-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel image super-resolution technique utilizing deep learning and generative adversarial networks (GANs) to generate high-resolution images from low-resolution inputs with improved perceptual quality. The method incorporates a novel loss function that combines adversarial loss, perceptual loss, and pixel-wise loss.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Processing using Convolutional Neural Networks\"\n        }\n    ],\n    \"claims\": [\n        \"A method for super-resolving an image comprising:...\",\n        \"A system for performing image super-resolution…\"\n    ]\n}"}
{"_id": "Academic--patents--n--67164", "text": "{\n    \"patent_title\": \"Method for Improving Contrast in Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"University of California, Los Angeles\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-03-10\",\n    \"filing_date\": \"2019-09-25\",\n    \"issue_date\": \"2021-04-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the contrast of medical images, such as X-rays and CT scans, to improve diagnostic accuracy. The method utilizes histogram equalization and adaptive filtering techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Contrast Enhancement in Digital Images\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing the contrast of a medical image comprising:...\",\n        \"A system for performing contrast enhancement…\"\n    ]\n}"}
{"_id": "Academic--patents--p--67165", "text": "{\n    \"patent_title\": \"Method for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for reconstructing medical images from raw data, significantly improving image clarity and reducing noise, thus enhancing diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"The method of claim 1, wherein the reconstructed image exhibits improved clarity.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67165", "text": "{\n    \"patent_title\": \"System for Automated Patient Scheduling\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"General Hospital\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-11-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a system for automating patient appointment scheduling and reducing wait times in a hospital setting.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344AA\"\n        }\n    ],\n    \"claims\": [\n        \"A system for scheduling patient appointments...\",\n        \"The system of claim 1, wherein the scheduling is optimized to minimize wait times.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67166", "text": "{\n    \"patent_title\": \"Low-Power Wake-Up Receiver for Wireless Sensor Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A low-power wake-up receiver is presented for use in wireless sensor networks, enabling energy-efficient long-term operation of battery-powered devices. The receiver utilizes a novel low-threshold CMOS process to minimize power consumption while maintaining acceptable sensitivity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art on low-power design\"\n        }\n    ],\n    \"claims\": [\n        \"A wake-up receiver comprising:...\",\n        \"A method for activating a wireless sensor node...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67166", "text": "{\n    \"patent_title\": \"High-Speed Data Transmission over Fiber Optic Cables\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Wilson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-06-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for high-speed data transmission over fiber optic cables is disclosed. The system employs advanced modulation techniques and error correction codes to achieve data rates exceeding 100 Gbps.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on optical communication systems\"\n        }\n    ],\n    \"claims\": [\n        \"A fiber optic transmission system comprising:...\",\n        \"A method for modulating optical signals...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67167", "text": "{\n    \"patent_title\": \"Novel Microfluidic Device for Rapid Point-of-Care Diagnostic Testing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device is disclosed for rapid and accurate detection of biomarkers in biological samples, enabling point-of-care diagnostics. The device utilizes novel microchannel design and surface modification techniques to enhance sensitivity and specificity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for detecting biomarkers...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67167", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2019-12-01\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-08-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design is presented, featuring a novel tip geometry for enhanced drug delivery efficiency. The catheter minimizes tissue trauma and ensures precise drug placement.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising...\",\n        \"A method for drug delivery using the catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67168", "text": "{\n    \"patent_title\": \"Miniaturized Diagnostic Device for Rapid Pathogen Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A portable, low-cost device for rapid and accurate detection of pathogens in biological samples. Utilizes microfluidic technology and electrochemical sensors for enhanced sensitivity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in microfluidic devices\"\n        }\n    ],\n    \"claims\": [\n        \"A diagnostic device comprising a microfluidic channel...\",\n        \"A method for detecting a pathogen using the device...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67168", "text": "{\n    \"patent_title\": \"Surgical Instrument for Minimally Invasive Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Evans\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2018-11-01\",\n    \"issue_date\": \"2020-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical instrument designed to improve precision and minimize tissue damage during minimally invasive procedures. Features an articulated tip and advanced visualization capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related to surgical robotics\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising an articulated tip...\",\n        \"A method for performing minimally invasive surgery using the instrument...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67169", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for Magnetic Resonance Angiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-10\",\n    \"filing_date\": \"2015-03-15\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel contrast agent for magnetic resonance angiography (MRA) is disclosed, providing improved visualization of blood vessels with reduced toxicity. The agent exhibits enhanced relaxivity and targeted delivery to endothelial cells.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8545678B1\",\n            \"relevance\": \"Prior art contrast agent\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"A method for visualizing blood vessels...\",\n        \"A pharmaceutical composition comprising...\",\n        \"The contrast agent of claim 1, wherein...\",\n        \"The method of claim 2, wherein...\",\n        \"The pharmaceutical composition of claim 3, wherein...\",\n        \"The contrast agent is biocompatible.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67169", "text": "{\n    \"patent_title\": \"System for Remote Monitoring of Patient Vitals\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2017-05-01\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A remote patient monitoring system utilizing wearable sensors and a cloud-based platform for data analysis and alerting medical professionals to potential health issues.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Previous remote monitoring system\"\n        }\n    ],\n    \"claims\": [\n        \"A remote monitoring system comprising...\",\n        \"A wearable sensor configured to...\",\n        \"A cloud-based platform for...\",\n        \"A method for monitoring patient vitals...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67170", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging Technique for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel magnetic resonance imaging (MRI) technique employing advanced pulse sequences and image reconstruction algorithms to enhance the detection of early-stage cancerous tumors. The improved contrast and resolution significantly increase diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI comprising...\",\n        \"An MRI system configured to...\",\n        \"A computer-implemented method for...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67170", "text": "{\n    \"patent_title\": \"Automated System for X-Ray Image Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emily Davis\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-08-10\",\n    \"filing_date\": \"2017-08-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents an automated system for analyzing X-ray images to identify potential fractures. The system utilizes machine learning algorithms to assist radiologists in their diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for analyzing X-ray images comprising...\",\n        \"A computer program for...\",\n        \"A method for detecting fractures...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67171", "text": "{\n    \"patent_title\": \"Improved MRI Reconstruction for Enhanced Diagnostic Accuracy\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides methods and systems for improved magnetic resonance image (MRI) reconstruction, leading to higher resolution and enhanced diagnostic accuracy, particularly in detecting subtle anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67171", "text": "{\n    \"patent_title\": \"Automated Ultrasound Image Labeling System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2019-09-01\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an automated system for labeling ultrasound images, improving efficiency in medical imaging workflows.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"Related to image processing techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A system for automatically labeling ultrasound images...\",\n        \"A method for training a labeling model...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67172", "text": "{\n    \"patent_title\": \"Novel Image Enhancement Technique Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for enhancing the clarity of digital images using deep convolutional neural networks is presented. The method effectively reduces noise and artifacts, resulting in visually superior image quality. It's particularly effective in low-light conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Denoising Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image clarity comprising...\",\n        \"A system for reducing noise in digital images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67172", "text": "{\n    \"patent_title\": \"Adaptive Histogram Equalization for Image Contrast Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-05-10\",\n    \"filing_date\": \"2018-05-10\",\n    \"issue_date\": \"2022-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an adaptive histogram equalization technique to enhance image contrast. It aims to improve visibility in images with poor lighting conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Histogram Equalization Algorithm\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Contrast Limited Adaptive Histogram Equalization\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Image Enhancement Using Wavelet Transform\"\n        },\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Denoising Method\"\n        },\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"title\": \"Adaptive Filtering Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image contrast using adaptive histogram equalization...\",\n        \"A system for processing images to improve visibility...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67173", "text": "{\n    \"patent_title\": \"Improved Method and System for Anomaly Detection in Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, San Francisco\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method for enhancing the clarity of medical images and improving the detection of subtle anomalies, utilizing a combination of advanced filtering techniques and machine learning algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8567890B1\",\n            \"title\": \"Medical Image Processing System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing medical image clarity comprising...\",\n        \"A system for detecting anomalies in medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67173", "text": "{\n    \"patent_title\": \"Digital Radiography System with Reduced Dose\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A digital radiography system designed to minimize radiation exposure to patients while maintaining diagnostic image quality. The system incorporates advanced sensor technology and image processing algorithms to achieve a low-dose imaging solution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Radiation Shielding for X-ray Systems\"\n        }\n    ],\n    \"claims\": [\n        \"A digital radiography system comprising a radiation source...\",\n        \"A method for reducing patient radiation dose during radiography...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67174", "text": "{\n    \"patent_title\": \"Wearable Sensor System for Continuous Glucose Monitoring and Predictive Analytics\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Health\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wearable sensor system continuously monitors glucose levels and utilizes machine learning algorithms to predict future glucose trends, enabling proactive diabetes management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art related to continuous glucose monitoring\"\n        }\n    ],\n    \"claims\": [\n        \"A wearable glucose sensor comprising...\",\n        \"A method for predicting glucose levels...\",\n        \"A system for alerting patients to potential hypoglycemic events...\",\n        \"A data processing module for analyzing sensor data...\",\n        \"A communication interface for transmitting data to a mobile device...\",\n        \"A machine learning algorithm for improving prediction accuracy...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67174", "text": "{\n    \"patent_title\": \"Wearable Device for Fitness Tracking and Activity Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Fitbit Inc.\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Apple Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-08-01\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2021-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wearable device for tracking physical activity, including steps taken, distance traveled, and calories burned. The device also utilizes activity recognition algorithms to identify different types of exercises.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art related to activity trackers\"\n        }\n    ],\n    \"claims\": [\n        \"A wearable fitness tracker comprising...\",\n        \"A method for calculating steps taken...\",\n        \"A system for displaying activity data...\",\n        \"A sensor for measuring heart rate...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67175", "text": "{\n    \"patent_title\": \"Method and System for Enhancing Image Contrast in Low-Light Conditions\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-07-15\",\n    \"filing_date\": \"2020-03-01\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the contrast of images captured in low-light conditions, improving visibility and detail without introducing significant artifacts. The system utilizes a novel algorithm for adaptive histogram equalization.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Enhancement Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image contrast...\",\n        \"A system comprising a processor configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67175", "text": "{\n    \"patent_title\": \"Generative Adversarial Network for Realistic Image Synthesis\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2018-11-20\",\n    \"filing_date\": \"2020-05-15\",\n    \"issue_date\": \"2023-05-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel generative adversarial network (GAN) architecture for synthesizing realistic images from random noise vectors. The system is capable of creating high-resolution images with complex details.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"title\": \"Image Generation using Deep Learning\"\n        }\n    ],\n    \"claims\": [\n        \"A generative adversarial network comprising...\",\n        \"A method for generating an image...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67176", "text": "{\n    \"patent_title\": \"Remote Physiological Monitoring System and Method\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-06-15\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for remotely monitoring a patient's vital signs, transmitting data to a central server, and alerting medical personnel to potential health issues. This addresses the need for continuous monitoring outside of a hospital setting.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for remote patient monitoring...\",\n        \"A method for transmitting physiological data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67176", "text": "{\n    \"patent_title\": \"Surgical Instrument with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-04-20\",\n    \"issue_date\": \"2022-07-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical instrument design providing greater precision and control during complex procedures. The instrument incorporates novel haptic feedback mechanisms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising...\",\n        \"A haptic feedback system for surgical instruments...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67177", "text": "{\n    \"patent_title\": \"Implantable Cardiovascular Monitoring System with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable device for continuous monitoring of cardiovascular parameters with wireless data transmission to a remote monitoring station. The device utilizes novel sensor technology for accurate measurement of blood pressure, heart rate, and oxygen saturation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art related to implantable sensors\"\n        }\n    ],\n    \"claims\": [\n        \"A method for continuously monitoring cardiovascular parameters...\",\n        \"An implantable device comprising a sensor...\",\n        \"A system for wireless data transmission...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67177", "text": "{\n    \"patent_title\": \"Surgical Instrument for Bone Cutting\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-12-01\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-09-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical instrument designed for precise and efficient bone cutting during orthopedic procedures. The instrument features a unique blade geometry and ergonomic handle.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art related to surgical instruments\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising a blade...\",\n        \"A method for cutting bone using the instrument...\",\n        \"A handle configured for ergonomic grip...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67178", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction for Enhanced Diagnostic MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for reconstructing medical images from MRI data, reducing noise and artifacts to improve diagnostic accuracy. The technique utilizes a novel iterative algorithm with a simplified regularization term.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"MRI Image Reconstruction Using Wavelet Transforms\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"The method of claim 1, wherein the regularization term is a total variation term.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67178", "text": "{\n    \"patent_title\": \"Advanced Multi-Modal Medical Imaging System with AI-Powered Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-01-20\",\n    \"issue_date\": \"2022-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A complex medical imaging system integrating PET, CT, and MRI modalities with a deep learning-based diagnostic analysis pipeline. The system offers highly detailed and automated analysis, but requires significant computational resources.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Deep Learning for Medical Image Segmentation\"\n        }\n    ],\n    \"claims\": [\n        \"A multi-modal medical imaging system comprising...\",\n        \"A deep neural network for analyzing medical images...\",\n        \"The system of claim 2, wherein the deep neural network has at least 100 layers.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67179", "text": "{\n    \"patent_title\": \"Ergonomic Insulin Pen with Enhanced Grip and Dose Adjustment\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"BioTech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University Medical Center\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An ergonomic insulin pen designed to improve grip comfort and dose accuracy for patients with limited dexterity. The pen features a textured grip and a larger, more easily adjustable dose dial.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art related to insulin pen design.\"\n        }\n    ],\n    \"claims\": [\n        \"A handheld insulin pen comprising an ergonomic grip.\",\n        \"The insulin pen of claim 1, wherein the grip is textured.\",\n        \"The insulin pen of claim 1, further comprising a dose adjustment dial.\",\n        \"The dose adjustment dial of claim 3, wherein the dial is larger than conventional dose dials.\",\n        \"A method for administering insulin using the insulin pen of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67179", "text": "{\n    \"patent_title\": \"Automated Surgical Robot with High Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Robotics Corp\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-03-01\",\n    \"filing_date\": \"2019-11-20\",\n    \"issue_date\": \"2021-08-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated surgical robot capable of performing complex surgical procedures with high precision and minimal invasiveness.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art in robotic surgery.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robot comprising a robotic arm.\",\n        \"The surgical robot of claim 1, wherein the robotic arm is capable of performing precise movements.\",\n        \"The surgical robot of claim 1, further comprising a control system.\",\n        \"The control system of claim 3, wherein the control system is computer-assisted.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67180", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10582176B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable biosensor for continuous glucose monitoring, utilizing a novel nanomaterial-based sensing element. The device provides real-time glucose data with improved accuracy and reduced biofouling compared to existing glucose monitors.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8500543B2\",\n            \"title\": \"Implantable glucose sensor\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable biosensor comprising...\",\n        \"A method for continuous glucose monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67180", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US9783521B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2018-11-13\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler with enhanced ergonomics and a redesigned cartridge for more reliable staple deployment. The device offers improvements in surgical efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7895412B2\",\n            \"title\": \"Surgical Stapler\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"A staple cartridge for use with a surgical stapler...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67181", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Electrolyte for Improved Cycle Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Princeton University\"\n        },\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Princeton University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-01\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery with a novel electrolyte composition exhibiting enhanced cycle life and improved safety characteristics. The electrolyte is designed to mitigate dendrite formation and enhance ion conductivity, making it suitable for use in electric vehicle applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art related to electrolyte additives\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition...\",\n        \"A method for fabricating...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67181", "text": "{\n    \"patent_title\": \"Improved Solar Cell Design for Residential Use\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"SunPower Corporation\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"SunPower Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2020-02-20\",\n    \"filing_date\": \"2020-05-15\",\n    \"issue_date\": \"2023-01-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel solar cell design incorporating a multi-layer perovskite structure for enhanced energy conversion efficiency in residential applications. The design optimizes light absorption and minimizes energy loss.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous work on perovskite materials\"\n        }\n    ],\n    \"claims\": [\n        \"A solar cell comprising...\",\n        \"A perovskite layer...\",\n        \"A method for manufacturing...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67182", "text": "{\n    \"patent_title\": \"Micro-Robotic System for Minimally Invasive Cardiac Surgery\",\n    \"inventors\": [\n        {\n            \"name\": \"David Gracias\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A micro-robotic system designed for precise and minimally invasive cardiac surgery. The system utilizes a novel magnetic control method for enhanced maneuverability within the body.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in micro-robotics\"\n        }\n    ],\n    \"claims\": [\n        \"A micro-robotic system comprising a plurality of micro-robots...\",\n        \"A method for performing minimally invasive surgery using the micro-robotic system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67182", "text": "{\n    \"patent_title\": \"Novel Stent Design for Arterial Blockages\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-05-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new stent design utilizing a bioabsorbable polymer for improved arterial blockage treatment. The stent provides temporary support and then dissolves over time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art in stent design\"\n        }\n    ],\n    \"claims\": [\n        \"A stent comprising a bioabsorbable polymer...\",\n        \"A method for treating arterial blockages using the stent...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67183", "text": "{\n    \"patent_title\": \"Method and System for Dynamic Voltage and Frequency Scaling in Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Qualcomm\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-08-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for dynamically adjusting the voltage and frequency of a processor in a mobile device to optimize power consumption. The system analyzes application workload and adjusts processor parameters accordingly.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11111111B1\"\n        },\n        {\n            \"patent_number\": \"US22222222B2\"\n        },\n        {\n            \"patent_number\": \"US33333333B1\"\n        },\n        {\n            \"patent_number\": \"US44444444B2\"\n        },\n        {\n            \"patent_number\": \"US55555555B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for dynamically adjusting voltage and frequency...\",\n        \"A system comprising a processor and a voltage regulator...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67183", "text": "{\n    \"patent_title\": \"Novel Battery Casing Design for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Apple Inc.\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2018-07-20\",\n    \"filing_date\": \"2019-11-05\",\n    \"issue_date\": \"2021-05-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new design for a battery casing that improves impact resistance and thermal dissipation in mobile devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US66666666B2\"\n        },\n        {\n            \"patent_number\": \"US77777777B1\"\n        }\n    ],\n    \"claims\": [\n        \"A battery casing comprising a polycarbonate shell...\",\n        \"A mobile device incorporating the battery casing...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67184", "text": "{\n    \"patent_title\": \"Novel Image Enhancement Technique Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel image enhancement technique utilizing deep convolutional neural networks to significantly improve image quality and detail, surpassing existing methods in terms of perceptual quality and computational efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Processing Using Fourier Transforms\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image comprising:...\",\n        \"A system for enhancing an image comprising:...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67184", "text": "{\n    \"patent_title\": \"Improved Method for JPEG Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9123456B2\",\n    \"priority_date\": \"2016-05-20\",\n    \"filing_date\": \"2016-05-20\",\n    \"issue_date\": \"2018-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a minor improvement to the standard JPEG compression algorithm, resulting in a slightly reduced file size without noticeable loss of image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"JPEG Image Compression Standard\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image using JPEG...\",\n        \"A system for compressing an image using JPEG...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67185", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2021-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a minimally invasive surgical system comprising a console, a surgical instrument, and an endoscopic camera. The system is designed with enhanced ergonomics to improve surgeon comfort and workflow, ultimately enhancing patient experience.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising...\",\n        \"A method for performing minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67185", "text": "{\n    \"patent_title\": \"High-Throughput Drug Screening Assay\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Pfizer\"\n        }\n    ],\n    \"patent_number\": \"US11345678B2\",\n    \"priority_date\": \"2018-11-20\",\n    \"filing_date\": \"2018-11-20\",\n    \"issue_date\": \"2021-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel high-throughput assay for identifying drug candidates targeting specific cellular pathways. The assay utilizes microfluidic technology and fluorescent labeling for rapid and accurate analysis of drug efficacy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Previous work on microfluidic devices\"\n        }\n    ],\n    \"claims\": [\n        \"A method for screening drug candidates...\",\n        \"A microfluidic device comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67186", "text": "{\n    \"patent_title\": \"Adaptive Power Allocation for Enhanced Mobile Device Battery Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Apple Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2021-02-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for dynamically allocating power to different components of a mobile device to optimize battery life. The system uses machine learning to predict user behavior and adjust power consumption accordingly.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Power Saving Techniques for Mobile Devices\"\n        }\n    ],\n    \"claims\": [\n        \"A method for dynamically allocating power to a mobile device...\",\n        \"A system for predicting user behavior and adjusting power consumption...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67186", "text": "{\n    \"patent_title\": \"Low-Power Display Technology for Mobile Phones\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Samsung Electronics\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2018-11-01\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new display technology for mobile phones that reduces power consumption by using a novel backlighting system.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Efficient Backlighting Systems\"\n        }\n    ],\n    \"claims\": [\n        \"A display comprising a novel backlighting system...\",\n        \"A mobile phone incorporating said display...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67187", "text": "{\n    \"patent_title\": \"High-Efficiency Modulation Techniques for 5G Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Qualcomm Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-03-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel modulation schemes and coding techniques to enhance data rates and spectral efficiency in 5G wireless communication systems. The method utilizes a combination of orthogonal frequency-division multiplexing (OFDM) and advanced channel coding to achieve superior performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9124567B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for transmitting data in a wireless communication system comprising...\",\n        \"An apparatus for implementing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67187", "text": "{\n    \"patent_title\": \"Improved Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Motors\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2021-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel battery management system (BMS) for electric vehicles, optimizing battery life and performance. The BMS includes advanced algorithms for cell balancing, temperature control, and state-of-charge estimation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for an electric vehicle comprising...\",\n        \"A method for controlling the charge and discharge of a battery pack...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67188", "text": "{\n    \"patent_title\": \"High-Resolution Medical Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-12-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning approach for reconstructing high-resolution medical images from low-dose scans, significantly improving image clarity and reducing patient radiation exposure.  The system utilizes a convolutional neural network trained on a large dataset of CT and MRI images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"A system comprising a deep learning model...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67188", "text": "{\n    \"patent_title\": \"Automated Diagnosis of Pneumonia Using Chest X-Rays\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-05-10\",\n    \"filing_date\": \"2018-05-10\",\n    \"issue_date\": \"2020-07-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A computer-aided diagnosis system for detecting pneumonia from chest X-ray images. The system employs machine learning algorithms to analyze image features and provide diagnostic suggestions to clinicians.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A computer-implemented method for diagnosing pneumonia...\",\n        \"A system for assisting in the diagnosis of respiratory illnesses...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67189", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Enhancement for Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Research\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-08-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for enhancing the quality of medical images, improving diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"count\": 50\n        },\n        {\n            \"patent_number\": \"US11223344AA\",\n            \"count\": 35\n        },\n        {\n            \"patent_number\": \"EP3789012A1\",\n            \"count\": 20\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing medical images using a convolutional neural network.\",\n        \"A system for processing medical images with improved resolution.\",\n        \"A deep learning model trained on a large dataset of medical images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67189", "text": "{\n    \"patent_title\": \"Method for Basic Image Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corp\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-20\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A simple method for compressing image data using a basic lossless algorithm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"count\": 2\n        },\n        {\n            \"patent_number\": \"US65432109AA\",\n            \"count\": 1\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing image data.\",\n        \"A system for reducing the size of image files.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67190", "text": "{\n    \"patent_title\": \"Advanced Modulation Techniques for 5G Wireless Communications\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Qualcomm Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents novel modulation schemes for 5G wireless communication systems, improving spectral efficiency and data rates. It utilizes advanced coding and signal processing techniques to overcome channel impairments.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Previous Generation Wireless Communication System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for transmitting data in a wireless communication system...\",\n        \"A wireless communication device comprising...\",\n        \"A modulation scheme characterized by...\",\n        \"A coding algorithm for improving signal quality...\",\n        \"A system for minimizing interference...\",\n        \"A receiver adapted for decoding modulated signals...\",\n        \"The method of claim 1, wherein...\",\n        \"The device of claim 2, further comprising...\",\n        \"The scheme of claim 3, optimized for...\",\n        \"The algorithm of claim 4, employing...\",\n        \"The system of claim 5, configured to...\",\n        \"The receiver of claim 6, utilizing...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67190", "text": "{\n    \"patent_title\": \"Improved Antenna Design for Bluetooth Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Texas Instruments\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2013-11-20\",\n    \"filing_date\": \"2013-11-20\",\n    \"issue_date\": \"2017-02-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a compact antenna design for Bluetooth devices, enhancing signal strength and reducing interference in short-range wireless communication.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Basic Bluetooth Antenna Configuration\"\n        }\n    ],\n    \"claims\": [\n        \"An antenna for a Bluetooth device...\",\n        \"The antenna of claim 1, comprising...\",\n        \"A method for manufacturing the antenna...\",\n        \"The antenna of claim 2, optimized for...\",\n        \"A Bluetooth device incorporating the antenna...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67191", "text": "{\n    \"patent_title\": \"Method and system for enhancing image resolution using deep learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2019-03-01\",\n    \"issue_date\": \"2021-01-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the resolution of images using deep convolutional neural networks. The system learns to map low-resolution images to high-resolution images, improving visual quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760723B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising: training a deep convolutional neural network...\",\n        \"A system for enhancing image resolution comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67191", "text": "{\n    \"patent_title\": \"System for managing digital photographs\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US7654321B1\",\n    \"priority_date\": \"2008-12-10\",\n    \"filing_date\": \"2009-06-15\",\n    \"issue_date\": \"2012-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for organizing and managing digital photographs, allowing users to easily store, retrieve, and share their images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for managing digital photographs comprising: a storage device...\",\n        \"A method for organizing digital photographs comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67192", "text": "{\n    \"patent_title\": \"Novel Magnetic Resonance Imaging Technique for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2020-12-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a revolutionary MRI technique utilizing novel pulse sequences and image reconstruction algorithms, achieving significantly improved sensitivity and specificity in the detection of early-stage cancers compared to existing methods. Results demonstrate a 30% increase in detection rate for small tumors.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art MRI pulse sequence\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI...\",\n        \"An MRI apparatus...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67192", "text": "{\n    \"patent_title\": \"Improved X-Ray Image Enhancement System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"Dr. Emily Foster\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-05-20\",\n    \"filing_date\": \"2019-05-20\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an improved system for enhancing the contrast and clarity of X-ray images. The system utilizes a novel filtering algorithm to reduce noise and improve image quality. It provides better visualization of anatomical structures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Existing X-ray image processing techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A system for enhancing X-ray images...\",\n        \"A method for filtering X-ray image data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67193", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Pressure Sensor for Intracranial Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized, wireless pressure sensor is disclosed for continuous intracranial pressure (ICP) monitoring. This device allows for early detection of increased ICP, potentially improving patient outcomes in traumatic brain injury.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor for intracranial monitoring.\",\n        \"A system for continuous ICP measurement.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67193", "text": "{\n    \"patent_title\": \"Surgical Instrument Tracking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2021-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for tracking surgical instruments during a procedure using radio-frequency identification (RFID) tags. The system improves inventory management and reduces instrument loss.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument tracking system using RFID.\",\n        \"A method for instrument inventory management.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67194", "text": "{\n    \"patent_title\": \"High-Resolution Magnetic Resonance Imaging with Accelerated Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel magnetic resonance imaging (MRI) technique utilizing compressed sensing and deep learning algorithms for significantly accelerated image reconstruction. The method allows for high-resolution images to be acquired in a fraction of the time compared to conventional MRI, enabling real-time imaging and reducing patient discomfort.  Detailed analysis of the signal processing chain, coil sensitivity profiles, and iterative reconstruction parameters are presented, along with comprehensive in-vivo validation on healthy volunteers and patients with cardiovascular disease. The advantages of the proposed technique include improved image quality, reduced scan time, and enhanced diagnostic accuracy.  The system architecture includes a dedicated GPU cluster for rapid processing and a user-friendly interface for parameter optimization. Further improvements utilize adaptive sampling strategies, minimizing artifacts and maximizing image fidelity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"title\": \"Compressed Sensing MRI\"\n        }\n    ],\n    \"claims\": [\n        \"A method for accelerating MRI image reconstruction comprising...\",\n        \"A system for performing MRI with reduced scan time...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67194", "text": "{\n    \"patent_title\": \"Portable X-Ray Device for Veterinary Use\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Animal Health Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-09-01\",\n    \"filing_date\": \"2017-09-01\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A portable X-ray device designed for veterinary applications. The device is lightweight and battery-powered, allowing for convenient use in field settings. It utilizes a low-dose X-ray emitter and a digital detector for real-time image acquisition. The device is intended for the diagnosis of fractures and other conditions in animals.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A portable X-ray device comprising...\",\n        \"A method for diagnosing animal injuries using the device...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67195", "text": "{\n    \"patent_title\": \"Miniature Implantable Sensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-10-26\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2021-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature implantable sensor for continuous glucose monitoring providing real-time data transmission for improved diabetes management and patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A miniature implantable sensor for glucose monitoring.\",\n        \"A system for transmitting glucose data wirelessly.\",\n        \"A method for improving diabetes management.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67195", "text": "{\n    \"patent_title\": \"Surgical Stapler with Enhanced Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2017-08-10\",\n    \"filing_date\": \"2018-12-05\",\n    \"issue_date\": \"2020-12-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler with enhanced ergonomics for more comfortable and precise surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler with improved handle design.\",\n        \"A stapling mechanism with increased precision.\",\n        \"A method for performing surgical stapling.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67196", "text": "{\n    \"patent_title\": \"Enhanced Medical Imaging with Novel Contrast Agents\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel contrast agents and imaging techniques for improved visualization of internal organs and tissues, enabling more accurate disease diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"A method for enhancing medical images...\",\n        \"An imaging system utilizing the contrast agent...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67196", "text": "{\n    \"patent_title\": \"Advanced Signal Processing for MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-01-25\",\n    \"filing_date\": \"2019-03-10\",\n    \"issue_date\": \"2021-07-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to improved signal processing algorithms for Magnetic Resonance Imaging, resulting in faster scan times and reduced noise levels. It focuses on enhancing image clarity without changing the contrast.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"relevance\": \"Related to MRI reconstruction techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing MRI signals...\",\n        \"A system for performing MRI reconstruction...\",\n        \"A software application for image enhancement...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67197", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2017-06-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the resolution of digital images using a deep convolutional neural network. The network is trained to map low-resolution images to high-resolution images, resulting in improved image quality and detail.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising...\",\n        \"A system for processing digital images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67197", "text": "{\n    \"patent_title\": \"Mobile Application for Real-Time Image Sharing\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-08-10\",\n    \"filing_date\": \"2016-09-10\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A mobile application enabling users to capture, edit, and share images in real-time with their social network. Features include filters, captions, and location tagging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A mobile application comprising...\",\n        \"A method for sharing digital images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67198", "text": "{\n    \"patent_title\": \"Method and System for Enhanced MRI Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing high-resolution MRI images using compressed sensing techniques. The method reduces scan time and improves image quality, enabling earlier and more accurate diagnosis of various medical conditions. This contributes to less invasive diagnostic procedures by minimizing patient discomfort and exposure to radiation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"relevance\": \"Prior art in MRI image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"A system for performing MRI reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67198", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Vascular Access\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel catheter design featuring a flexible tip and improved biocompatibility. The catheter is intended for use in vascular access procedures, minimizing trauma to blood vessels.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art in catheter design\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible distal tip...\",\n        \"A method for accessing a blood vessel using the catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67199", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction for Enhanced Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Chen\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image reconstruction algorithm for medical imaging, specifically targeting improved detection of cancerous lesions. The method uses a deep learning approach to reduce noise and enhance image clarity, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8652001B2\",\n            \"title\": \"Prior Art Image Processing Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for enhancing the clarity of medical images...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67199", "text": "{\n    \"patent_title\": \"Method for Packaging Medical Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Miller\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9123456B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2018-09-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new packaging method for sterile medical devices, designed to reduce contamination and extend shelf life. The packaging utilizes a multi-layer film and a vacuum sealing process.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7456789B2\",\n            \"title\": \"Prior Art Packaging Method\"\n        }\n    ],\n    \"claims\": [\n        \"A packaging system for medical devices comprising...\",\n        \"A multi-layer film for sterile packaging...\",\n        \"A method of vacuum sealing medical devices...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67200", "text": "{\n    \"patent_title\": \"Artificial Intelligence-Based System for Early Detection of Lung Cancer in CT Scans\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel artificial intelligence system utilizing deep learning algorithms for the automated detection of early-stage lung cancer in computed tomography (CT) scans. The system significantly improves diagnostic accuracy and reduces false positive rates compared to traditional methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting lung nodules in CT scans using a convolutional neural network.\",\n        \"A system comprising a CT scanner and a computer implementing the method of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67200", "text": "{\n    \"patent_title\": \"AI-Powered Personalized Radiation Therapy Planning System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An artificial intelligence system designed to optimize radiation therapy plans for cancer patients, considering individual anatomical variations and tumor characteristics. The system aims to deliver the most effective radiation dose while minimizing damage to healthy tissues.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for generating personalized radiation therapy plans using reinforcement learning.\",\n        \"A method for optimizing radiation dose distribution based on patient-specific imaging data.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67201", "text": "{\n    \"patent_title\": \"Method and System for Real-Time Image Enhancement Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2017-05-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for real-time image enhancement using a deep convolutional neural network. The system learns to enhance images based on a large dataset of labeled examples, resulting in improved visual quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760521B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image comprising...\",\n        \"A system for enhancing an image comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67201", "text": "{\n    \"patent_title\": \"Image Compression Technique Using Discrete Cosine Transform\",\n    \"inventors\": [\n        {\n            \"name\": \"Thomas Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US7654321B2\",\n    \"priority_date\": \"2006-02-28\",\n    \"filing_date\": \"2006-02-28\",\n    \"issue_date\": \"2009-08-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An image compression technique based on the discrete cosine transform (DCT). The method divides the image into blocks and applies the DCT to each block, resulting in a compressed representation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6548792B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image comprising...\",\n        \"An apparatus for compressing an image comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67202", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"David A. Jones\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system incorporating enhanced 3D visualization and robotic assistance to improve surgical precision and patient recovery times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising a robotic arm...\",\n        \"A visualization module providing 3D imaging...\",\n        \"A method for performing minimally invasive surgery...\",\n        \"A control system for the robotic arm...\",\n        \"A feedback mechanism to enhance surgical precision...\",\n        \"A user interface for controlling the surgical system...\",\n        \"A data storage module for recording surgical procedures...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67202", "text": "{\n    \"patent_title\": \"Improved Battery Charging Circuit\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-05-10\",\n    \"filing_date\": \"2022-05-10\",\n    \"issue_date\": \"2024-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel circuit design for improving the efficiency of battery charging in portable electronic devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art in battery charging technology\"\n        }\n    ],\n    \"claims\": [\n        \"A battery charging circuit comprising...\",\n        \"A voltage regulator...\",\n        \"A current limiter...\",\n        \"A temperature sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67203", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Sepsis Diagnosis\",\n    \"inventors\": [\n        {\n            \"name\": \"David Baker\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Chen\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2022-12-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device is disclosed for rapid and accurate diagnosis of sepsis. The device utilizes a novel biomarker panel and allows for point-of-care testing, significantly improving patient outcomes by enabling faster treatment initiation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art in microfluidic diagnostics\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for diagnosing sepsis using said device...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67203", "text": "{\n    \"patent_title\": \"Surgical Instrument with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"Boston University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2021-08-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical instrument with an improved ergonomic design to reduce physician fatigue. The instrument features a novel handle and grip mechanism, enhancing precision and control during surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art in surgical instrument design\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising...\",\n        \"A handle assembly for said instrument...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67204", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-04-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for enhancing the analysis of medical images, specifically targeting improved diagnostic accuracy in detecting subtle anomalies. It employs a streamlined algorithm for feature extraction and classification.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image segmentation\"\n        }\n    ],\n    \"claims\": [\n        \"A method for analyzing a medical image comprising...\",\n        \"A system for enhancing the diagnostic accuracy of medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67204", "text": "{\n    \"patent_title\": \"Complex Multi-Modal Medical Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US11123456B2\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-19\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a highly sophisticated medical imaging system integrating multiple modalities, including MRI, CT, and PET. It features advanced reconstruction algorithms and a complex user interface for detailed image manipulation and analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related to multi-modal imaging techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A multi-modal medical imaging system comprising...\",\n        \"A method for reconstructing images from multiple modalities...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67205", "text": "{\n    \"patent_title\": \"Novel MRI Contrast Agent for Enhanced Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2018-03-01\",\n    \"issue_date\": \"2021-11-23\",\n    \"patent_office\": \"US Patent and Trademark Office\",\n    \"abstract\": \"A novel MRI contrast agent utilizing nanoparticle technology to significantly enhance tumor detection sensitivity and specificity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on nanoparticle synthesis\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing tumor detection using a nanoparticle-based MRI contrast agent.\",\n        \"A nanoparticle composition comprising...\",\n        \"An MRI apparatus configured to utilize the contrast agent...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67205", "text": "{\n    \"patent_title\": \"Improved X-Ray Shielding for Dental Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Los Angeles\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-11-10\",\n    \"filing_date\": \"2018-07-12\",\n    \"issue_date\": \"2020-04-07\",\n    \"patent_office\": \"US Patent and Trademark Office\",\n    \"abstract\": \"An improved design for X-ray shielding used in dental imaging, resulting in reduced radiation exposure to patients and operators.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art on X-ray shielding materials\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray shielding apparatus comprising a lead-based material...\",\n        \"A dental imaging system incorporating the shielding apparatus...\",\n        \"A method for reducing radiation exposure during dental X-rays...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67206", "text": "{\n    \"patent_title\": \"Enhanced Medical Image Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2020-06-20\",\n    \"issue_date\": \"2022-12-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for reconstructing medical images from limited data, resulting in improved image quality and diagnostic accuracy. The system employs a generative adversarial network (GAN) to enhance image resolution and reduce noise.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for enhancing the resolution of a medical image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67206", "text": "{\n    \"patent_title\": \"Improved Turbine Blade Design for Wind Energy\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Siemens Energy\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2022-01-10\",\n    \"filing_date\": \"2021-05-01\",\n    \"issue_date\": \"2023-09-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new turbine blade design utilizing advanced aerodynamic principles to maximize energy capture from wind sources. The blade features a unique airfoil shape and optimized surface texture.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"related technology\"\n        }\n    ],\n    \"claims\": [\n        \"A turbine blade having a specific airfoil shape...\",\n        \"A wind turbine system comprising the aforementioned blade...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67207", "text": "{\n    \"patent_title\": \"Magnetic Resonance Imaging with Enhanced Contrast for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel magnetic resonance imaging technique using targeted contrast agents for the early detection of cancerous tumors. The method enhances image resolution and specificity, allowing for earlier diagnosis and improved patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8652001B2\",\n            \"title\": \"Contrast Agents for MRI\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancer using MRI...\",\n        \"A contrast agent composition for use in MRI...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67207", "text": "{\n    \"patent_title\": \"Improved Ultrasound Transducer Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2019-05-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved design for ultrasound transducers that increases image clarity and reduces noise. The design incorporates a new piezoelectric material for enhanced performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7543987B2\",\n            \"title\": \"Ultrasound Imaging Systems\"\n        }\n    ],\n    \"claims\": [\n        \"An ultrasound transducer comprising a piezoelectric material...\",\n        \"A method for manufacturing an ultrasound transducer...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67208", "text": "{\n    \"patent_title\": \"Deep Learning Architecture for Enhanced Medical Image Segmentation\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel deep learning architecture utilizing attention mechanisms and residual connections for significantly improved accuracy in medical image segmentation.  The approach demonstrates a breakthrough in identifying subtle anomalies in MRI scans, surpassing existing state-of-the-art methods by a considerable margin.  It offers enhanced robustness to noise and variations in image quality, creating a more reliable diagnostic tool.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for segmenting medical images using a deep learning architecture.\",\n        \"The deep learning architecture comprising attention mechanisms.\",\n        \"A system for automated anomaly detection in medical images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67208", "text": "{\n    \"patent_title\": \"Image Compression Technique Using Wavelet Transforms\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corp\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved image compression technique based on wavelet transforms. It achieves higher compression ratios with minimal loss of image quality. The method is particularly suitable for transmitting images over low-bandwidth networks.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing images using wavelet transforms.\",\n        \"A system for transmitting compressed images.\",\n        \"An image compression algorithm.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67209", "text": "{\n    \"patent_title\": \"Remote Physiological Parameter Monitoring System and Method\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-11-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for remote monitoring of patient vital signs, including heart rate, blood pressure, and oxygen saturation. The system utilizes wearable sensors and a cloud-based data analysis platform to provide real-time alerts to healthcare providers.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for remotely monitoring a patient's physiological parameters...\",\n        \"A method for analyzing patient data to detect anomalies...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67209", "text": "{\n    \"patent_title\": \"Surgical Instrument with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-10\",\n    \"issue_date\": \"2020-08-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical instrument designed for precise tissue dissection and manipulation. Features include ergonomic handle and enhanced visualization capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising an ergonomic handle...\",\n        \"A method for precise tissue dissection using the instrument...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67210", "text": "{\n    \"patent_title\": \"Enhanced Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for enhancing the resolution of digital images using a deep convolutional neural network. The network is trained to predict high-resolution image details from low-resolution inputs, resulting in improved image clarity and sharpness.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Super-Resolution with GANs\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising: training a deep neural network...\",\n        \"The method of claim 1, wherein the deep neural network is a convolutional neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67210", "text": "{\n    \"patent_title\": \"Method for Efficient Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"IBM Research\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-08-01\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2020-12-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel data compression algorithm that utilizes a combination of Huffman coding and Lempel-Ziv techniques to achieve high compression ratios. The method is particularly well-suited for compressing text and binary data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Adaptive Huffman Coding\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data comprising: encoding the data using Huffman coding...\",\n        \"The method of claim 1, further comprising: applying a Lempel-Ziv algorithm to the encoded data.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67211", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Detail Recovery\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-09-20\",\n    \"issue_date\": \"2020-01-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for enhancing image detail by utilizing a novel noise reduction algorithm combined with edge sharpening techniques. The system is designed to improve the visual clarity of existing images without introducing artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Denoising Using Wavelet Transform\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image detail comprising...\",\n        \"A system for processing images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67211", "text": "{\n    \"patent_title\": \"Generative Adversarial Network for Creating Realistic Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2021-04-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A generative adversarial network (GAN) architecture is described for creating high-resolution, photorealistic images from random noise. The system is capable of generating completely novel visual content.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"title\": \"Deep Convolutional GANs\"\n        }\n    ],\n    \"claims\": [\n        \"A generative adversarial network comprising...\",\n        \"A method for generating images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67212", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Enhanced Patient Comfort\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel catheter design incorporating flexible materials and a streamlined tip to minimize patient discomfort during insertion and use. The design also improves usability for medical personnel, reducing procedure time and potential complications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible distal tip...\",\n        \"A method of inserting a catheter comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67212", "text": "{\n    \"patent_title\": \"Automated Surgical Robot System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2014-12-01\",\n    \"filing_date\": \"2014-12-01\",\n    \"issue_date\": \"2017-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated surgical robot system capable of performing complex surgical procedures with high precision. The system utilizes advanced sensors and algorithms for real-time guidance and control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robot system comprising a robotic arm...\",\n        \"A method of performing surgery using a robotic system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67213", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-05-15\",\n    \"filing_date\": \"2020-06-15\",\n    \"issue_date\": \"2021-11-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system incorporating advanced imaging techniques and robotic assistance to improve surgical precision and patient recovery times. The system includes a console, a patient cart with robotic arms, and a vision system providing a high-resolution 3D view of the surgical site. This leads to better outcomes and reduced trauma.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Similar robotic surgical system\"\n        }\n    ],\n    \"claims\": [\n        \"A minimally invasive surgical system comprising a robotic arm...\",\n        \"A method for performing a surgical procedure using the system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67213", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Cardiovascular Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Medtronic\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2021-02-10\",\n    \"filing_date\": \"2021-03-10\",\n    \"issue_date\": \"2022-08-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel catheter design featuring a flexible tip and improved lumen for efficient delivery of therapeutic agents. The catheter is designed to navigate complex vascular pathways during cardiovascular procedures, improving access and reducing the risk of complications. Focuses primarily on access and delivery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Prior art catheter designs\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible distal tip...\",\n        \"A method for delivering a therapeutic agent using the catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67214", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for improving the quality and speed of medical image reconstruction, particularly for computed tomography (CT) scans. The invention utilizes a new iterative algorithm that reduces artifacts and enhances image resolution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"count\": 150\n        },\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"count\": 80\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for performing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67214", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-10-13\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new contrast agent for magnetic resonance imaging (MRI) that provides improved signal enhancement and reduced toxicity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"count\": 20\n        },\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"count\": 10\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"A method for enhancing MRI images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67215", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Pressure Sensor for Glaucoma Management\",\n    \"inventors\": [\n        {\n            \"name\": \"David K. Anderson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Maria Gomez\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11567890B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-01-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable pressure sensor for continuous intraocular pressure monitoring in glaucoma patients. The device utilizes a MEMS pressure transducer and wireless communication for real-time data transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        },\n        {\n            \"patent_number\": \"US10234567B1\"\n        }\n    ],\n    \"claims\": [\n        \"1. A miniaturized implantable pressure sensor comprising: a MEMS pressure transducer…\",\n        \"2. The sensor of claim 1, further comprising a wireless communication module…\",\n        \"3. The sensor of claim 2, wherein the wireless communication module utilizes Bluetooth Low Energy…\",\n        \"4. A system for monitoring intraocular pressure comprising: the miniaturized implantable pressure sensor of claim 1; and a receiver…\",\n        \"5. The system of claim 4, wherein the receiver displays the intraocular pressure in real-time…\",\n        \"6. The system of claim 4, further comprising an alert mechanism triggered when the intraocular pressure exceeds a predetermined threshold…\",\n        \"7. The sensor of claim 1, wherein the MEMS pressure transducer is fabricated using silicon-on-insulator (SOI) technology…\",\n        \"8. The sensor of claim 1, wherein the power source is a biocompatible battery…\",\n        \"9. The sensor of claim 1, wherein the device is hermetically sealed…\",\n        \"10. A method for monitoring intraocular pressure…\",\n        \"11. The method of claim 10, wherein the monitoring is continuous…\",\n        \"12. The method of claim 10, wherein the data is transmitted to a healthcare professional…\",\n        \"13. The method of claim 10, wherein the monitoring adjusts medication dosage…\",\n        \"14. The method of claim 10, wherein the monitoring alerts the user for potential medical intervention…\"\n    ]\n}"}
{"_id": "Academic--patents--n--67215", "text": "{\n    \"patent_title\": \"Surgical Instrument Handle with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11445566B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical instrument handle designed for enhanced grip and reduced hand fatigue during prolonged surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"1. A surgical instrument handle comprising: a grip portion…\",\n        \"2. The handle of claim 1, wherein the grip portion is formed from a non-slip material…\",\n        \"3. The handle of claim 1, further comprising an adjustable finger rest…\"\n    ]\n}"}
{"_id": "Academic--patents--p--67216", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Device for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Mark Horowitz\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jennifer Dionne\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable device for continuous glucose monitoring, incorporating advanced microfabrication techniques and biocompatible materials to enhance patient comfort and accuracy of readings. This results in improved diabetes management and patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in glucose monitoring\"\n        }\n    ],\n    \"claims\": [\n        \"A method for continuously monitoring glucose levels in a patient.\",\n        \"An implantable glucose sensor with a miniaturized form factor.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67216", "text": "{\n    \"patent_title\": \"Surgical Instrument for Bone Cutting\",\n    \"inventors\": [\n        {\n            \"name\": \"William Fry\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US7654321B2\",\n    \"priority_date\": \"2005-08-20\",\n    \"filing_date\": \"2006-08-20\",\n    \"issue_date\": \"2012-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical instrument designed for precise bone cutting during orthopedic procedures. Features an ergonomic handle and high-speed cutting blade.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"relevance\": \"Prior art in surgical instruments\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument with an ergonomic handle.\",\n        \"A bone cutting blade with a high cutting speed.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67217", "text": "{\n    \"patent_title\": \"Improved Training Efficiency for Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel optimization algorithm for training deep neural networks, significantly reducing training time and computational resources required while maintaining comparable accuracy to existing models. It focuses on adaptive learning rate scheduling and gradient compression techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Deep Learning Framework for Image Recognition\"\n        }\n    ],\n    \"claims\": [\n        \"A method for training a deep neural network comprising...\",\n        \"An optimization algorithm for reducing training time...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67217", "text": "{\n    \"patent_title\": \"Novel Generative Adversarial Network Architecture\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-15\",\n    \"issue_date\": \"2021-06-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a completely new generative adversarial network (GAN) architecture with unique layers and a novel training procedure, resulting in significantly improved image generation quality and diversity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"title\": \"Improved GAN Training Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A generative adversarial network architecture comprising...\",\n        \"A method for generating images using the novel GAN architecture...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67218", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2019-03-20\",\n    \"issue_date\": \"2021-01-26\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A novel method and system for reconstructing medical images with enhanced clarity and resolution. The invention utilizes a deep learning algorithm to reduce noise and artifacts, resulting in improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for enhancing the clarity of a medical image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67218", "text": "{\n    \"patent_title\": \"Contrast Agent for Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"University of Barcelona\"\n        }\n    ],\n    \"patent_number\": \"EP3456789B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2018-07-10\",\n    \"issue_date\": \"2020-03-18\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"A novel contrast agent for use in magnetic resonance imaging, providing improved signal intensity and enhanced visualization of targeted tissues.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"A method for enhancing the visibility of tissues using the contrast agent...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67219", "text": "{\n    \"patent_title\": \"Improved Cardiovascular Disease Diagnostic System Using Enhanced MRI Techniques\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel magnetic resonance imaging (MRI) system and method for improved detection and diagnosis of cardiovascular diseases. The system utilizes advanced pulse sequences and image processing algorithms to enhance image quality and accuracy, leading to earlier and more reliable diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Contrast Agent for MRI\"\n        }\n    ],\n    \"claims\": [\n        \"A method for imaging the cardiovascular system comprising...\",\n        \"An MRI system configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67219", "text": "{\n    \"patent_title\": \"Novel Algorithm for Processing Satellite Imagery\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new algorithm for enhancing the resolution and clarity of satellite images, enabling improved monitoring of environmental changes and resource management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10112233B2\",\n            \"title\": \"Image Compression Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing satellite imagery comprising...\",\n        \"A computer-implemented system for...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67220", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging Techniques for Early Alzheimer's Disease Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides improved magnetic resonance imaging (MRI) techniques for the early detection of Alzheimer's disease. The techniques utilize novel pulse sequences and image processing algorithms to enhance the visualization of amyloid plaques and tau tangles, enabling earlier and more accurate diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for imaging brain tissue using MRI...\",\n        \"An MRI system configured to detect amyloid plaques...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67220", "text": "{\n    \"patent_title\": \"Enhanced X-Ray Imaging System for Fracture Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11112222B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved X-ray imaging system for the detection of bone fractures. It features a novel detector array and image reconstruction algorithm that provides higher resolution images with reduced radiation dose.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A detector array for capturing X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67221", "text": "{\n    \"patent_title\": \"Magnetic Resonance Image Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2020-03-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel deep learning approach to magnetic resonance image (MRI) reconstruction, drastically reducing scan times and improving image quality. The method represents a breakthrough in medical imaging, enabling faster and more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B1\",\n            \"relevance\": \"Prior art on MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image...\",\n        \"A system comprising a processor...\",\n        \"The method of claim 1, wherein the deep learning model...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67221", "text": "{\n    \"patent_title\": \"Improved X-Ray Shielding Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2018-11-01\",\n    \"issue_date\": \"2021-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel composite material for X-ray shielding, offering improved protection against radiation exposure. It builds upon existing materials with a minor enhancement in density.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Previous work on X-ray shielding\"\n        }\n    ],\n    \"claims\": [\n        \"A composite material comprising...\",\n        \"The material of claim 1, having a density...\",\n        \"A shield constructed from the material...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67222", "text": "{\n    \"patent_title\": \"Comfort-Enhanced Intravascular Stent\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MedTech Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel intravascular stent design incorporating a flexible, biocompatible coating to minimize vessel wall irritation and enhance patient comfort during and after implantation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on stent design\"\n        }\n    ],\n    \"claims\": [\n        \"A stent comprising a flexible framework...\",\n        \"A biocompatible coating applied to the stent framework...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67222", "text": "{\n    \"patent_title\": \"High-Throughput Drug Delivery System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-15\",\n    \"issue_date\": \"2021-05-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for precise and rapid delivery of pharmaceutical compounds. The system focuses on maximizing drug efficacy and minimizing dosage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related work on microfluidic devices\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising a channel network...\",\n        \"A method for delivering a pharmaceutical compound...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67223", "text": "{\n    \"patent_title\": \"High-Resolution Optical Coherence Tomography System with Adaptive Scanning\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10456789B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2021-02-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel optical coherence tomography (OCT) system utilizing adaptive scanning algorithms to achieve unprecedented resolution in retinal imaging. The system overcomes limitations of traditional OCT by dynamically adjusting scan patterns based on real-time tissue characteristics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Conventional Optical Coherence Tomography\"\n        }\n    ],\n    \"claims\": [\n        \"A method for high-resolution OCT imaging comprising adaptive scanning.\",\n        \"An OCT system with a dynamic scan pattern adjustment module.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67223", "text": "{\n    \"patent_title\": \"Improved X-Ray Image Processing Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2014-12-01\",\n    \"filing_date\": \"2014-12-01\",\n    \"issue_date\": \"2019-07-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved algorithm for processing X-ray images to reduce noise and enhance contrast. This algorithm builds upon existing techniques to provide a more visually clear image for diagnostic purposes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Standard X-Ray Image Processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing X-ray images using noise reduction.\",\n        \"An X-ray image processing system employing the described algorithm.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67224", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging Technique for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel magnetic resonance imaging (MRI) technique employing advanced pulse sequences and image reconstruction algorithms for enhanced detection of early-stage cancerous tumors.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8543210B2\",\n            \"relevance\": \"Prior art in MRI pulse sequences\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI comprising...\",\n        \"An MRI system configured to...\",\n        \"A computer-readable medium storing instructions for...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67224", "text": "{\n    \"patent_title\": \"Digital X-Ray Image Enhancement System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-09-20\",\n    \"filing_date\": \"2017-09-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for improving the clarity and contrast of digital X-ray images using image processing techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"relevance\": \"Prior art in X-ray image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A system for enhancing digital X-ray images...\",\n        \"A method for improving image contrast...\",\n        \"A computer program for processing X-ray data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67225", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Recognition System for Autonomous Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Sergey Levine\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep learning system for image recognition designed for autonomous vehicles, capable of accurately identifying objects in real-time. The system incorporates novel attention mechanisms and data augmentation techniques to improve performance in challenging conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for object detection in images using a convolutional neural network.\",\n        \"A system for autonomous navigation utilizing real-time image recognition.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67225", "text": "{\n    \"patent_title\": \"Theoretical Framework for Robust Image Feature Extraction\",\n    \"inventors\": [\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-12-10\",\n    \"filing_date\": \"2019-12-10\",\n    \"issue_date\": \"2022-09-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This patent outlines a theoretical framework for extracting robust image features based on advanced mathematical principles. It analyzes the limitations of existing feature extraction methods and proposes a new approach to improve robustness against noise and variations in lighting conditions.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for feature extraction based on wavelet transforms.\",\n        \"A mathematical model for characterizing image robustness.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67226", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"MIT Lincoln Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-11-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable biosensor for continuous glucose monitoring is disclosed. The device utilizes a novel enzyme-based electrochemical sensor and wireless communication for real-time data transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on glucose monitoring\"\n        }\n    ],\n    \"claims\": [\n        \"1. A miniaturized implantable biosensor comprising...\",\n        \"2. The biosensor of claim 1, wherein...\",\n        \"3. A method for continuous glucose monitoring...\",\n        \"4. The method of claim 3, wherein...\",\n        \"5. A system for wirelessly transmitting data...\",\n        \"6. The system of claim 5, wherein...\",\n        \"7. A device for calibrating the biosensor...\",\n        \"8. The device of claim 7, wherein...\",\n        \"9. An assembly comprising the biosensor...\",\n        \"10. The assembly of claim 9, wherein...\",\n        \"11. The biosensor comprising a biocompatible coating...\",\n        \"12. The coating of claim 11, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67226", "text": "{\n    \"patent_title\": \"Surgical Instrument Handle with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Acme Medical Devices, Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-08-10\",\n    \"filing_date\": \"2019-12-15\",\n    \"issue_date\": \"2021-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical instrument handle is disclosed, designed to enhance operator comfort and reduce fatigue during prolonged surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Existing surgical handle designs\"\n        }\n    ],\n    \"claims\": [\n        \"1. A surgical instrument handle comprising...\",\n        \"2. The handle of claim 1, wherein...\",\n        \"3. A grip portion configured for ergonomic...\",\n        \"4. The grip portion of claim 3, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67227", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Glucose Sensor with Extended Lifespan\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-09-20\",\n    \"issue_date\": \"2021-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable glucose sensor is disclosed, providing continuous glucose monitoring with an extended lifespan and improved biocompatibility. The device aims to improve patient outcomes by enabling more precise diabetes management and reducing the need for frequent finger-prick tests.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A glucose sensor comprising...\",\n        \"A method for continuously monitoring glucose levels...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67227", "text": "{\n    \"patent_title\": \"Novel Catheter Design for Enhanced Fluid Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MedTech Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-03-05\",\n    \"issue_date\": \"2021-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel catheter design with improved fluid delivery capabilities. The catheter features a streamlined tip and enhanced material properties for reduced friction during insertion. It is designed for use in various medical procedures requiring precise fluid administration.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising...\",\n        \"A method for delivering fluids using the catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67228", "text": "{\n    \"patent_title\": \"Improved MRI Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2021-02-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning approach for reconstructing MRI images with improved resolution and reduced scan time. This represents a significant advancement in medical imaging capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art on MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images using a deep neural network.\",\n        \"A system for performing MRI reconstruction as described above.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67228", "text": "{\n    \"patent_title\": \"Enhanced X-Ray Image Filtering Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Peter Jones\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2018-11-22\",\n    \"filing_date\": \"2018-11-22\",\n    \"issue_date\": \"2020-08-04\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a new filtering technique for X-ray images, leading to slightly improved image clarity. It offers incremental improvements over existing methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US12345678B2\",\n            \"relevance\": \"Similar X-ray filtering techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for filtering X-ray images using a specific kernel.\",\n        \"An apparatus for implementing the filtering method.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67229", "text": "{\n    \"patent_title\": \"System and Method for Object Recognition in Real-Time Video Streams\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10248572B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2019-12-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for recognizing objects in real-time video streams using convolutional neural networks. The system is designed for practical applications such as automated surveillance and traffic monitoring.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in object detection\"\n        }\n    ],\n    \"claims\": [\n        \"A system for object recognition comprising a camera, a processor, and a memory.\",\n        \"A method for object recognition comprising the steps of capturing an image, processing the image with a neural network, and identifying an object.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67229", "text": "{\n    \"patent_title\": \"Novel Mathematical Framework for Feature Extraction in Image Data\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11123456B2\",\n    \"priority_date\": \"2019-03-10\",\n    \"filing_date\": \"2019-03-10\",\n    \"issue_date\": \"2021-04-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel mathematical framework for feature extraction from image data, based on advanced wavelet transforms and signal processing techniques.  The invention provides a theoretical foundation for improved image analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related work on wavelet transforms\"\n        }\n    ],\n    \"claims\": [\n        \"A mathematical function for feature extraction from image data.\",\n        \"A method for processing image data based on wavelet transforms.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67230", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Enhancement for Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for enhancing the quality of medical images, improving diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing medical images using a convolutional neural network.\",\n        \"A system for improving the resolution of medical images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67230", "text": "{\n    \"patent_title\": \"Method for Improving Color Contrast in Digital Photographs\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Kodak Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-12-10\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2021-08-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for automatically adjusting the color contrast in digital photographs to enhance visual appeal.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for adjusting color contrast in a digital image.\",\n        \"A system for improving the visual quality of digital photographs.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67231", "text": "{\n    \"patent_title\": \"Enhanced MRI Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing MRI images using deep convolutional neural networks, significantly improving image quality and reducing scan time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images...\",\n        \"A system comprising a deep learning model...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67231", "text": "{\n    \"patent_title\": \"Improved X-Ray Tube Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Philips Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US91234567B1\",\n    \"priority_date\": \"2014-12-20\",\n    \"filing_date\": \"2014-12-20\",\n    \"issue_date\": \"2018-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved design for X-ray tubes, enhancing their efficiency and lifespan. This is an incremental improvement over existing designs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube comprising a modified anode...\",\n        \"A method for manufacturing an X-ray tube...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67232", "text": "{\n    \"patent_title\": \"Method and System for Enhancing Image Resolution Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-01\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for enhancing the resolution of digital images using deep convolutional neural networks. The system utilizes a novel architecture to reconstruct high-frequency details, resulting in improved image clarity and perceptual quality. Applications include medical imaging and satellite imagery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Super-Resolution Using Convolutional Neural Networks\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising...\",\n        \"A system for processing digital images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67232", "text": "{\n    \"patent_title\": \"System and Method for Audio Signal Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-11-20\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2021-08-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system and method for processing audio signals to remove noise and enhance clarity. It utilizes a recursive filter to isolate the desired audio component from background interference. Applications include telecommunications and speech recognition.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Noise Reduction in Audio Systems\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing audio signals comprising...\",\n        \"A system for filtering audio...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67233", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction Method for Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel image reconstruction method for magnetic resonance imaging (MRI) that improves image quality and reduces scan time, leading to enhanced diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in image reconstruction.\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for reconstructing an MRI image comprising...\",\n        \"2. The method of claim 1, wherein...\",\n        \"3. An MRI system configured to...\",\n        \"4. The MRI system of claim 3, wherein...\",\n        \"5. A computer-readable medium comprising...\",\n        \"6. The computer-readable medium of claim 5, wherein...\",\n        \"7. The method of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67233", "text": "{\n    \"patent_title\": \"Portable Ultrasound Device for Veterinary Use\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Veterinary Imaging Solutions\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-09-20\",\n    \"filing_date\": \"2017-09-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A compact and portable ultrasound device designed for veterinary diagnostic applications. The device is lightweight and easy to use in field settings.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art in portable ultrasound technology.\"\n        }\n    ],\n    \"claims\": [\n        \"1. A portable ultrasound device comprising...\",\n        \"2. The device of claim 1, wherein...\",\n        \"3. A battery for powering the device...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67234", "text": "{\n    \"patent_title\": \"Adaptive Image Recognition System Using Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An image recognition system that utilizes deep neural networks and adaptive learning algorithms to improve recognition accuracy over time. The system can adapt to changing environmental conditions and learn to identify new objects without explicit retraining.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"An image recognition system configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67234", "text": "{\n    \"patent_title\": \"Image Compression Technique using Wavelet Transform\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2019-12-01\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-09-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image compression technique based on wavelet transform. The method achieves high compression ratios while maintaining acceptable image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image comprising...\",\n        \"An image compression system configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67235", "text": "{\n    \"patent_title\": \"AI-Assisted Mammography System for Early Breast Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a mammography system utilizing artificial intelligence algorithms for enhanced early breast cancer detection. The system analyzes mammographic images to identify subtle anomalies indicative of early-stage tumors, improving diagnostic accuracy and patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting breast cancer using AI-enhanced image analysis.\",\n        \"A mammography system comprising an image acquisition module and an AI processing unit.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67235", "text": "{\n    \"patent_title\": \"Improved X-Ray Tube Design for General Radiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2017-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved design of an X-ray tube, focusing on enhanced heat dissipation and increased image clarity. The design incorporates novel materials and cooling techniques to improve the overall performance and lifespan of the X-ray tube.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art in X-ray tube technology\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube with improved heat dissipation characteristics.\",\n        \"A radiography system incorporating the improved X-ray tube.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67236", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable biosensor for continuous glucose monitoring is disclosed. The device utilizes a novel enzymatic reaction and a microfluidic channel to provide accurate and real-time glucose readings.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art related to glucose monitoring.\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable biosensor comprising...\",\n        \"A method for continuous glucose monitoring using the biosensor...\",\n        \"A system for data transmission and analysis...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67236", "text": "{\n    \"patent_title\": \"Improved Syringe Design for Insulin Injection\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Baxter Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved syringe design for insulin injection with enhanced accuracy and ease of use is disclosed. The syringe features a modified plunger and needle gauge.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous syringe designs.\"\n        }\n    ],\n    \"claims\": [\n        \"A syringe comprising a modified plunger...\",\n        \"A needle gauge for improved insulin injection...\",\n        \"A method for administering insulin using the syringe...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67237", "text": "{\n    \"patent_title\": \"Low-Dose Computed Tomography Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for reconstructing high-quality CT images from low-dose scans using a deep convolutional neural network. The method significantly reduces patient radiation exposure while maintaining diagnostic image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image denoising\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image from low-dose scan data comprising...\",\n        \"A system for performing low-dose CT imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67237", "text": "{\n    \"patent_title\": \"Method for Enhancing Contrast in Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-19\",\n    \"issue_date\": \"2021-06-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel technique for improving the contrast of images obtained via magnetic resonance imaging (MRI) without increasing scan time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related to pulse sequence optimization\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing contrast in an MRI image comprising...\",\n        \"An MRI system configured to implement the contrast enhancement method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67238", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Real-Time Feedback\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-01\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel minimally invasive surgical system incorporating real-time feedback mechanisms to enhance surgical precision and improve patient outcomes following the procedure. The system employs advanced sensor technology and image processing algorithms to provide surgeons with detailed information during operation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in minimally invasive surgery.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising a sensor for detecting tissue properties...\",\n        \"A method for performing minimally invasive surgery using real-time feedback...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67238", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Fluid Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-05-20\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2022-07-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new catheter design for more efficient and reliable fluid delivery, particularly in emergency medical situations. The catheter features a streamlined tip and improved material properties.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related to existing catheter technology.\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a streamlined tip...\",\n        \"A method for delivering fluids using the catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67239", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Pressure Sensor for Intracranial Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-05-15\",\n    \"issue_date\": \"2023-11-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized, wireless pressure sensor is disclosed for continuous intracranial pressure monitoring. The device utilizes a novel MEMS technology and biocompatible materials, enabling long-term implantation and real-time data transmission. This represents a significant advancement over existing invasive monitoring techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor for intracranial monitoring comprising...\",\n        \"A method for continuous intracranial pressure monitoring using the sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67239", "text": "{\n    \"patent_title\": \"Improved Syringe Design with Enhanced Grip\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2022-01-10\",\n    \"filing_date\": \"2022-01-10\",\n    \"issue_date\": \"2023-08-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved syringe design featuring an ergonomic grip for enhanced user comfort and control during injection. The syringe incorporates a textured surface and optimized barrel shape.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A syringe comprising an ergonomic grip...\",\n        \"A method of injecting a substance using the improved syringe...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67240", "text": "{\n    \"patent_title\": \"Neural Network Architecture for Efficient Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2022-05-15\",\n    \"filing_date\": \"2022-08-20\",\n    \"issue_date\": \"2023-09-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel neural network architecture incorporating attention mechanisms and residual connections, significantly improving image recognition accuracy and reducing computational complexity. The architecture utilizes a dynamically adjusted receptive field based on image content, enhancing feature extraction and enabling efficient processing of high-resolution images.  Experimental results demonstrate a 15% improvement in accuracy compared to existing state-of-the-art models on the ImageNet dataset, with a 20% reduction in inference time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in convolutional neural networks\"\n        }\n    ],\n    \"claims\": [\n        \"A neural network architecture comprising an attention mechanism...\",\n        \"A method for image recognition using the proposed architecture...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67240", "text": "{\n    \"patent_title\": \"System for Data Storage\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corp\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2022-11-01\",\n    \"filing_date\": \"2023-02-10\",\n    \"issue_date\": \"2023-07-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for storing data. Data is stored in a storage medium.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A system for storing data comprising a storage medium...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67241", "text": "{\n    \"patent_title\": \"Improved MRI Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-04-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel deep learning approach to reconstruct MRI images with significantly improved resolution and reduced scan time. Clinical trials demonstrate a 15% improvement in diagnostic accuracy for detecting early-stage tumors and improved patient comfort due to shorter scan times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67241", "text": "{\n    \"patent_title\": \"Novel Coil Design for MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-01-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new radiofrequency coil design for MRI machines. The coil improves signal-to-noise ratio in specific anatomical regions, allowing for faster imaging. The coil itself is more compact and easier to manufacture.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil comprising...\",\n        \"A method of manufacturing an MRI coil...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67242", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Enhancement for Low-Light Conditions\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Research\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel deep learning architecture for enhancing images captured in low-light conditions. Utilizing a generative adversarial network with a unique loss function, the system dramatically improves image clarity and detail, representing a significant advancement in the field of image processing. Results demonstrate state-of-the-art performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing low-light images using a deep neural network.\",\n        \"The method of claim 1, wherein the deep neural network is a generative adversarial network.\",\n        \"The method of claim 2, further comprising a loss function designed to preserve image detail.\",\n        \"A system for implementing the method of claim 1.\",\n        \"A non-transitory computer-readable medium storing instructions for performing the method of claim 1.\",\n        \"The system of claim 4, comprising a processor and memory.\",\n        \"The system of claim 5, further comprising an image sensor.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67242", "text": "{\n    \"patent_title\": \"Image Compression Using Wavelet Transform\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method for compressing images using a wavelet transform. The method utilizes a discrete cosine transform (DCT) to reduce redundancy and improve compression ratio. It is an effective method for archiving and transmitting image data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image using a wavelet transform.\",\n        \"The method of claim 1, further comprising a discrete cosine transform (DCT).\",\n        \"A system for implementing the method of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67243", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction Method for Enhanced Medical Diagnostic Accuracy\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel image reconstruction method for medical imaging, specifically designed to enhance the clarity and diagnostic accuracy of images obtained from MRI and CT scans. The method employs a deep learning algorithm to reduce noise and artifacts, resulting in improved visualization of subtle anatomical features.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing medical images comprising...\",\n        \"A system for medical image analysis using the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67243", "text": "{\n    \"patent_title\": \"System for Controlling MRI Machine Parameters\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2014-11-10\",\n    \"filing_date\": \"2014-11-10\",\n    \"issue_date\": \"2017-05-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system and method for automatically controlling parameters of an MRI machine to optimize image quality. The system uses feedback loops to adjust parameters based on real-time data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for controlling MRI machine parameters comprising...\",\n        \"A method for optimizing image quality using the system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67244", "text": "{\n    \"patent_title\": \"Enhanced Image Restoration using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method for enhancing the quality of degraded images using deep convolutional neural networks. The method effectively removes noise and artifacts, resulting in clearer and more visually appealing images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for restoring images comprising...\",\n        \"A system for enhancing image quality...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67244", "text": "{\n    \"patent_title\": \"Method for Compressing Digital Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp.\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Acme Corp.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-11-20\",\n    \"filing_date\": \"2020-03-01\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel method for compressing digital images to reduce storage space and transmission bandwidth. The method utilizes a wavelet transform and entropy encoding.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image comprising...\",\n        \"A system for encoding image data...\",\n        \"A device for reducing image file size...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67245", "text": "{\n    \"patent_title\": \"Remote Physiological Monitoring System and Method\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A remote patient monitoring system utilizing wearable sensors and a cloud-based platform for real-time data analysis and alert generation. The system aims to improve chronic disease management and reduce hospital readmissions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for remotely monitoring physiological parameters...\",\n        \"A method for analyzing sensor data to detect anomalies...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67245", "text": "{\n    \"patent_title\": \"Surgical Instrument with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-12-01\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-09-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical instrument designed for enhanced precision and reduced surgeon fatigue. The instrument features a novel handle design and optimized weight distribution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising a handle with an ergonomic grip...\",\n        \"A method for performing surgical procedures using the instrument...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67246", "text": "{\n    \"patent_title\": \"Method and System for Semantic Segmentation of Images using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for performing semantic segmentation of images using deep convolutional neural networks. The system is capable of identifying and classifying objects in complex scenes, enabling applications such as autonomous driving and image analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for semantic segmentation of an image comprising...\",\n        \"A system for performing image analysis comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67246", "text": "{\n    \"patent_title\": \"Improved Image Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-08-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved image compression algorithm that utilizes wavelet transform and entropy encoding to achieve higher compression ratios with minimal loss of image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"An image compression method comprising...\",\n        \"A system for compressing images using wavelet transform...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67247", "text": "{\n    \"patent_title\": \"Deep Convolutional Neural Networks for Scene Understanding\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2021-12-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep convolutional neural network architecture for understanding complex scenes. The system analyzes spatial relationships between objects and contextual information to provide a comprehensive interpretation of the environment.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11345678B1\",\n            \"title\": \"Improved Object Recognition System\"\n        },\n        {\n            \"patent_number\": \"US11456789B2\",\n            \"title\": \"Autonomous Vehicle Navigation\"\n        },\n        {\n            \"patent_number\": \"US11567890B1\",\n            \"title\": \"Medical Image Analysis\"\n        },\n        {\n            \"patent_number\": \"US11678901B2\",\n            \"title\": \"Robotic Manipulation\"\n        },\n        {\n            \"patent_number\": \"US11789012B1\",\n            \"title\": \"Augmented Reality Applications\"\n        },\n        {\n            \"patent_number\": \"US11890123B2\",\n            \"title\": \"Advanced Security System\"\n        }\n    ],\n    \"claims\": [\n        \"A system for scene understanding comprising...\",\n        \"A method for identifying contextual relationships...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67247", "text": "{\n    \"patent_title\": \"Efficient Object Detection in Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Sergey Levine\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11901234B2\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A streamlined object detection algorithm optimized for speed and accuracy. This system focuses on identifying and localizing individual objects within an image.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US12012345B1\",\n            \"title\": \"Real-time Video Processing\"\n        },\n        {\n            \"patent_number\": \"US12123456B2\",\n            \"title\": \"Image Classification Algorithm\"\n        },\n        {\n            \"patent_number\": \"US12234567B1\",\n            \"title\": \"Improved Feature Extraction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for object detection comprising...\",\n        \"A system for real-time image analysis...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67248", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Patient Feedback\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-01-20\",\n    \"issue_date\": \"2021-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system incorporating haptic feedback and real-time physiological monitoring to improve surgical precision and patient comfort. The system utilizes a smaller incision size and advanced imaging techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art in minimally invasive surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising a minimally invasive surgical instrument...\",\n        \"A method for performing surgery using the surgical system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67248", "text": "{\n    \"patent_title\": \"High-Throughput Screening System for Drug Discovery\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2021-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A high-throughput screening system for identifying potential drug candidates. The system utilizes microfluidic devices and automated analysis techniques to rapidly assess the efficacy of various compounds.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related prior art in drug screening\"\n        }\n    ],\n    \"claims\": [\n        \"A high-throughput screening system comprising a microfluidic device...\",\n        \"A method for screening compounds using the screening system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67249", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Cardiac Monitor with Wireless Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Medtronic Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10556789B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable cardiac monitor for long-term monitoring of heart rhythm. The device wirelessly transmits data to an external receiver for analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8761654B2\",\n            \"title\": \"Implantable Cardiac Pacemaker\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable cardiac monitor comprising...\",\n        \"A wireless communication module for transmitting cardiac data...\",\n        \"A power management system for long-term operation...\",\n        \"A method for remotely monitoring cardiac rhythm...\",\n        \"A system for detecting and alerting to abnormal heart conditions...\",\n        \"A data processing unit for analyzing cardiac signals...\",\n        \"A biocompatible housing for the implantable device...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67249", "text": "{\n    \"patent_title\": \"Improved Syringe Design for Insulin Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Becton Dickinson\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2019-09-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved syringe design for more accurate and comfortable insulin delivery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Disposable Syringe\"\n        }\n    ],\n    \"claims\": [\n        \"A syringe comprising a barrel, a plunger, and a needle...\",\n        \"The syringe having a graduated scale for accurate dosage...\",\n        \"A plunger with a textured grip for enhanced comfort...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67250", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Sensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable sensor for continuous glucose monitoring is disclosed. The sensor utilizes a novel microfabrication technique and biocompatible materials to provide accurate and reliable glucose readings.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable sensor comprising...\",\n        \"A method for continuous glucose monitoring using...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67250", "text": "{\n    \"patent_title\": \"Surgical Stapler with Enhanced Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler with enhanced ergonomic features for increased surgeon comfort and precision.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"A handle assembly configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67251", "text": "{\n    \"patent_title\": \"Implantable Cardiac Monitoring System with Predictive Analytics\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2020-05-15\",\n    \"filing_date\": \"2020-06-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"An implantable cardiac monitoring system capable of predicting cardiac events based on real-time data analysis, addressing the unmet need for early detection of heart failure exacerbations.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on implantable loop recorders\"\n        }\n    ],\n    \"claims\": [\n        \"A method for predicting cardiac events...\",\n        \"An implantable device comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67251", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Angioplasty\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"Medtronic\"\n        }\n    ],\n    \"patent_number\": \"EP3876543B1\",\n    \"priority_date\": \"2021-03-10\",\n    \"filing_date\": \"2021-04-10\",\n    \"issue_date\": \"2022-09-15\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"A novel catheter design offering improved maneuverability and reduced risk of vessel damage during angioplasty procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Existing catheter technology\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible distal tip...\",\n        \"A method for performing angioplasty using...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67252", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-01-20\",\n    \"issue_date\": \"2021-04-13\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable glucose sensor utilizing microfabrication techniques and wireless communication for continuous glucose monitoring. This addresses the critical unmet need for real-time glucose data in diabetes management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on glucose sensing\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable glucose sensor comprising...\",\n        \"A wireless communication module integrated with said sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67252", "text": "{\n    \"patent_title\": \"Improved Syringe Design for Insulin Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Baxter Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-10\",\n    \"issue_date\": \"2021-03-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved syringe design with enhanced ergonomics and dose accuracy for insulin delivery. This aims to improve patient compliance with insulin therapy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related syringe technologies\"\n        }\n    ],\n    \"claims\": [\n        \"A syringe comprising a barrel with graduated markings...\",\n        \"A plunger assembly configured for precise insulin delivery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67253", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized, implantable biosensor for continuous glucose monitoring utilizing novel nanomaterial-based sensing technology. The device offers enhanced accuracy, biocompatibility, and long-term stability compared to existing technologies, representing a significant advancement in diabetes management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in glucose sensing\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable biosensor comprising a nanomaterial-based glucose sensing element.\",\n        \"A method for continuous glucose monitoring using the aforementioned biosensor.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67253", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Acme Surgical Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-05-20\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-12-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler with ergonomic handle design for increased comfort and precision during surgical procedures. The stapler features a modified firing mechanism for reduced force requirements.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art in surgical staplers\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler with an ergonomically designed handle.\",\n        \"A firing mechanism for a surgical stapler requiring reduced actuation force.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67254", "text": "{\n    \"patent_title\": \"Wearable Sensor for Non-Invasive Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10543210B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-01-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wearable sensor device for continuous non-invasive glucose monitoring. The device is designed for improved patient comfort and ease of use with a flexible adhesive patch and wireless data transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A wearable sensor for non-invasive glucose monitoring comprising...\",\n        \"A method for continuous glucose monitoring using said wearable sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67254", "text": "{\n    \"patent_title\": \"Implantable Cardioverter Defibrillator with Enhanced Battery Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2021-02-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardioverter defibrillator with a novel battery technology providing extended operational life.  The device is designed for effective treatment of cardiovascular arrhythmias.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable cardioverter defibrillator comprising...\",\n        \"A method for treating cardiovascular arrhythmias using said device...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67255", "text": "{\n    \"patent_title\": \"Deep Learning Framework for Robust Image Recognition in Adverse Conditions\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep learning framework is presented for improving image recognition accuracy, particularly in low-light and obscured image scenarios. The system utilizes a novel attention mechanism and data augmentation techniques to enhance feature extraction and classification performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image recognition accuracy in low-light conditions.\",\n        \"A system utilizing a deep learning framework with an attention mechanism.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67255", "text": "{\n    \"patent_title\": \"Method for Enhanced Object Detection in Aerial Imagery\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2021-11-01\",\n    \"filing_date\": \"2021-11-01\",\n    \"issue_date\": \"2023-12-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This patent describes a method for improving object detection in aerial imagery using convolutional neural networks. The system focuses on identifying specific objects in high-resolution satellite images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for object detection in aerial images.\",\n        \"A system utilizing convolutional neural networks for image analysis.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67256", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the resolution of images using deep convolutional neural networks. The system utilizes a generative adversarial network (GAN) to generate high-resolution images from low-resolution inputs, resulting in improved image quality and detail.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        },\n        {\n            \"patent_number\": \"US9345678B1\"\n        },\n        {\n            \"patent_number\": \"US9567890B2\"\n        },\n        {\n            \"patent_number\": \"US9678901B1\"\n        },\n        {\n            \"patent_number\": \"US9789012B2\"\n        },\n        {\n            \"patent_number\": \"US9890123B1\"\n        },\n        {\n            \"patent_number\": \"US10012345B2\"\n        },\n        {\n            \"patent_number\": \"US10123456B1\"\n        },\n        {\n            \"patent_number\": \"US10234567B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising...\",\n        \"A system for enhancing image resolution comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67256", "text": "{\n    \"patent_title\": \"Image Compression Technique Using Wavelet Transform\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US7654321B1\",\n    \"priority_date\": \"2015-05-20\",\n    \"filing_date\": \"2015-05-20\",\n    \"issue_date\": \"2017-11-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for compressing images using a discrete wavelet transform. The technique reduces the size of image files without significant loss of quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\"\n        },\n        {\n            \"patent_number\": \"US7432109B2\"\n        },\n        {\n            \"patent_number\": \"US8321098B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image comprising...\",\n        \"An apparatus for compressing an image comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67257", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2021-11-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing medical images from raw data, utilizing a deep learning algorithm to reduce noise and enhance resolution, leading to improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"A system comprising a data acquisition device and a processing unit...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67257", "text": "{\n    \"patent_title\": \"Apparatus for Monitoring Patient Vital Signs\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2017-12-10\",\n    \"issue_date\": \"2020-09-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An apparatus for continuous monitoring of patient vital signs, including heart rate, blood pressure, and oxygen saturation, utilizing non-invasive sensors.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related to patient monitoring systems\"\n        }\n    ],\n    \"claims\": [\n        \"An apparatus for monitoring patient vital signs...\",\n        \"A sensor configured to measure heart rate...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67258", "text": "{\n    \"patent_title\": \"Deep Convolutional Neural Networks for Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        },\n        {\n            \"name\": \"Alex Krizhevsky\",\n            \"affiliation\": \"University of Toronto\"\n        },\n        {\n            \"name\": \"Ilya Sutskever\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"patent_number\": \"US9454889B2\",\n    \"priority_date\": \"2012-11-26\",\n    \"filing_date\": \"2014-09-04\",\n    \"issue_date\": \"2016-09-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep convolutional neural network architecture for image recognition is described. The network utilizes multiple convolutional layers to extract hierarchical features from images, and is trained using stochastic gradient descent. This architecture achieved state-of-the-art results on the ImageNet Large Scale Visual Recognition Challenge.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8036083B1\"\n        },\n        {\n            \"patent_number\": \"US7646698B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for recognizing objects in an image comprising...\",\n        \"A system for classifying images using a deep convolutional neural network...\",\n        \"A non-transitory computer-readable medium storing instructions for...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67258", "text": "{\n    \"patent_title\": \"Method for Enhancing Contrast in Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"General Hospital\"\n        }\n    ],\n    \"patent_number\": \"US8564923B2\",\n    \"priority_date\": \"2011-08-15\",\n    \"filing_date\": \"2013-02-18\",\n    \"issue_date\": \"2013-10-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for enhancing contrast in medical images, particularly X-rays, using histogram equalization. The method improves the visibility of subtle details in the images, aiding in diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7218632B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing contrast in a medical image...\",\n        \"A system for processing medical images to improve visibility...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67259", "text": "{\n    \"patent_title\": \"Method and System for Low-Dose Computed Tomography Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-12-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for reconstructing high-quality computed tomography (CT) images from low-dose radiation data. The technique utilizes advanced iterative reconstruction algorithms and noise reduction filters to enhance image clarity while minimizing patient exposure to ionizing radiation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in iterative reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a CT image...\",\n        \"A system comprising a CT scanner...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67259", "text": "{\n    \"patent_title\": \"Apparatus for Improved X-Ray Tube Cooling\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Philips Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-07-22\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved cooling system for X-ray tubes, designed to increase tube lifespan and maintain stable operating temperatures. The system employs a novel heat sink design and a high-efficiency coolant circulation mechanism.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related to X-ray tube design\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube cooling apparatus...\",\n        \"A heat sink for an X-ray tube...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67260", "text": "{\n    \"patent_title\": \"Implantable Cardiac Monitor with Wireless Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"David Starr\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Mark Golkowski\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-05-15\",\n    \"filing_date\": \"2020-05-15\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac monitor capable of wirelessly transmitting ECG data to a remote monitoring station, improving early detection of arrhythmias and reducing hospital readmissions. This device addresses the critical need for continuous cardiovascular monitoring in high-risk patients.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for remotely monitoring cardiac activity...\",\n        \"An implantable device comprising a sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67260", "text": "{\n    \"patent_title\": \"Surgical Robotic System with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Boston University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2021-03-10\",\n    \"filing_date\": \"2021-03-10\",\n    \"issue_date\": \"2023-04-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical robotic system designed to enhance precision and control during minimally invasive procedures. The system incorporates advanced haptic feedback and image guidance technologies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system comprising a controller...\",\n        \"A method for performing a surgical procedure using a robot...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67261", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel magnetic resonance imaging (MRI) technique utilizing advanced pulse sequences and image reconstruction algorithms to enhance the detection of early-stage cancerous tumors. The method improves image contrast and reduces scan time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8652234B2\",\n            \"title\": \"MRI Pulse Sequence Optimization\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI comprising...\",\n        \"An MRI apparatus configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67261", "text": "{\n    \"patent_title\": \"Enhanced X-Ray Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Wilson\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved X-ray imaging system with enhanced image processing capabilities for visualizing bone structures. It reduces radiation exposure while maintaining high image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Digital X-Ray Image Enhancement\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A method for enhancing X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67262", "text": "{\n    \"patent_title\": \"Remote Cardiovascular Monitoring System and Method\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2021-03-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A remote patient monitoring system utilizing wearable sensors to track cardiovascular metrics and transmit data for analysis and intervention. The system allows for early detection of anomalies and reduces hospital readmissions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in wearable sensor technology\"\n        }\n    ],\n    \"claims\": [\n        \"A system for remote cardiovascular monitoring comprising...\",\n        \"A method for analyzing cardiovascular data received from a wearable sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67262", "text": "{\n    \"patent_title\": \"Surgical Instrument for Minimally Invasive Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-15\",\n    \"issue_date\": \"2020-11-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical instrument designed for enhanced precision in minimally invasive procedures. The instrument incorporates a robotic control system and advanced imaging capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related to robotic surgical systems\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising a robotic control system...\",\n        \"A method for performing minimally invasive surgery using the surgical instrument...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67263", "text": "{\n    \"patent_title\": \"Low-Light Image Enhancement Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Independent Researcher\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-06-15\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep learning approach for enhancing images captured in low-light environments. The system utilizes a convolutional neural network to improve image visibility and reduce noise.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing low-light images comprising...\",\n        \"A system for real-time image enhancement...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67263", "text": "{\n    \"patent_title\": \"Color Correction Algorithm for Digital Cameras\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Sony Corporation\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Canon Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11123456B2\",\n    \"priority_date\": \"2018-11-20\",\n    \"filing_date\": \"2019-01-10\",\n    \"issue_date\": \"2021-05-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An algorithm for improving the color accuracy of digital images. It focuses on white balance and color saturation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for correcting color in digital images...\",\n        \"A digital camera comprising a color correction module...\",\n        \"A computer program for color adjustment...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67264", "text": "{\n    \"patent_title\": \"Wearable Sensor System for Continuous Physiological Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"David Edwards\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Maria Chen\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11876543B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-05-14\",\n    \"issue_date\": \"2023-12-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wearable sensor system for non-invasive and continuous monitoring of physiological parameters, including heart rate, respiration rate, and body temperature, facilitating remote patient monitoring and early detection of health anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10540789B2\",\n            \"title\": \"Smartwatch with Health Monitoring Features\"\n        }\n    ],\n    \"claims\": [\n        \"A wearable sensor system comprising...\",\n        \"A method for remotely monitoring a patient's physiological parameters...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67264", "text": "{\n    \"patent_title\": \"Implantable Cardiac Pacemaker with Remote Adjustment Capabilities\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2019-11-20\",\n    \"filing_date\": \"2019-11-19\",\n    \"issue_date\": \"2022-05-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac pacemaker system with remote adjustment capabilities for optimized heart rhythm control. Includes communication protocols for data transmission and parameter updates.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9295529B2\",\n            \"title\": \"Remote Cardiac Monitoring System\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Advanced Pacemaker Technology\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable cardiac pacemaker comprising...\",\n        \"A method for remotely adjusting pacemaker parameters...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67265", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Segmentation Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-01-29\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for image segmentation utilizing deep convolutional neural networks. The system employs a unique loss function to improve segmentation accuracy in challenging scenarios.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9000001B2\",\n            \"count\": 120\n        },\n        {\n            \"patent_number\": \"US9500002B2\",\n            \"count\": 85\n        },\n        {\n            \"patent_number\": \"US9700003B2\",\n            \"count\": 95\n        }\n    ],\n    \"claims\": [\n        \"A method for image segmentation comprising...\",\n        \"A system for image segmentation...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67265", "text": "{\n    \"patent_title\": \"Image Compression Technique Using Wavelet Transform\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US8888888B1\",\n    \"priority_date\": \"2015-05-20\",\n    \"filing_date\": \"2015-05-20\",\n    \"issue_date\": \"2017-08-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for compressing images using wavelet transformation, improving compression ratios.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7777777B2\",\n            \"count\": 10\n        },\n        {\n            \"patent_number\": \"US6666666B2\",\n            \"count\": 5\n        }\n    ],\n    \"claims\": [\n        \"A method for image compression comprising...\",\n        \"An apparatus for image compression...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67266", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for reconstructing medical images from raw data, utilizing a deep learning algorithm to significantly improve image clarity and reduce noise, surpassing conventional image enhancement techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for performing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67266", "text": "{\n    \"patent_title\": \"Apparatus for Medical Image Display\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-12-10\",\n    \"filing_date\": \"2014-12-10\",\n    \"issue_date\": \"2018-07-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved medical image display apparatus with enhanced contrast and brightness controls. This allows for better visualization of anatomical structures.\",\n    \"citations\": [],\n    \"claims\": [\n        \"An apparatus for displaying a medical image...\",\n        \"The apparatus comprising a display screen...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67267", "text": "{\n    \"patent_title\": \"Neural Network-Based Image Enhancement for Low-Light Conditions\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel neural network architecture is presented for enhancing images captured in low-light conditions. The network learns to map low-light images to high-quality, visually appealing images without introducing artifacts. This addresses the significant challenge of image restoration in scenarios with limited illumination.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing low-light images using a deep neural network.\",\n        \"A neural network architecture comprising convolutional layers, residual blocks, and an attention mechanism.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67267", "text": "{\n    \"patent_title\": \"Method for Improving Color Contrast in Digital Photographs\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-12-01\",\n    \"filing_date\": \"2019-12-01\",\n    \"issue_date\": \"2022-09-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method for automatically adjusting the color contrast of digital photographs to improve their visual appeal. The method involves analyzing the histogram of the image and applying a contrast enhancement algorithm.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for enhancing color contrast in digital images.\",\n        \"An algorithm for analyzing image histograms.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67268", "text": "{\n    \"patent_title\": \"Enhanced MRI Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel deep learning approach to reconstruct magnetic resonance images (MRIs) with significantly improved clarity and reduced noise. The method enhances diagnostic accuracy by enabling the visualization of subtle anatomical details. It aims to reduce scan times without compromising image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"MRI Reconstruction Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for processing MRI data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67268", "text": "{\n    \"patent_title\": \"Combined MRI and Radiation Therapy Planning System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11123456B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system for integrating MRI imaging with radiation therapy planning. The system allows for precise tumor localization and optimized radiation dose delivery. The abstract describes a combined system, incorporating advanced techniques for both imaging and radiation therapy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Radiation Dose Calculation Method\"\n        }\n    ],\n    \"claims\": [\n        \"A system for planning radiation therapy using MRI images...\",\n        \"A method for combining MRI and radiation therapy data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67269", "text": "{\n    \"patent_title\": \"High-Resolution Photoacoustic Tomography System with Improved Signal Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Elizabeth Hill\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Meyers\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-07-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel photoacoustic tomography system is disclosed, incorporating advanced signal processing techniques to achieve significantly improved resolution and penetration depth for medical imaging applications. The system utilizes a pulsed laser source and a wideband ultrasonic transducer array, coupled with a sophisticated reconstruction algorithm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in photoacoustic imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A photoacoustic tomography system comprising...\",\n        \"A method for reconstructing an image from photoacoustic data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67269", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2014-12-10\",\n    \"filing_date\": \"2014-12-10\",\n    \"issue_date\": \"2018-05-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel contrast agent is disclosed for use in magnetic resonance imaging, enhancing image clarity and providing improved diagnostic capabilities. The contrast agent comprises a gadolinium complex encapsulated within a biocompatible polymer.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related art in MRI contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent for MRI comprising...\",\n        \"A method for enhancing MRI images using the contrast agent...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67270", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2015-03-15\",\n    \"filing_date\": \"2015-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for enhancing the resolution and clarity of medical images obtained through computed tomography (CT) and magnetic resonance imaging (MRI). The method utilizes a novel image reconstruction algorithm to reduce noise and improve contrast, resulting in more detailed and diagnostically useful images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8652234B2\",\n            \"title\": \"Image Processing Technique for Noise Reduction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"A system for enhancing the resolution of a medical image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67270", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Minimally Invasive Surgery\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-07-01\",\n    \"filing_date\": \"2016-07-01\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a catheter design with improved flexibility and maneuverability for use in minimally invasive surgical procedures. The catheter incorporates a novel polymer material and a streamlined tip to facilitate access to difficult-to-reach anatomical locations.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Catheter with Flexible Tip\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible shaft...\",\n        \"A catheter tip configured for enhanced maneuverability...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67271", "text": "{\n    \"patent_title\": \"Low-Dose Computed Tomography with Advanced Iterative Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-06-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method and system for performing low-dose computed tomography (CT) imaging. Utilizing advanced iterative reconstruction algorithms, the system significantly reduces patient radiation exposure while maintaining diagnostic image quality. The technique employs a novel regularization approach to minimize noise and artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior Art in Iterative Reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing CT imaging with reduced radiation dose.\",\n        \"A CT system comprising an iterative reconstruction algorithm.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67271", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2021-05-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a new contrast agent for Magnetic Resonance Imaging (MRI) that enhances image clarity and provides improved tissue differentiation. The agent utilizes a gadolinium-based complex with modified ligands to increase relaxivity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior Art in MRI Contrast Agents\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent for MRI comprising a gadolinium complex.\",\n        \"A method for enhancing MRI image quality using the contrast agent.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67272", "text": "{\n    \"patent_title\": \"Deep Learning Based Image Enhancement System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Research\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel system for enhancing images using deep convolutional neural networks. This system significantly improves image quality and detail, particularly in low-light conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9012345B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image using a deep learning model.\",\n        \"A system comprising a deep learning model for image enhancement.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67272", "text": "{\n    \"patent_title\": \"Method for Color Space Conversion in Digital Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corp\"\n        }\n    ],\n    \"patent_number\": \"US7654321B2\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2016-09-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for converting images between different color spaces, such as RGB and YCbCr. The method includes a set of conversion matrices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for converting an image from RGB to YCbCr color space.\",\n        \"A system for performing color space conversions.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67273", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Cardiac Monitor with Wireless Charging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Medtronic\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2021-12-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable cardiac monitor offering wireless charging capabilities and enhanced data transmission. Addresses the limitations of existing devices by reducing size and improving patient convenience.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on implantable monitors\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable cardiac monitor comprising...\",\n        \"A wireless charging system for said monitor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67273", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Angiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Boston Scientific\"\n        }\n    ],\n    \"patent_number\": \"US11456789B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2022-09-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design featuring enhanced maneuverability and visualization capabilities for angiography procedures. This design improves the precision of existing techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous catheter designs\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible tip...\",\n        \"An imaging system integrated within said catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67274", "text": "{\n    \"patent_title\": \"Implantable Cardiac Monitor with Remote Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Chen\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac monitor for continuous ECG monitoring with remote data transmission capabilities via Bluetooth and cellular networks. The device allows for early detection of arrhythmias and heart failure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Prior Art Cardiac Monitor\"\n        }\n    ],\n    \"claims\": [\n        \"A method for remote monitoring of cardiac activity...\",\n        \"An implantable device comprising a sensor...\",\n        \"A system for detecting arrhythmias...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67274", "text": "{\n    \"patent_title\": \"Improved Stent Design for Peripheral Artery Disease\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Miller\",\n            \"affiliation\": \"Medtronic Inc.\"\n        },\n        {\n            \"name\": \"Sarah Johnson\",\n            \"affiliation\": \"Medtronic Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel stent design with improved flexibility and biocompatibility for the treatment of peripheral artery disease. The stent is constructed from a nickel-titanium alloy with a porous surface coating.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"title\": \"Existing Stent Technology\"\n        }\n    ],\n    \"claims\": [\n        \"A stent comprising a nickel-titanium alloy...\",\n        \"A method for treating peripheral artery disease...\",\n        \"A stent with a porous surface coating...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67275", "text": "{\n    \"patent_title\": \"Enhanced Medical Image Reconstruction Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        },\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing medical images from raw data, significantly reducing noise and improving image clarity. This leads to more accurate diagnoses in various medical fields.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"title\": \"Prior Art Medical Imaging System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"An apparatus for performing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67275", "text": "{\n    \"patent_title\": \"Advanced Multi-Modal Medical Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Siemens Healthineers\"\n        },\n        {\n            \"name\": \"Emily Green\",\n            \"affiliation\": \"Johns Hopkins University\"\n        },\n        {\n            \"name\": \"Frank White\",\n            \"affiliation\": \"University of Michigan\"\n        },\n        {\n            \"name\": \"Grace Black\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Henry Gray\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Ivy Purple\",\n            \"affiliation\": \"Mayo Clinic\"\n        }\n    ],\n    \"patent_number\": \"US10246813B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system integrating multiple medical imaging modalities to provide a comprehensive diagnostic view of the patient's anatomy and physiology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Enhanced Medical Image Reconstruction Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A multi-modal imaging system comprising...\",\n        \"A method for combining data from multiple imaging modalities...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67276", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for analyzing medical images to improve diagnostic accuracy by utilizing advanced machine learning algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for analyzing a medical image...\",\n        \"A system for improving diagnostic accuracy...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67276", "text": "{\n    \"patent_title\": \"Improved Contrast Agents for MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2018-11-01\",\n    \"issue_date\": \"2022-02-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides novel contrast agents for use in magnetic resonance imaging (MRI) to improve image clarity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"A method for enhancing MRI images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67277", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel MRI sequence and reconstruction method for enhanced early-stage cancer detection, improving diagnostic accuracy and reducing false positives.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art related to MRI sequences\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI comprising...\",\n        \"An MRI apparatus configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67277", "text": "{\n    \"patent_title\": \"Enhanced X-Ray Image Processing Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Carol Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"Dr. David Miller\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved algorithm for processing X-ray images to enhance contrast and reduce noise, leading to better image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related image processing techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing X-ray images comprising...\",\n        \"A system for enhancing X-ray image quality...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67278", "text": "{\n    \"patent_title\": \"Deep Learning for Image Enhancement and Restoration\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for enhancing and restoring images with improved performance and robustness.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image enhancement comprising...\",\n        \"A system for image restoration...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67278", "text": "{\n    \"patent_title\": \"Method for Compressing Digital Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new technique for efficiently compressing digital images, reducing storage requirements and transmission bandwidth.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"type\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image compression...\",\n        \"An apparatus for encoding images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67279", "text": "{\n    \"patent_title\": \"High-Resolution Medical Imaging System Utilizing Compressed Sensing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-03-15\",\n    \"filing_date\": \"2015-05-20\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A medical imaging system employing compressed sensing techniques to achieve high-resolution images with reduced scan times. The system utilizes advanced reconstruction algorithms to enhance image clarity and diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"title\": \"Compressed Sensing for MRI\"\n        }\n    ],\n    \"claims\": [\n        \"A medical imaging system comprising a sensor array...\",\n        \"A method for reconstructing an image from compressed data...\",\n        \"The system of claim 1, wherein the sensor array is an MRI coil.\",\n        \"The method of claim 2, wherein the reconstruction algorithm is an iterative algorithm.\",\n        \"The system of claim 1, further comprising a display for viewing the reconstructed image.\",\n        \"The method of claim 2, wherein the compressed data is acquired using a non-Cartesian sampling pattern.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67279", "text": "{\n    \"patent_title\": \"Portable Ultrasound Device with Wireless Connectivity\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Philips Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2017-03-10\",\n    \"issue_date\": \"2020-05-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A portable ultrasound device with wireless connectivity for remote diagnosis and monitoring. The device features a compact design and user-friendly interface.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Wireless Medical Monitoring System\"\n        }\n    ],\n    \"claims\": [\n        \"A portable ultrasound device comprising a transducer...\",\n        \"A wireless communication module for transmitting image data...\",\n        \"The device of claim 1, wherein the wireless communication module uses Bluetooth technology.\",\n        \"A battery power supply for powering the device.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67280", "text": "{\n    \"patent_title\": \"Deep Convolutional Neural Networks for Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        },\n        {\n            \"name\": \"Alex Krizhevsky\",\n            \"affiliation\": \"University of Toronto\"\n        },\n        {\n            \"name\": \"Ilya Sutskever\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"patent_number\": \"US9176751B2\",\n    \"priority_date\": \"2012-11-26\",\n    \"filing_date\": \"2013-03-04\",\n    \"issue_date\": \"2015-11-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep convolutional neural network is presented for image recognition. The network is trained on a large dataset of labeled images and achieves state-of-the-art performance on a variety of image recognition tasks.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7640131B2\",\n            \"title\": \"System and method for object recognition\"\n        }\n    ],\n    \"claims\": [\n        \"A method for recognizing objects in an image, comprising: obtaining an image; applying a convolutional neural network to the image; and identifying objects in the image based on the output of the convolutional neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67280", "text": "{\n    \"patent_title\": \"Method and Apparatus for Image Compression Using Discrete Cosine Transform\",\n    \"inventors\": [\n        {\n            \"name\": \"Ahmed H. Said\",\n            \"affiliation\": \"University of California, San Diego\"\n        }\n    ],\n    \"patent_number\": \"US5255378A\",\n    \"priority_date\": \"1990-11-20\",\n    \"filing_date\": \"1991-05-20\",\n    \"issue_date\": \"1993-10-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and apparatus for image compression are disclosed. The method utilizes a discrete cosine transform (DCT) to convert the image data into frequency components, which are then quantized and encoded for efficient storage and transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US4868757A\",\n            \"title\": \"Method and apparatus for image coding using transform coding\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image, comprising: transforming the image data using a discrete cosine transform; quantizing the transformed data; and encoding the quantized data.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67281", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Physiological Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-06-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized, wireless system for continuous monitoring of vital signs including heart rate, respiration rate, and body temperature.  Utilizes novel sensor technology and low-power communication protocols for long-term patient monitoring.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless physiological monitoring system comprising...\",\n        \"A method for continuous monitoring of vital signs...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67281", "text": "{\n    \"patent_title\": \"Improved Insulin Delivery Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-12-01\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved insulin delivery device with enhanced accuracy and user interface. Incorporates a feedback loop to adjust insulin dosage based on blood glucose levels.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"An insulin delivery device comprising...\",\n        \"A method for controlling insulin dosage...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67282", "text": "{\n    \"patent_title\": \"Miniaturized Robotic System for Minimally Invasive Cardiac Surgery\",\n    \"inventors\": [\n        {\n            \"name\": \"David Gracias\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jennifer Wong\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-05-15\",\n    \"filing_date\": \"2020-05-15\",\n    \"issue_date\": \"2022-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized robotic system designed for performing minimally invasive cardiac surgery. The system utilizes micro-robots navigated through the vasculature to access and repair cardiac tissue.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic system comprising a plurality of micro-robots...\",\n        \"A method for performing cardiac surgery using the robotic system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67282", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Angiography\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2021-11-01\",\n    \"filing_date\": \"2021-11-01\",\n    \"issue_date\": \"2023-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design for performing angiography procedures. The catheter features enhanced flexibility and biocompatibility.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible shaft...\",\n        \"A method for performing angiography using the catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67283", "text": "{\n    \"patent_title\": \"Deep Convolutional Neural Networks for Image Segmentation\",\n    \"inventors\": [\n        {\n            \"name\": \"Jonathan Long\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Evan Shelhamer\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Trevor Darrell\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9483025B2\",\n    \"priority_date\": \"2015-03-05\",\n    \"filing_date\": \"2015-03-05\",\n    \"issue_date\": \"2016-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A fully convolutional network is presented for semantic image segmentation. This network overcomes the limitations of traditional methods by performing pixel-wise classification, enabling efficient and accurate segmentation of images. The network employs upsampling techniques to produce segmentation maps of the original image resolution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8837043B2\",\n            \"title\": \"System and method for image segmentation\"\n        },\n        {\n            \"patent_number\": \"US9215567B2\",\n            \"title\": \"Method for segmenting an image\"\n        }\n    ],\n    \"claims\": [\n        \"A method for segmenting an image using a fully convolutional network.\",\n        \"A system for performing semantic image segmentation.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67283", "text": "{\n    \"patent_title\": \"Method for Displaying Images on a Screen\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"DisplayTech Inc.\"\n        }\n    ],\n    \"patent_number\": \"US8565123B1\",\n    \"priority_date\": \"2013-10-15\",\n    \"filing_date\": \"2013-10-15\",\n    \"issue_date\": \"2013-12-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and apparatus for displaying images on a screen with improved color accuracy and brightness. The system adjusts color parameters based on ambient lighting conditions to enhance the viewing experience.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Display device with enhanced color reproduction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for adjusting color parameters of a display device.\",\n        \"A display device configured to adjust color parameters.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67284", "text": "{\n    \"patent_title\": \"Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-15\",\n    \"filing_date\": \"2015-03-10\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable biosensor for continuous glucose monitoring, utilizing a novel enzymatic reaction and wireless data transmission to improve diabetes management and patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A biosensor comprising...\",\n        \"A method for continuous glucose monitoring...\",\n        \"A wireless communication system for...\",\n        \"An implantable device...\",\n        \"A system for alerting patients...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67284", "text": "{\n    \"patent_title\": \"Improved Cat Litter Box Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Independent Inventor\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2017-05-01\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new design for a cat litter box, featuring an automatic cleaning mechanism and improved odor control.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A cat litter box comprising...\",\n        \"An automatic cleaning mechanism...\",\n        \"A filter for odor control...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67285", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Sensor for Continuous Physiological Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"David A. Lewis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Maria Gutierrez\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-11-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized, wireless sensor system for continuous monitoring of vital signs, enabling remote patient care and early detection of health anomalies. The sensor transmits data via Bluetooth to a mobile device for real-time analysis and alerts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in wireless sensor technology.\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor device comprising a biocompatible housing and a plurality of sensors for measuring physiological parameters.\",\n        \"The device of claim 1, wherein the physiological parameters include heart rate, body temperature, and blood oxygen saturation.\",\n        \"A communication module for transmitting data from the sensor device to a remote monitoring station.\",\n        \"A method for continuously monitoring a patient's vital signs using the wireless sensor device.\",\n        \"The method of claim 4, further comprising analyzing the data to detect anomalies and generate alerts.\",\n        \"The device of claim 1, comprising a battery life of at least 7 days.\",\n        \"The device of claim 1, having a size less than 2 cubic centimeters.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67285", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Cardiovascular Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2024-01-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel catheter design with enhanced maneuverability and reduced risk of vascular complications during cardiovascular procedures.  The catheter features a flexible tip and a lubricious coating.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related art in catheter design.\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible shaft and a distal tip.\",\n        \"The catheter of claim 1, wherein the distal tip is tapered.\",\n        \"A lubricious coating applied to the surface of the catheter.\",\n        \"A method for performing cardiovascular procedures using the catheter.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67286", "text": "{\n    \"patent_title\": \"Improved Image Restoration Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep learning approach for restoring degraded images. This invention utilizes convolutional neural networks to remove noise and artifacts, resulting in significantly improved image quality and visual clarity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for restoring an image comprising...\",\n        \"A system for improving image quality...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67286", "text": "{\n    \"patent_title\": \"Novel Data Compression Algorithm for Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"David A. Huffman\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2019-11-20\",\n    \"filing_date\": \"2019-11-20\",\n    \"issue_date\": \"2022-09-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new data compression algorithm designed for efficient storage and transmission of medical imaging data. The invention focuses on reducing file size without significant loss of information.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing medical image data...\",\n        \"A system for reducing storage requirements...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67287", "text": "{\n    \"patent_title\": \"Deep Learning for Enhanced Medical Image Segmentation\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2021-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention utilizes a novel deep learning architecture for significantly improving the accuracy and efficiency of medical image segmentation, enabling more precise diagnoses and treatment planning.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Convolutional Neural Networks for Image Recognition\"\n        }\n    ],\n    \"claims\": [\n        \"A method for segmenting medical images using a deep convolutional neural network.\",\n        \"A system for automated detection of anomalies in medical images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67287", "text": "{\n    \"patent_title\": \"Improved Color Correction Algorithm for Digital Cameras\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Kodak\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2018-11-01\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new algorithm for color correction in digital cameras, leading to more accurate and vibrant image reproduction.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Automatic White Balance Control\"\n        }\n    ],\n    \"claims\": [\n        \"A method for adjusting the color balance of a digital image.\",\n        \"A digital camera incorporating the improved color correction algorithm.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67288", "text": "{\n    \"patent_title\": \"Method and System for Enhanced MRI Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing high-resolution MRI images with reduced scan time and improved clarity, enabling earlier and more accurate diagnosis of various medical conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67288", "text": "{\n    \"patent_title\": \"Improved CT Scanner Cooling System\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10246813B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-15\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved cooling system for CT scanners designed to reduce heat buildup and increase operational lifespan. The system utilizes a novel heat pipe design.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A cooling system for a CT scanner comprising...\",\n        \"A heat pipe assembly for dissipating heat...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67289", "text": "{\n    \"patent_title\": \"Method and System for Enhanced MRI Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for reconstructing magnetic resonance images (MRI) with improved resolution and reduced scan time. The invention utilizes a deep learning algorithm to enhance image quality and reduce artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"count\": 15\n        },\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"count\": 5\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67289", "text": "{\n    \"patent_title\": \"Improved X-Ray Shielding for Dental Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Davis\",\n            \"affiliation\": \"Dental Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2014-12-10\",\n    \"filing_date\": \"2014-12-10\",\n    \"issue_date\": \"2017-09-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved shielding device for use during dental X-ray procedures. The device utilizes a novel lead composite material to reduce radiation exposure to patients and operators.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"count\": 3\n        }\n    ],\n    \"claims\": [\n        \"A shielding device for dental X-ray procedures comprising...\",\n        \"A method for reducing radiation exposure...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67290", "text": "{\n    \"patent_title\": \"MRI-Based System for Early Detection of Alzheimer's Disease\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-03-26\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A novel magnetic resonance imaging (MRI) technique is disclosed for early detection of amyloid plaques in the brain, indicative of Alzheimer's disease. The system utilizes advanced image processing algorithms to enhance contrast and improve diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art relating to MRI image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting amyloid plaques in a patient using MRI.\",\n        \"An MRI system configured to generate images suitable for Alzheimer's disease diagnosis.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67290", "text": "{\n    \"patent_title\": \"Improved X-Ray Imaging for Fracture Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Franz Schmidt\",\n            \"affiliation\": \"University Hospital Heidelberg\"\n        }\n    ],\n    \"patent_number\": \"EP3456789A1\",\n    \"priority_date\": \"2015-11-20\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2018-07-18\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"This invention relates to a new X-ray imaging system offering enhanced resolution and reduced radiation dose for more accurate fracture detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related X-ray technology.\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging apparatus with improved resolution.\",\n        \"A method for reducing radiation exposure during X-ray imaging.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67291", "text": "{\n    \"patent_title\": \"Enhanced Magnetic Resonance Imaging for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method for enhancing the resolution of magnetic resonance images, enabling earlier and more accurate detection of cancerous tumors. A novel image processing algorithm is used to reduce noise and improve contrast.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI image resolution comprising...\",\n        \"An MRI system configured to implement the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67291", "text": "{\n    \"patent_title\": \"Improved X-ray Tube Design for Industrial Radiography\",\n    \"inventors\": [\n        {\n            \"name\": \"John Davis\",\n            \"affiliation\": \"General Electric\"\n        },\n        {\n            \"name\": \"Sarah Williams\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-09-10\",\n    \"filing_date\": \"2017-09-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved X-ray tube designed for high-throughput industrial radiography. The tube features a novel filament design and cooling system to enhance its lifespan and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube comprising a novel filament design...\",\n        \"A radiography system incorporating the improved X-ray tube...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67292", "text": "{\n    \"patent_title\": \"Novel MRI Contrast Agent for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Chen\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10456789B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-02-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel MRI contrast agent utilizing nanoscale particles for enhanced detection of early-stage cancerous tumors, addressing a critical need for improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on MRI contrast agents.\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising nanoscale particles...\",\n        \"A method for detecting cancer using said contrast agent...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67292", "text": "{\n    \"patent_title\": \"Improved X-Ray Image Processing Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"Dr. Ben Harris\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2017-08-20\",\n    \"filing_date\": \"2017-08-20\",\n    \"issue_date\": \"2020-05-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An enhanced algorithm for processing X-ray images to improve clarity and reduce noise, resulting in better image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related algorithm for noise reduction.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing X-ray images...\",\n        \"A system for displaying processed X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67293", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Enhancement for Low-Light Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-04-20\",\n    \"issue_date\": \"2023-11-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for enhancing images captured in low-light conditions. The system utilizes a generative adversarial network to produce high-quality, visually appealing images with improved detail and reduced noise. This represents a significant advancement in image processing capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image denoising\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing low-light images using a deep learning model.\",\n        \"A system comprising a generative adversarial network configured to improve image quality.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67293", "text": "{\n    \"patent_title\": \"Method for Color Correction in Digital Photographs\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Eastman Kodak\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2019-12-10\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2022-05-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for automatically correcting color imbalances in digital photographs. The system employs a histogram equalization technique to enhance image contrast and saturation. This is an incremental improvement to existing color correction algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Previous work on histogram equalization\"\n        }\n    ],\n    \"claims\": [\n        \"A method for color correction using histogram equalization.\",\n        \"A digital camera comprising a color correction module.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67294", "text": "{\n    \"patent_title\": \"Low-Light Image Enhancement Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-06-20\",\n    \"issue_date\": \"2012-11-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel deep learning approach to enhance the quality of images captured in low-light environments. The method utilizes convolutional neural networks to effectively reduce noise and improve visibility.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing low-light images comprising...\",\n        \"A system for processing images captured under low illumination...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67294", "text": "{\n    \"patent_title\": \"Method for Compressing Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Siemens AG\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2009-12-01\",\n    \"filing_date\": \"2010-05-10\",\n    \"issue_date\": \"2011-09-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method for lossless compression of medical imaging data, reducing storage requirements and transmission bandwidth.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US89101122B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing medical images comprising...\",\n        \"A system for encoding and decoding medical image data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67295", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Cardiac Monitor with Wireless Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"David Alt\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Sarah Chen\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2021-12-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable cardiac monitor for long-term monitoring of cardiac function with wireless data transmission to a remote monitoring station. The device addresses the need for continuous and non-invasive cardiac monitoring.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in implantable cardiac devices.\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable cardiac monitor...\",\n        \"A system for wireless data transmission...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67295", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Peripheral Angioplasty\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Emily Brown\",\n            \"affiliation\": \"Boston University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2017-08-10\",\n    \"filing_date\": \"2018-08-10\",\n    \"issue_date\": \"2020-04-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design for peripheral angioplasty procedures, offering enhanced maneuverability and reduced risk of vessel damage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art in catheter design.\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter with improved maneuverability...\",\n        \"A method for performing peripheral angioplasty...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67296", "text": "{\n    \"patent_title\": \"Novel MRI Reconstruction Technique for Enhanced Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Chen\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-09-20\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel magnetic resonance imaging (MRI) reconstruction technique utilizing deep learning algorithms to significantly improve the detection of small tumors, particularly in the early stages of cancer development.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8542678B2\",\n            \"relevance\": \"Prior art in MRI reconstruction.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for detecting tumors using reconstructed MRI images...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67296", "text": "{\n    \"patent_title\": \"Improved X-Ray Shielding Material\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US8234567B1\",\n    \"priority_date\": \"2014-11-01\",\n    \"filing_date\": \"2015-05-10\",\n    \"issue_date\": \"2017-12-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new material composition for X-ray shielding, offering enhanced protection against radiation exposure during medical imaging procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"relevance\": \"Previous X-ray shielding materials.\"\n        }\n    ],\n    \"claims\": [\n        \"A shielding material comprising...\",\n        \"A method of manufacturing a shielding device...\",\n        \"An X-ray imaging system utilizing said shielding material...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67297", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Patient Comfort\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10555555B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system utilizing flexible robotics and real-time imaging feedback to enhance surgical precision and significantly improve patient comfort during procedures. The system reduces incision size and post-operative recovery time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9888888B2\",\n            \"type\": \"Related\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising...\",\n        \"A method for performing minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67297", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Portable Medical Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11222222B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2021-07-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved lithium-ion battery technology designed to provide extended runtime and enhanced safety for portable medical devices. The battery incorporates a novel electrolyte composition and a reinforced casing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10111111B2\",\n            \"type\": \"Cited by\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"A portable medical device powered by said battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67298", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing medical images from raw data, utilizing advanced filtering techniques to significantly improve image clarity and reduce noise. This is applicable to MRI, CT, and PET scans.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Filtering Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"The method of claim 1, wherein the filtering technique...\",\n        \"A system for performing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67298", "text": "{\n    \"patent_title\": \"Digital Image Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-10\",\n    \"issue_date\": \"2021-09-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new method for compressing digital images using wavelet transforms. This method significantly reduces file size while maintaining acceptable image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Wavelet Transform for Image Compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a digital image...\",\n        \"The method of claim 1, wherein the wavelet transform...\",\n        \"A system for performing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67299", "text": "{\n    \"patent_title\": \"Surgical Robotic System with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2019-03-20\",\n    \"issue_date\": \"2021-07-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A robotic surgical system designed for increased precision in minimally invasive procedures. The system uses advanced imaging and haptic feedback to improve surgical outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system comprising...\",\n        \"A method for performing minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67299", "text": "{\n    \"patent_title\": \"Novel Stent Design for Vascular Repair\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Ramirez\",\n            \"affiliation\": \"University of Barcelona\"\n        }\n    ],\n    \"patent_number\": \"EP3876543B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-04-03\",\n    \"issue_date\": \"2022-02-15\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"A new stent design offering improved flexibility and biocompatibility for vascular applications. The stent utilizes a novel alloy composition to reduce inflammation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\"\n        }\n    ],\n    \"claims\": [\n        \"A stent comprising a novel alloy...\",\n        \"A method for deploying a stent in a vascular lumen...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67300", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for reconstructing high-quality images from degraded or incomplete data using deep convolutional neural networks. The system optimizes image reconstruction through iterative refinement and incorporates a novel loss function to enhance details and reduce artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10234567B1\",\n            \"count\": 55\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"count\": 42\n        },\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"count\": 38\n        }\n    ],\n    \"claims\": [\n        \"A method for image reconstruction comprising:...\",\n        \"A system for image reconstruction comprising:...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67300", "text": "{\n    \"patent_title\": \"Improved Algorithm for Basic Image Filtering\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"SmallTech Inc.\"\n        }\n    ],\n    \"patent_number\": \"US8654321B1\",\n    \"priority_date\": \"2016-05-20\",\n    \"filing_date\": \"2016-05-20\",\n    \"issue_date\": \"2018-01-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An algorithm for applying a series of basic filters to digital images, including blurring, sharpening, and edge detection. The algorithm is optimized for speed and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7543210B2\",\n            \"count\": 3\n        },\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"count\": 2\n        }\n    ],\n    \"claims\": [\n        \"A method for applying image filters comprising...\",\n        \"A digital image processing system comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67301", "text": "{\n    \"patent_title\": \"Implantable Cardiac Monitor with Enhanced Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Medtronic Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-11-01\",\n    \"issue_date\": \"2022-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac monitor with a novel data compression algorithm to extend battery life and improve data transmission rates. The device offers enhanced diagnostics for patients with arrhythmia.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in implantable devices\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing ECG data in an implantable cardiac monitor.\",\n        \"An implantable cardiac monitor comprising a data compression module.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67301", "text": "{\n    \"patent_title\": \"Surgical Instrument for Orthopedic Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Johnson & Johnson\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2022-01-20\",\n    \"filing_date\": \"2022-07-15\",\n    \"issue_date\": \"2023-04-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical instrument designed to improve precision during orthopedic bone cutting. It features a unique blade stabilization system.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related prior art in surgical instruments\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument with a blade stabilization system.\",\n        \"A method for using the surgical instrument during bone cutting.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67302", "text": "{\n    \"patent_title\": \"Enhanced Contrast Agent for Magnetic Resonance Angiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2021-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel contrast agent for magnetic resonance angiography (MRA) providing significantly improved image clarity and enabling detection of smaller vascular anomalies. The agent utilizes a targeted nanoparticle formulation that enhances signal-to-noise ratio and reduces background noise, leading to more accurate diagnostic assessments.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent for magnetic resonance angiography comprising...\",\n        \"A method for imaging blood vessels...\",\n        \"A system for enhanced MRA imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67302", "text": "{\n    \"patent_title\": \"Improved Calibration Method for CT Scanners\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-03-10\",\n    \"filing_date\": \"2019-03-10\",\n    \"issue_date\": \"2020-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for calibrating computed tomography (CT) scanners to reduce image artifacts and improve image quality. The method utilizes a new algorithm for correcting geometric distortions and reducing noise levels.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for calibrating a CT scanner comprising...\",\n        \"A system for automated CT scanner calibration...\",\n        \"A computer-readable medium storing instructions for...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67303", "text": "{\n    \"patent_title\": \"Enhanced Image Sharpening Using Deep Convolutional Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel deep learning architecture for image sharpening. By utilizing a convolutional neural network with attention mechanisms, the system significantly improves visual clarity and detail in low-resolution images, overcoming limitations of traditional sharpening techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for sharpening an image comprising:...\",\n        \"The method of claim 1, wherein the convolutional neural network...\",\n        \"An apparatus for sharpening an image...\",\n        \"The apparatus of claim 3, further comprising...\",\n        \"A system for enhancing image quality...\",\n        \"The system of claim 5, wherein the attention mechanism...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67303", "text": "{\n    \"patent_title\": \"Method for Compressing Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Mayo Clinic\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-08-01\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2021-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new method for compressing medical images using wavelet transforms and entropy encoding. This invention reduces storage requirements for large medical datasets without significant loss of diagnostic information.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a medical image comprising:...\",\n        \"The method of claim 1, wherein the wavelet transform...\",\n        \"An apparatus for compressing a medical image...\",\n        \"The apparatus of claim 3, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67304", "text": "{\n    \"patent_title\": \"Magnetic Resonance Fingerprinting for Rapid Disease Characterization\",\n    \"inventors\": [\n        {\n            \"name\": \"David Feinberg\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jiang Du\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876452B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A magnetic resonance imaging (MRI) method and system for rapid disease characterization using magnetic resonance fingerprinting (MRF). The method provides quantitative tissue characterization without requiring explicit knowledge of relaxation parameters.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8569846B2\",\n            \"relevance\": \"Prior art in MRF techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for characterizing tissue using MRF comprising...\",\n        \"An MRI system configured to perform MRF...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67304", "text": "{\n    \"patent_title\": \"Drug Delivery System Utilizing Targeted Nanoparticles\",\n    \"inventors\": [\n        {\n            \"name\": \"Maria Garcia\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Ahmed Khalil\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10233578B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A drug delivery system utilizing targeted nanoparticles for localized cancer therapy. The nanoparticles encapsulate chemotherapeutic agents and are designed to selectively target cancer cells.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9126987B2\",\n            \"relevance\": \"Prior art in nanoparticle drug delivery\"\n        }\n    ],\n    \"claims\": [\n        \"A nanoparticle comprising a chemotherapeutic agent...\",\n        \"A method of treating cancer comprising administering the nanoparticle...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67305", "text": "{\n    \"patent_title\": \"AI-Enhanced Magnetic Resonance Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2021-01-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for reconstructing magnetic resonance images using deep learning techniques. The method significantly improves image clarity and reduces scan time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Prior Art MRI Reconstruction Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI reconstruction using a neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67305", "text": "{\n    \"patent_title\": \"Improved X-ray Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"GE Healthcare\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-03-10\",\n    \"filing_date\": \"2018-03-10\",\n    \"issue_date\": \"2020-07-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved x-ray imaging system with enhanced radiation shielding and dose reduction capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Conventional X-ray System\"\n        }\n    ],\n    \"claims\": [\n        \"An x-ray imaging system comprising...\",\n        \"A radiation shielding mechanism for an x-ray system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67306", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Segmentation using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for accurate image segmentation utilizing deep convolutional neural networks. The system improves upon existing techniques by incorporating attention mechanisms and a novel loss function, resulting in enhanced performance and robustness.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"count\": 150\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"count\": 120\n        }\n    ],\n    \"claims\": [\n        \"A method for segmenting an image comprising...\",\n        \"A system for image segmentation comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67306", "text": "{\n    \"patent_title\": \"Image Compression Technique Using Discrete Cosine Transform\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US7654321B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2018-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A technique for compressing images using the Discrete Cosine Transform (DCT). The method reduces image file size while maintaining acceptable image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B2\",\n            \"count\": 20\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image comprising...\",\n        \"An apparatus for image compression...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67307", "text": "{\n    \"patent_title\": \"Method and System for Early Cancer Detection using Enhanced MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for enhancing Magnetic Resonance Imaging (MRI) to improve the early detection of cancerous tumors. The method utilizes advanced image processing techniques and contrast agents to highlight subtle changes indicative of early-stage cancer.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in MRI image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI images for cancer detection...\",\n        \"A system comprising a MRI scanner and a processing unit configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67307", "text": "{\n    \"patent_title\": \"Improved Ultrasound Imaging for Cardiovascular Diagnostics\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Philips Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved ultrasound imaging system for diagnosing cardiovascular diseases. This system uses beamforming techniques to generate high-resolution images of the heart and blood vessels.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related to ultrasound technology\"\n        }\n    ],\n    \"claims\": [\n        \"An ultrasound system with enhanced beamforming capabilities...\",\n        \"A method for generating high-resolution cardiovascular images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67308", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Segmentation using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-04-20\",\n    \"issue_date\": \"2022-09-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for accurate image segmentation using a deep convolutional neural network. This addresses the challenge of effectively identifying objects and boundaries within complex visual data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image segmentation comprising...\",\n        \"A system for implementing the image segmentation method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67308", "text": "{\n    \"patent_title\": \"System for Data Compression using Wavelet Transforms\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-12-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for efficiently compressing digital data using wavelet transform techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression using wavelet transforms...\",\n        \"A system for implementing the data compression method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67309", "text": "{\n    \"patent_title\": \"Improved Image Enhancement Using Adaptive Histogram Equalization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents an improved adaptive histogram equalization technique for enhancing the contrast of images. It builds upon existing methods to provide more visually appealing and informative results.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image contrast comprising...\",\n        \"An image processing system configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67309", "text": "{\n    \"patent_title\": \"Novel Neural Network Architecture for Image Generation\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2021-01-20\",\n    \"filing_date\": \"2021-01-20\",\n    \"issue_date\": \"2023-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel neural network architecture capable of generating high-resolution images from text descriptions. It represents a fundamental shift in image generation techniques.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A neural network comprising...\",\n        \"A method for generating images using a neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67310", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Enhancement for Low-Light Photography\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for enhancing images captured in low-light conditions using a deep convolutional neural network. The method addresses the challenges of noise reduction and detail preservation in low-light images, resulting in significantly improved image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in image denoising\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing a low-light image comprising...\",\n        \"A system for processing images with reduced noise...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67310", "text": "{\n    \"patent_title\": \"Improved Color Correction Algorithm for Digital Cameras\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Sony Corporation\"\n        }\n    ],\n    \"patent_number\": \"US9123456B2\",\n    \"priority_date\": \"2016-11-10\",\n    \"filing_date\": \"2016-11-10\",\n    \"issue_date\": \"2018-08-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved color correction algorithm for digital cameras that provides more accurate and vibrant color reproduction. The algorithm builds upon existing color correction techniques by incorporating a novel weighting scheme.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Existing color correction techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for color correcting a digital image comprising...\",\n        \"A digital camera utilizing a color correction algorithm...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67311", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Cardiac Monitor with Enhanced Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MedTech Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-11-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable cardiac monitor is disclosed, featuring advanced data transmission capabilities for real-time remote monitoring of cardiac function.  The device improves patient outcomes by enabling earlier detection of arrhythmias and prompt intervention.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable cardiac monitor comprising...\",\n        \"A method for remotely monitoring cardiac function using said monitor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67311", "text": "{\n    \"patent_title\": \"Surgical Instrument Sterilization System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Hospital Equipment Corp.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-12-10\",\n    \"filing_date\": \"2019-10-05\",\n    \"issue_date\": \"2020-08-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for sterilizing surgical instruments using a novel plasma technology is disclosed. The system provides efficient and reliable sterilization, reducing the risk of infection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A sterilization system comprising...\",\n        \"A method for sterilizing surgical instruments...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67312", "text": "{\n    \"patent_title\": \"AI-Powered Diagnostic System for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-11-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel artificial intelligence system utilizing deep learning algorithms for the early detection of cancerous tumors in medical imaging. The system demonstrates significantly improved accuracy and sensitivity compared to existing methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"title\": \"Medical Image Analysis using Convolutional Neural Networks\"\n        },\n        {\n            \"patent_number\": \"US1012345678B2\",\n            \"title\": \"AI-Assisted Diagnosis of Cardiovascular Diseases\"\n        },\n        {\n            \"patent_number\": \"US1122334455B2\",\n            \"title\": \"Automated Tumor Segmentation in CT Scans\"\n        },\n        {\n            \"patent_number\": \"US1211223344B2\",\n            \"title\": \"Deep Learning for Retinal Disease Detection\"\n        },\n        {\n            \"patent_number\": \"US1313131313B2\",\n            \"title\": \"Machine Learning Based Prediction of Patient Outcomes\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancerous tumors...\",\n        \"A system comprising a deep learning model...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67312", "text": "{\n    \"patent_title\": \"Improved Method for Storing Medical Records\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"HealthTech Solutions Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2018-09-01\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2021-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for securely storing and retrieving electronic medical records using a blockchain technology. This ensures data integrity and patient privacy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Secure Data Storage Using Blockchain\"\n        },\n        {\n            \"patent_number\": \"US91234567B2\",\n            \"title\": \"Electronic Health Record System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for securely storing medical records...\",\n        \"A blockchain-based system for data integrity...\",\n        \"A computer-readable medium implementing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67313", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for automatically identifying and classifying anomalies in medical images, utilizing deep learning techniques. The system improves diagnostic accuracy and reduces radiologist workload.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8543210B2\",\n            \"relevance\": \"Prior art in image segmentation\"\n        }\n    ],\n    \"claims\": [\n        \"A method for analyzing a medical image comprising...\",\n        \"A system for identifying anomalies in a medical image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67313", "text": "{\n    \"patent_title\": \"Digital Image Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-09-01\",\n    \"filing_date\": \"2017-09-01\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel algorithm for compressing digital images, achieving high compression ratios with minimal loss of image quality. This is useful for transmission and storage of digital images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"relevance\": \"Related to wavelet compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a digital image comprising...\",\n        \"An apparatus for implementing the compression method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67314", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the resolution of images using deep convolutional neural networks. The system learns to map low-resolution images to high-resolution counterparts, improving visual clarity and detail.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Super-Resolution Using Sparse Representation\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising:...\",\n        \"A system for enhancing image resolution comprising:...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67314", "text": "{\n    \"patent_title\": \"Simple Image Filtering Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Independent Researcher\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-15\",\n    \"issue_date\": \"2020-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A simple image filtering technique to reduce noise in images.\",\n    \"citations\": [],\n    \"claims\": [\n        \"An image filtering method comprising:...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67315", "text": "{\n    \"patent_title\": \"Improved MRI Image Reconstruction for Enhanced Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing MRI images, resulting in improved clarity and enhanced detection of small tumors. The method utilizes a deep learning algorithm trained on a large dataset of MRI scans.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"An MRI apparatus configured to implement the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67315", "text": "{\n    \"patent_title\": \"Portable X-Ray Device for Veterinary Use\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Carol Davis\",\n            \"affiliation\": \"Animal Imaging Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-19\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A compact and portable X-ray device designed for veterinary diagnostic imaging. The device is lightweight and can be easily transported to remote locations.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A portable X-ray device comprising...\",\n        \"A method for performing veterinary X-ray imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67316", "text": "{\n    \"patent_title\": \"Enhanced Resolution Medical Imaging Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-06-20\",\n    \"issue_date\": \"2022-12-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel deep learning architecture for enhancing the resolution and clarity of medical images, leading to improved diagnostic accuracy. The system utilizes convolutional neural networks trained on a large dataset of medical scans to reduce noise and artifacts, providing clinicians with more detailed images for analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image processing.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing the resolution of a medical image comprising...\",\n        \"A system for processing medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67316", "text": "{\n    \"patent_title\": \"Automated Surgical Instrument Tracking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"General Electric\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Medtronic\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-08-12\",\n    \"issue_date\": \"2023-04-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system for accurately tracking the position and orientation of surgical instruments during a medical procedure. The system utilizes a combination of optical sensors and machine learning algorithms to provide real-time feedback to the surgeon.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related technology in robotics.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument tracking system comprising...\",\n        \"A method for determining the position of a surgical instrument...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67317", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-03-15\",\n    \"filing_date\": \"2015-05-20\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for reconstructing medical images with improved clarity and reduced noise. The invention utilizes a deep learning algorithm to enhance image quality, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"title\": \"Prior Art Medical Imaging System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for enhancing image clarity...\",\n        \"The method of claim 1, wherein the deep learning algorithm...\",\n        \"The system of claim 2, further comprising...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67317", "text": "{\n    \"patent_title\": \"Portable X-Ray Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"SmallTech Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2017-03-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A compact and portable X-ray device for field use. The device features a lightweight design and improved power efficiency.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A portable X-ray device comprising...\",\n        \"The device of claim 1, wherein the device is battery powered...\",\n        \"A housing for containing the X-ray source...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67318", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system comprising a small diameter endoscope with enhanced imaging capabilities and robotic surgical tools designed for precise tissue manipulation. This system improves surgical precision and reduces patient recovery time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8545321B2\",\n            \"relevance\": \"Prior art in endoscopic visualization\"\n        }\n    ],\n    \"claims\": [\n        \"A minimally invasive surgical system comprising...\",\n        \"An endoscope with enhanced imaging capabilities...\",\n        \"Robotic surgical tools for precise tissue manipulation...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67318", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-15\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel catheter design for improved drug delivery to peripheral vessels. The catheter features a modified tip geometry to minimize vessel trauma during insertion.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Previous catheter designs\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a modified tip geometry...\",\n        \"A drug delivery system for peripheral vessels...\",\n        \"A method for minimizing vessel trauma...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67319", "text": "{\n    \"patent_title\": \"Noise Reduction Method for Digital Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-15\",\n    \"filing_date\": \"2015-03-20\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reducing noise in digital images using a wavelet transform and adaptive filtering. The method effectively removes noise while preserving image details, resulting in improved image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"title\": \"Image Filtering Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing noise in a digital image comprising...\",\n        \"An apparatus for reducing noise in a digital image...\",\n        \"A digital image with reduced noise...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67319", "text": "{\n    \"patent_title\": \"Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-01-10\",\n    \"filing_date\": \"2016-04-05\",\n    \"issue_date\": \"2020-02-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new data compression algorithm based on Huffman coding. The algorithm efficiently compresses data while maintaining a high level of fidelity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Efficient Data Encoding\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data comprising...\",\n        \"An apparatus for compressing data...\",\n        \"Compressed data resulting from the method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67320", "text": "{\n    \"patent_title\": \"Low-Light Image Enhancement Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Li Wei\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Chen Zhang\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-11-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-01-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning approach for enhancing the visibility and quality of images captured in low-light conditions. The method utilizes a convolutional neural network trained on a large dataset of low-light and normal-light image pairs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image denoising.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing a low-light image comprising:...\",\n        \"A system for processing images in low-light environments...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67320", "text": "{\n    \"patent_title\": \"Method for Compressing High-Resolution Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-08-20\",\n    \"filing_date\": \"2019-12-05\",\n    \"issue_date\": \"2020-06-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new method for efficiently compressing high-resolution medical images, reducing storage requirements and transmission bandwidth. This technique employs wavelet transforms and quantization.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous compression algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a medical image comprising...\",\n        \"A system for storing and transmitting medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67321", "text": "{\n    \"patent_title\": \"Improved Medical Image Reconstruction Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing medical images from raw data, resulting in improved image quality and reduced scan time. This invention aims to enhance the detection of subtle anomalies for early diagnostics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"An apparatus for performing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67321", "text": "{\n    \"patent_title\": \"New Display Technology for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Samsung Electronics\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved display technology for mobile devices, providing higher resolution and better color accuracy. This invention significantly enhances the user experience of smartphones and tablets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A display panel comprising...\",\n        \"A mobile device incorporating the display panel of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67322", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Research\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing image resolution using deep convolutional neural networks. The system utilizes a novel network architecture to reconstruct high-resolution images from low-resolution inputs, achieving state-of-the-art performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in super-resolution imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising...\",\n        \"A system for enhancing image resolution comprising...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The method of claim 1, wherein the deep convolutional neural network...\",\n        \"The system of claim 2, wherein the network architecture...\",\n        \"The method of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67322", "text": "{\n    \"patent_title\": \"Image Compression Technique Using Discrete Cosine Transform\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2014-12-10\",\n    \"filing_date\": \"2014-12-10\",\n    \"issue_date\": \"2017-05-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An image compression technique utilizing the Discrete Cosine Transform (DCT). This method provides efficient compression ratios for various image formats.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210A\",\n            \"relevance\": \"Related to DCT-based compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image comprising...\",\n        \"A system for compressing an image comprising...\",\n        \"The method of claim 1, wherein the DCT is applied...\",\n        \"The system of claim 2, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67323", "text": "{\n    \"patent_title\": \"Adaptive Noise Reduction in Digital Images Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-06-20\",\n    \"issue_date\": \"2022-12-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for reducing noise in digital images using a deep convolutional neural network. The network is trained to identify and remove noise while preserving important image details, resulting in improved image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Denoising Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing noise in a digital image comprising...\",\n        \"A system for reducing noise in a digital image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67323", "text": "{\n    \"patent_title\": \"Method for Rotating Images in a Digital Display\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corp\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2021-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for rotating a digital image 90, 180, or 270 degrees within a digital display.  This provides a simple user interface for image orientation.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for rotating an image...\",\n        \"A system for displaying a rotated image...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67324", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction with Reduced Radiation Dose\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method and system for reconstructing medical images from limited data, resulting in a significant reduction in radiation dose while maintaining or improving image quality. The method employs advanced iterative reconstruction algorithms and regularization techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Prior Art Imaging System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for performing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67324", "text": "{\n    \"patent_title\": \"Improved Design for MRI Coil Cooling System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2014-11-01\",\n    \"filing_date\": \"2014-11-01\",\n    \"issue_date\": \"2017-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved cooling system for MRI coils, increasing the lifespan and stability of the coils during prolonged use. It involves a novel fluid dynamic design and heat dissipation mechanism.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"MRI Coil Design\"\n        }\n    ],\n    \"claims\": [\n        \"A cooling system for an MRI coil comprising...\",\n        \"The cooling system of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67325", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Point-of-Care Sepsis Diagnosis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-11-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for rapid and accurate detection of sepsis biomarkers in whole blood. The device utilizes a novel antibody-based assay and provides results within 5 minutes, enabling faster diagnosis and treatment initiation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for detecting sepsis biomarkers...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67325", "text": "{\n    \"patent_title\": \"Improved Surgical Stapler Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2021-02-01\",\n    \"filing_date\": \"2021-08-15\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler design featuring enhanced ergonomics and staple deployment reliability. The stapler provides surgeons with greater control and precision during surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"A staple cartridge for use with the surgical stapler...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67326", "text": "{\n    \"patent_title\": \"Microfluidic Device for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"David Baker\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for isolating and analyzing circulating tumor cells (CTCs) from blood samples, enabling early cancer detection and personalized treatment strategies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for isolating CTCs...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67326", "text": "{\n    \"patent_title\": \"Improved Surgical Stapler Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emily Chen\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-08-10\",\n    \"filing_date\": \"2021-08-10\",\n    \"issue_date\": \"2024-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler featuring a more ergonomic handle and enhanced staple deployment mechanism.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"A handle designed for enhanced grip...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67327", "text": "{\n    \"patent_title\": \"Wearable Sensor System for Continuous Physiological Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2020-10-15\",\n    \"filing_date\": \"2021-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wearable sensor system for continuous monitoring of vital signs, including heart rate, blood pressure, and oxygen saturation. The system utilizes a wireless communication module to transmit data to a remote monitoring station, enabling real-time patient monitoring and early detection of health anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Remote Health Monitoring Device\"\n        }\n    ],\n    \"claims\": [\n        \"A wearable sensor system comprising...\",\n        \"A method for remotely monitoring a patient's vital signs...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67327", "text": "{\n    \"patent_title\": \"Surgical Instrument with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2021-03-01\",\n    \"filing_date\": \"2022-09-15\",\n    \"issue_date\": \"2023-05-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical instrument designed to provide enhanced precision during minimally invasive procedures. The instrument incorporates a robotic control system and advanced imaging technology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Robotic Surgical System\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising...\",\n        \"A method for performing minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67328", "text": "{\n    \"patent_title\": \"Method and System for Adaptive Image Sharpening\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for adaptively sharpening images by analyzing image gradients and applying a dynamic sharpening filter. This improves image clarity and detail while minimizing artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B1\",\n            \"title\": \"Image Enhancement Using Wavelet Transforms\"\n        }\n    ],\n    \"claims\": [\n        \"A method for adaptively sharpening an image...\",\n        \"A system comprising a processor and memory...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67328", "text": "{\n    \"patent_title\": \"Generative Adversarial Network for Realistic Image Synthesis\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2018-08-01\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2021-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A generative adversarial network (GAN) for creating photorealistic images from random noise. This invention utilizes deep learning to generate entirely new images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US1011121314B2\",\n            \"title\": \"Deep Convolutional Generative Adversarial Networks\"\n        }\n    ],\n    \"claims\": [\n        \"A generative adversarial network comprising...\",\n        \"A method for generating images using...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67329", "text": "{\n    \"patent_title\": \"Deep Learning for Enhanced Medical Image Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-06-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a deep learning system for analyzing medical images, specifically MRI and CT scans, to improve the accuracy of early disease detection. The system utilizes convolutional neural networks to identify subtle anomalies indicative of various medical conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for analyzing medical images using deep learning.\",\n        \"A system for detecting anomalies in MRI scans.\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67329", "text": "{\n    \"patent_title\": \"Improved Algorithm for Financial Fraud Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Bank of America\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"JP Morgan Chase\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2020-03-10\",\n    \"filing_date\": \"2020-04-10\",\n    \"issue_date\": \"2023-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a machine learning algorithm for detecting fraudulent transactions in financial systems. The system utilizes recurrent neural networks to identify suspicious patterns and prevent financial losses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in fraud detection\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting fraudulent transactions using machine learning.\",\n        \"A system for analyzing financial data in real-time.\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67330", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing medical images from raw data, improving image clarity and reducing noise. This system utilizes deep learning techniques to enhance image quality and provide more accurate diagnostic information.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"count\": 120\n        },\n        {\n            \"patent_number\": \"US9000123B2\",\n            \"count\": 85\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for processing medical image data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67330", "text": "{\n    \"patent_title\": \"Improved X-Ray Shielding Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new composite material for shielding against X-ray radiation, offering improved protection and reduced weight. The material utilizes a novel polymer matrix with embedded heavy metal nanoparticles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"count\": 15\n        },\n        {\n            \"patent_number\": \"US9234567B1\",\n            \"count\": 20\n        }\n    ],\n    \"claims\": [\n        \"A shielding material comprising...\",\n        \"A method for manufacturing a shielding material...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67331", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging Technique for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel magnetic resonance imaging (MRI) technique utilizing advanced pulse sequences and image reconstruction algorithms to enhance the detection of early-stage cancers. The method significantly improves image clarity and sensitivity, enabling the identification of tumors at a much earlier stage than conventional MRI, leading to improved patient outcomes. It demonstrates a significant leap in diagnostic capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"title\": \"MRI Pulse Sequence Optimization\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing cancer detection using MRI.\",\n        \"An MRI apparatus incorporating the novel pulse sequences.\",\n        \"A system for reconstructing images with improved clarity.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67331", "text": "{\n    \"patent_title\": \"Enhanced X-Ray Image Processing System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a system for improving the quality of X-ray images through digital processing techniques. The system utilizes advanced filtering algorithms to reduce noise and enhance contrast, resulting in clearer images. While providing an improvement over existing systems, it's an incremental enhancement rather than a fundamentally new approach.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Digital X-Ray Image Filtering\"\n        }\n    ],\n    \"claims\": [\n        \"A system for processing X-ray images.\",\n        \"A method for filtering noise in X-ray images.\",\n        \"A digital image processing apparatus.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67332", "text": "{\n    \"patent_title\": \"Improved MRI Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-09-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning approach for reconstructing Magnetic Resonance Images (MRI) with reduced scan time and improved image quality, leading to earlier and more accurate diagnosis of diseases.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"The method of claim 1, wherein the deep learning model is a convolutional neural network.\",\n        \"The method of claim 1, wherein the reconstructed image has a higher signal-to-noise ratio than a conventionally reconstructed image.\",\n        \"A system for performing MRI image reconstruction...\",\n        \"The system of claim 4, comprising a user interface for displaying the reconstructed image.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67332", "text": "{\n    \"patent_title\": \"System and Method for Enhanced X-ray Image Filtering\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2017-05-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for filtering X-ray images to improve contrast and clarity for diagnostic purposes. The filtering is performed in the frequency domain.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A system for filtering X-ray images comprising...\",\n        \"The system of claim 1, wherein the filter is a high-pass filter.\",\n        \"The system of claim 1, wherein the filter is applied in the frequency domain.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67333", "text": "{\n    \"patent_title\": \"Enhanced Image Reconstruction for Low-Dose Computed Tomography\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image reconstruction algorithm for reducing radiation dose in computed tomography while maintaining image quality. The algorithm utilizes deep learning techniques to enhance image clarity and reduce noise.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Prior Art CT Reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an image from projection data comprising...\",\n        \"The method of claim 1, wherein the image is a computed tomography image.\",\n        \"The method of claim 1, wherein the deep learning model is a convolutional neural network.\",\n        \"The method of claim 1, further comprising a step of reducing radiation dose.\",\n        \"The method of claim 4, wherein the radiation dose is reduced by at least 20%.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67333", "text": "{\n    \"patent_title\": \"Wireless Communication System for Biomedical Sensors\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A low-power wireless communication system for transmitting data from biomedical sensors. The system utilizes a novel modulation scheme to improve data throughput and reduce energy consumption.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Existing Wireless Sensor Network\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication system comprising...\",\n        \"The system of claim 1, wherein the sensor is a biomedical sensor.\",\n        \"The system of claim 1, further comprising a modulation scheme.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67334", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical system for minimally invasive procedures, incorporating advanced imaging and robotic assistance. The system utilizes a small incision to access the surgical site, reducing patient trauma and recovery time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising a robotic arm...\",\n        \"A method for performing a minimally invasive surgical procedure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67334", "text": "{\n    \"patent_title\": \"Drug Delivery System for Cancer Treatment\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-12-10\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2023-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel drug delivery system designed to target cancer cells with enhanced efficiency. The system utilizes nanoparticles to encapsulate and deliver chemotherapeutic agents directly to the tumor site.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in nanoparticle drug delivery\"\n        }\n    ],\n    \"claims\": [\n        \"A drug delivery system comprising nanoparticles...\",\n        \"A method for treating cancer using said nanoparticles...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67335", "text": "{\n    \"patent_title\": \"Comfort-Enhanced Catheter Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"BioTech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University Medical Center\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel catheter design incorporating flexible materials and ergonomic features to minimize patient discomfort during insertion and use. The design includes a lubricious coating and a contoured tip.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art catheter design\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible polymeric material.\",\n        \"The catheter of claim 1, further comprising a lubricious coating.\",\n        \"The catheter of claim 1, having a contoured distal tip.\",\n        \"A method of using the catheter to deliver fluids.\",\n        \"The method of claim 4, wherein the delivery reduces patient discomfort.\",\n        \"The catheter of claim 1, wherein the polymeric material is biocompatible.\",\n        \"A system for delivering fluids via the catheter.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67335", "text": "{\n    \"patent_title\": \"Automated Surgical Instrument Control System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Robotics Corp.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-08-01\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2021-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated control system for surgical instruments, providing precise movement and feedback to surgeons during complex procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Existing surgical robotic systems\"\n        }\n    ],\n    \"claims\": [\n        \"A control system for surgical instruments.\",\n        \"The control system of claim 1, comprising a robotic arm.\",\n        \"The control system of claim 1, providing haptic feedback.\",\n        \"A method of controlling a surgical instrument using the system.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67336", "text": "{\n    \"patent_title\": \"Ultrasound Image Enhancement using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention utilizes deep learning algorithms to enhance the clarity and resolution of ultrasound images, improving diagnostic accuracy for various medical conditions. The method reduces noise and artifacts, providing clearer visualization of anatomical structures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing ultrasound images using a convolutional neural network.\",\n        \"A system for real-time ultrasound image enhancement.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67336", "text": "{\n    \"patent_title\": \"Improved X-ray Imaging with Contrast Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2015-11-20\",\n    \"filing_date\": \"2015-11-20\",\n    \"issue_date\": \"2017-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel technique for improving the contrast and clarity of X-ray images, leading to more accurate diagnoses of bone fractures and other skeletal abnormalities. A new contrast agent is utilized to enhance image visibility.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing X-ray images using a novel contrast agent.\",\n        \"A composition for use as a contrast agent in X-ray imaging.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67337", "text": "{\n    \"patent_title\": \"Miniaturized Biosensor for Rapid Point-of-Care Diagnostics\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized biosensor for detecting biomarkers in bodily fluids, enabling rapid and accurate point-of-care diagnostics. The device utilizes a novel nanomaterial for enhanced sensitivity and selectivity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A biosensor comprising a nanomaterial-based sensing element.\",\n        \"A method for detecting biomarkers using the biosensor.\",\n        \"A diagnostic device incorporating the biosensor for point-of-care testing.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67337", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler with enhanced ergonomic features for increased surgeon comfort and efficiency during surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler with an ergonomic handle.\",\n        \"A stapling cartridge for use with the surgical stapler.\",\n        \"A method of performing surgical stapling using the device.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67338", "text": "{\n    \"patent_title\": \"Image Enhancement System for Low-Light Photography\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing images captured in low-light conditions. The system utilizes a novel algorithm to reduce noise and improve contrast, resulting in clearer and more detailed images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Noise Reduction in Digital Images\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image captured in low-light conditions, comprising...\",\n        \"An image processing system configured to reduce noise in low-light images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67338", "text": "{\n    \"patent_title\": \"Method for Compressing Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-04-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for compressing medical images using wavelet transform. The method significantly reduces the storage space required for medical image data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Wavelet-Based Image Compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a medical image using wavelet transform...\",\n        \"A system for reducing the storage space of medical image data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67339", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Point-of-Care Diagnostics\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for rapid and accurate detection of biomarkers in biological fluids, enabling point-of-care diagnostics. The device utilizes novel channel designs and surface modifications to enhance sensitivity and specificity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8652200B2\",\n            \"relevance\": \"Prior art on microfluidic devices\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for detecting biomarkers...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67339", "text": "{\n    \"patent_title\": \"Improved Catheter Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Medtronic Inc.\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Boston Scientific Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-09-20\",\n    \"filing_date\": \"2017-09-20\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design with enhanced flexibility and biocompatibility for minimally invasive procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7455678B2\",\n            \"relevance\": \"Previous catheter designs\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising...\",\n        \"A method for using the catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67340", "text": "{\n    \"patent_title\": \"Adaptive Learning Rate Scheduling for Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-06-15\",\n    \"issue_date\": \"2023-11-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for dynamically adjusting the learning rate during the training of deep neural networks is disclosed. This approach improves convergence speed and model accuracy, particularly in challenging optimization landscapes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for training a deep neural network comprising...\",\n        \"A system for adaptive learning rate adjustment...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67340", "text": "{\n    \"patent_title\": \"Improved Image Compression Techniques\",\n    \"inventors\": [\n        {\n            \"name\": \"Hans Müller\",\n            \"affiliation\": \"Technical University of Munich\"\n        }\n    ],\n    \"patent_number\": \"EP3876543B1\",\n    \"priority_date\": \"2020-03-10\",\n    \"filing_date\": \"2020-04-10\",\n    \"issue_date\": \"2022-09-15\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"This invention relates to an improved method for compressing digital images, reducing storage space and transmission bandwidth.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image...\",\n        \"An image compression system comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67341", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction with Reduced Radiation Dose\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for reconstructing medical images from low-dose radiation data, employing advanced iterative algorithms to enhance image clarity and reduce patient exposure. The method utilizes a novel regularization technique to suppress noise and improve image resolution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in iterative reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for performing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67341", "text": "{\n    \"patent_title\": \"Automated System for Drug Dosage Calculation\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Pharmaceutical Corp\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Pharmaceutical Corp\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-05-20\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-02-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for calculating and dispensing drug dosages based on patient data. The system utilizes a database of drug interactions and patient-specific parameters to ensure accurate dosing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art in dosage calculation\"\n        }\n    ],\n    \"claims\": [\n        \"A system for calculating drug dosages comprising...\",\n        \"A method for dispensing drugs based on the calculated dosage...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67342", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-01-20\",\n    \"issue_date\": \"2021-02-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a minimally invasive surgical system providing improved visualization and precision for surgeons, leading to better patient outcomes and faster recovery times. The system incorporates real-time image processing and robotic assistance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in minimally invasive surgery.\"\n        }\n    ],\n    \"claims\": [\n        \"A minimally invasive surgical system comprising...\",\n        \"A method for performing surgery using the system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67342", "text": "{\n    \"patent_title\": \"Automated Drug Delivery System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Pharmaceutical Corp.\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Pharmaceutical Corp.\"\n        }\n    ],\n    \"patent_number\": \"US11345678B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-05-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for delivering drugs directly to patients based on their specific needs and medical history. It utilizes a closed-loop feedback mechanism to optimize dosage and reduce side effects.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art in drug delivery systems.\"\n        }\n    ],\n    \"claims\": [\n        \"An automated drug delivery system comprising...\",\n        \"A method for controlling drug delivery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67343", "text": "{\n    \"patent_title\": \"Early Cancer Detection Using Enhanced MRI Techniques\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US1054321B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel magnetic resonance imaging (MRI) technique for detecting early-stage cancerous tumors with improved sensitivity and specificity. The method utilizes contrast agents and advanced image processing algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in MRI contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting early-stage cancer comprising...\",\n        \"An MRI system configured to implement the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67343", "text": "{\n    \"patent_title\": \"Improved Algorithm for Processing Satellite Imagery\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"California Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2022-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved algorithm for processing and analyzing satellite imagery data, enhancing image clarity and object recognition capabilities. Focuses on environmental monitoring.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10112233B2\",\n            \"relevance\": \"Prior art in satellite image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing satellite imagery comprising...\",\n        \"A system for analyzing satellite image data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67344", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the resolution and clarity of medical images, particularly MRI and CT scans. The invention utilizes a novel reconstruction algorithm to reduce noise and artifacts, resulting in improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for enhancing the resolution of a medical image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67344", "text": "{\n    \"patent_title\": \"Apparatus for Automated Blood Cell Counting\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for accurately and efficiently counting blood cells in a sample. The invention utilizes a microfluidic device and image analysis techniques to provide rapid and reliable results.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"An apparatus for counting blood cells comprising...\",\n        \"A method for automating blood cell counting...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67345", "text": "{\n    \"patent_title\": \"Enhanced Resolution Medical Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2015-03-15\",\n    \"filing_date\": \"2015-05-20\",\n    \"issue_date\": \"2017-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel medical imaging system that utilizes advanced signal processing techniques to significantly enhance image resolution and clarity, leading to improved diagnostic accuracy. The system includes a new type of detector and a refined image reconstruction algorithm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in medical imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A medical imaging system comprising...\",\n        \"A method for improving image resolution in medical imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67345", "text": "{\n    \"patent_title\": \"Automated Surgical Instrument Tracking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Carol Davis\",\n            \"affiliation\": \"General Hospital\"\n        },\n        {\n            \"name\": \"Dr. David Miller\",\n            \"affiliation\": \"General Hospital\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2016-01-25\",\n    \"filing_date\": \"2016-03-10\",\n    \"issue_date\": \"2018-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a system for tracking surgical instruments during operations, utilizing computer vision and sensor fusion techniques. It allows for precise localization and identification of instruments in real-time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related to surgical robotics\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument tracking system comprising...\",\n        \"A method for localizing surgical instruments...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67346", "text": "{\n    \"patent_title\": \"Method and System for Super-Resolution Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for reconstructing high-resolution images from low-resolution images using deep convolutional neural networks. The system aims to enhance image clarity and detail, improving visual quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for super-resolution image reconstruction comprising...\",\n        \"A system for enhancing image resolution...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67346", "text": "{\n    \"patent_title\": \"System for Automated Plant Disease Detection Using Image Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"AgriTech Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for automatically detecting plant diseases from images captured by drones or mobile devices. The system uses image analysis techniques to identify disease symptoms and provide alerts to farmers.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for detecting plant diseases comprising...\",\n        \"A method for analyzing images to identify disease symptoms...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67347", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Super-Resolution with Perceptual Loss\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-11-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel deep learning architecture for image super-resolution, achieving state-of-the-art results by incorporating a perceptual loss function that significantly enhances the visual quality of upscaled images. The method represents a breakthrough in realistic texture synthesis and detail recovery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for super-resolving an image comprising...\",\n        \"A deep neural network configured to perform image super-resolution...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67347", "text": "{\n    \"patent_title\": \"Method for Image Compression Using Discrete Cosine Transform\",\n    \"inventors\": [\n        {\n            \"name\": \"Thomas Mitchell\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2019-12-01\",\n    \"filing_date\": \"2019-12-01\",\n    \"issue_date\": \"2022-04-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved method for image compression utilizing the discrete cosine transform (DCT) algorithm. This approach provides efficient compression ratios with acceptable image quality. The technique builds upon existing DCT-based compression standards.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image comprising...\",\n        \"An image compression system utilizing a DCT encoder...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67348", "text": "{\n    \"patent_title\": \"Method for Enhanced Magnetic Resonance Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"David A. Haussler\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emma Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing magnetic resonance images (MRI) with improved clarity and resolution. This method utilizes a deep learning algorithm to reduce noise and enhance image details.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"MRI Reconstruction Using Compressed Sensing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"A system for performing MRI reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67348", "text": "{\n    \"patent_title\": \"Improved X-Ray Detector for Mammography\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-11-01\",\n    \"filing_date\": \"2022-03-10\",\n    \"issue_date\": \"2024-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved X-ray detector for mammography, offering increased sensitivity and reduced radiation dose.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Digital Mammography System\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray detector for mammography comprising...\",\n        \"A system for performing mammography using the improved detector...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67349", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Enhancement for Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel deep learning architecture for enhancing the quality of medical images, improving diagnostic accuracy in challenging cases. It addresses issues like low contrast and noise.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing medical images using a convolutional neural network.\",\n        \"A system for automated image quality assessment.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67349", "text": "{\n    \"patent_title\": \"Method for Compressing Digital Photographs\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-12-01\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-08-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an efficient algorithm for compressing digital photographs, reducing storage requirements and transmission bandwidth.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for lossy compression of digital images.\",\n        \"A system for encoding and decoding image data.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67350", "text": "{\n    \"patent_title\": \"AI-Powered Diagnostic System for Early Cancer Detection Using Multi-Modal Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-09-20\",\n    \"issue_date\": \"2021-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel system and method for early cancer detection utilizing deep learning algorithms to analyze multi-modal medical images (MRI, CT, PET). The system significantly improves diagnostic accuracy and reduces false positives.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art in image segmentation\"\n        }\n    ],\n    \"claims\": [\n        \"A method for diagnosing cancer comprising:...\",\n        \"A computer-implemented system for analyzing medical images...\",\n        \"A non-transitory computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67350", "text": "{\n    \"patent_title\": \"Improved Image Compression Technique for Medical Scans\",\n    \"inventors\": [\n        {\n            \"name\": \"Mr. John Smith\",\n            \"affiliation\": \"Acme Medical Devices Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-03-10\",\n    \"issue_date\": \"2020-12-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An enhanced image compression algorithm specifically designed for reducing the storage space requirements of medical imaging data. The algorithm achieves high compression ratios while preserving image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art related to wavelet compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a medical image comprising...\",\n        \"A system for encoding medical image data...\",\n        \"A computer-readable medium storing compression parameters...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67351", "text": "{\n    \"patent_title\": \"Comfortable and Adjustable Patient Interface for Respiratory Support\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel patient interface for respiratory support devices is disclosed, featuring a soft, adjustable frame and breathable materials designed to enhance patient comfort and minimize skin irritation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\",\n            \"relevance\": \"Related prior art in respiratory interfaces\"\n        }\n    ],\n    \"claims\": [\n        \"A patient interface comprising an adjustable frame...\",\n        \"The patient interface of claim 1, wherein the frame is constructed from a flexible polymer.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67351", "text": "{\n    \"patent_title\": \"Surgical Instrument for Precise Tissue Dissection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"Boston Scientific Corporation\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2020-11-15\",\n    \"filing_date\": \"2020-11-15\",\n    \"issue_date\": \"2022-09-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical instrument designed for precise tissue dissection with minimal collateral damage. Features include a micro-vibrating blade and ergonomic handle.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"relevance\": \"Prior art in surgical instrumentation\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising a vibrating blade...\",\n        \"The surgical instrument of claim 1, wherein the blade frequency is adjustable.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67352", "text": "{\n    \"patent_title\": \"Surgical Stapler with Integrated Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Boston Scientific\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical stapler incorporating a miniature imaging system to provide real-time visualization during minimally invasive procedures, enhancing precision and reducing complications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an imaging system.\",\n        \"The surgical stapler of claim 1, wherein the imaging system is a miniature endoscope.\",\n        \"A method of performing minimally invasive surgery using the surgical stapler of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67352", "text": "{\n    \"patent_title\": \"Orthopedic Screw Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Johnson & Johnson\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2018-11-01\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved orthopedic screw design with enhanced thread geometry for secure bone fixation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"An orthopedic screw comprising a novel thread pitch.\",\n        \"The orthopedic screw of claim 1, wherein the thread pitch is variable.\",\n        \"A method of fixing bone fractures using the orthopedic screw of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67353", "text": "{\n    \"patent_title\": \"Improved MRI Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method for improving the quality and speed of MRI image reconstruction using deep learning techniques, leading to enhanced diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67353", "text": "{\n    \"patent_title\": \"New Catheter Design for Vascular Access\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MedTech Solutions Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2015-11-20\",\n    \"filing_date\": \"2015-11-19\",\n    \"issue_date\": \"2018-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel catheter design for improved vascular access during medical procedures. The catheter features a flexible tip and enhanced biocompatibility.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible distal tip...\",\n        \"A method for inserting a catheter into a blood vessel...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67354", "text": "{\n    \"patent_title\": \"Contrast-Enhanced Spectral CT for Improved Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2018-04-20\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel spectral CT imaging technique using contrast agents to enhance tumor detection sensitivity and specificity.  The method allows for differentiation of tumor microenvironment characteristics not previously visible, potentially leading to earlier and more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on spectral CT imaging.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing tumor detection using spectral CT imaging.\",\n        \"A contrast agent formulation optimized for spectral CT imaging of tumors.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67354", "text": "{\n    \"patent_title\": \"Improved X-Ray Tube Cooling System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11123456B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2018-02-10\",\n    \"issue_date\": \"2019-10-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new cooling system for X-ray tubes designed to increase operational lifespan and reduce maintenance costs.  The system utilizes a more efficient heat exchanger and a novel coolant fluid.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous designs for X-ray tube cooling.\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube cooling system incorporating a high-efficiency heat exchanger.\",\n        \"A coolant fluid for use in X-ray tube cooling systems.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67355", "text": "{\n    \"patent_title\": \"High-Resolution Optical Coherence Tomography System for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Chen\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel optical coherence tomography system providing high-resolution images for improved early cancer detection. The system utilizes a swept-source laser and advanced image processing algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating a high-resolution cross-sectional image of a tissue sample...\",\n        \"An optical coherence tomography system comprising a swept-source laser...\",\n        \"A computer-readable medium storing instructions for processing image data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67355", "text": "{\n    \"patent_title\": \"Improved MRI Coil Design for Enhanced Image Quality\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Wilson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-06-01\",\n    \"filing_date\": \"2020-06-01\",\n    \"issue_date\": \"2022-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new MRI coil design significantly improves signal-to-noise ratio and image quality, leading to more accurate diagnoses. This design incorporates advanced shielding techniques and optimized coil geometry.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        },\n        {\n            \"patent_number\": \"US98765432B1\"\n        },\n        {\n            \"patent_number\": \"US11223344B2\"\n        },\n        {\n            \"patent_number\": \"US12334455B2\"\n        },\n        {\n            \"patent_number\": \"US13445566B2\"\n        },\n        {\n            \"patent_number\": \"US14556677B2\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil comprising a plurality of conductive elements...\",\n        \"A method for manufacturing an MRI coil with improved shielding...\",\n        \"A system for performing magnetic resonance imaging using the aforementioned coil...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67356", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"David A. Bluemher\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Shreyas Vasanawala\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-12-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing medical images from limited data, resulting in improved image quality and diagnostic accuracy. Utilizes deep learning algorithms to reduce noise and artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for performing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67356", "text": "{\n    \"patent_title\": \"MRI Coil Design for Improved Signal-to-Noise Ratio\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2017-11-22\",\n    \"filing_date\": \"2018-11-22\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved magnetic resonance imaging (MRI) coil design for enhancing signal-to-noise ratio. This design allows for clearer images but does not specifically address diagnostic accuracy improvements beyond signal clarity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil comprising...\",\n        \"A system incorporating the MRI coil of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67357", "text": "{\n    \"patent_title\": \"Method and System for Real-Time Image Enhancement Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the quality of digital images using a deep convolutional neural network. The system analyzes image features and applies learned transformations to improve resolution, contrast, and overall visual appeal.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing a digital image comprising...\",\n        \"A system for real-time image enhancement...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67357", "text": "{\n    \"patent_title\": \"Improved Image Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corp\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2018-11-01\",\n    \"issue_date\": \"2021-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an optimized JPEG compression algorithm that achieves slightly better compression ratios than existing methods. It improves upon established techniques but does not fundamentally alter the compression process.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"An image compression method based on JPEG...\",\n        \"A system for compressing digital images using the method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67358", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"EP3854921A1\",\n    \"priority_date\": \"2020-05-15\",\n    \"filing_date\": \"2021-03-22\",\n    \"issue_date\": \"2021-08-04\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"This invention discloses a method and system for enhancing the resolution of images using deep convolutional neural networks. The system is designed to improve image quality by removing artifacts and increasing detail.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10234567B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising:...\",\n        \"A system for processing images comprising:...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67358", "text": "{\n    \"patent_title\": \"Digital Image Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2019-11-10\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2022-05-03\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"This invention presents a novel digital image compression technique based on wavelet transform and entropy encoding. The method aims to reduce the file size of images without significant loss of quality.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for compressing digital images comprising...\",\n        \"A system for encoding image data comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67359", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction with Reduced Radiation Dose\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for reconstructing medical images from low-dose radiation data. The invention utilizes a novel iterative reconstruction algorithm that minimizes noise and artifacts, resulting in improved image clarity while significantly reducing patient radiation exposure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for reducing radiation dose in medical imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67359", "text": "{\n    \"patent_title\": \"Automated System for Dental X-ray Image Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for analyzing dental x-ray images to detect cavities and other dental abnormalities. The system employs machine learning algorithms to identify potential issues, improving the efficiency and accuracy of dental diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for analyzing dental x-ray images comprising...\",\n        \"A method for detecting cavities in dental images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67360", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging Technique for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel MRI technique utilizing advanced pulse sequences and image reconstruction algorithms for enhanced detection of early-stage cancerous tumors. The method improves signal-to-noise ratio and reduces scan time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8567890B1\",\n            \"title\": \"MRI Pulse Sequence Optimization\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Image Reconstruction Algorithms for MRI\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI comprising...\",\n        \"An MRI apparatus configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67360", "text": "{\n    \"patent_title\": \"Digital X-Ray Image Enhancement System\",\n    \"inventors\": [\n        {\n            \"name\": \"Mr. John Smith\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2018-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for enhancing the clarity and contrast of digital X-ray images. Utilizes a proprietary filtering algorithm to reduce noise and improve image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Digital Image Filtering Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A system for processing digital X-ray images comprising...\",\n        \"A method for enhancing image contrast...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67361", "text": "{\n    \"patent_title\": \"Contrast-Enhanced Magnetic Resonance Imaging for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"David Stanford\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2018-07-15\",\n    \"filing_date\": \"2018-11-01\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for contrast-enhanced magnetic resonance imaging (MRI) is presented, significantly improving the detection of early-stage cancer in patients. The technique utilizes a new contrast agent and imaging protocol optimized for accurate diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing contrast in MRI imaging...\",\n        \"A contrast agent for use in MRI imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67361", "text": "{\n    \"patent_title\": \"Advanced Algorithm for Image Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2019-03-10\",\n    \"filing_date\": \"2019-07-01\",\n    \"issue_date\": \"2020-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a highly efficient algorithm for lossless image compression, reducing file sizes while maintaining image quality.  It uses a novel wavelet transform and entropy encoding scheme.  The algorithm is applicable to a wide range of image formats.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing image data...\",\n        \"A system for implementing the compression algorithm...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67362", "text": "{\n    \"patent_title\": \"Noise Reduction in Digital Images Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for reducing noise in digital images using a convolutional neural network. The network is trained to map noisy images to clean images, resulting in improved visual quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Denoising Using Wavelet Transforms\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing noise in an image comprising: training a convolutional neural network...\",\n        \"An image processing system configured to implement the method of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67362", "text": "{\n    \"patent_title\": \"Method for Compressing Video Streams\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-12-01\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-08-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel technique for compressing video data using a hybrid coding scheme. This improves bandwidth efficiency for streaming applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Efficient Video Encoding Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing video data comprising: applying a discrete cosine transform...\",\n        \"A video encoding device configured to implement the method of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67363", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for reconstructing medical images with improved clarity and reduced noise using advanced filtering techniques. This invention provides higher resolution images, improving diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for enhancing medical image clarity...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67363", "text": "{\n    \"patent_title\": \"Apparatus for Automated Blood Sample Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"BioTech Industries Inc.\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"BioTech Industries Inc.\"\n        }\n    ],\n    \"patent_number\": \"US1234567B2\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for processing and analyzing blood samples, providing rapid and accurate results.  The system automates the blood drawing, preparation, and analysis steps.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"An apparatus for analyzing blood samples...\",\n        \"A method for automating blood sample processing...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67364", "text": "{\n    \"patent_title\": \"Enhanced MRI Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing high-resolution MRI images using a deep convolutional neural network. The method significantly reduces scan time and improves image quality, particularly for patients with challenging anatomy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI reconstruction...\",\n        \"A non-transitory computer-readable medium...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67364", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for CT Scans\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2018-05-10\",\n    \"filing_date\": \"2018-05-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new formulation of contrast agent for computed tomography (CT) scans, providing enhanced visualization of blood vessels. The agent exhibits improved biocompatibility and reduced toxicity compared to existing formulations.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent for CT scans comprising...\",\n        \"A method for enhancing CT imaging using the contrast agent...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67365", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for image reconstruction utilizing deep convolutional neural networks.  This invention significantly improves image quality and reduces artifacts compared to traditional iterative reconstruction algorithms, achieving state-of-the-art performance on benchmark datasets.  The system is particularly well-suited for medical imaging applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"relevance\": \"Prior art in image reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an image...\",\n        \"A system comprising a deep neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67365", "text": "{\n    \"patent_title\": \"Image Compression Technique Based on JPEG Standard\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US7654321B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2019-01-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents an improved JPEG compression algorithm that offers slight efficiency gains over existing implementations.  It focuses on optimizing the quantization process to reduce file size while maintaining acceptable image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"relevance\": \"Baseline JPEG standard\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image...\",\n        \"A system for encoding image data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67366", "text": "{\n    \"patent_title\": \"Novel MRI Technique for Enhanced Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2023-11-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new magnetic resonance imaging (MRI) technique utilizing advanced pulse sequences and image reconstruction algorithms to significantly improve the detection and characterization of small tumors. This invention offers a non-invasive approach with enhanced sensitivity and specificity compared to existing methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in MRI pulse sequence design\"\n        }\n    ],\n    \"claims\": [\n        \"A method for MRI imaging comprising...\",\n        \"An MRI system configured to...\",\n        \"A computer-readable medium storing instructions for...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67366", "text": "{\n    \"patent_title\": \"Improved X-Ray Shielding Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2017-12-10\",\n    \"filing_date\": \"2017-12-10\",\n    \"issue_date\": \"2022-09-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel shielding material for X-ray imaging, providing enhanced radiation protection for patients and operators. The material is a composite of barium sulfate and a polymer matrix.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in X-ray shielding materials\"\n        }\n    ],\n    \"claims\": [\n        \"A shielding material comprising...\",\n        \"An X-ray imaging system including...\",\n        \"A method for manufacturing...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67367", "text": "{\n    \"patent_title\": \"High-Resolution Optical Coherence Tomography System for Enhanced Retinal Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2021-01-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel optical coherence tomography (OCT) system achieving unprecedented axial and transverse resolution. Utilizing a swept-source laser with a broad bandwidth and advanced signal processing techniques, the system enables detailed visualization of retinal structures, facilitating early detection and diagnosis of macular degeneration and other retinal diseases. The improved resolution allows for identification of subtle pathological changes previously undetectable with conventional OCT systems, representing a significant advancement in ophthalmic diagnostics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art OCT system\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating high-resolution retinal images...\",\n        \"An optical coherence tomography system comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67367", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2018-03-10\",\n    \"filing_date\": \"2018-03-10\",\n    \"issue_date\": \"2020-06-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new gadolinium-based contrast agent for magnetic resonance imaging (MRI). The agent exhibits enhanced relaxivity, leading to improved image contrast in cardiovascular applications. The design focuses on optimizing the agent's pharmacokinetic properties for faster clearance and reduced toxicity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Existing gadolinium-based contrast agent\"\n        }\n    ],\n    \"claims\": [\n        \"A gadolinium-based contrast agent comprising...\",\n        \"A method for enhancing MRI image contrast...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67368", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical Device with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-06-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel medical device for minimally invasive surgical procedures, incorporating a high-resolution imaging system and ergonomic design for improved precision and control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9238217B2\",\n            \"relevance\": \"Prior art related to surgical visualization\"\n        }\n    ],\n    \"claims\": [\n        \"A medical device comprising an imaging system and a surgical instrument.\",\n        \"The medical device of claim 1, wherein the imaging system provides high-resolution images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67368", "text": "{\n    \"patent_title\": \"Automated Pharmaceutical Dispensing System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"TechPharm Inc.\"\n        },\n        {\n            \"name\": \"Emily Wilson\",\n            \"affiliation\": \"TechPharm Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2017-08-10\",\n    \"filing_date\": \"2017-08-10\",\n    \"issue_date\": \"2021-04-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for dispensing pharmaceutical drugs with improved accuracy and efficiency, utilizing robotic arms and barcode scanning.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8987654B2\",\n            \"relevance\": \"Previous automation systems\"\n        }\n    ],\n    \"claims\": [\n        \"An automated dispensing system comprising a robotic arm and a barcode scanner.\",\n        \"The system of claim 1, wherein the robotic arm accurately dispenses pharmaceutical drugs.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67369", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Super-Resolution with Generative Adversarial Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Chen Wang\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Li Zhang\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for improving the resolution of images using deep convolutional neural networks and generative adversarial networks. The system learns to generate high-resolution images from low-resolution inputs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Enhancement Using Convolutional Neural Networks\"\n        }\n    ],\n    \"claims\": [\n        \"A method for super-resolving an image...\",\n        \"A system comprising...\",\n        \"A non-transitory computer-readable medium...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67369", "text": "{\n    \"patent_title\": \"Method for Digital Image Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"IBM\"\n        }\n    ],\n    \"patent_number\": \"US7654321B1\",\n    \"priority_date\": \"2017-12-20\",\n    \"filing_date\": \"2017-12-20\",\n    \"issue_date\": \"2019-07-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel approach to compressing digital images using wavelet transforms and Huffman coding. This method provides improved compression ratios and image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"title\": \"Image Compression Using Wavelet Transforms\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a digital image...\",\n        \"A system for encoding and decoding images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67370", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10456789B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-02-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for reconstructing high-resolution medical images from limited data, resulting in improved image clarity and diagnostic accuracy. The method utilizes a novel iterative reconstruction algorithm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"A system comprising a processor configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67370", "text": "{\n    \"patent_title\": \"Portable X-Ray Device with Digital Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Charles Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Eve Miller\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2014-12-20\",\n    \"filing_date\": \"2014-12-20\",\n    \"issue_date\": \"2018-04-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A portable X-ray device with integrated digital processing capabilities for rapid image acquisition and display.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7236895B2\",\n            \"type\": \"related\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A portable X-ray device...\",\n        \"A digital image processing system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67371", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Recognition Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel method and system for enhanced image recognition utilizing deep convolutional neural networks with innovative attention mechanisms. The technique significantly improves accuracy in identifying objects within complex visual scenes, representing an advancement in the field of computer vision.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for implementing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67371", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-08-01\",\n    \"filing_date\": \"2019-11-22\",\n    \"issue_date\": \"2020-12-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved algorithm for lossless data compression, achieving higher compression ratios compared to existing techniques. The algorithm is suitable for various applications including file storage and network transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related Art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression...\",\n        \"A system for performing the compression...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67372", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Contrast in Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-09\",\n    \"patent_office\": \"US Patent and Trademark Office\",\n    \"abstract\": \"A method for improving the contrast of medical images, particularly those suffering from low signal-to-noise ratio. The method utilizes a novel filtering technique based on wavelet transform and adaptive histogram equalization.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760543B2\",\n            \"title\": \"Image Enhancement System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing contrast in a medical image comprising...\",\n        \"A system for processing medical images to improve visualization...\",\n        \"The method of claim 1, wherein the medical image is a CT scan.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67372", "text": "{\n    \"patent_title\": \"Novel Dental Implant Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2018-07-17\",\n    \"patent_office\": \"US Patent and Trademark Office\",\n    \"abstract\": \"A new design for dental implants incorporating a porous surface for improved osseointegration.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Dental Implant with Enhanced Stability\"\n        }\n    ],\n    \"claims\": [\n        \"A dental implant comprising a titanium core and a porous coating...\",\n        \"The dental implant of claim 1, wherein the porous coating is hydroxyapatite.\",\n        \"A method for installing the dental implant of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67373", "text": "{\n    \"patent_title\": \"Improved MRI Reconstruction Algorithm for Enhanced Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel algorithm for reconstructing MRI images, significantly reducing noise and enhancing the visibility of small tumors, leading to improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"An MRI system configured to perform the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67373", "text": "{\n    \"patent_title\": \"New X-Ray Shielding Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2014-12-10\",\n    \"filing_date\": \"2014-12-10\",\n    \"issue_date\": \"2017-05-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel material for shielding against X-ray radiation, reducing patient exposure during medical imaging.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A shielding material comprising...\",\n        \"A medical imaging apparatus including the shielding material of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67374", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Electrolyte for Improved Cycle Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10523456B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-12-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery incorporating a novel electrolyte composition to significantly enhance cycle life and overall performance. The electrolyte is designed to minimize degradation and improve ion conductivity, resulting in a more durable and efficient battery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrolyte composition...\",\n        \"The electrolyte composition comprising...\",\n        \"A method for manufacturing a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67374", "text": "{\n    \"patent_title\": \"Improved Internal Combustion Engine Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Ford Motor Company\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2021-01-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved internal combustion engine design featuring a novel fuel injection system and combustion chamber geometry to increase efficiency and reduce emissions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"An internal combustion engine comprising a fuel injection system...\",\n        \"The fuel injection system comprising...\",\n        \"A method for operating an internal combustion engine...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67375", "text": "{\n    \"patent_title\": \"Novel MRI Technique for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2021-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel magnetic resonance imaging (MRI) technique utilizing advanced pulse sequences and image reconstruction algorithms for the early detection of cancerous tumors. The technique improves sensitivity and specificity compared to conventional MRI methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Improved MRI Contrast Agents\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancerous tumors using MRI.\",\n        \"An MRI apparatus configured for enhanced tumor detection.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67375", "text": "{\n    \"patent_title\": \"Improved X-Ray System for Bone Fracture Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Wilson\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"Dr. Sarah Jones\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-08-22\",\n    \"filing_date\": \"2020-12-15\",\n    \"issue_date\": \"2022-07-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved X-ray system with reduced radiation dosage and enhanced image clarity for the detection of bone fractures. The system utilizes a novel detector array and image processing techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Radiation Shielding for X-Ray Systems\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray system with reduced radiation exposure.\",\n        \"A detector array for improved X-ray imaging.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67376", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction Method for MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2015-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel image reconstruction method for Magnetic Resonance Imaging (MRI) that significantly improves image resolution and diagnostic accuracy by reducing noise and artifacts. The method utilizes a deep learning algorithm trained on a large dataset of MRI scans.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"An MRI system configured to perform the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67376", "text": "{\n    \"patent_title\": \"Digital X-Ray Enhancement System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2015-05-20\",\n    \"issue_date\": \"2017-02-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a digital X-ray enhancement system that improves image contrast and clarity. The system employs image processing techniques to reduce noise and enhance details in X-ray images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A digital X-ray enhancement system comprising...\",\n        \"A method for enhancing X-ray images using the system of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67377", "text": "{\n    \"patent_title\": \"Efficient Training of Deep Neural Networks using Quantization\",\n    \"inventors\": [\n        {\n            \"name\": \"Li Wei\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a method for quantizing the weights and activations of deep neural networks to reduce memory footprint and computational cost, thereby improving training efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11111111B1\"\n        },\n        {\n            \"patent_number\": \"US22222222B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for quantizing a deep neural network comprising...\",\n        \"A system for training a quantized deep neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67377", "text": "{\n    \"patent_title\": \"System and Method for Recommender Systems\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for providing personalized recommendations to users based on their past behavior and preferences. The system uses collaborative filtering techniques to identify similar users and predict their future interests.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US33333333B2\"\n        },\n        {\n            \"patent_number\": \"US44444444B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for generating recommendations comprising...\",\n        \"A method for identifying similar users...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67378", "text": "{\n    \"patent_title\": \"Wearable Sensor System for Continuous Physiological Monitoring with Enhanced Patient Comfort\",\n    \"inventors\": [\n        {\n            \"name\": \"David A. Holmes\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emily C. Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wearable sensor system is disclosed that provides continuous physiological monitoring while minimizing discomfort to the patient. The system incorporates flexible materials and optimized sensor placement for long-term wearability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related art in wearable sensors\"\n        }\n    ],\n    \"claims\": [\n        \"A wearable sensor system comprising a flexible substrate...\",\n        \"The system of claim 1, wherein the flexible substrate is biocompatible...\",\n        \"A method for continuous physiological monitoring using the system of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67378", "text": "{\n    \"patent_title\": \"Implantable Cardiac Pacemaker with Remote Monitoring Capabilities\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert J. Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Jessica L. Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-05-20\",\n    \"filing_date\": \"2016-05-20\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac pacemaker is disclosed with remote monitoring and data transmission capabilities. The device provides precise pacing and real-time feedback to healthcare professionals.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Prior art in implantable pacemakers\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable cardiac pacemaker comprising a pulse generator...\",\n        \"The pacemaker of claim 1, further comprising a wireless communication module...\",\n        \"A method for monitoring cardiac function using the pacemaker of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67379", "text": "{\n    \"patent_title\": \"Novel Image Enhancement Algorithm for Low-Light Conditions\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel image enhancement algorithm that significantly improves the visibility of images captured in low-light conditions. The algorithm utilizes a unique combination of deep learning and wavelet transform techniques to achieve state-of-the-art performance, demonstrating a substantial improvement over existing methods. This represents a breakthrough in image processing for applications such as surveillance, medical imaging, and autonomous vehicles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image denoising\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing images captured in low-light conditions, comprising...\",\n        \"An image processing system configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67379", "text": "{\n    \"patent_title\": \"Improved Method for JPEG Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improvement to the JPEG compression standard, reducing file size while maintaining acceptable image quality. The method involves optimizing the quantization process and utilizing a more efficient entropy coding scheme.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Original JPEG standard\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing images using the JPEG standard, comprising...\",\n        \"A system for encoding images using the JPEG standard...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67380", "text": "{\n    \"patent_title\": \"Enhanced Medical Imaging System for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel medical imaging system utilizing advanced signal processing techniques to enhance image clarity, particularly for detecting subtle indications of early-stage cancer. The system incorporates a new algorithm for noise reduction and contrast enhancement.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A medical imaging system comprising a signal acquisition module, a noise reduction algorithm, and a contrast enhancement module.\",\n        \"The system of claim 1, wherein the noise reduction algorithm utilizes wavelet transform.\",\n        \"A method for detecting early-stage cancer using the system of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67380", "text": "{\n    \"patent_title\": \"Improved MRI Coil Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-11-01\",\n    \"filing_date\": \"2014-11-01\",\n    \"issue_date\": \"2018-02-13\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new design for MRI coils that improves signal-to-noise ratio. The coil is constructed from a novel material with enhanced conductivity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil comprising a novel conductive material.\",\n        \"The coil of claim 1, wherein the conductive material is a silver-coated copper alloy.\",\n        \"A method for improving MRI signal-to-noise ratio using the coil of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67381", "text": "{\n    \"patent_title\": \"Deep Convolutional Neural Networks for Image Classification\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876678B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep convolutional neural network architecture for accurately classifying images. The network utilizes multiple convolutional layers, pooling layers, and fully connected layers to learn hierarchical features from images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8560167B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for classifying images using a deep convolutional neural network.\",\n        \"A system for automatically recognizing objects in images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67381", "text": "{\n    \"patent_title\": \"Method for Enhanced Data Compression in Multimedia Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"David Donoho\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel data compression algorithm that significantly reduces the size of multimedia files while maintaining acceptable quality. The algorithm utilizes wavelet transforms and adaptive quantization techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing multimedia data using wavelet transforms.\",\n        \"A system for transmitting compressed multimedia data.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67382", "text": "{\n    \"patent_title\": \"AI-Powered Diagnostic System for Early Detection of Lung Cancer\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for improving the accuracy of lung cancer detection using deep learning algorithms applied to CT scan images. The system is trained on a large dataset of annotated images and provides radiologists with a risk score for each identified nodule.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"title\": \"Medical Image Analysis using Convolutional Neural Networks\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Automated Nodule Detection in Lung CT Scans\"\n        },\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"title\": \"Deep Learning for Image Segmentation\"\n        },\n        {\n            \"patent_number\": \"US12112233B2\",\n            \"title\": \"Computer-Aided Diagnosis System\"\n        },\n        {\n            \"patent_number\": \"US13131313B2\",\n            \"title\": \"Radiological Image Enhancement Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A system for diagnosing lung cancer comprising a deep learning module configured to analyze CT scan images.\",\n        \"A method for detecting lung nodules in CT scan images with improved accuracy.\",\n        \"A computer-readable medium storing instructions for implementing the system.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67382", "text": "{\n    \"patent_title\": \"Method for Improving Image Compression in Medical Scanners\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-09-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for compressing medical images, reducing storage requirements and transmission bandwidth without significant loss of image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\",\n            \"title\": \"Lossless Image Compression Techniques\"\n        },\n        {\n            \"patent_number\": \"US85432109B2\",\n            \"title\": \"Wavelet-Based Image Compression\"\n        },\n        {\n            \"patent_number\": \"US94321087B2\",\n            \"title\": \"JPEG 2000 Standard for Image Compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing medical images using wavelet transforms.\",\n        \"A system for reducing the file size of medical images.\",\n        \"A computer-readable medium storing instructions for performing image compression.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67383", "text": "{\n    \"patent_title\": \"High-resolution spectral imaging system and method\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A spectral imaging system and method for acquiring high-resolution images with improved contrast and reduced scan time. The system utilizes a novel combination of light sources and detectors to capture detailed spectral information, enhancing image clarity and diagnostic capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in spectral imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A spectral imaging system comprising...\",\n        \"A method for acquiring spectral images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67383", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression in Network Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-08-20\",\n    \"filing_date\": \"2017-08-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel algorithm for compressing data packets for efficient transmission over computer networks. The algorithm utilizes a combination of lossless and lossy compression techniques to minimize bandwidth usage and improve network performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B1\",\n            \"relevance\": \"Prior art in data compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data packets...\",\n        \"A system for transmitting compressed data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67384", "text": "{\n    \"patent_title\": \"Magnetic Resonance Imaging with Enhanced Contrast Agents\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2015-03-15\",\n    \"filing_date\": \"2015-03-15\",\n    \"issue_date\": \"2018-05-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides novel contrast agents for magnetic resonance imaging, resulting in significantly improved image clarity and diagnostic accuracy. The agents target specific biomarkers indicative of early-stage disease.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent for magnetic resonance imaging...\",\n        \"A method for diagnosing a disease using the contrast agent...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67384", "text": "{\n    \"patent_title\": \"X-ray System Calibration Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2016-11-01\",\n    \"issue_date\": \"2019-09-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a method for calibrating x-ray systems to ensure accurate radiation dosage and image quality. It improves the reliability of the system's operation and reduces patient exposure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for calibrating an x-ray system...\",\n        \"An x-ray system calibrated according to the method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67385", "text": "{\n    \"patent_title\": \"High-Capacity Lithium-Ion Battery with Novel Electrolyte\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-06-10\",\n    \"issue_date\": \"2021-03-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery with a novel electrolyte composition exhibiting increased energy density and improved cycle life is disclosed. The electrolyte contains a unique additive that enhances ionic conductivity and suppresses dendrite formation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art related to electrolyte additives\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising: an anode; a cathode; and an electrolyte comprising...\",\n        \"The lithium-ion battery of claim 1, wherein the electrolyte has an ionic conductivity of at least...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67385", "text": "{\n    \"patent_title\": \"Method for Enhancing Solar Cell Efficiency\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2018-11-20\",\n    \"filing_date\": \"2019-01-15\",\n    \"issue_date\": \"2022-06-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for increasing the efficiency of silicon-based solar cells by applying a nanoscale coating to the surface is described. This coating reduces light reflection and enhances electron collection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art related to anti-reflective coatings\"\n        }\n    ],\n    \"claims\": [\n        \"A solar cell comprising: a silicon substrate; and a nanoscale coating applied to the surface of the silicon substrate...\",\n        \"The solar cell of claim 1, wherein the nanoscale coating comprises...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67386", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Enhancement System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2020-07-21\",\n    \"patent_office\": \"US Patent and Trademark Office\",\n    \"abstract\": \"A novel image enhancement system utilizing deep convolutional neural networks to improve image quality and resolution. This system overcomes limitations of traditional image processing techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image denoising\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image comprising...\",\n        \"An apparatus for enhancing an image...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67386", "text": "{\n    \"patent_title\": \"Method for Color Space Conversion\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corp\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"US Patent and Trademark Office\",\n    \"abstract\": \"A method for efficiently converting images between different color spaces, such as RGB and YCbCr.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related art in color management\"\n        }\n    ],\n    \"claims\": [\n        \"A method for converting an image...\",\n        \"A system for performing color space conversion...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67387", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"David A. Gutman\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Michael Lustig\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876342B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for reconstructing medical images with improved clarity and reduced artifacts using compressed sensing techniques and iterative reconstruction algorithms. The invention significantly improves image quality, enabling more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8569835B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for performing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67387", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9546517B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel contrast agent for Magnetic Resonance Imaging (MRI) that enhances the visibility of tumors. The agent exhibits improved biocompatibility and reduced toxicity compared to existing contrast agents.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8927268B2\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent for MRI comprising...\",\n        \"A method for imaging a tumor using the contrast agent of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67388", "text": "{\n    \"patent_title\": \"Deep Convolutional Neural Networks for Image Classification\",\n    \"inventors\": [\n        {\n            \"name\": \"Alex Krizhevsky\",\n            \"affiliation\": \"University of Toronto\"\n        },\n        {\n            \"name\": \"Ilya Sutskever\",\n            \"affiliation\": \"University of Toronto\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"patent_number\": \"US9876789B2\",\n    \"priority_date\": \"2016-09-26\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2021-01-26\",\n    \"patent_office\": \"US\",\n    \"abstract\": \"A deep convolutional neural network architecture for image classification is disclosed. The network includes multiple convolutional layers, pooling layers, and fully connected layers. The network is trained using stochastic gradient descent.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8761545B2\",\n            \"relevance\": \"Highly Related\"\n        },\n        {\n            \"patent_number\": \"US9123456B1\",\n            \"relevance\": \"Related\"\n        },\n        {\n            \"patent_number\": \"US9234567B2\",\n            \"relevance\": \"Related\"\n        },\n        {\n            \"patent_number\": \"US9345678B1\",\n            \"relevance\": \"Related\"\n        },\n        {\n            \"patent_number\": \"US9456789B2\",\n            \"relevance\": \"Related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for classifying images using a deep convolutional neural network.\",\n        \"A deep convolutional neural network architecture comprising multiple convolutional layers.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67388", "text": "{\n    \"patent_title\": \"System and Method for Object Tracking in Video Streams\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2018-11-05\",\n    \"filing_date\": \"2019-02-18\",\n    \"issue_date\": \"2021-03-10\",\n    \"patent_office\": \"US\",\n    \"abstract\": \"A system and method for tracking objects in video streams is described. The system utilizes Kalman filtering and particle filtering techniques to estimate the location of objects in each frame of the video.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related\"\n        },\n        {\n            \"patent_number\": \"US8901234B1\",\n            \"relevance\": \"Related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for tracking objects in a video stream using Kalman filtering.\",\n        \"A system comprising a camera and a processor for tracking objects.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67389", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Cardiac Monitor with Wireless Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MedTech Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2021-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable cardiac monitor for long-term heart rhythm monitoring with wireless data transmission to a remote server. This device aims to improve early detection of arrhythmias and reduce the need for frequent hospital visits, addressing a critical unmet clinical need for patients at risk of sudden cardiac events.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art related to implantable pacemakers\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable cardiac monitor comprising...\",\n        \"A wireless communication module for transmitting data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67389", "text": "{\n    \"patent_title\": \"Improved Surgical Stapler Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Surgical Tools\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-20\",\n    \"filing_date\": \"2018-11-20\",\n    \"issue_date\": \"2020-12-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler featuring enhanced ergonomic design and faster staple deployment. The invention increases surgical efficiency and reduces surgeon fatigue.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Previous surgical stapler designs\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an ergonomic handle...\",\n        \"A staple cartridge with a faster deployment mechanism...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67390", "text": "{\n    \"patent_title\": \"Enhanced Lithium-Ion Battery with Recycled Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"US Patent and Trademark Office\",\n    \"abstract\": \"A lithium-ion battery incorporating recycled cobalt and nickel, significantly reducing the environmental impact of battery production. The battery exhibits improved energy density and cycle life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising a cathode material containing at least 50% recycled cobalt.\",\n        \"A method for manufacturing a lithium-ion battery using recycled materials.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67390", "text": "{\n    \"patent_title\": \"Novel Fuel Cell Design for Automotive Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Motors\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-01-10\",\n    \"issue_date\": \"2023-11-15\",\n    \"patent_office\": \"US Patent and Trademark Office\",\n    \"abstract\": \"A proton exchange membrane fuel cell with improved power output and durability. The fuel cell uses a novel catalyst material for enhanced performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A fuel cell comprising a proton exchange membrane and a novel catalyst.\",\n        \"A method for operating a fuel cell with increased efficiency.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67391", "text": "{\n    \"patent_title\": \"Deep Learning for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-08-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for early cancer detection using deep learning algorithms applied to medical imaging data. The system utilizes convolutional neural networks to identify subtle patterns indicative of cancerous tissue, improving diagnostic accuracy and reducing false positives.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"high\"\n        },\n        {\n            \"patent_number\": \"US1012345678B2\",\n            \"relevance\": \"medium\"\n        },\n        {\n            \"patent_number\": \"US1122334455B1\",\n            \"relevance\": \"high\"\n        },\n        {\n            \"patent_number\": \"US1234567890B2\",\n            \"relevance\": \"medium\"\n        },\n        {\n            \"patent_number\": \"US98765432B2\",\n            \"relevance\": \"high\"\n        },\n        {\n            \"patent_number\": \"US1012345679B2\",\n            \"relevance\": \"medium\"\n        },\n        {\n            \"patent_number\": \"US1122334456B1\",\n            \"relevance\": \"high\"\n        },\n        {\n            \"patent_number\": \"US1234567891B2\",\n            \"relevance\": \"medium\"\n        },\n        {\n            \"patent_number\": \"US98765433B2\",\n            \"relevance\": \"high\"\n        },\n        {\n            \"patent_number\": \"US1012345680B2\",\n            \"relevance\": \"medium\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancer in a subject using deep learning.\",\n        \"A system comprising a deep learning model trained on medical imaging data.\",\n        \"A non-transitory computer-readable medium storing instructions for performing the method.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67391", "text": "{\n    \"patent_title\": \"Medical Device for Monitoring Heart Rate\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-20\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wearable medical device for continuous monitoring of a patient's heart rate. The device transmits data wirelessly to a central monitoring station.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"medium\"\n        },\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"relevance\": \"low\"\n        }\n    ],\n    \"claims\": [\n        \"A wearable medical device for monitoring heart rate.\",\n        \"A system for wirelessly transmitting heart rate data.\",\n        \"A method for analyzing heart rate data.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67392", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Electrolyte for Electric Vehicle Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery featuring a novel electrolyte composition exhibiting improved ionic conductivity and thermal stability, specifically designed for electric vehicle energy storage systems. The electrolyte comprises a blend of lithium salts and organic solvents, enhancing battery performance and lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        },\n        {\n            \"patent_number\": \"US10123456B1\"\n        },\n        {\n            \"patent_number\": \"US11223344B2\"\n        },\n        {\n            \"patent_number\": \"EP3456789A1\"\n        },\n        {\n            \"patent_number\": \"CN108765432B\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition...\",\n        \"A method for enhancing battery performance...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67392", "text": "{\n    \"patent_title\": \"Improved Solar Cell Efficiency using Perovskite Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A solar cell utilizing perovskite materials to achieve enhanced energy conversion efficiency. The perovskite layer is optimized for light absorption and charge carrier transport, resulting in improved performance compared to conventional silicon-based solar cells.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9012345B2\"\n        }\n    ],\n    \"claims\": [\n        \"A solar cell comprising a perovskite layer...\",\n        \"A method for fabricating a perovskite solar cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67393", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Sensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a miniaturized implantable sensor for continuous glucose monitoring, designed to improve patient outcomes through real-time data analysis and personalized feedback. The sensor utilizes a novel biocompatible material and a low-power wireless communication protocol for seamless data transmission. This leads to better diabetes management and reduced complications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable glucose sensor comprising...\",\n        \"A method for continuous glucose monitoring using said sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67393", "text": "{\n    \"patent_title\": \"Surgical Robotic System with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2022-09-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a surgical robotic system with enhanced precision and dexterity. The system incorporates advanced imaging techniques and a novel control algorithm to improve surgical outcomes. The robotic arms are designed for minimally invasive surgical procedures, enhancing patient recovery times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic system comprising...\",\n        \"A method for performing surgical procedures using said system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67394", "text": "{\n    \"patent_title\": \"Implantable Cardiac Monitor with Wireless Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-05-15\",\n    \"filing_date\": \"2020-06-20\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac monitor for long-term monitoring of heart activity, wirelessly transmitting data to a remote receiver for improved patient care. Addresses issues related to arrhythmia detection and heart failure management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for remotely monitoring cardiac activity.\",\n        \"An implantable device for detecting arrhythmias.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67394", "text": "{\n    \"patent_title\": \"Surgical Instrument for Orthopedic Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-03-10\",\n    \"filing_date\": \"2021-04-15\",\n    \"issue_date\": \"2023-02-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical instrument designed for precise bone cutting and shaping during orthopedic procedures. Improves surgical accuracy and reduces patient recovery time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument with enhanced cutting precision.\",\n        \"A method for improving orthopedic surgical outcomes.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67395", "text": "{\n    \"patent_title\": \"Implantable Cardiac Monitor with Extended Battery Life and Remote Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Chen\",\n            \"affiliation\": \"Boston Children's Hospital\"\n        }\n    ],\n    \"patent_number\": \"US10543217B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-01-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac monitor with a novel power management system allowing for over 10 years of continuous operation. The device wirelessly transmits data to a remote monitoring station, enabling proactive detection of arrhythmias and reducing the need for frequent clinical visits. Addresses a significant clinical need for long-term cardiac monitoring without the burden of battery replacements.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8909082B2\",\n            \"title\": \"Wireless Physiological Monitoring System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for continuously monitoring cardiac activity...\",\n        \"An implantable device comprising a low-power processor...\",\n        \"A system for remotely transmitting cardiac data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67395", "text": "{\n    \"patent_title\": \"Improved Syringe for Subcutaneous Insulin Injection\",\n    \"inventors\": [\n        {\n            \"name\": \"John Williams\",\n            \"affiliation\": \"Becton Dickinson\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved syringe design for subcutaneous insulin injection. The syringe features a shortened needle and a pre-filled dosage indicator, increasing ease of use for diabetic patients.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7540045B2\",\n            \"title\": \"Syringe with Dosage Indicator\"\n        }\n    ],\n    \"claims\": [\n        \"A syringe comprising a shortened needle...\",\n        \"A syringe with a pre-filled dosage indicator...\",\n        \"A method for injecting insulin using the syringe...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67396", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A novel method for reconstructing medical images from raw data, resulting in improved clarity and resolution compared to existing techniques. The system utilizes a deep learning algorithm to reduce noise and enhance image features.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8652012B2\",\n            \"title\": \"Medical Image Processing System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for enhancing image clarity comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67396", "text": "{\n    \"patent_title\": \"Improved CT Scan Apparatus\",\n    \"inventors\": [\n        {\n            \"name\": \"Hans Schmidt\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        }\n    ],\n    \"patent_number\": \"EP2543211A1\",\n    \"priority_date\": \"2012-09-10\",\n    \"filing_date\": \"2013-03-08\",\n    \"issue_date\": \"2016-01-27\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"An improved CT scan apparatus with enhanced radiation shielding and faster scan times. This invention focuses on patient safety and operational efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Computed Tomography System\"\n        }\n    ],\n    \"claims\": [\n        \"A CT scan apparatus comprising a radiation shield...\",\n        \"A method for reducing radiation exposure...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67397", "text": "{\n    \"patent_title\": \"High-Resolution Optical Coherence Tomography System for Retinal Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"David Huang\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"James Fujimoto\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A high-resolution optical coherence tomography (OCT) system is disclosed for improved retinal imaging. The system utilizes a novel scanning protocol and signal processing techniques to enhance image resolution and improve the accuracy of diagnosing retinal diseases, leading to earlier and more effective treatment.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8542321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating a high-resolution image of a retinal structure using optical coherence tomography.\",\n        \"An optical coherence tomography system comprising a light source, a scanning mechanism, and a signal processor.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67397", "text": "{\n    \"patent_title\": \"Automated System for Analyzing Mammogram Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Maria Rodriguez\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9234567B1\",\n    \"priority_date\": \"2015-03-15\",\n    \"filing_date\": \"2015-03-16\",\n    \"issue_date\": \"2016-02-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an automated system for analyzing mammogram images to detect potential abnormalities. The system employs machine learning algorithms to identify suspicious regions in mammograms, assisting radiologists in early breast cancer detection. The system focuses on improving workflow efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for analyzing mammogram images using machine learning.\",\n        \"A method for identifying suspicious regions in mammograms.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67398", "text": "{\n    \"patent_title\": \"Deep Learning Architecture for Semantic Image Segmentation\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-11-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep convolutional neural network architecture for accurate semantic image segmentation, capable of understanding complex scenes and object relationships.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for semantic image segmentation using a deep neural network.\",\n        \"A system comprising a convolutional neural network configured to identify objects in an image.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67398", "text": "{\n    \"patent_title\": \"Method for Enhancing Image Contrast\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-07-01\",\n    \"filing_date\": \"2019-12-15\",\n    \"issue_date\": \"2020-04-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A technique for improving the visibility of details in low-contrast images through histogram equalization and adaptive filtering.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for enhancing image contrast using histogram equalization.\",\n        \"A system for applying adaptive filtering to improve image quality.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67399", "text": "{\n    \"patent_title\": \"Deep Convolutional Neural Networks for Image Segmentation\",\n    \"inventors\": [\n        {\n            \"name\": \"Jonathan Long\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Evan Shelhamer\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep convolutional neural network architecture for semantic image segmentation is presented. The architecture leverages fully convolutional networks to produce dense pixel-wise predictions. The approach represents a significant advancement in the field and demonstrates state-of-the-art performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456\"\n        },\n        {\n            \"patent_number\": \"US7654321\"\n        }\n    ],\n    \"claims\": [\n        \"A method for semantic image segmentation using a deep convolutional neural network.\",\n        \"A system comprising a deep convolutional neural network configured to perform semantic image segmentation.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67399", "text": "{\n    \"patent_title\": \"Image Enhancement Using Histogram Equalization\",\n    \"inventors\": [\n        {\n            \"name\": \"David Smith\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US8901234\",\n    \"priority_date\": \"2015-02-15\",\n    \"filing_date\": \"2015-02-13\",\n    \"issue_date\": \"2017-07-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for improving the contrast of images using histogram equalization. This technique is a standard approach in image processing and enhances image visibility. It’s a refinement of well-known techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image contrast using histogram equalization.\",\n        \"An apparatus for performing histogram equalization on an image.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67400", "text": "{\n    \"patent_title\": \"High-Resolution Magnetic Resonance Imaging with Artificial Intelligence Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method for enhancing the resolution and diagnostic accuracy of magnetic resonance images using deep learning algorithms. The system learns to identify and correct for image artifacts, leading to improved visualization of subtle anatomical features.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"MRI Image Reconstruction Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing the resolution of MRI images.\",\n        \"A system for identifying and correcting image artifacts in MRI.\",\n        \"A computer-implemented method for improving diagnostic accuracy in MRI.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67400", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for X-ray Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2013-11-20\",\n    \"filing_date\": \"2013-11-20\",\n    \"issue_date\": \"2017-05-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel contrast agent for X-ray imaging with enhanced visibility of blood vessels. The contrast agent improves image clarity compared to existing barium-based agents.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Barium Sulfate Contrast Agents\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent composition for X-ray imaging.\",\n        \"A method for visualizing blood vessels using the contrast agent.\",\n        \"A formulation of the contrast agent with improved stability.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67401", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Sensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Jennifer Wilcox\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Chen\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-01-20\",\n    \"issue_date\": \"2021-12-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable sensor for continuous glucose monitoring. The device utilizes a novel microfabrication technique to achieve high sensitivity and long-term stability, offering potential for improved diabetes management and personalized healthcare.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable glucose sensor comprising...\",\n        \"A method for continuous glucose monitoring using the sensor...\",\n        \"A system for data transmission and analysis...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67401", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Vascular Access\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Jones\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2022-03-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design with enhanced flexibility and reduced risk of vascular damage. The catheter features a novel tip geometry and biocompatible coating.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible shaft...\",\n        \"A distal tip with a rounded geometry...\",\n        \"A biocompatible coating for reducing friction...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67402", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Enhancement System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-08-20\",\n    \"issue_date\": \"2021-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel image enhancement system utilizing deep learning algorithms to improve image quality and resolution. The system employs convolutional neural networks for noise reduction and detail enhancement.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image filtering.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image quality using deep learning.\",\n        \"An image enhancement system comprising a convolutional neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67402", "text": "{\n    \"patent_title\": \"Improved Method for Image Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Google Research\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-02-10\",\n    \"issue_date\": \"2020-12-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new method for compressing digital images with improved efficiency and reduced file size. The method utilizes wavelet transforms and Huffman coding.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related to image compression techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image using wavelet transforms.\",\n        \"An image compression system utilizing Huffman coding.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67403", "text": "{\n    \"patent_title\": \"Pediatric MRI Enhancement Using Novel Contrast Agents\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-08-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to improved magnetic resonance imaging (MRI) techniques for pediatric patients, utilizing novel contrast agents to enhance image clarity and reduce scan times. The invention particularly benefits young children who struggle to remain still during MRI procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI image quality in pediatric patients...\",\n        \"A contrast agent composition for use in pediatric MRI...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67403", "text": "{\n    \"patent_title\": \"Improved CT Scanning Protocols for Adult Cardiac Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to improved computed tomography (CT) scanning protocols for adult cardiac imaging, focusing on reducing radiation exposure while maintaining diagnostic image quality. The protocols are designed for optimal visualization of coronary arteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A CT scanning protocol for adult cardiac imaging...\",\n        \"A method for reducing radiation exposure during CT scans...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67404", "text": "{\n    \"patent_title\": \"Magnetic Resonance Imaging for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel magnetic resonance imaging technique for early detection of cancerous tumors, utilizing advanced signal processing and contrast agents.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancerous tumors using MRI.\",\n        \"A contrast agent for enhancing MRI signal in cancerous tissues.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67404", "text": "{\n    \"patent_title\": \"Improved Algorithm for Image Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image compression algorithm that reduces file size without significant loss of image quality. The algorithm is applicable to various types of images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"An image compression algorithm based on wavelet transforms.\",\n        \"A method for reducing image file size.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67405", "text": "{\n    \"patent_title\": \"Method and System for Efficient Image Segmentation Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-06-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for image segmentation using deep convolutional neural networks. The system achieves state-of-the-art accuracy and efficiency in segmenting images with complex scenes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"High\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Medium\"\n        },\n        {\n            \"patent_number\": \"US9543210B1\",\n            \"relevance\": \"High\"\n        },\n        {\n            \"patent_number\": \"US10234567B2\",\n            \"relevance\": \"High\"\n        },\n        {\n            \"patent_number\": \"US11345678B2\",\n            \"relevance\": \"Medium\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image segmentation comprising...\",\n        \"A system for image segmentation...\",\n        \"A computer-readable medium...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67405", "text": "{\n    \"patent_title\": \"Method for Improving Image Contrast\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corp\"\n        }\n    ],\n    \"patent_number\": \"US8901234B1\",\n    \"priority_date\": \"2016-05-20\",\n    \"filing_date\": \"2016-05-20\",\n    \"issue_date\": \"2018-01-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for enhancing the contrast of digital images. The method involves applying a histogram equalization technique to improve the visibility of details in the image.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Medium\"\n        },\n        {\n            \"patent_number\": \"US8543210B1\",\n            \"relevance\": \"Low\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image contrast...\",\n        \"A digital image processing system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67406", "text": "{\n    \"patent_title\": \"High-Energy Density Lithium-Ion Battery with Novel Electrolyte\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-09-20\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery featuring a novel electrolyte composition that significantly increases energy density and cycle life. The electrolyte comprises a lithium salt dissolved in a mixture of solvents, enhancing ion conductivity and stability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Lithium-Ion Battery with Improved Safety Features\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67406", "text": "{\n    \"patent_title\": \"Method for Improving Battery Charging Speed\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2022-02-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for rapidly charging lithium-ion batteries by utilizing a pulsed current approach. This method minimizes heat generation and improves charging efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Adaptive Charging Controller for Batteries\"\n        }\n    ],\n    \"claims\": [\n        \"A method for charging a lithium-ion battery comprising...\",\n        \"A charging controller configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67407", "text": "{\n    \"patent_title\": \"Enhanced Magnetic Resonance Imaging with Artificial Intelligence Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-06-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for enhancing magnetic resonance imaging (MRI) using artificial intelligence (AI) reconstruction algorithms. The technique significantly reduces scan time and improves image clarity, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9234567B1\",\n            \"description\": \"Prior art related to MRI image reconstruction.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for MRI image reconstruction comprising...\",\n        \"An MRI system configured to implement the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67407", "text": "{\n    \"patent_title\": \"Improved X-Ray Tube Design for Radiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9546789B1\",\n    \"priority_date\": \"2014-12-01\",\n    \"filing_date\": \"2014-12-01\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents an improved design for X-ray tubes used in radiography, enhancing image quality and reducing radiation exposure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"description\": \"Previous X-ray tube designs.\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube comprising...\",\n        \"A radiography system utilizing the X-ray tube...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67408", "text": "{\n    \"patent_title\": \"Deep Learning for Automated Diabetic Retinopathy Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a deep learning system for the automated detection of diabetic retinopathy in retinal fundus images. The system utilizes convolutional neural networks trained on a large dataset of labeled images to identify early signs of the disease, enabling timely diagnosis and treatment. Applications include automated screening programs and assisting ophthalmologists in clinical settings.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Analysis System\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Medical Image Processing\"\n        },\n        {\n            \"patent_number\": \"US11987654B2\",\n            \"title\": \"Neural Network Architecture for Image Classification\"\n        },\n        {\n            \"patent_number\": \"US12345678B2\",\n            \"title\": \"Automated Disease Detection\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Convolutional Neural Networks\"\n        },\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"title\": \"Retinal Image Analysis\"\n        },\n        {\n            \"patent_number\": \"US10987654B2\",\n            \"title\": \"Deep Learning Applications in Healthcare\"\n        },\n        {\n            \"patent_number\": \"US11876543B2\",\n            \"title\": \"Automated Medical Diagnosis\"\n        },\n        {\n            \"patent_number\": \"US12098765B2\",\n            \"title\": \"Image Recognition Systems\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"title\": \"Medical Imaging Techniques\"\n        },\n        {\n            \"patent_number\": \"US10876543B2\",\n            \"title\": \"Artificial Intelligence in Medicine\"\n        }\n    ],\n    \"claims\": [\n        \"A system for detecting diabetic retinopathy...\",\n        \"A method for analyzing retinal images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67408", "text": "{\n    \"patent_title\": \"Improved Image Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charles Brown\",\n            \"affiliation\": \"TechCorp Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11998877B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2021-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel image compression algorithm that reduces file size while maintaining high image quality. The algorithm utilizes wavelet transforms and entropy coding techniques to achieve significant compression ratios. Applications include digital photography, video streaming, and image archiving.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Wavelet Transform for Image Compression\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Entropy Coding Techniques\"\n        },\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Compression Standards\"\n        }\n    ],\n    \"claims\": [\n        \"An image compression algorithm comprising...\",\n        \"A method for encoding image data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67409", "text": "{\n    \"patent_title\": \"Miniaturized Surgical Instrument with Integrated Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-01-20\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized surgical instrument incorporating a high-resolution imaging system for improved visualization during minimally invasive procedures. The device allows for enhanced precision and reduced patient trauma.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art relating to surgical robotics\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising: a miniaturized body...\",\n        \"An imaging system integrated within the surgical instrument...\",\n        \"A method for performing minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67409", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Medtronic\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Boston Scientific\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-15\",\n    \"issue_date\": \"2020-12-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel catheter design with improved flow characteristics for targeted drug delivery.  The catheter utilizes a biocompatible coating to minimize inflammation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous catheter designs\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising: a flexible tube...\",\n        \"A biocompatible coating applied to the tube...\",\n        \"A method for delivering a therapeutic agent...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67410", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Implantable Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized, wireless, implantable pressure sensor system for continuous monitoring of physiological pressures. The system utilizes low-power circuitry and a biocompatible housing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"year\": \"2018\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"year\": \"2019\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless implantable pressure sensor...\",\n        \"A method for monitoring physiological pressure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67410", "text": "{\n    \"patent_title\": \"Improved Surgical Scalpel Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11556677B1\",\n    \"priority_date\": \"2022-05-10\",\n    \"filing_date\": \"2022-05-10\",\n    \"issue_date\": \"2024-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical scalpel with an improved handle design for enhanced grip and precision.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US4567890A\",\n            \"year\": \"1986\"\n        },\n        {\n            \"patent_number\": \"US5678901A\",\n            \"year\": \"1997\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical scalpel comprising...\",\n        \"A handle for a surgical scalpel...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67411", "text": "{\n    \"patent_title\": \"Ergonomic Insulin Pen for Enhanced Grip and Injection Comfort\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, San Francisco\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Dexcom Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-12-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An insulin pen with an enlarged, textured grip and a low-force injection mechanism is disclosed. The pen is designed to improve ease of use and reduce discomfort during insulin injections, particularly for patients with arthritis or limited dexterity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art related to insulin pen designs.\"\n        }\n    ],\n    \"claims\": [\n        \"A handheld insulin pen comprising an ergonomic grip...\",\n        \"A low-force injection mechanism for reducing patient discomfort...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67411", "text": "{\n    \"patent_title\": \"Surgical Robot with Enhanced Precision Control\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Intuitive Surgical\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-06-05\",\n    \"issue_date\": \"2022-01-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A robotic surgical system with improved precision and control is described. The system utilizes advanced sensors and algorithms to enable surgeons to perform minimally invasive procedures with greater accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Prior art related to surgical robotics.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic system comprising a plurality of robotic arms...\",\n        \"A control system for precise manipulation of surgical instruments...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67412", "text": "{\n    \"patent_title\": \"Method and System for Adaptive Image Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Adobe Systems\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2018-06-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for adaptively enhancing the clarity of images by analyzing image characteristics and applying optimal filtering techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"Prior art in image filtering.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image clarity comprising...\",\n        \"A system for adaptively filtering images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67412", "text": "{\n    \"patent_title\": \"Digital Image Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-05-20\",\n    \"issue_date\": \"2017-11-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new algorithm for compressing digital images without significant loss of quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"relevance\": \"Related work in image compression.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a digital image comprising...\",\n        \"A system for encoding image data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67413", "text": "{\n    \"patent_title\": \"Method and System for Real-Time Object Recognition in Video Streams\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University AI Lab\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT Computer Vision Group\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-04-20\",\n    \"issue_date\": \"2022-09-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for real-time object recognition in video streams using deep convolutional neural networks. The system is designed for use in autonomous vehicles and surveillance applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Prior art in object detection\"\n        }\n    ],\n    \"claims\": [\n        \"A method for recognizing objects in a video stream comprising...\",\n        \"A system for real-time object recognition...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67413", "text": "{\n    \"patent_title\": \"A Novel Mathematical Framework for Image Transformation\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"California Institute of Technology\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-06-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This patent describes a novel mathematical framework for image transformation based on wavelet decomposition and fractal geometry. The framework provides a new approach to image compression and analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US1012345678B2\",\n            \"relevance\": \"Related work on wavelet transforms\"\n        }\n    ],\n    \"claims\": [\n        \"A mathematical framework for image transformation comprising...\",\n        \"A method for image compression based on fractal geometry...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67414", "text": "{\n    \"patent_title\": \"Neural Network Architecture for Efficient Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel neural network architecture designed for efficient image recognition, leveraging sparse connectivity and dynamic routing. Achieves state-of-the-art performance on benchmark datasets with significantly reduced computational cost.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in convolutional neural networks.\"\n        }\n    ],\n    \"claims\": [\n        \"A neural network architecture comprising a plurality of sparse layers.\",\n        \"A method for dynamic routing in a neural network.\",\n        \"A system for efficient image recognition using the described architecture.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67414", "text": "{\n    \"patent_title\": \"Improved Data Preprocessing Technique for Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2020-07-20\",\n    \"filing_date\": \"2020-07-20\",\n    \"issue_date\": \"2023-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improvement to existing data preprocessing techniques used in machine learning, specifically focusing on outlier detection and normalization. Offers a slight performance increase over current methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"Existing outlier detection algorithm.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for identifying outliers in a dataset.\",\n        \"A data normalization technique.\",\n        \"A system for preprocessing data for machine learning applications.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67415", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Super-Resolution with Generative Adversarial Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Jiahao Wang\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Xin Liu\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11878942B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2023-11-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image super-resolution method utilizing generative adversarial networks to reconstruct high-resolution images from low-resolution counterparts. The method significantly improves perceptual quality compared to existing techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876345B1\",\n            \"title\": \"Image Enhancement using Convolutional Neural Networks\"\n        }\n    ],\n    \"claims\": [\n        \"A method for super-resolving an image comprising:\",\n        \"  a) receiving a low-resolution image;\",\n        \"  b) applying a generative adversarial network to the low-resolution image to generate a high-resolution image;\",\n        \"  c) optimizing the generative adversarial network based on a perceptual loss function.\",\n        \"The method of claim 1, wherein the perceptual loss function comprises a combination of adversarial loss and content loss.\",\n        \"The method of claim 2, wherein the content loss is based on VGG features.\",\n        \"A system for super-resolving an image...\",\n        \"The system of claim 4, comprising a GPU for accelerating the generative adversarial network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67415", "text": "{\n    \"patent_title\": \"Method for Compressing Medical Images Using Wavelet Transform\",\n    \"inventors\": [\n        {\n            \"name\": \"Elena Rodriguez\",\n            \"affiliation\": \"University of Barcelona\"\n        }\n    ],\n    \"patent_number\": \"US10549876B2\",\n    \"priority_date\": \"2018-06-20\",\n    \"filing_date\": \"2019-12-05\",\n    \"issue_date\": \"2020-02-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for efficiently compressing medical images using a wavelet transform. This technique reduces storage requirements and transmission bandwidth while maintaining acceptable image quality for diagnostic purposes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Wavelet-Based Image Compression System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a medical image comprising:\",\n        \"  a) applying a wavelet transform to the medical image;\",\n        \"  b) quantizing the wavelet coefficients;\",\n        \"  c) encoding the quantized wavelet coefficients.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67416", "text": "{\n    \"patent_title\": \"Method and System for Intelligent Image Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for intelligent image enhancement. It utilizes deep learning techniques to analyze image characteristics and improve visual quality by reducing noise and enhancing details. The system can be applied to various image types, including photographs and medical images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Denoising Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image quality comprising...\",\n        \"A system for processing images...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The method of claim 1, wherein...\",\n        \"The system of claim 2, wherein...\",\n        \"The method of claim 3, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67416", "text": "{\n    \"patent_title\": \"Digital Signal Processing for Audio Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-03-01\",\n    \"issue_date\": \"2022-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to digital signal processing techniques for improving audio quality. It describes a novel filtering method to reduce noise in audio recordings. The system improves clarity and fidelity in sound reproduction.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Audio Filtering Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for filtering audio signals comprising...\",\n        \"A system for processing audio...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The method of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67417", "text": "{\n    \"patent_title\": \"Deep Convolutional Neural Networks for Robust Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alexei Krizhevsky\",\n            \"affiliation\": \"University of Toronto\"\n        },\n        {\n            \"name\": \"Ilya Sutskever\",\n            \"affiliation\": \"University of Toronto\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"patent_number\": \"US9483054B2\",\n    \"priority_date\": \"2012-09-10\",\n    \"filing_date\": \"2015-09-10\",\n    \"issue_date\": \"2016-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a deep convolutional neural network architecture for image recognition.  The network utilizes multiple convolutional layers, pooling layers, and fully connected layers to achieve state-of-the-art performance on the ImageNet Large Scale Visual Recognition Challenge (ILSVRC). The novel combination of network depth, non-saturating ReLU activations, and dropout regularization significantly reduces error rates, demonstrating a substantial advancement in the field of image recognition. The architecture has been applied to object detection and image classification tasks with exceptional results.  The innovation lies in the network's ability to automatically learn hierarchical feature representations from raw pixel data without requiring manual feature engineering.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8234010B2\",\n            \"title\": \"System and method for object recognition\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"An apparatus for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67417", "text": "{\n    \"patent_title\": \"Method for Enhancing Image Contrast\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Image Processing Corp.\"\n        }\n    ],\n    \"patent_number\": \"US8560022B1\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2013-05-15\",\n    \"issue_date\": \"2013-10-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method for improving the contrast of digital images. The method involves applying a histogram equalization algorithm to the image, followed by sharpening using a Laplacian filter. The result is an image with increased clarity and detail. The system also includes a user interface for selecting image processing parameters.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7899012B2\",\n            \"title\": \"Adaptive histogram equalization method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image contrast comprising...\",\n        \"An apparatus for enhancing image contrast comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67418", "text": "{\n    \"patent_title\": \"Deep Learning for Automated Detection of Lung Nodules in CT Scans\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11567890B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for automatically detecting lung nodules in computed tomography (CT) scans using a deep convolutional neural network. The system is trained on a large dataset of CT scans with expert annotations and achieves high accuracy and sensitivity in detecting small and subtle nodules.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in image segmentation\"\n        },\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"Related work on deep learning for medical diagnosis\"\n        },\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"relevance\": \"Similar approach to automated nodule detection\"\n        },\n        {\n            \"patent_number\": \"US12345678B2\",\n            \"relevance\": \"Used for training data augmentation\"\n        },\n        {\n            \"patent_number\": \"US13456789B2\",\n            \"relevance\": \"Alternative method for feature extraction\"\n        },\n        {\n            \"patent_number\": \"US14567890B2\",\n            \"relevance\": \"Comparison benchmark\"\n        },\n        {\n            \"patent_number\": \"US15678901B2\",\n            \"relevance\": \"Used for evaluation metrics\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting lung nodules in CT scans comprising...\",\n        \"A system for automatically identifying potential cancerous regions in lung tissue...\",\n        \"A computer-readable medium storing instructions for...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67418", "text": "{\n    \"patent_title\": \"Improved Image Compression for Medical DICOM Files\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11098765B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2022-11-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for compressing Digital Imaging and Communications in Medicine (DICOM) files using a novel wavelet transform. This improves storage efficiency and transmission speeds for medical images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art in DICOM compression\"\n        },\n        {\n            \"patent_number\": \"US9654321B1\",\n            \"relevance\": \"Related work on wavelet transforms\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing DICOM images comprising...\",\n        \"A system for reducing the file size of medical images...\",\n        \"A computer-readable medium storing instructions for...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67419", "text": "{\n    \"patent_title\": \"Method for Noise Reduction in Magnetic Resonance Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2015-03-15\",\n    \"filing_date\": \"2015-05-20\",\n    \"issue_date\": \"2018-07-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel method for reducing noise in magnetic resonance images (MRI) using a wavelet transform and adaptive filtering. The technique significantly enhances image clarity, allowing for improved diagnostic accuracy. It also minimizes artifacts commonly associated with low signal-to-noise ratios.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing noise in MRI comprising...\",\n        \"An MRI system configured to implement the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67419", "text": "{\n    \"patent_title\": \"Automated System for X-Ray Image Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2016-02-29\",\n    \"filing_date\": \"2016-04-15\",\n    \"issue_date\": \"2019-05-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an automated system for analyzing X-ray images to detect bone fractures. The system utilizes machine learning algorithms to identify potential fracture sites and provide real-time feedback to radiologists. The aim is to improve the efficiency and accuracy of fracture diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for automated fracture detection comprising...\",\n        \"A method for analyzing X-ray images using machine learning...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67420", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical Instrument with Integrated Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2022-05-15\",\n    \"filing_date\": \"2020-07-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical instrument designed for minimally invasive procedures, incorporating a high-resolution imaging system for enhanced visualization and precision.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising an elongated shaft...\",\n        \"An imaging system integrated within the surgical instrument...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67420", "text": "{\n    \"patent_title\": \"Automated Drug Delivery System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2023-03-10\",\n    \"filing_date\": \"2021-11-01\",\n    \"issue_date\": \"2023-05-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for automated drug delivery, including a pump and control mechanisms for precise dosage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A drug delivery system comprising a pump...\",\n        \"A control system for regulating drug dosage...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67421", "text": "{\n    \"patent_title\": \"Magnetic Resonance Elastography for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Mary Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for early cancer detection using magnetic resonance elastography, providing enhanced image contrast and improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancerous tissue...\",\n        \"A system for performing magnetic resonance elastography...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67421", "text": "{\n    \"patent_title\": \"Improved CT Scanner Calibration Techniques\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-05-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details improved calibration techniques for computed tomography (CT) scanners, enhancing image quality and reducing radiation exposure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for calibrating a CT scanner...\",\n        \"A system for reducing radiation exposure during CT scans...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67422", "text": "{\n    \"patent_title\": \"Contrast-enhanced spectral CT perfusion imaging for assessing tumor response\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Stanford University Medical Center\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to methods and systems for performing contrast-enhanced spectral CT perfusion imaging to assess tumor response to therapy. The use of spectral CT allows for improved contrast and accuracy in measuring tumor perfusion.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for assessing tumor response comprising...\",\n        \"A system for performing spectral CT perfusion imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67422", "text": "{\n    \"patent_title\": \"Improved MRI Coil Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel design for MRI coils that improves signal-to-noise ratio and image quality.  The design utilizes a new material and geometry to enhance performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil comprising...\",\n        \"A method for constructing an MRI coil...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67423", "text": "{\n    \"patent_title\": \"Miniature Robotic Catheter for Targeted Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature robotic catheter designed for precise and targeted drug delivery within the cardiovascular system. The catheter utilizes micro-actuators and real-time imaging feedback to navigate complex anatomical structures with minimal invasiveness.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Remote Control Surgical Systems\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic catheter comprising a flexible shaft...\",\n        \"A system for targeted drug delivery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67423", "text": "{\n    \"patent_title\": \"Improved Surgical Stapler Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler with enhanced tissue compression and reduced firing force. This design aims to improve surgical outcomes in open abdominal procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Surgical Stapling Apparatus\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising a housing...\",\n        \"A cartridge for delivering staples...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67424", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Robotic Assistance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical system designed for minimally invasive procedures. Utilizes robotic assistance and advanced imaging techniques to enhance precision and reduce patient recovery time. This system represents a significant advancement in surgical technology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising a robotic arm...\",\n        \"A method for performing a minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67424", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Cardiovascular Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-01-10\",\n    \"issue_date\": \"2023-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design for delivering therapeutic agents to cardiovascular tissues. Enhancements in flexibility and biocompatibility improve patient outcomes. This design provides optimized access to difficult-to-reach areas.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"relevance\": \"Related catheter technology\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible shaft...\",\n        \"A method for delivering a therapeutic agent...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67425", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable biosensor for continuous glucose monitoring. The device utilizes a novel enzymatic reaction and microfabrication techniques to provide highly accurate and reliable glucose readings, improving patient management of diabetes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable biosensor comprising...\",\n        \"A method for continuous glucose monitoring using said biosensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67425", "text": "{\n    \"patent_title\": \"Surgical Instrument Sterilization System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"SterilTech Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-06-01\",\n    \"filing_date\": \"2019-12-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel sterilization system for surgical instruments utilizing plasma technology. The system provides rapid and effective sterilization, reducing turnaround time in operating rooms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A sterilization system comprising a plasma chamber...\",\n        \"A method for sterilizing surgical instruments using said system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67426", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction with Reduced Radiation Dose\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method and system for reconstructing medical images from low-dose radiation data, improving image clarity while minimizing patient exposure. The method employs a deep learning algorithm to enhance image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in image reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for performing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67426", "text": "{\n    \"patent_title\": \"Automated System for Drug Dispensing in Hospitals\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-05-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for dispensing medication in hospital settings, reducing errors and improving efficiency. The system includes a robotic arm and a barcode scanner.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Existing automated dispensing systems\"\n        }\n    ],\n    \"claims\": [\n        \"A system for dispensing medication comprising...\",\n        \"A method for operating the system of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67427", "text": "{\n    \"patent_title\": \"Enhanced Magnetic Resonance Imaging for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"David Haussler\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jennifer Dionne\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10543217B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2020-11-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel magnetic resonance imaging (MRI) technique utilizing advanced signal processing and contrast agents to significantly improve the detection of early-stage cancerous tumors.  The method demonstrates increased sensitivity and specificity compared to conventional MRI.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in contrast agent development\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancerous tumors...\",\n        \"An MRI apparatus configured to perform the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67427", "text": "{\n    \"patent_title\": \"Improved Calibration Method for Ultrasound Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2021-08-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details an improved method for calibrating ultrasound transducers, resulting in slightly more accurate image resolution. The calibration process is automated and reduces errors associated with manual adjustment.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Previous methods for ultrasound calibration\"\n        }\n    ],\n    \"claims\": [\n        \"A method for calibrating an ultrasound transducer...\",\n        \"A system for automated ultrasound calibration...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67428", "text": "{\n    \"patent_title\": \"Method and System for Enhanced MRI Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for reconstructing Magnetic Resonance Images (MRI) with improved resolution and reduced scan time. The method utilizes a deep learning algorithm to enhance image quality and minimize artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on MRI reconstruction techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"A system for performing MRI image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67428", "text": "{\n    \"patent_title\": \"Improved X-ray Shielding Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US8654321B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2017-05-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new composite material for shielding against X-ray radiation. The material offers improved attenuation properties compared to existing lead-based shields.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art in X-ray shielding.\"\n        }\n    ],\n    \"claims\": [\n        \"A shielding material comprising...\",\n        \"A method for manufacturing a shielding material...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67429", "text": "{\n    \"patent_title\": \"Method and System for Super-Resolution Image Reconstruction Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Li Wang\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jia Deng\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876345B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for reconstructing a high-resolution image from a low-resolution image using deep convolutional neural networks. The network is trained to learn a mapping function between low-resolution and high-resolution image patches, allowing for significant improvements in image quality and resolution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760521B1\",\n            \"title\": \"Image Enhancement Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for super-resolution image reconstruction...\",\n        \"A system comprising a deep convolutional neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67429", "text": "{\n    \"patent_title\": \"System and Method for Image Format Conversion\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Adobe Systems Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9253467B1\",\n    \"priority_date\": \"2016-05-20\",\n    \"filing_date\": \"2016-05-20\",\n    \"issue_date\": \"2016-09-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for converting images between different file formats, such as JPEG, PNG, and GIF. The system efficiently handles large image files and provides a user-friendly interface.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for converting an image from a first format to a second format...\",\n        \"A system for providing a user interface for image format conversion...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67430", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Detection of Micro-Calcifications in Mammography\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for improving the detection of micro-calcifications in mammography images using advanced image processing techniques and machine learning algorithms. The system enhances contrast and reduces noise, enabling radiologists to identify subtle anomalies with greater accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9120987B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting micro-calcifications in mammography images comprising...\",\n        \"A system for enhancing mammography images comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67430", "text": "{\n    \"patent_title\": \"Improved Display Technology for Medical Monitors\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11123456B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2021-01-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved display technology for medical monitors that enhances image clarity and color accuracy, leading to better visualization of medical images. The invention focuses on reducing glare and improving contrast ratio.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A medical monitor comprising a display panel with...\",\n        \"A method for reducing glare on a medical monitor comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67431", "text": "{\n    \"patent_title\": \"High-Resolution Magnetic Resonance Imaging with Accelerated Acquisition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for acquiring high-resolution magnetic resonance images with significantly reduced scan times. The invention utilizes a novel k-space sampling trajectory and image reconstruction algorithm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"cited_by\": \"Alice Johnson et al.\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"cited_by\": \"Bob Williams\"\n        },\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"cited_by\": \"Alice Johnson et al.\"\n        },\n        {\n            \"patent_number\": \"US8987654B2\",\n            \"cited_by\": \"Bob Williams\"\n        },\n        {\n            \"patent_number\": \"US9234567B2\",\n            \"cited_by\": \"Alice Johnson et al.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for acquiring magnetic resonance images...\",\n        \"A system for performing magnetic resonance imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67431", "text": "{\n    \"patent_title\": \"Improved X-Ray Shielding for Dental Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Dental Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved X-ray shielding device for use during dental procedures, designed to minimize radiation exposure to patients and operators.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"cited_by\": \"Carol Davis\"\n        },\n        {\n            \"patent_number\": \"US8234567B2\",\n            \"cited_by\": \"Carol Davis\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray shielding device comprising...\",\n        \"A method for using the shielding device...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67432", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method and system for reconstructing medical images with significantly enhanced clarity and resolution, utilizing a new iterative algorithm and advanced image processing techniques. The resulting images exhibit improved diagnostic capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for reconstructing a medical image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67432", "text": "{\n    \"patent_title\": \"Surgical Instrument with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11223344B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a surgical instrument designed with improved ergonomics for enhanced surgical precision and reduced surgeon fatigue. The instrument features a novel handle design and adjustable features.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        },\n        {\n            \"patent_number\": \"US8901234B1\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising...\",\n        \"An ergonomic handle for a surgical instrument...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67433", "text": "{\n    \"patent_title\": \"Enhanced Lithium-Ion Battery Management System for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery management system utilizing advanced algorithms and sensor integration to significantly extend battery life in mobile devices. This system optimizes charging cycles, predicts battery degradation, and dynamically adjusts power consumption based on user behavior.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Lithium-Ion Battery Charging Control\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery charging cycles...\",\n        \"A mobile device incorporating the battery management system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67433", "text": "{\n    \"patent_title\": \"Improved Charging Cable for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Samsung Electronics\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-01\",\n    \"issue_date\": \"2023-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A charging cable with improved durability and data transfer speed for mobile devices. The cable utilizes a reinforced connector and shielding to prevent damage and ensure reliable performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"title\": \"Data Cable Connector\"\n        }\n    ],\n    \"claims\": [\n        \"A charging cable comprising...\",\n        \"A connector for a charging cable...\",\n        \"A method for manufacturing a durable charging cable...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67434", "text": "{\n    \"patent_title\": \"Contrast-Enhanced Ultrasound Imaging System with Adaptive Frequency Tuning\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2018-02-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an ultrasound imaging system utilizing adaptive frequency tuning to improve image quality in the presence of microbubble contrast agents. The system dynamically adjusts frequency to minimize signal distortion and enhance visualization of subtle vascular structures, improving diagnostic accuracy in detecting early-stage tumors.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Ultrasound Beamforming Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for ultrasound imaging comprising:...\",\n        \"An ultrasound imaging system comprising:...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67434", "text": "{\n    \"patent_title\": \"Improved MRI Coil Design for Brain Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2017-12-15\",\n    \"issue_date\": \"2022-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel MRI coil design that improves signal-to-noise ratio in brain imaging. The coil utilizes a phased array configuration and optimized impedance matching network.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"MRI Pulse Sequence Optimization\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil comprising:...\",\n        \"A method for brain imaging using the MRI coil...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67435", "text": "{\n    \"patent_title\": \"High-Resolution Optical Coherence Tomography System\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-04-20\",\n    \"issue_date\": \"2022-08-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel optical coherence tomography (OCT) system capable of achieving unprecedented resolution in biological tissue imaging. The system incorporates a new wavefront shaping technique to minimize scattering and enhance image clarity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating a high-resolution OCT image...\",\n        \"An OCT system comprising a wavefront shaping module...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67435", "text": "{\n    \"patent_title\": \"MRI Coil Design for Enhanced Signal-to-Noise Ratio\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-06-15\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel MRI coil design that improves signal-to-noise ratio, leading to faster scan times and more detailed anatomical images. The coil utilizes a unique geometric configuration to maximize signal capture.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil comprising a geometrically optimized array...\",\n        \"A method for enhancing MRI signal-to-noise ratio...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67436", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University, Department of Radiology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for enhancing the resolution and clarity of medical images acquired using computed tomography (CT) and magnetic resonance imaging (MRI). The method involves a novel image reconstruction algorithm that minimizes noise and artifacts, resulting in improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"relevance\": \"Prior art in image reconstruction techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing the resolution of a medical image...\",\n        \"A system for reconstructing a medical image with reduced noise...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67436", "text": "{\n    \"patent_title\": \"Apparatus for Automated Cell Counting\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an automated apparatus for accurately counting cells in a fluid sample. The apparatus utilizes image processing techniques to identify and count individual cells. The system is designed for high-throughput analysis in biological research and clinical diagnostics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Previous approaches to cell counting.\"\n        }\n    ],\n    \"claims\": [\n        \"An apparatus for automated cell counting...\",\n        \"A method for identifying cells in a fluid sample...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67437", "text": "{\n    \"patent_title\": \"Comfortable and Secure Wearable Medical Sensor\",\n    \"inventors\": [\n        {\n            \"name\": \"David Chen\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-11-20\",\n    \"issue_date\": \"2021-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wearable medical sensor designed for prolonged use with a focus on minimizing skin irritation and maximizing comfort. The device incorporates flexible materials and a novel adhesive system.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on wearable sensors\"\n        }\n    ],\n    \"claims\": [\n        \"A wearable medical sensor comprising a flexible substrate.\",\n        \"An adhesive system configured to minimize skin irritation.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67437", "text": "{\n    \"patent_title\": \"High-Throughput Blood Analysis Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jessica Williams\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2018-12-01\",\n    \"filing_date\": \"2019-06-10\",\n    \"issue_date\": \"2020-12-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A device for rapid and accurate blood analysis utilizing microfluidic technology. Designed for high-throughput clinical diagnostic applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"Prior art on microfluidic devices\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device for blood analysis.\",\n        \"A system for automated blood sample processing.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67438", "text": "{\n    \"patent_title\": \"Improved Contrast Enhancement in Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-12-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method for enhancing contrast in magnetic resonance imaging (MRI) by utilizing a novel pulse sequence and image reconstruction algorithm. The technique builds upon existing MRI technology to improve image clarity and diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"MRI Pulse Sequence Optimization\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing contrast in MRI comprising...\",\n        \"An MRI system configured to implement the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67438", "text": "{\n    \"patent_title\": \"Novel Terahertz Imaging System for Non-Destructive Testing\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-08-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A completely new imaging system utilizing terahertz radiation for non-destructive testing of materials.  The system does not rely on existing imaging modalities and provides unprecedented resolution and penetration depth.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A terahertz imaging system comprising...\",\n        \"A method for non-destructive testing using terahertz radiation...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67439", "text": "{\n    \"patent_title\": \"Improved MRI Techniques for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-06-10\",\n    \"issue_date\": \"2018-12-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel magnetic resonance imaging (MRI) techniques for enhanced detection of cancerous tumors at early stages. The method utilizes a new contrast agent and a specific pulse sequence to improve image clarity and sensitivity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancer using MRI with a specific contrast agent.\",\n        \"An MRI system configured for enhanced cancer detection.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67439", "text": "{\n    \"patent_title\": \"Advanced Ultrasound Imaging for Cardiovascular Diagnosis\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-04-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved ultrasound imaging system for detailed visualization of the cardiovascular system, allowing for more accurate diagnosis of heart conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9012345B2\"\n        }\n    ],\n    \"claims\": [\n        \"An ultrasound system with enhanced resolution.\",\n        \"A method for cardiovascular imaging using the ultrasound system.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67440", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Enhancement for Low-Light Conditions\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-11-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for enhancing images captured in low-light conditions. The method utilizes a generative adversarial network (GAN) to restore details and improve visual quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing images comprising...\",\n        \"An image enhancement system comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67440", "text": "{\n    \"patent_title\": \"Improved Color Calibration Algorithm for Digital Cameras\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Kodak\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-12-10\",\n    \"filing_date\": \"2019-12-10\",\n    \"issue_date\": \"2022-09-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved algorithm for calibrating the color reproduction of digital cameras, enhancing the accuracy of color rendering in various lighting conditions.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for color calibration comprising...\",\n        \"A digital camera utilizing the color calibration method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67441", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Point-of-Care Diagnostics\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel microfluidic device enabling rapid and accurate point-of-care diagnostics for a wide range of biomarkers. The device utilizes a unique channel design and surface chemistry to enhance sensitivity and reduce analysis time, representing a significant advancement in diagnostic technology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for detecting biomarkers...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67441", "text": "{\n    \"patent_title\": \"Improved Syringe Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved syringe design featuring a more ergonomic grip and a modified plunger mechanism for smoother fluid delivery. This design offers enhanced comfort and ease of use for healthcare professionals.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\"\n        }\n    ],\n    \"claims\": [\n        \"A syringe comprising...\",\n        \"A plunger mechanism...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67442", "text": "{\n    \"patent_title\": \"Deep Learning for Image Super-Resolution\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2019-10-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep convolutional neural network architecture for enhancing the resolution of images.  The system utilizes residual learning and skip connections to generate high-resolution images from low-resolution inputs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for super-resolving an image...\",\n        \"A system for enhancing image resolution...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67442", "text": "{\n    \"patent_title\": \"Method for Color Space Conversion in Digital Images\",\n    \"inventors\": [\n        {\n            \"name\": \"David A. Forsyth\",\n            \"affiliation\": \"University of Washington\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2017-03-10\",\n    \"filing_date\": \"2017-03-10\",\n    \"issue_date\": \"2018-07-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel algorithm for efficiently converting between different color spaces in digital image processing. The method leverages lookup tables for fast and accurate conversion.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for converting a color value...\",\n        \"A system for color space transformation...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67443", "text": "{\n    \"patent_title\": \"Deep Learning Enhanced MRI Reconstruction for Improved Diagnostic Accuracy\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-01-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel method for MRI image reconstruction utilizing deep learning algorithms. The method significantly improves image quality and reduces scan time, leading to enhanced diagnostic accuracy in detecting subtle anomalies. The system employs convolutional neural networks to learn complex image patterns, resulting in superior image reconstruction compared to traditional techniques, and is particularly suited for identifying early-stage cancerous tissues.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"MRI Image Enhancement Using Wavelet Transform\"\n        }\n    ],\n    \"claims\": [\n        \"A method for MRI image reconstruction comprising: applying a deep learning algorithm to raw MRI data; generating a reconstructed image; and displaying the reconstructed image.\",\n        \"The method of claim 1, wherein the deep learning algorithm is a convolutional neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67443", "text": "{\n    \"patent_title\": \"Improved X-Ray Imaging System with Enhanced Contrast\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"University of Michigan\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2021-07-13\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved X-ray imaging system incorporating a novel contrast agent delivery mechanism. The system provides significantly enhanced image contrast, allowing for clearer visualization of anatomical structures. The system is designed for faster image acquisition and lower radiation dose compared to conventional X-ray systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"title\": \"Digital Radiography System with Automated Exposure Control\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising: a contrast agent delivery mechanism; an X-ray source; and a detector.\",\n        \"The X-ray imaging system of claim 1, wherein the contrast agent delivery mechanism is a microbubble-based system.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67444", "text": "{\n    \"patent_title\": \"Enhanced Medical Image Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel deep learning framework for reconstructing high-resolution medical images from low-dose data, significantly improving image clarity and reducing radiation exposure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Prior Art Image Reconstruction Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"A system comprising a processor...\",\n        \"The method of claim 1, wherein the deep learning framework is a convolutional neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67444", "text": "{\n    \"patent_title\": \"Improved Automotive Engine Control System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Motors\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Ford Motor Company\"\n        }\n    ],\n    \"patent_number\": \"US10243789B1\",\n    \"priority_date\": \"2016-08-22\",\n    \"filing_date\": \"2016-08-22\",\n    \"issue_date\": \"2018-11-13\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An advanced control system for internal combustion engines, optimizing fuel efficiency and reducing emissions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Existing Engine Control System\"\n        }\n    ],\n    \"claims\": [\n        \"An engine control system comprising a processor...\",\n        \"A method for controlling fuel injection...\",\n        \"The system of claim 1, wherein the processor is programmed to...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67445", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Super-Resolution Using Generative Adversarial Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"UC Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-06-01\",\n    \"issue_date\": \"2021-12-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for image super-resolution is presented, utilizing generative adversarial networks to produce high-resolution images with enhanced detail and perceptual quality. The approach significantly outperforms existing methods in subjective and objective evaluations.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Enhancement System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for super-resolving an image comprising...\",\n        \"An apparatus for performing image super-resolution...\",\n        \"A computer program product for...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67445", "text": "{\n    \"patent_title\": \"Method for Color Image Filtering\",\n    \"inventors\": [\n        {\n            \"name\": \"Eve Miller\",\n            \"affiliation\": \"XYZ Corp\"\n        },\n        {\n            \"name\": \"Frank Green\",\n            \"affiliation\": \"ABC Inc\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-11-10\",\n    \"filing_date\": \"2019-03-01\",\n    \"issue_date\": \"2020-08-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for filtering colors in images using a median filter. Improves the appearance of images in low-light conditions.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for filtering colors in an image...\",\n        \"A system for improving image quality...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67446", "text": "{\n    \"patent_title\": \"High-Resolution Medical Imaging System Utilizing Compressed Sensing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2018-03-01\",\n    \"issue_date\": \"2020-06-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel medical imaging system employing compressed sensing techniques to achieve significantly higher resolution images with reduced scan times. The system utilizes advanced reconstruction algorithms to enhance image clarity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A medical imaging system comprising...\",\n        \"A method for reconstructing images...\",\n        \"A system for enhancing image resolution...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67446", "text": "{\n    \"patent_title\": \"Portable Ultrasound Device with Wireless Connectivity\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2018-05-20\",\n    \"filing_date\": \"2018-09-15\",\n    \"issue_date\": \"2021-02-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A portable and wireless ultrasound device designed for point-of-care diagnostics. The device features real-time image transmission and remote consultation capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A portable ultrasound device comprising...\",\n        \"A method for wirelessly transmitting ultrasound images...\",\n        \"A system for remote diagnosis...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67447", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction for Enhanced Cardiac MRI Diagnostic Accuracy\",\n    \"inventors\": [\n        {\n            \"name\": \"David A. Feinberg\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Michael J. Ackerman\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-01-20\",\n    \"issue_date\": \"2021-12-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image reconstruction algorithm for cardiac MRI that significantly improves diagnostic accuracy by reducing noise and enhancing image clarity. The method utilizes deep learning techniques to optimize image quality and minimize artifacts, leading to more reliable detection of cardiac abnormalities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in cardiac MRI imaging.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing cardiac MRI images comprising...\",\n        \"A system for performing image reconstruction...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67447", "text": "{\n    \"patent_title\": \"Novel Wireless Communication Protocol for Wearable Sensors\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2022-03-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A low-power wireless communication protocol designed for wearable sensors, enabling efficient data transmission and extended battery life. The protocol utilizes a novel modulation scheme and error correction techniques to ensure reliable communication.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related work in wireless sensor networks.\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication protocol for wearable sensors comprising...\",\n        \"A wearable sensor device configured to...\",\n        \"A method for transmitting data using...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67448", "text": "{\n    \"patent_title\": \"Enhanced MRI Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning method for reconstructing MRI images with improved resolution and reduced artifacts, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67448", "text": "{\n    \"patent_title\": \"New Algorithm for Data Compression in Communication Systems\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"TechCorp Inc.\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"TechCorp Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-11-01\",\n    \"filing_date\": \"2021-11-01\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel algorithm for compressing data used in wireless communication systems. It increases efficiency and reduces bandwidth requirements.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US1011121314B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising...\",\n        \"A system for compressing data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67449", "text": "{\n    \"patent_title\": \"Enhanced Resolution Magnetic Resonance Imaging Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-12-04\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel magnetic resonance imaging (MRI) technique is disclosed that significantly improves image resolution and clarity through optimized pulse sequence design and advanced reconstruction algorithms. This advancement enables earlier and more accurate detection of subtle pathological changes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI comprising...\",\n        \"An MRI apparatus configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67449", "text": "{\n    \"patent_title\": \"Automated Surgical Tool Tracking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US9123456B2\",\n    \"priority_date\": \"2015-05-20\",\n    \"filing_date\": \"2015-05-20\",\n    \"issue_date\": \"2017-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for tracking surgical tools during operation. The system utilizes computer vision and sensor data to provide real-time location information to surgeons.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical tool tracking system comprising...\",\n        \"A method for tracking a surgical tool...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67450", "text": "{\n    \"patent_title\": \"Miniaturized Optical Coherence Tomography Probe for Intravascular Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized optical coherence tomography (OCT) probe designed for in vivo intravascular imaging. The device allows for high-resolution visualization of coronary arteries with minimal invasiveness. It's intended for diagnostic purposes to assess plaque composition and guide interventional procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized OCT probe...\",\n        \"A method for intravascular imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67450", "text": "{\n    \"patent_title\": \"Surgical Robotic System with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-01\",\n    \"issue_date\": \"2023-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical robotic system designed for performing complex surgical procedures with enhanced precision and dexterity. The system incorporates advanced control algorithms and force feedback mechanisms, including a surgical robot.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic system comprising...\",\n        \"A method for robot-assisted surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67451", "text": "{\n    \"patent_title\": \"Method and System for Enhanced MRI Image Reconstruction for Neurological Disease Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for improving the quality of MRI images, particularly useful for detecting subtle anomalies indicative of neurological diseases such as Alzheimer's and Parkinson's. The system employs advanced image reconstruction algorithms to reduce noise and enhance contrast.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in MRI image processing.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI image reconstruction...\",\n        \"The method of claim 1, wherein the neurological disease is Alzheimer's disease.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67451", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Cardiovascular Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-10-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new catheter design optimized for minimally invasive cardiovascular procedures. The catheter features a flexible tip and improved maneuverability for navigating complex vascular pathways.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Previous catheter designs.\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible distal tip...\",\n        \"The catheter of claim 1, wherein the catheter is used for angioplasty.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67452", "text": "{\n    \"patent_title\": \"Energy-Efficient Beamforming for Wireless Communication Systems\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Qualcomm Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-09-20\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for beamforming in wireless communication networks to minimize energy consumption while maintaining quality of service. The system utilizes adaptive power allocation and interference cancellation techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"inventor\": \"Nokia Technologies\"\n        }\n    ],\n    \"claims\": [\n        \"A method for beamforming comprising...\",\n        \"A wireless communication system comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67452", "text": "{\n    \"patent_title\": \"Advanced Modulation Techniques for 5G Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Ericsson\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Huawei\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2020-12-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"Novel modulation schemes for increasing data throughput in 5G networks. These schemes improve spectral efficiency and reduce latency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"inventor\": \"Samsung Electronics\"\n        }\n    ],\n    \"claims\": [\n        \"A modulation scheme characterized by...\",\n        \"A 5G network comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67453", "text": "{\n    \"patent_title\": \"Comfortable Patient Interface for Respiratory Support\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-06-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel patient interface for respiratory support devices, designed to minimize pressure points and enhance patient comfort during prolonged use. The interface utilizes a flexible, adaptive material and ergonomic design.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A patient interface for a respiratory support device comprising a flexible material.\",\n        \"The patient interface as claimed in claim 1, wherein the flexible material is adaptive to the patient's facial contours.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67453", "text": "{\n    \"patent_title\": \"Surgical Instrument with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-11-01\",\n    \"filing_date\": \"2021-11-01\",\n    \"issue_date\": \"2023-04-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical instrument designed to improve precision and control during minimally invasive procedures. The instrument incorporates advanced robotic components and imaging capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising a robotic arm and an imaging system.\",\n        \"The surgical instrument as claimed in claim 1, wherein the robotic arm is controlled by a surgeon.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67454", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the clarity and resolution of medical images obtained through computed tomography (CT) are disclosed. The method includes advanced image reconstruction algorithms to reduce noise and artifacts, leading to improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8234567B1\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"A system comprising a detector and a processor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67454", "text": "{\n    \"patent_title\": \"Contrast Agent for Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2014-12-20\",\n    \"filing_date\": \"2014-12-20\",\n    \"issue_date\": \"2020-05-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel contrast agent for magnetic resonance imaging (MRI) is described. The agent enhances the visibility of blood vessels and tissues, improving diagnostic capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US7890123B2\"\n        },\n        {\n            \"patent_number\": \"US6543210B1\"\n        },\n        {\n            \"patent_number\": \"US5432109B2\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising a gadolinium complex...\",\n        \"A method for enhancing MRI images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67455", "text": "{\n    \"patent_title\": \"Method and System for Enhanced MRI Diagnosis of Alzheimer's Disease\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for improving the diagnosis of Alzheimer's disease using Magnetic Resonance Imaging (MRI) techniques. This invention utilizes advanced image processing algorithms to identify subtle changes in brain structure associated with early stages of the disease.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"title\": \"MRI Image Reconstruction Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for diagnosing Alzheimer's disease comprising...\",\n        \"A system for processing MRI images...\",\n        \"An MRI apparatus configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67455", "text": "{\n    \"patent_title\": \"Improved CT Scanner Design for Cardiovascular Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved design for Computed Tomography (CT) scanners, specifically aimed at enhancing image quality and reducing radiation exposure during cardiovascular imaging procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"CT Image Filtering Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A CT scanner comprising...\",\n        \"A method for reducing radiation dose...\",\n        \"A system for image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67456", "text": "{\n    \"patent_title\": \"Patient-Centric Infusion Pump with Adaptive Pressure Control\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An infusion pump designed to dynamically adjust pressure based on patient feedback, minimizing discomfort during intravenous drug delivery. The system utilizes a biofeedback sensor and a closed-loop control algorithm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8652098B2\",\n            \"title\": \"Infusion Pump Control System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for controlling fluid delivery...\",\n        \"An infusion pump comprising a pressure sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67456", "text": "{\n    \"patent_title\": \"Surgical Robot with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US10456789B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2020-02-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A robotic surgical system featuring high-resolution imaging and precise instrument control for minimally invasive procedures. It improves surgical accuracy and reduces recovery times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Remote Surgical System\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system comprising a visual display...\",\n        \"A method for performing a surgical procedure using a robot...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67457", "text": "{\n    \"patent_title\": \"Micro-robotic System for Minimally Invasive Cardiac Surgery\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2018-11-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A micro-robotic system designed for precise and minimally invasive cardiac surgery. The system incorporates advanced sensors and control algorithms to navigate within the heart and perform delicate procedures with increased accuracy and reduced trauma to the patient.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A micro-robotic system for performing cardiac surgery.\",\n        \"A control system for navigating the micro-robotic system.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67457", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Angiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Jones\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2014-12-15\",\n    \"filing_date\": \"2014-12-15\",\n    \"issue_date\": \"2017-04-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel catheter design for improved visualization during angiography. The catheter incorporates a flexible tip and enhanced contrast delivery for clearer imaging of blood vessels.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter with a flexible tip for angiography.\",\n        \"A contrast delivery system for enhancing angiographic images.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67458", "text": "{\n    \"patent_title\": \"Non-Invasive Continuous Blood Pressure Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for non-invasively and continuously monitoring a patient's blood pressure using optical sensors and signal processing techniques. This system provides real-time blood pressure readings without requiring arterial punctures or external cuffs, improving patient comfort and reducing the risk of complications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8652098B2\",\n            \"relevance\": \"Prior art on non-invasive blood pressure measurement.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for non-invasively monitoring blood pressure...\",\n        \"A system comprising an optical sensor...\",\n        \"A data processing unit configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67458", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US9988776B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler with an ergonomic handle design for enhanced precision and reduced surgeon fatigue during minimally invasive procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"relevance\": \"Prior art on surgical stapler designs.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an ergonomic handle...\",\n        \"A stapling cartridge configured for...\",\n        \"A firing mechanism adapted to...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67459", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Sepsis Diagnosis\",\n    \"inventors\": [\n        {\n            \"name\": \"David Chen\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Maria Rodriguez\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-06-20\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a microfluidic device for the rapid and accurate diagnosis of sepsis at the point of care. The device integrates antibody-based detection with a novel amplification strategy to achieve highly sensitive detection of bacterial biomarkers within minutes, addressing the critical need for faster diagnosis and treatment initiation in sepsis patients.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in microfluidic device design\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device for detecting bacterial biomarkers in a biological sample.\",\n        \"A method for rapidly diagnosing sepsis using said device.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67459", "text": "{\n    \"patent_title\": \"Improved Catheter Design\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Boston Medical Center\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2023-05-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents an improved design for a standard urinary catheter, incorporating a novel coating to reduce the risk of catheter-associated urinary tract infections. The coating utilizes a biocompatible polymer with antimicrobial properties.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous work on catheter coatings\"\n        }\n    ],\n    \"claims\": [\n        \"A urinary catheter comprising a biocompatible polymer coating.\",\n        \"A method for reducing urinary tract infections using said catheter.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67460", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Super-Resolution Network with Attention Mechanism\",\n    \"inventors\": [\n        {\n            \"name\": \"Li Wei\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-05-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for image super-resolution is presented, incorporating an attention mechanism to focus on crucial image details. This network significantly improves image quality and perceptual realism.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Similar super-resolution technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image super-resolution using a deep learning model.\",\n        \"The deep learning model comprising an attention mechanism.\",\n        \"An apparatus for performing image super-resolution.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67460", "text": "{\n    \"patent_title\": \"Method for Image Compression using Discrete Cosine Transform\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2018-06-20\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2020-02-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method for efficient image compression utilizing the Discrete Cosine Transform (DCT). It achieves a significant reduction in file size while maintaining acceptable image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art on DCT-based compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image compression using DCT.\",\n        \"An apparatus for performing image compression using DCT.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67461", "text": "{\n    \"patent_title\": \"Enhanced Medical Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning approach for reconstructing high-resolution medical images from low-dose data. The method significantly improves image clarity and reduces noise, enabling more accurate diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"A system comprising a deep learning model...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67461", "text": "{\n    \"patent_title\": \"Automated Surgical Tool Tracking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2014-11-10\",\n    \"filing_date\": \"2014-11-10\",\n    \"issue_date\": \"2017-05-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for tracking surgical tools during a medical procedure, providing real-time location data to surgeons. The system improves surgical precision and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for tracking surgical instruments...\",\n        \"A method for displaying tool location data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67462", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction Method for MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image reconstruction method for Magnetic Resonance Imaging (MRI) that utilizes a deep learning algorithm to reduce noise and enhance image clarity, thereby improving diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image...\",\n        \"The method of claim 1, wherein the deep learning algorithm is a convolutional neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67462", "text": "{\n    \"patent_title\": \"Portable X-Ray Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"SmallTech Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-09-01\",\n    \"filing_date\": \"2016-09-01\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A compact and portable X-ray device for on-site medical examinations. The device is designed for ease of use and reduced radiation exposure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A portable X-ray device comprising...\",\n        \"The device of claim 1, wherein the radiation output is limited to...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67463", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Sepsis Diagnosis\",\n    \"inventors\": [\n        {\n            \"name\": \"James R. Heath\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Manu Prakash\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device is provided for rapid and accurate diagnosis of sepsis using a small blood sample. The device integrates multiple diagnostic assays on a single chip, enabling early detection and improved patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8759042B2\",\n            \"title\": \"Point-of-Care Diagnostic Device\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device for detecting biomarkers associated with sepsis.\",\n        \"A method for diagnosing sepsis using the microfluidic device.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67463", "text": "{\n    \"patent_title\": \"Surgical Instrument for Bone Cutting\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Y. Langer\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Gordon Freeman\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical instrument is disclosed, comprising a cutting blade and a handle for precise bone cutting during orthopedic procedures. The instrument allows for improved surgical precision.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7659321B2\",\n            \"title\": \"Bone Saw\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising a cutting blade.\",\n        \"A method for cutting bone using the surgical instrument.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67464", "text": "{\n    \"patent_title\": \"Improved Medical Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning approach for reconstructing medical images with enhanced clarity and reduced noise. This system utilizes a convolutional neural network trained on a large dataset of medical scans to improve image resolution and diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in image reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for enhancing the clarity of a medical image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67464", "text": "{\n    \"patent_title\": \"Wireless Communication System for Remote Patient Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless communication system for remote patient monitoring. The system transmits physiological data from a patient to a healthcare provider in real-time, enabling timely intervention and improved patient care.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related to wireless communication protocols\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication system for transmitting patient data comprising...\",\n        \"A method for remotely monitoring a patient's physiological parameters...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67465", "text": "{\n    \"patent_title\": \"Deep Learning for Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a deep learning algorithm for image recognition. The algorithm utilizes convolutional neural networks to achieve high accuracy in identifying objects within images. The system is applicable to a variety of applications, including autonomous vehicles and medical imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition using a convolutional neural network.\",\n        \"A system for classifying images based on deep learning algorithms.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67465", "text": "{\n    \"patent_title\": \"Improved Data Compression Techniques\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-08-01\",\n    \"filing_date\": \"2021-10-15\",\n    \"issue_date\": \"2023-04-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a new data compression technique based on Huffman coding and run-length encoding. It provides improved compression ratios for various data types. It is applicable to storage and transmission of data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in data compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression using Huffman coding.\",\n        \"A system for encoding data using run-length encoding.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67466", "text": "{\n    \"patent_title\": \"Wearable Sensor System for Continuous Physiological Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10556789B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wearable sensor system for continuously monitoring vital signs, including heart rate, respiration rate, and skin temperature, using non-invasive sensors. The system transmits data wirelessly to a central monitoring station for real-time analysis and alerts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8986001B2\",\n            \"relevance\": \"Related prior art in wearable sensor technology\"\n        }\n    ],\n    \"claims\": [\n        \"A wearable sensor system comprising...\",\n        \"A method for continuously monitoring physiological parameters...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67466", "text": "{\n    \"patent_title\": \"Automated Surgical Instrument Tracking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2014-12-20\",\n    \"filing_date\": \"2014-12-20\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for tracking surgical instruments during medical procedures, utilizing RFID tags and a real-time location system to enhance surgical efficiency and safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art in surgical instrument tracking\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument tracking system comprising...\",\n        \"A method for tracking surgical instruments in real-time...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67467", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction Method for Low-Dose CT Scans\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel image reconstruction algorithm for computed tomography (CT) scans that significantly reduces radiation dose while maintaining image quality. The method employs advanced filtering and iterative reconstruction techniques to suppress noise and enhance contrast.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8569876B1\",\n            \"title\": \"Prior Art CT Reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an image from CT projection data...\",\n        \"The method of claim 1, wherein the radiation dose is reduced by at least 30%...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67467", "text": "{\n    \"patent_title\": \"Novel MRI Coil Design for Enhanced Signal Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new design for a magnetic resonance imaging (MRI) coil that increases signal-to-noise ratio and improves image resolution. The coil utilizes a novel geometric arrangement of conductive elements.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Conventional MRI Coil\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil comprising a plurality of conductive elements...\",\n        \"The MRI coil of claim 1, wherein the signal-to-noise ratio is increased by at least 10%...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67468", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction with Reduced Radiation Dose\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"This invention provides a method and system for reconstructing medical images with improved clarity and reduced radiation dose. The method utilizes advanced filtering techniques and iterative reconstruction algorithms to enhance image quality while minimizing patient exposure to harmful radiation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8213245B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for reducing radiation dose during medical imaging comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67468", "text": "{\n    \"patent_title\": \"Improved Contrast Agents for MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Charles Brown\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"Imperial College London\"\n        }\n    ],\n    \"patent_number\": \"EP3456789A1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2018-05-16\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"This invention discloses novel contrast agents for magnetic resonance imaging (MRI) that provide enhanced image contrast and improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent for MRI comprising...\",\n        \"A method for enhancing MRI image contrast comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67469", "text": "{\n    \"patent_title\": \"Low-Light Image Enhancement Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Adobe Research\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep learning approach for enhancing images captured in low-light conditions, achieving improved visual quality while maintaining computational efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Denoising Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing low-light images using a convolutional neural network.\",\n        \"A system comprising a camera and a processor configured to implement the method.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67469", "text": "{\n    \"patent_title\": \"Color Correction in Digital Photography\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Canon Inc.\"\n        }\n    ],\n    \"patent_number\": \"EP3456789A1\",\n    \"priority_date\": \"2019-12-01\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-05-12\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"A method and apparatus for automatically correcting the color balance in digital photographs to achieve a more natural and appealing look.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Automatic White Balance Control\"\n        }\n    ],\n    \"claims\": [\n        \"A method for adjusting color parameters in an image.\",\n        \"A digital camera implementing the color correction method.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67470", "text": "{\n    \"patent_title\": \"Energy-Efficient Wireless Communication System Utilizing Cognitive Radio\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Intel Corporation\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel wireless communication system leveraging cognitive radio techniques to dynamically allocate spectrum and reduce energy consumption. The system optimizes transmission power based on channel conditions, resulting in significant energy savings and improved spectral efficiency. Key features include a power adaptation algorithm and a spectrum sensing module designed for low power operation.  The design significantly enhances the sustainability of wireless networks.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on cognitive radio\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication system comprising a cognitive radio module...\",\n        \"A method for dynamically allocating spectrum to minimize energy consumption...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67470", "text": "{\n    \"patent_title\": \"High-Speed Wireless Data Transmission Protocol\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Qualcomm\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Ericsson\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a high-speed wireless data transmission protocol employing advanced modulation techniques and error correction codes. The protocol is designed to maximize data throughput in congested wireless environments.  It focuses on speed and reliability and provides a robust communication link for various applications.  The system improves performance by employing a novel encoding scheme.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related technology on wireless communication\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless data transmission protocol utilizing a novel modulation scheme...\",\n        \"A method for error correction in a wireless communication system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67471", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Enhanced Biocompatibility\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel implantable glucose sensor utilizing a bio-inspired polymer coating to significantly reduce foreign body response and enhance long-term biocompatibility. The sensor demonstrates superior accuracy and stability compared to existing technologies, offering a groundbreaking approach to continuous glucose monitoring for diabetic patients.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"relevance\": \"Related prior art on glucose sensing\"\n        }\n    ],\n    \"claims\": [\n        \"A glucose sensor comprising a biocompatible coating...\",\n        \"A method for continuous glucose monitoring using said sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67471", "text": "{\n    \"patent_title\": \"Improved Syringe Design for Insulin Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Baxter Healthcare Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-08-20\",\n    \"filing_date\": \"2017-08-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved syringe design for the delivery of insulin. The syringe features ergonomic enhancements and a modified plunger mechanism to improve usability and reduce injection discomfort. It does not fundamentally change the way insulin is delivered.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art syringe designs\"\n        }\n    ],\n    \"claims\": [\n        \"A syringe comprising an ergonomic grip...\",\n        \"A plunger mechanism with reduced friction...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67472", "text": "{\n    \"patent_title\": \"Automated Anomaly Detection in Medical Images Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for automatically detecting anomalies in medical images using deep convolutional neural networks. The system is trained on a large dataset of labeled images to identify patterns indicative of anomalies, improving diagnostic accuracy and reducing the workload on radiologists.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting anomalies in medical images comprising...\",\n        \"A system for analyzing medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67472", "text": "{\n    \"patent_title\": \"Improved X-Ray Tube Design for Enhanced Image Clarity\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2012-11-20\",\n    \"filing_date\": \"2012-11-19\",\n    \"issue_date\": \"2014-12-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved design for X-ray tubes that enhances image clarity and reduces radiation exposure. The invention focuses on optimizing the filament geometry and cooling system to achieve higher resolution images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube comprising...\",\n        \"A method for manufacturing an X-ray tube...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67473", "text": "{\n    \"patent_title\": \"Method for Enhanced Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, San Francisco\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for improving the resolution and contrast of magnetic resonance images using advanced pulse sequences and image reconstruction techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"type\": \"Cited by Examiner\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"type\": \"Cited by Applicant\"\n        },\n        {\n            \"patent_number\": \"US9456789B1\",\n            \"type\": \"Cited by Examiner\"\n        },\n        {\n            \"patent_number\": \"US10234567B2\",\n            \"type\": \"Cited by Applicant\"\n        },\n        {\n            \"patent_number\": \"US11345678B1\",\n            \"type\": \"Cited by Examiner\"\n        },\n        {\n            \"patent_number\": \"US12456789B2\",\n            \"type\": \"Cited by Applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating a magnetic resonance image...\",\n        \"The method of claim 1, wherein the pulse sequence...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67473", "text": "{\n    \"patent_title\": \"Improved X-Ray Detector\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        }\n    ],\n    \"patent_number\": \"US9234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2018-11-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved X-ray detector with enhanced sensitivity and reduced noise.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8345678B2\",\n            \"type\": \"Cited by Examiner\"\n        },\n        {\n            \"patent_number\": \"US9567890B1\",\n            \"type\": \"Cited by Applicant\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray detector comprising...\",\n        \"The detector of claim 1, wherein the sensitive material...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67474", "text": "{\n    \"patent_title\": \"Improved MRI Reconstruction Algorithm for Enhanced Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel algorithm for reconstructing Magnetic Resonance Images (MRIs) which significantly improves the clarity and resolution of images, particularly for the detection of small tumors. The algorithm utilizes a deep learning approach to reduce noise and artifacts, enhancing diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Prior art in MRI reconstruction.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for processing MRI data...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67474", "text": "{\n    \"patent_title\": \"Novel Contrast Agent for X-ray Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2022-05-10\",\n    \"filing_date\": \"2022-05-10\",\n    \"issue_date\": \"2024-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a new contrast agent for use in X-ray imaging. The contrast agent enhances the visibility of blood vessels and tissues, improving image quality. It is particularly useful in angiography procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\",\n            \"relevance\": \"Previous work on contrast agents.\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"A method for enhancing X-ray images...\",\n        \"A composition for medical imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67475", "text": "{\n    \"patent_title\": \"Remote Physiological Monitoring System with Enhanced Data Security\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for remotely monitoring a patient's physiological parameters, incorporating advanced encryption techniques to ensure data security and privacy. The system utilizes wearable sensors and a cloud-based platform for data analysis and transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on wearable sensors.\"\n        }\n    ],\n    \"claims\": [\n        \"A remote patient monitoring system comprising...\",\n        \"A method for securely transmitting physiological data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67475", "text": "{\n    \"patent_title\": \"Surgical Instrument with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-11-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical instrument design featuring enhanced ergonomics and precision for minimally invasive procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous surgical instrument designs.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising...\",\n        \"A handle design for improved grip...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67476", "text": "{\n    \"patent_title\": \"High-Resolution Magnetic Resonance Imaging with Enhanced Contrast Agents\",\n    \"inventors\": [\n        {\n            \"name\": \"David A. Bernstein\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Maria Rodriguez\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2018-11-15\",\n    \"filing_date\": \"2019-03-01\",\n    \"issue_date\": \"2020-04-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for high-resolution magnetic resonance imaging (MRI) utilizing new contrast agents to improve diagnostic accuracy in detecting early-stage tumors. The enhanced contrast allows for clearer visualization of subtle anatomical changes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Improved MRI Coil Design\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI using a contrast agent comprising...\",\n        \"An MRI apparatus configured to...\",\n        \"A system for diagnosing medical conditions using the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67476", "text": "{\n    \"patent_title\": \"Automated X-Ray Image Analysis System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11123456B1\",\n    \"priority_date\": \"2019-05-20\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2021-07-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents an automated system for analyzing X-ray images to detect fractures and other bone abnormalities. It focuses on speed and efficiency in image processing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10012345B2\",\n            \"title\": \"Digital X-Ray Acquisition Method\"\n        }\n    ],\n    \"claims\": [\n        \"A system for automatically detecting fractures in X-ray images comprising...\",\n        \"A method for processing X-ray images...\",\n        \"A computer program for...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67477", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2021-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable glucose sensor utilizing microfabrication techniques and wireless communication for continuous glucose monitoring. Designed to improve diabetes management and patient compliance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art related to glucose sensing technology\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable glucose sensor comprising...\",\n        \"A wireless communication module for transmitting glucose data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67477", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-15\",\n    \"issue_date\": \"2020-12-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical stapler designed with improved ergonomics to reduce surgeon fatigue and enhance precision during surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Existing surgical stapler designs\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an ergonomic handle...\",\n        \"A staple cartridge designed for secure tissue closure...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67478", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method for reconstructing medical images from raw data, resulting in significantly improved clarity and resolution. The method incorporates a deep learning algorithm to reduce noise and enhance image details, particularly beneficial for diagnostic imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"The method of claim 1, wherein the deep learning algorithm...\",\n        \"A system for performing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67478", "text": "{\n    \"patent_title\": \"System for Automated Patient Scheduling in Hospitals\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-01-05\",\n    \"filing_date\": \"2019-03-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system and method for automatically scheduling patient appointments in a hospital setting, optimizing resource allocation and reducing wait times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for scheduling patient appointments...\",\n        \"The system of claim 1, wherein the scheduling algorithm...\",\n        \"A method for optimizing resource allocation...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67479", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method and system for improving the resolution and contrast of magnetic resonance images (MRI). By utilizing a dynamically adjusted gradient field and a sophisticated reconstruction algorithm, the system significantly reduces image artifacts and enhances visualization of subtle anatomical structures. The method involves real-time feedback and adaptive optimization, leading to superior image quality compared to conventional MRI techniques. This has significant implications for early disease detection and improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"MRI Image Reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI image quality...\",\n        \"A system comprising a gradient field controller...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67479", "text": "{\n    \"patent_title\": \"Improved X-Ray Shielding for Medical Use\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9123456B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2018-07-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a protective shield for use during X-ray procedures. The shield is made of a lead composite material and provides improved radiation attenuation. It is designed for easy positioning and is compatible with standard X-ray equipment.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A radiation shield comprising a lead composite material...\",\n        \"A method of protecting a patient during X-ray exposure...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67480", "text": "{\n    \"patent_title\": \"Deep Learning for Enhanced Medical Image Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11876543B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-12-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a deep learning system for analyzing medical images to improve the accuracy and speed of diagnosis. The system utilizes convolutional neural networks to identify subtle patterns indicative of disease.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9897561B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for automatically detecting anomalies in medical images.\",\n        \"A system comprising a convolutional neural network trained on a dataset of medical images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67480", "text": "{\n    \"patent_title\": \"Real-Time Object Detection in Autonomous Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Chris Ngo\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Silva\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2021-05-20\",\n    \"filing_date\": \"2021-05-20\",\n    \"issue_date\": \"2024-01-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system and method for real-time object detection in autonomous vehicles, enabling safe and efficient navigation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for identifying objects in a vehicle's environment.\",\n        \"A method for predicting the trajectory of moving objects.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67481", "text": "{\n    \"patent_title\": \"Method and System for Enhancing Image Resolution using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel deep learning approach for significantly enhancing the resolution of digital images. The method utilizes a generative adversarial network (GAN) to create high-resolution images from low-resolution inputs, improving clarity and detail. Applications include medical imaging and satellite imagery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Super-Resolution using Convolutional Neural Networks\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising...\",\n        \"A system for implementing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67481", "text": "{\n    \"patent_title\": \"Data Compression Technique for Video Streaming\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-06-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an efficient data compression algorithm for reducing the bandwidth requirements of video streaming. The algorithm utilizes wavelet transforms and entropy coding to achieve high compression ratios. It is particularly suited for mobile devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Wavelet-based Image Compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing video data comprising...\",\n        \"A system for implementing the compression method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67482", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-11-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing medical images from raw data, utilizing advanced filtering techniques to reduce noise and enhance image clarity, thereby improving diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for implementing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67482", "text": "{\n    \"patent_title\": \"Surgical Instrument for Minimally Invasive Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Acme Medical Devices\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2021-08-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical instrument designed for minimally invasive procedures, offering improved precision and dexterity for surgeons.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising...\",\n        \"A handle for manipulating the instrument...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67483", "text": "{\n    \"patent_title\": \"Wireless Cardiac Pacemaker with Remote Monitoring Capabilities\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-08-20\",\n    \"issue_date\": \"2021-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless cardiac pacemaker is disclosed, featuring remote monitoring capabilities and adaptive pacing algorithms. The device aims to improve patient quality of life and reduce the need for invasive procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art related to cardiac pacing\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless cardiac pacemaker comprising a power source, a pacing circuit, and a communication module.\",\n        \"A method for remotely monitoring a cardiac pacemaker's performance.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67483", "text": "{\n    \"patent_title\": \"Drug-Eluting Stent with Biodegradable Polymer Coating\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-02-15\",\n    \"issue_date\": \"2022-01-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A drug-eluting stent is disclosed, featuring a biodegradable polymer coating for controlled drug release. The stent is designed to reduce restenosis after percutaneous coronary intervention.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related to stent design and material science\"\n        }\n    ],\n    \"claims\": [\n        \"A drug-eluting stent comprising a metallic scaffold and a biodegradable polymer coating.\",\n        \"A method for treating coronary artery disease using the drug-eluting stent.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67484", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, San Francisco\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing medical images from raw data, resulting in improved clarity and reduced noise. This allows for more accurate diagnosis of diseases and conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8652123B1\",\n            \"relevance\": \"Prior art in image reconstruction techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for performing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67484", "text": "{\n    \"patent_title\": \"Wireless Communication System for Remote Patient Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless communication system for remotely monitoring patient vital signs and transmitting data to healthcare providers. This system utilizes low-power communication protocols and secure data encryption.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related to wireless sensor networks\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication system comprising...\",\n        \"A method for remotely monitoring a patient's vital signs...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67485", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel minimally invasive surgical system incorporating high-resolution 3D imaging and robotic precision. The system allows surgeons to perform complex procedures through small incisions, reducing patient trauma and recovery time. The enhanced visualization component provides real-time feedback and improved surgical accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related prior art in robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A minimally invasive surgical system comprising...\",\n        \"A method for performing surgery using said system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67485", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Cardiovascular Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-07-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new catheter design with improved flexibility and maneuverability for navigating the cardiovascular system. The catheter features a specialized tip geometry to enhance access to difficult-to-reach vessels. The improved design reduces the risk of vessel damage and improves the efficiency of cardiovascular procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9321098B2\",\n            \"relevance\": \"Prior art in catheter design\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter for cardiovascular procedures, comprising...\",\n        \"A method for navigating a vessel using said catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67486", "text": "{\n    \"patent_title\": \"Method and System for Adaptive Noise Reduction in Digital Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for reducing noise in digital images by adaptively adjusting noise reduction parameters based on local image characteristics.  The algorithm utilizes a wavelet transform for efficient noise separation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in image filtering.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing noise in a digital image comprising...\",\n        \"A system for implementing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67486", "text": "{\n    \"patent_title\": \"System and Method for Compressing Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for efficiently compressing medical images using a novel lossless compression algorithm.  The system reduces storage requirements while preserving image fidelity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related compression techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a medical image comprising...\",\n        \"A system for implementing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67487", "text": "{\n    \"patent_title\": \"High-Resolution Optical Coherence Tomography System with Adaptive Optics\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A high-resolution optical coherence tomography (OCT) system incorporating adaptive optics for improved image clarity and resolution. The system utilizes a deformable mirror to correct for aberrations in the sample, resulting in enhanced image quality for biomedical imaging applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A biomedical imaging system comprising: an OCT module; a deformable mirror; and a control system configured to adjust the deformable mirror to correct for aberrations.\",\n        \"The system of claim 1, wherein the aberrations are caused by scattering media.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67487", "text": "{\n    \"patent_title\": \"MRI Pulse Sequence for Improved Cardiac Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-05-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved MRI pulse sequence for high-resolution cardiac imaging, enabling faster scan times and enhanced visualization of cardiac structures. The sequence incorporates novel gradient encoding schemes to reduce artifacts and improve image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI pulse sequence comprising: a gradient encoding scheme optimized for cardiac imaging; and a data acquisition module configured to acquire data based on the pulse sequence.\",\n        \"The pulse sequence of claim 1, wherein the gradient encoding scheme reduces artifacts caused by motion.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67488", "text": "{\n    \"patent_title\": \"Miniature Robotic Catheter for Targeted Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"David Utley\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Samuel Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10876321B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-03-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature robotic catheter system designed for precise drug delivery to targeted areas within the cardiovascular system. The system utilizes micro-robotics and advanced imaging techniques to navigate through tortuous vessels and deliver therapeutic agents with minimal invasiveness.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8986328B2\",\n            \"title\": \"Remote Control Catheter\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic catheter comprising a micro-robot and a drug delivery module.\",\n        \"A method for targeted drug delivery using a robotic catheter.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67488", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Chen\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9540287B1\",\n    \"priority_date\": \"2014-12-15\",\n    \"filing_date\": \"2015-12-15\",\n    \"issue_date\": \"2017-03-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler with a novel ergonomic handle design for enhanced surgical precision and reduced surgeon fatigue. The stapler features a quick-loading cartridge and a robust clamping mechanism.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Surgical Stapler with Auto-Firing Mechanism\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an ergonomic handle and a staple cartridge.\",\n        \"A method for performing surgical stapling using the stapler.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67489", "text": "{\n    \"patent_title\": \"High-Resolution Medical Imaging System with Adaptive Filtering\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, San Francisco\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A medical imaging system utilizing adaptive filtering techniques to enhance image resolution and clarity, reducing noise and artifacts for improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8542321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A medical imaging system comprising an image acquisition module and an adaptive filtering module.\",\n        \"The system of claim 1, wherein the adaptive filtering module reduces noise in the acquired image.\",\n        \"The system of claim 1, wherein the adaptive filtering module enhances image resolution.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67489", "text": "{\n    \"patent_title\": \"Portable Ultrasound Device for Veterinary Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"PetScan Technologies\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2016-11-01\",\n    \"issue_date\": \"2018-09-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A portable ultrasound device designed for veterinary use, featuring a compact design and wireless connectivity for convenient animal scanning.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\"\n        }\n    ],\n    \"claims\": [\n        \"A portable ultrasound device comprising a transducer, a processing unit, and a display.\",\n        \"The device of claim 1, wherein the device is wireless.\",\n        \"The device of claim 1, wherein the device is suitable for veterinary use.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67490", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction Algorithm for MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"EP3456789B1\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-26\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"A novel image reconstruction algorithm for Magnetic Resonance Imaging (MRI) that improves image quality and reduces scan time. The algorithm utilizes a deep learning approach to effectively denoise and enhance MRI images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"MRI Image Reconstruction Using Wavelet Transform\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"An MRI system configured to implement the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67490", "text": "{\n    \"patent_title\": \"Enhanced X-Ray Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2019-11-12\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"An improved X-ray imaging system with enhanced contrast and reduced radiation dose. The system utilizes a novel detector array and image processing techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"EP2345678A1\",\n            \"title\": \"Digital Radiography System\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A method for generating an X-ray image using the system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67491", "text": "{\n    \"patent_title\": \"Novel MRI Reconstruction Method for Enhanced Image Clarity\",\n    \"inventors\": [\n        {\n            \"name\": \"David A. Stanford\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-04-20\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a groundbreaking new method for Magnetic Resonance Image (MRI) reconstruction.  By utilizing a novel deep learning algorithm combined with compressed sensing techniques, we achieve significantly improved image clarity and reduced scan times. This dramatically enhances diagnostic capabilities and patient comfort.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"An MRI system configured to implement the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67491", "text": "{\n    \"patent_title\": \"Improved X-Ray Shielding Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Miller\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Sarah Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-06-15\",\n    \"issue_date\": \"2023-02-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a new composite material for X-ray shielding.  The material offers increased protection and is more lightweight than existing shielding options. It utilizes barium sulfate nanoparticles embedded in a polymer matrix.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous work on X-ray shielding\"\n        }\n    ],\n    \"claims\": [\n        \"A shielding material comprising...\",\n        \"A method for manufacturing the shielding material...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67492", "text": "{\n    \"patent_title\": \"System and Method for Fraud Detection Using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for detecting fraudulent transactions using machine learning algorithms. The system analyzes transaction data to identify patterns indicative of fraud, providing real-time risk assessment and prevention.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for fraud detection comprising...\",\n        \"A method for identifying fraudulent transactions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67492", "text": "{\n    \"patent_title\": \"Novel Mathematical Framework for Reinforcement Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Sergey Levine\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-01\",\n    \"issue_date\": \"2023-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel mathematical framework for improving the convergence rate of reinforcement learning algorithms. The framework utilizes advanced tensor decomposition techniques to enhance the efficiency of policy optimization.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A mathematical framework for reinforcement learning...\",\n        \"A method for optimizing policy gradients...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67493", "text": "{\n    \"patent_title\": \"Novel Image Enhancement Algorithm Utilizing Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Research\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-05-22\",\n    \"issue_date\": \"2019-07-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel image enhancement algorithm based on deep convolutional neural networks. It achieves state-of-the-art results in image denoising and super-resolution, representing a breakthrough in image processing technology. The architecture utilizes a unique attention mechanism to focus on important image features, leading to superior performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in image denoising\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image using a deep convolutional neural network...\",\n        \"The method of claim 1, wherein the deep convolutional neural network includes an attention mechanism...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67493", "text": "{\n    \"patent_title\": \"Image Compression Technique Using Wavelet Transform\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9123456B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2017-01-10\",\n    \"issue_date\": \"2018-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved image compression technique based on wavelet transform. It offers a higher compression ratio compared to existing JPEG standards. The algorithm efficiently encodes image data for reduced storage and transmission costs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Existing wavelet-based compression methods\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image using a wavelet transform...\",\n        \"The method of claim 1, wherein the wavelet transform is a Daubechies wavelet...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67494", "text": "{\n    \"patent_title\": \"Improved MRI Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-03-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for reconstructing high-resolution MRI images from undersampled k-space data.  The method significantly reduces scan time while maintaining image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B1\",\n            \"relevance\": \"Prior art in MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"A computer-readable medium storing instructions for...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67494", "text": "{\n    \"patent_title\": \"Basic Principles of Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charles Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US7543210B2\",\n    \"priority_date\": \"2005-11-01\",\n    \"filing_date\": \"2005-11-01\",\n    \"issue_date\": \"2009-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A comprehensive overview of the fundamental physics and principles underlying Magnetic Resonance Imaging (MRI).\",\n    \"citations\": [],\n    \"claims\": [\n        \"An apparatus for generating MRI signals...\",\n        \"A method for detecting MRI signals...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67495", "text": "{\n    \"patent_title\": \"Method and System for Super-Resolution Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Li Wei\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Zhang Hong\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for reconstructing a high-resolution image from a low-resolution image. The method employs a deep convolutional neural network trained to map low-resolution images to high-resolution counterparts, enhancing image details and resolution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760871B2\",\n            \"title\": \"Image Enhancement using Wavelet Transform\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a high-resolution image comprising...\",\n        \"A system for super-resolution image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67495", "text": "{\n    \"patent_title\": \"Digital Image Processing System\",\n    \"inventors\": [\n        {\n            \"name\": \"Schmidt Klaus\",\n            \"affiliation\": \"Technical University of Munich\"\n        }\n    ],\n    \"patent_number\": \"EP3215489A1\",\n    \"priority_date\": \"2017-02-15\",\n    \"filing_date\": \"2017-02-15\",\n    \"issue_date\": \"2018-09-05\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"A digital image processing system for noise reduction in images. The system uses a median filter to smooth images and reduce noise levels.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7548732B2\",\n            \"title\": \"Noise Reduction in Digital Images\"\n        }\n    ],\n    \"claims\": [\n        \"A digital image processing system comprising...\",\n        \"A method for noise reduction in digital images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67496", "text": "{\n    \"patent_title\": \"Novel MRI Technique for Enhanced Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Jian Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2023-11-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel magnetic resonance imaging (MRI) technique that utilizes a unique pulse sequence and contrast agent to significantly enhance the detection of small tumors, particularly in the breast.  The technique improves signal-to-noise ratio and reduces false positives.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"prior art on MRI pulse sequences\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing tumor detection using MRI...\",\n        \"A contrast agent specifically formulated for use with the novel MRI technique...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67496", "text": "{\n    \"patent_title\": \"Improved X-Ray Image Processing Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2017-12-10\",\n    \"filing_date\": \"2017-12-10\",\n    \"issue_date\": \"2022-05-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved algorithm for processing X-ray images to reduce noise and improve image clarity. The algorithm utilizes a novel filtering technique based on wavelet transforms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"related work in image filtering\"\n        }\n    ],\n    \"claims\": [\n        \"An image processing algorithm for X-ray images...\",\n        \"A wavelet-based filtering technique...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67497", "text": "{\n    \"patent_title\": \"Novel MRI Reconstruction Method Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing magnetic resonance images (MRI) utilizing deep learning techniques. This method significantly reduces scan time and improves image quality compared to traditional reconstruction algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"A system for performing MRI reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67497", "text": "{\n    \"patent_title\": \"Improved X-Ray Shielding Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-12-10\",\n    \"filing_date\": \"2019-12-10\",\n    \"issue_date\": \"2022-09-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new shielding material for X-ray machines providing enhanced radiation protection for patients and operators.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A shielding material comprising...\",\n        \"An X-ray machine utilizing the shielding material...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67498", "text": "{\n    \"patent_title\": \"Method and System for Enhancing Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11876543B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-12-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the resolution of digital images using a deep learning model. The model is trained on a large dataset of high-resolution images and learns to predict the missing details in low-resolution images, resulting in significantly improved image clarity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing the resolution of a digital image...\",\n        \"A system comprising a processor and a memory...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67498", "text": "{\n    \"patent_title\": \"Medical Image Reconstruction Using Compressed Sensing\",\n    \"inventors\": [\n        {\n            \"name\": \"Gordon Wetzstein\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Levin\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11902876B2\",\n    \"priority_date\": \"2021-06-20\",\n    \"filing_date\": \"2021-06-20\",\n    \"issue_date\": \"2023-11-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for reconstructing medical images from limited data using compressed sensing techniques. The method improves image quality and reduces scan time in medical imaging applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8785765B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image from undersampled data...\",\n        \"A system for performing compressed sensing reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67499", "text": "{\n    \"patent_title\": \"Deep Convolutional Neural Networks for Robust Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10453087B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2019-10-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep convolutional neural network architecture for image recognition, achieving state-of-the-art results on benchmark datasets. The system enhances visual perception capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9886230B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition using a deep convolutional neural network.\",\n        \"A system for classifying images based on learned features.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67499", "text": "{\n    \"patent_title\": \"Method for Enhancing Audio Signal Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2019-05-20\",\n    \"filing_date\": \"2019-05-20\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel technique for improving the clarity and quality of audio signals. This enhances the user experience in various audio applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760845B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing audio signals to reduce noise.\",\n        \"A system for enhancing audio quality.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67500", "text": "{\n    \"patent_title\": \"Adaptive Noise Reduction for Digital Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2021-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reducing noise in digital images using adaptive filtering techniques, resulting in improved image quality and clarity. The method dynamically adjusts filter parameters based on local image characteristics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B1\",\n            \"relevance\": \"Prior art on image filtering.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for noise reduction in digital images comprising...\",\n        \"An image processing system configured to implement the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67500", "text": "{\n    \"patent_title\": \"Method for Image Compression using Wavelet Transform\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2018-03-10\",\n    \"filing_date\": \"2018-03-10\",\n    \"issue_date\": \"2019-11-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for compressing digital images using wavelet transform techniques. The method reduces file size while maintaining acceptable image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art on image compression techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a digital image comprising...\",\n        \"A system for implementing the image compression method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67501", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-12-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing high-resolution medical images from low-dose data using deep learning techniques. The system significantly reduces radiation exposure while maintaining image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Prior Art Image Reconstruction\"\n        },\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"title\": \"Deep Learning for Image Analysis\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Low-Dose CT Imaging\"\n        },\n        {\n            \"patent_number\": \"US11345678B2\",\n            \"title\": \"Advanced Noise Reduction Techniques\"\n        },\n        {\n            \"patent_number\": \"US10456789B1\",\n            \"title\": \"Medical Image Segmentation\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"A system comprising a processor...\",\n        \"The method of claim 1, wherein the medical image is a CT scan.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67501", "text": "{\n    \"patent_title\": \"Novel Algorithm for Abstract Art Generation\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Art Institute of Chicago\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2020-08-01\",\n    \"filing_date\": \"2021-01-15\",\n    \"issue_date\": \"2022-05-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An innovative algorithm for generating unique and aesthetically pleasing abstract art pieces using fractal geometry and color theory.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Prior Art Fractal Generation\"\n        },\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"title\": \"Color Theory Fundamentals\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Procedural Art Generation\"\n        },\n        {\n            \"patent_number\": \"US11345678B2\",\n            \"title\": \"Geometric Pattern Creation\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating an abstract art image...\",\n        \"A system comprising a rendering engine...\",\n        \"The method of claim 1, wherein the fractal geometry is based on the Mandelbrot set.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67502", "text": "{\n    \"patent_title\": \"Method and System for Adaptive Image Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Adobe Systems\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for adaptively enhancing the visual quality of digital images by analyzing image content and applying specific enhancement algorithms. The system employs a feedback loop to optimize the enhancement parameters for optimal results.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for adaptively enhancing an image...\",\n        \"A system comprising a processor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67502", "text": "{\n    \"patent_title\": \"Digital Signal Processing for Audio Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for compressing digital audio signals using advanced signal processing techniques. The invention achieves high compression ratios with minimal loss of audio quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an audio signal...\",\n        \"An apparatus for performing audio compression...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67503", "text": "{\n    \"patent_title\": \"High-Efficiency Modulation Scheme for 5G Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Qualcomm Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2020-12-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel modulation scheme for 5G wireless communication is disclosed, achieving a significant increase in data transmission speed and spectral efficiency. The invention utilizes a hybrid approach combining orthogonal frequency-division multiplexing (OFDM) with a space-time block code (STBC).\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"OFDM-based Wireless Communication System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for transmitting data in a wireless communication system comprising...\",\n        \"An apparatus for implementing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67503", "text": "{\n    \"patent_title\": \"Improved Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Motors\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-05-20\",\n    \"filing_date\": \"2019-05-20\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery management system (BMS) for electric vehicles is disclosed, improving battery life and performance. The invention utilizes advanced algorithms for charge and discharge control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Lithium-Ion Battery Management System\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for an electric vehicle comprising...\",\n        \"A method for controlling the charge and discharge of a battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67504", "text": "{\n    \"patent_title\": \"Deep Learning for Enhanced Medical Image Segmentation\",\n    \"inventors\": [\n        {\n            \"name\": \"Li Zhang\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Chen\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-11-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep learning system for accurate and efficient segmentation of medical images, enabling improved diagnostics and treatment planning. The system utilizes a novel convolutional neural network architecture and a loss function specifically designed for imbalanced datasets. It's applicable to various medical imaging modalities like MRI, CT scans, and X-rays.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for segmenting medical images using a deep convolutional neural network.\",\n        \"A system comprising a deep convolutional neural network trained on medical image data.\",\n        \"A non-transitory computer-readable medium storing instructions for segmenting medical images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67504", "text": "{\n    \"patent_title\": \"Method and System for Real-Time Photo Filtering\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2022-05-10\",\n    \"filing_date\": \"2022-05-10\",\n    \"issue_date\": \"2024-02-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for applying real-time photo filters to digital images. The system allows users to select from a variety of pre-defined filters and adjust filter parameters. It is designed for mobile devices and social media applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for applying a filter to a digital image.\",\n        \"A system for real-time photo filtering.\",\n        \"A mobile application incorporating the filtering system.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67505", "text": "{\n    \"patent_title\": \"Non-Invasive Glucose Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2020-05-15\",\n    \"filing_date\": \"2020-05-15\",\n    \"issue_date\": \"2021-11-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive system for continuous glucose monitoring using optical sensors. The system aims to improve diabetes management and patient outcomes by providing real-time glucose data without requiring blood samples.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on optical glucose sensing\"\n        }\n    ],\n    \"claims\": [\n        \"A non-invasive glucose monitoring system comprising an optical sensor...\",\n        \"A method for continuously monitoring glucose levels using the system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67505", "text": "{\n    \"patent_title\": \"Surgical Robotic Arm with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2021-03-10\",\n    \"filing_date\": \"2021-03-10\",\n    \"issue_date\": \"2022-09-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical robotic arm designed to enhance precision during complex surgical procedures. The arm incorporates advanced control algorithms and high-resolution imaging for improved surgical outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related art on surgical robotics\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic arm comprising a multi-jointed structure...\",\n        \"A control system for precisely manipulating the robotic arm...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67506", "text": "{\n    \"patent_title\": \"Enhanced Medical Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-08-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel deep learning architecture for reconstructing medical images from raw data. The method significantly improves image clarity and resolution, enabling more accurate diagnosis and treatment planning. Specifically, it reduces noise and artifacts in CT and MRI scans.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"title\": \"Prior Art Medical Imaging System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"A system for enhancing image resolution...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67506", "text": "{\n    \"patent_title\": \"Automated Surgical Tool Tracking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-01\",\n    \"issue_date\": \"2023-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system for tracking surgical tools during minimally invasive procedures. The system utilizes infrared sensors and computer vision algorithms to provide real-time feedback to the surgeon. It increases surgical precision and reduces the risk of complications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"title\": \"Previous Surgical Tracking Technology\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical tool tracking system comprising...\",\n        \"A method for tracking tool position...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67507", "text": "{\n    \"patent_title\": \"Improved MRI Reconstruction for Enhanced Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing MRI images, significantly reducing noise and enhancing the visibility of small tumors, thereby improving diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"An MRI system configured to implement the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67507", "text": "{\n    \"patent_title\": \"Digital X-Ray Image Processing System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US10246813B1\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2017-12-15\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for enhancing the contrast and clarity of digital X-ray images, improving visualization for routine screenings.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A digital X-ray image processing system comprising...\",\n        \"A method for contrast enhancement in X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67508", "text": "{\n    \"patent_title\": \"Enhanced MRI Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing MRI images using deep learning techniques, improving image quality and reducing scan time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10987654B1\",\n            \"cited_by\": \"Alice Johnson\"\n        },\n        {\n            \"patent_number\": \"US11012345B2\",\n            \"cited_by\": \"Bob Williams\"\n        },\n        {\n            \"patent_number\": \"US11123456B1\",\n            \"cited_by\": \"Charlie Brown\"\n        },\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"cited_by\": \"David Lee\"\n        },\n        {\n            \"patent_number\": \"US11334455B1\",\n            \"cited_by\": \"Eve Green\"\n        },\n        {\n            \"patent_number\": \"US11445566B2\",\n            \"cited_by\": \"Frank White\"\n        },\n        {\n            \"patent_number\": \"US11556677B1\",\n            \"cited_by\": \"Grace Black\"\n        },\n        {\n            \"patent_number\": \"US11667788B2\",\n            \"cited_by\": \"Henry Gray\"\n        },\n        {\n            \"patent_number\": \"US11778899B1\",\n            \"cited_by\": \"Ivy Blue\"\n        },\n        {\n            \"patent_number\": \"US11889900B2\",\n            \"cited_by\": \"Jack Red\"\n        },\n        {\n            \"patent_number\": \"US11990011B1\",\n            \"cited_by\": \"Kelly Silver\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images...\",\n        \"A system for performing MRI reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67508", "text": "{\n    \"patent_title\": \"Improved X-ray Detector Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new design for X-ray detectors that improves sensitivity and reduces noise.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10876543B1\",\n            \"cited_by\": \"Alice Johnson\"\n        },\n        {\n            \"patent_number\": \"US11001234B2\",\n            \"cited_by\": \"Bob Smith\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray detector comprising...\",\n        \"A method for detecting X-rays...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67509", "text": "{\n    \"patent_title\": \"Deep Learning Framework for Robust Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep learning framework for image recognition, achieving state-of-the-art accuracy and robustness. The system uses novel convolutional neural network architectures and training techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67509", "text": "{\n    \"patent_title\": \"Improved Method for Barcode Scanning\",\n    \"inventors\": [\n        {\n            \"name\": \"David Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-11-20\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2021-04-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved method for barcode scanning using advanced optical sensors and image processing techniques. Increases speed and accuracy of barcode recognition.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A barcode scanner comprising...\",\n        \"A method for decoding barcodes comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67510", "text": "{\n    \"patent_title\": \"Deep Learning for Predictive Maintenance in Industrial Robotics\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-08-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep learning system for predicting failures in industrial robots, reducing downtime and maintenance costs. The system utilizes sensor data and historical maintenance records.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for predicting failures in industrial robots using a deep learning model.\",\n        \"A system comprising sensors, a data processing unit, and a deep learning model for predictive maintenance.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67510", "text": "{\n    \"patent_title\": \"Novel Image Compression Algorithm Using Wavelet Transforms\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2020-07-10\",\n    \"filing_date\": \"2020-09-18\",\n    \"issue_date\": \"2021-12-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new image compression algorithm based on wavelet transforms, achieving higher compression ratios with minimal loss of image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing images using wavelet transforms.\",\n        \"A system for encoding and decoding images using the described algorithm.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67511", "text": "{\n    \"patent_title\": \"Ergonomic Design for Improved Patient Tolerance of Continuous Glucose Monitors\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A continuous glucose monitor (CGM) with an improved ergonomic design incorporating flexible materials and a reduced profile adhesive patch. The design minimizes skin irritation and discomfort, leading to increased patient compliance and improved data accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Miniaturized Glucose Sensor\"\n        }\n    ],\n    \"claims\": [\n        \"A continuous glucose monitor comprising a flexible substrate.\",\n        \"An adhesive patch with a hypoallergenic adhesive.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67511", "text": "{\n    \"patent_title\": \"Automated Insulin Delivery System with Remote Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2021-11-01\",\n    \"filing_date\": \"2021-11-01\",\n    \"issue_date\": \"2023-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated insulin delivery system that utilizes a closed-loop algorithm to regulate blood glucose levels in patients with Type 1 diabetes. The system includes a continuous glucose monitor, an insulin pump, and a remote monitoring interface for healthcare professionals.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Closed-Loop Insulin Pump\"\n        }\n    ],\n    \"claims\": [\n        \"An automated insulin delivery system comprising a glucose sensor and an insulin pump.\",\n        \"A remote monitoring interface for data analysis.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67512", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Cardiac Monitor with Remote Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MedTech Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-06-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable cardiac monitor for continuous ECG monitoring with wireless data transmission to a remote server, improving early detection of cardiac arrhythmias and enhancing patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on implantable cardiac devices.\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable cardiac monitor comprising...\",\n        \"A method for remote data transmission...\",\n        \"A system for arrhythmia detection...\",\n        \"A wireless communication module...\",\n        \"A power management unit...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67512", "text": "{\n    \"patent_title\": \"Surgical Stapler with Enhanced Jaw Alignment\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Surgical Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2021-05-01\",\n    \"filing_date\": \"2021-08-15\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler design with enhanced jaw alignment mechanisms for precise tissue cutting and stapling during surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous stapler designs\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"An alignment mechanism...\",\n        \"A staple cartridge...\",\n        \"A firing mechanism...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67513", "text": "{\n    \"patent_title\": \"Improved Medical Image Reconstruction Method for Enhanced Diagnostic Accuracy\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-06-15\",\n    \"issue_date\": \"2019-03-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method for reconstructing medical images from raw data, resulting in significantly improved image quality and diagnostic accuracy. The method utilizes a new regularization technique to reduce noise and artifacts, enabling clinicians to better visualize and interpret subtle anatomical features.  The method is applicable to various imaging modalities including MRI, CT, and PET.  Detailed algorithms and experimental results demonstrating superior performance compared to existing methods are provided.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"relevance\": \"Prior art in image reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for performing the method according to claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67513", "text": "{\n    \"patent_title\": \"Portable X-Ray Device for Veterinary Use\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Carol Davis\",\n            \"affiliation\": \"University of California, Davis\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-09-20\",\n    \"filing_date\": \"2018-01-10\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A compact and lightweight X-ray device designed for veterinary applications. The device offers portability and ease of use for on-site diagnosis in animal clinics and farms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related to portable X-ray technology\"\n        }\n    ],\n    \"claims\": [\n        \"A portable X-ray device comprising...\",\n        \"A system for operating the portable X-ray device...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67514", "text": "{\n    \"patent_title\": \"Improved MRI Contrast Agent for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel MRI contrast agent that enhances tumor visibility in early stages of cancer, leading to improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8652341B2\",\n            \"relevance\": \"Prior art on MRI contrast agents.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing tumor visibility using the disclosed contrast agent.\",\n        \"A contrast agent formulation comprising the novel compound.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67514", "text": "{\n    \"patent_title\": \"New Algorithm for Image Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An efficient algorithm for compressing digital images, reducing storage space and transmission bandwidth.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7543210B2\",\n            \"relevance\": \"Prior art on image compression techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image using the disclosed algorithm.\",\n        \"A system for encoding and decoding images based on the algorithm.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67515", "text": "{\n    \"patent_title\": \"Implantable Cardiac Monitor with Remote Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac monitor that continuously monitors heart rhythm and wirelessly transmits data to a remote server for analysis. The device utilizes advanced algorithms to detect arrhythmias and provide timely alerts to healthcare professionals.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in implantable cardiac devices\"\n        }\n    ],\n    \"claims\": [\n        \"A method for remotely monitoring cardiac rhythm.\",\n        \"An implantable device for detecting arrhythmias.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67515", "text": "{\n    \"patent_title\": \"Surgical Instrument for Orthopedic Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-15\",\n    \"issue_date\": \"2020-07-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical instrument designed for precise bone cutting in orthopedic surgeries. The instrument incorporates a laser guidance system and a micro-vibration mechanism to minimize tissue damage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related to surgical instrument design.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument with laser guidance.\",\n        \"A method for precise bone cutting.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67516", "text": "{\n    \"patent_title\": \"Method and System for Noise Reduction in Digital Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Adobe Systems\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2015-03-15\",\n    \"filing_date\": \"2015-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for reducing noise in digital images is disclosed. The method includes applying a wavelet transform to the image, identifying noise components based on energy levels, and attenuating the noise components to improve image clarity. This technique significantly enhances the visual quality of images captured in low-light conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"title\": \"Image Filtering Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing noise in a digital image comprising...\",\n        \"A system for implementing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67516", "text": "{\n    \"patent_title\": \"Digital Signal Processing for Audio Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-05-20\",\n    \"filing_date\": \"2016-05-20\",\n    \"issue_date\": \"2019-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a digital signal processing system for enhancing audio signals. The system uses Fourier transforms and adaptive filtering to remove unwanted noise and improve sound quality in audio recordings. It is particularly useful for speech recognition and music reproduction.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Audio Filtering Methods\"\n        }\n    ],\n    \"claims\": [\n        \"A system for enhancing audio signals comprising...\",\n        \"A method for filtering audio signals of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67517", "text": "{\n    \"patent_title\": \"Extended Battery Life System Utilizing Novel Capacitor Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Quantum Energy Labs\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel energy storage system utilizing a layered capacitor design to significantly extend battery life in mobile devices.  The system incorporates a unique electrolyte formulation for enhanced performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on capacitor technology.\"\n        }\n    ],\n    \"claims\": [\n        \"A battery system for a mobile device comprising a layered capacitor.\",\n        \"The battery system of claim 1, wherein the capacitor utilizes a novel electrolyte formulation.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67517", "text": "{\n    \"patent_title\": \"Improved Signal Processing for Mobile Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Bell Labs\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2017-12-15\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved signal processing method for enhancing data transmission in mobile communication networks. This invention focuses on reducing interference and increasing bandwidth.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related art in signal processing.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for signal processing in a mobile communication network.\",\n        \"The method of claim 1, comprising interference reduction techniques.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67518", "text": "{\n    \"patent_title\": \"Novel MRI Technique for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel magnetic resonance imaging (MRI) technique employing a unique contrast agent and pulse sequence for the early detection of cancerous tumors. This technology offers improved sensitivity and specificity compared to existing methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancer using MRI...\",\n        \"A contrast agent for enhancing MRI signal...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67518", "text": "{\n    \"patent_title\": \"Improved X-Ray Shielding Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Carol Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"Mr. David Miller\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-01\",\n    \"issue_date\": \"2023-05-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved shielding material for X-ray machines, providing enhanced radiation protection for patients and operators. The material comprises a novel polymer composite.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A shielding material comprising a polymer composite...\",\n        \"An X-ray machine incorporating the shielding material...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67519", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-09-20\",\n    \"issue_date\": \"2021-01-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel minimally invasive surgical system incorporating real-time image guidance and robotic assistance for precise tissue manipulation. This system offers improved visualization and control compared to traditional laparoscopic techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art related to surgical robotics.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising a robotic arm...\",\n        \"A method for performing a minimally invasive procedure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67519", "text": "{\n    \"patent_title\": \"Automated Drug Delivery System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Pharmaceutical Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2020-12-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for delivering precise dosages of medication to patients. The system utilizes microfluidic technology and a closed-loop control algorithm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related to microfluidic drug delivery.\"\n        }\n    ],\n    \"claims\": [\n        \"A drug delivery system comprising a microfluidic chip...\",\n        \"A method for controlling drug dosage...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67520", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Blood Glucose Sensor\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Chen\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable glucose sensor providing continuous glucose monitoring with improved accuracy and reduced biofouling. Addresses the need for less invasive glucose monitoring for diabetes patients.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Implantable Glucose Sensor\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable glucose sensor comprising...\",\n        \"A method for continuous glucose monitoring using the sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67520", "text": "{\n    \"patent_title\": \"Improved Surgical Stapler\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-04-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler with enhanced ergonomic design and faster staple deployment. Aims to reduce surgical time and improve surgical outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Surgical Stapler with Automatic Adjustment\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"A method for performing surgical stapling using the stapler...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67521", "text": "{\n    \"patent_title\": \"Improved Patient Positioning System for MRI Scanners\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel patient positioning system for MRI scanners designed to minimize discomfort and pressure points. The system utilizes a dynamic air cushion and automated alignment features to optimize patient positioning. The system is relatively simple to integrate with existing MRI infrastructure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8652012B2\",\n            \"relevance\": \"Prior art related to patient support systems.\"\n        }\n    ],\n    \"claims\": [\n        \"A patient positioning system for MRI scanners comprising a dynamic air cushion.\",\n        \"A method for automatically aligning a patient within an MRI scanner.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67521", "text": "{\n    \"patent_title\": \"Advanced Image Reconstruction Algorithm for PET Scanners\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A computationally intensive image reconstruction algorithm for PET scanners utilizing advanced statistical modeling and iterative optimization techniques to significantly improve image resolution and reduce noise. Requires substantial computational resources and specialized hardware.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Prior art on PET image reconstruction.\"\n        }\n    ],\n    \"claims\": [\n        \"An image reconstruction algorithm for PET scanners based on a maximum likelihood expectation maximization (MLEM) method.\",\n        \"A system for performing PET imaging utilizing said algorithm.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67522", "text": "{\n    \"patent_title\": \"Enhanced Image Processing for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel image processing technique utilizing deep learning algorithms to enhance the detection of subtle anomalies in medical images, specifically for early cancer diagnosis. The system improves diagnostic accuracy and reduces false negatives.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in image segmentation\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing medical images comprising...\",\n        \"A system for detecting anomalies in medical images comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67522", "text": "{\n    \"patent_title\": \"Automated System for X-Ray Image Storage and Retrieval\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"General Electric\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2018-02-15\",\n    \"issue_date\": \"2021-04-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for storing, retrieving, and managing digital X-ray images. The system includes a database, a user interface, and security features for protecting patient data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art in data storage techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A system for storing medical images comprising...\",\n        \"A method for retrieving medical images from a database comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67523", "text": "{\n    \"patent_title\": \"Miniaturized Robotic Surgical System\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized robotic surgical system designed for improved precision and reduced invasiveness in various surgical procedures. The system incorporates advanced sensors and control algorithms for enhanced maneuverability within confined spaces.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system comprising a miniaturized robotic arm...\",\n        \"A control system for directing the robotic arm...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67523", "text": "{\n    \"patent_title\": \"Improved Catheter Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design for enhanced fluid delivery and waste removal. The catheter features a novel tip geometry for reduced trauma.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible tube...\",\n        \"A tip geometry designed to minimize tissue damage...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67524", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-12-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for reconstructing medical images with improved clarity and reduced noise. The system utilizes a deep learning algorithm to enhance image resolution and detail, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for enhancing the resolution of a medical image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67524", "text": "{\n    \"patent_title\": \"Improved Algorithm for Audio Signal Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-01-25\",\n    \"filing_date\": \"2021-03-10\",\n    \"issue_date\": \"2023-05-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved algorithm for processing audio signals, specifically designed for noise reduction and enhancement of speech clarity in noisy environments. The algorithm utilizes a novel filtering technique.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"An algorithm for processing an audio signal comprising...\",\n        \"A system for reducing noise in an audio signal...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67525", "text": "{\n    \"patent_title\": \"Enhanced Magnetic Resonance Imaging with Artificial Intelligence for Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2023-11-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method for improving the accuracy of cancer detection using magnetic resonance imaging (MRI) combined with artificial intelligence (AI) algorithms. The AI algorithms analyze MRI images to identify subtle patterns indicative of cancerous tissue, leading to earlier and more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"MRI Image Reconstruction Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for analyzing MRI images using AI to detect cancer.\",\n        \"An AI algorithm trained to identify cancerous tissue patterns.\",\n        \"A system comprising an MRI scanner and an AI processing unit.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67525", "text": "{\n    \"patent_title\": \"Improved Algorithm for Compressing Digital Images\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-03-10\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-08-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel algorithm for compressing digital images, reducing file size while maintaining image quality. It is applicable to various image formats and devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Lossless Image Compression Methods\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing digital images using a novel algorithm.\",\n        \"A system for implementing the compression algorithm.\",\n        \"A compressed image file generated using the algorithm.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67526", "text": "{\n    \"patent_title\": \"Noise Reduction in Digital Images Using Adaptive Filtering\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Adobe Systems\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents an adaptive filtering method for reducing noise in digital images while preserving important image details. The method analyzes the local statistics of the image to dynamically adjust the filter parameters, resulting in improved image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Filtering Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing noise in a digital image comprising...\",\n        \"An apparatus for implementing the noise reduction method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67526", "text": "{\n    \"patent_title\": \"Method for Compressing Video Data\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel video compression algorithm that efficiently encodes video data for storage and transmission. The algorithm utilizes a combination of motion estimation and entropy coding techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Video Coding Standards\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing video data comprising...\",\n        \"A system for encoding video streams...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67527", "text": "{\n    \"patent_title\": \"Ultrasound Image Enhancement for Improved Breast Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Chen\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10543217B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing ultrasound images to improve the detection of small breast cancer lesions. The method uses a novel filtering algorithm to reduce noise and increase image clarity, leading to improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8781234B2\",\n            \"relevance\": \"Prior art in ultrasound image processing.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing ultrasound images comprising...\",\n        \"A system for improving breast cancer detection...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67527", "text": "{\n    \"patent_title\": \"High-Resolution MRI Imaging Techniques\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Williams\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2016-05-20\",\n    \"filing_date\": \"2016-05-20\",\n    \"issue_date\": \"2019-06-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"Novel techniques for achieving high-resolution imaging using Magnetic Resonance Imaging (MRI). This invention focuses on pulse sequence optimization and gradient coil design to enhance image quality and reduce scan time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art in MRI pulse sequence design.\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI pulse sequence comprising...\",\n        \"A gradient coil for high-resolution MRI...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67528", "text": "{\n    \"patent_title\": \"Deep Learning for Enhanced MRI Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for significantly improving the quality and speed of MRI image reconstruction. This allows for faster scan times and improved diagnostic accuracy in identifying subtle anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images using a convolutional neural network.\",\n        \"A system for reducing MRI scan time without compromising image quality.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67528", "text": "{\n    \"patent_title\": \"Improved X-Ray Shielding Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"3M\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-12-01\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2022-09-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new composite material for improved radiation shielding in X-ray applications. This material offers enhanced protection and is cost-effective.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A radiation shielding material comprising a specific polymer blend.\",\n        \"A method for manufacturing the shielding material.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67529", "text": "{\n    \"patent_title\": \"Deep Convolutional Neural Networks for Image Classification\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep convolutional neural network architecture for improved image classification accuracy. The network utilizes novel activation functions and regularization techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for classifying images using a deep convolutional neural network.\",\n        \"A system for image recognition comprising a deep convolutional neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67529", "text": "{\n    \"patent_title\": \"Method for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-01-05\",\n    \"filing_date\": \"2021-03-10\",\n    \"issue_date\": \"2022-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel data compression algorithm based on Huffman coding. Achieves high compression ratios with minimal computational overhead.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for compressing data using Huffman coding.\",\n        \"A system for data storage utilizing a compressed data format.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67530", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2021-07-13\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable biosensor for continuous glucose monitoring, providing real-time data for improved diabetes management and patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on glucose monitoring technology.\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable biosensor comprising...\",\n        \"A method for continuous glucose monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67530", "text": "{\n    \"patent_title\": \"Improved Algorithm for Financial Trading\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved algorithm for high-frequency financial trading, designed to maximize profits and minimize risk.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related prior art in algorithmic trading.\"\n        }\n    ],\n    \"claims\": [\n        \"A computer-implemented method for executing trades...\",\n        \"A system for optimizing trading strategies...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67531", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Enhancement for Medical Diagnostics\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2020-06-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for enhancing the quality of medical images, improving diagnostic accuracy. Utilizes convolutional neural networks and generative adversarial networks (GANs) for image restoration.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art in medical image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing medical images using a deep learning model.\",\n        \"A system for automated medical image diagnosis.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67531", "text": "{\n    \"patent_title\": \"Method for Compressing Digital Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"IBM\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2017-11-10\",\n    \"filing_date\": \"2017-11-10\",\n    \"issue_date\": \"2019-01-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new algorithm for lossless compression of digital images, reducing file size without sacrificing image quality. Based on advanced Huffman coding techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art in image compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing digital images using Huffman coding.\",\n        \"A system for storing and transmitting compressed images.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67532", "text": "{\n    \"patent_title\": \"High-Capacity Solid-State Lithium-Ion Battery with Enhanced Safety Features\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2018-03-20\",\n    \"issue_date\": \"2023-10-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel solid-state lithium-ion battery design utilizing a ceramic electrolyte and a high-capacity cathode material, resulting in significant improvements in energy density, safety, and cycle life. This invention overcomes limitations of conventional lithium-ion batteries by eliminating the flammable liquid electrolyte.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Lithium-Ion Battery with Improved Thermal Stability\"\n        }\n    ],\n    \"claims\": [\n        \"A solid-state lithium-ion battery comprising...\",\n        \"A ceramic electrolyte with a lithium ion conductivity of...\",\n        \"A cathode material with a capacity of...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67532", "text": "{\n    \"patent_title\": \"Improved Lead-Acid Battery Charging System\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Exide Technologies\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-01-10\",\n    \"filing_date\": \"2019-07-15\",\n    \"issue_date\": \"2022-05-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new charging system for lead-acid batteries designed to improve charging efficiency and reduce sulfation. The system utilizes a pulsed charging algorithm to optimize battery performance and extend its lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Lead-Acid Battery with Enhanced Cycle Life\"\n        }\n    ],\n    \"claims\": [\n        \"A charging system for lead-acid batteries comprising...\",\n        \"A pulsed charging algorithm with a frequency of...\",\n        \"A voltage control circuit to maintain...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67533", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction Algorithm for Cardiac MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image reconstruction algorithm for cardiac MRI, utilizing deep learning techniques to enhance image quality and improve the accuracy of detecting subtle cardiac abnormalities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Prior Art MRI Reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a cardiac MRI image...\",\n        \"A system for implementing the image reconstruction method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67533", "text": "{\n    \"patent_title\": \"Automated System for X-Ray Film Archiving\",\n    \"inventors\": [\n        {\n            \"name\": \"Mr. John Smith\",\n            \"affiliation\": \"Acme Medical Solutions\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2014-12-20\",\n    \"filing_date\": \"2014-12-20\",\n    \"issue_date\": \"2020-04-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for digitizing and archiving traditional X-ray films, improving storage efficiency and accessibility of patient records.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Early X-Ray Archiving System\"\n        }\n    ],\n    \"claims\": [\n        \"A system for digitizing and archiving X-ray films...\",\n        \"A method for managing digital X-ray records...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67534", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Enhancement for Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel image enhancement technique utilizing deep learning algorithms to improve the quality of medical images, specifically MRI and CT scans. The system employs convolutional neural networks for noise reduction and contrast enhancement, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Denoising Using Wavelet Transform\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing medical images using deep learning.\",\n        \"A system comprising a convolutional neural network for image processing.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67534", "text": "{\n    \"patent_title\": \"Method for Enhancing Color Contrast in Digital Photographs\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Kodak\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2021-05-04\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method for adjusting color contrast in digital photographs to improve visual appeal. It employs histogram equalization and gamma correction techniques to enhance image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Automatic Color Correction in Digital Images\"\n        }\n    ],\n    \"claims\": [\n        \"A method for adjusting color contrast in digital images.\",\n        \"A system for automatically enhancing the visual appearance of photographs.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67535", "text": "{\n    \"patent_title\": \"Deep Learning Based Image Super-Resolution with Perceptual Loss\",\n    \"inventors\": [\n        {\n            \"name\": \"Li Wei\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Chen Xiaohui\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11786258B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-06-10\",\n    \"issue_date\": \"2023-03-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for improving the resolution of digital images using a deep convolutional neural network trained with a perceptual loss function. This achieves visually superior results compared to traditional super-resolution techniques by focusing on perceptual similarity rather than pixel-wise error.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9875342B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for super-resolving an image comprising: training a deep convolutional neural network with a perceptual loss function; applying the trained network to a low-resolution input image to generate a high-resolution output image.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67535", "text": "{\n    \"patent_title\": \"Method for Sharpening Digital Images\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10542891B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2020-01-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A digital image sharpening method based on unsharp masking. The method enhances the edges of an image to improve its perceived clarity.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for sharpening a digital image comprising: applying an unsharp mask to the image; adjusting the mask parameters to control the sharpening effect.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67536", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Cancer Detection Using Multi-Modal Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-07-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for improving cancer detection accuracy by integrating data from multiple medical imaging modalities, including MRI, CT, and PET scans. The system utilizes advanced image processing algorithms and machine learning techniques to identify subtle anomalies indicative of cancerous growths.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8540901B2\",\n            \"relevance\": \"Prior art in image segmentation\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancer comprising...\",\n        \"A system for processing medical images to identify cancerous tissues...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67536", "text": "{\n    \"patent_title\": \"Improved Algorithm for Noise Reduction in Ultrasound Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-22\",\n    \"filing_date\": \"2017-11-22\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel algorithm for reducing noise in ultrasound images, resulting in clearer and more detailed visualizations of internal structures. The algorithm utilizes adaptive filtering techniques to minimize unwanted artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"relevance\": \"Previous work on ultrasound filtering\"\n        }\n    ],\n    \"claims\": [\n        \"An algorithm for noise reduction in ultrasound images...\",\n        \"A system for processing ultrasound data utilizing adaptive filtering...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67537", "text": "{\n    \"patent_title\": \"Method and System for Improving Image Contrast in Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2015-03-15\",\n    \"filing_date\": \"2015-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for improving image contrast in medical imaging techniques such as MRI and CT scans. The method utilizes a novel filtering algorithm to enhance the visibility of subtle details and improve diagnostic accuracy. The improved contrast is achieved by...\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image contrast...\",\n        \"A system for medical imaging comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67537", "text": "{\n    \"patent_title\": \"Portable X-Ray Device for Veterinary Use\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Davis\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2016-05-20\",\n    \"filing_date\": \"2016-05-20\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A portable X-ray device designed specifically for veterinary applications. The device is lightweight and easy to maneuver, enabling rapid image acquisition in various clinical settings. It utilizes a low-dose radiation technique to minimize exposure to animals.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A portable X-ray device comprising...\",\n        \"A method for veterinary radiography...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67538", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Cardiac Monitor with Wireless Charging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"CardioTech Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable cardiac monitor with wireless charging capability, providing long-term, real-time cardiac data acquisition and transmission. The device utilizes novel energy harvesting techniques and biocompatible materials.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art related to implantable cardiac devices.\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable cardiac monitor comprising...\",\n        \"A wireless charging system for said monitor...\",\n        \"A method for real-time cardiac data acquisition...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67538", "text": "{\n    \"patent_title\": \"Method for Automated Diagnosis of Skin Cancer Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2021-05-20\",\n    \"filing_date\": \"2021-05-20\",\n    \"issue_date\": \"2023-06-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for automated diagnosis of skin cancer using a deep learning model trained on a large dataset of dermatoscopic images. The system provides a probability score indicating the likelihood of malignancy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related to image processing for medical diagnosis.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for diagnosing skin cancer comprising...\",\n        \"A deep learning model trained on dermatoscopic images...\",\n        \"A system for providing a malignancy probability score...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67539", "text": "{\n    \"patent_title\": \"Novel MRI Contrast Agent for Early-Stage Breast Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-04-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel MRI contrast agent is disclosed, enabling enhanced detection of early-stage breast cancer through improved signal-to-noise ratio and targeted delivery to tumor cells.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on MRI contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting breast cancer comprising...\",\n        \"An MRI contrast agent comprising...\",\n        \"A pharmaceutical composition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67539", "text": "{\n    \"patent_title\": \"Improved Algorithm for Image Compression in Digital Radiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-11-22\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-09-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved algorithm for lossless compression of digital radiographic images is described, enhancing storage efficiency and transmission speeds.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art on image compression techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a digital image...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67540", "text": "{\n    \"patent_title\": \"Low-Light Image Enhancement Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-05-15\",\n    \"filing_date\": \"2020-05-15\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method for enhancing images captured in low-light conditions using a deep convolutional neural network. The network is trained to map low-light images to high-quality images with improved visibility and reduced noise.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing low-light images comprising...\",\n        \"A deep convolutional neural network configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67540", "text": "{\n    \"patent_title\": \"Color Correction in Digital Photography\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Kodak\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2021-08-01\",\n    \"filing_date\": \"2021-08-01\",\n    \"issue_date\": \"2023-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method for improving color accuracy in digital photographs. The method utilizes a color transformation algorithm to adjust the color balance of an image.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for correcting color in digital images comprising...\",\n        \"A color transformation algorithm configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67541", "text": "{\n    \"patent_title\": \"Novel Biosensor for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel biosensor utilizing nanotechnology for the highly sensitive and specific detection of cancer biomarkers in bodily fluids, enabling early cancer diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A biosensor comprising a nanomaterial-based sensing element...\",\n        \"A method for detecting cancer biomarkers...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67541", "text": "{\n    \"patent_title\": \"Improved Catheter Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-12-15\",\n    \"issue_date\": \"2022-06-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved design for a medical catheter with enhanced flexibility and reduced patient discomfort during insertion.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible polymer shaft...\",\n        \"A method for inserting a catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67542", "text": "{\n    \"patent_title\": \"High-Resolution Photoacoustic Tomography System with Deep Learning Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Meng Wang\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Chiu\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11876543B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-09\",\n    \"issue_date\": \"2023-12-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A high-resolution photoacoustic tomography (PAT) system is disclosed, incorporating a novel ultrasound transducer array and a deep learning-based image reconstruction algorithm. The system provides enhanced image quality and improved penetration depth for non-invasive diagnostic imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Photoacoustic Imaging Apparatus\"\n        }\n    ],\n    \"claims\": [\n        \"A photoacoustic tomography system comprising...\",\n        \"A method for reconstructing an image from photoacoustic data...\",\n        \"A non-invasive diagnostic method using the system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67542", "text": "{\n    \"patent_title\": \"Improved X-ray Detector for Mammography\",\n    \"inventors\": [\n        {\n            \"name\": \"Elizabeth Chen\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Robert Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2019-12-16\",\n    \"issue_date\": \"2022-04-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved X-ray detector for mammography is disclosed, featuring enhanced sensitivity and reduced radiation dose. The detector utilizes a novel scintillator material and a digital readout system.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Digital X-ray Imaging System\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray detector comprising...\",\n        \"A method for detecting X-rays...\",\n        \"A mammography system using the detector...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67543", "text": "{\n    \"patent_title\": \"Medical Image Enhancement Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning approach for enhancing the quality of medical images, improving diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing medical images using a convolutional neural network.\",\n        \"A system for automated image analysis.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67543", "text": "{\n    \"patent_title\": \"Digital Image Watermarking Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-01-05\",\n    \"filing_date\": \"2021-03-10\",\n    \"issue_date\": \"2023-05-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A robust watermarking technique for protecting digital images from unauthorized copying.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for embedding a watermark into a digital image.\",\n        \"A system for verifying the authenticity of a digital image.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67544", "text": "{\n    \"patent_title\": \"Method and System for Noise Reduction in Computed Tomography Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, San Francisco\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for reducing noise in computed tomography (CT) images while minimizing radiation dose. The method utilizes a novel filtering algorithm to enhance image clarity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8567890B1\",\n            \"title\": \"Image Reconstruction Technique for CT Scanners\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing noise in a CT image comprising...\",\n        \"A system for CT imaging comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67544", "text": "{\n    \"patent_title\": \"Automated Diagnostic System for Skin Lesions\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for automatically diagnosing skin lesions based on image analysis using machine learning.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Method for Image Segmentation in Dermatology\"\n        }\n    ],\n    \"claims\": [\n        \"A system for diagnosing skin lesions comprising...\",\n        \"A method for analyzing skin lesion images comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67545", "text": "{\n    \"patent_title\": \"Improved MRI Contrast Agent for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2018-11-15\",\n    \"filing_date\": \"2019-05-20\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel MRI contrast agent with enhanced sensitivity for detecting early-stage cancerous tumors. The contrast agent utilizes targeted nanoparticles to improve signal amplification and reduce false positives, offering a more accurate and reliable diagnostic tool.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on nanoparticle contrast agents.\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising targeted nanoparticles for MRI imaging.\",\n        \"A method for detecting early-stage cancer using the contrast agent.\",\n        \"A system for image analysis utilizing the contrast agent signal.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67545", "text": "{\n    \"patent_title\": \"Automated Blood Cell Counter\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2019-08-01\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for counting blood cells with improved speed and accuracy. The system employs image processing techniques to identify and classify different types of blood cells.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous work on automated cell counting.\"\n        }\n    ],\n    \"claims\": [\n        \"An automated blood cell counter system.\",\n        \"A method for identifying and classifying blood cells.\",\n        \"A user interface for displaying cell count data.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67546", "text": "{\n    \"patent_title\": \"Improved Method for Contrast-Enhanced Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2018-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method for enhancing contrast in magnetic resonance images, leading to improved detection of subtle abnormalities and enhanced diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8545321B2\",\n            \"title\": \"Contrast Agents for MRI\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing contrast in MRI comprising...\",\n        \"An MRI apparatus configured to implement the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67546", "text": "{\n    \"patent_title\": \"Digital X-Ray Image Processing Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US7654321B1\",\n    \"priority_date\": \"2014-12-15\",\n    \"filing_date\": \"2015-01-05\",\n    \"issue_date\": \"2017-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image processing algorithm for reducing noise and improving the quality of digital X-ray images. It uses a wavelet transform and adaptive filtering.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"title\": \"Wavelet-Based Image Denoising\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing digital X-ray images...\",\n        \"A system for implementing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67547", "text": "{\n    \"patent_title\": \"Deep Learning Framework for Anomaly Detection in High-Dimensional Data\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"12345678\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for identifying anomalies in complex datasets. The framework utilizes autoencoders and variational autoencoders to learn robust data representations, enabling accurate anomaly detection in various applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"11223344\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting anomalies in data using a deep learning model.\",\n        \"A system comprising a deep learning model configured to identify anomalies.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67547", "text": "{\n    \"patent_title\": \"System and Method for Recommendation Engines\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"9876543\",\n    \"priority_date\": \"2019-11-20\",\n    \"filing_date\": \"2019-11-20\",\n    \"issue_date\": \"2022-04-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for providing personalized recommendations to users based on their preferences and historical data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"87654321\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating recommendations based on user preferences.\",\n        \"A system for displaying recommendations to a user.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67548", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Recognition Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2022-05-15\",\n    \"filing_date\": \"2022-06-01\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for improving image recognition accuracy using deep convolutional neural networks. The system utilizes a novel architecture that enhances feature extraction and classification performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Similar approach to feature extraction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67548", "text": "{\n    \"patent_title\": \"Digital Image Storage and Retrieval System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"IBM\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-12-20\",\n    \"filing_date\": \"2019-01-15\",\n    \"issue_date\": \"2020-03-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for efficiently storing and retrieving digital images. The system utilizes a database and indexing scheme to facilitate fast access to images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related to data storage\"\n        }\n    ],\n    \"claims\": [\n        \"A system for storing digital images...\",\n        \"A method for retrieving digital images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67549", "text": "{\n    \"patent_title\": \"Wearable Sensor System for Continuous Non-Invasive Blood Pressure Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-09-20\",\n    \"issue_date\": \"2019-12-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wearable sensor system for continuous and non-invasive blood pressure monitoring. The system utilizes a novel optical sensor and signal processing algorithms to provide accurate and reliable blood pressure readings without the need for a traditional cuff. This addresses the need for continuous blood pressure monitoring in patients with hypertension and other cardiovascular conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A wearable sensor system for non-invasive blood pressure monitoring comprising...\",\n        \"A method for continuously monitoring blood pressure using said sensor system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67549", "text": "{\n    \"patent_title\": \"Surgical Instrument for Bone Cutting\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2019-05-01\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2021-01-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical instrument designed for precise bone cutting during orthopedic procedures. The instrument features a novel blade geometry and ergonomic handle for improved control and maneuverability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising a blade with a specific geometry...\",\n        \"A method of cutting bone using said instrument...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67550", "text": "{\n    \"patent_title\": \"Implantable Cardiac Rhythm Management System with Adaptive Pacing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Boston University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2015-03-15\",\n    \"filing_date\": \"2015-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac rhythm management system that automatically adjusts pacing parameters based on real-time physiological data to optimize cardiac output and minimize energy consumption.  Utilizes novel algorithms for arrhythmia detection and adaptive pacing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for pacing the heart, comprising...\",\n        \"A method for adaptively adjusting pacing parameters...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67550", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-05-20\",\n    \"filing_date\": \"2016-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical stapler designed with enhanced ergonomic features to reduce surgeon fatigue and improve precision during surgical procedures. Includes a redesigned handle and improved staple cartridge alignment.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"A handle assembly configured for ergonomic grip...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67551", "text": "{\n    \"patent_title\": \"Improved MRI Reconstruction for Enhanced Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing magnetic resonance images (MRI) to improve the detection of small tumors. The method utilizes a deep learning algorithm to reduce noise and enhance image clarity, leading to increased diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8766854B2\",\n            \"title\": \"MRI Reconstruction Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for detecting tumors using reconstructed MRI images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67551", "text": "{\n    \"patent_title\": \"Automated X-Ray Analysis for Bone Fracture Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2019-08-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for analyzing X-ray images to detect bone fractures. The system employs image processing techniques to identify fracture lines and provide diagnostic assistance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"X-Ray Image Enhancement\"\n        }\n    ],\n    \"claims\": [\n        \"A system for detecting bone fractures in X-ray images...\",\n        \"A method for analyzing X-ray images comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67552", "text": "{\n    \"patent_title\": \"Improved MRI Contrast Agent for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10554237B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel MRI contrast agent exhibiting enhanced sensitivity and specificity for early-stage cancer detection, improving diagnostic accuracy and patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8986321B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A composition comprising a gadolinium complex...\",\n        \"A method for detecting cancer...\",\n        \"An MRI apparatus utilizing the composition...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67552", "text": "{\n    \"patent_title\": \"Digital Radiography Enhancement Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An algorithm for enhancing the quality of digital radiography images, reducing noise and improving clarity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing digital radiography images...\",\n        \"A computer-readable medium storing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67553", "text": "{\n    \"patent_title\": \"High-Resolution Optical Coherence Tomography System for In Vivo Tissue Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"David Huang\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Eric Swanson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A high-resolution optical coherence tomography (OCT) system capable of in vivo imaging of biological tissues. The system utilizes a swept-source laser and advanced signal processing techniques to achieve enhanced image quality and penetration depth.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Highly Relevant\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Relevant\"\n        },\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"Somewhat Relevant\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating a high-resolution image of a biological tissue using OCT.\",\n        \"An OCT system comprising a swept-source laser, a scanning mechanism, and a signal processing unit.\",\n        \"A device for in vivo imaging of retinal structures.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67553", "text": "{\n    \"patent_title\": \"Method for Analyzing Genetic Sequences\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10246813B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for analyzing genetic sequences to identify disease markers. The method employs machine learning algorithms to predict the likelihood of genetic predispositions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Relevant\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Somewhat Relevant\"\n        }\n    ],\n    \"claims\": [\n        \"A method for analyzing genetic sequences using machine learning.\",\n        \"A system for predicting disease predispositions based on genetic data.\",\n        \"A computer-readable medium storing instructions for performing genetic sequence analysis.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67554", "text": "{\n    \"patent_title\": \"Deep Convolutional Neural Networks for Enhanced Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2020-10-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep convolutional neural network architecture for improved image recognition accuracy and efficiency. The network utilizes residual connections and attention mechanisms to achieve state-of-the-art results on benchmark datasets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Convolutional Neural Networks for Image Classification\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image analysis...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67554", "text": "{\n    \"patent_title\": \"Method for Processing Digital Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"EP3210987A1\",\n    \"priority_date\": \"2017-12-01\",\n    \"filing_date\": \"2017-12-01\",\n    \"issue_date\": \"2019-03-13\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"A method for enhancing the contrast of digital images using histogram equalization. The method improves image quality for visualization purposes.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for contrast enhancement...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67555", "text": "{\n    \"patent_title\": \"AI-Powered Image Analysis for Enhanced Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel deep learning model for analyzing medical images (CT scans, MRIs) to detect cancerous tissues with improved accuracy and reduced false positive rates. The system utilizes convolutional neural networks and transfer learning techniques to identify subtle patterns indicative of malignancy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancer in a medical image comprising...\",\n        \"A system for analyzing medical images using a deep learning model...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The method of claim 1, wherein the deep learning model is a convolutional neural network.\",\n        \"The system of claim 2, wherein the medical image is a CT scan.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67555", "text": "{\n    \"patent_title\": \"Automated Reporting System for X-Ray Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-12-01\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-08-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a system for automatically generating reports from X-ray images, focusing on standardized terminology and efficient workflow. It utilizes image processing techniques to identify key anatomical structures and generate preliminary findings.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for generating reports from X-ray images comprising...\",\n        \"A method for identifying anatomical structures in an X-ray image...\",\n        \"A computer-readable medium storing a database of anatomical terms...\",\n        \"The system of claim 1, wherein the report is formatted in a standardized manner.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67556", "text": "{\n    \"patent_title\": \"Improved Resolution MRI Imaging Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10555555B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-12-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel magnetic resonance imaging (MRI) technique that significantly improves image resolution and clarity through a combination of advanced pulse sequences and signal processing algorithms. The improved image quality enables more accurate diagnosis of subtle anatomical abnormalities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8888888B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI imaging...\",\n        \"An MRI apparatus comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67556", "text": "{\n    \"patent_title\": \"Automated Surgical Instrument Tracking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US9999999B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2021-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system for tracking surgical instruments during a medical procedure. The system utilizes infrared sensors and a computer processor to determine the precise location and orientation of each instrument. This improves surgical accuracy and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7777777B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument tracking system...\",\n        \"A method for tracking a surgical instrument...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67557", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Enhancement for Medical Diagnostics\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for enhancing the resolution and contrast of medical images, improving diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing medical images using a convolutional neural network.\",\n        \"A system for automated image analysis in medical diagnostics.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67557", "text": "{\n    \"patent_title\": \"Method for Color Correction in Digital Photographs\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Kodak Inc.\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2019-12-01\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-08-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and apparatus for automatically correcting color imbalances in digital photographs using a lookup table.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for color correction using a lookup table.\",\n        \"A digital camera incorporating the color correction method.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67558", "text": "{\n    \"patent_title\": \"Adaptive Histogram Equalization for Enhanced Low-Light Image Visibility\",\n    \"inventors\": [\n        {\n            \"name\": \"David L. Chen\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Sarah M. Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-10-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for enhancing the visibility of images captured in low-light conditions using adaptive histogram equalization. The technique improves contrast and detail without introducing significant artifacts, offering a robust solution for various imaging applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing low-light images comprising...\",\n        \"An image processing system configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67558", "text": "{\n    \"patent_title\": \"Deep Convolutional Neural Network for Low-Light Image Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Emily K. Garcia\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Michael R. Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2021-05-20\",\n    \"filing_date\": \"2021-05-20\",\n    \"issue_date\": \"2023-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep convolutional neural network (DCNN) architecture for robust low-light image enhancement. The network is trained on a large dataset of low-light images and utilizes advanced learning techniques to achieve state-of-the-art performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A deep learning model for low-light image enhancement comprising...\",\n        \"A system for implementing the deep learning model...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67559", "text": "{\n    \"patent_title\": \"Targeted Drug Delivery System for Autoimmune Disease Treatment\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel drug delivery system utilizing nanoparticles to selectively target immune cells involved in autoimmune responses, enhancing therapeutic efficacy and reducing systemic side effects.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Prior art on nanoparticle synthesis\"\n        }\n    ],\n    \"claims\": [\n        \"A drug delivery system comprising nanoparticles...\",\n        \"A method for treating autoimmune diseases...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67559", "text": "{\n    \"patent_title\": \"Improved Catalyst for Polymer Production\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new catalytic process for the efficient production of high-performance polymers, improving yield and reducing waste.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\",\n            \"relevance\": \"Previous catalyst designs\"\n        }\n    ],\n    \"claims\": [\n        \"A catalyst composition comprising...\",\n        \"A method for polymerizing monomers...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67560", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical Device with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-11-20\",\n    \"issue_date\": \"2021-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical device enabling minimally invasive procedures with improved visualization and precision.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical device comprising a miniaturized camera and robotic arms.\",\n        \"A method for performing a surgical procedure using the aforementioned device.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67560", "text": "{\n    \"patent_title\": \"System for Large-Scale Pharmaceutical Production\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-12-01\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2022-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for efficient and large-scale production of pharmaceutical compounds.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A pharmaceutical production system comprising automated reactors.\",\n        \"A method for producing a pharmaceutical compound at scale.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67561", "text": "{\n    \"patent_title\": \"High-Resolution Medical Imaging System Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel medical imaging system utilizing deep learning algorithms to significantly enhance image resolution and diagnostic accuracy, particularly in detecting early-stage cancers. The system provides clearer images with reduced noise, leading to improved diagnostic capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Prior art in medical imaging.\"\n        }\n    ],\n    \"claims\": [\n        \"A medical imaging system comprising...\",\n        \"A method for enhancing image resolution...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67561", "text": "{\n    \"patent_title\": \"Portable X-Ray Device for Veterinary Use\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Animal Health Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A compact and portable X-ray device designed for veterinary applications. The device offers ease of use and affordability for on-site diagnostics in animal clinics and farms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344AA\",\n            \"relevance\": \"Related to portable X-ray technology.\"\n        }\n    ],\n    \"claims\": [\n        \"A portable X-ray device...\",\n        \"A method for performing X-ray imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67562", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Contrast Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for enhancing contrast in medical imaging, particularly MRI and CT scans, utilizing a new class of contrast agents and image reconstruction algorithms. This invention improves diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8652345B2\",\n            \"relevance\": \"Prior art in contrast agent technology\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing contrast in medical imaging...\",\n        \"A system for implementing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67562", "text": "{\n    \"patent_title\": \"Improved X-Ray Tube Design for Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved design for X-ray tubes used in medical imaging, focusing on increased efficiency and reduced radiation exposure. The design includes a novel anode material and cooling system.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7543210B2\",\n            \"relevance\": \"Previous X-ray tube designs\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube with an improved anode material...\",\n        \"A medical imaging system incorporating the improved X-ray tube...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67563", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Enhancement for Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-15\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for enhancing the quality of medical images, improving diagnostic accuracy. This system leverages a generative adversarial network to reduce noise and enhance contrast.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing medical images using a deep learning model.\",\n        \"A system comprising a generative adversarial network for image enhancement.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67563", "text": "{\n    \"patent_title\": \"Image Processing Technique for Mobile Phones\",\n    \"inventors\": [\n        {\n            \"name\": \"David Kim\",\n            \"affiliation\": \"Samsung Electronics\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-15\",\n    \"issue_date\": \"2022-06-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An image processing technique for improving the clarity of images captured by mobile phone cameras. The algorithm focuses on noise reduction and color correction.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for enhancing images captured by a mobile phone camera.\",\n        \"A mobile phone comprising an image processing module.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67564", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Super-Resolution with Generative Adversarial Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Microsoft Research\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for image super-resolution using generative adversarial networks. This method significantly enhances image quality and detail compared to existing techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on image upscaling\"\n        }\n    ],\n    \"claims\": [\n        \"A method for super-resolving an image using a generative adversarial network.\",\n        \"A system comprising a generator network and a discriminator network for enhancing image resolution.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67564", "text": "{\n    \"patent_title\": \"Method for Basic Image Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Eve Davis\",\n            \"affiliation\": \"XYZ Corp\"\n        },\n        {\n            \"name\": \"Frank Miller\",\n            \"affiliation\": \"XYZ Corp\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-15\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A simple image compression algorithm based on discrete cosine transform. This method reduces file size with acceptable quality loss.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for compressing an image using a discrete cosine transform.\",\n        \"A system for reducing image file size.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67565", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10245789B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the clarity of medical images using advanced reconstruction algorithms. The invention improves diagnostic accuracy by reducing noise and artifacts in the images.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"A system comprising a processor and memory...\",\n        \"The method of claim 1, wherein the noise reduction algorithm is a wavelet-based filter.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67565", "text": "{\n    \"patent_title\": \"Contrast-Enhanced Medical Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2014-12-01\",\n    \"filing_date\": \"2014-12-01\",\n    \"issue_date\": \"2019-04-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A medical imaging system utilizing contrast agents to improve visualization of internal structures. The system includes a delivery mechanism for the contrast agent and image processing techniques to enhance the contrast.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"title\": \"Novel Contrast Agents for MRI\"\n        }\n    ],\n    \"claims\": [\n        \"A medical imaging system comprising...\",\n        \"A contrast agent delivery mechanism...\",\n        \"The system of claim 1, wherein the contrast agent is a gadolinium-based compound.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67566", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for Magnetic Resonance Angiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9782456B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel contrast agent for magnetic resonance angiography (MRA) provides significantly improved signal enhancement and resolution, leading to more accurate vascular imaging and diagnosis of cardiovascular diseases.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8540000B2\",\n            \"relevance\": \"Prior art contrast agent\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent for MRA comprising...\",\n        \"A method for visualizing blood vessels...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67566", "text": "{\n    \"patent_title\": \"Digital X-Ray Image Enhancement System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2021-03-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a digital X-ray image enhancement system that improves the clarity and detail of X-ray images. The system utilizes advanced algorithms to reduce noise and enhance contrast.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7678901B2\",\n            \"relevance\": \"Basic X-ray processing techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A digital X-ray image enhancement system comprising...\",\n        \"A method for improving X-ray image quality...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67567", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction for Enhanced Diagnostic Accuracy in MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for improving image reconstruction in magnetic resonance imaging (MRI) to enhance diagnostic accuracy by reducing noise and artifacts. The method utilizes a novel filtering algorithm combined with iterative reconstruction techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"MRI Image Processing Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"An MRI system configured to implement the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67567", "text": "{\n    \"patent_title\": \"Medical Imaging Device with Enhanced Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Carl Davis\",\n            \"affiliation\": \"Siemens Healthcare\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Siemens AG\"\n        }\n    ],\n    \"patent_number\": \"EP3456789A1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2018-11-28\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"An improved medical imaging device featuring high-speed data transmission capabilities for real-time image display. The device incorporates a novel communication protocol to minimize latency and ensure accurate image rendering.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"High-Speed Data Transmission for Medical Devices\"\n        }\n    ],\n    \"claims\": [\n        \"A medical imaging device comprising a high-speed data transmission module...\",\n        \"A communication protocol for transmitting medical imaging data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67568", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Restoration using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2018-11-15\",\n    \"filing_date\": \"2019-05-20\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for restoring degraded images. The method effectively removes noise and artifacts, resulting in significant improvements in image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for restoring an image comprising...\",\n        \"A system for enhancing image quality...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67568", "text": "{\n    \"patent_title\": \"System and Method for 3D Object Reconstruction from Multiple Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Google Inc.\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2019-02-01\",\n    \"filing_date\": \"2019-08-15\",\n    \"issue_date\": \"2021-01-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for reconstructing a three-dimensional model of an object from a set of two-dimensional images captured from different viewpoints.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a 3D object comprising...\",\n        \"A system for generating a 3D model...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67569", "text": "{\n    \"patent_title\": \"Magnetic Resonance Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel deep learning architecture for reconstructing high-resolution magnetic resonance images from undersampled k-space data, improving diagnostic accuracy by reducing noise and artifacts. The method allows for faster scan times and enhanced image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images...\",\n        \"A system comprising a magnetic resonance imaging apparatus and a processing unit...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67569", "text": "{\n    \"patent_title\": \"X-Ray Imaging System with Reduced Dose\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2020-11-15\",\n    \"filing_date\": \"2020-11-15\",\n    \"issue_date\": \"2022-08-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An X-ray imaging system designed to minimize radiation exposure while maintaining diagnostic image quality. The system utilizes advanced filtration techniques and iterative reconstruction algorithms to reduce the dose required for accurate diagnosis. This invention is especially useful in pediatric imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\",\n            \"relevance\": \"Previous work on radiation reduction\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A method for reducing radiation dose in X-ray imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67570", "text": "{\n    \"patent_title\": \"Implantable Cardiac Monitor with Enhanced Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac monitor providing real-time ECG data transmission with improved battery life and reduced signal interference.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art related to implantable sensors\"\n        }\n    ],\n    \"claims\": [\n        \"A method for monitoring cardiac activity comprising...\",\n        \"An implantable device for detecting arrhythmias...\",\n        \"A system for transmitting cardiac data wirelessly...\",\n        \"A battery management system for extending device life...\",\n        \"A signal processing unit for reducing noise in ECG signals...\",\n        \"A method of configuring device parameters...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67570", "text": "{\n    \"patent_title\": \"Surgical Instrument for Orthopedic Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Acme Medical Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-01\",\n    \"issue_date\": \"2023-09-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical instrument designed for precise bone cutting during orthopedic surgeries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art on surgical instrument design\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising...\",\n        \"A cutting blade for bone resection...\",\n        \"A handle for gripping the instrument...\",\n        \"A locking mechanism for blade stability...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67571", "text": "{\n    \"patent_title\": \"Noise Reduction in Digital Images Using Wavelet Transform\",\n    \"inventors\": [\n        {\n            \"name\": \"Marc Levoy\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jia-Wei Han\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel method for reducing noise in digital images using a wavelet transform-based approach. The technique effectively separates noise from image details, resulting in significantly improved image clarity and visual quality.  It is particularly effective in low-light conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing noise in a digital image...\",\n        \"An apparatus for noise reduction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67571", "text": "{\n    \"patent_title\": \"Method for Compressing Vector Graphics\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Bosch\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2021-05-20\",\n    \"filing_date\": \"2021-05-20\",\n    \"issue_date\": \"2024-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel approach to compressing vector graphics is described, allowing for efficient storage and transmission of visual data. The method utilizes a combination of lossless and lossy compression algorithms to achieve high compression ratios.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing vector graphics...\",\n        \"An apparatus for vector graphic compression...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67572", "text": "{\n    \"patent_title\": \"Implantable Sensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2013-05-10\",\n    \"filing_date\": \"2014-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an implantable glucose sensor providing continuous monitoring and data transmission for improved diabetes management and patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8652089B2\",\n            \"relevance\": \"Prior art in implantable sensors.\"\n        }\n    ],\n    \"claims\": [\n        \"A glucose sensor for continuous monitoring.\",\n        \"A system for transmitting glucose data wirelessly.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67572", "text": "{\n    \"patent_title\": \"Surgical Instrument for Bone Cutting\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-08-01\",\n    \"filing_date\": \"2017-02-10\",\n    \"issue_date\": \"2018-04-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a surgical instrument designed for precise bone cutting during orthopedic procedures. It enhances surgical efficiency and accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7988456B2\",\n            \"relevance\": \"Existing bone cutting tools.\"\n        }\n    ],\n    \"claims\": [\n        \"A bone cutting instrument with a novel blade design.\",\n        \"A method for precise bone resection.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67573", "text": "{\n    \"patent_title\": \"Adaptive Beamforming for Enhanced Wireless Signal Strength in Urban Environments\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Intel Corporation\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for adaptive beamforming in wireless communication networks to mitigate signal fading and enhance signal strength in dense urban environments. The system dynamically adjusts beam patterns based on real-time channel state information.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760987B2\"\n        },\n        {\n            \"patent_number\": \"US9235345B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for adjusting a beam pattern in a wireless communication system.\",\n        \"A system for enhancing signal strength in a dense urban environment.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67573", "text": "{\n    \"patent_title\": \"Improved Battery Life for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Samsung Electronics\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Qualcomm\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for dynamically adjusting processor speed and screen brightness to prolong battery life in mobile devices. Includes power saving modes and user-configurable settings.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        },\n        {\n            \"patent_number\": \"US8987654B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for prolonging battery life in a mobile device.\",\n        \"A system for managing power consumption in a mobile device.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67574", "text": "{\n    \"patent_title\": \"Low-Light Image Enhancement Using Adaptive Histogram Equalization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the quality of images captured in low-light conditions. The method employs an adaptive histogram equalization technique that adjusts the histogram based on local image characteristics to improve contrast and visibility.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Enhancement System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing a low-light image, comprising...\",\n        \"A system for processing images, configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67574", "text": "{\n    \"patent_title\": \"Efficient Video Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-04-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel video compression algorithm that reduces bandwidth requirements while maintaining acceptable video quality. The algorithm utilizes advanced transform coding and quantization techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Video Coding Standard\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing video data, comprising...\",\n        \"A video encoding device, configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67575", "text": "{\n    \"patent_title\": \"AI-Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2020-01-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method for reconstructing medical images using artificial intelligence. Specifically, a deep learning model is trained to enhance image quality and reduce noise, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"A system for implementing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67575", "text": "{\n    \"patent_title\": \"Improved X-Ray Tube Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US9123456B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-14\",\n    \"issue_date\": \"2019-09-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel design for an X-ray tube, improving its efficiency and lifespan. The new design incorporates a modified anode and cooling system.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube comprising...\",\n        \"A cooling system for the X-ray tube...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67576", "text": "{\n    \"patent_title\": \"Improved MRI Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing MRI images using deep convolutional neural networks. The method improves image quality and reduces scan time, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67576", "text": "{\n    \"patent_title\": \"Enhanced X-Ray Shielding Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2013-11-20\",\n    \"filing_date\": \"2013-11-20\",\n    \"issue_date\": \"2017-08-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new material for shielding patients from X-ray radiation during medical imaging procedures. The material provides improved protection with reduced weight.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A shielding material comprising...\",\n        \"A method for protecting a patient from X-ray radiation...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67577", "text": "{\n    \"patent_title\": \"Novel Method for Accelerated MRI Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for accelerating Magnetic Resonance Imaging (MRI) reconstruction using a deep learning framework. The method significantly reduces scan time while maintaining image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8766954B2\"\n        },\n        {\n            \"patent_number\": \"US9123789B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"A system for performing MRI reconstruction...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67577", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for X-ray Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2019-08-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved contrast agent for X-ray imaging, offering enhanced visibility of soft tissues.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"A method of enhancing X-ray imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67578", "text": "{\n    \"patent_title\": \"Enhanced Image Reconstruction for Low-Dose CT Scans\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A novel image reconstruction algorithm for computed tomography (CT) scans that reduces radiation dose while maintaining diagnostic image quality. The algorithm utilizes deep learning techniques to enhance image clarity and reduce noise, leading to improved detection of subtle anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8652123B1\",\n            \"relevance\": \"Prior art on CT image reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a CT image comprising...\",\n        \"A system for reducing radiation dose in CT scans...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67578", "text": "{\n    \"patent_title\": \"Method for Magnetic Resonance Imaging of the Brain\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"University of Munich\"\n        }\n    ],\n    \"patent_number\": \"EP3456789B1\",\n    \"priority_date\": \"2017-03-10\",\n    \"filing_date\": \"2017-03-10\",\n    \"issue_date\": \"2018-11-05\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"A new pulse sequence for magnetic resonance imaging (MRI) that improves the visualization of brain structures. This method utilizes a novel gradient scheme to reduce artifacts and enhance contrast.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7543210B2\",\n            \"relevance\": \"Related work on MRI pulse sequences\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI pulse sequence comprising...\",\n        \"A method for enhancing brain image contrast...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67579", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Reconstruction in Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing high-resolution MRI images with reduced scan time and improved signal-to-noise ratio. The invention utilizes a deep learning algorithm to enhance image quality and reduce artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6789012B1\",\n            \"inventor\": \"Siemens Medical Solutions\"\n        },\n        {\n            \"patent_number\": \"US5432109B2\",\n            \"inventor\": \"Philips Healthcare\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"A system for performing MRI image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67579", "text": "{\n    \"patent_title\": \"Portable X-Ray Device with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"SmallTech Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A compact and portable X-ray device with integrated wireless communication capabilities for remote image viewing and diagnostics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"inventor\": \"Canon Inc.\"\n        }\n    ],\n    \"claims\": [\n        \"A portable X-ray device comprising...\",\n        \"A wireless communication module for transmitting X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67580", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Super-Resolution with Artifact Removal\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-01\",\n    \"issue_date\": \"2021-10-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel deep learning architecture for image super-resolution that effectively removes artifacts commonly found in upscaled images. The network utilizes a generative adversarial network (GAN) with a perceptual loss function to produce high-quality, visually appealing results.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image scaling\"\n        }\n    ],\n    \"claims\": [\n        \"A method for super-resolving an image comprising...\",\n        \"A deep learning model configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67580", "text": "{\n    \"patent_title\": \"Method for Color Image Conversion\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corp\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-06-20\",\n    \"filing_date\": \"2019-12-10\",\n    \"issue_date\": \"2021-08-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a method for converting images from one color space to another, such as RGB to grayscale. The method includes a lookup table and a simple formula for pixel conversion.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for converting a color image...\",\n        \"A system comprising a lookup table...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67581", "text": "{\n    \"patent_title\": \"Endoscopic Surgical Stapler with Integrated Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-06-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel endoscopic surgical stapler incorporating a miniature high-resolution camera for enhanced visualization during minimally invasive procedures. The device allows surgeons to precisely position and deploy staples while maintaining direct visual feedback, reducing the risk of complications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8568002B2\",\n            \"relevance\": \"Prior art on endoscopic staplers\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an endoscopic shaft and an integrated imaging device.\",\n        \"The surgical stapler of claim 1, wherein the imaging device is a miniature camera.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67581", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Cardiovascular Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Williams\",\n            \"affiliation\": \"Johnson & Johnson\"\n        },\n        {\n            \"name\": \"Dr. Maria Rodriguez\",\n            \"affiliation\": \"Boston Scientific\"\n        }\n    ],\n    \"patent_number\": \"US9238217B1\",\n    \"priority_date\": \"2014-12-20\",\n    \"filing_date\": \"2014-12-20\",\n    \"issue_date\": \"2016-01-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel catheter design for improved navigability and reduced trauma during cardiovascular procedures. The catheter features a flexible distal tip and an enhanced delivery system for therapeutic agents.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"relevance\": \"Prior art on catheter design\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible distal tip.\",\n        \"The catheter of claim 1, wherein the distal tip is capable of navigating tortuous vessels.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67582", "text": "{\n    \"patent_title\": \"Enhanced Image Reconstruction for MRI using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-10-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for reconstructing MRI images using a deep learning model to enhance clarity and reduce noise, leading to improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"kind\": \"reference\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"A system for performing MRI image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67582", "text": "{\n    \"patent_title\": \"Ultrasound Image Processing for Cardiac Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-12-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved method for processing ultrasound images to better visualize cardiac structures. It improves spatial resolution but does not explicitly address noise reduction.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8000000B2\",\n            \"kind\": \"reference\"\n        },\n        {\n            \"patent_number\": \"US9123456B1\",\n            \"kind\": \"reference\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing an ultrasound image comprising...\",\n        \"A system for processing ultrasound data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67583", "text": "{\n    \"patent_title\": \"Novel MRI Reconstruction Technique for Enhanced Image Quality\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new method for reconstructing MRI images utilizing deep learning to significantly improve image resolution and reduce scan time. This technology has the potential to revolutionize diagnostic imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8543210B2\",\n            \"relevance\": \"Prior art in MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"An MRI system configured to perform the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67583", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Angiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MedTech Industries\"\n        }\n    ],\n    \"patent_number\": \"US9234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2018-12-04\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A catheter design with improved flexibility and maneuverability for use in angiography procedures.  The design minimizes trauma to blood vessels.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"relevance\": \"Existing catheter designs\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible distal tip...\",\n        \"A method for performing angiography using the catheter of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67584", "text": "{\n    \"patent_title\": \"System and Method for Emotion Recognition from Facial Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of Tech\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"AI Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-11-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for recognizing emotions from facial images utilizing deep learning techniques. The system analyzes facial expressions to determine emotional states, applicable in various fields like human-computer interaction and market research.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Facial Feature Detection\"\n        }\n    ],\n    \"claims\": [\n        \"A method for emotion recognition comprising...\",\n        \"A system for analyzing facial expressions...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The method of claim 1, wherein the emotion is sadness.\",\n        \"The system of claim 2, further comprising a user interface...\",\n        \"The system of claim 2, wherein the emotion is happiness.\",\n        \"The method of claim 1, wherein the deep learning model is a convolutional neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67584", "text": "{\n    \"patent_title\": \"Object Detection in Images Using Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"TechCorp\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-05-01\",\n    \"filing_date\": \"2019-12-10\",\n    \"issue_date\": \"2021-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for detecting objects within images utilizing convolutional neural networks. The system identifies and classifies objects in real-time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Image Classification Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for object detection comprising...\",\n        \"A system for identifying objects in images...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The method of claim 1, wherein the object is a car.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67585", "text": "{\n    \"patent_title\": \"Novel Image Enhancement Technique Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-05-20\",\n    \"issue_date\": \"2020-08-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel image enhancement technique leveraging deep convolutional neural networks. It achieves a significant improvement in image clarity and detail compared to existing methods, particularly in low-light conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Processing Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing images using a deep convolutional neural network.\",\n        \"A system for processing images to improve clarity.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67585", "text": "{\n    \"patent_title\": \"Image Compression Method\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2018-01-10\",\n    \"issue_date\": \"2021-05-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an efficient method for compressing images, reducing storage space and transmission bandwidth. The method utilizes a discrete cosine transform and Huffman coding.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Data Compression Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing image data.\",\n        \"A system for reducing image file size.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67586", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging Technique for Enhanced Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel magnetic resonance imaging (MRI) technique utilizing a pulsed gradient spin echo sequence to enhance the contrast between tumor tissue and surrounding healthy tissue, improving diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI comprising...\",\n        \"An MRI apparatus configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67586", "text": "{\n    \"patent_title\": \"Digital Radiography System with Enhanced Image Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Charles Davis\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2014-12-10\",\n    \"filing_date\": \"2015-01-05\",\n    \"issue_date\": \"2019-04-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A digital radiography system incorporating advanced image processing algorithms to reduce noise and enhance image quality. Focuses on improving speed and resolution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A digital radiography system comprising...\",\n        \"A method for processing radiographic images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67587", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Sensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable sensor for continuous glucose monitoring. The sensor utilizes a novel enzymatic reaction and a microfluidic channel to provide accurate and reliable glucose readings, enhancing diabetes management and improving patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in glucose monitoring sensors\"\n        }\n    ],\n    \"claims\": [\n        \"1. A miniaturized implantable sensor comprising:...\",\n        \"2. The sensor of claim 1, wherein...\",\n        \"3. A method of continuously monitoring glucose levels...\",\n        \"4. The method of claim 3, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67587", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-11-15\",\n    \"filing_date\": \"2020-11-15\",\n    \"issue_date\": \"2022-07-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved bicycle braking system utilizing a novel lever design and enhanced friction material to provide increased stopping power and rider safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art in bicycle braking systems\"\n        }\n    ],\n    \"claims\": [\n        \"1. A bicycle braking system comprising:...\",\n        \"2. The braking system of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67588", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Denoising with Adaptive Filtering\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-05-15\",\n    \"filing_date\": \"2020-08-20\",\n    \"issue_date\": \"2022-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel deep learning architecture for image denoising. It utilizes an adaptive filtering mechanism that dynamically adjusts to the noise characteristics of the input image, resulting in superior noise reduction performance compared to traditional methods. The method is especially effective for low-light images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Denoising using Wavelet Transforms\"\n        }\n    ],\n    \"claims\": [\n        \"A method for denoising an image comprising...\",\n        \"An apparatus for denoising an image comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67588", "text": "{\n    \"patent_title\": \"Improved Color Calibration for Digital Cameras\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2021-11-01\",\n    \"filing_date\": \"2022-02-10\",\n    \"issue_date\": \"2023-05-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a new algorithm for improving the color accuracy of digital cameras. It uses a sophisticated color profiling technique to compensate for variations in lighting conditions and camera sensor characteristics, leading to more vibrant and realistic images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Color Management System for Printing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for calibrating the color of a digital camera...\",\n        \"A system for processing digital images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67589", "text": "{\n    \"patent_title\": \"Neural Network-Based Image Enhancement for Low-Light Microscopy\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the quality of images captured under low-light conditions using a deep convolutional neural network.  This improves visibility and detail in biological microscopy applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image enhancement comprising...\",\n        \"A system for image processing...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67589", "text": "{\n    \"patent_title\": \"Improved Color Calibration for Digital Cameras\",\n    \"inventors\": [\n        {\n            \"name\": \"Charles Davis\",\n            \"affiliation\": \"Canon Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10321098B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for accurately calibrating the color response of digital cameras, resulting in more vibrant and realistic images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A method for color calibration...\",\n        \"A digital camera comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67590", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method for reconstructing medical images, leading to enhanced visualization of subtle anatomical features and improved diagnostic accuracy, particularly for early detection of cancerous tissues.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for medical image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67590", "text": "{\n    \"patent_title\": \"Automated Report Generation for Radiology\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Mayo Clinic\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2017-08-10\",\n    \"filing_date\": \"2017-08-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system for automatically generating radiology reports from medical images. It focuses on reducing the workload of radiologists by providing preliminary report drafts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A system for automated radiology report generation...\",\n        \"A method for creating preliminary reports...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67591", "text": "{\n    \"patent_title\": \"Implantable Cardiac Monitor with Wireless Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"David Starr\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac monitor designed for long-term remote monitoring of heart rhythm and function. The device utilizes a novel wireless data transmission protocol to securely transmit data to a remote monitoring station, allowing for early detection of cardiac events.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for wirelessly monitoring cardiac activity.\",\n        \"An implantable device for detecting arrhythmias.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67591", "text": "{\n    \"patent_title\": \"Surgical Instrument for Orthopedic Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2021-05-20\",\n    \"filing_date\": \"2021-05-20\",\n    \"issue_date\": \"2023-06-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical instrument designed for precise bone cutting and shaping during orthopedic procedures. The instrument incorporates a micro-vibration system to reduce tissue damage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument with a micro-vibration system.\",\n        \"A method for precise bone cutting.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67592", "text": "{\n    \"patent_title\": \"High-Resolution Magnetic Resonance Imaging with Reduced Artifacts\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for acquiring high-resolution magnetic resonance images with reduced artifacts. The invention utilizes a novel pulse sequence and image reconstruction algorithm to improve image clarity and reduce noise.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8785342B2\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for acquiring MRI images comprising...\",\n        \"A system for processing MRI data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67592", "text": "{\n    \"patent_title\": \"Automated System for Analyzing Pathology Slides\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11345678B1\",\n    \"priority_date\": \"2017-08-10\",\n    \"filing_date\": \"2017-08-10\",\n    \"issue_date\": \"2021-11-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for automated analysis of pathology slides using image processing techniques. The system identifies and classifies cells based on their morphology and staining characteristics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for analyzing pathology slides comprising...\",\n        \"A system for identifying cells in pathology images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67593", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging Technique for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-06-15\",\n    \"issue_date\": \"2021-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel magnetic resonance imaging (MRI) technique utilizing advanced pulse sequences and image reconstruction algorithms to significantly enhance the detection of early-stage cancerous tumors. The method increases sensitivity and specificity, leading to earlier and more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art related to MRI pulse sequences.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI comprising...\",\n        \"An MRI system configured to...\",\n        \"A computer-readable medium storing instructions to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67593", "text": "{\n    \"patent_title\": \"Slightly Modified Contrast Agent for MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-02-10\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a minor modification to an existing gadolinium-based contrast agent used in magnetic resonance imaging. The modification aims to slightly improve the agent's solubility in biological fluids.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Original patent for the gadolinium-based contrast agent.\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent composition comprising...\",\n        \"A method of using the contrast agent...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67594", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Sensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable sensor for continuous glucose monitoring, designed to improve patient compliance and provide real-time data for better diabetes management, leading to improved patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable sensor...\",\n        \"A system for continuous glucose monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67594", "text": "{\n    \"patent_title\": \"Surgical Instrument for Orthopedic Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-01-20\",\n    \"filing_date\": \"2021-01-20\",\n    \"issue_date\": \"2023-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical instrument designed to enhance precision and efficiency in orthopedic procedures. The instrument features a unique articulation mechanism for improved access to surgical sites.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising...\",\n        \"An articulation mechanism for surgical instruments...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67595", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Enhanced Patient Comfort\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Boston Scientific\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel catheter design incorporating flexible materials and a streamlined insertion tip to minimize discomfort during insertion and use. The design incorporates bio-compatible materials and features improved ergonomic handling for medical personnel.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Prior Art Catheter Design\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible shaft...\",\n        \"The catheter of claim 1, wherein the shaft comprises a bio-compatible polymer.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67595", "text": "{\n    \"patent_title\": \"Automated Surgical Robotic System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2018-08-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A robotic system for performing complex surgical procedures with increased precision and efficiency.  The system utilizes advanced image guidance and automated manipulation capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Remote Surgical Control System\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system comprising a robotic arm...\",\n        \"The system of claim 1, further comprising an image guidance module.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67596", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology, Research Lab of Imaging Sciences\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Harvard University, Biomedical Engineering Department\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-06-15\",\n    \"issue_date\": \"2019-03-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing medical images from raw data, utilizing a deep learning algorithm to reduce noise and enhance resolution. The system improves the clarity of CT and MRI scans, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"A system comprising a processor configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67596", "text": "{\n    \"patent_title\": \"Automated Diagnostic System Using Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2018-01-10\",\n    \"issue_date\": \"2021-09-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for automatically diagnosing diseases based on analysis of medical images. The system utilizes machine learning to identify patterns and anomalies in the images, providing a rapid diagnostic assessment.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for diagnosing a disease...\",\n        \"A method comprising analyzing a medical image...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67597", "text": "{\n    \"patent_title\": \"High-Efficiency Wireless Power Transfer System Using Metamaterials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10855742B2\",\n    \"priority_date\": \"2018-12-15\",\n    \"filing_date\": \"2019-06-20\",\n    \"issue_date\": \"2020-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel wireless power transfer system employing metamaterials to enhance efficiency and range. This system achieves significant improvements in power transfer distance and conversion efficiency compared to existing technologies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9780456B2\",\n            \"relevance\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless power transfer system comprising a metamaterial-based transmitter and receiver.\",\n        \"The system of claim 1, wherein the metamaterial is designed to focus electromagnetic energy.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67597", "text": "{\n    \"patent_title\": \"Improved Antenna Design for Mobile Phones\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Qualcomm\"\n        }\n    ],\n    \"patent_number\": \"US10782314B1\",\n    \"priority_date\": \"2017-03-10\",\n    \"filing_date\": \"2018-09-25\",\n    \"issue_date\": \"2020-03-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved antenna design for mobile phones, increasing signal strength and reducing interference. This antenna is a minor refinement of existing mobile phone antenna technologies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9546822B2\",\n            \"relevance\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"An antenna for a mobile phone comprising a modified radiation pattern.\",\n        \"The antenna of claim 1, wherein the modification reduces interference.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67598", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction Method for Positron Emission Tomography\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2021-11-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing images from positron emission tomography (PET) data, addressing limitations of current techniques by incorporating advanced statistical modeling. This improves image quality and reduces noise.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in PET image reconstruction.\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related method for noise reduction.\"\n        },\n        {\n            \"patent_number\": \"US11555555B2\",\n            \"relevance\": \"Similar approach to image enhancement.\"\n        },\n        {\n            \"patent_number\": \"US12121212B2\",\n            \"relevance\": \"Application of deep learning for image analysis.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an image...\",\n        \"The method of claim 1, wherein the statistical model...\",\n        \"A system comprising a processor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67598", "text": "{\n    \"patent_title\": \"Surgical Instrument with Integrated Camera\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Hospital\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"General Hospital\"\n        }\n    ],\n    \"patent_number\": \"US11890123B2\",\n    \"priority_date\": \"2020-03-10\",\n    \"filing_date\": \"2020-09-01\",\n    \"issue_date\": \"2022-04-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical instrument incorporating a miniature camera for improved visualization during minimally invasive procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Previous surgical instrument designs.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising...\",\n        \"The surgical instrument of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67599", "text": "{\n    \"patent_title\": \"Miniaturized Robotic Surgical System with Enhanced Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"David Gracias\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized robotic surgical system incorporating advanced imaging techniques for improved precision and reduced invasiveness in surgical procedures.  The system utilizes micro-robotics and real-time image guidance to navigate complex anatomical structures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system comprising a miniaturized robotic arm...\",\n        \"A method for performing minimally invasive surgery using the robotic system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67599", "text": "{\n    \"patent_title\": \"Novel Catheter Design for Cardiac Ablation\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-11-20\",\n    \"filing_date\": \"2019-11-20\",\n    \"issue_date\": \"2022-07-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new catheter design for performing cardiac ablation procedures. The catheter features improved flexibility and electrode configuration for enhanced efficacy and safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous catheter designs\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible shaft and a plurality of electrodes...\",\n        \"A method for performing cardiac ablation using the catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67600", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid and Sensitive Biomarker Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel microfluidic device for the rapid and sensitive detection of biomarkers in biological samples, enabling early disease diagnosis and personalized medicine.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\"\n        },\n        {\n            \"patent_number\": \"US98765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for detecting biomarkers using the device...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67600", "text": "{\n    \"patent_title\": \"Improved Automotive Engine Cooling System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Ford Motor Company\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"General Motors\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-04-10\",\n    \"filing_date\": \"2020-06-01\",\n    \"issue_date\": \"2022-09-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved cooling system for internal combustion engines, enhancing efficiency and reducing emissions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"An engine cooling system comprising...\",\n        \"A method for regulating engine temperature...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67601", "text": "{\n    \"patent_title\": \"Method for Enhanced Medical Image Reconstruction with Reduced Radiation Dose\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-01\",\n    \"issue_date\": \"2023-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel method for reconstructing medical images from low-dose radiation data. By utilizing advanced iterative algorithms and incorporating prior knowledge about anatomical structures, the method significantly improves image clarity while reducing patient radiation exposure. The results demonstrate a 30% reduction in radiation dose with comparable image quality to conventional techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"The method of claim 1, wherein the radiation dose is reduced by at least 20%.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67601", "text": "{\n    \"patent_title\": \"System for Automated X-ray Positioning\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-11-20\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a system for automatically positioning patients for X-ray imaging. The system utilizes robotic arms and computer vision to ensure accurate and consistent positioning, reducing the need for manual adjustment by technicians. This improves efficiency and reduces the risk of errors.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Previous work on robotic X-ray systems\"\n        }\n    ],\n    \"claims\": [\n        \"A system for automatically positioning a patient for X-ray imaging...\",\n        \"The system of claim 1, comprising a robotic arm...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67602", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Recognition System for Autonomous Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-06-15\",\n    \"issue_date\": \"2021-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for robust and accurate image recognition in autonomous driving applications. The system utilizes a convolutional neural network with attention mechanisms to improve performance in challenging conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Convolutional Neural Networks for Image Classification\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a deep learning model...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67602", "text": "{\n    \"patent_title\": \"Method for Filtering Images Based on Color\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corp\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-03-10\",\n    \"filing_date\": \"2018-04-10\",\n    \"issue_date\": \"2019-10-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for filtering digital images based on dominant color palettes. The system allows users to select specific colors to highlight or remove from images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Color Image Processing Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for filtering images comprising...\",\n        \"A system for selecting color ranges...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67603", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2015-03-15\",\n    \"filing_date\": \"2015-05-20\",\n    \"issue_date\": \"2018-11-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for reconstructing medical images with improved clarity and resolution using advanced algorithms. It reduces noise and artifacts, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B1\",\n            \"relevance\": \"Prior art in image reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"A system comprising a processor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67603", "text": "{\n    \"patent_title\": \"System for Automated Medical Report Generation\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US98765432B2\",\n    \"priority_date\": \"2016-07-01\",\n    \"filing_date\": \"2016-09-10\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system for automatically generating medical reports from patient data. The system utilizes natural language processing and machine learning to streamline the reporting process.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\",\n            \"relevance\": \"Related to medical data processing\"\n        }\n    ],\n    \"claims\": [\n        \"A system for generating medical reports...\",\n        \"A method comprising analyzing patient data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67604", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Pressure Sensor for Intracranial Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-06-01\",\n    \"issue_date\": \"2021-12-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized, wireless pressure sensor for continuous intracranial pressure monitoring. The sensor is designed for long-term implantation and transmits data wirelessly to an external receiver, reducing the risk of infection and improving patient comfort.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor for intracranial monitoring.\",\n        \"A system for wirelessly transmitting intracranial pressure data.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67604", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Peripheral Vascular Access\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-15\",\n    \"issue_date\": \"2020-09-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design featuring a flexible tip and enhanced biocompatible coating to reduce the risk of vascular damage during peripheral vascular access procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter with a flexible distal tip.\",\n        \"A catheter comprising a biocompatible coating.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67605", "text": "{\n    \"patent_title\": \"Low-Dose Computed Tomography with Iterative Reconstruction and Adaptive Statistical Iterative Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Li, Jian\",\n            \"affiliation\": \"University of California, San Francisco\"\n        },\n        {\n            \"name\": \"Wang, Shuo\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9879532B2\",\n    \"priority_date\": \"2016-07-15\",\n    \"filing_date\": \"2017-07-14\",\n    \"issue_date\": \"2019-03-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for low-dose computed tomography (CT) imaging. An iterative reconstruction algorithm is employed to reduce image noise and artifacts, and adaptive statistical iterative reconstruction (ASIR) is used to further improve image quality at reduced radiation doses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8560071B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing computed tomography comprising...\",\n        \"A system for computed tomography comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67605", "text": "{\n    \"patent_title\": \"Method for Enhanced MRI Contrast using Gadolinium-Based Contrast Agents\",\n    \"inventors\": [\n        {\n            \"name\": \"Chen, Wei\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9234687B2\",\n    \"priority_date\": \"2014-03-10\",\n    \"filing_date\": \"2015-03-09\",\n    \"issue_date\": \"2016-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for improving the contrast of Magnetic Resonance Images (MRIs) using optimized dosages of gadolinium-based contrast agents. The method focuses on achieving better visualization of vascular structures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7895234B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for improving MRI contrast comprising...\",\n        \"A composition for use in MRI contrast enhancement...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67606", "text": "{\n    \"patent_title\": \"Adaptive Image Enhancement Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel deep learning approach for adaptive image enhancement. The system utilizes convolutional neural networks to effectively remove noise and artifacts, resulting in significant improvements in perceived image quality. The method is particularly effective for low-light conditions and images with high dynamic range.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image denoising\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image comprising...\",\n        \"A system for adaptive image processing...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67606", "text": "{\n    \"patent_title\": \"Method for Compressing Digital Audio Signals\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"AudioTech Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-05\",\n    \"issue_date\": \"2023-06-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a highly efficient method for compressing digital audio signals. The technique utilizes a modified discrete cosine transform to reduce data redundancy while preserving audio fidelity. It is suitable for streaming and storage applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous audio compression algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an audio signal comprising...\",\n        \"A system for digital audio compression...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67607", "text": "{\n    \"patent_title\": \"Enhanced Image Reconstruction for Low-Dose CT Scans\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for reconstructing CT images from low-dose radiation data, using iterative reconstruction algorithms and noise reduction techniques to improve image quality and reduce patient exposure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8569782B2\",\n            \"relevance\": \"Prior art in iterative reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a CT image...\",\n        \"The method of claim 1, wherein the iterative reconstruction algorithm...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67607", "text": "{\n    \"patent_title\": \"New Algorithm for Satellite Image Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"NASA\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2016-11-01\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An algorithm for enhancing the resolution and color accuracy of satellite images, utilizing deep learning and spectral analysis techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related work in image enhancement\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing a satellite image...\",\n        \"The method of claim 1, wherein the deep learning model...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67608", "text": "{\n    \"patent_title\": \"Enhanced Resolution Medical Imaging System Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2020-06-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A medical imaging system utilizing deep learning algorithms to enhance image resolution and clarity, resulting in improved diagnostic accuracy. The system reduces noise and artifacts, providing clearer visualizations of anatomical structures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing medical image resolution using a deep convolutional neural network.\",\n        \"A medical imaging system comprising a sensor and a processing unit configured to implement the method.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67608", "text": "{\n    \"patent_title\": \"Improved X-Ray Tube Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-05-20\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2021-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An X-ray tube with improved filament geometry for increased X-ray flux and reduced heat load. The design enhances image contrast and reduces patient exposure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube comprising a filament with a modified geometry.\",\n        \"A method for producing X-rays using the X-ray tube.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67609", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-07-15\",\n    \"filing_date\": \"2015-02-20\",\n    \"issue_date\": \"2019-05-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing image reconstruction quality using advanced filtering algorithms. This invention has applications in medical imaging and security systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"relevance\": \"Prior art in image filtering.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an image comprising...\",\n        \"A system for enhancing image resolution...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67609", "text": "{\n    \"patent_title\": \"A Novel Theoretical Framework for Fractal Image Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Theoretical Research Institute\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2013-11-01\",\n    \"filing_date\": \"2016-03-10\",\n    \"issue_date\": \"2020-01-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This patent describes a new mathematical approach to fractal image compression based on non-Euclidean geometry. It presents theoretical advantages but lacks immediate practical implementation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related work in image compression.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for fractal image compression based on...\",\n        \"A theoretical framework for non-Euclidean image representation...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67610", "text": "{\n    \"patent_title\": \"Implantable Cardiac Monitor with Enhanced Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MedTech Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-05-15\",\n    \"filing_date\": \"2020-05-15\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac monitor providing real-time ECG data with improved wireless transmission capabilities, addressing the need for continuous and reliable cardiac monitoring for patients at risk of arrhythmias.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for continuously monitoring cardiac activity...\",\n        \"An implantable device comprising a sensor...\",\n        \"A system for wirelessly transmitting cardiac data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67610", "text": "{\n    \"patent_title\": \"Surgical Instrument for Orthopedic Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Medical Devices\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-10\",\n    \"filing_date\": \"2021-03-10\",\n    \"issue_date\": \"2023-06-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical instrument designed for improved precision in orthopedic joint replacement procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10112233B1\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising a handle...\",\n        \"A cutting mechanism for bone removal...\",\n        \"A method for performing joint replacement surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67611", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"David Chen\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Maria Rodriguez\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel minimally invasive surgical system incorporating advanced optical coherence tomography for real-time tissue visualization, improving precision and reducing patient trauma.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\",\n            \"relevance\": \"Prior art in endoscopic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising...\",\n        \"A method for performing minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67611", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Cardiovascular Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2021-02-10\",\n    \"issue_date\": \"2022-07-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design featuring a flexible tip and enhanced biocompatibility for cardiovascular procedures, minimizing risk of vascular damage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"relevance\": \"Previous designs in catheter technology\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter characterized by...\",\n        \"A method for utilizing the catheter in cardiovascular procedures...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67612", "text": "{\n    \"patent_title\": \"Enhanced MRI Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-12-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method for reconstructing MRI images using deep learning techniques. The method significantly enhances diagnostic accuracy by reducing noise and improving image resolution, enabling earlier and more precise detection of subtle anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"MRI Reconstruction Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images using a deep neural network.\",\n        \"A system for enhancing diagnostic accuracy in MRI imaging.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67612", "text": "{\n    \"patent_title\": \"Improved X-ray Shielding Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2023-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel shielding material for X-ray equipment, reducing radiation exposure to patients and operators. The material is cost-effective and easy to manufacture.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Radiation Shielding Materials\"\n        }\n    ],\n    \"claims\": [\n        \"A shielding material comprising a specific alloy composition.\",\n        \"An X-ray apparatus utilizing the described shielding material.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67613", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Device for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Jennifer Dionne\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Mark Christensen\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-11-15\",\n    \"filing_date\": \"2019-05-20\",\n    \"issue_date\": \"2021-01-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized, fully implantable glucose monitoring device utilizing a novel enzymatic sensor and wireless power transfer. The device provides continuous glucose readings with increased accuracy, leading to improved diabetes management and patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in glucose sensing technology\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable glucose sensor.\",\n        \"A wireless power transfer system for an implantable device.\",\n        \"A method for continuous glucose monitoring.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67613", "text": "{\n    \"patent_title\": \"Surgical Instrument with Enhanced Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"David Stark\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2017-03-10\",\n    \"filing_date\": \"2018-09-05\",\n    \"issue_date\": \"2020-12-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical instrument designed with improved ergonomics to reduce hand fatigue during long procedures. The instrument features a lightweight handle and optimized grip angle.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous surgical instrument designs.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument with an ergonomic handle.\",\n        \"An instrument grip designed to reduce hand fatigue.\",\n        \"A lightweight surgical instrument.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67614", "text": "{\n    \"patent_title\": \"Non-Invasive Glucose Monitoring System Using Raman Spectroscopy\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive glucose monitoring system utilizing Raman spectroscopy to determine glucose levels in interstitial fluid through the skin. This system eliminates the need for blood draws, providing a more comfortable and convenient monitoring experience for diabetic patients.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in optical glucose sensing.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for non-invasively determining glucose concentration comprising: directing Raman light onto a subject's skin; collecting Raman scattered light; analyzing the Raman spectrum to identify glucose peaks; and calculating glucose concentration based on the intensity of said glucose peaks.\",\n        \"A system for non-invasive glucose monitoring comprising: a Raman spectrometer; a light source; and a processor configured to analyze Raman spectra and calculate glucose concentration.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67614", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Minimally Invasive Surgery\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-20\",\n    \"filing_date\": \"2020-03-01\",\n    \"issue_date\": \"2021-08-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design featuring enhanced maneuverability and reduced friction for use in minimally invasive surgical procedures. The catheter incorporates a novel coating material and a flexible tip for precise navigation through blood vessels.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous catheter designs.\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising: a flexible shaft; a distal tip; and a coating material applied to the shaft to reduce friction.\",\n        \"A method for performing minimally invasive surgery utilizing a catheter as claimed in claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67615", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Pressure Sensor for Intracranial Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-03-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized, biocompatible pressure sensor for continuous intracranial pressure monitoring. The device improves patient outcomes by enabling early detection of intracranial hypertension.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A pressure sensor comprising a biocompatible housing and a piezoelectric element.\",\n        \"A method for monitoring intracranial pressure using the sensor.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67615", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-05-20\",\n    \"filing_date\": \"2019-06-12\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design for efficient drug delivery. The catheter features a novel tip geometry to reduce resistance during insertion.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible shaft and a distal tip with a rounded profile.\",\n        \"A method for delivering drugs using the catheter.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67616", "text": "{\n    \"patent_title\": \"Enhanced Medical Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning algorithm for reconstructing medical images from limited data, resulting in improved image quality and diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"A system comprising a processor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67616", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2022-08-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new contrast agent formulation for magnetic resonance imaging, providing enhanced signal intensity and improved visualization of tissues.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent composition...\",\n        \"A method for enhancing MRI images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67617", "text": "{\n    \"patent_title\": \"Improved MRI Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2020-09-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel deep learning approach for reconstructing MRI images, resulting in significantly improved image quality and reduced scan times. The enhanced diagnostic capabilities allow for earlier and more accurate detection of anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Prior art in MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images using a deep convolutional neural network.\",\n        \"A system for performing MRI scans with reduced scan times.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67617", "text": "{\n    \"patent_title\": \"Enhanced X-Ray Tube Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2019-01-10\",\n    \"filing_date\": \"2019-01-10\",\n    \"issue_date\": \"2021-05-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved design for X-ray tubes, increasing their efficiency and lifespan. It focuses on the physical construction of the tube and its cooling system, resulting in a more durable and reliable X-ray source.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\",\n            \"relevance\": \"Previous X-ray tube designs\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube with a modified anode material.\",\n        \"A cooling system for X-ray tubes based on liquid metal flow.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67618", "text": "{\n    \"patent_title\": \"Patient-Comfortable Wearable Cardiac Monitor\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"MedTech Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel wearable cardiac monitor designed with hypoallergenic materials and a flexible form factor to maximize patient comfort during prolonged use.  Utilizes advanced sensor technology for accurate data acquisition.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in wearable sensor technology\"\n        }\n    ],\n    \"claims\": [\n        \"A wearable cardiac monitor comprising a flexible substrate...\",\n        \"The monitor of claim 1, wherein the substrate is hypoallergenic.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67618", "text": "{\n    \"patent_title\": \"High-Throughput Drug Screening System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Biopharma Corp\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Biopharma Corp\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2019-08-20\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for automated high-throughput screening of potential drug candidates. Includes robotic handling and advanced data analysis capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"relevance\": \"Previous work in automated liquid handling\"\n        }\n    ],\n    \"claims\": [\n        \"A drug screening system comprising a robotic arm...\",\n        \"The system of claim 1, further comprising a data analysis module.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67619", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging Technique for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"David A. Bernstein\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Maria Rodriguez\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel magnetic resonance imaging (MRI) technique is disclosed that enhances the detection of early-stage cancerous tumors by utilizing a new contrast agent and image processing algorithm. The technique significantly improves sensitivity and specificity, leading to earlier and more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on MRI contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A method for imaging a tissue sample comprising...\",\n        \"An MRI apparatus comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67619", "text": "{\n    \"patent_title\": \"Method for Analyzing Genomic Data for Personalized Medicine\",\n    \"inventors\": [\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-20\",\n    \"filing_date\": \"2021-05-20\",\n    \"issue_date\": \"2024-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for analyzing genomic data to predict individual responses to pharmaceutical treatments. The system utilizes machine learning algorithms to identify genetic markers associated with drug efficacy and adverse effects.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related genomic analysis techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for analyzing genomic data comprising...\",\n        \"A computer system for...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67620", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction Method for MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image reconstruction algorithm for Magnetic Resonance Imaging (MRI) that significantly improves image quality and diagnostic accuracy by reducing noise and artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"An MRI system configured to implement the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67620", "text": "{\n    \"patent_title\": \"Advanced X-ray Tube Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876544B2\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-02-29\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel X-ray tube design with improved heat dissipation and electron beam control, leading to enhanced image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube comprising...\",\n        \"A system for generating X-rays using the tube...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67621", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Device for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable device for continuous glucose monitoring, offering improved accuracy and biocompatibility for managing diabetes. Addresses the challenge of frequent finger-prick testing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable glucose sensor.\",\n        \"A method for continuous glucose monitoring using said sensor.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67621", "text": "{\n    \"patent_title\": \"Improved Surgical Stapler Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-15\",\n    \"issue_date\": \"2021-05-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler design with enhanced precision and reduced tissue damage. Provides a more reliable and efficient surgical tool.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler with improved jaw alignment.\",\n        \"A method of using the surgical stapler for tissue closure.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67622", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University Medical Center\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Imaging Technologies Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for reconstructing medical images with enhanced clarity and resolution. The method utilizes a deep learning algorithm to reduce noise and artifacts, resulting in improved diagnostic accuracy.  Keywords: image reconstruction, medical imaging, deep learning, clarity, resolution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8543210B2\",\n            \"relevance\": \"Prior art in image processing.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for reconstructing a medical image comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67622", "text": "{\n    \"patent_title\": \"Portable X-Ray Device with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Medical Device Corp.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2019-03-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A portable X-ray device with integrated wireless communication capabilities for remote image transmission and storage. The device features a lightweight design and ease of use. Keywords: X-ray, portable, wireless, communication, remote diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related to portable imaging devices.\"\n        }\n    ],\n    \"claims\": [\n        \"A portable X-ray device comprising...\",\n        \"A wireless communication system integrated with an X-ray device...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67623", "text": "{\n    \"patent_title\": \"Enhanced Resolution MRI Imaging Using Novel Gradient Coils\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Chen\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel gradient coil design for Magnetic Resonance Imaging (MRI) that significantly improves image resolution and clarity by reducing artifacts and enhancing signal-to-noise ratio. The new coil geometry allows for faster scan times and more detailed anatomical visualization.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"MRI Gradient Coil Design\"\n        }\n    ],\n    \"claims\": [\n        \"A gradient coil for MRI comprising...\",\n        \"A method for enhancing MRI image resolution...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67623", "text": "{\n    \"patent_title\": \"Automated System for X-Ray Image Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"City General Hospital\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-10\",\n    \"filing_date\": \"2017-03-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for analyzing X-ray images to detect fractures and abnormalities. The system utilizes convolutional neural networks to provide rapid and accurate diagnoses. The focus is on improving diagnostic speed and reducing human error.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Digital X-Ray Imaging System\"\n        }\n    ],\n    \"claims\": [\n        \"A system for analyzing X-ray images comprising...\",\n        \"A method for detecting fractures using neural networks...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67624", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Real-time Tissue Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-04-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system incorporating real-time tissue analysis using advanced spectroscopy to guide resection of cancerous tissue. The system utilizes micro-robotics and advanced algorithms to navigate complex biological structures with precision.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art in micro-robotics for surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising a micro-robotic arm...\",\n        \"A method for real-time tissue analysis...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67624", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Fluid Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Acme Medical Devices\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-06-15\",\n    \"issue_date\": \"2023-03-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design with enhanced fluid delivery capabilities. The catheter utilizes a novel material to reduce friction and improve flow rate. It is designed for general fluid delivery applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in catheter materials\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a novel polymer material...\",\n        \"A method for delivering fluid using the catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67625", "text": "{\n    \"patent_title\": \"Context-Aware Image Recognition System for Autonomous Navigation\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image recognition system that leverages contextual information to improve the accuracy of object detection and scene understanding, enabling robust autonomous navigation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in object detection\"\n        }\n    ],\n    \"claims\": [\n        \"A system for recognizing objects in an image based on contextual features.\",\n        \"A method for autonomous navigation using a context-aware image recognition system.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67625", "text": "{\n    \"patent_title\": \"Object Detection Using Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10321098B1\",\n    \"priority_date\": \"2019-12-01\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-07-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved object detection method utilizing convolutional neural networks for accurate and efficient identification of objects in images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Baseline CNN architecture\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting objects in an image using a convolutional neural network.\",\n        \"A system for identifying objects with high accuracy.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67626", "text": "{\n    \"patent_title\": \"Neural Network Based Image Enhancement for Low-Light Conditions\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for enhancing images captured in low-light conditions utilizing a deep convolutional neural network. The network is trained to map low-light images to high-quality images with improved brightness and contrast.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image comprising: training a deep neural network...\",\n        \"The method of claim 1, wherein the neural network is a convolutional neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67626", "text": "{\n    \"patent_title\": \"Method for Sharpening Images Using Traditional Filters\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-05-20\",\n    \"filing_date\": \"2016-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A technique for improving image sharpness through the application of linear and non-linear filtering techniques. This method utilizes edge detection and contrast enhancement algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related work on image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for sharpening an image comprising: applying a high-pass filter...\",\n        \"The method of claim 1, further comprising adjusting the contrast of the image.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67627", "text": "{\n    \"patent_title\": \"Novel Magnetic Resonance Imaging Technique for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-06-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel magnetic resonance imaging (MRI) technique utilizing targeted contrast agents and advanced image processing algorithms for the early detection of cancerous tumors. The method demonstrates significantly improved sensitivity and specificity compared to conventional MRI techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Contrast Agents for MRI\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Processing Algorithms for Medical Imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancerous tumors using MRI.\",\n        \"The method of claim 1, wherein the MRI utilizes targeted contrast agents.\",\n        \"The method of claim 2, wherein the contrast agents are nanoparticles.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67627", "text": "{\n    \"patent_title\": \"Improved X-ray Shielding Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US9123456B2\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2017-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new composite material for X-ray shielding, offering enhanced radiation protection and reduced weight compared to traditional lead-based shields.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8000001B2\",\n            \"title\": \"Lead-Based X-ray Shields\"\n        }\n    ],\n    \"claims\": [\n        \"A composite material for X-ray shielding.\",\n        \"The material of claim 1, comprising a polymer matrix and barium sulfate particles.\",\n        \"The material of claim 2, having a radiation attenuation coefficient greater than 0.5.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67628", "text": "{\n    \"patent_title\": \"Method and System for Enhancing Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing image resolution using a deep convolutional neural network. The system analyzes low-resolution images and reconstructs high-resolution counterparts with improved clarity and detail.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image super-resolution.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising...\",\n        \"A system for reconstructing high-resolution images...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67628", "text": "{\n    \"patent_title\": \"System for Data Compression and Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-02-10\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-08-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for compressing data for efficient transmission over networks. It uses a novel algorithm to reduce file sizes without significant loss of information.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related to data compression techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data comprising...\",\n        \"A system for transmitting compressed data...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67629", "text": "{\n    \"patent_title\": \"System and Method for Fraud Detection Using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2021-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for detecting fraudulent transactions using machine learning algorithms. The system analyzes transaction data to identify patterns indicative of fraud and generates alerts when suspicious activity is detected.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting fraudulent transactions comprising...\",\n        \"A system for analyzing transaction data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67629", "text": "{\n    \"patent_title\": \"A Novel Theoretical Framework for Deep Learning Optimization\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of Advanced Studies\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"University of Advanced Studies\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-01-10\",\n    \"issue_date\": \"2022-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This patent describes a new theoretical framework for optimizing deep learning models. The framework focuses on gradient descent algorithms and provides insights into their convergence properties.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for optimizing deep learning models comprising...\",\n        \"A theoretical framework for gradient descent...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67630", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Recognition System for Medical Diagnosis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for accurate and efficient image recognition in medical diagnosis, addressing the challenges of limited labeled data and high computational costs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image classification\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a deep learning model...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67630", "text": "{\n    \"patent_title\": \"Simple Image Filtering Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2021-02-28\",\n    \"filing_date\": \"2021-04-15\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A basic image filtering technique to enhance contrast and reduce noise in digital images.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for applying a filtering algorithm to an image...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67631", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Point-of-Care Diagnostics\",\n    \"inventors\": [\n        {\n            \"name\": \"David A. Haussler\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"James R. Heath\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2019-03-20\",\n    \"issue_date\": \"2021-12-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for rapid and accurate diagnosis of infectious diseases at the point of care. The device integrates sample preparation, amplification, and detection into a single chip, enabling fast results and improved patient management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on microfluidic devices.\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for diagnosing an infectious disease...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67631", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Enhanced Comfort\",\n    \"inventors\": [\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"University of California, Los Angeles\"\n        },\n        {\n            \"name\": \"Michael Brown\",\n            \"affiliation\": \"UCLA\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2018-07-10\",\n    \"issue_date\": \"2020-03-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel catheter design incorporating a flexible tip and lubricious coating to reduce patient discomfort during insertion and use.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous catheter designs.\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible tip...\",\n        \"A method for reducing patient discomfort...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67632", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for reconstructing high-resolution medical images from low-dose CT scans using deep learning techniques. The invention significantly reduces radiation exposure while maintaining image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8654321B2\",\n            \"relevance\": \"Prior art in image reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for performing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67632", "text": "{\n    \"patent_title\": \"Digital Image Watermarking Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for embedding a digital watermark into an image to protect copyright. The watermark is robust against common image processing operations.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7543210B2\",\n            \"relevance\": \"Related to digital watermarking\"\n        }\n    ],\n    \"claims\": [\n        \"A method for watermarking an image comprising...\",\n        \"A system for implementing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67633", "text": "{\n    \"patent_title\": \"Enhanced Resolution Medical Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel medical imaging system that utilizes advanced algorithms to significantly enhance image resolution and clarity, enabling more accurate diagnoses. The system improves image contrast and reduces noise, leading to clearer visualizations of anatomical structures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A medical imaging system comprising a detector and a processor configured to enhance image resolution.\",\n        \"The system of claim 1, wherein the processor utilizes a noise reduction algorithm.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67633", "text": "{\n    \"patent_title\": \"Portable X-Ray Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US1234567B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A portable X-ray device designed for field applications. This device is compact and lightweight, making it ideal for emergency situations and remote locations. It features a standard X-ray tube and detector.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A portable X-ray device comprising an X-ray tube and a detector.\",\n        \"The device of claim 1, wherein the device is battery powered.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67634", "text": "{\n    \"patent_title\": \"Endoscopic Surgical Instrument with Articulating Tip\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"EP3456789B1\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-04-20\",\n    \"issue_date\": \"2018-11-01\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"An endoscopic surgical instrument with an articulating tip for improved maneuverability in minimally invasive procedures. The device allows for precise tissue manipulation and resection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US20120296135A1\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising an elongated shaft...\",\n        \"An articulating tip mechanism...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67634", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Cartridge Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US8765432B2\",\n    \"priority_date\": \"2014-12-10\",\n    \"filing_date\": \"2015-01-15\",\n    \"issue_date\": \"2017-07-04\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A surgical stapler featuring an improved cartridge design for more reliable and consistent staple deployment. The invention focuses on enhancing the staple formation process to reduce misfires.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B1\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising a cartridge...\",\n        \"A staple driving mechanism...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67635", "text": "{\n    \"patent_title\": \"Implantable Cardioverter-Defibrillator with Enhanced Lead Integrity\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-05-15\",\n    \"issue_date\": \"2023-11-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardioverter-defibrillator (ICD) with improved lead integrity through a novel anchoring mechanism and biocompatible materials. The device minimizes lead dislodgement and reduces the risk of infection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on ICD lead design\"\n        }\n    ],\n    \"claims\": [\n        \"A method for securing an ICD lead to cardiac tissue.\",\n        \"An ICD lead comprising a biocompatible anchoring component.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67635", "text": "{\n    \"patent_title\": \"Automated Insulin Delivery System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Medtronic Inc.\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Medtronic Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-12-01\",\n    \"filing_date\": \"2020-12-01\",\n    \"issue_date\": \"2023-09-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated insulin delivery system comprising a continuous glucose monitor, a pump, and a control algorithm to regulate blood sugar levels in patients with diabetes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art on glucose monitoring systems\"\n        }\n    ],\n    \"claims\": [\n        \"A system for automated insulin delivery.\",\n        \"A method for controlling blood glucose levels.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67636", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Patient Comfort Features\",\n    \"inventors\": [\n        {\n            \"name\": \"David Chen\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical system designed for minimally invasive procedures, incorporating ergonomic features and biocompatible materials to significantly enhance patient comfort and reduce post-operative recovery time. The system utilizes advanced imaging and robotic assistance for precise and controlled surgical interventions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Related prior art in minimally invasive surgery.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising a robotic arm and an ergonomic handle.\",\n        \"A method for performing a minimally invasive surgery using the system.\",\n        \"A biocompatible material for reducing patient discomfort.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67636", "text": "{\n    \"patent_title\": \"High-Throughput Drug Screening Platform\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jessica Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A high-throughput drug screening platform for identifying potential therapeutic compounds. The platform utilizes microfluidic technology and automated analysis to rapidly screen large libraries of compounds against various biological targets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\",\n            \"relevance\": \"Related prior art in drug discovery.\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device for high-throughput screening.\",\n        \"A method for identifying drug candidates using the device.\",\n        \"A system for automated data analysis.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67637", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Diagnosis of Sepsis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-06-15\",\n    \"issue_date\": \"2021-02-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for the rapid and accurate detection of biomarkers associated with sepsis, enabling faster diagnosis and improved patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for detecting sepsis...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67637", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-12-10\",\n    \"filing_date\": \"2018-01-10\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel catheter design with improved flow characteristics for more efficient drug delivery. This catheter aims to reduce complications associated with long-term catheterization.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising...\",\n        \"A method for delivering drugs using said catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67638", "text": "{\n    \"patent_title\": \"Remote Physiological Monitoring System and Method\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A remote physiological monitoring system includes a wearable sensor device and a cloud-based platform for data analysis and alerts. It is designed to enable continuous monitoring of vital signs for patients at home.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in wearable sensor technology\"\n        }\n    ],\n    \"claims\": [\n        \"A system for remotely monitoring a patient's vital signs.\",\n        \"A method for analyzing physiological data to detect anomalies.\",\n        \"A wearable sensor device for continuous data collection.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67638", "text": "{\n    \"patent_title\": \"Improved Surgical Instrument\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-05-10\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2021-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical instrument with enhanced precision and ergonomics for minimally invasive procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10112233B2\",\n            \"relevance\": \"Related surgical instrument designs\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument with improved grip.\",\n        \"A mechanism for precise cutting.\",\n        \"A system for minimizing tissue damage.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67639", "text": "{\n    \"patent_title\": \"Energy-Efficient Communication Protocol for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Qualcomm Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-12-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel communication protocol designed to minimize energy consumption in mobile devices. By employing adaptive transmission power control and optimized data scheduling, the protocol significantly extends battery life and improves overall device efficiency. The protocol also reduces network congestion and enhances data throughput.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing energy consumption in a mobile communication device...\",\n        \"A communication protocol comprising adaptive transmission power control...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67639", "text": "{\n    \"patent_title\": \"Advanced Signal Processing Techniques for 5G Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Nokia\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Ericsson\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-07-15\",\n    \"issue_date\": \"2022-05-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details advanced signal processing techniques to improve the reliability and throughput of 5G networks. The techniques involve sophisticated channel estimation and interference cancellation algorithms. The implementation focuses on base station technologies and network infrastructure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for channel estimation in a 5G communication system...\",\n        \"A signal processing apparatus for interference cancellation...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67640", "text": "{\n    \"patent_title\": \"Deep Convolutional Neural Networks for Image Classification\",\n    \"inventors\": [\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"Google\"\n        },\n        {\n            \"name\": \"Alex Krizhevsky\",\n            \"affiliation\": \"University of Toronto\"\n        },\n        {\n            \"name\": \"Ilya Sutskever\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"patent_number\": \"US9176768B2\",\n    \"priority_date\": \"2012-11-26\",\n    \"filing_date\": \"2014-09-25\",\n    \"issue_date\": \"2015-11-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep convolutional neural network architecture is presented for image classification. The network utilizes multiple convolutional layers and pooling layers, followed by fully connected layers for classification. The network demonstrates state-of-the-art performance on the ImageNet dataset.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8165038B2\",\n            \"relevance\": \"Prior art in convolutional neural networks\"\n        }\n    ],\n    \"claims\": [\n        \"A method for classifying images using a deep convolutional neural network.\",\n        \"A computer system for implementing the method.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67640", "text": "{\n    \"patent_title\": \"Method and Apparatus for Image Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US7542345B1\",\n    \"priority_date\": \"2007-06-15\",\n    \"filing_date\": \"2008-01-10\",\n    \"issue_date\": \"2009-06-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved method for image compression using discrete cosine transform (DCT) and Huffman coding. The method aims to reduce the size of image files while maintaining acceptable image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6268953B1\",\n            \"relevance\": \"Previous work on DCT-based image compression.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing images using DCT and Huffman coding.\",\n        \"An apparatus for performing image compression.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67641", "text": "{\n    \"patent_title\": \"Deep Convolutional Neural Networks for Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        },\n        {\n            \"name\": \"Alex Krizhevsky\",\n            \"affiliation\": \"University of Toronto\"\n        },\n        {\n            \"name\": \"Ilya Sutskever\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"patent_number\": \"US9483053B2\",\n    \"priority_date\": \"2012-11-26\",\n    \"filing_date\": \"2014-09-26\",\n    \"issue_date\": \"2016-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep convolutional neural network is presented for large-scale image recognition. The network achieves state-of-the-art results on the ImageNet dataset, demonstrating a significant advancement in the field of image processing. The architecture utilizes multiple convolutional layers and pooling layers to extract hierarchical features from images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8102547B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for recognizing objects in an image comprising...\",\n        \"A system for classifying images using a convolutional neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67641", "text": "{\n    \"patent_title\": \"Method and System for Basic Image Filtering\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US8548762B1\",\n    \"priority_date\": \"2012-05-10\",\n    \"filing_date\": \"2014-05-10\",\n    \"issue_date\": \"2013-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a method and system for applying basic image filters, such as blurring and sharpening, to digital images. The system allows users to adjust filter parameters and preview the results. The invention focuses on enhancing existing image processing techniques.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for blurring an image comprising...\",\n        \"A system for sharpening an image based on user input...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67642", "text": "{\n    \"patent_title\": \"Deep Learning Based Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2021-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel image recognition system utilizing deep learning techniques, specifically convolutional neural networks, to achieve state-of-the-art accuracy in image classification tasks. The system is trained on a large dataset of labeled images and demonstrates significant improvements over existing methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition using a deep neural network.\",\n        \"A system for classifying images based on learned features.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67642", "text": "{\n    \"patent_title\": \"Enhanced Image Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-20\",\n    \"filing_date\": \"2018-11-20\",\n    \"issue_date\": \"2022-01-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details an improved image compression algorithm that reduces file size while maintaining acceptable image quality. The algorithm utilizes wavelet transforms and entropy coding techniques for efficient data representation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing images using wavelet transforms.\",\n        \"A system for reducing image file size without significant quality loss.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67643", "text": "{\n    \"patent_title\": \"Method and System for Super-Resolution Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-12-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for reconstructing high-resolution images from low-resolution images using deep learning techniques. The system significantly improves image clarity and detail, suitable for mobile photography applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a high-resolution image...\",\n        \"A system comprising a processor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67643", "text": "{\n    \"patent_title\": \"Digital Signal Processing for Audio Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-10\",\n    \"issue_date\": \"2021-08-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A digital signal processing technique for enhancing audio quality by reducing noise and improving clarity. The invention is applicable to various audio devices and systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing audio signals...\",\n        \"An audio processing system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67644", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction Method for Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-07-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel image reconstruction method for MRI that improves image quality and reduces scan time, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image...\",\n        \"An MRI apparatus comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67644", "text": "{\n    \"patent_title\": \"System and Method for Controlling a Robotic Arm\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A robotic arm control system utilizing advanced algorithms for precise movement and manipulation of objects. Applicable to manufacturing and assembly tasks.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic arm control system comprising...\",\n        \"A method for controlling the movement of a robotic arm...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67645", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for enhancing the clarity and resolution of medical images, particularly those obtained from MRI and CT scans. The method utilizes a novel reconstruction algorithm to reduce noise and artifacts, leading to improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in image reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for enhancing image clarity comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67645", "text": "{\n    \"patent_title\": \"Automated System for Patient Scheduling in Radiology Departments\",\n    \"inventors\": [\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Siemens Healthineers\"\n        },\n        {\n            \"name\": \"Emily Green\",\n            \"affiliation\": \"Mayo Clinic\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for scheduling patients for radiology exams, optimizing appointment slots and reducing wait times. The system integrates with existing hospital information systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art in patient scheduling\"\n        }\n    ],\n    \"claims\": [\n        \"A system for scheduling patients comprising...\",\n        \"A method for optimizing appointment slots comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67646", "text": "{\n    \"patent_title\": \"Method and System for Super-Resolution Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Li Wei\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Maria Garcia\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-01\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for reconstructing high-resolution images from low-resolution images using a deep convolutional neural network. The network is trained to learn a mapping function between low-resolution and high-resolution image patches, enabling effective super-resolution reconstruction.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Enhancement Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a high-resolution image...\",\n        \"A system comprising a deep neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67646", "text": "{\n    \"patent_title\": \"Automated System for Object Detection in Video Streams\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Acme Corporation\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Global Tech Industries\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-11-20\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2021-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for detecting and tracking objects in video streams using computer vision algorithms.  The system is designed for security surveillance applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Video Analytics System\"\n        }\n    ],\n    \"claims\": [\n        \"A system for detecting objects in a video stream...\",\n        \"A method for tracking objects...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67647", "text": "{\n    \"patent_title\": \"Enhanced Resolution Medical Imaging System Using Deep Learning Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2023-11-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A medical imaging system utilizing deep learning algorithms for image reconstruction, resulting in significantly improved resolution and clarity, facilitating earlier detection of subtle anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A medical imaging system comprising a scanner and a processor.\",\n        \"The processor configured to apply a deep learning algorithm to reconstruct images.\",\n        \"The deep learning algorithm optimized for enhancing image resolution.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67647", "text": "{\n    \"patent_title\": \"Method for Automated X-Ray Analysis of Bone Density\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2014-12-10\",\n    \"filing_date\": \"2014-12-10\",\n    \"issue_date\": \"2022-09-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for automatically analyzing x-ray images to determine bone density, aiding in the diagnosis of osteoporosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related to bone density measurement techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for automatically analyzing x-ray images.\",\n        \"The method comprising steps for identifying bone structures.\",\n        \"The method for calculating bone density based on x-ray absorption.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67648", "text": "{\n    \"patent_title\": \"Enhanced Medical Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning approach for reconstructing high-resolution medical images from low-dose data. The method significantly improves image clarity and reduces artifacts, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Prior art in image reconstruction\"\n        },\n        {\n            \"patent_number\": \"US1012345678B2\",\n            \"relevance\": \"Related work on deep learning for medical imaging\"\n        },\n        {\n            \"patent_number\": \"US1122334455B2\",\n            \"relevance\": \"Image enhancement techniques\"\n        },\n        {\n            \"patent_number\": \"US1234567890B1\",\n            \"relevance\": \"Noise reduction algorithms\"\n        },\n        {\n            \"patent_number\": \"US1345678901B2\",\n            \"relevance\": \"Artifact correction methods\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for enhancing the clarity of a medical image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67648", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Cardiovascular Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-01-15\",\n    \"filing_date\": \"2022-01-15\",\n    \"issue_date\": \"2023-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel catheter design with improved maneuverability and reduced risk of vascular damage during cardiovascular procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous catheter designs\"\n        },\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Related work on vascular access\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising...\",\n        \"A method for inserting a catheter into a blood vessel...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67649", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the resolution of images using deep convolutional neural networks. The system employs a novel architecture and training process to generate high-resolution images from low-resolution inputs with superior quality and reduced artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image super-resolution.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising...\",\n        \"A system for enhancing image resolution comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67649", "text": "{\n    \"patent_title\": \"Image Processing System for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-05-20\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2020-08-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An image processing system optimized for mobile devices. The system includes algorithms for image stabilization, noise reduction, and color correction, designed for real-time performance on resource-constrained platforms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related technology for mobile image processing.\"\n        }\n    ],\n    \"claims\": [\n        \"An image processing system for a mobile device comprising...\",\n        \"A method for image stabilization in a mobile device...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67650", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical Device with Enhanced Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-06-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical device designed for minimally invasive procedures. The device incorporates ergonomic features to reduce surgeon fatigue and improve precision, leading to improved patient outcomes and reduced recovery times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Existing Minimally Invasive Tool\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical device comprising an elongated shaft...\",\n        \"The surgical device according to claim 1, wherein the elongated shaft is flexible...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67650", "text": "{\n    \"patent_title\": \"Industrial Robot Arm for Manufacturing\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2021-11-01\",\n    \"filing_date\": \"2022-02-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An advanced robotic arm designed for high-precision manufacturing tasks. This arm features improved speed and repeatability for increased productivity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Prior Art Robotic Arm\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic arm comprising a plurality of joints...\",\n        \"The robotic arm according to claim 1, wherein the joints are powered by electric motors...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67651", "text": "{\n    \"patent_title\": \"Enhanced Resolution Medical Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel medical imaging system employing advanced signal processing algorithms to significantly enhance image resolution and clarity, leading to improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A medical imaging system comprising...\",\n        \"A method for enhancing image resolution...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67651", "text": "{\n    \"patent_title\": \"Portable Ultrasound Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Independent Inventor\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A compact and portable ultrasound device for point-of-care diagnostics. The device is designed for ease of use and affordability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A portable ultrasound device...\",\n        \"A method for performing ultrasound imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67652", "text": "{\n    \"patent_title\": \"Method and system for enhancing image clarity using adaptive filtering\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-02-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing image clarity by adaptively filtering noise and artifacts, thereby improving the overall visual quality of the image. The method uses a novel algorithm to analyze the image content and dynamically adjust the filtering parameters.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image clarity comprising...\",\n        \"A system for implementing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67652", "text": "{\n    \"patent_title\": \"System and method for compressing video data\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Google LLC\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-06-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for efficiently compressing video data using a novel encoding scheme. The method reduces the storage space and bandwidth requirements for video transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing video data comprising...\",\n        \"A system for implementing the compression method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67653", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction for Enhanced Medical Diagnostics\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-06-15\",\n    \"filing_date\": \"2015-03-20\",\n    \"issue_date\": \"2019-01-10\",\n    \"patent_office\": \"US\",\n    \"abstract\": \"This invention provides novel image reconstruction techniques for improving the clarity and resolution of medical images, leading to enhanced diagnostic capabilities in various imaging modalities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"title\": \"Prior Art Image Processing Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"The method of claim 1, wherein the reconstruction algorithm...\",\n        \"An apparatus for performing the method of claim 1...\",\n        \"The apparatus of claim 3, further comprising...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67653", "text": "{\n    \"patent_title\": \"Novel Contrast Agent for MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2016-02-01\",\n    \"filing_date\": \"2017-05-15\",\n    \"issue_date\": \"2020-08-25\",\n    \"patent_office\": \"US\",\n    \"abstract\": \"This invention discloses a new contrast agent for magnetic resonance imaging (MRI) that improves image contrast in certain tissues.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Existing MRI Contrast Agent\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent for MRI comprising...\",\n        \"The contrast agent of claim 1, wherein the metal complex...\",\n        \"A method of using the contrast agent of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67654", "text": "{\n    \"patent_title\": \"Comfortable Wearable Cardiac Monitor\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"CardioTech Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel wearable cardiac monitor designed with hypoallergenic materials and ergonomic shaping for improved patient comfort during prolonged use. The device provides continuous ECG monitoring and transmits data wirelessly to a secure cloud platform.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art related to wearable sensors.\"\n        }\n    ],\n    \"claims\": [\n        \"A wearable cardiac monitor comprising hypoallergenic materials.\",\n        \"A method for continuously monitoring ECG signals.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67654", "text": "{\n    \"patent_title\": \"Automated Surgical Robot\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2019-11-22\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2023-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated surgical robot with enhanced precision and dexterity for minimally invasive procedures. The robot utilizes advanced computer vision and machine learning algorithms to assist surgeons.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Previous robotic surgery systems.\"\n        }\n    ],\n    \"claims\": [\n        \"An automated surgical robot comprising a robotic arm.\",\n        \"A method for performing minimally invasive surgery using a robotic system.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67655", "text": "{\n    \"patent_title\": \"Enhanced Magnetic Resonance Imaging with Artificial Intelligence\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method for improving the accuracy of magnetic resonance imaging (MRI) using artificial intelligence algorithms. The AI algorithms analyze MRI data to enhance image clarity and aid in the diagnosis of various medical conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI image clarity using AI.\",\n        \"A system for diagnosing medical conditions based on enhanced MRI images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67655", "text": "{\n    \"patent_title\": \"Novel X-Ray Shielding Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-01\",\n    \"issue_date\": \"2023-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a new material for shielding against X-ray radiation, offering improved protection for patients and medical personnel.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A shielding material comprising a novel alloy.\",\n        \"A method for manufacturing the shielding material.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67656", "text": "{\n    \"patent_title\": \"Novel MRI Contrast Agent for Enhanced Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-06-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel MRI contrast agent utilizing nanoparticles with surface functionalization that dramatically enhances tumor detection sensitivity and specificity. Preclinical studies demonstrate a significant improvement in early-stage cancer diagnosis. This represents a substantial advancement in medical imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8546001B2\",\n            \"relevance\": \"Prior art contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising nanoparticles with a specific surface coating.\",\n        \"A method for enhancing tumor detection using the contrast agent.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67656", "text": "{\n    \"patent_title\": \"Improved X-Ray Tube Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-09-20\",\n    \"filing_date\": \"2017-09-20\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes improvements to the design of X-ray tubes, focusing on increasing lifespan and reducing energy consumption. The design incorporates a novel anode material and cooling system. This offers incremental gains in X-ray technology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"relevance\": \"Previous X-ray tube designs\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube with a specific anode material.\",\n        \"A cooling system for an X-ray tube.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67657", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical Stapler with Integrated Tissue Alignment System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Boston Medical Center\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-05-04\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical stapler incorporating a novel tissue alignment system to improve surgical precision and patient outcomes by reducing tissue damage and promoting faster healing. The design prioritizes simplicity and ease of use for surgeons.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Similar stapler design\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"A tissue alignment system...\",\n        \"A method for performing surgical anastomosis...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67657", "text": "{\n    \"patent_title\": \"Advanced Robotic Surgical System with AI-Powered Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-08-20\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2022-01-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An advanced robotic surgical system utilizing artificial intelligence to enhance surgical precision and automation. Features include real-time image guidance, haptic feedback, and autonomous tissue manipulation capabilities. This complex system enables surgeons to perform highly intricate procedures with minimal invasiveness.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"Related robotic surgery technology\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system comprising...\",\n        \"An AI module for real-time image analysis...\",\n        \"A method for autonomous tissue manipulation...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67658", "text": "{\n    \"patent_title\": \"Method and System for Adaptive Image Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-07-15\",\n    \"filing_date\": \"2015-01-20\",\n    \"issue_date\": \"2019-05-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for adaptively enhancing digital images by analyzing image characteristics and applying optimized filters to improve visual clarity and reduce noise.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"title\": \"Image Noise Reduction Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing a digital image comprising: analyzing the image to determine noise levels; and applying a filter based on the determined noise levels.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67658", "text": "{\n    \"patent_title\": \"System for Organizing Digital Photographs\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10293847B1\",\n    \"priority_date\": \"2015-03-10\",\n    \"filing_date\": \"2016-02-15\",\n    \"issue_date\": \"2020-11-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for automatically organizing digital photographs based on metadata, facial recognition, and location data.  The system allows users to easily search and retrieve photos.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Metadata Extraction for Image Retrieval\"\n        }\n    ],\n    \"claims\": [\n        \"A system for organizing digital photographs comprising: a metadata extraction module; a facial recognition module; and a search interface.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67659", "text": "{\n    \"patent_title\": \"Miniature Surgical Robot with Enhanced Dexterity\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature surgical robot designed for minimally invasive procedures, featuring enhanced dexterity and precision control. This invention addresses the challenges of performing complex surgeries through small incisions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robot comprising a flexible end effector...\",\n        \"A control system for precise manipulation of the end effector...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67659", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"MedTech Industries Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2017-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design for efficient and targeted drug delivery to specific anatomical locations. The catheter features a novel tip geometry to minimize tissue damage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter with a distal tip comprising a curved profile...\",\n        \"A method for delivering a therapeutic agent using the catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67660", "text": "{\n    \"patent_title\": \"Low-Light Image Enhancement Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-06-15\",\n    \"issue_date\": \"2021-01-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing images captured under low-light conditions using deep convolutional neural networks. The system learns to map low-light images to high-quality images, improving visibility and detail.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Noise Reduction Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing a low-light image comprising...\",\n        \"A system for processing images captured in low-light environments...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67660", "text": "{\n    \"patent_title\": \"Facial Recognition System for Security Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-02-20\",\n    \"filing_date\": \"2018-03-20\",\n    \"issue_date\": \"2020-04-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A facial recognition system for enhancing security, capable of identifying individuals with high accuracy in various lighting conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Image Recognition Algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"A facial recognition system comprising...\",\n        \"A method for identifying individuals based on facial features...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67661", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical system incorporating advanced imaging and robotic assistance for minimally invasive procedures, improving precision and patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art in robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising a robotic arm...\",\n        \"An imaging module for real-time visualization...\",\n        \"A control system for precise movement...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67661", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-11-10\",\n    \"filing_date\": \"2019-12-15\",\n    \"issue_date\": \"2021-08-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A catheter with an improved tip design for more effective drug delivery to targeted tissues.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in catheter design\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible shaft...\",\n        \"A tip configured for targeted drug delivery...\",\n        \"A lumen for fluid flow...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67662", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Detection of Micro-Calcifications in Mammograms\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-11-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for improving the detection of micro-calcifications in mammograms using a novel image processing algorithm. The system enhances image contrast and utilizes machine learning to identify subtle anomalies indicative of early-stage breast cancer.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760832B1\",\n            \"relevance\": \"Prior art in image enhancement.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing mammographic images comprising...\",\n        \"A system for detecting micro-calcifications...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The method of claim 1, wherein the image processing algorithm...\",\n        \"The system of claim 2, further comprising a user interface...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67662", "text": "{\n    \"patent_title\": \"System for Automated Analysis of Electrocardiogram Signals\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2014-12-01\",\n    \"filing_date\": \"2014-12-01\",\n    \"issue_date\": \"2020-04-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for automated analysis of electrocardiogram signals to detect heart rhythm abnormalities. The system utilizes signal processing techniques to identify key features in the ECG waveform.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Previous work on ECG signal processing.\"\n        }\n    ],\n    \"claims\": [\n        \"A system for analyzing electrocardiogram signals comprising...\",\n        \"A method for detecting heart rhythm abnormalities...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67663", "text": "{\n    \"patent_title\": \"Contrast-Enhanced Photoacoustic Tomography System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel photoacoustic tomography system utilizing contrast agents for enhanced medical imaging. This system improves resolution and depth penetration for early disease detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on photoacoustic imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A photoacoustic tomography system comprising...\",\n        \"A method for enhancing image resolution...\",\n        \"Use of contrast agents...\",\n        \"A system for detecting early-stage tumors...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67663", "text": "{\n    \"patent_title\": \"Improved X-Ray Detection System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US11345678B2\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-01\",\n    \"issue_date\": \"2023-05-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved X-ray detection system with enhanced signal processing capabilities. This system provides clearer images and reduced radiation exposure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Existing X-ray detection technologies\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray detection system comprising...\",\n        \"A method for signal processing...\",\n        \"A device for reducing radiation...\",\n        \"A system for improving image clarity...\",\n        \"Claim 5...\",\n        \"Claim 6...\",\n        \"Claim 7...\",\n        \"Claim 8...\",\n        \"Claim 9...\",\n        \"Claim 10...\",\n        \"Claim 11...\",\n        \"Claim 12...\",\n        \"Claim 13...\",\n        \"Claim 14...\",\n        \"Claim 15...\",\n        \"Claim 16...\",\n        \"Claim 17...\",\n        \"Claim 18...\",\n        \"Claim 19...\",\n        \"Claim 20...\",\n        \"Claim 21...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67664", "text": "{\n    \"patent_title\": \"Improved MRI Image Reconstruction Technique for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel MRI image reconstruction technique utilizing deep learning algorithms to enhance image clarity and reduce noise, leading to improved detection of early-stage cancerous tumors. The method demonstrates a statistically significant improvement in diagnostic accuracy compared to existing methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for diagnosing cancer using reconstructed MRI images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67664", "text": "{\n    \"patent_title\": \"Enhanced CT Scan Protocol for Bone Fracture Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Wilson\",\n            \"affiliation\": \"General Hospital Corporation\"\n        }\n    ],\n    \"patent_number\": \"US11123456B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an improved CT scan protocol for visualizing bone fractures with increased speed and reduced radiation exposure. The protocol optimizes scanning parameters and image processing techniques for clear visualization of fracture lines.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A CT scan protocol comprising...\",\n        \"A system for detecting bone fractures using the protocol...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67665", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-06-10\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing medical images from raw data, utilizing a deep learning algorithm to reduce noise and enhance image resolution. The method significantly improves the clarity of MRI and CT scans.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"The method of claim 1, wherein the deep learning algorithm...\",\n        \"A system for performing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67665", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Vascular Access\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10246813B1\",\n    \"priority_date\": \"2017-03-01\",\n    \"filing_date\": \"2017-04-15\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new design for vascular access catheters, featuring a flexible tip and improved biocompatible coating to minimize risk of infection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A vascular access catheter comprising...\",\n        \"The catheter of claim 1, wherein the tip is flexible...\",\n        \"The catheter of claim 1, comprising a biocompatible coating...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67666", "text": "{\n    \"patent_title\": \"Remote Physiological Monitoring System and Method\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-01\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for remotely monitoring physiological parameters of a patient, including continuous ECG, heart rate variability, and respiratory rate, using wearable sensors and a cloud-based data analytics platform. The system provides real-time alerts to healthcare providers for abnormal readings.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in wearable sensor technology\"\n        }\n    ],\n    \"claims\": [\n        \"A system for remotely monitoring a patient's physiological parameters comprising...\",\n        \"A method for analyzing physiological data received from a wearable sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67666", "text": "{\n    \"patent_title\": \"Surgical Instrument for Minimally Invasive Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2018-05-20\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2021-05-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical instrument designed for performing minimally invasive procedures with enhanced precision and dexterity. The instrument incorporates a flexible robotic arm and advanced imaging capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"Prior art in robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising a flexible robotic arm...\",\n        \"A method for performing minimally invasive surgery using the surgical instrument...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67667", "text": "{\n    \"patent_title\": \"Comfortable Nasal Cannula with Integrated Humidity Control\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2020-01-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel nasal cannula design incorporating an integrated humidity control system. This design significantly improves patient comfort during prolonged oxygen therapy, reducing nasal dryness and irritation. The cannula features a flexible, ergonomic fit and minimizes pressure points, enhancing usability for patients of all ages.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art related to nasal cannula design\"\n        }\n    ],\n    \"claims\": [\n        \"A nasal cannula comprising an integrated humidity control system.\",\n        \"The nasal cannula of claim 1, wherein the humidity control system is adjustable.\",\n        \"The nasal cannula of claim 1, wherein the cannula is constructed from a flexible material.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67667", "text": "{\n    \"patent_title\": \"Automated Surgical Instrument Tracking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2019-09-10\",\n    \"filing_date\": \"2019-09-10\",\n    \"issue_date\": \"2021-05-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for tracking surgical instruments during procedures. The system utilizes RFID tags and a central processing unit to monitor the location of each instrument in real-time, improving efficiency and reducing the risk of misplaced tools. This improves surgical workflow.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related to RFID-based tracking systems\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument tracking system comprising RFID tags.\",\n        \"The system of claim 1, further comprising a central processing unit.\",\n        \"The system of claim 1, wherein the system provides real-time location data.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67668", "text": "{\n    \"patent_title\": \"Low-Light Image Enhancement Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-04-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel deep learning architecture for enhancing the visibility and quality of images captured in low-light conditions. The network utilizes a multi-scale convolutional approach to effectively reduce noise and improve contrast.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing low-light images comprising...\",\n        \"A system for automatically improving image quality in challenging lighting conditions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67668", "text": "{\n    \"patent_title\": \"Method for Compressing Digital Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"IBM Research\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-12-01\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2021-09-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new algorithm for efficiently compressing digital images without significant loss of quality. It utilizes wavelet transforms and entropy encoding techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a digital image comprising...\",\n        \"A system for reducing the storage space required for digital image data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67669", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Recognition using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University - Computer Vision Lab\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for improving image recognition accuracy using deep convolutional neural networks. The system is capable of identifying objects in images with high precision and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Classification using Support Vector Machines\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising:...\",\n        \"A system for image recognition comprising:...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67669", "text": "{\n    \"patent_title\": \"Improved Method for Mechanical Gear Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Motors - Engineering Department\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Ford Motor Company\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved method for designing mechanical gears with increased efficiency and durability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Gear Manufacturing Process\"\n        }\n    ],\n    \"claims\": [\n        \"A mechanical gear design characterized by...\",\n        \"A method for manufacturing a mechanical gear...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67670", "text": "{\n    \"patent_title\": \"Neural Network Architecture for Enhanced Medical Image Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2021-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel neural network architecture for analyzing medical images, specifically designed for identifying subtle anomalies indicative of early-stage disease. The system goes beyond simple object detection to provide contextual understanding of image features.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for analyzing medical images comprising...\",\n        \"A system for detecting anomalies in medical images...\",\n        \"A neural network architecture with enhanced contextual awareness...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67670", "text": "{\n    \"patent_title\": \"Object Detection in Real-Time Video Streams\",\n    \"inventors\": [\n        {\n            \"name\": \"Sergey Levin\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Yann LeCun\",\n            \"affiliation\": \"New York University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for real-time object detection in video streams, utilizing a convolutional neural network. This invention improves the speed and accuracy of identifying common objects such as cars, pedestrians, and buildings.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for detecting objects in real-time video streams...\",\n        \"A convolutional neural network optimized for object detection...\",\n        \"A method for improving the accuracy of object detection...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67671", "text": "{\n    \"patent_title\": \"Improved MRI Contrast Enhancement for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel MRI contrast agent and imaging protocol that significantly enhances the detection of early-stage cancerous tumors, leading to improved diagnostic accuracy and patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Gadolinium-Based Contrast Agents for MRI\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Methods for Optimizing MRI Signal Intensity\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI contrast using a nanoparticle-based contrast agent.\",\n        \"An MRI protocol optimized for early cancer detection.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67671", "text": "{\n    \"patent_title\": \"Novel System for Dental X-ray Image Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-05\",\n    \"issue_date\": \"2023-04-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new algorithm for processing digital X-ray images in dentistry, improving image clarity and reducing radiation exposure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Digital X-ray Image Enhancement Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for improving the clarity of dental X-ray images using digital signal processing.\",\n        \"A system for reducing radiation exposure during dental X-ray imaging.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67672", "text": "{\n    \"patent_title\": \"Enhanced MRI Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning approach for reconstructing MRI images, leading to improved image quality and diagnostic accuracy. The method reduces noise and artifacts, allowing for earlier and more accurate detection of subtle anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for improved MRI diagnosis based on...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67672", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Cardiovascular Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Medtronic Inc.\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Medtronic Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2015-12-10\",\n    \"filing_date\": \"2015-12-10\",\n    \"issue_date\": \"2017-06-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new catheter design with improved maneuverability and reduced risk of vascular damage during cardiovascular procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous catheter designs\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible shaft...\",\n        \"A method for performing cardiovascular procedures using the catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67673", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable biosensor for continuous glucose monitoring, utilizing a novel enzymatic reaction and wireless communication protocol. This device offers improved accuracy and patient comfort compared to existing technologies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on glucose sensing technology\"\n        }\n    ],\n    \"claims\": [\n        \"A biosensor comprising a miniaturized enzymatic reaction chamber...\",\n        \"A wireless communication module for transmitting glucose levels...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67673", "text": "{\n    \"patent_title\": \"Improved Surgical Stapler Design\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Acme Medical Inc.\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Acme Medical Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler design featuring enhanced ergonomics and a faster firing mechanism.  This improves surgical efficiency and reduces surgeon fatigue.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Prior art on surgical staplers\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an improved handle design...\",\n        \"A firing mechanism with reduced friction...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67674", "text": "{\n    \"patent_title\": \"High-Resolution Optical Coherence Tomography System with Adaptive Optics\",\n    \"inventors\": [\n        {\n            \"name\": \"David Huang\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"James Fujimoto\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A high-resolution optical coherence tomography (OCT) system incorporating adaptive optics to correct for aberrations and significantly improve image clarity. This allows for detailed visualization of retinal structures and improved diagnosis of various eye diseases.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8542378B2\"\n        },\n        {\n            \"patent_number\": \"US7907348B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for obtaining a high-resolution image using OCT and adaptive optics.\",\n        \"An OCT system comprising an adaptive optics module.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67674", "text": "{\n    \"patent_title\": \"MRI Coil Design for Improved Signal-to-Noise Ratio\",\n    \"inventors\": [\n        {\n            \"name\": \"Sarah Jones\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9234567B1\",\n    \"priority_date\": \"2014-12-10\",\n    \"filing_date\": \"2014-12-10\",\n    \"issue_date\": \"2016-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved magnetic resonance imaging (MRI) coil design that enhances the signal-to-noise ratio, leading to clearer images and reduced scan times. The coil utilizes a novel arrangement of conductive elements.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8125098B2\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil with a specific geometric arrangement.\",\n        \"A method for increasing signal-to-noise ratio in MRI.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67675", "text": "{\n    \"patent_title\": \"Adaptive Noise Reduction for Low-Light Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2018-10-15\",\n    \"filing_date\": \"2019-03-20\",\n    \"issue_date\": \"2021-01-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reducing noise in low-light images using adaptive filtering techniques. The algorithm dynamically adjusts filtering parameters based on image content, resulting in improved image quality and visual perception.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing noise in an image comprising...\",\n        \"An apparatus for processing images comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67675", "text": "{\n    \"patent_title\": \"Method for Compressing Video Data\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2022-06-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for efficiently compressing video data using a novel wavelet transform. This reduces storage space and bandwidth requirements.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US1011121314B1\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing video data comprising...\",\n        \"A system for encoding video data comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67676", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method and system for reconstructing medical images from raw data, resulting in significantly enhanced clarity and improved diagnostic accuracy. The method employs advanced algorithms to reduce noise and artifacts, leading to more detailed and reliable images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8569321B2\"\n        },\n        {\n            \"patent_number\": \"US9216987B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for implementing the method of claim 1...\",\n        \"The method of claim 1, wherein the medical image is a CT scan.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67676", "text": "{\n    \"patent_title\": \"Automated Surgical Tool Tracking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10458765B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system for accurately tracking surgical tools during minimally invasive procedures, providing real-time feedback to the surgeon. The system utilizes magnetic resonance imaging to determine the position and orientation of the tools.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for tracking surgical tools comprising...\",\n        \"The system of claim 1, wherein the tracking is performed using MRI.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67677", "text": "{\n    \"patent_title\": \"High-Resolution Photoacoustic Tomography System for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel photoacoustic tomography system achieving unprecedented resolution for early cancer detection. This breakthrough utilizes a new pulse compression technique and advanced image reconstruction algorithms, enabling visualization of microvasculature with exceptional clarity. The system demonstrates significantly improved sensitivity and specificity compared to existing imaging modalities, offering potential for earlier and more accurate diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in photoacoustic imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A photoacoustic tomography system comprising...\",\n        \"A method for generating high-resolution images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67677", "text": "{\n    \"patent_title\": \"Improved Calibration Method for CT Scanners\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-05-10\",\n    \"filing_date\": \"2022-05-10\",\n    \"issue_date\": \"2024-01-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved method for calibrating computed tomography (CT) scanners. The method utilizes a novel algorithm to correct for geometric distortions and improve image quality. The calibration process is automated and reduces the time required for setup.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous CT calibration techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for calibrating a CT scanner comprising...\",\n        \"A system for automated CT scanner calibration...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67678", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"David Utley\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical system designed for minimally invasive procedures, incorporating advanced imaging and robotic control for improved precision and patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising a robotic arm and an imaging module.\",\n        \"A method for performing a minimally invasive surgical procedure using the system.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67678", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Cardiovascular Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Smith\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2021-02-28\",\n    \"filing_date\": \"2021-04-15\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new catheter design providing enhanced maneuverability and reduced trauma during cardiovascular interventions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible shaft and a distal tip.\",\n        \"A method for navigating a blood vessel using the catheter.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67679", "text": "{\n    \"patent_title\": \"Method and System for Efficient Image Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2019-06-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for enhancing the quality of digital images using adaptive filtering techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"count\": 10\n        },\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"count\": 6\n        }\n    ],\n    \"claims\": [\n        \"A method for image enhancement...\",\n        \"A system for implementing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67679", "text": "{\n    \"patent_title\": \"Image Compression Technique Using Wavelets\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2018-05-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new image compression algorithm based on wavelet transformation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"count\": 2\n        },\n        {\n            \"patent_number\": \"US10456789B1\",\n            \"count\": 1\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing images...\",\n        \"An apparatus for implementing the compression method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67680", "text": "{\n    \"patent_title\": \"Patient-Comfortable Intravenous Catheter System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Medical Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US1234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An intravenous catheter system designed to minimize patient discomfort during insertion and usage. The system incorporates a flexible, bio-compatible material and a novel insertion technique.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible polymeric material.\",\n        \"A method for inserting a catheter minimizing patient discomfort.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67680", "text": "{\n    \"patent_title\": \"Surgical Robotic Arm with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Davis\",\n            \"affiliation\": \"Robotics Corp.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2014-11-22\",\n    \"filing_date\": \"2014-11-22\",\n    \"issue_date\": \"2017-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A robotic arm designed for surgical procedures, offering improved precision and control. The device utilizes advanced sensor technology and a sophisticated control algorithm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic arm comprising a plurality of servo motors.\",\n        \"A method for controlling a robotic arm during surgery.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67681", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Super-Resolution with Generative Adversarial Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Chen Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Wei Zhang\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-12-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for image super-resolution is presented, utilizing generative adversarial networks (GANs) to generate high-resolution images with enhanced details and perceptual quality. The method addresses the challenges of texture recovery and realistic image generation in super-resolution tasks.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Image Enhancement Using Convolutional Neural Networks\"\n        }\n    ],\n    \"claims\": [\n        \"A method for super-resolving an image comprising...\",\n        \"A system for generating high-resolution images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67681", "text": "{\n    \"patent_title\": \"Method for Compressing Digital Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Smith\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-10\",\n    \"issue_date\": \"2021-08-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method for efficiently compressing digital images using a wavelet transform and entropy encoding. The method reduces image file size while maintaining acceptable image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Wavelet-Based Image Compression Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a digital image comprising...\",\n        \"A system for encoding image data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67682", "text": "{\n    \"patent_title\": \"Miniature Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10543216B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-11-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable glucose sensor is disclosed, utilizing a novel biocompatible material and wireless communication protocol for real-time glucose monitoring in diabetic patients. The sensor addresses the need for continuous, non-invasive glucose monitoring.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable glucose sensor...\",\n        \"A method for continuously monitoring glucose levels...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67682", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-12-20\",\n    \"filing_date\": \"2014-12-20\",\n    \"issue_date\": \"2018-08-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler with enhanced ergonomics for increased surgeon comfort and precision. The stapler features a redesigned handle and improved staple cartridge.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A surgical stapler comprising an ergonomic handle...\",\n        \"A staple cartridge for use with the surgical stapler...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67683", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Sepsis Diagnosis\",\n    \"inventors\": [\n        {\n            \"name\": \"Manu Prakash\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Chen\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a microfluidic device capable of rapidly diagnosing sepsis from a small blood sample. The device integrates multiple diagnostic tests on a single chip, providing results within minutes. Improved diagnostic speed leads to faster treatment initiation and significantly improved patient survival rates.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for diagnosing sepsis...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67683", "text": "{\n    \"patent_title\": \"Surgical Instrument Handle Design\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2021-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved ergonomic design for surgical instrument handles. The handle features a textured grip and optimized weight distribution for enhanced control during complex procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument handle with...\",\n        \"A method for manufacturing a surgical instrument handle...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67684", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the resolution of digital images using deep learning techniques. The system utilizes a convolutional neural network to upscale images while preserving details and reducing artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Super-Resolution Using Sparse Representation\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing the resolution of a digital image comprising...\",\n        \"A system for enhancing the resolution of a digital image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67684", "text": "{\n    \"patent_title\": \"Medical Image Analysis System for Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Mayo Clinic\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of Michigan\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for analyzing medical images to detect tumors using advanced image processing and machine learning algorithms. Specifically designed for detecting cancerous growths in MRI and CT scans.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Automated Tumor Segmentation in Medical Images\"\n        }\n    ],\n    \"claims\": [\n        \"A system for detecting tumors in medical images comprising...\",\n        \"A method for segmenting tumors in MRI scans...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67685", "text": "{\n    \"patent_title\": \"Method for Enhanced Magnetic Resonance Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method for reconstructing magnetic resonance images with improved clarity and reduced noise, leading to more accurate diagnoses. It utilizes a deep learning algorithm trained on a large dataset of MRI scans.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image filtering\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a magnetic resonance image comprising...\",\n        \"A system for performing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67685", "text": "{\n    \"patent_title\": \"Automated System for Pharmaceutical Compound Synthesis\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2017-08-22\",\n    \"filing_date\": \"2017-08-22\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for synthesizing pharmaceutical compounds with high throughput and precision. The system incorporates robotic arms and automated chemical reactors.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous work on automated chemical synthesis\"\n        }\n    ],\n    \"claims\": [\n        \"An automated system for synthesizing pharmaceutical compounds comprising...\",\n        \"A method for operating the system of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67686", "text": "{\n    \"patent_title\": \"Improved MRI Reconstruction Algorithm for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel MRI reconstruction algorithm that significantly enhances image clarity and improves the accuracy of early cancer detection. The algorithm utilizes advanced machine learning techniques to reduce noise and artifacts, leading to more reliable diagnostic results.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"MRI Image Enhancement Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"An MRI system configured to perform the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67686", "text": "{\n    \"patent_title\": \"Novel System for Pharmaceutical Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2015-11-01\",\n    \"filing_date\": \"2015-11-01\",\n    \"issue_date\": \"2017-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new system for delivering pharmaceutical drugs directly to targeted tissues. The system utilizes biocompatible nanoparticles and controlled release mechanisms to maximize therapeutic efficacy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Nanoparticle Drug Delivery Systems\"\n        }\n    ],\n    \"claims\": [\n        \"A drug delivery system comprising...\",\n        \"A method for treating a disease using the drug delivery system of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67687", "text": "{\n    \"patent_title\": \"Enhanced Resolution MRI Using Deep Learning Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing MRI images using deep learning algorithms, resulting in significantly improved resolution and clarity compared to traditional methods. Applicable to a wide range of medical imaging applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"An MRI system configured to implement the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67687", "text": "{\n    \"patent_title\": \"Improved X-Ray Tube Design for Reduced Radiation Exposure\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11567890B2\",\n    \"priority_date\": \"2021-01-20\",\n    \"filing_date\": \"2021-04-15\",\n    \"issue_date\": \"2022-10-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel X-ray tube design incorporating advanced shielding materials to reduce radiation exposure to patients during X-ray imaging. Improves patient safety and image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube comprising...\",\n        \"A radiation shielding assembly for use with the X-ray tube of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67688", "text": "{\n    \"patent_title\": \"Improved Method for Early Cancer Detection Using Multi-Modal Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for detecting early-stage cancers utilizing a combination of MRI and PET imaging modalities, enhanced with artificial intelligence algorithms for improved accuracy and reduced false-positive rates. The system provides significantly improved diagnostic capability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"relevance\": \"Prior art in MRI image reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancer comprising...\",\n        \"A system for processing multi-modal medical images...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67688", "text": "{\n    \"patent_title\": \"Enhanced Image Compression for Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-08-10\",\n    \"filing_date\": \"2017-08-10\",\n    \"issue_date\": \"2020-11-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an improved method for compressing medical images, reducing storage requirements and transmission bandwidth without significant loss of image quality. It uses a novel wavelet transform algorithm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Previous work in wavelet compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a medical image...\",\n        \"A system for encoding and decoding medical images...\",\n        \"A computer-readable medium storing a compression algorithm...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67689", "text": "{\n    \"patent_title\": \"Implantable Sensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable sensor for continuous glucose monitoring provides real-time glucose levels to patients with diabetes, improving glycemic control and reducing the risk of complications. The sensor utilizes a novel biocompatible material and a miniaturized electrochemical detection system.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for continuous glucose monitoring comprising: an implantable sensor...\",\n        \"A method for improving glycemic control in a diabetic patient...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67689", "text": "{\n    \"patent_title\": \"Surgical Instrument for Bone Cutting\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Smith Medical Devices Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-11-20\",\n    \"filing_date\": \"2019-11-20\",\n    \"issue_date\": \"2022-09-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical instrument for precise bone cutting during orthopedic procedures. The instrument features a high-speed rotary blade and a depth control mechanism.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising: a rotary blade...\",\n        \"A method for cutting bone using a high-speed blade...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67690", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Pressure Sensor for Remote Hemodynamic Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized, wireless pressure sensor system for continuous and remote monitoring of hemodynamic parameters. This device utilizes a novel MEMS-based pressure transducer and a low-power communication protocol to provide real-time data on cardiac function, offering a non-invasive solution for managing cardiovascular diseases.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in wireless sensor technology\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising...\",\n        \"A method for remotely monitoring hemodynamic parameters...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67690", "text": "{\n    \"patent_title\": \"Surgical Instrument for Orthopedic Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-05-10\",\n    \"filing_date\": \"2022-05-10\",\n    \"issue_date\": \"2024-01-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical instrument designed for precise bone cutting and shaping during orthopedic procedures. The instrument incorporates a novel blade geometry and ergonomic handle for enhanced surgical control and reduced patient trauma.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related prior art in surgical instrument design\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising...\",\n        \"A method for orthopedic bone cutting...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67691", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Segmentation Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-11-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for image segmentation utilizing deep convolutional neural networks. This invention significantly improves the accuracy and efficiency of identifying objects within images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image classification\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related work on convolutional neural networks\"\n        },\n        {\n            \"patent_number\": \"US11000001B2\",\n            \"relevance\": \"Comparative study on segmentation techniques\"\n        },\n        {\n            \"patent_number\": \"US11111111B2\",\n            \"relevance\": \"Baseline segmentation algorithm\"\n        },\n        {\n            \"patent_number\": \"US11222222B2\",\n            \"relevance\": \"Related segmentation approach\"\n        },\n        {\n            \"patent_number\": \"US11333333B2\",\n            \"relevance\": \"Alternative deep learning technique\"\n        },\n        {\n            \"patent_number\": \"US11444444B2\",\n            \"relevance\": \"Another relevant segmentation method\"\n        },\n        {\n            \"patent_number\": \"US11555555B2\",\n            \"relevance\": \"An older segmentation technique\"\n        },\n        {\n            \"patent_number\": \"US11666666B2\",\n            \"relevance\": \"A preliminary segmentation method\"\n        },\n        {\n            \"patent_number\": \"US11777777B2\",\n            \"relevance\": \"A similar approach to segmentation\"\n        },\n        {\n            \"patent_number\": \"US11888888B2\",\n            \"relevance\": \"A precursor to the current invention\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image segmentation comprising...\",\n        \"A system for performing image segmentation...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67691", "text": "{\n    \"patent_title\": \"Digital Camera with Auto-Focus Feature\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Sony Corporation\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2018-01-05\",\n    \"filing_date\": \"2019-12-10\",\n    \"issue_date\": \"2020-08-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A digital camera with an improved autofocus system for capturing clear images. The system uses contrast detection and phase detection autofocus methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art autofocus system\"\n        },\n        {\n            \"patent_number\": \"US8543210B1\",\n            \"relevance\": \"Related work on image stabilization\"\n        }\n    ],\n    \"claims\": [\n        \"A digital camera comprising an autofocus system...\",\n        \"A method for autofocusing a camera lens...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67692", "text": "{\n    \"patent_title\": \"Method and System for Accelerated MRI Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2019-08-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for reconstructing Magnetic Resonance Images (MRIs) using deep learning techniques to significantly reduce scan time without sacrificing image quality. The system learns to fill in missing k-space data, resulting in faster and more efficient imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image...\",\n        \"A system comprising a deep learning module...\",\n        \"A non-transitory computer-readable medium...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67692", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Cardiovascular Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Sarah Chen\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2021-05-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel catheter design optimized for improved visualization during cardiovascular imaging procedures. The catheter incorporates a flexible tip and enhanced contrast delivery mechanisms for clearer imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible distal tip...\",\n        \"A system for cardiovascular imaging...\",\n        \"A method of using the catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67693", "text": "{\n    \"patent_title\": \"Deep Learning Based Image Super-Resolution with Enhanced Detail\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for image super-resolution that significantly improves detail recovery and perceptual quality. The system utilizes a generative adversarial network (GAN) with a novel loss function to enhance image realism.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Scaling Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for super-resolving an image...\",\n        \"A system comprising a deep neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67693", "text": "{\n    \"patent_title\": \"Method for Color Correction in Digital Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Adobe Systems\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-08-20\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2020-04-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for automatically adjusting the color balance of digital images. The algorithm analyzes the image histogram and applies a corrective transformation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Automatic White Balance Adjustment\"\n        }\n    ],\n    \"claims\": [\n        \"A method for color correcting a digital image...\",\n        \"A system for adjusting image color balance...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67694", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-02-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for improving the clarity and diagnostic accuracy of medical images using deep learning techniques. The system enhances contrast and reduces noise, leading to more reliable image analysis for early disease detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing medical images comprising...\",\n        \"A system for analyzing medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67694", "text": "{\n    \"patent_title\": \"Image Compression Technique for Satellite Imagery\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-22\",\n    \"filing_date\": \"2017-11-22\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new algorithm for compressing large satellite images, reducing storage requirements and transmission bandwidth. The technique utilizes wavelet transforms and entropy encoding.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing satellite images comprising...\",\n        \"A system for storing compressed satellite images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67695", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging Contrast Agents for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"Novel contrast agents for MRI, enhancing tumor visibility and improving early cancer detection rates. Demonstrates significantly increased sensitivity and specificity in preclinical studies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"MRI Contrast Agents\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"A method for imaging a tumor...\",\n        \"An MRI apparatus utilizing the contrast agent...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67695", "text": "{\n    \"patent_title\": \"Digital X-Ray Image Processing Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2014-11-01\",\n    \"filing_date\": \"2014-11-01\",\n    \"issue_date\": \"2018-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"Algorithms for improving the clarity and resolution of digital X-ray images. Reduces noise and artifacts in radiographic images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7541234B2\",\n            \"title\": \"Digital Radiography Systems\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing a digital X-ray image...\",\n        \"A system for enhancing radiographic images...\",\n        \"A computer program for X-ray image processing...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67696", "text": "{\n    \"patent_title\": \"Miniature Wireless Implantable Pressure Sensor for Intracranial Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-12-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature, wireless, and fully implantable pressure sensor for long-term intracranial pressure monitoring. The device utilizes a novel energy harvesting technique and biocompatible materials, offering a significant improvement over existing invasive monitoring methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Implantable Physiological Monitoring System\"\n        }\n    ],\n    \"claims\": [\n        \"A miniature wireless implantable pressure sensor comprising...\",\n        \"A method for monitoring intracranial pressure using said sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67696", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Peripheral Vascular Access\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved design for a catheter used in peripheral vascular access procedures. The catheter features a novel tip geometry and lubrication coating to minimize patient discomfort and improve insertion success rates.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Catheter with Flexible Tip\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a distal tip with a specific curvature...\",\n        \"A method for inserting a catheter into a peripheral vessel...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67697", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction Method for Positron Emission Tomography\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-12-15\",\n    \"filing_date\": \"2015-03-10\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image reconstruction algorithm for PET scans that reduces noise and artifacts, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing images from PET data...\",\n        \"An apparatus for implementing the reconstruction method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67697", "text": "{\n    \"patent_title\": \"Method for Analyzing Financial Data Using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-06-01\",\n    \"filing_date\": \"2017-01-15\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for predicting stock market trends using machine learning algorithms. This system analyzes financial data and identifies patterns to generate investment recommendations.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predicting stock market trends...\",\n        \"A method for analyzing financial data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67698", "text": "{\n    \"patent_title\": \"High-Resolution Magnetic Resonance Imaging with Reduced Scan Time\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel magnetic resonance imaging (MRI) technique that utilizes a compressed sensing algorithm to significantly reduce scan time while maintaining high resolution. This allows for faster and more accurate diagnosis of various medical conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8234567B1\",\n            \"title\": \"MRI Image Reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI comprising...\",\n        \"An MRI system configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67698", "text": "{\n    \"patent_title\": \"Improved X-Ray Shielding Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2016-05-20\",\n    \"filing_date\": \"2016-05-20\",\n    \"issue_date\": \"2018-11-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new composite material for X-ray shielding that offers improved radiation attenuation and reduced weight compared to traditional lead-based shields.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Lead-Based Radiation Shielding\"\n        }\n    ],\n    \"claims\": [\n        \"A shielding material comprising...\",\n        \"A method for manufacturing...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67699", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel method for reconstructing medical images from limited data, resulting in significantly enhanced clarity and reduced radiation exposure for patients. The technique employs a deep learning algorithm trained on a large dataset of medical scans to accurately fill in missing information, improving diagnostic capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Prior Art Image Reconstruction Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"The method of claim 1, wherein the deep learning algorithm is a convolutional neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67699", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Vascular Access\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-01-10\",\n    \"filing_date\": \"2017-01-10\",\n    \"issue_date\": \"2020-10-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved design for catheters used in vascular access procedures. The catheter features a novel tip geometry that reduces trauma to blood vessels and enhances ease of use for clinicians. It provides improved flow rates and reduced risk of complications during insertion.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Existing Catheter Technology\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a distal tip with a specific curvature...\",\n        \"The catheter of claim 1, wherein the tip is made of a biocompatible polymer.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67700", "text": "{\n    \"patent_title\": \"Improved MRI Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing MRI images using deep convolutional neural networks, resulting in higher resolution and faster scan times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"MRI Data Compression Technique\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Artifact Reduction in MRI\"\n        },\n        {\n            \"patent_number\": \"US10234567B2\",\n            \"title\": \"Deep Learning for Image Segmentation\"\n        },\n        {\n            \"patent_number\": \"US11345678B2\",\n            \"title\": \"Advanced Pulse Sequence Design\"\n        },\n        {\n            \"patent_number\": \"US12456789B2\",\n            \"title\": \"Improved Gradient Coil Design\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67700", "text": "{\n    \"patent_title\": \"Enhanced X-Ray Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Philips Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US8901234B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved X-ray imaging system with reduced radiation exposure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"X-Ray Tube Design\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A method for reducing radiation...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67701", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Enhancement for Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-08-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for enhancing the quality of medical images, leading to improved diagnostic accuracy. The system utilizes generative adversarial networks (GANs) to reconstruct high-resolution images from low-resolution inputs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing medical images using a deep learning model.\",\n        \"The method of claim 1, wherein the deep learning model is a generative adversarial network.\",\n        \"A system comprising a deep learning model configured to enhance medical images.\",\n        \"The system of claim 3, further comprising a user interface for displaying the enhanced images.\",\n        \"A non-transitory computer-readable medium storing instructions for performing the method of claim 1.\",\n        \"The method of claim 1, wherein the medical images are CT scans.\",\n        \"The method of claim 1, wherein the medical images are MRI scans.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67701", "text": "{\n    \"patent_title\": \"Method for Applying a Standard Filter to Digital Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-08-01\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2021-05-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for applying a predefined filter (e.g., Gaussian blur, sharpening) to digital images. The filter parameters are adjustable by the user.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Background on digital image filtering\"\n        }\n    ],\n    \"claims\": [\n        \"A method for applying a filter to a digital image.\",\n        \"The method of claim 1, wherein the filter is a Gaussian blur.\",\n        \"The method of claim 1, wherein the filter is a sharpening filter.\",\n        \"A system for applying a filter to a digital image.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67702", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Cardiac Monitor with Enhanced Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Mark Olsen\",\n            \"affiliation\": \"Boston Children's Hospital\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable cardiac monitor is disclosed, comprising a low-power transceiver and advanced signal processing algorithms for reliable detection of cardiac arrhythmias and enhanced data transmission to external devices, thereby improving patient monitoring and reducing hospital readmissions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art related to implantable sensors.\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable cardiac monitor comprising...\",\n        \"A method for detecting cardiac arrhythmias...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67702", "text": "{\n    \"patent_title\": \"Complex Robotic Surgical System with AI-Powered Precision Control\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Jian Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Sarah Chen\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2015-11-20\",\n    \"filing_date\": \"2015-11-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A complex robotic surgical system incorporating artificial intelligence algorithms for enhanced precision and control during minimally invasive surgical procedures. The system includes multiple robotic arms, a high-resolution 3D visualization module, and a machine learning platform for real-time tissue identification and surgical path planning.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Prior art regarding robotic surgical arms.\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system comprising multiple robotic arms...\",\n        \"A method for performing minimally invasive surgery using AI...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67703", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for reconstructing medical images with improved resolution and reduced artifacts, utilizing a novel iterative algorithm. The system offers significant improvements in diagnostic accuracy, particularly in detecting subtle anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8780512B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for performing medical image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67703", "text": "{\n    \"patent_title\": \"Novel Contrast Agent for MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2018-07-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new contrast agent for magnetic resonance imaging (MRI) that enhances signal intensity. The agent is biocompatible and offers improved visualization of blood vessels.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"A method for enhancing MRI signal using the contrast agent...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67704", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction Algorithm for Enhanced MRI Diagnostic Accuracy\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2023-11-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel image reconstruction algorithm for Magnetic Resonance Imaging (MRI) that significantly improves diagnostic accuracy by reducing noise and enhancing resolution. The algorithm utilizes a deep learning approach to identify and remove artifacts, leading to clearer images and more reliable diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in MRI image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"An MRI system configured to implement the method...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67704", "text": "{\n    \"patent_title\": \"Method for Improving Contrast in X-Ray Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2015-12-10\",\n    \"filing_date\": \"2015-12-10\",\n    \"issue_date\": \"2022-09-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method for enhancing contrast in X-ray images using a novel filter. The filter improves the visibility of subtle anatomical features, aiding in the detection of abnormalities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related X-ray imaging techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing contrast in X-ray images...\",\n        \"An X-ray imaging system comprising the method...\",\n        \"A filter configured to improve contrast...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67705", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Chen\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2019-01-20\",\n    \"issue_date\": \"2021-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized, implantable biosensor for continuous glucose monitoring using novel nanomaterial-based sensing elements. The device offers improved accuracy and biocompatibility compared to existing technologies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in glucose sensing\"\n        }\n    ],\n    \"claims\": [\n        \"A biosensor comprising a nanomaterial-based sensing element...\",\n        \"A method for continuous glucose monitoring using the biosensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67705", "text": "{\n    \"patent_title\": \"Improved Syringe Design for Fluid Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2018-05-10\",\n    \"issue_date\": \"2022-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved syringe design with enhanced flow control and reduced dead volume for precise fluid delivery in medical applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art in syringe design\"\n        }\n    ],\n    \"claims\": [\n        \"A syringe comprising a plunger with optimized geometry...\",\n        \"A method for delivering fluid using the syringe...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67706", "text": "{\n    \"patent_title\": \"Adaptive Image Enhancement Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-09-20\",\n    \"issue_date\": \"2019-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for adaptively enhancing image quality using deep convolutional neural networks. The system analyzes image characteristics and applies optimal enhancement filters to improve visual clarity and detail.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image quality comprising: analyzing an input image using a deep convolutional neural network; and applying an enhancement filter based on the analysis.\",\n        \"The method of claim 1, wherein the enhancement filter is adaptively adjusted based on image content.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67706", "text": "{\n    \"patent_title\": \"Method for Data Compression Using Wavelet Transforms\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US11123456B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2021-02-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for compressing digital data using wavelet transforms. The technique provides high compression ratios while maintaining acceptable data fidelity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing digital data comprising: applying a wavelet transform to the data; and quantizing the wavelet coefficients.\",\n        \"The method of claim 1, wherein the wavelet transform is a discrete wavelet transform.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67707", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Recognition Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for improving image recognition accuracy using deep convolutional neural networks. The system includes a novel architecture and training algorithm to reduce false positives and improve classification performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"type\": \"Prior Art\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"type\": \"Related Application\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67707", "text": "{\n    \"patent_title\": \"Digital Image Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US7654321B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2017-09-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A digital image compression technique utilizing wavelet transform for efficient storage and transmission of image data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"type\": \"Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image comprising...\",\n        \"A system for compressing an image comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67708", "text": "{\n    \"patent_title\": \"AI-Powered Diagnostic System for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an AI system utilizing deep learning to analyze medical images for early cancer detection, significantly improving diagnostic accuracy compared to traditional methods. The system identifies subtle patterns indicative of cancerous growth, assisting radiologists in making more informed decisions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for detecting cancer comprising:...\",\n        \"A method for improving diagnostic accuracy using AI...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67708", "text": "{\n    \"patent_title\": \"Automated Medical Report Generation System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2020-11-20\",\n    \"filing_date\": \"2020-11-20\",\n    \"issue_date\": \"2022-07-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for generating medical reports from patient data, reducing administrative burden on healthcare professionals. The system utilizes natural language processing to convert structured data into readable reports.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for automatically generating medical reports...\",\n        \"A method for converting patient data into narrative format...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67709", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the resolution of digital images using a deep convolutional neural network. The system analyzes low-resolution images and reconstructs high-resolution versions with improved clarity and detail, leading to better image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image super-resolution\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising:...\",\n        \"A system for enhancing image resolution comprising:...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67709", "text": "{\n    \"patent_title\": \"Image Format Conversion Tool\",\n    \"inventors\": [\n        {\n            \"name\": \"Eve Wilson\",\n            \"affiliation\": \"XYZ Corp\"\n        },\n        {\n            \"name\": \"Frank Miller\",\n            \"affiliation\": \"XYZ Corp\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-12-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A software tool for converting between various image file formats, such as JPEG, PNG, and TIFF. It supports batch processing and provides options for adjusting compression levels.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A computer-implemented method for converting an image file from a first format to a second format...\",\n        \"A computer program for performing image format conversion...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67710", "text": "{\n    \"patent_title\": \"Enhanced Image Reconstruction for Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-15\",\n    \"issue_date\": \"2023-03-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method for reconstructing images from magnetic resonance imaging (MRI) data. The method incorporates a deep learning algorithm to enhance image clarity and resolution, leading to improved diagnostic capabilities.  It addresses the limitations of existing reconstruction techniques by reducing noise and artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67710", "text": "{\n    \"patent_title\": \"System for Automated Drug Dispensing\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"PharmaCorp Inc.\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"PharmaCorp Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-01-15\",\n    \"filing_date\": \"2022-01-20\",\n    \"issue_date\": \"2023-10-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system for automating the dispensing of pharmaceutical drugs in a hospital setting. It includes a robotic arm, a database of drug information, and a user interface. The system aims to improve efficiency and reduce errors in medication delivery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related to automated pharmacy systems\"\n        }\n    ],\n    \"claims\": [\n        \"A system for dispensing drugs comprising...\",\n        \"A method for controlling a robotic dispensing arm...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67711", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Early Cancer Detection Using Multi-Modal Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for enhanced early cancer detection using multi-modal imaging techniques. By combining MRI and PET scans with advanced algorithms, the system enables earlier and more accurate diagnosis of cancerous tumors, improving patient outcomes. The potential for early diagnosis is greatly enhanced through this combined approach.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8652210B2\",\n            \"title\": \"MRI image reconstruction method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for early cancer detection comprising...\",\n        \"A system for processing multi-modal imaging data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67711", "text": "{\n    \"patent_title\": \"Improved Image Compression for Medical Scans\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-22\",\n    \"filing_date\": \"2017-11-22\",\n    \"issue_date\": \"2019-03-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel image compression algorithm specifically designed for medical imaging data. It achieves higher compression ratios while maintaining acceptable image quality, reducing storage costs and improving transmission speeds. The algorithm is particularly effective for CT scans and X-rays.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Lossless image compression technique\"\n        }\n    ],\n    \"claims\": [\n        \"An image compression algorithm comprising...\",\n        \"A method for reducing the size of medical imaging data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67712", "text": "{\n    \"patent_title\": \"High-Resolution Magnetic Resonance Imaging with Adaptive Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A method and system for generating high-resolution magnetic resonance images (MRI) using adaptive reconstruction techniques. The invention improves image clarity and diagnostic accuracy by reducing noise and artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8789012B2\",\n            \"title\": \"MRI Image Reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating a high-resolution MRI image comprising...\",\n        \"A system for performing MRI with adaptive reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67712", "text": "{\n    \"patent_title\": \"Contrast Enhancement in Computed Tomography\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"EP3876543A1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-09-08\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"The invention relates to a method for enhancing contrast in computed tomography (CT) images. The contrast enhancement allows for better visualization of anatomical structures and pathological conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"CT Image Processing Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing contrast in CT images comprising...\",\n        \"A system for CT imaging with contrast enhancement...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67713", "text": "{\n    \"patent_title\": \"Enhanced Image Reconstruction Method for Low-Dose CT Scanning\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image reconstruction algorithm for computed tomography (CT) scanning that significantly reduces radiation dose while maintaining high image quality. The method utilizes a deep learning approach to denoise and enhance the reconstructed images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Prior Art CT Reconstruction Method\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Deep Learning for Image Denoising\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a CT image comprising...\",\n        \"A system for performing CT scanning...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67713", "text": "{\n    \"patent_title\": \"Novel Contrast Agent for MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new contrast agent designed to enhance the visibility of tumors in magnetic resonance imaging (MRI). The agent exhibits improved biocompatibility and target specificity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"title\": \"Existing MRI Contrast Agent\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent for MRI comprising...\",\n        \"A method for enhancing MRI images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67714", "text": "{\n    \"patent_title\": \"Magnetic Resonance Imaging with Accelerated Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel MRI technique utilizing compressed sensing for significantly faster image reconstruction without compromising image quality. This invention provides a breakthrough in reducing scan times for patients.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"Cited by Examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing magnetic resonance imaging comprising...\",\n        \"An apparatus for performing magnetic resonance imaging comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67714", "text": "{\n    \"patent_title\": \"Improved X-Ray Image Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for enhancing the contrast of X-ray images to improve diagnostic accuracy. The method uses a new filtering algorithm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"kind\": \"Cited by Applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing X-ray images comprising...\",\n        \"A system for enhancing X-ray images comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67715", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Robotic Assistance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10523456B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-08-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel robotic surgical system enabling precise and minimally invasive procedures. The system incorporates advanced imaging and haptic feedback for enhanced surgeon control and improved patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system comprising...\",\n        \"A method for performing a minimally invasive surgical procedure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67715", "text": "{\n    \"patent_title\": \"Improved Catheter Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"St. Jude Medical\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-12-10\",\n    \"filing_date\": \"2014-12-10\",\n    \"issue_date\": \"2018-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design with enhanced flexibility and reduced friction for easier insertion and navigation within blood vessels.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Previous catheter designs\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible shaft...\",\n        \"A method for inserting a catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67716", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-06-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel deep learning architecture for significantly enhancing image resolution.  It surpasses existing methods in perceptual quality and reduces artifacts, representing a substantial advancement in image processing. The system leverages generative adversarial networks (GANs) with a modified loss function to achieve superior results. This offers a paradigm shift in high-resolution image creation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art on image super-resolution.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising...\",\n        \"A system for enhancing image resolution comprising...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The method of claim 1, wherein the deep learning model is a GAN...\",\n        \"The system of claim 2, further comprising a preprocessing module...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67716", "text": "{\n    \"patent_title\": \"Image Compression Technique Using Wavelet Transforms\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-20\",\n    \"issue_date\": \"2021-04-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an efficient image compression technique based on wavelet transforms. It provides improved compression ratios compared to traditional JPEG methods, particularly for medical images.  The method is relatively straightforward and easy to implement.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art on JPEG compression.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image comprising...\",\n        \"An apparatus for compressing an image...\",\n        \"The method of claim 1, wherein the wavelet transform is a Daubechies wavelet...\",\n        \"The apparatus of claim 2, further comprising a quantization module...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67717", "text": "{\n    \"patent_title\": \"Ergonomic Design for Minimally Invasive Surgical Instruments\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Boston Medical Center\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2021-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel ergonomic handle design for minimally invasive surgical instruments. The improved grip and reduced weight significantly enhance surgical precision and reduce hand fatigue for surgeons, thereby improving patient outcomes and surgical efficiency. The design incorporates biofeedback principles to optimize user comfort.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Surgical Instrument Handle\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument handle comprising an ergonomic grip surface.\",\n        \"The handle of claim 1, further comprising a weight reduction feature.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67717", "text": "{\n    \"patent_title\": \"System for Automated Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-12-01\",\n    \"filing_date\": \"2018-12-01\",\n    \"issue_date\": \"2022-01-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A closed-loop system for automated drug delivery based on real-time physiological monitoring. The system uses a microfluidic pump and a biosensor to deliver precise drug dosages in response to patient-specific needs. Focuses on accurate dosage and reduced human error.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Automated Infusion Device\"\n        }\n    ],\n    \"claims\": [\n        \"A drug delivery system comprising a microfluidic pump and a biosensor.\",\n        \"The system of claim 1, further comprising a feedback control loop.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67718", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Enhancement for Low-Light Photography\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-05-15\",\n    \"filing_date\": \"2020-08-20\",\n    \"issue_date\": \"2022-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for enhancing images captured in low-light conditions. The system utilizes a generative adversarial network (GAN) to produce high-quality, visually appealing images with improved details and reduced noise.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Noise Reduction Using Wavelet Transform\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing a low-light image comprising...\",\n        \"A system for image enhancement based on a GAN architecture...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67718", "text": "{\n    \"patent_title\": \"Method for Compressing Digital Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"IBM Research\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for compressing digital images using a modified JPEG algorithm. The method reduces file size while maintaining acceptable image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Improved JPEG Compression Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image using a modified JPEG algorithm...\",\n        \"A system for image compression with reduced file size...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67719", "text": "{\n    \"patent_title\": \"Non-Invasive Medical Imaging Using Ultrasound and Artificial Intelligence\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for non-invasive medical imaging using ultrasound combined with artificial intelligence for improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Ultrasound Imaging System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for non-invasive medical imaging...\",\n        \"An ultrasound imaging system comprising...\",\n        \"A method for diagnosing diseases...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67719", "text": "{\n    \"patent_title\": \"Improved X-Ray Imaging Techniques\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2018-07-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved X-ray imaging technique providing higher resolution images for diagnostic purposes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"X-Ray Imaging Device\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system with enhanced resolution...\",\n        \"A method for obtaining X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67720", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction for Enhanced MRI Diagnostic Accuracy\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-06-15\",\n    \"issue_date\": \"2021-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel image reconstruction algorithm for magnetic resonance imaging (MRI) that significantly improves diagnostic accuracy by reducing noise and artifacts. The algorithm incorporates deep learning techniques to enhance image quality, leading to earlier and more accurate detection of anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in MRI image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67720", "text": "{\n    \"patent_title\": \"New Display Technology for Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-03-10\",\n    \"filing_date\": \"2018-04-10\",\n    \"issue_date\": \"2020-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new display technology that enhances the visualization of medical images, providing improved color accuracy and contrast. The display utilizes a novel OLED panel design.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related art in display technology\"\n        }\n    ],\n    \"claims\": [\n        \"A medical display comprising an OLED panel...\",\n        \"A method for displaying medical images using the display...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67721", "text": "{\n    \"patent_title\": \"Enhanced Image Clarity Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-08-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for enhancing the clarity of digital images using deep convolutional neural networks. The system is applicable to various fields, including medical imaging, surveillance, and photography.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image clarity comprising...\",\n        \"A system for processing digital images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67721", "text": "{\n    \"patent_title\": \"Method for Compressing Vector Graphics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2021-05-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel method for compressing vector graphics data, reducing file sizes and transmission bandwidth. The method is based on a new entropy coding scheme.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing vector graphics comprising...\",\n        \"A system for encoding and decoding vector data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67722", "text": "{\n    \"patent_title\": \"Method and System for Real-Time Image Enhancement Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for real-time image enhancement using deep convolutional neural networks. The system learns to optimize image quality based on perceptual metrics, resulting in visually appealing and enhanced images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"count\": 150\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"count\": 80\n        },\n        {\n            \"patent_number\": \"US9543210B1\",\n            \"count\": 100\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image comprising...\",\n        \"A system for enhancing an image comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67722", "text": "{\n    \"patent_title\": \"Digital Image Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corp\"\n        }\n    ],\n    \"patent_number\": \"US8654321B1\",\n    \"priority_date\": \"2015-05-20\",\n    \"filing_date\": \"2015-05-20\",\n    \"issue_date\": \"2017-11-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image compression algorithm based on wavelet transforms.  This method achieves a higher compression ratio compared to existing techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"count\": 10\n        },\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"count\": 5\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image comprising...\",\n        \"A system for compressing an image comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67723", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Boston Medical Center\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel minimally invasive surgical system integrating high-resolution 3D imaging and robotic assistance. The system aims to enhance surgical precision, reduce patient trauma, and improve post-operative recovery times, potentially revolutionizing surgical procedures for a wide range of conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8652001B2\",\n            \"relevance\": \"Related prior art in robotic surgery.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising a robotic arm...\",\n        \"A 3D imaging module integrated with the robotic arm...\",\n        \"A method for performing minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67723", "text": "{\n    \"patent_title\": \"Improved Catheter Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10245789B1\",\n    \"priority_date\": \"2017-09-01\",\n    \"filing_date\": \"2017-09-01\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a catheter with a modified tip for improved maneuverability within blood vessels. The design offers incremental improvements over existing catheter technology, enhancing its ability to navigate complex vascular structures. \",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"relevance\": \"Previous catheter designs.\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter with a flexible tip...\",\n        \"A method for navigating blood vessels using the catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67724", "text": "{\n    \"patent_title\": \"Method and System for Improving Image Clarity Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"Google Brain\"\n        },\n        {\n            \"name\": \"Ilya Sutskever\",\n            \"affiliation\": \"Google Brain\"\n        }\n    ],\n    \"patent_number\": \"US9876452B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the visual clarity of images using deep convolutional neural networks. The system is trained on a large dataset of images and is capable of removing noise and artifacts, thereby improving the overall quality of the image.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760871B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image clarity comprising...\",\n        \"A system for processing images to improve visual quality...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67724", "text": "{\n    \"patent_title\": \"System and Method for Compressing Digital Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Michael Smith\",\n            \"affiliation\": \"Microsoft Research\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Microsoft Corporation\"\n        }\n    ],\n    \"patent_number\": \"US9987654B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-14\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for efficiently compressing digital images using a wavelet transform and entropy coding. This system reduces file size without significant loss of image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8902345B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image comprising...\",\n        \"A system for reducing the size of digital images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67725", "text": "{\n    \"patent_title\": \"Medical Image Enhancement Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method for enhancing medical images using deep convolutional neural networks. The enhanced images improve the accuracy of medical diagnosis by highlighting subtle features often missed by the human eye. Applications include X-ray, MRI, and CT scan analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing medical images using a convolutional neural network.\",\n        \"A system for assisting medical diagnosis using enhanced images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67725", "text": "{\n    \"patent_title\": \"Digital Image Watermarking Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-09-01\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2021-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel digital image watermarking technique for protecting copyright. The watermark is embedded into the image's frequency domain and is resistant to common image processing operations.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for watermarking digital images.\",\n        \"A system for verifying the authenticity of digital images.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67726", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Sensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-12-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable sensor and associated system for continuous glucose monitoring, providing real-time data transmission and improved patient management for diabetes. This device addresses the need for less invasive and more accurate glucose monitoring.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on implantable sensors\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable glucose sensor comprising...\",\n        \"A system for transmitting glucose data wirelessly...\",\n        \"A method for continuous glucose monitoring using the sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67726", "text": "{\n    \"patent_title\": \"Improved Design for Surgical Staplers\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Johnson & Johnson\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2021-07-01\",\n    \"filing_date\": \"2021-07-01\",\n    \"issue_date\": \"2023-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler design featuring enhanced ergonomics and increased staple firing reliability. This design addresses common issues encountered by surgeons during laparoscopic procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Previous designs of surgical staplers\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler with an improved handle design...\",\n        \"A staple cartridge for use with the stapler...\",\n        \"A method for using the stapler during surgical procedures...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67727", "text": "{\n    \"patent_title\": \"Automated Lung Nodule Detection Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Research\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for automatically detecting lung nodules in CT scans using deep convolutional neural networks. The system is designed to improve the accuracy and efficiency of lung cancer diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting lung nodules...\",\n        \"A system comprising a convolutional neural network...\",\n        \"The method of claim 1, wherein the convolutional neural network is trained on a dataset of CT scans...\",\n        \"The system of claim 2, further comprising a user interface for displaying the detected lung nodules...\",\n        \"The method of claim 3, wherein the dataset is annotated by radiologists...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67727", "text": "{\n    \"patent_title\": \"Real-time Image Enhancement for Mobile Photography\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Apple Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for real-time image enhancement on mobile devices. The system utilizes a combination of algorithms to improve the quality of images captured by a mobile camera.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image...\",\n        \"A mobile device comprising a camera and a processor...\",\n        \"The method of claim 1, wherein the image enhancement includes adjusting brightness and contrast...\",\n        \"The mobile device of claim 2, further comprising a display for viewing the enhanced image...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67728", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the resolution of images using deep convolutional neural networks. The system learns a mapping from low-resolution images to high-resolution images, resulting in improved visual quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"count\": 250\n        },\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"count\": 180\n        },\n        {\n            \"patent_number\": \"US9234567B1\",\n            \"count\": 120\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising...\",\n        \"A system for enhancing image resolution comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67728", "text": "{\n    \"patent_title\": \"Image Compression Technique Utilizing Wavelet Transform\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US7654321B2\",\n    \"priority_date\": \"2017-11-10\",\n    \"filing_date\": \"2017-11-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An image compression technique based on wavelet transform, achieving a reasonable compression ratio with acceptable image quality. Suitable for various image formats.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"count\": 30\n        },\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"count\": 15\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image using wavelet transform comprising...\",\n        \"An image compression system comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67729", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Blood Glucose Sensor\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable sensor for continuous blood glucose monitoring, utilizing a novel enzymatic reaction and wireless data transmission to a smartphone application. This device addresses the unmet need for painless and accurate glucose monitoring for diabetic patients.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8652086B2\"\n        },\n        {\n            \"patent_number\": \"US7500071B2\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable glucose sensor comprising...\",\n        \"A wireless communication module for transmitting glucose data...\",\n        \"A method for continuous glucose monitoring using the sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67729", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler design featuring an ergonomic handle and enhanced staple cartridge loading mechanism. This stapler provides surgeons with greater control and efficiency during surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9125678B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an ergonomic handle...\",\n        \"A staple cartridge loading mechanism...\",\n        \"A method for surgical stapling...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67730", "text": "{\n    \"patent_title\": \"Deep Convolutional Neural Networks for Abstract Image Classification\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-11-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep convolutional neural network architecture for classifying abstract images with high accuracy. The network utilizes attention mechanisms to focus on salient features and achieves state-of-the-art performance on benchmark datasets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in convolutional neural networks\"\n        }\n    ],\n    \"claims\": [\n        \"A method for classifying images using a deep convolutional neural network.\",\n        \"A system comprising a deep convolutional neural network for image classification.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67730", "text": "{\n    \"patent_title\": \"Image Enhancement Technique for Mobile Phones\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Samsung Electronics\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-05-01\",\n    \"filing_date\": \"2019-12-10\",\n    \"issue_date\": \"2021-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A technique for enhancing the quality of images captured by mobile phone cameras. The method utilizes a simple filtering algorithm to improve contrast and reduce noise.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Image filtering algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing images captured by a mobile phone camera.\",\n        \"A mobile phone comprising a system for image enhancement.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67731", "text": "{\n    \"patent_title\": \"Novel Image Enhancement Technique Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel method for enhancing the quality of images using deep convolutional neural networks.  Unlike prior art, this method dynamically adjusts network parameters based on image content, resulting in significant improvements in detail and reduced noise, representing a groundbreaking approach to image enhancement.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on image denoising\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image comprising:...\",\n        \"A system for automatically enhancing image quality...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67731", "text": "{\n    \"patent_title\": \"Improved Color Calibration for Digital Cameras\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Canon Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2016-05-20\",\n    \"filing_date\": \"2016-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details an improved algorithm for color calibration in digital cameras, enhancing color accuracy and consistency. The method involves a new lookup table approach to map sensor readings to standard color spaces. This improves upon existing color correction techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Previous color calibration methods\"\n        }\n    ],\n    \"claims\": [\n        \"A method for calibrating the color of images captured by a digital camera...\",\n        \"A digital camera comprising a color calibration system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67732", "text": "{\n    \"patent_title\": \"Improved Medical Image Reconstruction for Enhanced Diagnostic Accuracy\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing medical images from raw data, resulting in improved image quality and enhanced diagnostic accuracy, particularly for detecting subtle anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"An apparatus for reconstructing a medical image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67732", "text": "{\n    \"patent_title\": \"New Contrast Agent for MRI Scans\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2014-12-01\",\n    \"filing_date\": \"2014-12-01\",\n    \"issue_date\": \"2018-04-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new contrast agent designed to enhance the visibility of specific tissues during MRI scans. The agent exhibits improved biocompatibility and signal amplification.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"A method for enhancing MRI image contrast...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67733", "text": "{\n    \"patent_title\": \"Advanced Beamforming Techniques for 5G Millimeter Wave Systems\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents novel beamforming algorithms for 5G millimeter wave systems, significantly enhancing signal strength and reducing interference. It utilizes machine learning to dynamically optimize beam patterns based on real-time channel conditions, leading to improved data rates and network capacity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on beamforming techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for beamforming in a 5G millimeter wave system...\",\n        \"A device for implementing the beamforming method...\",\n        \"A system utilizing the beamforming method and device...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67733", "text": "{\n    \"patent_title\": \"Improved Antenna Design for Bluetooth Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Smith\",\n            \"affiliation\": \"XYZ Corporation\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2021-05-20\",\n    \"filing_date\": \"2021-05-20\",\n    \"issue_date\": \"2023-02-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel antenna design for Bluetooth devices, resulting in a more compact and efficient antenna. It focuses on miniaturization and cost reduction for mass production.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Previous work on Bluetooth antenna designs\"\n        }\n    ],\n    \"claims\": [\n        \"An antenna for Bluetooth devices with a reduced footprint...\",\n        \"A method for manufacturing the antenna...\",\n        \"A Bluetooth device incorporating the antenna...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67734", "text": "{\n    \"patent_title\": \"Improved MRI Contrast Agent for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-11-15\",\n    \"filing_date\": \"2020-03-01\",\n    \"issue_date\": \"2022-07-26\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A novel MRI contrast agent designed to enhance the detection of early-stage tumors, offering improved sensitivity and specificity compared to existing agents.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B1\",\n            \"relevance\": \"Prior art relating to MRI contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A composition comprising a gadolinium-based contrast agent and a targeting ligand.\",\n        \"A method for detecting tumors using the composition of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67734", "text": "{\n    \"patent_title\": \"Novel X-Ray System for Industrial Inspection\",\n    \"inventors\": [\n        {\n            \"name\": \"Chen Li\",\n            \"affiliation\": \"Tsinghua University\"\n        }\n    ],\n    \"patent_number\": \"CN101234567B\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-06-15\",\n    \"issue_date\": \"2021-12-01\",\n    \"patent_office\": \"China National Intellectual Property Administration\",\n    \"abstract\": \"A new X-ray system for non-destructive testing of materials in industrial applications, providing high-resolution images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B2\",\n            \"relevance\": \"Related to X-ray imaging techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray system comprising an X-ray source, a detector, and a processing unit.\",\n        \"A method for inspecting materials using the X-ray system of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67735", "text": "{\n    \"patent_title\": \"Improved MRI Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-11-20\",\n    \"issue_date\": \"2021-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for reconstructing high-resolution MRI images from undersampled k-space data, leading to improved diagnostic accuracy in detecting subtle anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for improved MRI reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67735", "text": "{\n    \"patent_title\": \"Novel Catheter Design for Vascular Access\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-08-01\",\n    \"filing_date\": \"2019-02-15\",\n    \"issue_date\": \"2020-12-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new catheter design with improved flexibility and reduced trauma during vascular access procedures. The catheter features a novel tip geometry to facilitate navigation through tortuous vessels.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible shaft...\",\n        \"A method of inserting a catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67736", "text": "{\n    \"patent_title\": \"Early Cancer Detection Using Enhanced MRI Techniques\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel magnetic resonance imaging (MRI) techniques for early cancer detection, utilizing contrast agents and image processing algorithms to identify subtle tumor markers. The improved sensitivity and specificity of this method enable detection at earlier stages of disease progression.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Prior art on MRI contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancer comprising...\",\n        \"An MRI system configured to...\",\n        \"A contrast agent for enhancing...\",\n        \"A computer-implemented process for...\",\n        \"A method for visualizing tumor markers...\",\n        \"A diagnostic tool comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67736", "text": "{\n    \"patent_title\": \"Improved Ultrasound Device for Musculoskeletal Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-05-20\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2021-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved ultrasound device for high-resolution imaging of musculoskeletal tissues. The device utilizes advanced signal processing techniques to enhance image clarity and reduce noise. It is particularly useful for diagnosing tendon injuries and muscle strains.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art on ultrasound signal processing\"\n        }\n    ],\n    \"claims\": [\n        \"An ultrasound device comprising...\",\n        \"A signal processing method for...\",\n        \"A transducer for generating...\",\n        \"A system for displaying ultrasound images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67737", "text": "{\n    \"patent_title\": \"Noise Reduction Method for Digital Images using Wavelet Transform\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Adobe Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-11-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for reducing noise in digital images using a wavelet transform. The method decomposes the image into different frequency bands and applies a thresholding function to the wavelet coefficients to remove noise while preserving important image features.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10987654B1\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A method for noise reduction in digital images comprising...\",\n        \"The method of claim 1, wherein the wavelet transform is a Daubechies wavelet.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67737", "text": "{\n    \"patent_title\": \"System and Method for Image Compression using Fractal Geometry\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-09-10\",\n    \"filing_date\": \"2020-09-10\",\n    \"issue_date\": \"2022-07-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel system and method for compressing digital images using fractal geometry. The method partitions the image into range and domain blocks and finds the best fractal code to represent the image.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing digital images comprising...\",\n        \"The method of claim 1, wherein the fractal code is optimized using a genetic algorithm.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67738", "text": "{\n    \"patent_title\": \"Method and System for Super-Resolution Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2021-12-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for reconstructing a high-resolution image from a low-resolution image using a deep convolutional neural network. The network is trained to map low-resolution image patches to high-resolution image patches, enabling significant improvement in image detail and clarity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Enhancement System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a high-resolution image...\",\n        \"A system comprising a deep neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67738", "text": "{\n    \"patent_title\": \"Efficient Image Compression Algorithm Using Wavelet Transform\",\n    \"inventors\": [\n        {\n            \"name\": \"Marc Levoy\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2020-05-20\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An image compression algorithm based on wavelet transformation that reduces image file size while maintaining acceptable image quality. The algorithm utilizes a novel quantization method for improved compression ratios.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Wavelet Based Image Coding\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image using wavelet transform...\",\n        \"A system for encoding image data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67739", "text": "{\n    \"patent_title\": \"Improved MRI Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel deep learning-based method for reconstructing MRI images, resulting in improved image quality and reduced scan time. The method utilizes a convolutional neural network trained on a large dataset of MRI images to accurately reconstruct images from undersampled k-space data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"A system for performing MRI image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67739", "text": "{\n    \"patent_title\": \"Contrast Agent for X-Ray Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2016-05-20\",\n    \"filing_date\": \"2016-05-20\",\n    \"issue_date\": \"2018-01-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel contrast agent for use in X-ray imaging, providing enhanced visibility of blood vessels and soft tissues. The contrast agent comprises a complex of iodine and a biocompatible polymer.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent for X-ray imaging comprising...\",\n        \"A method for enhancing X-ray images using the contrast agent...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67740", "text": "{\n    \"patent_title\": \"Enhanced Image Sharpening via Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Research\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the sharpness of digital images using deep convolutional neural networks. The invention addresses the limitations of traditional image sharpening techniques by learning complex features directly from image data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Adaptive Image Filtering\"\n        }\n    ],\n    \"claims\": [\n        \"A method for sharpening a digital image comprising...\",\n        \"The method of claim 1, wherein the convolutional neural network is trained on a dataset of paired sharp and blurred images.\",\n        \"The method of claim 1, further comprising...\",\n        \"A system for sharpening a digital image comprising...\",\n        \"The system of claim 4, wherein the convolutional neural network is implemented on a graphics processing unit.\",\n        \"A non-transitory computer-readable medium containing...\",\n        \"The method of claim 2, where the data set is augmented with synthetic blur.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67740", "text": "{\n    \"patent_title\": \"Method for Compressing Medical Images Using Wavelet Transform\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Mayo Clinic\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-08-01\",\n    \"filing_date\": \"2019-11-10\",\n    \"issue_date\": \"2021-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for compressing medical images, such as X-rays and MRIs, using a wavelet transform. The invention reduces the storage space required for medical images while maintaining acceptable image quality for diagnostic purposes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Lossless Image Compression Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a medical image comprising...\",\n        \"The method of claim 1, wherein the wavelet transform is a Daubechies wavelet.\",\n        \"The method of claim 1, further comprising quantizing the wavelet coefficients.\",\n        \"A system for compressing a medical image comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67741", "text": "{\n    \"patent_title\": \"Deep Learning Based Image Enhancement System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-09-22\",\n    \"issue_date\": \"2019-04-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing images using deep learning techniques. The system utilizes a convolutional neural network to improve image quality and resolution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Processing using Fourier Transforms\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image using a deep learning model.\",\n        \"A system comprising a convolutional neural network configured to process image data.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67741", "text": "{\n    \"patent_title\": \"Method for Color Correction in Digital Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US9123456B1\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-11-01\",\n    \"issue_date\": \"2018-02-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for adjusting color balance in digital images using a histogram equalization algorithm.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for correcting color imbalances in a digital image.\",\n        \"A system for implementing the color correction method.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67742", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Sensor for Enhanced Patient Comfort During Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-11-20\",\n    \"issue_date\": \"2021-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized wireless sensor system is disclosed for continuous physiological monitoring of patients. The system prioritizes patient comfort through its small size, flexible materials, and low power consumption, while maintaining high accuracy and reliability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor comprising a flexible substrate.\",\n        \"A system for continuous physiological monitoring.\",\n        \"A method for improving patient comfort during monitoring.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67742", "text": "{\n    \"patent_title\": \"Novel Surgical Instrument for Laparoscopic Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2018-12-01\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new surgical instrument designed for enhanced precision and control during laparoscopic surgery. The instrument features a unique articulation mechanism and improved visualization capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising an articulation mechanism.\",\n        \"A laparoscopic system with improved visualization.\",\n        \"A method for performing minimally invasive surgery.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67743", "text": "{\n    \"patent_title\": \"Miniaturized Ultrasound Probe for Non-Invasive Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized ultrasound probe is disclosed, enabling high-resolution imaging for non-invasive cancer detection. The device utilizes advanced signal processing to improve image quality and accuracy, offering a promising alternative to traditional biopsy procedures. It represents an innovative approach to early and accurate diagnostics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on ultrasound imaging techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized ultrasound probe comprising...\",\n        \"A method for non-invasive cancer detection using said probe...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67743", "text": "{\n    \"patent_title\": \"Surgical Robotic System with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-05-10\",\n    \"filing_date\": \"2022-05-10\",\n    \"issue_date\": \"2024-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical robotic system is described, featuring enhanced precision and dexterity for minimally invasive procedures. The system utilizes advanced control algorithms and haptic feedback to improve surgical outcomes. The robot's manipulation arm is designed for complex surgical maneuvers.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art on robotic surgery systems.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic system comprising...\",\n        \"A control method for the robotic system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67744", "text": "{\n    \"patent_title\": \"Wireless Physiological Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-01-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel wireless physiological monitoring system for remote patient care. The system utilizes advanced sensor technology to continuously track vital signs and transmit data securely to healthcare providers, enabling proactive intervention and improved patient outcomes. The system is highly accurate and non-invasive.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless physiological monitoring system comprising...\",\n        \"A method for remotely monitoring a patient's vital signs...\",\n        \"A sensor for continuous data acquisition...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67744", "text": "{\n    \"patent_title\": \"Surgical Instrument for Laparoscopic Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"St. Jude Medical\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Medtronic\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-04-20\",\n    \"issue_date\": \"2021-02-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical instrument for use in minimally invasive laparoscopic procedures. The instrument features a novel articulation mechanism for enhanced maneuverability and precision during surgery. It's designed to reduce trauma and improve patient recovery times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising...\",\n        \"An articulation mechanism for laparoscopic procedures...\",\n        \"A method for performing minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67745", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging Technique for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel magnetic resonance imaging (MRI) technique employing advanced pulse sequences and image reconstruction algorithms to significantly enhance diagnostic accuracy for early-stage cancer detection. The method improves contrast resolution and reduces image noise, leading to more reliable identification of subtle tumor formations.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8652222B2\",\n            \"title\": \"MRI Pulse Sequence Optimization\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI comprising...\",\n        \"An MRI system configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67745", "text": "{\n    \"patent_title\": \"New System for Pharmaceutical Compound Screening\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"Pharmaceutical Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2016-11-01\",\n    \"issue_date\": \"2020-04-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an automated system for high-throughput screening of pharmaceutical compounds to identify potential drug candidates. The system includes robotic handling and advanced data analysis capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Automated Chemical Handling System\"\n        }\n    ],\n    \"claims\": [\n        \"A system for screening pharmaceutical compounds comprising...\",\n        \"A robotic apparatus for...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67746", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Enhancement for Medical Diagnostics\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-12-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for enhancing the quality of medical images, leading to improved diagnostic accuracy. This system leverages generative adversarial networks (GANs) to remove noise and artifacts while preserving crucial image details.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image denoising\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing medical images using a deep learning model.\",\n        \"A system comprising a GAN architecture for image denoising.\",\n        \"A computer-readable medium storing instructions for performing the method.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67746", "text": "{\n    \"patent_title\": \"Method for Compressing Digital Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2019-11-20\",\n    \"filing_date\": \"2019-11-20\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new algorithm for efficiently compressing digital images using wavelet transform techniques.  The method provides high compression ratios while maintaining acceptable image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related to image compression standards\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing digital images using wavelet transforms.\",\n        \"A system for encoding and decoding image data.\",\n        \"A computer-readable medium containing instructions for image compression.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67747", "text": "{\n    \"patent_title\": \"Improved Medical Image Analysis Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing the accuracy of medical image analysis utilizing deep convolutional neural networks. The system is capable of identifying subtle anomalies indicative of disease with higher precision than traditional methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for analyzing a medical image comprising...\",\n        \"A system for medical image analysis comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67747", "text": "{\n    \"patent_title\": \"Novel Apparatus for X-Ray Image Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2013-11-20\",\n    \"filing_date\": \"2013-11-20\",\n    \"issue_date\": \"2018-01-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved X-ray image enhancement apparatus utilizing novel filter techniques to increase image clarity. The apparatus provides a more detailed visualization of anatomical structures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray image enhancement apparatus comprising...\",\n        \"A method for enhancing an X-ray image comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67748", "text": "{\n    \"patent_title\": \"Method and System for Real-Time Object Recognition in Low-Light Conditions\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Intel Corporation\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing object recognition in low-light environments utilizing a novel image processing algorithm and deep learning techniques to improve visibility and accuracy. This addresses challenges in surveillance and autonomous navigation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Enhancement Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing low-light images comprising...\",\n        \"A system for object recognition in low-light environments...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67748", "text": "{\n    \"patent_title\": \"Data Compression Technique for Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2021-05-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel data compression algorithm designed for reducing the storage requirements of medical images, enhancing transmission efficiency, and maintaining diagnostic quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Medical Image Compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing medical image data comprising...\",\n        \"A system for transmitting compressed medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67749", "text": "{\n    \"patent_title\": \"Deep Learning for Automated Detection of Pulmonary Nodules in CT Scans\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2018-03-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep learning system for automated detection of pulmonary nodules in CT scans, improving diagnostic accuracy and reducing radiologist workload. The system uses a convolutional neural network trained on a large dataset of annotated CT images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting pulmonary nodules in CT scans using a deep learning model.\",\n        \"A system comprising a deep learning model and a CT scan image processing module.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67749", "text": "{\n    \"patent_title\": \"Image Compression Technique for Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2017-12-15\",\n    \"issue_date\": \"2019-08-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image compression technique for reducing the storage space required for medical images, while maintaining acceptable image quality. The method utilizes a wavelet transform and entropy encoding.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing medical images using a wavelet transform.\",\n        \"A system for encoding medical images using entropy encoding.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67750", "text": "{\n    \"patent_title\": \"Improved Cardiac Imaging Using Novel Contrast Agents\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-06-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides novel contrast agents for enhanced cardiac imaging, leading to improved detection of coronary artery disease and other cardiovascular conditions. The agents exhibit increased biocompatibility and signal intensity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Existing Cardiac Imaging Technology\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent for cardiac imaging comprising...\",\n        \"A method for detecting coronary artery disease...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67750", "text": "{\n    \"patent_title\": \"Method for Enhanced Ultrasound Image Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2021-05-01\",\n    \"filing_date\": \"2021-08-10\",\n    \"issue_date\": \"2023-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method for enhancing the resolution of ultrasound images using advanced signal processing techniques. It improves visualization of soft tissues, but does not specifically address contrast agents.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Previous Ultrasound Processing Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing ultrasound signals...\",\n        \"An apparatus for improving ultrasound image quality...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67751", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging Technique for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel magnetic resonance imaging (MRI) technique utilizing advanced pulse sequences and image reconstruction algorithms for enhanced early detection of cancerous tumors. This invention significantly improves diagnostic accuracy and reduces false-positive rates.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\"\n        },\n        {\n            \"patent_number\": \"US8987654B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI comprising...\",\n        \"An MRI apparatus configured to...\",\n        \"A system for diagnosing cancer...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67751", "text": "{\n    \"patent_title\": \"Digital Image Compression Method for General Photography\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-11-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel digital image compression algorithm designed for efficient storage and transmission of photographic images. The method utilizes wavelet transforms and entropy coding to achieve high compression ratios with minimal loss of image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a digital image comprising...\",\n        \"A system for encoding and decoding images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67752", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-04-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system incorporating advanced imaging techniques for improved precision and patient outcomes during complex procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in surgical robotics.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising an endoscope and a robotic arm.\",\n        \"A method for performing minimally invasive surgery using the system.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67752", "text": "{\n    \"patent_title\": \"Portable Blood Pressure Monitor\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Eve Davis\",\n            \"affiliation\": \"Independent Researcher\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2021-05-20\",\n    \"filing_date\": \"2021-06-15\",\n    \"issue_date\": \"2023-07-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A compact and portable blood pressure monitoring device for home use. Allows for convenient tracking of cardiovascular health.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"Previous designs for ambulatory blood pressure monitors.\"\n        }\n    ],\n    \"claims\": [\n        \"A portable blood pressure monitor comprising a cuff and a display.\",\n        \"A method for measuring blood pressure using the monitor.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67753", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel approach to medical image reconstruction using deep learning techniques, significantly improving image quality and reducing scan time. The method incorporates a novel loss function...\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8652245B2\",\n            \"title\": \"Medical Imaging System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"A system comprising a scanner and a processing unit...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67753", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9123456B1\",\n    \"priority_date\": \"2015-11-01\",\n    \"filing_date\": \"2015-11-01\",\n    \"issue_date\": \"2016-09-13\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved contrast agent for magnetic resonance imaging, leading to enhanced visualization of blood vessels. The agent utilizes a nanoparticle formulation...\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7545678B2\",\n            \"title\": \"Contrast Agents for MRI\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent for MRI comprising nanoparticles...\",\n        \"A method for enhancing MRI images using the contrast agent...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67754", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Super-Resolution Using Generative Adversarial Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Ming-Hsuan Yang\",\n            \"affiliation\": \"University of California, Los Angeles\"\n        },\n        {\n            \"name\": \"Jun-Yan Zhu\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876453B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2017-05-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention introduces a novel deep learning architecture utilizing generative adversarial networks (GANs) for achieving high-quality image super-resolution. The proposed method overcomes limitations of traditional interpolation-based techniques by learning a complex mapping function between low-resolution and high-resolution image spaces. A perceptual loss function is employed to improve the visual realism of the generated images. The architecture leverages residual learning and batch normalization for stable training and enhanced performance. The model is particularly effective in reconstructing fine details and textures, resulting in significantly improved image quality compared to state-of-the-art methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9454878B2\",\n            \"relevance\": \"Prior art in image upscaling\"\n        }\n    ],\n    \"claims\": [\n        \"A method for super-resolving an image comprising...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67754", "text": "{\n    \"patent_title\": \"Method for Enhancing Contrast in Digital Images\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US8971234B2\",\n    \"priority_date\": \"2014-02-28\",\n    \"filing_date\": \"2014-02-28\",\n    \"issue_date\": \"2015-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method for improving the contrast of digital images by applying a histogram equalization algorithm. The method analyzes the pixel intensity distribution and maps it to a more uniform distribution, enhancing the visibility of details in the image. This is a straightforward technique applicable to a wide range of image types.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for enhancing contrast in a digital image comprising...\",\n        \"A system for implementing the contrast enhancement method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67755", "text": "{\n    \"patent_title\": \"Enhanced Resolution Magnetic Resonance Imaging Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-05-20\",\n    \"issue_date\": \"2021-11-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel magnetic resonance imaging (MRI) technique utilizing advanced signal processing to significantly improve image resolution and clarity. The method enhances visualization of fine anatomical details.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on MRI signal processing.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI image resolution comprising...\",\n        \"An MRI system configured to implement the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67755", "text": "{\n    \"patent_title\": \"Portable X-Ray Device for Veterinary Use\",\n    \"inventors\": [\n        {\n            \"name\": \"David Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-12-10\",\n    \"filing_date\": \"2018-02-15\",\n    \"issue_date\": \"2020-08-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A compact and portable X-ray device designed for veterinary applications. The device allows for rapid image acquisition in field settings.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Prior art on portable X-ray systems.\"\n        }\n    ],\n    \"claims\": [\n        \"A portable X-ray device comprising...\",\n        \"A system for veterinary imaging using the device...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67756", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging with Accelerated Acquisition and Enhanced Resolution\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel magnetic resonance imaging (MRI) technique that utilizes a compressed sensing algorithm and optimized gradient waveforms to significantly reduce scan time while simultaneously improving image resolution. The resulting images exhibit enhanced clarity, enabling more accurate and earlier diagnoses of various medical conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8654321B2\",\n            \"title\": \"MRI with Parallel Imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing magnetic resonance imaging comprising...\",\n        \"An MRI system configured to implement the method...\",\n        \"The method of claim 1, wherein the scan time is reduced by at least 30%.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67756", "text": "{\n    \"patent_title\": \"System for Automated X-Ray Image Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Carlos Rodriguez\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9123456B1\",\n    \"priority_date\": \"2015-11-20\",\n    \"filing_date\": \"2015-11-20\",\n    \"issue_date\": \"2016-09-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for automatically analyzing X-ray images to detect potential anomalies. The system employs image processing techniques to identify areas of interest and flag them for review by a radiologist. It improves the efficiency of the image analysis process.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Computer-Aided Diagnosis System\"\n        }\n    ],\n    \"claims\": [\n        \"A system for analyzing X-ray images comprising...\",\n        \"A method for detecting anomalies in X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67757", "text": "{\n    \"patent_title\": \"Deep Learning Based Image Enhancement for Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-06-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for enhancing the quality of medical images, improving diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing medical images using a convolutional neural network.\",\n        \"A system comprising a deep learning model for image enhancement.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67757", "text": "{\n    \"patent_title\": \"Improved JPEG Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of Texas at Austin\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An incremental improvement to the JPEG compression algorithm, reducing file size by a small percentage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing images using a modified DCT algorithm.\",\n        \"A system for encoding image data with improved compression ratios.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67758", "text": "{\n    \"patent_title\": \"Low-Light Image Enhancement Using Deep Learning and Retinex Theory\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for enhancing low-light images using a deep learning framework combined with Retinex theory. The method effectively separates reflectance and illumination components to improve image visibility and quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image enhancement.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing a low-light image comprising...\",\n        \"A system for processing images in low-light conditions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67758", "text": "{\n    \"patent_title\": \"Color Correction in Digital Cameras\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Kodak\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Eastman Chemical Company\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2021-07-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method for improving the color accuracy of images captured by digital cameras. It involves a novel color correction algorithm that adjusts the color balance to produce more realistic and vibrant images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related to color space transformations.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for color correction in a digital camera...\",\n        \"A system for processing images to improve color accuracy...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67759", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Sepsis Diagnosis\",\n    \"inventors\": [\n        {\n            \"name\": \"James R. Heath\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Manu Prakash\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-11-15\",\n    \"filing_date\": \"2019-05-20\",\n    \"issue_date\": \"2021-03-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device is disclosed for rapid and accurate diagnosis of sepsis by detecting biomarkers in a small blood sample. The device utilizes a novel amplification technique resulting in significant improvement in sensitivity and specificity, representing a groundbreaking advancement in point-of-care diagnostics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for diagnosing sepsis...\",\n        \"A system for automated sepsis detection...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67759", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Peripheral IV Access\",\n    \"inventors\": [\n        {\n            \"name\": \"Maria Lopez\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2017-08-10\",\n    \"filing_date\": \"2018-12-05\",\n    \"issue_date\": \"2019-12-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design is presented, enhancing ease of insertion and reducing patient discomfort during peripheral intravenous access. The catheter features a rounded tip and a smoother coating.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a rounded tip...\",\n        \"A method for inserting a catheter...\",\n        \"A coating for a catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67760", "text": "{\n    \"patent_title\": \"Patient-Comfortable Implantable Medical Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2014-03-15\",\n    \"filing_date\": \"2015-05-20\",\n    \"issue_date\": \"2018-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable medical device designed for enhanced patient comfort through biocompatible materials and a novel ergonomic design.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A biocompatible implantable medical device comprising...\",\n        \"The device of claim 1, further comprising...\",\n        \"A method for implanting the device...\",\n        \"The method of claim 3, wherein...\",\n        \"The device of claim 1, configured for minimal patient discomfort.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67760", "text": "{\n    \"patent_title\": \"Surgical Instrument with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Johns Hopkins University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2014-11-01\",\n    \"filing_date\": \"2015-02-15\",\n    \"issue_date\": \"2017-05-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical instrument designed for increased precision during minimally invasive procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising...\",\n        \"The instrument of claim 1, further comprising...\",\n        \"A method for using the instrument...\",\n        \"The method of claim 3, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67761", "text": "{\n    \"patent_title\": \"Implantable Cardiac Monitor with Remote Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Medtronic Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac monitor capable of continuously monitoring cardiac rhythm and transmitting data wirelessly to a remote monitoring station. The device utilizes advanced algorithms to detect arrhythmias and alerts medical personnel to potential life-threatening events. Designed to improve early detection of cardiovascular issues and reduce hospital readmissions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"relevance\": \"Prior art relating to wireless telemetry\"\n        }\n    ],\n    \"claims\": [\n        \"A method for remotely monitoring cardiac rhythm...\",\n        \"An implantable device comprising a sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67761", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical stapler designed to improve surgical precision and reduce surgeon fatigue. The device features an ergonomic handle and enhanced visualization capabilities. It is applicable in a broad range of surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art relating to surgical staplers\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an ergonomic handle...\",\n        \"A method for performing surgical anastomosis...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67762", "text": "{\n    \"patent_title\": \"Ultrasound Beamforming with Adaptive Focusing for Enhanced Image Resolution\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Philips Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for ultrasound beamforming utilizing adaptive focusing algorithms to enhance image resolution and reduce artifacts. This technology aims to provide clearer diagnostic images and improve patient care.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in beamforming techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for ultrasound beamforming comprising...\",\n        \"A system for generating ultrasound images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67762", "text": "{\n    \"patent_title\": \"High-Field MRI Coil Design for Improved Signal-to-Noise Ratio\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"GE Healthcare\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved high-field MRI coil design that significantly enhances the signal-to-noise ratio, enabling higher resolution MRI images and faster scan times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Previous coil designs\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil comprising...\",\n        \"A method for improving signal-to-noise ratio...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67763", "text": "{\n    \"patent_title\": \"Deep Learning-Based Object Detection for Autonomous Driving\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"US Patent and Trademark Office\",\n    \"abstract\": \"A system and method for real-time object detection in autonomous vehicles using deep convolutional neural networks. The system is trained to identify pedestrians, vehicles, traffic signs, and other obstacles with high accuracy and low latency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for object detection in an autonomous vehicle comprising...\",\n        \"A method for training a deep neural network for object detection...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67763", "text": "{\n    \"patent_title\": \"Method for Enhancing Image Contrast in Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2021-01-20\",\n    \"filing_date\": \"2021-01-20\",\n    \"issue_date\": \"2023-11-10\",\n    \"patent_office\": \"US Patent and Trademark Office\",\n    \"abstract\": \"A novel method for improving the visibility of details in medical images by adjusting contrast levels and applying image filtering techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image contrast comprising...\",\n        \"An apparatus for processing medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67764", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Medical Device Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system comprising a small diameter endoscope with integrated optical coherence tomography (OCT) for real-time tissue characterization and a robotic manipulator for precise instrument control. This system addresses the unmet clinical need for improved visualization and precision in delicate surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Endoscopic Imaging System\"\n        }\n    ],\n    \"claims\": [\n        \"A minimally invasive surgical system comprising...\",\n        \"An endoscope with integrated OCT...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67764", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"PharmaCorp Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-15\",\n    \"issue_date\": \"2022-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design for targeted drug delivery, featuring a flexible tip and enhanced flow control. This catheter is designed for efficient delivery of therapeutic agents to specific anatomical locations.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Catheter with Flexible Tip\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible tip...\",\n        \"A drug delivery system using the catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67765", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"David Utley\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Maria Rodriguez\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-11-15\",\n    \"filing_date\": \"2019-05-20\",\n    \"issue_date\": \"2021-03-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system incorporating advanced imaging techniques and robotic assistance to improve surgical precision and reduce patient recovery time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising a robotic arm and an endoscopic camera.\",\n        \"A method for performing minimally invasive surgery using the surgical system.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67765", "text": "{\n    \"patent_title\": \"Orthopedic Implant Design\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2017-09-01\",\n    \"filing_date\": \"2018-03-10\",\n    \"issue_date\": \"2022-01-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved design for a hip implant, enhancing stability and longevity within the human body.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"An orthopedic implant made of titanium alloy.\",\n        \"A method for implanting the orthopedic implant.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67766", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Super-Resolution with Enhanced Detail\",\n    \"inventors\": [\n        {\n            \"name\": \"Li Wei\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Chen Zhang\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2019-10-26\",\n    \"filing_date\": \"2020-05-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for image super-resolution is presented, significantly improving image detail and reducing artifacts compared to existing methods. The network utilizes a generative adversarial network (GAN) with a perceptual loss function to achieve high-quality results.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image upscaling\"\n        }\n    ],\n    \"claims\": [\n        \"A method for super-resolving an image comprising...\",\n        \"A deep learning model configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67766", "text": "{\n    \"patent_title\": \"Improved Color Correction Algorithm for Digital Cameras\",\n    \"inventors\": [\n        {\n            \"name\": \"Maria Rodriguez\",\n            \"affiliation\": \"Canon Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-07-22\",\n    \"issue_date\": \"2021-04-13\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved color correction algorithm for digital cameras, achieving more accurate and vibrant colors in photographs. It enhances existing color processing techniques with a new lookup table approach.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Existing color correction techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for correcting color in a digital image comprising...\",\n        \"A digital camera utilizing the color correction method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67767", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging Technique for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-06-20\",\n    \"issue_date\": \"2021-12-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel MRI technique utilizing advanced pulse sequences and image reconstruction algorithms for enhanced detection of early-stage cancerous tumors. This technology improves image clarity and reduces false positives.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"MRI Pulse Sequence Optimization\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Image Reconstruction Algorithm for MRI\"\n        },\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Contrast Agent for Tumor Imaging\"\n        },\n        {\n            \"patent_number\": \"US6543210B2\",\n            \"title\": \"Data Processing Method for Medical Images\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI comprising...\",\n        \"An MRI apparatus comprising...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67767", "text": "{\n    \"patent_title\": \"Digital X-Ray Image Enhancement System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-05-10\",\n    \"filing_date\": \"2018-08-15\",\n    \"issue_date\": \"2020-04-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for enhancing the quality of digital x-ray images through noise reduction and contrast adjustment algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"X-Ray Image Filtering\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Digital Image Processing Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A system for enhancing x-ray images...\",\n        \"A method for filtering x-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67768", "text": "{\n    \"patent_title\": \"Enhanced Medical Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning-based method for reconstructing medical images from limited data, significantly improving image quality and diagnostic accuracy. The system is trained on a large dataset of CT scans and MRI images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"A system for processing medical image data...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67768", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Angiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MedTech Solutions Inc.\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"MedTech Solutions Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-01\",\n    \"issue_date\": \"2023-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel catheter design for angiography procedures, featuring a flexible tip and improved biocompatibility. This catheter allows for easier navigation through blood vessels.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible tip...\",\n        \"A method for performing angiography using the catheter...\",\n        \"A biocompatible coating for the catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67769", "text": "{\n    \"patent_title\": \"Miniature Implantable Cardiac Monitor with Wireless Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Medtronic Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-02-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature implantable cardiac monitor provides real-time data transmission wirelessly to an external receiver. The device includes a low-power sensor and communication module for long-term monitoring of cardiac activity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Highly relevant - prior art in implantable devices\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related - wireless communication technology\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Background - cardiac monitoring systems\"\n        },\n        {\n            \"patent_number\": \"US20100001234A1\",\n            \"relevance\": \"Relevant - power management techniques\"\n        },\n        {\n            \"patent_number\": \"US20120012345A1\",\n            \"relevance\": \"Related - data processing algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"A miniature implantable cardiac monitor comprising...\",\n        \"A wireless communication module for transmitting data...\",\n        \"A method for monitoring cardiac activity using the monitor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67769", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Peripheral Angioplasty\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Boston Scientific\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Boston Scientific\"\n        }\n    ],\n    \"patent_number\": \"US9234567B1\",\n    \"priority_date\": \"2014-12-10\",\n    \"filing_date\": \"2014-12-10\",\n    \"issue_date\": \"2016-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design for performing peripheral angioplasty. The catheter features a flexible tip and enhanced maneuverability for navigating tortuous vessels.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"relevance\": \"Relevant - catheter design\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Background - angioplasty procedures\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter for peripheral angioplasty comprising...\",\n        \"A flexible tip for navigating vessels...\",\n        \"A method for performing angioplasty using the catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67770", "text": "{\n    \"patent_title\": \"Miniature Implantable Device for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-06-20\",\n    \"issue_date\": \"2021-02-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature implantable glucose monitoring device with improved biocompatibility and accuracy for continuous glucose level tracking, enhancing diabetes management and patient health outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on implantable sensors\"\n        }\n    ],\n    \"claims\": [\n        \"A glucose monitoring device comprising...\",\n        \"A method for continuously monitoring glucose levels...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67770", "text": "{\n    \"patent_title\": \"Surgical Instrument for Bone Cutting\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Diana Garcia\",\n            \"affiliation\": \"Boston University\"\n        }\n    ],\n    \"patent_number\": \"US11123456B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-02-10\",\n    \"issue_date\": \"2022-05-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical instrument with a novel cutting mechanism for precise bone manipulation during orthopedic procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related to bone cutting technology\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument including...\",\n        \"A cutting mechanism characterized by...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67771", "text": "{\n    \"patent_title\": \"Novel MRI Technique for Enhanced Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel magnetic resonance imaging (MRI) technique utilizing pulse sequence optimization and advanced image reconstruction algorithms for significantly improved detection of small tumors. The method allows for earlier cancer diagnosis and more effective treatment planning.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8540876B2\"\n        },\n        {\n            \"patent_number\": \"US9216345B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for MRI imaging comprising...\",\n        \"An MRI system configured to perform...\",\n        \"A computer-implemented method for tumor detection...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67771", "text": "{\n    \"patent_title\": \"Improved X-ray Shielding for Dental Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"John Davis\",\n            \"affiliation\": \"Dental Imaging Corp.\"\n        },\n        {\n            \"name\": \"Emily Wilson\",\n            \"affiliation\": \"Dental Imaging Corp.\"\n        }\n    ],\n    \"patent_number\": \"US10456789B1\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved shielding material for dental X-ray machines, reducing radiation exposure to patients and operators. The shielding utilizes a composite material with enhanced lead absorption properties.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\"\n        }\n    ],\n    \"claims\": [\n        \"A shielding apparatus for dental X-ray machines...\",\n        \"A composite material comprising...\",\n        \"A method for reducing radiation exposure...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67772", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel minimally invasive surgical system incorporating advanced imaging and robotic control to improve surgical precision and patient outcomes. The system reduces incision size and minimizes tissue trauma, leading to faster recovery times and increased patient comfort.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on robotic surgical systems\"\n        }\n    ],\n    \"claims\": [\n        \"A minimally invasive surgical system comprising...\",\n        \"A method for performing surgery using the surgical system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67772", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Jones\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-11-15\",\n    \"filing_date\": \"2020-11-15\",\n    \"issue_date\": \"2022-08-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new catheter design incorporating a microfluidic channel for targeted drug delivery. The catheter enhances drug efficacy and reduces systemic side effects.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Existing catheter designs for intravenous drug delivery\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a microfluidic channel...\",\n        \"A method for delivering drugs using the catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67773", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction for Enhanced Diagnostic MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Chen\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel image reconstruction algorithm for Magnetic Resonance Imaging (MRI) that significantly reduces noise and artifacts, leading to improved diagnostic accuracy in identifying subtle tissue abnormalities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"An MRI system configured to perform the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67773", "text": "{\n    \"patent_title\": \"System for Automated Dental X-Ray Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Miller\",\n            \"affiliation\": \"Dental Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2022-08-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system for automated analysis of dental X-ray images, identifying cavities and other dental anomalies with high precision.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for analyzing dental X-ray images...\",\n        \"A method for detecting cavities...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67774", "text": "{\n    \"patent_title\": \"Real-Time Image Enhancement System for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for real-time image enhancement on mobile devices utilizing a novel convolutional neural network architecture. The system enables improved image quality in low-light conditions and provides faster processing speeds for real-time applications like video conferencing and augmented reality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"kind\": \"cited_by\"\n        }\n    ],\n    \"claims\": [\n        \"A method for real-time image enhancement comprising...\",\n        \"An apparatus for performing real-time image enhancement...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67774", "text": "{\n    \"patent_title\": \"Image Compression Technique for Satellite Imagery\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"NASA\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"NASA\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image compression technique specifically designed for high-resolution satellite imagery.  The technique utilizes wavelet transforms and entropy coding to achieve high compression ratios while preserving image detail. It's suitable for archiving and transmission of large datasets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US12345678B2\",\n            \"kind\": \"cites\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing satellite images comprising...\",\n        \"A system for archiving compressed satellite images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67775", "text": "{\n    \"patent_title\": \"High-Resolution Optical Coherence Tomography System with Adaptive Optics\",\n    \"inventors\": [\n        {\n            \"name\": \"David Boas\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Arjun Yodh\",\n            \"affiliation\": \"University of Pennsylvania\"\n        }\n    ],\n    \"patent_number\": \"US10543025B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2019-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A high-resolution optical coherence tomography (OCT) system incorporating adaptive optics for improved image quality in biological tissues. The system corrects for aberrations in the tissue, resulting in significantly sharper and more detailed images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8562489B2\",\n            \"title\": \"Adaptive optics system and method\"\n        },\n        {\n            \"patent_number\": \"US9235392B2\",\n            \"title\": \"Optical coherence tomography system with motion correction\"\n        },\n        {\n            \"patent_number\": \"US9897544B2\",\n            \"title\": \"Enhanced image processing for optical coherence tomography\"\n        },\n        {\n            \"patent_number\": \"US10125861B2\",\n            \"title\": \"Wide-field optical coherence tomography\"\n        }\n    ],\n    \"claims\": [\n        \"A system for performing optical coherence tomography, comprising...\",\n        \"The system of claim 1, further comprising...\",\n        \"A method for imaging a biological tissue using optical coherence tomography...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67775", "text": "{\n    \"patent_title\": \"Method for Detecting Cancer Biomarkers using Nanoparticles\",\n    \"inventors\": [\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2019-05-20\",\n    \"filing_date\": \"2019-05-20\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for detecting cancer biomarkers in a sample using functionalized nanoparticles. The nanoparticles bind to the biomarkers, allowing for their detection using a fluorescence assay.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Nanoparticle-based biosensor\"\n        },\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"title\": \"Fluorescence detection method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancer biomarkers, comprising...\",\n        \"The method of claim 1, wherein the nanoparticles are...\",\n        \"A composition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67776", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for Magnetic Resonance Angiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-10-26\",\n    \"filing_date\": \"2019-04-15\",\n    \"issue_date\": \"2021-03-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel contrast agent for magnetic resonance angiography (MRA) exhibiting improved signal enhancement and reduced toxicity, leading to more accurate vascular imaging and improved diagnostic capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Conventional MRA Contrast Agents\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent for MRA comprising...\",\n        \"A method for enhancing vascular imaging using the contrast agent...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67776", "text": "{\n    \"patent_title\": \"System for Automated X-Ray Image Archiving\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2017-05-12\",\n    \"filing_date\": \"2018-11-01\",\n    \"issue_date\": \"2020-01-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for archiving and retrieving X-ray images using a cloud-based storage solution, improving efficiency in radiology departments.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Traditional X-Ray Archiving Methods\"\n        }\n    ],\n    \"claims\": [\n        \"A system for archiving X-ray images comprising...\",\n        \"A method for retrieving archived X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67777", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Early Cancer Detection Using Multi-Modal Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2015-03-15\",\n    \"filing_date\": \"2015-03-15\",\n    \"issue_date\": \"2020-01-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for early cancer detection using a combination of MRI and PET imaging techniques. The system utilizes advanced image processing algorithms to enhance diagnostic accuracy and identify subtle indicators of cancer at early stages.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in MRI imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A method for early cancer detection comprising...\",\n        \"A system for processing multi-modal images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67777", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging Coil Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2016-05-20\",\n    \"filing_date\": \"2016-05-20\",\n    \"issue_date\": \"2018-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved design for magnetic resonance imaging coils, increasing signal-to-noise ratio and image quality. The coil design reduces energy consumption and enhances patient comfort.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Previous coil designs\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil comprising...\",\n        \"A method for manufacturing an MRI coil...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67778", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Sensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2014-03-15\",\n    \"filing_date\": \"2015-05-20\",\n    \"issue_date\": \"2018-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable sensor for continuous glucose monitoring, providing real-time data for improved diabetes management and patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B1\",\n            \"relevance\": \"Prior art in glucose sensor technology\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized glucose sensor comprising...\",\n        \"A method for continuous glucose monitoring using said sensor...\",\n        \"A system for data transmission and analysis...\",\n        \"A method for alerting patients to abnormal glucose levels...\",\n        \"A device for automated insulin delivery based on sensor readings...\",\n        \"A biocompatible coating for the sensor...\",\n        \"A power management system for the sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67778", "text": "{\n    \"patent_title\": \"Surgical Stapler with Enhanced Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Johnson & Johnson\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Ethicon\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2014-11-01\",\n    \"filing_date\": \"2016-02-10\",\n    \"issue_date\": \"2019-08-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler with enhanced ergonomic design for increased surgeon comfort and precision during surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art in surgical stapler design\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"A handle with ergonomic features...\",\n        \"A staple cartridge...\",\n        \"A firing mechanism...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67779", "text": "{\n    \"patent_title\": \"Contrast-Enhanced Medical Imaging Using Targeted Nanoparticles\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel system and method for enhancing medical imaging using targeted nanoparticles containing contrast agents. The nanoparticles are designed to selectively bind to tumor cells, improving image clarity and diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Contrast Agents for MRI\"\n        },\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"title\": \"Targeted Drug Delivery Systems\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing medical imaging comprising...\",\n        \"A nanoparticle for targeted delivery of contrast agents...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67779", "text": "{\n    \"patent_title\": \"Improved X-Ray Tube Design for Reduced Radiation Exposure\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2014-12-10\",\n    \"filing_date\": \"2014-12-10\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A redesigned X-ray tube that minimizes radiation exposure to patients while maintaining image quality. The invention incorporates improved shielding and cooling mechanisms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"title\": \"X-Ray Tube Cooling Systems\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube comprising...\",\n        \"A method for reducing radiation exposure during X-ray imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67780", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Enhancement for Improved Medical Diagnosis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10245789B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing medical images using deep learning techniques to improve diagnostic accuracy and reduce false positives. The invention focuses on identifying subtle patterns indicative of disease.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image segmentation\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing a medical image comprising...\",\n        \"A system for diagnosing a disease based on an enhanced medical image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67780", "text": "{\n    \"patent_title\": \"Method for Compressing Digital Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10567890B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2020-12-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel algorithm for compressing digital images with minimal loss of quality. This invention significantly reduces storage space required for image data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"relevance\": \"JPEG compression standard\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a digital image comprising...\",\n        \"A system for storing compressed image data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67781", "text": "{\n    \"patent_title\": \"Miniature Implantable Pressure Sensor for Glaucoma Management\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-12-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature, wirelessly powered pressure sensor is disclosed for continuous intraocular pressure monitoring. The sensor is fully implantable and transmits data via near-field communication.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        },\n        {\n            \"patent_number\": \"US11000001B2\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\"\n        },\n        {\n            \"patent_number\": \"US9654321B2\"\n        },\n        {\n            \"patent_number\": \"US10876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A miniature implantable pressure sensor comprising...\",\n        \"A system for wirelessly transmitting pressure data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67781", "text": "{\n    \"patent_title\": \"Improved Syringe Design for Subcutaneous Injections\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Baxter Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11567890B2\",\n    \"priority_date\": \"2019-11-20\",\n    \"filing_date\": \"2020-07-01\",\n    \"issue_date\": \"2022-04-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved syringe design with a reduced dead volume and ergonomic grip is disclosed, improving medication delivery accuracy and patient comfort.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        },\n        {\n            \"patent_number\": \"US10234567B2\"\n        }\n    ],\n    \"claims\": [\n        \"A syringe comprising a barrel and a plunger...\",\n        \"An ergonomic grip for improved handling...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67782", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the resolution of digital images using a deep convolutional neural network. The system learns to map low-resolution images to high-resolution images, improving visual quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8780556B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising...\",\n        \"A system for processing images to improve quality...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67782", "text": "{\n    \"patent_title\": \"System for Automated Plant Disease Detection Using Image Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lobell\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Elena Rodriguez\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234987B1\",\n    \"priority_date\": \"2016-11-20\",\n    \"filing_date\": \"2016-11-20\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for automatically detecting diseases in plants using image analysis techniques. The system analyzes images of plant leaves to identify symptoms of disease.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for detecting plant disease comprising...\",\n        \"A method for analyzing plant images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67783", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Early Cancer Detection Using Multi-Modal Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for improving early cancer detection using the combined analysis of PET and MRI images. The system employs machine learning algorithms to identify subtle anomalies indicative of early-stage tumors.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8234567B1\",\n            \"title\": \"Medical Image Analysis System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for early cancer detection comprising: acquiring PET and MRI images...\",\n        \"A system for analyzing medical images…\"\n    ]\n}"}
{"_id": "Academic--patents--n--67783", "text": "{\n    \"patent_title\": \"Improved Contrast Agents for Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10456789B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-02-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"Novel contrast agents for MRI with enhanced signal intensity and improved biocompatibility. These agents provide clearer images for diagnostic purposes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"MRI Contrast Agents\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent for MRI comprising a gadolinium complex...\",\n        \"A method for enhancing MRI image contrast…\"\n    ]\n}"}
{"_id": "Academic--patents--p--67784", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10789456B2\",\n    \"priority_date\": \"2018-11-15\",\n    \"filing_date\": \"2019-03-22\",\n    \"issue_date\": \"2020-09-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for reconstructing medical images from raw data, utilizing a deep learning algorithm to reduce noise and enhance resolution, leading to improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in image reconstruction.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"A system comprising a processor...\",\n        \"The method of claim 1, wherein the deep learning algorithm...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67784", "text": "{\n    \"patent_title\": \"Apparatus for Displaying Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2020-01-17\",\n    \"issue_date\": \"2021-04-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved display apparatus for visualizing medical images, providing enhanced color rendering and adjustable brightness. Does not involve image reconstruction itself.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related to display technologies.\"\n        }\n    ],\n    \"claims\": [\n        \"An apparatus for displaying a medical image...\",\n        \"The apparatus of claim 1, further comprising...\",\n        \"A method for adjusting the brightness...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67785", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for Magnetic Resonance Angiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-11-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel contrast agent for magnetic resonance angiography (MRA) providing enhanced image clarity and reduced toxicity. The agent utilizes biocompatible nanoparticles with improved targeting capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising biocompatible nanoparticles...\",\n        \"A method for performing magnetic resonance angiography using the contrast agent...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67785", "text": "{\n    \"patent_title\": \"New Packaging Design for Pharmaceuticals\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Pharmaceutical Corp.\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2020-04-01\",\n    \"filing_date\": \"2020-06-10\",\n    \"issue_date\": \"2021-12-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel packaging design for pharmaceutical products, enhancing shelf life and ease of use. The design incorporates a tamper-evident seal and improved labeling.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"similar packaging\"\n        }\n    ],\n    \"claims\": [\n        \"A packaging container comprising a tamper-evident seal...\",\n        \"A pharmaceutical package including the container...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67786", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction for Enhanced Diagnostic Accuracy in MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"David A. Levin\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University Medical Center\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2023-11-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel image reconstruction algorithm for Magnetic Resonance Imaging (MRI) that significantly improves image clarity and diagnostic accuracy, particularly in detecting subtle anomalies. The algorithm utilizes a deep learning approach to reduce noise and enhance resolution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"MRI Image Enhancement\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"An MRI system configured to utilize the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67786", "text": "{\n    \"patent_title\": \"Enhanced Algorithm for Satellite Image Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2024-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an algorithm for enhancing the resolution and clarity of satellite images, providing improved data for environmental monitoring and urban planning. The algorithm utilizes wavelet transformation techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Satellite Image Analysis\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing satellite images comprising...\",\n        \"A system for analyzing satellite imagery using the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67787", "text": "{\n    \"patent_title\": \"Method and System for Adaptive Image Enhancement Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for adaptively enhancing images using a deep convolutional neural network. The network is trained to map low-quality images to high-quality images, improving visual fidelity and reducing artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image comprising...\",\n        \"A system for enhancing an image comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67787", "text": "{\n    \"patent_title\": \"Data Compression Technique for Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"David Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2013-11-20\",\n    \"filing_date\": \"2013-11-20\",\n    \"issue_date\": \"2017-09-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel data compression algorithm for efficiently storing and transmitting medical images. The method minimizes data loss while reducing file size.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a medical image comprising...\",\n        \"A system for compressing a medical image comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67788", "text": "{\n    \"patent_title\": \"Method and System for Robust Image Enhancement Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Mark Chen\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Li Wei\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-12-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing image quality, particularly in low-light or noisy environments, using a deep convolutional neural network. The network is trained to remove noise and artifacts while preserving important image details.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image comprising...\",\n        \"A system for enhancing an image comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67788", "text": "{\n    \"patent_title\": \"Improved Algorithm for Image Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new image compression algorithm that achieves higher compression ratios with minimal loss of image quality. The algorithm utilizes wavelet transform and entropy encoding techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image comprising...\",\n        \"A system for compressing an image comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67789", "text": "{\n    \"patent_title\": \"Deep Convolutional Neural Networks for Image Super-Resolution\",\n    \"inventors\": [\n        {\n            \"name\": \"Chuanjian Li\",\n            \"affiliation\": \"Microsoft Research\"\n        },\n        {\n            \"name\": \"Xiaohui Shen\",\n            \"affiliation\": \"Microsoft Research\"\n        },\n        {\n            \"name\": \"Yu-Wing Tai\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"patent_number\": \"US9972836B2\",\n    \"priority_date\": \"2016-03-08\",\n    \"filing_date\": \"2016-03-08\",\n    \"issue_date\": \"2019-05-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides techniques for performing single image super-resolution using deep convolutional neural networks. The networks are trained to map low-resolution images to high-resolution images, improving image quality and detail.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8896324B2\"\n        },\n        {\n            \"patent_number\": \"US9424774B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for super-resolving an image, comprising: training a deep convolutional neural network on a dataset of paired low-resolution and high-resolution images; and applying the trained network to a low-resolution image to generate a high-resolution image.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67789", "text": "{\n    \"patent_title\": \"Method and System for Image Format Conversion\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US8542567B2\",\n    \"priority_date\": \"2012-10-26\",\n    \"filing_date\": \"2012-10-26\",\n    \"issue_date\": \"2013-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for converting images between different file formats. This allows for compatibility across various platforms and devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7679611B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for converting an image from a first format to a second format, comprising: a processing unit configured to receive an image in the first format; and a conversion module configured to convert the image to the second format.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67790", "text": "{\n    \"patent_title\": \"High-Resolution Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for reconstructing high-resolution images from low-resolution inputs is presented. The system significantly improves image quality and resolves fine details, enhancing visual perception. Applications include medical imaging and satellite imagery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Super-Resolution via Deep Convolutional Networks\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a high-resolution image from a low-resolution image...\",\n        \"A deep learning model configured to improve image resolution...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67790", "text": "{\n    \"patent_title\": \"Method for Compressing Digital Audio Signals\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-01-10\",\n    \"issue_date\": \"2023-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new algorithm for compressing digital audio signals is described. This method significantly reduces file size while maintaining acceptable audio quality. It is suitable for streaming and storage applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Digital Audio Compression Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a digital audio signal...\",\n        \"An audio compression algorithm...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67791", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-06-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable biosensor for continuous glucose monitoring utilizing nanotechnology to enhance sensitivity and accuracy. This device significantly improves patient compliance and management of diabetes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in glucose monitoring\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable biosensor...\",\n        \"A method for continuous glucose monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67791", "text": "{\n    \"patent_title\": \"Improved Syringe Design for Medication Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Baxter Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-15\",\n    \"issue_date\": \"2022-05-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved syringe design incorporating a spring-loaded plunger for more accurate and consistent medication delivery. The syringe features ergonomic enhancements for ease of use.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous syringe designs\"\n        }\n    ],\n    \"claims\": [\n        \"A syringe comprising a spring-loaded plunger...\",\n        \"A method of administering medication using the syringe...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67792", "text": "{\n    \"patent_title\": \"Method and System for Real-Time Image Enhancement in Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-01-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing images captured by mobile devices in real-time. The system utilizes a combination of noise reduction, contrast adjustment, and color correction algorithms to improve image quality under various lighting conditions. The method is designed for low-power consumption and efficient processing on mobile platforms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Processing System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image comprising...\",\n        \"A system for real-time image enhancement...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67792", "text": "{\n    \"patent_title\": \"A Novel Theoretical Framework for Wavelet Transform-Based Image Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2020-02-20\",\n    \"filing_date\": \"2020-05-15\",\n    \"issue_date\": \"2022-04-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This patent describes a novel theoretical framework for image compression using wavelet transforms. It introduces a new mathematical model for analyzing and optimizing wavelet-based compression algorithms, focusing on achieving optimal compression ratios while preserving image fidelity. The framework is primarily intended for research purposes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Wavelet-Based Image Coding\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image using wavelet transforms...\",\n        \"A theoretical framework for optimizing wavelet compression...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67793", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a minimally invasive surgical system designed with improved ergonomics and a user-friendly interface. The system incorporates features to enhance surgical precision while minimizing strain on the surgeon, resulting in improved patient outcomes and a better patient experience.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\",\n            \"relevance\": \"Prior art in minimally invasive surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising an ergonomic handle...\",\n        \"A user interface for controlling the surgical instrument...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67793", "text": "{\n    \"patent_title\": \"Novel Chemical Compound for Cancer Treatment\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2019-12-01\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2023-04-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel chemical compound demonstrating promising results in cancer treatment. The compound exhibits high selectivity for tumor cells and minimal toxicity to healthy cells.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"relevance\": \"Previous work on cancer therapeutics\"\n        }\n    ],\n    \"claims\": [\n        \"A chemical compound with the formula...\",\n        \"A method of treating cancer using the compound...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67794", "text": "{\n    \"patent_title\": \"Enhanced Medical Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2020-06-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing medical images using deep learning techniques to reduce noise and enhance image clarity, leading to improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image denoising.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for enhancing the clarity of medical images...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67794", "text": "{\n    \"patent_title\": \"System for Automated Medical Report Generation\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Mayo Clinic\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2018-11-01\",\n    \"issue_date\": \"2021-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for automatically generating medical reports from patient data, including diagnosis and treatment recommendations. This system reduces physician workload and improves reporting efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"Prior art in natural language processing.\"\n        }\n    ],\n    \"claims\": [\n        \"A system for generating medical reports comprising...\",\n        \"A method for analyzing patient data...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67795", "text": "{\n    \"patent_title\": \"Non-Invasive Continuous Blood Pressure Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-11-20\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive system for continuous blood pressure monitoring using photoplethysmography and advanced signal processing algorithms. This system provides real-time, accurate blood pressure readings without the need for arterial catheterization, improving patient comfort and reducing the risk of infection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for non-invasively monitoring blood pressure comprising...\",\n        \"A system for continuous blood pressure monitoring comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67795", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2018-09-01\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2021-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler designed for enhanced precision and operator comfort during minimally invasive surgery. The stapler features a redesigned handle and firing mechanism for increased control and reduced fatigue.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an ergonomic handle...\",\n        \"A firing mechanism for a surgical stapler...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67796", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging Technique for Enhanced Tissue Contrast\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel magnetic resonance imaging (MRI) technique is disclosed that utilizes a specific pulse sequence and data processing algorithm to enhance tissue contrast and improve the detection of subtle pathological changes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing magnetic resonance imaging comprising...\",\n        \"An apparatus for performing magnetic resonance imaging comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67796", "text": "{\n    \"patent_title\": \"Computed Tomography System with Reduced Radiation Dose\",\n    \"inventors\": [\n        {\n            \"name\": \"Karl Schmidt\",\n            \"affiliation\": \"Siemens Healthineers\"\n        },\n        {\n            \"name\": \"Maria Gruber\",\n            \"affiliation\": \"Siemens AG\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2015-11-01\",\n    \"filing_date\": \"2015-11-01\",\n    \"issue_date\": \"2018-08-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A computed tomography (CT) system designed to minimize patient exposure to ionizing radiation while maintaining diagnostic image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A computed tomography system comprising...\",\n        \"A method for reducing radiation dose in computed tomography comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67797", "text": "{\n    \"patent_title\": \"Implantable Cardiac Sensor with Adaptive Stimulation Control\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2020-03-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac sensor and stimulation system dynamically adjusts stimulation parameters based on real-time cardiac function, providing improved pacing efficiency and reducing energy consumption. The system incorporates machine learning algorithms to personalize treatment.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9230456B1\",\n            \"relevance\": \"Prior art related to cardiac pacing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for dynamically adjusting cardiac stimulation parameters...\",\n        \"An implantable cardiac sensor comprising a machine learning module...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67797", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US11245678B1\",\n    \"priority_date\": \"2018-11-20\",\n    \"filing_date\": \"2018-11-20\",\n    \"issue_date\": \"2021-04-13\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical stapler designed for minimally invasive procedures, featuring an improved handle design for enhanced surgeon comfort and control. The stapler includes a safety mechanism to prevent accidental discharge.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8540123B2\",\n            \"relevance\": \"Existing surgical stapler designs\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an ergonomic handle...\",\n        \"A safety mechanism for preventing accidental stapler firing...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67798", "text": "{\n    \"patent_title\": \"Low-Dose Computed Tomography with Iterative Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Michael Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for reducing radiation dose in computed tomography by utilizing iterative reconstruction algorithms and advanced image processing techniques. This invention significantly improves image quality while minimizing patient exposure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"title\": \"Iterative Reconstruction Techniques\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Noise Reduction in CT Images\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing radiation dose in CT imaging.\",\n        \"A system for implementing iterative reconstruction.\",\n        \"A CT scanner configured for low-dose imaging.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67798", "text": "{\n    \"patent_title\": \"Improved MRI Coil Design for Enhanced Signal Reception\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-02-15\",\n    \"filing_date\": \"2017-02-14\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel magnetic resonance imaging (MRI) coil design that improves signal reception and image resolution. This coil utilizes a phased array architecture and advanced shielding techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"title\": \"MRI Coil Phased Array Techniques\"\n        },\n        {\n            \"patent_number\": \"US7890123B1\",\n            \"title\": \"MRI Shielding Methods\"\n        },\n        {\n            \"patent_number\": \"US6789012B2\",\n            \"title\": \"Signal Amplification in MRI\"\n        },\n        {\n            \"patent_number\": \"US5678901B1\",\n            \"title\": \"Radio Frequency Coil Design\"\n        },\n        {\n            \"patent_number\": \"US4567890B2\",\n            \"title\": \"MRI Image Reconstruction Algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil with a phased array architecture.\",\n        \"A method for improving signal reception in MRI.\",\n        \"An MRI system incorporating the novel coil design.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67799", "text": "{\n    \"patent_title\": \"Minimally Invasive Glucose Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Jennifer Hamilton\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Chen\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive glucose monitoring system utilizing optical sensors and machine learning algorithms for accurate and real-time glucose level detection. The system aims to improve patient outcomes by reducing the need for frequent finger pricks.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A non-invasive glucose monitoring device comprising an optical sensor.\",\n        \"A method for continuous glucose monitoring using optical data analysis.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67799", "text": "{\n    \"patent_title\": \"Surgical Robotic System with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Robert Wilson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A robotic surgical system with improved precision and dexterity, enabling surgeons to perform complex procedures with greater control. The system utilizes advanced haptic feedback and image-guided navigation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic system comprising a robotic arm and a control interface.\",\n        \"A method for performing surgery using a robotic system with haptic feedback.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67800", "text": "{\n    \"patent_title\": \"High-Resolution Photoacoustic Tomography System for Enhanced Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"David J. Wallace\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel photoacoustic tomography system capable of achieving sub-millimeter resolution in biological tissues. The system employs a pulsed laser source and a high-sensitivity ultrasound detector array, combined with advanced signal processing algorithms. The resulting images provide unprecedented detail for tumor detection and characterization, potentially revolutionizing cancer diagnostics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A photoacoustic tomography system comprising...\",\n        \"A method for detecting tumors using said system...\",\n        \"A signal processing algorithm for enhancing image resolution...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67800", "text": "{\n    \"patent_title\": \"Improved X-Ray Shielding Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jessica Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2014-12-15\",\n    \"filing_date\": \"2014-12-15\",\n    \"issue_date\": \"2018-05-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new composite material for shielding against X-ray radiation. The material consists of a polymer matrix reinforced with barium sulfate nanoparticles. It provides improved shielding effectiveness compared to traditional lead-based materials, while being lighter and more environmentally friendly.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A shielding material comprising...\",\n        \"A method for manufacturing said material...\",\n        \"A use of said material in X-ray equipment...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67801", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing medical images from noisy data, utilizing a deep learning approach to enhance image quality and reduce artifacts. The system is designed for use with MRI, CT, and PET scans.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Noise Reduction Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"A system comprising a processor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67801", "text": "{\n    \"patent_title\": \"Color Correction Algorithm for Digital Photographs\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Adobe Systems\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-10\",\n    \"filing_date\": \"2017-03-10\",\n    \"issue_date\": \"2018-09-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An algorithm for automatically correcting the color balance in digital photographs, improving visual appearance and ensuring accurate color representation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Automatic White Balance Adjustment\"\n        }\n    ],\n    \"claims\": [\n        \"A method for correcting color in a digital image...\",\n        \"A system for automatic color balance adjustment...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67802", "text": "{\n    \"patent_title\": \"Improved Contrast Agent Delivery System for Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel system for targeted delivery of contrast agents in MRI, improving image resolution and diagnostic accuracy. This system builds upon existing microbubble technology by incorporating...\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art related to microbubble contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI imaging...\",\n        \"A contrast agent delivery system comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67802", "text": "{\n    \"patent_title\": \"Quantum Entanglement Based Medical Imaging Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"California Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-01-20\",\n    \"filing_date\": \"2021-04-15\",\n    \"issue_date\": \"2022-08-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A revolutionary medical imaging device utilizing quantum entanglement for unprecedented resolution and diagnostic capabilities. This device represents a fundamentally new approach to medical imaging...\",\n    \"citations\": [],\n    \"claims\": [\n        \"An imaging device utilizing quantum entanglement...\",\n        \"A method for creating entangled photon pairs...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67803", "text": "{\n    \"patent_title\": \"Method and System for Super-Resolution Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Li Wei\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Zhang Xiaoming\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-06-15\",\n    \"issue_date\": \"2021-01-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for reconstructing high-resolution images from low-resolution images using a deep convolutional neural network. The system utilizes a generative adversarial network (GAN) to improve the perceptual quality of the reconstructed images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a high-resolution image...\",\n        \"A system comprising a deep learning model...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67803", "text": "{\n    \"patent_title\": \"System for Automated Vehicle Parking\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2018-11-20\",\n    \"filing_date\": \"2019-01-10\",\n    \"issue_date\": \"2022-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for parking vehicles in designated parking spaces. The system utilizes sensors and computer vision to identify available parking spaces and guide vehicles to those spaces.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for automated vehicle parking...\",\n        \"A method comprising the steps of sensing...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67804", "text": "{\n    \"patent_title\": \"Comfortable and Adjustable Orthopedic Cast\",\n    \"inventors\": [\n        {\n            \"name\": \"David Stark\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"Stanford University Medical Center\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An orthopedic cast designed with breathable materials and adjustable support features to enhance patient comfort and reduce skin irritation during the healing process. Improved usability through simplified application and removal.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art regarding cast materials.\"\n        }\n    ],\n    \"claims\": [\n        \"A cast comprising breathable, moisture-wicking material.\",\n        \"A cast with adjustable support bands.\",\n        \"A cast designed for easy application and removal by medical personnel.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67804", "text": "{\n    \"patent_title\": \"Surgical Robot with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A robotic surgical system utilizing advanced sensors and algorithms to achieve sub-millimeter precision in complex surgical procedures. Focuses on accuracy and minimizing invasiveness.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\",\n            \"relevance\": \"Prior art regarding robotic surgery systems.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robot with a positioning accuracy of less than 0.5mm.\",\n        \"A control system for the robot utilizing real-time feedback.\",\n        \"A surgical instrument designed for use with the robotic system.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67805", "text": "{\n    \"patent_title\": \"Improved MRI Reconstruction Algorithm for Enhanced Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel algorithm for reconstructing MRI images, significantly improving tumor detection accuracy and reducing scan time. The algorithm employs a deep learning approach to denoise images and enhance contrast.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"An MRI apparatus configured to utilize the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67805", "text": "{\n    \"patent_title\": \"Method for Data Compression in Ultrasound Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Small Tech Solutions Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for compressing ultrasound image data to reduce storage requirements. This method utilizes a lossless compression algorithm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing ultrasound data...\",\n        \"A system for storing compressed ultrasound images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67806", "text": "{\n    \"patent_title\": \"Adaptive Noise Reduction for Enhanced Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel adaptive noise reduction algorithm for medical images, significantly improving image clarity and diagnostic accuracy. The algorithm leverages deep learning techniques to identify and remove noise while preserving important image features. Results demonstrate a substantial improvement in signal-to-noise ratio compared to existing methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"title\": \"Prior Art Noise Reduction Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing noise in medical images comprising...\",\n        \"A system for processing medical images...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67806", "text": "{\n    \"patent_title\": \"Color Correction for Digital Photographs\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a color correction method for digital photographs. The method adjusts the color balance and contrast to improve the visual appearance of the images. It utilizes a histogram equalization technique to enhance image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Early Color Correction Algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"A method for correcting color in digital photographs comprising...\",\n        \"A system for adjusting color balance...\",\n        \"A computer program for image processing...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67807", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel method for significantly improving the resolution and clarity of magnetic resonance images through the application of advanced signal processing techniques and a unique pulse sequence. The system utilizes artificial intelligence to reduce noise and enhance contrast, leading to more accurate diagnoses and improved patient outcomes.  Initial tests demonstrate a 30% improvement in image clarity compared to existing methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art related to MRI signal processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing magnetic resonance images comprising...\",\n        \"A system for performing magnetic resonance imaging...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67807", "text": "{\n    \"patent_title\": \"Improved X-ray Shielding Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2014-12-10\",\n    \"filing_date\": \"2014-12-10\",\n    \"issue_date\": \"2017-05-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new composite material for X-ray shielding. The material consists of a polymer matrix reinforced with barium sulfate particles. It offers improved density and flexibility compared to traditional lead shielding, resulting in better protection for patients and healthcare workers.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous work on radiation shielding materials\"\n        }\n    ],\n    \"claims\": [\n        \"A composite material for X-ray shielding comprising...\",\n        \"A method for manufacturing the composite material...\",\n        \"An X-ray shielding device incorporating the composite material...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67808", "text": "{\n    \"patent_title\": \"High-Resolution Magnetic Resonance Imaging with Accelerated Acquisition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel approach to magnetic resonance imaging (MRI) that significantly reduces scan time while maintaining high image resolution. Utilizing a unique pulse sequence and advanced reconstruction algorithms, the method achieves a 50% reduction in scan time compared to conventional techniques, enabling faster and more efficient diagnosis of various medical conditions. This represents a breakthrough in MRI technology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art relating to pulse sequence design\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI with reduced scan time.\",\n        \"An MRI system comprising a pulse sequence generator and a reconstruction algorithm.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67808", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for X-Ray Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2014-12-10\",\n    \"filing_date\": \"2014-12-10\",\n    \"issue_date\": \"2018-08-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved contrast agent for X-ray imaging. The agent exhibits enhanced visibility and reduced toxicity compared to existing agents. It provides a slight improvement in image quality and patient safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art regarding contrast agent formulations\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent for X-ray imaging comprising a novel chemical compound.\",\n        \"A method for using the contrast agent in medical imaging.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67809", "text": "{\n    \"patent_title\": \"Miniature Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"MIT Bioengineering\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature implantable biosensor for continuous glucose monitoring. The device utilizes a novel enzymatic reaction and microfluidic channel design to provide highly accurate and stable glucose readings.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on glucose monitoring\"\n        }\n    ],\n    \"claims\": [\n        \"A miniature implantable biosensor comprising...\",\n        \"A method for continuous glucose monitoring using the biosensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67809", "text": "{\n    \"patent_title\": \"Improved Syringe Design for Medication Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Baxter Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-06-01\",\n    \"filing_date\": \"2019-12-15\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved syringe design featuring a more ergonomic grip and reduced dead volume to minimize medication waste.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Existing syringe designs\"\n        }\n    ],\n    \"claims\": [\n        \"A syringe comprising an ergonomic grip...\",\n        \"A syringe with reduced dead volume...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67810", "text": "{\n    \"patent_title\": \"Enhanced Medical Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for reconstructing medical images using a deep learning model. The method significantly improves image quality and reduces noise compared to traditional techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Medical Image Filtering\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"The method of claim 1, wherein the deep learning model is a convolutional neural network...\",\n        \"A system for performing the method of claim 1...\",\n        \"The system of claim 3, comprising a processor...\",\n        \"A non-transitory computer-readable medium storing instructions...\",\n        \"The computer-readable medium of claim 5, wherein the instructions cause the processor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67810", "text": "{\n    \"patent_title\": \"Improved X-Ray Tube Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US7654321B1\",\n    \"priority_date\": \"2014-12-01\",\n    \"filing_date\": \"2014-12-01\",\n    \"issue_date\": \"2017-05-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved design for an X-ray tube that increases efficiency and reduces heat generation. This provides a more reliable and cost-effective imaging solution.\",\n    \"citations\": [],\n    \"claims\": [\n        \"An X-ray tube comprising...\",\n        \"The X-ray tube of claim 1, wherein the cathode is made of tungsten...\",\n        \"A method for manufacturing the X-ray tube of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67811", "text": "{\n    \"patent_title\": \"Method for Enhancing Medical Image Clarity Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-10-26\",\n    \"filing_date\": \"2020-05-15\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for enhancing the clarity of medical images using a deep learning convolutional neural network. The method reduces noise and artifacts, leading to improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing a medical image...\",\n        \"A system for implementing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67811", "text": "{\n    \"patent_title\": \"System for Automated Surgical Tool Tracking\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2018-03-12\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2022-04-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for tracking the position and orientation of surgical tools during a medical procedure, providing real-time feedback to the surgeon.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related to surgical robotics\"\n        }\n    ],\n    \"claims\": [\n        \"A system comprising a plurality of sensors...\",\n        \"A method for tracking a surgical tool...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67812", "text": "{\n    \"patent_title\": \"Enhanced User Interface for AI-Powered Voice Assistants\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved user interface for voice assistants, utilizing contextual awareness and personalized responses to enhance user experience. The system dynamically adapts to user preferences and provides more intuitive interactions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing voice commands.\",\n        \"A system for providing personalized responses.\",\n        \"A user interface for a voice assistant.\",\n        \"A method for contextual awareness.\",\n        \"A system for dynamic adaptation to user preferences.\",\n        \"A method for intuitive user interactions.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67812", "text": "{\n    \"patent_title\": \"Machine Learning Algorithm for Financial Fraud Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Bank of America\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Citigroup\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a machine learning algorithm for detecting fraudulent financial transactions. The system analyzes transaction data to identify patterns indicative of fraud and provides alerts to prevent financial loss.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10111213B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for detecting fraudulent transactions.\",\n        \"A method for analyzing transaction data.\",\n        \"A method for generating fraud alerts.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67813", "text": "{\n    \"patent_title\": \"Neural Network-Based Image Enhancement for Low-Light Conditions\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for enhancing images captured in low-light conditions using a deep convolutional neural network. The network is trained to map low-light images to high-quality, visually appealing images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art in image enhancement.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing a low-light image comprising:...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67813", "text": "{\n    \"patent_title\": \"Method for Compressing Digital Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2022-07-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for efficiently compressing digital images using a discrete cosine transform.  The method reduces file size while maintaining acceptable image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related prior art in image compression.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a digital image comprising:...\",\n        \"A system for encoding and decoding images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67814", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-05-20\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the resolution of images using deep convolutional neural networks. The system learns to map low-resolution images to high-resolution images, significantly improving image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Image Super-Resolution Using Sparse Representations\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising...\",\n        \"A system for enhancing image resolution comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67814", "text": "{\n    \"patent_title\": \"Image Compression Technique Based on Wavelet Transform\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Google LLC\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Google LLC\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2011-07-01\",\n    \"filing_date\": \"2011-09-10\",\n    \"issue_date\": \"2018-04-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image compression technique using wavelet transforms to achieve higher compression ratios while maintaining acceptable image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Wavelet-Based Image Coding\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image comprising...\",\n        \"A system for compressing an image comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67815", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Device for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-07-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-05-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable glucose monitoring device with enhanced biocompatibility and accuracy, providing continuous real-time glucose readings to patients with diabetes. The device utilizes a novel enzymatic biosensor and wireless communication protocol.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art related to glucose sensing technology.\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable glucose monitoring device comprising...\",\n        \"A biosensor for detecting glucose levels in vivo...\",\n        \"A wireless communication module for transmitting glucose data...\",\n        \"A biocompatible coating for enhancing device integration...\",\n        \"A method for continuous glucose monitoring using said device...\",\n        \"A system for data analysis and reporting of glucose levels...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67815", "text": "{\n    \"patent_title\": \"Surgical Instrument Handle Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stryker Corporation\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2018-12-01\",\n    \"filing_date\": \"2020-01-20\",\n    \"issue_date\": \"2021-11-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved handle design for surgical instruments, providing enhanced ergonomics and grip control for surgeons during complex procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related prior art in surgical instrument ergonomics.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument handle comprising...\",\n        \"An ergonomic grip surface...\",\n        \"A locking mechanism for securing instrument attachments...\",\n        \"A material composition for improved durability...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67816", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging Technique for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel magnetic resonance imaging (MRI) technique utilizing enhanced contrast agents and advanced image processing algorithms for the early detection of cancerous tumors. This invention significantly improves the accuracy and speed of diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8652012B2\"\n        },\n        {\n            \"patent_number\": \"US9233587B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancerous tumors...\",\n        \"An MRI system configured to utilize the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67816", "text": "{\n    \"patent_title\": \"Enhanced X-Ray Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved X-ray imaging system with reduced radiation exposure and enhanced image clarity. The system incorporates a new detector technology and image reconstruction algorithm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A detector configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67817", "text": "{\n    \"patent_title\": \"Implantable Cardioverter Defibrillator with Enhanced Sensing Capabilities\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Boston Scientific Corporation\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2021-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardioverter defibrillator (ICD) with improved signal processing algorithms for more accurate arrhythmia detection and faster therapy delivery. The device includes enhanced sensing capabilities to minimize false positives and reduce unnecessary shocks.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art relating to ICD therapy\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting and treating arrhythmias using an implantable device.\",\n        \"An implantable device comprising a signal processing unit and a therapy delivery module.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67817", "text": "{\n    \"patent_title\": \"Surgical Instrument for Orthopedic Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stryker Corporation\"\n        }\n    ],\n    \"patent_number\": \"US11789012B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-01-10\",\n    \"issue_date\": \"2022-05-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical instrument designed for precise bone cutting and shaping during orthopedic procedures. The instrument incorporates a laser guidance system for improved accuracy and reduced surgical trauma.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10543219B2\",\n            \"relevance\": \"Related to laser-assisted surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising a laser guidance system.\",\n        \"A method for performing orthopedic surgery using the surgical instrument.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67818", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Enhancement for Medical Diagnostics\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Research\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-11-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel system and method for enhancing medical images using deep convolutional neural networks. This invention significantly improves the clarity and diagnostic accuracy of medical imaging, leading to earlier and more effective treatment.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing a medical image comprising...\",\n        \"A system for processing medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67818", "text": "{\n    \"patent_title\": \"Improved Method for JPEG Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"IBM\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-12-01\",\n    \"filing_date\": \"2019-12-15\",\n    \"issue_date\": \"2020-10-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved method for compressing JPEG images, reducing file size while maintaining acceptable image quality. This invention builds upon existing JPEG standards to provide greater efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image using JPEG...\",\n        \"A system for encoding image data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67819", "text": "{\n    \"patent_title\": \"Portable Diagnostic Device for Rapid Blood Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Genentech\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A portable device for rapid blood analysis, providing immediate diagnostic results at the point of care. The device utilizes microfluidic technology and electrochemical sensors for accurate and efficient detection of biomarkers.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Similar microfluidic design\"\n        }\n    ],\n    \"claims\": [\n        \"A portable diagnostic device comprising...\",\n        \"A method for rapid blood analysis using...\",\n        \"An electrochemical sensor for biomarker detection...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67819", "text": "{\n    \"patent_title\": \"Improved Surgical Instrument Handle\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Medtronic\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-08-20\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2020-12-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved ergonomic handle design for surgical instruments, enhancing surgeon comfort and precision during procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related handle designs\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument handle with...\",\n        \"An ergonomic grip feature...\",\n        \"A method for manufacturing...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67820", "text": "{\n    \"patent_title\": \"Image Enhancement System for Mobile Cameras\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing image quality in mobile devices utilizing adaptive noise reduction and color correction algorithms. The system improves low-light performance and dynamic range.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image captured by a mobile device.\",\n        \"A system comprising a processor and a memory...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67820", "text": "{\n    \"patent_title\": \"Advanced Data Compression Techniques\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Data Solutions Corp.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-05-20\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2021-09-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel approach to data compression utilizing fractal algorithms and wavelet transforms. Significantly reduces data storage requirements.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing digital data.\",\n        \"A system for efficiently storing and retrieving compressed data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67821", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-12-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable biosensor for continuous glucose monitoring, utilizing a novel enzymatic reaction and wireless data transmission. The device offers improved accuracy and patient comfort compared to existing methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on glucose sensing techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable biosensor comprising...\",\n        \"A method for continuous glucose monitoring using the biosensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67821", "text": "{\n    \"patent_title\": \"Surgical Instrument Handle Design\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-07-22\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved ergonomic design for surgical instrument handles, enhancing grip and reducing hand fatigue during prolonged procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous designs for surgical instrument handles\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument handle with an ergonomic grip...\",\n        \"A method of manufacturing the surgical instrument handle...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67822", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"David Jones\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system comprising a robotic arm, a high-resolution camera, and advanced image processing algorithms for improved surgical precision and visualization. This system allows for the performance of complex surgical procedures with reduced patient trauma and faster recovery times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Robotic Surgical System\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising a robotic arm and a visualization module.\",\n        \"A method for performing a minimally invasive surgical procedure using the system.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67822", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Jessica Brown\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-09-22\",\n    \"filing_date\": \"2017-09-22\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel catheter design with improved drug delivery capabilities. The catheter features a micro-needle array for targeted drug release and reduced systemic side effects.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Drug Delivery Catheter\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a micro-needle array.\",\n        \"A method for delivering a drug using the catheter.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67823", "text": "{\n    \"patent_title\": \"Method and System for Enhanced MRI Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-06-15\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing MRI images with improved resolution and reduced artifacts, enhancing diagnostic accuracy for detecting subtle anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"A system for performing MRI image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67823", "text": "{\n    \"patent_title\": \"Automated X-ray Image Analysis System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-10\",\n    \"filing_date\": \"2017-04-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for analyzing X-ray images to detect fractures and other bone abnormalities, improving workflow efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for analyzing X-ray images comprising...\",\n        \"A method for detecting fractures in X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67824", "text": "{\n    \"patent_title\": \"Improved MRI Image Reconstruction Method\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-06-20\",\n    \"issue_date\": \"2022-12-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing MRI images with reduced artifacts and improved signal-to-noise ratio, leading to more accurate diagnoses of soft tissue injuries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"An MRI system configured to implement the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67824", "text": "{\n    \"patent_title\": \"CT Scan Calibration Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2020-05-01\",\n    \"filing_date\": \"2020-08-15\",\n    \"issue_date\": \"2021-04-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A calibration method for CT scanners to ensure accurate Hounsfield unit measurements and reduce image distortion.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related CT scanner technology\"\n        }\n    ],\n    \"claims\": [\n        \"A method for calibrating a CT scanner...\",\n        \"A CT scanner comprising a calibration module...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67825", "text": "{\n    \"patent_title\": \"Improved Medical Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel deep learning architecture for reconstructing medical images from raw data, resulting in improved image quality and diagnostic accuracy. The system is particularly useful for MRI and CT scans.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"A system for improving the quality of a medical image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67825", "text": "{\n    \"patent_title\": \"Automated Report Generation for X-Ray Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Hospital\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"General Hospital\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a system for automatically generating reports from X-ray images, reducing the workload of radiologists.  The system uses image recognition and natural language processing techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for generating a report from an X-ray image...\",\n        \"A method for automating radiology report creation...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67826", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction for Cardiac MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-06-20\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel image reconstruction algorithm for cardiac MRI, leading to improved image quality and diagnostic accuracy in identifying heart disease.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing cardiac MRI images comprising...\",\n        \"An apparatus for performing image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67826", "text": "{\n    \"patent_title\": \"Novel Contrast Agent for Ultrasound Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2019-12-10\",\n    \"filing_date\": \"2020-04-05\",\n    \"issue_date\": \"2023-02-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new contrast agent used in ultrasound imaging, enhancing visualization of blood vessels and tissues.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent for ultrasound imaging comprising...\",\n        \"A method of using the contrast agent...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67827", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"David A. Levin\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2018-03-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing medical images from raw data, leading to improved image quality and diagnostic accuracy. The system utilizes a deep learning algorithm to reduce noise and enhance contrast.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for performing medical image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67827", "text": "{\n    \"patent_title\": \"Apparatus for Improved X-Ray Tube Cooling\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2018-07-12\",\n    \"issue_date\": \"2019-04-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved cooling system for X-ray tubes, designed to increase lifespan and reduce maintenance costs. It features a novel heat sink design and efficient fluid circulation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube cooling apparatus comprising...\",\n        \"A heat sink for an X-ray tube...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67828", "text": "{\n    \"patent_title\": \"Method and System for Super-Resolution Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Li Wei\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2017-05-15\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for reconstructing high-resolution images from low-resolution images using deep convolutional neural networks. The system utilizes a generative adversarial network (GAN) to enhance image details and improve perceptual quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760754B1\",\n            \"title\": \"Image Enhancement using Wavelet Transform\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a high-resolution image...\",\n        \"A system comprising a deep neural network configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67828", "text": "{\n    \"patent_title\": \"Improved Data Compression Technique for Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Acme Corporation\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2016-11-20\",\n    \"filing_date\": \"2016-11-20\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel data compression algorithm specifically designed for medical images, reducing storage requirements and transmission bandwidth while preserving diagnostic quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Lossless Compression of Digital Images\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a medical image...\",\n        \"A system comprising a compression module configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67829", "text": "{\n    \"patent_title\": \"Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable biosensor capable of continuously monitoring glucose levels in real-time, providing accurate data for diabetes management and improving patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A biosensor for continuous glucose monitoring...\",\n        \"A method for transmitting glucose data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67829", "text": "{\n    \"patent_title\": \"Novel Packaging Material for Pharmaceuticals\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Williams\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-01\",\n    \"issue_date\": \"2023-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel packaging material designed to enhance the shelf life and protect the integrity of pharmaceutical products.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A packaging material comprising...\",\n        \"A method of packaging pharmaceuticals...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67830", "text": "{\n    \"patent_title\": \"Method for Enhanced Cancer Detection Using Multi-Modal Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for improving cancer detection accuracy by fusing images from multiple medical imaging modalities, such as MRI and PET scans. The method utilizes machine learning algorithms to identify subtle patterns indicative of cancerous tissue.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in medical image fusion\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancer comprising...\",\n        \"A system for processing medical images...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67830", "text": "{\n    \"patent_title\": \"Improved Algorithm for Satellite Image Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2019-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An enhanced algorithm for processing satellite imagery to improve the detection of land features. The algorithm utilizes spectral analysis and pattern recognition techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related work on image segmentation\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing satellite imagery comprising...\",\n        \"A system for analyzing spectral data...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67831", "text": "{\n    \"patent_title\": \"Novel MRI Reconstruction Method for Enhanced Image Clarity\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing MRI images using deep learning, resulting in significantly improved image clarity and reduced scan time. The method is particularly effective for imaging of soft tissues and can potentially aid in early disease detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Prior art in MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67831", "text": "{\n    \"patent_title\": \"Improved X-Ray Shielding Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2017-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new composite material for X-ray shielding, offering improved protection and reduced weight compared to traditional lead-based shields.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art in radiation shielding\"\n        }\n    ],\n    \"claims\": [\n        \"A shielding material comprising...\",\n        \"A method for manufacturing a shielding material...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67832", "text": "{\n    \"patent_title\": \"Deep Learning for Automated Diagnosis of Retinal Diseases\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2020-04-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for automatically diagnosing retinal diseases using deep learning techniques. The system analyzes retinal images to identify and classify various conditions, assisting clinicians in faster and more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for diagnosing retinal diseases using a convolutional neural network.\",\n        \"A system comprising a camera, a processing unit, and a display for visualizing diagnostic results.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67832", "text": "{\n    \"patent_title\": \"Enhanced Object Detection in Autonomous Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Elon Musk\",\n            \"affiliation\": \"Tesla\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2018-03-10\",\n    \"filing_date\": \"2018-03-10\",\n    \"issue_date\": \"2021-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to improved object detection algorithms for use in autonomous vehicles. The system utilizes a combination of lidar and camera data to accurately identify and track objects in the vehicle's surroundings.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10112233B2\"\n        }\n    ],\n    \"claims\": [\n        \"An autonomous vehicle comprising a lidar sensor, a camera, and a processing unit.\",\n        \"A method for detecting objects using sensor fusion.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67833", "text": "{\n    \"patent_title\": \"Remote Physiological Parameter Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for remotely monitoring a patient's vital signs including heart rate, blood pressure, and oxygen saturation. The system utilizes wearable sensors and a cloud-based platform for data analysis and reporting.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for remotely monitoring a patient's physiological parameters...\",\n        \"A wearable sensor configured to measure heart rate...\",\n        \"A cloud-based platform for receiving and analyzing sensor data...\",\n        \"A method for alerting healthcare professionals to abnormal readings...\",\n        \"The system of claim 1, further comprising a user interface...\",\n        \"The wearable sensor of claim 2, being a patch...\",\n        \"The platform of claim 3, storing patient data securely...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67833", "text": "{\n    \"patent_title\": \"Improved Stethoscope Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2021-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved stethoscope design featuring enhanced sound amplification and noise reduction.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A stethoscope comprising a sound collection chamber...\",\n        \"A diaphragm configured to amplify sound...\",\n        \"A noise reduction filter...\",\n        \"The stethoscope of claim 1, made of stainless steel...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67834", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2018-05-10\",\n    \"filing_date\": \"2018-05-10\",\n    \"issue_date\": \"2019-12-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel MRI technique utilizing advanced pulse sequences and image reconstruction algorithms to enhance the detection of small cancerous tumors with improved specificity and sensitivity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI comprising...\",\n        \"An MRI apparatus configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67834", "text": "{\n    \"patent_title\": \"Method for Analyzing Financial Data Using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10293847B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-15\",\n    \"issue_date\": \"2020-04-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for analyzing financial data streams to identify trends and predict market movements using machine learning algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for analyzing financial data comprising...\",\n        \"A method for predicting market trends using...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67835", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for improving the accuracy and speed of medical image analysis using deep learning techniques. Specifically designed for identifying anomalies in MRI scans.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Prior art in image segmentation.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for analyzing medical images comprising...\",\n        \"A system for detecting anomalies in medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67835", "text": "{\n    \"patent_title\": \"Improved Image Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2020-02-28\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2022-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved image compression algorithm based on wavelet transforms.  This algorithm significantly reduces file sizes without sacrificing image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\",\n            \"relevance\": \"Related compression techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"An image compression method comprising...\",\n        \"A system for compressing images using wavelet transforms...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67836", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Recognition System with Attention Mechanisms\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image recognition system utilizing deep learning and attention mechanisms to improve accuracy and efficiency. The system can be applied to various image analysis tasks.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Convolutional Neural Networks for Image Classification\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition using deep learning...\",\n        \"A system comprising a convolutional neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67836", "text": "{\n    \"patent_title\": \"Method for Basic Image Filtering\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"SmallTech Inc.\"\n        }\n    ],\n    \"patent_number\": \"EP3456789A1\",\n    \"priority_date\": \"2019-11-10\",\n    \"filing_date\": \"2019-11-10\",\n    \"issue_date\": \"2021-01-15\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"A simple image filtering method based on averaging pixel values. This method improves image quality by reducing noise.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for filtering an image...\",\n        \"An image processing system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67837", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Robotic Assistance\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel robotic surgical system allows for highly precise and minimally invasive procedures, improving patient outcomes and reducing recovery times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8652001B2\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system comprising...\",\n        \"A method for performing minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67837", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Fluid Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Williams\",\n            \"affiliation\": \"University of California, San Diego\"\n        }\n    ],\n    \"patent_number\": \"US10456789B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design with enhanced flow characteristics for efficient fluid delivery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7435000B2\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising...\",\n        \"A method for delivering fluids using the catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67838", "text": "{\n    \"patent_title\": \"Method and System for Efficient Image Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for image enhancement utilizing parallel processing techniques to reduce computational load and improve performance.  The system is designed for high-resolution images requiring substantial processing power.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image comprising...\",\n        \"A system for performing image enhancement...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67838", "text": "{\n    \"patent_title\": \"Digital Camera Interface\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2018-11-01\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved interface for connecting digital cameras to computer systems. Focuses on data transfer protocols and user experience.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A digital camera interface comprising...\",\n        \"A method for transferring image data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67839", "text": "{\n    \"patent_title\": \"Method and System for Super-Resolution Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Mark Horowitz\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"James Liang\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11876543B2\",\n    \"priority_date\": \"2020-05-15\",\n    \"filing_date\": \"2020-05-15\",\n    \"issue_date\": \"2023-12-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for reconstructing high-resolution images from low-resolution images using deep convolutional neural networks. The system utilizes a generative adversarial network (GAN) to enhance image details and reduce artifacts, resulting in improved visual quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a high-resolution image comprising...\",\n        \"A system for super-resolution image reconstruction...\",\n        \"The method of claim 1, wherein the neural network is a generative adversarial network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67839", "text": "{\n    \"patent_title\": \"Medical Image Enhancement Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Christina Collins\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2020-08-20\",\n    \"filing_date\": \"2020-08-20\",\n    \"issue_date\": \"2024-01-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep learning approach for enhancing the quality of medical images, such as X-rays and MRIs, to improve diagnostic accuracy. The system employs convolutional neural networks to reduce noise and enhance contrast, facilitating better visualization of anatomical structures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing medical images comprising...\",\n        \"A system for medical image processing...\",\n        \"The method of claim 1, wherein the image is an MRI scan.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67840", "text": "{\n    \"patent_title\": \"Novel Image Enhancement Algorithm Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-09-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel image enhancement algorithm based on deep convolutional neural networks. The algorithm improves image quality by removing noise and enhancing details, offering significant advantages over existing methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image comprising...\",\n        \"A system for image enhancement...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67840", "text": "{\n    \"patent_title\": \"Improved Method for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"SmallTech Solutions Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2018-11-01\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method for compressing digital data efficiently. It uses a novel algorithm to reduce the file size while maintaining data integrity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data comprising...\",\n        \"A system for data compression...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67841", "text": "{\n    \"patent_title\": \"Miniature Implantable Wireless Pressure Sensor for Glaucoma Management\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature, fully implantable wireless pressure sensor for continuous intraocular pressure (IOP) monitoring in glaucoma patients. The device transmits data wirelessly to an external reader, providing real-time IOP readings and improving glaucoma management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art on implantable sensors\"\n        }\n    ],\n    \"claims\": [\n        \"A miniature implantable pressure sensor comprising...\",\n        \"A wireless communication module for transmitting data...\",\n        \"A system for continuous IOP monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67841", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Angiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"St. Jude Medical\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-12-01\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2022-08-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design for angiography procedures, featuring a more flexible tip and enhanced visualization capabilities. This reduces patient discomfort and improves diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous catheter designs\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible distal tip...\",\n        \"A visualization system integrated within the catheter...\",\n        \"A method for performing angiography using the catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67842", "text": "{\n    \"patent_title\": \"Enhanced Magnetic Resonance Imaging with Artificial Intelligence for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for improving the accuracy of cancer detection using magnetic resonance imaging (MRI) and artificial intelligence. The system utilizes deep learning algorithms to analyze MRI scans and identify subtle indicators of cancerous tissue, leading to earlier and more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"MRI Image Enhancement Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancer using MRI and AI.\",\n        \"A system comprising an MRI scanner and a deep learning algorithm.\",\n        \"A computer-readable medium storing instructions for implementing the method.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67842", "text": "{\n    \"patent_title\": \"Improved X-ray Image Processing for Bone Fracture Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Sarah Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-10\",\n    \"issue_date\": \"2021-08-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new algorithm for processing X-ray images to enhance the visibility of bone fractures. The algorithm improves contrast and reduces noise, leading to more accurate diagnoses of skeletal injuries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Digital X-ray Image Enhancement\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing X-ray images.\",\n        \"A system comprising an X-ray source and an image processing unit.\",\n        \"A computer program for implementing the method.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67843", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2021-03-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a minimally invasive surgical system comprising a small diameter endoscope with enhanced visualization capabilities and robotic surgical instruments. The system allows for precise and controlled tissue manipulation, reducing patient trauma and recovery time. The technology offers a groundbreaking approach to complex surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art related to endoscopic visualization.\"\n        }\n    ],\n    \"claims\": [\n        \"A minimally invasive surgical system comprising...\",\n        \"An endoscope with enhanced visualization...\",\n        \"A robotic surgical instrument...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67843", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"General Hospital Inc.\"\n        },\n        {\n            \"name\": \"Dr. Jane Doe\",\n            \"affiliation\": \"Pharmaceutical Solutions Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-20\",\n    \"filing_date\": \"2018-11-20\",\n    \"issue_date\": \"2020-12-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved catheter design for efficient drug delivery within the cardiovascular system. The catheter features a novel tip geometry and material composition, leading to reduced clogging and enhanced drug distribution. The design improves upon existing drug delivery methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art regarding catheter materials.\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter for drug delivery comprising...\",\n        \"A tip geometry for reduced clogging...\",\n        \"A material composition for enhanced drug distribution...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67844", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Super-Resolution Network\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for image super-resolution, significantly enhancing image quality and detail.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution using a convolutional neural network.\",\n        \"An image processing system comprising a deep learning module for super-resolution.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67844", "text": "{\n    \"patent_title\": \"Method for Data Compression using Wavelet Transforms\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Beta Industries\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-08-22\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2021-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A data compression method based on wavelet transforms for efficient storage and transmission of digital data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data using wavelet transforms.\",\n        \"A data storage system utilizing wavelet compression.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67845", "text": "{\n    \"patent_title\": \"Novel MRI Reconstruction Method for Enhanced Soft Tissue Contrast\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-06-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing MRI images is presented, utilizing a deep learning approach to significantly enhance contrast in soft tissue imaging. The technique demonstrably improves visualization of subtle anatomical features and is potentially applicable in early cancer detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Prior art on MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI reconstruction according to claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67845", "text": "{\n    \"patent_title\": \"Improved Calibration Procedure for Existing CT Scanners\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-09-20\",\n    \"filing_date\": \"2017-09-20\",\n    \"issue_date\": \"2019-05-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved calibration procedure for CT scanners to reduce image artifacts. The method primarily focuses on optimizing existing hardware and software parameters and offers minor improvements over current standards.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous CT scanner calibration methods\"\n        }\n    ],\n    \"claims\": [\n        \"A method for calibrating a CT scanner comprising...\",\n        \"A system for performing CT scanner calibration according to claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67846", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging with Artificial Intelligence Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10500000B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel method for enhancing the resolution and clarity of magnetic resonance images using artificial intelligence algorithms. This results in improved diagnostic accuracy for various medical conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8000000B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI images...\",\n        \"An AI-powered system for medical image analysis...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67846", "text": "{\n    \"patent_title\": \"Contrast Agent for X-Ray Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"Bayer AG\"\n        }\n    ],\n    \"patent_number\": \"EP3800000B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-02-26\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"This invention describes a new contrast agent for enhancing the visibility of tissues during X-ray imaging procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7500000B2\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"A method for enhancing X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67847", "text": "{\n    \"patent_title\": \"Method and System for Enhanced MRI Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10556789B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing Magnetic Resonance Images (MRI) with improved resolution and reduced scan time. This technology utilizes advanced signal processing algorithms to enhance image clarity and diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67847", "text": "{\n    \"patent_title\": \"Improved X-Ray Imaging Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"EP3845678A1\",\n    \"priority_date\": \"2017-09-20\",\n    \"filing_date\": \"2017-09-20\",\n    \"issue_date\": \"2021-05-05\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"An X-ray imaging device with enhanced radiation shielding and improved image quality. This invention offers a safer and more efficient X-ray imaging solution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related X-ray technology\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging device comprising...\",\n        \"A method for operating the X-ray imaging device...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67848", "text": "{\n    \"patent_title\": \"Method and System for Real-Time Image Enhancement Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the quality of images in real-time using a deep learning model. The model is trained on a large dataset of images and is capable of improving the clarity, contrast, and overall visual appeal of images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Highly Relevant\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Relevant\"\n        },\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"Related\"\n        },\n        {\n            \"patent_number\": \"US6543210B2\",\n            \"relevance\": \"Related\"\n        },\n        {\n            \"patent_number\": \"US5432109B1\",\n            \"relevance\": \"Related\"\n        },\n        {\n            \"patent_number\": \"US4321098B2\",\n            \"relevance\": \"Related\"\n        },\n        {\n            \"patent_number\": \"US3210987B1\",\n            \"relevance\": \"Related\"\n        },\n        {\n            \"patent_number\": \"US2109876B2\",\n            \"relevance\": \"Related\"\n        },\n        {\n            \"patent_number\": \"US1098765B1\",\n            \"relevance\": \"Related\"\n        },\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Highly Relevant\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image...\",\n        \"A system for enhancing an image...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67848", "text": "{\n    \"patent_title\": \"Image Compression Technique Using Wavelet Transform\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corp\"\n        }\n    ],\n    \"patent_number\": \"US11223344B2\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-06-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image compression technique based on wavelet transform is presented. This method achieves a high compression ratio while maintaining acceptable image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US12345678B1\",\n            \"relevance\": \"Relevant\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related\"\n        },\n        {\n            \"patent_number\": \"US6543210B2\",\n            \"relevance\": \"Related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image...\",\n        \"A system for compressing an image...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67849", "text": "{\n    \"patent_title\": \"Miniature Implantable Cardiac Monitor with Wireless Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"David Alt\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-06-15\",\n    \"issue_date\": \"2022-12-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature implantable cardiac monitor for long-term monitoring of heart rhythm and function. The device wirelessly transmits data to an external receiver, providing continuous and convenient monitoring for patients at risk of arrhythmias or other cardiovascular events. Addresses the unmet need for less invasive and more patient-friendly cardiac monitoring.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on implantable cardiac devices.\"\n        }\n    ],\n    \"claims\": [\n        \"A miniature implantable cardiac monitor...\",\n        \"A method for wirelessly transmitting cardiac data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67849", "text": "{\n    \"patent_title\": \"Surgical Instrument for Laparoscopic Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-08-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical instrument designed for use in laparoscopic procedures. The instrument features an ergonomic handle and a precise articulating tip for enhanced maneuverability and control during minimally invasive surgery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art on laparoscopic surgical instruments.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising an ergonomic handle...\",\n        \"An articulating tip for laparoscopic procedures...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67850", "text": "{\n    \"patent_title\": \"System and Method for Personalized Recommendation Using Deep Reinforcement Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-05-15\",\n    \"filing_date\": \"2020-11-20\",\n    \"issue_date\": \"2022-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for providing personalized recommendations to users utilizing deep reinforcement learning. The system analyzes user behavior and preferences to optimize recommendations in real-time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        },\n        {\n            \"patent_number\": \"US11000001B1\"\n        },\n        {\n            \"patent_number\": \"US10500002B1\"\n        },\n        {\n            \"patent_number\": \"US11500003B1\"\n        },\n        {\n            \"patent_number\": \"US12000004B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for providing personalized recommendations...\",\n        \"A method for training a reinforcement learning model...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67850", "text": "{\n    \"patent_title\": \"Novel Theoretical Framework for Bayesian Optimization\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11789012B2\",\n    \"priority_date\": \"2021-01-05\",\n    \"filing_date\": \"2021-07-12\",\n    \"issue_date\": \"2023-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a new theoretical framework for Bayesian optimization, focusing on the convergence properties of acquisition functions. It introduces a novel kernel function for improved exploration-exploitation balance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10000001B2\"\n        },\n        {\n            \"patent_number\": \"US10100002B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for Bayesian optimization based on a novel kernel function...\",\n        \"A theoretical framework for analyzing the convergence properties...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67851", "text": "{\n    \"patent_title\": \"Enhanced Resolution MRI using Deep Learning Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-12-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method for improving the resolution of Magnetic Resonance Images (MRIs) using a deep learning-based reconstruction algorithm. The algorithm reduces noise and artifacts, leading to clearer and more accurate diagnostic images. Specifically, it addresses challenges in low-dose imaging scenarios.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"MRI Image Reconstruction Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67851", "text": "{\n    \"patent_title\": \"Automated Tumor Detection in CT Scans\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"General Hospital Research Institute\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-08-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system and method for automatically detecting tumors in Computed Tomography (CT) scans. The system employs machine learning algorithms to identify suspicious regions within the scan data. It focuses on increasing the speed and accuracy of tumor detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Medical Image Analysis using Machine Learning\"\n        }\n    ],\n    \"claims\": [\n        \"A system for automated tumor detection in CT scans...\",\n        \"A method for identifying tumors in CT scan data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67852", "text": "{\n    \"patent_title\": \"High-Resolution Medical Imaging System Using Deep Learning Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A medical imaging system utilizing deep learning algorithms for enhanced image reconstruction, resulting in higher resolution and improved diagnostic accuracy. The system is applicable to MRI, CT, and PET scans.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Image Reconstruction Techniques\"\n        },\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"Deep Learning in Medical Imaging\"\n        },\n        {\n            \"patent_number\": \"US11000001B2\",\n            \"relevance\": \"Artifact Reduction in MRI\"\n        }\n    ],\n    \"claims\": [\n        \"A medical imaging system comprising a scanner and a processor configured to reconstruct images using a deep learning algorithm.\",\n        \"A method for enhancing image resolution in medical imaging using a convolutional neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67852", "text": "{\n    \"patent_title\": \"Portable Ultrasound Device with Wireless Connectivity\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Medical Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2018-11-01\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A portable ultrasound device with wireless connectivity for remote diagnostics. The device is compact and user-friendly, allowing for point-of-care imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Wireless Medical Devices\"\n        },\n        {\n            \"patent_number\": \"US9123456B1\",\n            \"relevance\": \"Ultrasound Technology\"\n        }\n    ],\n    \"claims\": [\n        \"A portable ultrasound device comprising a transducer, a processor, and a wireless transmitter.\",\n        \"A method for transmitting ultrasound images wirelessly to a remote diagnostic center.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67853", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Super-Resolution with Generative Adversarial Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Jia Deng\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Shuwen Wang\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11876543B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-04-20\",\n    \"issue_date\": \"2023-12-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel approach to image super-resolution utilizing generative adversarial networks (GANs) for enhanced detail and realism. The method overcomes limitations of traditional super-resolution techniques by incorporating perceptual loss functions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Processing System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for super-resolving an image comprising...\",\n        \"A system for implementing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67853", "text": "{\n    \"patent_title\": \"Method for Enhancing Contrast in Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2019-03-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for automatically adjusting the contrast of medical images to improve visibility of subtle details. This invention employs histogram equalization techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Medical Image Display System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing the contrast of a medical image comprising...\",\n        \"An apparatus for implementing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67854", "text": "{\n    \"patent_title\": \"Deep Learning Framework for Efficient Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-05-15\",\n    \"filing_date\": \"2020-08-20\",\n    \"issue_date\": \"2022-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning framework designed for high-accuracy and efficient image recognition tasks. This invention utilizes a new activation function and optimized network architecture.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image classification\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A deep learning network configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67854", "text": "{\n    \"patent_title\": \"Improved Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Beta Industries\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-03-10\",\n    \"filing_date\": \"2021-06-15\",\n    \"issue_date\": \"2023-02-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel data compression algorithm that achieves higher compression ratios while maintaining data integrity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10111213B2\",\n            \"relevance\": \"Related data compression techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data...\",\n        \"A data compression system comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67855", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-06-15\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the resolution of digital images using a deep convolutional neural network. The network is trained to predict high-resolution details from low-resolution input, resulting in improved image clarity and detail.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution...\",\n        \"A system comprising a deep learning network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67855", "text": "{\n    \"patent_title\": \"Automated Plant Species Identification using Spectral Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Davis\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2022-11-15\",\n    \"filing_date\": \"2022-12-01\",\n    \"issue_date\": \"2024-02-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for automatically identifying plant species using spectral imaging and machine learning algorithms. The system analyzes the spectral signature of a plant leaf to determine its species with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for identifying plant species...\",\n        \"A system comprising a spectral imaging device...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67856", "text": "{\n    \"patent_title\": \"Method and System for Adaptive Image Filtering\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Adobe Systems\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2019-12-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for adaptively filtering images to reduce noise and enhance detail. The system utilizes a novel algorithm that analyzes image characteristics to dynamically adjust filtering parameters.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for adaptively filtering an image comprising...\",\n        \"A system for enhancing image quality...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67856", "text": "{\n    \"patent_title\": \"System for Managing Digital Assets\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Apple Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11123456B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2021-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for storing, organizing, and retrieving digital assets, including images and videos. The system provides a user interface for managing assets and controlling access.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for managing digital assets comprising...\",\n        \"A method for organizing digital images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67857", "text": "{\n    \"patent_title\": \"Low-Dose Computed Tomography Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method for reconstructing high-quality computed tomography images from low-dose radiation data using deep learning techniques. The method is particularly useful in resource-constrained environments where radiation exposure must be minimized.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art in CT image reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a CT image comprising...\",\n        \"A system for implementing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67857", "text": "{\n    \"patent_title\": \"Enhanced Magnetic Resonance Imaging Contrast Agents\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to novel contrast agents for magnetic resonance imaging, providing improved image clarity and diagnostic capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related art on contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"A method for using the contrast agent...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67858", "text": "{\n    \"patent_title\": \"Improved Image Recognition Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2019-03-20\",\n    \"issue_date\": \"2021-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for improving image recognition accuracy using deep convolutional neural networks. The system utilizes a novel architecture to enhance feature extraction and classification performance in general visual recognition tasks.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67858", "text": "{\n    \"patent_title\": \"Medical Image Analysis System Using Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"David Hung\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for analyzing medical images using deep convolutional neural networks to detect anomalies and assist in diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for medical image analysis comprising...\",\n        \"A system for medical image analysis...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67859", "text": "{\n    \"patent_title\": \"High-Capacity Solid-State Lithium-Ion Battery with Enhanced Safety Features\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel solid-state lithium-ion battery architecture exhibiting a significantly enhanced energy density and improved safety characteristics. A breakthrough electrolyte composition minimizes dendrite formation, leading to prolonged cycle life and reduced risk of thermal runaway. The invention represents a substantial advancement in battery technology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art on solid-state electrolytes\"\n        }\n    ],\n    \"claims\": [\n        \"A solid-state lithium-ion battery comprising...\",\n        \"An electrolyte composition characterized by...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67859", "text": "{\n    \"patent_title\": \"Improved Battery Casing Design for Enhanced Durability\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2018-08-22\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2022-09-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new design for battery casings, utilizing a composite material to increase impact resistance and prevent leakage. The casing provides improved protection for lithium-ion batteries during transportation and operation. The design is robust and cost-effective.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Previous casing designs\"\n        }\n    ],\n    \"claims\": [\n        \"A battery casing comprising...\",\n        \"A composite material with a defined tensile strength...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67860", "text": "{\n    \"patent_title\": \"Remote Physiological Monitoring System with AI-Powered Anomaly Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A remote patient monitoring system utilizing wearable sensors and an AI algorithm to detect anomalies in physiological data, enabling proactive healthcare interventions. The system provides real-time alerts to healthcare professionals and patients, improving patient outcomes and reducing hospital readmissions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for remote physiological monitoring comprising...\",\n        \"A method for detecting anomalies in physiological data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67860", "text": "{\n    \"patent_title\": \"Improved Insulin Pump Control Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-12-10\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2021-09-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel control algorithm for insulin pumps designed to optimize glucose regulation in diabetic patients. The algorithm utilizes a model predictive control strategy to predict future glucose levels and adjust insulin delivery accordingly.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"related_art\"\n        }\n    ],\n    \"claims\": [\n        \"An insulin pump control algorithm comprising...\",\n        \"A method for predicting glucose levels...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67861", "text": "{\n    \"patent_title\": \"Deep Convolutional Neural Networks for Image Classification\",\n    \"inventors\": [\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        },\n        {\n            \"name\": \"Alex Krizhevsky\",\n            \"affiliation\": \"University of Toronto\"\n        },\n        {\n            \"name\": \"Ilya Sutskever\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"patent_number\": \"US9182668B2\",\n    \"priority_date\": \"2012-11-26\",\n    \"filing_date\": \"2014-09-26\",\n    \"issue_date\": \"2015-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep convolutional neural network architecture for image classification is presented. The network uses ReLU non-linearities and local response normalization. The network is trained using stochastic gradient descent.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7627283B2\"\n        },\n        {\n            \"patent_number\": \"US8144604B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for classifying images using a deep convolutional neural network.\",\n        \"A deep convolutional neural network comprising multiple convolutional layers.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67861", "text": "{\n    \"patent_title\": \"Method and Apparatus for Object Tracking in Video Sequences\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US8879852B2\",\n    \"priority_date\": \"2013-03-15\",\n    \"filing_date\": \"2014-09-10\",\n    \"issue_date\": \"2014-11-04\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and apparatus for tracking objects in video sequences is described. The method uses Kalman filtering and feature matching.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7548253B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for tracking objects in a video sequence using Kalman filtering.\",\n        \"An apparatus for tracking objects comprising a video input and a Kalman filter.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67862", "text": "{\n    \"patent_title\": \"Adaptive Noise Reduction in Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2018-03-01\",\n    \"issue_date\": \"2021-06-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reducing noise in MRI images using adaptive filtering techniques, resulting in improved image clarity and diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image filtering.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing noise in MRI images...\",\n        \"An MRI system comprising a noise reduction module...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67862", "text": "{\n    \"patent_title\": \"Improved X-ray Tube Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Philips Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2016-05-20\",\n    \"filing_date\": \"2017-11-10\",\n    \"issue_date\": \"2020-01-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved design for X-ray tubes that enhances their efficiency and lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related art in X-ray technology.\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube comprising a modified filament structure...\",\n        \"A method for manufacturing an X-ray tube...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67863", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction for Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"David A. Agrawal\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Michael S. Rosen\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10786612B2\",\n    \"priority_date\": \"2018-10-26\",\n    \"filing_date\": \"2019-01-15\",\n    \"issue_date\": \"2020-09-29\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel image reconstruction method for Magnetic Resonance Imaging (MRI) that significantly improves image resolution and clarity by reducing noise and artifacts. The technique utilizes a deep learning approach to enhance image details and provide more accurate diagnostic information.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9879543B2\",\n            \"title\": \"MRI Image Processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"A system for performing MRI image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67863", "text": "{\n    \"patent_title\": \"System for Automated Pathology Slide Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Harold G. Moore\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Sarah Chen\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11238456B1\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2021-01-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system for automated analysis of pathology slides, utilizing computer vision algorithms to identify and classify cellular structures. The system improves efficiency in diagnostic pathology workflows.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8982521B2\",\n            \"title\": \"Digital Pathology System\"\n        }\n    ],\n    \"claims\": [\n        \"A system for automated pathology slide analysis comprising...\",\n        \"A method for identifying cellular structures in pathology slides...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67864", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Sepsis Diagnosis\",\n    \"inventors\": [\n        {\n            \"name\": \"David A. Sinclair\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-05-15\",\n    \"issue_date\": \"2023-11-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device capable of rapid and accurate detection of biomarkers associated with sepsis, allowing for earlier intervention and improved patient outcomes. This device addresses the critical need for faster diagnostics in sepsis cases, where timely treatment is essential for survival.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art in microfluidic diagnostics\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for detecting sepsis biomarkers...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67864", "text": "{\n    \"patent_title\": \"Improved Catheter Design\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-02-10\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-08-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design with enhanced flexibility and reduced risk of kinking. The catheter utilizes a novel material composition to improve ease of use during medical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art in catheter materials\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible shaft...\",\n        \"A method of using the catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67865", "text": "{\n    \"patent_title\": \"Enhanced Image Reconstruction for Low-Dose Computed Tomography\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-06-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel image reconstruction algorithm for computed tomography that significantly reduces the radiation dose required to obtain diagnostic quality images. The algorithm utilizes deep learning techniques to enhance image clarity and reduce noise, resulting in improved diagnostic accuracy with lower patient exposure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Prior Art CT Reconstruction Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a CT image comprising...\",\n        \"An apparatus for performing CT image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67865", "text": "{\n    \"patent_title\": \"New Pharmaceutical Formulation for Pain Relief\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Pfizer Inc.\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-01-05\",\n    \"filing_date\": \"2020-04-15\",\n    \"issue_date\": \"2021-07-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel pharmaceutical formulation for the treatment of chronic pain, comprising a combination of existing analgesic compounds with improved bioavailability and reduced side effects.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10112233B1\",\n            \"title\": \"Previous Pain Relief Medication\"\n        }\n    ],\n    \"claims\": [\n        \"A pharmaceutical composition comprising...\",\n        \"A method of treating pain...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67866", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Sensor for Continuous Physiological Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"David Stark\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-11-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized wireless sensor system for continuous physiological monitoring of patients, providing real-time data for improved clinical decision-making and better patient outcomes. The device incorporates advanced sensing technologies to track vital signs and detect anomalies early.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor for physiological monitoring.\",\n        \"A system for real-time data transmission.\",\n        \"A method for improving patient care.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67866", "text": "{\n    \"patent_title\": \"Automated System for Pharmaceutical Compounding\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2024-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for precise and efficient pharmaceutical compounding, reducing errors and improving medication delivery. This system utilizes robotic arms and advanced software algorithms to ensure accurate ingredient mixing and dispensing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"An automated pharmaceutical compounding system.\",\n        \"A robotic arm for ingredient handling.\",\n        \"A software algorithm for precise mixing.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67867", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing image resolution using a deep convolutional neural network. The system improves image quality by learning a mapping from low-resolution to high-resolution images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising...\",\n        \"A system for enhancing image resolution comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67867", "text": "{\n    \"patent_title\": \"A Novel Data Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2017-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel data compression technique that significantly reduces file sizes without loss of information. The method utilizes advanced algorithms to identify and eliminate redundancies in data streams.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data comprising...\",\n        \"A system for compressing data comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67868", "text": "{\n    \"patent_title\": \"Remote Physiological Monitoring System and Method\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for remotely monitoring a patient's physiological parameters, including heart rate, blood pressure, and oxygen saturation. The system transmits data to a central monitoring station for analysis and alerts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8655555B2\",\n            \"relevance\": \"Prior art in remote monitoring\"\n        }\n    ],\n    \"claims\": [\n        \"A system for remotely monitoring a patient’s physiological parameters comprising...\",\n        \"A method for transmitting physiological data from a patient to a monitoring station...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67868", "text": "{\n    \"patent_title\": \"Improved Catheter Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MedTech Innovations Inc.\"\n        },\n        {\n            \"name\": \"David Green\",\n            \"affiliation\": \"MedTech Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel catheter design with improved flexibility and reduced patient discomfort during insertion. Features a tapered tip and lubricious coating.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7432109B2\",\n            \"relevance\": \"Related catheter technologies\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a tapered tip...\",\n        \"A lubricious coating for a catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67869", "text": "{\n    \"patent_title\": \"Remote Physiological Monitoring System and Method\",\n    \"inventors\": [\n        {\n            \"name\": \"David A. Schneider\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Michael P. Heller\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-12-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for remotely monitoring a patient's physiological parameters, including heart rate, blood pressure, and oxygen saturation.  The system utilizes wearable sensors and a cloud-based platform for data analysis and alerts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Wearable Health Monitoring Device\"\n        }\n    ],\n    \"claims\": [\n        \"A system for remotely monitoring a patient's physiological parameters...\",\n        \"A method for analyzing physiological data received from a wearable sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67869", "text": "{\n    \"patent_title\": \"Surgical Instrument with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Sarah Chen\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2021-05-20\",\n    \"filing_date\": \"2021-05-20\",\n    \"issue_date\": \"2023-11-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical instrument designed to enhance precision and reduce strain on the surgeon's hand. The instrument features a novel ergonomic handle and a micro-adjustable tip.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Ergonomic Surgical Tool\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising an ergonomic handle...\",\n        \"A surgical instrument with a micro-adjustable tip...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67870", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Cardiac Monitor with Wireless Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MedTech Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a miniaturized implantable cardiac monitor capable of continuously monitoring cardiac activity and wirelessly transmitting data to an external receiver. The device incorporates a novel energy harvesting system and a low-power communication protocol, enabling long-term operation without battery replacement.  The monitor uses advanced signal processing algorithms to detect and classify arrhythmias with high accuracy, and a biocompatible encapsulation ensures patient safety. It significantly improves patient care through early detection of cardiac events and remote monitoring capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8540721B2\",\n            \"kind\": \"Cited by Examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable cardiac monitor comprising...\",\n        \"A method for wirelessly transmitting cardiac data...\",\n        \"A system for detecting and classifying cardiac arrhythmias...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67870", "text": "{\n    \"patent_title\": \"Syringe with Improved Plunger Mechanism\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Baxter Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US8235678B1\",\n    \"priority_date\": \"2015-04-20\",\n    \"filing_date\": \"2015-04-20\",\n    \"issue_date\": \"2012-07-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A syringe with a modified plunger mechanism to improve fluid delivery. The plunger incorporates a silicone seal to prevent leakage.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A syringe comprising a barrel and a plunger...\",\n        \"The plunger having a silicone seal...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67871", "text": "{\n    \"patent_title\": \"Magnetic Resonance Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning approach for reconstructing magnetic resonance images with improved resolution and reduced artifacts, leading to enhanced diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images using a convolutional neural network.\",\n        \"A system for improving image quality in MRI.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67871", "text": "{\n    \"patent_title\": \"Ultrasound Signal Processing for Cardiac Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Alice Green\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-15\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"Improved signal processing techniques for ultrasound signals used in cardiac monitoring. Focuses on reducing noise and improving signal clarity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for filtering noise from ultrasound signals.\",\n        \"A system for analyzing cardiac ultrasound data.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67872", "text": "{\n    \"patent_title\": \"Improved MRI Reconstruction Algorithm for Enhanced Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel MRI reconstruction algorithm that utilizes deep learning to enhance image quality and improve the detection of small tumors. The algorithm significantly reduces noise and artifacts, leading to a marked increase in diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on MRI reconstruction techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"An MRI system configured to implement the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67872", "text": "{\n    \"patent_title\": \"Portable X-Ray Device for Veterinary Use\",\n    \"inventors\": [\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Zoetis\"\n        },\n        {\n            \"name\": \"Emily Wilson\",\n            \"affiliation\": \"Zoetis\"\n        }\n    ],\n    \"patent_number\": \"US11123456B2\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-11-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A portable X-ray device designed for veterinary applications. The device is lightweight and easy to use, providing quick and accurate diagnostic imaging for animals.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Previous designs for portable X-ray devices.\"\n        }\n    ],\n    \"claims\": [\n        \"A portable X-ray device comprising...\",\n        \"A method for using the portable X-ray device...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67873", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-06-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical system incorporating micro-robotics and advanced imaging to allow for less invasive procedures and improved patient outcomes. The system focuses on enhanced visualization and precise instrument control, leading to reduced recovery times and increased patient comfort.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising a micro-robotic arm...\",\n        \"A method for performing a minimally invasive procedure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67873", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Hospital\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"General Hospital\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-04-05\",\n    \"issue_date\": \"2023-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved catheter design for efficient and targeted drug delivery. The catheter features a novel tip configuration to enhance drug penetration into the target tissue.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\",\n            \"relevance\": \"Related to catheter tip designs\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a tip with a specific geometric profile...\",\n        \"A method for delivering a drug using the catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67874", "text": "{\n    \"patent_title\": \"Magnetic Resonance Fingerprinting with Deep Learning for Accelerated Cardiac Disease Diagnosis\",\n    \"inventors\": [\n        {\n            \"name\": \"David S. Bernstein\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Fan Long\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-07-15\",\n    \"filing_date\": \"2019-02-28\",\n    \"issue_date\": \"2021-12-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel method for accelerated cardiac disease diagnosis utilizing magnetic resonance fingerprinting (MRF) combined with deep learning algorithms. The technique allows for rapid and accurate quantification of myocardial tissue properties, enabling early detection of subtle pathological changes indicative of heart failure and ischemia.  The deep learning component significantly reduces scan times without compromising image quality or diagnostic accuracy. This represents a significant advancement over existing cardiac MRI techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Method for Cardiac Tissue Characterization\"\n        }\n    ],\n    \"claims\": [\n        \"A method for diagnosing cardiac disease comprising...\",\n        \"A system for performing magnetic resonance fingerprinting...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67874", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for X-Ray Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Maria Rodriguez\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-09-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel iodinated contrast agent for enhanced visualization of blood vessels during X-ray imaging. The agent exhibits improved solubility and reduced toxicity compared to existing contrast agents. It is suitable for use in angiography and computed tomography (CT) scans.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Iodinated Contrast Agent Composition\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"A method for visualizing blood vessels...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67875", "text": "{\n    \"patent_title\": \"Magnetic Resonance Elastography for Non-invasive Liver Fibrosis Assessment\",\n    \"inventors\": [\n        {\n            \"name\": \"Mary Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for non-invasively assessing liver fibrosis using magnetic resonance elastography (MRE). The technique provides quantitative measurements of liver stiffness, aiding in the diagnosis and monitoring of liver disease.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for assessing liver fibrosis comprising...\",\n        \"A system for performing magnetic resonance elastography...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67875", "text": "{\n    \"patent_title\": \"Automated X-Ray Image Analysis System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US1234567B2\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for analyzing X-ray images to detect fractures and other anomalies. The system utilizes machine learning algorithms to improve the speed and accuracy of image interpretation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for automatically analyzing X-ray images...\",\n        \"A method for detecting fractures in X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67876", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"David Utley\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system comprising a flexible endoscope with high-resolution imaging and robotic arms for precise tissue manipulation. The system is designed to improve patient outcomes by reducing incision size and recovery time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising a flexible endoscope and robotic arms.\",\n        \"A method for performing minimally invasive surgery using the surgical system.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67876", "text": "{\n    \"patent_title\": \"Drug Delivery System for Cancer Treatment\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Jones\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel drug delivery system using nanoparticles to target cancer cells. The system enhances drug efficacy and reduces side effects.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A drug delivery system comprising nanoparticles and a therapeutic agent.\",\n        \"A method for treating cancer using the drug delivery system.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67877", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-02-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for improving the quality of medical images reconstructed from raw data, using a novel iterative algorithm and noise reduction technique.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"cited_by\": \"Alice Johnson\"\n        },\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"cited_by\": \"Bob Williams\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"cited_by\": \"Alice Johnson\"\n        },\n        {\n            \"patent_number\": \"US8987654B1\",\n            \"cited_by\": \"Bob Williams\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"cited_by\": \"Alice Johnson\"\n        },\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"cited_by\": \"Bob Williams\"\n        },\n        {\n            \"patent_number\": \"US9234567B2\",\n            \"cited_by\": \"Alice Johnson\"\n        },\n        {\n            \"patent_number\": \"US8012345B1\",\n            \"cited_by\": \"Bob Williams\"\n        },\n        {\n            \"patent_number\": \"US9345678B2\",\n            \"cited_by\": \"Alice Johnson\"\n        },\n        {\n            \"patent_number\": \"US7901234B2\",\n            \"cited_by\": \"Bob Williams\"\n        },\n        {\n            \"patent_number\": \"US9456789B2\",\n            \"cited_by\": \"Alice Johnson\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"A system comprising a processor...\",\n        \"The method of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67877", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-07-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel contrast agent for magnetic resonance imaging, designed to enhance image clarity and improve diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"cited_by\": \"Charlie Brown\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"cited_by\": \"Charlie Brown\"\n        },\n        {\n            \"patent_number\": \"US9999999B2\",\n            \"cited_by\": \"Charlie Brown\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"The contrast agent of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67878", "text": "{\n    \"patent_title\": \"Method and system for improved image compression using wavelet transforms\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Adobe Systems\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for image compression utilizing wavelet transforms and adaptive quantization is presented. The system achieves significantly higher compression ratios with minimal loss of image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"count\": 50\n        },\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"count\": 35\n        },\n        {\n            \"patent_number\": \"US9234567B1\",\n            \"count\": 42\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image comprising...\",\n        \"A system for image compression comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67878", "text": "{\n    \"patent_title\": \"User interface for image viewing application\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Microsoft\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved user interface for an image viewing application, providing enhanced zoom and pan functionality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"count\": 5\n        },\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"count\": 3\n        }\n    ],\n    \"claims\": [\n        \"A user interface for displaying images comprising...\",\n        \"A method for zooming an image within a user interface comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67879", "text": "{\n    \"patent_title\": \"High-Performance Solid-State Electrolyte for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Princeton University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Princeton University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel solid-state electrolyte composition for lithium-ion batteries exhibiting enhanced ionic conductivity and electrochemical stability, enabling higher energy density and improved safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on solid-state electrolytes\"\n        }\n    ],\n    \"claims\": [\n        \"A solid-state electrolyte comprising...\",\n        \"A lithium-ion battery cell comprising the electrolyte of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67879", "text": "{\n    \"patent_title\": \"Method for Improving Combustion Efficiency in Internal Combustion Engines\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Jones\",\n            \"affiliation\": \"General Motors\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-03-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for optimizing the air-fuel mixture in internal combustion engines to enhance fuel efficiency and reduce emissions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related prior art on engine control systems\"\n        }\n    ],\n    \"claims\": [\n        \"A method of controlling the air-fuel ratio in an internal combustion engine...\",\n        \"An engine control system configured to implement the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67880", "text": "{\n    \"patent_title\": \"Improved MRI Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-12-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing MRI images using a deep learning algorithm, resulting in significantly improved image quality and diagnostic accuracy, particularly for early-stage cancer detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"MRI Image Enhancement\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI image reconstruction...\",\n        \"The method of claim 1, wherein the diagnostic accuracy is improved by at least 10%.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67880", "text": "{\n    \"patent_title\": \"Improved X-Ray Shielding Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2019-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new composite material for shielding against X-ray radiation, reducing exposure to patients and medical personnel.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Lead-Based X-Ray Shielding\"\n        }\n    ],\n    \"claims\": [\n        \"A shielding material comprising...\",\n        \"A method for manufacturing the shielding material...\",\n        \"The shielding material of claim 1, with a radiation attenuation factor of at least 95%.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67881", "text": "{\n    \"patent_title\": \"Method for Reducing Artifacts in Computed Tomography Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method for reducing streak artifacts in computed tomography (CT) images by employing an iterative reconstruction algorithm with a novel regularization term. This results in improved image clarity and potentially reduced radiation dose for patients.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8780523B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a CT image comprising...\",\n        \"The method of claim 1, wherein the regularization term minimizes the total variation of the reconstructed image.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67881", "text": "{\n    \"patent_title\": \"System for Automated Drug Dispensing\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-08-22\",\n    \"filing_date\": \"2017-08-21\",\n    \"issue_date\": \"2021-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an automated system for dispensing pharmaceutical drugs in a hospital setting, utilizing robotic arms and barcode scanning for accurate medication delivery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"An automated drug dispensing system comprising...\",\n        \"The system of claim 1, wherein the robotic arm is capable of handling multiple medications simultaneously.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67882", "text": "{\n    \"patent_title\": \"Lithium-ion Battery with Enhanced Electrolyte for Improved Cycle Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery featuring a novel electrolyte composition that significantly enhances cycle life and reduces capacity fade. The electrolyte incorporates a proprietary additive that stabilizes the solid electrolyte interphase (SEI), leading to improved performance and longevity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"relevance\": \"Cited as prior art relating to electrolyte compositions.\"\n        },\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"relevance\": \"Cited as enabling technology for SEI layer stabilization.\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Cited as a related advance in battery technology.\"\n        },\n        {\n            \"patent_number\": \"US11123456B2\",\n            \"relevance\": \"Cited as a key background reference.\"\n        },\n        {\n            \"patent_number\": \"US12123456B2\",\n            \"relevance\": \"Cited as foundational work in the field.\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising: an anode; a cathode; and an electrolyte comprising a lithium salt, a solvent, and a SEI stabilizing additive.\",\n        \"The lithium-ion battery of claim 1, wherein the SEI stabilizing additive is a fluorinated organic compound.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67882", "text": "{\n    \"patent_title\": \"Improved Connector for Charging Portable Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Apple Inc.\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2014-12-15\",\n    \"filing_date\": \"2014-12-15\",\n    \"issue_date\": \"2017-05-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel connector design for charging portable electronic devices. The connector features a self-aligning mechanism and improved durability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Cited as prior art relating to connector designs.\"\n        }\n    ],\n    \"claims\": [\n        \"A connector for charging a portable electronic device, comprising: a housing; a plurality of contacts; and a self-aligning mechanism.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67883", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing high-resolution images from low-resolution data using advanced algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Similar approach\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related technique\"\n        },\n        {\n            \"patent_number\": \"US9456789B1\",\n            \"relevance\": \"Building upon this work\"\n        },\n        {\n            \"patent_number\": \"US10234567B2\",\n            \"relevance\": \"Further development\"\n        },\n        {\n            \"patent_number\": \"US11345678B1\",\n            \"relevance\": \"Comparison and improvement\"\n        },\n        {\n            \"patent_number\": \"US12456789B2\",\n            \"relevance\": \"Alternative method\"\n        },\n        {\n            \"patent_number\": \"US13567890B1\",\n            \"relevance\": \"Combined approach\"\n        },\n        {\n            \"patent_number\": \"US14678901B2\",\n            \"relevance\": \"Extension of the method\"\n        },\n        {\n            \"patent_number\": \"US15789012B1\",\n            \"relevance\": \"Application to different domain\"\n        },\n        {\n            \"patent_number\": \"US16890123B2\",\n            \"relevance\": \"Further enhancement\"\n        },\n        {\n            \"patent_number\": \"US17901234B1\",\n            \"relevance\": \"Improved performance\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing images...\",\n        \"A system for implementing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67883", "text": "{\n    \"patent_title\": \"Basic Image Filtering Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US8901234B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2018-09-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A simple image filtering technique for noise reduction.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related filter\"\n        },\n        {\n            \"patent_number\": \"US8543210B1\",\n            \"relevance\": \"Similar concept\"\n        }\n    ],\n    \"claims\": [\n        \"A method for filtering images...\",\n        \"A system utilizing the filtering method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67884", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction for Enhanced Diagnostic Accuracy in MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"This invention provides methods and systems for improved image reconstruction in Magnetic Resonance Imaging (MRI) that significantly enhance diagnostic accuracy, particularly in the detection of subtle abnormalities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8785432B1\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image...\",\n        \"A system comprising a processor...\",\n        \"The method of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67884", "text": "{\n    \"patent_title\": \"Novel Contrast Agent for Enhanced MRI Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"University of Barcelona\"\n        }\n    ],\n    \"patent_number\": \"EP3456789A1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2018-11-07\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"A new contrast agent designed to improve the visualization of soft tissues in MRI scans, leading to clearer images and potentially aiding in diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising a gadolinium complex...\",\n        \"A method for enhancing MRI images using...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67885", "text": "{\n    \"patent_title\": \"Improved Gradient Descent Optimization for Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-06-01\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an improved gradient descent algorithm for training deep neural networks, resulting in faster convergence and better generalization performance. The algorithm incorporates a novel momentum scheduling strategy and adaptive learning rate adjustment.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Deep Neural Networks with Momentum\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Adaptive Learning Rate Methods for Deep Learning\"\n        },\n        {\n            \"patent_number\": \"US11000001B2\",\n            \"title\": \"Stochastic Gradient Descent with Variance Reduction\"\n        },\n        {\n            \"patent_number\": \"US10500002B2\",\n            \"title\": \"Second-Order Optimization Methods for Deep Learning\"\n        },\n        {\n            \"patent_number\": \"US11111111B2\",\n            \"title\": \"Regularization Techniques for Deep Neural Networks\"\n        }\n    ],\n    \"claims\": [\n        \"A method for training a deep neural network comprising...\",\n        \"The method of claim 1, wherein the momentum scheduling strategy is...\",\n        \"The method of claim 1, wherein the adaptive learning rate adjustment is...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67885", "text": "{\n    \"patent_title\": \"Novel Quantum Machine Learning Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"IBM Research\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-09-20\",\n    \"filing_date\": \"2022-03-10\",\n    \"issue_date\": \"2023-07-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention introduces a fundamentally new machine learning algorithm based on quantum computing principles. It leverages superposition and entanglement to achieve exponential speedups over classical algorithms for certain machine learning tasks.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Deep Neural Networks with Momentum\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Adaptive Learning Rate Methods for Deep Learning\"\n        },\n        {\n            \"patent_number\": \"US11000001B2\",\n            \"title\": \"Stochastic Gradient Descent with Variance Reduction\"\n        }\n    ],\n    \"claims\": [\n        \"A quantum machine learning algorithm comprising...\",\n        \"The algorithm of claim 1, wherein superposition is used to...\",\n        \"The algorithm of claim 1, wherein entanglement is used to...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67886", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Cardiac Monitor with Enhanced Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"James Harding\",\n            \"affiliation\": \"MedTech Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2021-12-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable cardiac monitor provides real-time data transmission and enhanced diagnostic capabilities, leading to earlier detection of cardiac events and improved patient management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art in implantable sensors\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable cardiac monitor comprising...\",\n        \"A system for real-time cardiac data transmission...\",\n        \"A method for detecting cardiac arrhythmias...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67886", "text": "{\n    \"patent_title\": \"Automated Pill Dispenser with Timer Function\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Miller\",\n            \"affiliation\": \"PharmAssist Solutions\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2021-06-01\",\n    \"filing_date\": \"2021-06-01\",\n    \"issue_date\": \"2022-09-13\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated pill dispenser with a programmable timer to ensure medication adherence. Provides reminders and tracks pill usage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art related to automated medication delivery systems\"\n        }\n    ],\n    \"claims\": [\n        \"An automated pill dispenser comprising...\",\n        \"A timer mechanism for dispensing pills...\",\n        \"A user interface for programming medication schedules...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67887", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction for Enhanced Cardiac MRI Diagnostics\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-09\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"This invention provides a novel image reconstruction algorithm for cardiac magnetic resonance imaging (MRI) that significantly enhances image quality and diagnostic accuracy, allowing for better visualization of cardiac structures and function.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in MRI image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"An MRI system configured to implement the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67887", "text": "{\n    \"patent_title\": \"Method for Improved Contrast in X-Ray Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"Philips Healthcare\"\n        }\n    ],\n    \"patent_number\": \"EP3123456B1\",\n    \"priority_date\": \"2015-07-20\",\n    \"filing_date\": \"2015-07-20\",\n    \"issue_date\": \"2018-11-14\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"The present invention relates to a method for improving the contrast in X-ray images, facilitating better visualization of anatomical structures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related to X-ray image enhancement techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing contrast in X-ray images...\",\n        \"An X-ray system incorporating the method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67888", "text": "{\n    \"patent_title\": \"Enhanced MRI Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-11-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing Magnetic Resonance Images (MRI) using deep convolutional neural networks. This technique significantly improves image quality and reduces scan time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image...\",\n        \"A system for performing MRI image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67888", "text": "{\n    \"patent_title\": \"Improved X-Ray Tube Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Philips Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9234567B1\",\n    \"priority_date\": \"2014-12-20\",\n    \"filing_date\": \"2014-12-20\",\n    \"issue_date\": \"2016-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new design for an X-ray tube that improves efficiency and reduces heat generation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube comprising...\",\n        \"A method for manufacturing an X-ray tube...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67889", "text": "{\n    \"patent_title\": \"Improved MRI Image Reconstruction for Enhanced Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method for reconstructing MRI images, leading to significantly improved visualization of tumors and enhanced diagnostic accuracy. The method utilizes a deep learning algorithm trained on a large dataset of MRI scans.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for enhanced tumor detection utilizing the method of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67889", "text": "{\n    \"patent_title\": \"New Catheter Design for Vascular Access\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Medical Devices Inc.\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Medical Devices Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11223344B2\",\n    \"priority_date\": \"2017-09-20\",\n    \"filing_date\": \"2017-09-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a new catheter design incorporating a flexible tip and improved lumen configuration for easier vascular access. The design reduces patient discomfort and improves procedural efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible distal tip...\",\n        \"A method of vascular access utilizing the catheter of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67890", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Enhanced Biocompatibility\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor with a novel biocompatible coating for long-term monitoring of glucose levels in diabetic patients.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A glucose sensor comprising a biocompatible coating.\",\n        \"A method for continuous glucose monitoring using the sensor.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67890", "text": "{\n    \"patent_title\": \"Novel Surgical Stapler Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2021-03-01\",\n    \"filing_date\": \"2021-06-15\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical stapler with an improved ergonomic handle for enhanced precision and ease of use.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler with an ergonomic handle.\",\n        \"A method for performing surgical stapling using the device.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67891", "text": "{\n    \"patent_title\": \"Deep Convolutional Neural Networks for High-Resolution Image Classification\",\n    \"inventors\": [\n        {\n            \"name\": \"Alex Krizhevsky\",\n            \"affiliation\": \"University of Toronto\"\n        },\n        {\n            \"name\": \"Ilya Sutskever\",\n            \"affiliation\": \"University of Toronto\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"patent_number\": \"US9483075B2\",\n    \"priority_date\": \"2016-09-15\",\n    \"filing_date\": \"2017-03-08\",\n    \"issue_date\": \"2016-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep convolutional neural network architecture is presented for image classification. The network achieves state-of-the-art results on the ImageNet dataset.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8724539B1\",\n            \"relevance\": \"Prior Art\"\n        },\n        {\n            \"patent_number\": \"US9274220B2\",\n            \"relevance\": \"Related Application\"\n        },\n        {\n            \"patent_number\": \"US9389313B2\",\n            \"relevance\": \"Cited by Examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A method for classifying images using a deep convolutional neural network.\",\n        \"A computer system for implementing the method.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67891", "text": "{\n    \"patent_title\": \"System and Method for Basic Image Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"ABC Corporation\"\n        }\n    ],\n    \"patent_number\": \"US8503211B2\",\n    \"priority_date\": \"2012-05-10\",\n    \"filing_date\": \"2013-01-15\",\n    \"issue_date\": \"2013-08-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for compressing images using a simple algorithm. This improves storage efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"relevance\": \"Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image.\",\n        \"A system implementing the compression method.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67892", "text": "{\n    \"patent_title\": \"Enhanced Medical Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing medical images using a deep convolutional neural network, resulting in significantly improved image clarity and reduced noise. This allows for more accurate diagnosis of subtle pathologies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image denoising\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"A system comprising a deep learning model...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67892", "text": "{\n    \"patent_title\": \"Automated Dental X-ray Analysis System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2022-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for automatically analyzing dental x-rays to detect cavities and other dental issues. The system uses image processing techniques to identify areas of concern.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Previous work in dental image analysis\"\n        }\n    ],\n    \"claims\": [\n        \"A system for analyzing dental x-rays...\",\n        \"A method for detecting cavities...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67893", "text": "{\n    \"patent_title\": \"High-Resolution Optical Coherence Tomography System with Adaptive Optics\",\n    \"inventors\": [\n        {\n            \"name\": \"David Huang\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"James Fujimoto\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876453B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A high-resolution optical coherence tomography (OCT) system incorporating adaptive optics to correct for aberrations in the sample, enabling significantly improved image quality and resolution. This allows for detailed visualization of retinal structures for early detection of diseases.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8203689B2\"\n        },\n        {\n            \"patent_number\": \"US7318064B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for imaging a sample using OCT with adaptive optics correction.\",\n        \"An OCT system comprising an adaptive optics module.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67893", "text": "{\n    \"patent_title\": \"Improved X-Ray Detector for Mammography\",\n    \"inventors\": [\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US8922634B2\",\n    \"priority_date\": \"2013-10-28\",\n    \"filing_date\": \"2013-10-28\",\n    \"issue_date\": \"2014-12-30\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved X-ray detector with enhanced sensitivity and reduced noise for mammography applications, leading to clearer images and more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7952841B2\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray detector with a novel scintillator material.\",\n        \"A mammography system utilizing the improved detector.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67894", "text": "{\n    \"patent_title\": \"Method for Enhanced MRI Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method for improving the quality and speed of MRI image reconstruction, addressing the need for faster and more accurate diagnoses in critical care settings.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"title\": \"MRI Pulse Sequence Optimization\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"An apparatus for performing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67894", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Angiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2015-12-20\",\n    \"filing_date\": \"2015-12-20\",\n    \"issue_date\": \"2019-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel catheter design for improved navigation and visualization during angiography procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Angiography Catheter with Enhanced Flexibility\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising...\",\n        \"A method for using the catheter of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67895", "text": "{\n    \"patent_title\": \"Nanoparticle-Mediated Targeted Drug Delivery System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-06-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel drug delivery system utilizing biocompatible nanoparticles for targeted delivery of therapeutic agents to cancerous tumors. The nanoparticles are surface-modified with targeting ligands to enhance cellular uptake and minimize off-target effects. The system demonstrates improved efficacy and reduced toxicity in pre-clinical models.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A drug delivery system comprising biocompatible nanoparticles.\",\n        \"The drug delivery system of claim 1, wherein the nanoparticles are surface-modified with targeting ligands.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67895", "text": "{\n    \"patent_title\": \"Improved Medical Imaging Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-04-05\",\n    \"issue_date\": \"2023-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved method for magnetic resonance imaging (MRI), allowing for enhanced resolution and reduced scan times. The technique employs advanced signal processing algorithms to reconstruct high-quality images from limited data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for MRI comprising advanced signal processing.\",\n        \"The method of claim 1, wherein the signal processing algorithm reduces scan time.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67896", "text": "{\n    \"patent_title\": \"Improved MRI Reconstruction Algorithm for Enhanced Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel MRI reconstruction algorithm employing deep learning techniques to improve the signal-to-noise ratio and enhance the detection of small tumors. The improved image quality leads to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in MRI reconstruction.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67896", "text": "{\n    \"patent_title\": \"Portable X-Ray Device for Emergency Situations\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        },\n        {\n            \"name\": \"Eve Franklin\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Frank Green\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-01\",\n    \"issue_date\": \"2023-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A compact and portable X-ray device designed for rapid deployment in emergency medical scenarios. The device provides high-resolution imaging capabilities in a lightweight and durable package.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related technology in portable imaging.\"\n        }\n    ],\n    \"claims\": [\n        \"A portable X-ray device comprising...\",\n        \"A system for image acquisition...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67897", "text": "{\n    \"patent_title\": \"Low-Light Image Enhancement Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2021-11-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel deep learning approach for enhancing images captured in low-light environments. The system utilizes a convolutional neural network architecture to effectively reduce noise and improve visibility without introducing artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Noise Reduction Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing a low-light image comprising...\",\n        \"A system for processing images in low-illumination conditions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67897", "text": "{\n    \"patent_title\": \"Method for Compressing Video Data\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-12-10\",\n    \"filing_date\": \"2019-03-01\",\n    \"issue_date\": \"2020-09-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a new algorithm for efficiently compressing video data for storage and transmission. The method employs a combination of wavelet transforms and entropy coding.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10111222B1\",\n            \"title\": \"Efficient Video Coding Schemes\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing video data comprising...\",\n        \"A system for encoding video streams...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67898", "text": "{\n    \"patent_title\": \"Patient Comfort System for Minimally Invasive Surgery\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9782543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-09-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A medical device designed to enhance patient comfort during minimally invasive surgical procedures. The device utilizes temperature regulation and gentle pressure application to minimize discomfort and anxiety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8991748B2\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A medical device comprising a temperature regulation system.\",\n        \"A medical device comprising a pressure application module.\",\n        \"A method for improving patient comfort during surgery.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67898", "text": "{\n    \"patent_title\": \"Surgical Stapler with Enhanced Cutting Mechanism\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Johnson & Johnson\"\n        }\n    ],\n    \"patent_number\": \"US9545678B1\",\n    \"priority_date\": \"2016-11-20\",\n    \"filing_date\": \"2016-11-20\",\n    \"issue_date\": \"2017-03-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical stapler design incorporating an improved cutting mechanism for more precise tissue resection. It reduces tissue damage and improves surgical outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an improved cutting mechanism.\",\n        \"A method for precise tissue resection using the stapler.\",\n        \"A surgical stapler with reduced tissue damage.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67899", "text": "{\n    \"patent_title\": \"Remote Physiological Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A remote patient monitoring system utilizing wearable sensors and a cloud-based platform for real-time data analysis and alerts. The system improves patient care by enabling early detection of health deterioration.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A remote patient monitoring system comprising: a wearable sensor...\",\n        \"A method for analyzing physiological data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67899", "text": "{\n    \"patent_title\": \"Surgical Instrument Handle\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2021-09-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved handle design for surgical instruments, enhancing ergonomics and precision during operations.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument handle comprising: a grip portion...\",\n        \"A locking mechanism for securing the instrument...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67900", "text": "{\n    \"patent_title\": \"Deep Learning System for Real-Time Object Detection in Autonomous Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Serge Belongie\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep learning system for rapidly and accurately identifying objects in images and video streams. This system is designed for use in autonomous vehicles to enhance safety and navigation capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for object detection comprising a convolutional neural network...\",\n        \"A method for real-time object recognition in a vehicle...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67900", "text": "{\n    \"patent_title\": \"Novel Mathematical Framework for Image Feature Extraction\",\n    \"inventors\": [\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2022-10-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new mathematical framework for extracting robust features from images, leveraging advanced algebraic topology.  This provides a theoretical foundation for improved image analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for feature extraction based on persistent homology...\",\n        \"A mathematical representation of image data utilizing topological invariants...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67901", "text": "{\n    \"patent_title\": \"Implantable Cardiac Monitor with Enhanced Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"Boston Medical Devices Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-04-20\",\n    \"issue_date\": \"2023-11-07\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"An implantable cardiac monitor designed to improve patient outcomes by providing real-time data transmission of electrocardiogram (ECG) signals. This device aids in early detection of arrhythmias and other cardiovascular health issues, facilitating prompt medical intervention and reducing hospital readmissions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art relating to implantable cardiac devices.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for continuously monitoring cardiac activity.\",\n        \"An implantable device comprising a sensor and a transmitter.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67901", "text": "{\n    \"patent_title\": \"Surgical Instrument for Orthopedic Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emily Wilson\",\n            \"affiliation\": \"Acme Surgical Solutions\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-02-15\",\n    \"issue_date\": \"2023-09-12\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A surgical instrument designed for precise bone cutting and shaping during orthopedic procedures, improving surgical accuracy and reducing patient recovery time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related art concerning surgical instruments.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising a cutting blade and a handle.\",\n        \"A method for performing a bone cut using the surgical instrument.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67902", "text": "{\n    \"patent_title\": \"Improved Method for Early Cancer Detection using Dynamic Contrast-Enhanced MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for enhancing the contrast in dynamic MRI scans, enabling earlier and more accurate detection of cancerous tumors. The method utilizes a specific pulse sequence and image processing algorithm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8652212B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for dynamic contrast-enhanced MRI comprising...\",\n        \"An image processing algorithm for tumor detection...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67902", "text": "{\n    \"patent_title\": \"Novel Algorithm for Image Compression in Radiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-09-20\",\n    \"filing_date\": \"2017-09-20\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an efficient algorithm for compressing radiographic images, reducing storage space and transmission bandwidth. The algorithm employs wavelet transform and entropy encoding.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7541123B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image compression using wavelet transform...\",\n        \"An algorithm for entropy encoding of radiographic data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67903", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-06-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing high-resolution medical images from low-dose scans, utilizing deep learning techniques to reduce noise and improve clarity. This invention allows for more accurate diagnosis with reduced radiation exposure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Image Denoising Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"A system comprising a processor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67903", "text": "{\n    \"patent_title\": \"System for Color Image Enhancement in Digital Cameras\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Sony Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-05-20\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2020-12-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for automatically enhancing the color saturation and contrast of images captured by digital cameras, improving the visual appeal of photographs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Automatic Color Correction Method\"\n        }\n    ],\n    \"claims\": [\n        \"A system for enhancing the color of an image...\",\n        \"A method comprising adjusting the color balance...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67904", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2021-03-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a minimally invasive surgical system with enhanced visualization capabilities, significantly improving patient outcomes in complex procedures by reducing recovery time and minimizing scarring.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising...\",\n        \"A method for performing a minimally invasive procedure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67904", "text": "{\n    \"patent_title\": \"Drug Delivery Device for Targeted Therapy\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-04-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel drug delivery device designed for targeted therapy, improving the efficacy of pharmaceutical treatments. The device utilizes microfluidics to precisely control drug release.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A drug delivery device comprising...\",\n        \"A method for delivering a therapeutic agent...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67905", "text": "{\n    \"patent_title\": \"Improved Medical Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing medical images from raw data using deep learning techniques, resulting in improved image quality and diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"A system for performing medical image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67905", "text": "{\n    \"patent_title\": \"New Contrast Agent for MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-01\",\n    \"issue_date\": \"2023-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel contrast agent for use in magnetic resonance imaging (MRI), enhancing image contrast and visibility of specific tissues.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"relevance\": \"Related contrast agent technology\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"A method for enhancing MRI images using the contrast agent...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67906", "text": "{\n    \"patent_title\": \"Non-Invasive Glucose Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2014-03-15\",\n    \"filing_date\": \"2015-05-20\",\n    \"issue_date\": \"2019-06-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive system for continuous glucose monitoring using optical sensors. The device analyzes skin reflectance to determine glucose levels without requiring blood samples.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in optical glucose sensing\"\n        }\n    ],\n    \"claims\": [\n        \"A system for non-invasive glucose monitoring comprising...\",\n        \"A method for determining glucose levels...\",\n        \"An optical sensor configured to...\",\n        \"A data processing unit...\",\n        \"A display unit...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67906", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Locking Mechanism\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Johnson & Johnson\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2013-11-01\",\n    \"filing_date\": \"2014-04-10\",\n    \"issue_date\": \"2018-02-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler with a novel locking mechanism to prevent accidental firing. The stapler is designed for use in minimally invasive surgery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art in surgical stapler design\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"A locking mechanism...\",\n        \"A firing mechanism...\",\n        \"A cartridge...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67907", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"David Utley\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Sarah Chen\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel minimally invasive surgical system utilizing advanced fiber optic technology and a robotic arm for precise tissue manipulation. The system offers enhanced visualization and reduces patient trauma compared to traditional surgical methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A minimally invasive surgical system comprising...\",\n        \"A method for performing a surgical procedure using the system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67907", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Vascular Access\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel catheter design for improved vascular access, reducing the risk of complications during central line placement. The catheter incorporates a flexible tip and a biocompatible coating.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible distal tip...\",\n        \"A method for inserting a catheter into a blood vessel...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67908", "text": "{\n    \"patent_title\": \"Magnetic Resonance Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing magnetic resonance images (MRI) using deep learning techniques, enhancing image quality and reducing scan time. This method improves diagnostic accuracy for various medical conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for improving MRI image quality...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67908", "text": "{\n    \"patent_title\": \"Improved X-Ray Image Enhancement with Digital Filtering\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a digital filtering technique to enhance the quality of X-ray images, improving contrast and clarity for better diagnostic capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing X-ray images using digital filters...\",\n        \"A system for processing X-ray images with improved contrast...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67909", "text": "{\n    \"patent_title\": \"Patient-Comfortable Prolonged-Wear Medical Interface\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"Boston Children's Hospital\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel medical interface designed for prolonged patient contact, featuring dynamic pressure redistribution and temperature regulation to minimize discomfort and skin breakdown during extended medical procedures like dialysis or MRI scans. The interface utilizes a bio-compatible, self-adjusting polymer matrix.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8545678B1\",\n            \"relevance\": \"Prior art related to pressure mapping\"\n        }\n    ],\n    \"claims\": [\n        \"A medical interface comprising a self-adjusting polymer matrix.\",\n        \"The medical interface of claim 1, further comprising a temperature regulation system.\",\n        \"The medical interface of claim 1, adapted for prolonged patient contact.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67909", "text": "{\n    \"patent_title\": \"Automated Surgical Tool Positioning System\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-09-20\",\n    \"filing_date\": \"2017-09-20\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for precise positioning of surgical instruments during minimally invasive procedures. The system utilizes robotic arms and image guidance to enhance surgical accuracy and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Prior art related to robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical tool positioning system comprising a robotic arm.\",\n        \"The system of claim 1, further comprising an image guidance module.\",\n        \"The system of claim 1, configured for minimally invasive procedures.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67910", "text": "{\n    \"patent_title\": \"Adaptive Image Enhancement for Low-Light Conditions\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-01-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for adaptively enhancing the visual quality of images captured under low-light conditions. The system utilizes a novel algorithm to dynamically adjust contrast and brightness based on image characteristics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image...\",\n        \"A system comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67910", "text": "{\n    \"patent_title\": \"Network Routing Optimization Protocol\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-20\",\n    \"filing_date\": \"2019-05-20\",\n    \"issue_date\": \"2022-04-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A protocol for optimizing data routing within a network infrastructure. The protocol dynamically adjusts routing paths to minimize latency and maximize throughput.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10111213B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for routing data packets...\",\n        \"A network device configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67911", "text": "{\n    \"patent_title\": \"Improved Resolution Medical Imaging System Utilizing Novel Reconstruction Algorithms\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-05-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A medical imaging system employing advanced reconstruction algorithms to significantly enhance image resolution and improve diagnostic accuracy. The system utilizes a novel iterative process to reduce noise and artifacts, resulting in clearer and more detailed images for improved clinical analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8213123B1\",\n            \"relevance\": \"Prior art in image reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A medical imaging system comprising: an image acquisition module; and a reconstruction module configured to apply a novel iterative algorithm to reconstruct images with improved resolution.\",\n        \"The system of claim 1, wherein the iterative algorithm reduces noise and artifacts in the reconstructed images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67911", "text": "{\n    \"patent_title\": \"Method for Patient Scheduling in a Radiology Department\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10456789B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2019-02-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for efficiently scheduling patients for radiology examinations, optimizing resource allocation and reducing wait times. The system utilizes a predictive algorithm to forecast patient demand and adjust schedules accordingly.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"relevance\": \"Prior art in patient scheduling\"\n        }\n    ],\n    \"claims\": [\n        \"A method for scheduling patients for radiology examinations, comprising: receiving a patient request; predicting a patient demand; and allocating a time slot based on the predicted demand.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67912", "text": "{\n    \"patent_title\": \"Deep Learning for Image Recognition with Enhanced Accuracy\",\n    \"inventors\": [\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-08-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep learning system for image recognition utilizing convolutional neural networks with novel activation functions to achieve superior accuracy compared to existing methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        },\n        {\n            \"patent_number\": \"US11234567B1\"\n        },\n        {\n            \"patent_number\": \"US12112233B2\"\n        },\n        {\n            \"patent_number\": \"US13131415B1\"\n        },\n        {\n            \"patent_number\": \"US14151617B2\"\n        }\n    ],\n    \"claims\": [\n        \"A deep learning system for image recognition...\",\n        \"A method for training a convolutional neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67912", "text": "{\n    \"patent_title\": \"Method for Optimizing Data Storage in Cloud Environments\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2020-03-01\",\n    \"filing_date\": \"2020-05-15\",\n    \"issue_date\": \"2021-11-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for optimizing data storage and retrieval in cloud computing environments, reducing latency and improving efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US91234567B1\"\n        },\n        {\n            \"patent_number\": \"US10234567B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for optimizing data storage...\",\n        \"A system for cloud-based data retrieval...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67913", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging Technique for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel magnetic resonance imaging (MRI) technique that enhances the detection of early-stage cancerous tumors by improving image contrast and resolution. The technique utilizes a unique pulse sequence and image reconstruction algorithm, leading to improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"MRI Contrast Enhancement Methods\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI comprising...\",\n        \"An MRI system configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67913", "text": "{\n    \"patent_title\": \"Advanced Ultrasound Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an advanced ultrasound imaging system for real-time visualization of internal organs. It offers improved image clarity and portability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"MRI Image Reconstruction Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"An ultrasound system comprising...\",\n        \"A method for generating ultrasound images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67914", "text": "{\n    \"patent_title\": \"High-Efficiency Wireless Power Transfer System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2021-02-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel wireless power transfer system utilizing resonant inductive coupling for high efficiency and long-range power delivery. The system incorporates advanced control algorithms to optimize power transfer and minimize losses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless power transfer system comprising...\",\n        \"A method for optimizing power transfer efficiency...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67914", "text": "{\n    \"patent_title\": \"Improved Antenna Design for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Emily Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2019-11-20\",\n    \"filing_date\": \"2019-11-20\",\n    \"issue_date\": \"2022-04-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved antenna design for mobile devices utilizing a multi-band configuration for enhanced signal reception and transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"An antenna for a mobile device comprising...\",\n        \"A method for improving signal reception...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67915", "text": "{\n    \"patent_title\": \"Advanced Modulation Techniques for 5G Wireless Systems\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Qualcomm Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-12-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention introduces novel modulation schemes for 5G wireless communication, achieving significantly higher data rates and improved spectral efficiency. The proposed techniques combine orthogonal time frequency space (OTFS) modulation with adaptive coding and modulation (ACM) strategies.  Detailed simulations and experimental results demonstrate the superior performance compared to existing 5G standards.  The system also incorporates a dynamic resource allocation algorithm to optimize network capacity and reduce latency. This allows for more reliable and faster wireless connections in challenging environments.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on OTFS modulation.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for transmitting data in a wireless communication system...\",\n        \"An apparatus comprising a modulator configured to perform OTFS modulation...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67915", "text": "{\n    \"patent_title\": \"Improved Antenna Design for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Apple Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2020-01-20\",\n    \"filing_date\": \"2020-07-15\",\n    \"issue_date\": \"2022-05-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an antenna design for mobile devices. The antenna is optimized for size and performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Previous antenna designs.\"\n        }\n    ],\n    \"claims\": [\n        \"An antenna for a mobile device...\",\n        \"A mobile device comprising the antenna...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67916", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Sepsis Diagnosis and Personalized Treatment\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Chen\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-07-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for rapid detection of biomarkers associated with sepsis, enabling faster diagnosis and personalized antibiotic treatment. This leads to improved patient survival rates and reduced healthcare costs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8545789B2\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for diagnosing sepsis...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67916", "text": "{\n    \"patent_title\": \"Improved Algorithm for Image Compression in Medical Scanners\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-15\",\n    \"issue_date\": \"2020-03-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved algorithm for compressing medical images, reducing storage requirements and transmission times. This algorithm utilizes wavelet transforms and entropy encoding to achieve higher compression ratios.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a medical image...\",\n        \"A system for storing and transmitting compressed medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67917", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical Device with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-11-20\",\n    \"issue_date\": \"2021-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical device designed for minimally invasive procedures. The device incorporates a high-resolution camera and articulated instruments to improve surgical precision and reduce patient trauma.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art in minimally invasive surgery.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical device comprising a camera and articulated instruments.\",\n        \"A method for performing minimally invasive surgery using the device.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67917", "text": "{\n    \"patent_title\": \"Automated System for Pharmaceutical Compounding\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-12-01\",\n    \"filing_date\": \"2019-06-15\",\n    \"issue_date\": \"2022-01-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for precise and efficient compounding of pharmaceutical drugs. The system minimizes human error and ensures consistent drug quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Relevant prior art in pharmaceutical automation.\"\n        }\n    ],\n    \"claims\": [\n        \"An automated system for compounding drugs.\",\n        \"A method for controlling drug dosage using the system.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67918", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2020-08-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the analysis of medical images using deep learning techniques. The system improves the accuracy of diagnoses by identifying subtle anomalies in images such as X-rays, MRIs, and CT scans.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Prior Art Image Processing Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing medical images comprising...\",\n        \"A system for analyzing medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67918", "text": "{\n    \"patent_title\": \"Advanced Image Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Hans Schmidt\",\n            \"affiliation\": \"Technical University of Munich\"\n        }\n    ],\n    \"patent_number\": \"EP3456789B1\",\n    \"priority_date\": \"2018-03-10\",\n    \"filing_date\": \"2018-03-10\",\n    \"issue_date\": \"2020-04-15\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"An improved algorithm for compressing digital images, reducing storage space and transmission bandwidth.  Applicable to a wide range of image types, including photographs and video.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Basic Image Compression Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing digital images...\",\n        \"A system for encoding and decoding images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67919", "text": "{\n    \"patent_title\": \"Enhanced Image Processing for Low-Light Environments\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-09-20\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image processing algorithm for enhancing image quality in low-light conditions, utilizing a combination of noise reduction and contrast enhancement techniques. The algorithm improves visibility and detail in images captured in challenging environments.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Noise Reduction Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing an image captured in low-light conditions, comprising...\",\n        \"An apparatus for enhancing image quality, including...\",\n        \"A system for improving visibility in challenging environments...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67919", "text": "{\n    \"patent_title\": \"Digital Signal Processing for Audio Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-05-05\",\n    \"issue_date\": \"2022-01-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for enhancing the quality of audio signals by reducing noise and improving clarity. This algorithm is applicable to various audio sources, including music, speech, and environmental sounds.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Audio Noise Cancellation System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing an audio signal to reduce noise...\",\n        \"An apparatus for enhancing audio clarity...\",\n        \"A system for improving audio quality...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67920", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Enhancement for Low-Light Conditions\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for enhancing images captured in low-light conditions. The system addresses the limitations of existing techniques by utilizing a generative adversarial network (GAN) trained on a large dataset of low-light and normal-light images, resulting in significantly improved image quality and detail.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing images captured in low-light conditions comprising...\",\n        \"A deep learning model configured to...\",\n        \"A system for automatically...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67920", "text": "{\n    \"patent_title\": \"Method for Color Correction in Digital Photographs\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Adobe Systems\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-12-10\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2021-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for improving the color balance in digital photographs using a histogram equalization technique. This allows users to correct color casts and enhance the overall visual appeal of their images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for color correction comprising...\",\n        \"A system for adjusting color balance...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67921", "text": "{\n    \"patent_title\": \"Comfortable and Adjustable Wearable Medical Sensor\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-05-15\",\n    \"filing_date\": \"2020-08-20\",\n    \"issue_date\": \"2021-11-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wearable medical sensor designed for prolonged use, featuring adjustable straps and biocompatible materials to enhance patient comfort and minimize skin irritation. The sensor continuously monitors vital signs and transmits data wirelessly to a healthcare provider.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on wearable sensors\"\n        }\n    ],\n    \"claims\": [\n        \"A wearable medical sensor comprising adjustable straps.\",\n        \"A biocompatible material for minimizing skin irritation.\",\n        \"A wireless data transmission module.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67921", "text": "{\n    \"patent_title\": \"Automated Insulin Delivery System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Johnson & Johnson\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Johnson & Johnson\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2021-02-10\",\n    \"filing_date\": \"2021-05-12\",\n    \"issue_date\": \"2022-08-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for delivering insulin to diabetic patients based on continuous glucose monitoring. The system includes a closed-loop algorithm and a portable pump for precise insulin dosage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related to closed-loop insulin delivery\"\n        }\n    ],\n    \"claims\": [\n        \"An automated insulin delivery system.\",\n        \"A closed-loop control algorithm.\",\n        \"A portable insulin pump.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67922", "text": "{\n    \"patent_title\": \"Method and System for Automated Detection of Lung Nodules in CT Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-06-15\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for automated detection of lung nodules in CT images. The system utilizes a deep learning algorithm trained on a large dataset of CT scans to identify potential nodules with high accuracy, addressing the critical need for early lung cancer diagnosis. The algorithm incorporates multi-scale analysis and texture features to improve sensitivity and specificity. The system also provides a user-friendly interface for radiologists to review and validate the detected nodules, reducing workload and improving diagnostic efficiency.  The current methods for lung nodule detection are time-consuming and prone to human error. This invention significantly addresses these limitations.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Previous Lung Nodule Detection System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting lung nodules in CT images comprising...\",\n        \"A system for assisting radiologists in lung nodule detection...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67922", "text": "{\n    \"patent_title\": \"Image Compression Technique Using Wavelet Transform\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2018-11-20\",\n    \"filing_date\": \"2018-12-20\",\n    \"issue_date\": \"2021-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel image compression technique utilizing wavelet transform. The method achieves high compression ratios while maintaining acceptable image quality. The algorithm is particularly effective for grayscale images and can be implemented in various applications such as image storage and transmission. It improves upon existing wavelet-based compression techniques by employing adaptive quantization.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Prior Art Wavelet Compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing grayscale images using wavelet transform comprising...\",\n        \"An image compression system utilizing adaptive quantization...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67923", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Mark Horowitz\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Zhang\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-06-20\",\n    \"issue_date\": \"2022-10-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable biosensor for continuous glucose monitoring. The device utilizes novel microfabrication techniques to achieve high sensitivity and long-term stability, significantly improving patient management of diabetes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in glucose monitoring\"\n        }\n    ],\n    \"claims\": [\n        \"A method for continuously monitoring glucose levels in a patient.\",\n        \"An implantable biosensor comprising...\",\n        \"A system for transmitting glucose data to a remote monitoring device.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67923", "text": "{\n    \"patent_title\": \"Surgical Robotic Arm with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11567890B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-08-15\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical robotic arm designed for enhanced precision in minimally invasive procedures. The arm incorporates advanced control algorithms and force feedback mechanisms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Prior art in surgical robotics\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic arm comprising...\",\n        \"A control system for precise movement of the robotic arm.\",\n        \"A force feedback mechanism for providing tactile sensation to the surgeon.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67924", "text": "{\n    \"patent_title\": \"Enhanced Resolution Magnetic Resonance Imaging Using Deep Learning Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2020-12-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for enhancing the resolution of magnetic resonance images (MRI) using a deep learning reconstruction algorithm. The method significantly improves image clarity, allowing for earlier and more accurate diagnosis of medical conditions. This is a substantial improvement over existing techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI resolution comprising...\",\n        \"A system for processing MRI data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67924", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Angiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-05-20\",\n    \"filing_date\": \"2019-05-20\",\n    \"issue_date\": \"2021-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved catheter design for angiography procedures. The new design allows for more precise navigation of blood vessels. The catheter offers incremental improvements in maneuverability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising...\",\n        \"A method for using the catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67925", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging Technique for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel magnetic resonance imaging (MRI) technique that significantly improves the detection of early-stage cancer. The technique utilizes advanced pulse sequences and image reconstruction algorithms to enhance contrast and resolution, leading to more accurate and reliable diagnoses. The improvements in diagnostic capabilities are substantial.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating MRI images with improved contrast.\",\n        \"An MRI system configured to perform the method.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67925", "text": "{\n    \"patent_title\": \"Novel Algorithm for Data Compression in Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-06-01\",\n    \"filing_date\": \"2020-08-15\",\n    \"issue_date\": \"2023-03-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new algorithm for compressing medical imaging data, reducing storage requirements and transmission times. The algorithm utilizes wavelet transforms and quantization techniques to achieve high compression ratios while preserving image quality. This enhances the efficiency of medical image archiving and distribution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing medical image data.\",\n        \"A system for implementing the compression method.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67926", "text": "{\n    \"patent_title\": \"Deep Learning System for Automated Medical Image Diagnosis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-06-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep learning system for automatically diagnosing diseases from medical images, such as X-rays and MRIs. The system utilizes convolutional neural networks to identify patterns indicative of various conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for diagnosing a disease from a medical image using a deep learning algorithm.\",\n        \"A system for providing automated medical image analysis.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67926", "text": "{\n    \"patent_title\": \"Novel Algorithm for Facial Recognition in Security Systems\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corp\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-11-01\",\n    \"filing_date\": \"2021-11-01\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved facial recognition algorithm for enhanced security systems. The algorithm utilizes advanced feature extraction techniques to identify individuals with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10112233B1\"\n        }\n    ],\n    \"claims\": [\n        \"A facial recognition system using advanced feature extraction.\",\n        \"A method for identifying individuals from video streams.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67927", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Enhancement for Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for enhancing the quality of medical images, improving diagnostic accuracy and reducing noise. The method utilizes a generative adversarial network (GAN) with a customized loss function to preserve critical image details.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image denoising.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing medical images using a deep learning model.\",\n        \"A system comprising a deep learning model and a display for visualizing enhanced medical images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67927", "text": "{\n    \"patent_title\": \"Method for Improving Contrast in Digital Photographs\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Kodak\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for automatically adjusting the contrast of digital photographs to improve their visual appeal. The method involves histogram equalization and adaptive gamma correction.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related to basic image processing techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for adjusting the contrast of a digital photograph.\",\n        \"A digital camera comprising a processor configured to implement the contrast adjustment method.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67928", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"David Jones\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-06-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system incorporating advanced imaging and robotic control for precise tissue manipulation. This invention improves surgical accuracy and reduces patient recovery time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art in robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising: a robotic arm with at least three degrees of freedom; an endoscope providing high-resolution imaging; a control interface for a surgeon; and a software module for image processing and navigation.\",\n        \"The surgical system of claim 1, wherein the robotic arm includes force feedback capabilities.\",\n        \"The surgical system of claim 1, wherein the endoscope is configured for fluorescence imaging.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67928", "text": "{\n    \"patent_title\": \"Diagnostic Device for Cardiovascular Disease\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive diagnostic device for detecting biomarkers associated with cardiovascular disease. The device utilizes microfluidic technology for rapid and accurate analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art in biomarker detection\"\n        }\n    ],\n    \"claims\": [\n        \"A diagnostic device comprising: a microfluidic chip; a sensor for detecting biomarkers; and a data processing unit.\",\n        \"The diagnostic device of claim 1, wherein the biomarker is C-reactive protein.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67929", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel surgical system enabling minimally invasive procedures with enhanced real-time visualization and precision control. The system utilizes a micro-robotic platform and advanced imaging technologies to improve surgical outcomes and reduce patient recovery times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8568421B2\",\n            \"relevance\": \"Prior art in robotic surgery.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising...\",\n        \"A method for performing a minimally invasive procedure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67929", "text": "{\n    \"patent_title\": \"Orthopedic Implant Design for Hip Replacement\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Acme Medical Inc.\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Acme Medical Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel design for orthopedic implants used in hip replacement surgery. The implant features improved biocompatibility and enhanced structural integrity for long-term patient benefit.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Previous hip implant designs.\"\n        }\n    ],\n    \"claims\": [\n        \"An orthopedic implant characterized by...\",\n        \"A method for implanting the orthopedic implant...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67930", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-06-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system comprising a miniaturized camera and robotic arms for precise tissue manipulation, designed to improve surgical accuracy and reduce patient recovery time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising a camera and robotic arms.\",\n        \"A method for minimally invasive surgery using said system.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67930", "text": "{\n    \"patent_title\": \"Improved Catheter Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2021-02-01\",\n    \"filing_date\": \"2021-05-15\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel catheter design with improved flexibility and reduced friction for easier navigation within blood vessels. The design focuses on material science advancements for biocompatibility.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible polymer material.\",\n        \"A method for inserting a catheter into a blood vessel.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67931", "text": "{\n    \"patent_title\": \"Enhanced MRI Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-06-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for reconstructing Magnetic Resonance Images (MRI) using deep learning techniques, resulting in improved image quality and diagnostic accuracy. This invention significantly reduces scan time and enhances visualization of subtle anatomical features.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Prior art in MRI reconstruction.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images...\",\n        \"A system for performing MRI reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67931", "text": "{\n    \"patent_title\": \"New Contrast Agent for CT Scans\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel contrast agent for Computed Tomography (CT) scans, offering improved visibility of blood vessels and tissues. The agent is designed for enhanced image contrast and reduced patient toxicity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US1012345678B2\",\n            \"relevance\": \"Related to contrast agent design.\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"A method for using the contrast agent...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67932", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction for Enhanced Diagnostic MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2020-12-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides methods and systems for improving image reconstruction in magnetic resonance imaging (MRI) to enhance diagnostic accuracy, particularly for early-stage cancer detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"A system for performing MRI image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67932", "text": "{\n    \"patent_title\": \"Method for Automated X-Ray Image Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2018-06-20\",\n    \"filing_date\": \"2019-06-20\",\n    \"issue_date\": \"2021-04-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a system and method for automatically analyzing X-ray images to identify potential anomalies. The system utilizes machine learning algorithms for image processing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for analyzing X-ray images comprising...\",\n        \"A method for automatically detecting anomalies in X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67933", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Enhancement System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-12-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel system for image enhancement utilizing deep convolutional neural networks to perform complex image manipulations, including super-resolution and style transfer.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image filtering techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image using a deep neural network.\",\n        \"A system comprising a deep neural network configured to perform image super-resolution.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67933", "text": "{\n    \"patent_title\": \"Method for Basic Image Filtering\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"XYZ Corp\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2019-08-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for applying basic image filters such as blur, sharpen, and edge detection to digital images.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for blurring an image.\",\n        \"A system for applying a sharpening filter to an image.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67934", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-06-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system comprising a console, a vision system, and surgical instruments. The system incorporates advanced imaging techniques for enhanced visualization during surgery, leading to improved precision and reduced patient trauma.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related art in robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising...\",\n        \"An imaging method for enhancing visualization...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67934", "text": "{\n    \"patent_title\": \"Dental Implant System with Improved Osseointegration\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of Pennsylvania\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-09-10\",\n    \"filing_date\": \"2022-01-15\",\n    \"issue_date\": \"2023-05-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A dental implant system designed to promote faster and more reliable osseointegration. The implant surface is modified with a bioactive coating to enhance bone cell attachment.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Prior art in dental implant surfaces\"\n        }\n    ],\n    \"claims\": [\n        \"A dental implant comprising...\",\n        \"A method for enhancing osseointegration...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67935", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-06-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing high-resolution medical images from low-dose CT scans utilizing deep learning techniques. This improves image quality while reducing patient exposure to radiation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Reconstruction Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"The method of claim 1, wherein the deep learning model is a convolutional neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67935", "text": "{\n    \"patent_title\": \"Digital Image Watermarking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-12-15\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for embedding a digital watermark into an image to protect copyright. The watermark is robust to common image processing operations.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Method and System for Enhanced Medical Image Reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for embedding a watermark into an image...\",\n        \"The watermark is imperceptible to the human eye.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67936", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-04-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for reconstructing medical images from raw data using deep convolutional neural networks, significantly improving image quality and reducing scan time. This leads to earlier and more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image denoising\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for performing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67936", "text": "{\n    \"patent_title\": \"Image Compression Technique for Digital Photographs\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Kodak\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2016-05-20\",\n    \"filing_date\": \"2016-05-20\",\n    \"issue_date\": \"2018-02-13\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved image compression algorithm based on wavelet transform, reducing file size without significant loss of visual quality for standard digital photographs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Existing JPEG compression standard\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a digital image comprising...\",\n        \"An apparatus for performing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67937", "text": "{\n    \"patent_title\": \"Method for Enhanced Detection of Micro-Calcifications in Mammograms\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for improving the detection of micro-calcifications in digital mammograms, utilizing a novel image processing algorithm. This technique enhances visibility and reduces false positives, aiding in the early diagnosis of breast cancer, particularly in cases with subtle indicators.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing digital mammogram images comprising...\",\n        \"An image processing system configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67937", "text": "{\n    \"patent_title\": \"System for Automated Analysis of Retinal Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Hospital Corporation of America\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for automated analysis of retinal images for the detection of diabetic retinopathy. The system uses deep learning algorithms to identify key features and provide a diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for analyzing retinal images comprising...\",\n        \"A computer-readable medium storing instructions for...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67938", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method and system for reconstructing medical images with improved resolution and reduced noise, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8652123B2\",\n            \"relevance\": \"Prior art in image filtering\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for medical image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67938", "text": "{\n    \"patent_title\": \"Improved Display for Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new display technology for medical images, enhancing visual clarity for radiologists.  It improves screen brightness and contrast.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related to LCD screen technology\"\n        }\n    ],\n    \"claims\": [\n        \"A medical image display device comprising...\",\n        \"A method for adjusting the brightness of a display...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67939", "text": "{\n    \"patent_title\": \"High-Density Solid-State Lithium-Ion Battery with Enhanced Safety Features\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2023-11-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel solid-state lithium-ion battery design utilizing a ceramic electrolyte and a three-dimensional current collector architecture to achieve significantly higher energy density and improved safety compared to conventional liquid electrolyte batteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on liquid electrolyte battery safety\"\n        }\n    ],\n    \"claims\": [\n        \"A solid-state lithium-ion battery comprising a ceramic electrolyte layer...\",\n        \"A three-dimensional current collector structure for enhanced ion transport...\",\n        \"A battery cell with an energy density of at least 500 Wh/kg.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67939", "text": "{\n    \"patent_title\": \"Improved Lead-Acid Battery Manufacturing Process\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Exide Technologies\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2014-12-20\",\n    \"filing_date\": \"2014-12-20\",\n    \"issue_date\": \"2017-09-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for optimizing the lead grid casting process in the manufacturing of lead-acid batteries, resulting in improved performance and reduced material waste.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art on lead-acid battery grid design\"\n        }\n    ],\n    \"claims\": [\n        \"A method of casting a lead grid for a lead-acid battery comprising...\",\n        \"A lead-acid battery manufactured using the method of claim 1...\",\n        \"A lead grid with a reduced antimony content.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67940", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Cardiac Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"David Stark\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Maria Chen\",\n            \"affiliation\": \"Stanford University Medical Center\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a fully implantable, wireless cardiac monitoring system designed to detect early signs of heart failure exacerbation. The system utilizes novel bio-sensing technology to continuously measure cardiac biomarkers and transmit data wirelessly to an external receiver, providing clinicians with real-time insights into patient health and enabling proactive intervention. This addresses the critical unmet need for continuous, non-invasive monitoring of heart failure patients.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on implantable cardiac devices.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for continuously monitoring cardiac biomarkers in a patient.\",\n        \"An implantable device for wireless transmission of cardiac data.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67940", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Angioplasty\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-07-01\",\n    \"filing_date\": \"2020-09-15\",\n    \"issue_date\": \"2023-04-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel catheter design for use in angioplasty procedures. The catheter incorporates a flexible tip and improved balloon material for enhanced navigation and precise stent placement. This leads to reduced vessel trauma and improved patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related to previous catheter designs.\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter with a flexible tip for navigating blood vessels.\",\n        \"A balloon material with improved elasticity.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67941", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Tumor Detection Using Multi-Modal Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for enhanced tumor detection utilizing the synergistic integration of MRI, PET, and optical imaging modalities. The system incorporates advanced image processing techniques to identify subtle indicators of cancerous growth at early stages, improving diagnostic accuracy and patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in MRI image enhancement\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting tumors comprising...\",\n        \"A system for processing multi-modal imaging data...\",\n        \"The method of claim 1, wherein the imaging modalities include...\",\n        \"The system of claim 2, further comprising...\",\n        \"A computer-readable medium storing instructions for...\",\n        \"A method for quantifying tumor growth...\",\n        \"A method for classifying tumors based on...\",\n        \"A system for displaying tumor characteristics...\",\n        \"A method for providing feedback to a user...\",\n        \"A system for integrating with electronic health records...\",\n        \"A method for identifying biomarkers...\",\n        \"A system for tracking treatment response...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67941", "text": "{\n    \"patent_title\": \"Improved Contrast Agents for Cardiovascular Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-06-01\",\n    \"filing_date\": \"2021-08-15\",\n    \"issue_date\": \"2023-05-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"Novel contrast agents for enhancing visualization of blood vessels and cardiac tissue during MRI and CT scans. The contrast agents exhibit improved biocompatibility and prolonged circulation times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Previous work on contrast agent stability\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"A method for enhancing cardiovascular imaging...\",\n        \"The contrast agent of claim 1, wherein the agent is biocompatible...\",\n        \"A pharmaceutical composition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67942", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Sensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable sensor for continuous glucose monitoring, providing real-time data for improved diabetes management and patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art related to glucose sensors.\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized glucose sensor comprising...\",\n        \"A method for continuous glucose monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67942", "text": "{\n    \"patent_title\": \"Surgical Stapler with Enhanced Cartridge Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Johnson & Johnson\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Johnson & Johnson\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler cartridge design for faster and more efficient tissue closure during surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Prior art relating to surgical staplers.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler cartridge comprising...\",\n        \"A method of using a surgical stapler...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67943", "text": "{\n    \"patent_title\": \"Method and System for Enhancing Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-04-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the resolution of an image using deep convolutional neural networks. The system utilizes a generative adversarial network to learn a mapping from low-resolution images to high-resolution images, resulting in improved image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising...\",\n        \"A system for enhancing image resolution comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67943", "text": "{\n    \"patent_title\": \"System for Organizing Digital Photographs\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Google Inc.\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Apple Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for organizing digital photographs based on metadata and facial recognition. The system allows users to easily search and retrieve photos based on various criteria.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for organizing digital photographs comprising...\",\n        \"A method for organizing digital photographs comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67944", "text": "{\n    \"patent_title\": \"Comfortable and Adjustable Orthopedic Support Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University Medical Technologies\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Innovative Prosthetics Inc.\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an orthopedic support device designed with a focus on patient comfort and usability. The device features adjustable straps, breathable materials, and a contoured design to minimize pressure points and maximize patient adherence. It is particularly suited for long-term wear.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A support device comprising adjustable straps.\",\n        \"A support device utilizing breathable material.\",\n        \"A support device with a contoured design.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67944", "text": "{\n    \"patent_title\": \"Automated Surgical Instrument Control System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Robotic Surgery Solutions\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"Advanced Medical Robotics\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-22\",\n    \"issue_date\": \"2023-06-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a control system for surgical instruments used in robotic surgery. The system enhances precision and reduces surgeon fatigue through automated movements and feedback mechanisms. It significantly improves surgical accuracy in complex procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A control system for robotic surgical instruments.\",\n        \"A system comprising automated movement control.\",\n        \"A system providing haptic feedback to the surgeon.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67945", "text": "{\n    \"patent_title\": \"Contrast-Enhanced Magnetic Resonance Imaging for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel contrast agent and imaging protocol for enhancing the detection of small cancerous tumors using magnetic resonance imaging. The improved contrast allows for earlier and more accurate diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing contrast in MRI...\",\n        \"A contrast agent comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67945", "text": "{\n    \"patent_title\": \"Improved X-Ray Tube Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-02-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new design for X-ray tubes that improves efficiency and reduces radiation exposure. The design incorporates a novel filament geometry and improved cooling system.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube comprising...\",\n        \"A filament geometry characterized by...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67946", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging Technique for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel magnetic resonance imaging (MRI) technique utilizing advanced pulse sequences and image reconstruction algorithms to significantly improve the detection of early-stage cancers. The enhanced contrast and resolution enable more accurate diagnosis and treatment planning.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8545678B1\",\n            \"relevance\": \"Prior art related to MRI pulse sequences.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing magnetic resonance imaging comprising...\",\n        \"An MRI apparatus configured to...\",\n        \"A computer-implemented method for processing MRI data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67946", "text": "{\n    \"patent_title\": \"Digital X-Ray Enhancement System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2017-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system and method for enhancing the quality of digital X-ray images through noise reduction and contrast adjustment. It improves visibility of anatomical structures in radiographic images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Previous work on X-ray image processing.\"\n        }\n    ],\n    \"claims\": [\n        \"A digital X-ray image enhancement system comprising...\",\n        \"A method for processing X-ray images to reduce noise...\",\n        \"A computer program for adjusting contrast in X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67947", "text": "{\n    \"patent_title\": \"Miniature Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable biosensor for continuous and real-time glucose monitoring in diabetic patients. The device utilizes a novel enzymatic reaction and microfabrication techniques to achieve high sensitivity and accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in glucose sensing\"\n        }\n    ],\n    \"claims\": [\n        \"A biosensor comprising...\",\n        \"A method for continuous glucose monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67947", "text": "{\n    \"patent_title\": \"Improved Syringe Design for Medication Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2022-01-10\",\n    \"filing_date\": \"2022-01-10\",\n    \"issue_date\": \"2023-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved syringe design featuring a pre-filled medication chamber and ergonomic grip for easier and more accurate medication delivery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\",\n            \"relevance\": \"Previous syringe designs\"\n        }\n    ],\n    \"claims\": [\n        \"A syringe comprising...\",\n        \"A method for administering medication...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67948", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Super-Resolution with Perceptual Loss\",\n    \"inventors\": [\n        {\n            \"name\": \"Jia Deng\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Xiaolong Wang\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A novel image super-resolution method utilizing deep learning and perceptual loss functions to generate high-resolution images from low-resolution inputs. This addresses the challenge of maintaining perceptual quality in super-resolved images, overcoming limitations of traditional methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art in image scaling.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating a high-resolution image...\",\n        \"The method of claim 1, wherein the deep learning model comprises a convolutional neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67948", "text": "{\n    \"patent_title\": \"Image Compression Using JPEG Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Clarke\",\n            \"affiliation\": \"IBM\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-01-10\",\n    \"issue_date\": \"2021-07-20\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"An improved implementation of the JPEG image compression algorithm, optimizing for speed and efficiency. It provides enhanced compression ratios compared to existing JPEG implementations.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6123456B2\",\n            \"relevance\": \"Original JPEG standard\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image using JPEG...\",\n        \"The method of claim 1, wherein the quantization table is optimized for perceptual quality.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67949", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-07-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing medical images from raw data, employing a deep learning algorithm to reduce noise and enhance image clarity, improving diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Prior Art Image Reconstruction Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"A system comprising a processor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67949", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Cardiovascular Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Medtronic\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Boston Scientific\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-03-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new catheter design featuring improved flexibility and maneuverability for navigating complex cardiovascular anatomy during minimally invasive procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Conventional Catheter Design\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible shaft...\",\n        \"A distal tip configured...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67950", "text": "{\n    \"patent_title\": \"Minimally Invasive Cardiovascular Stent Delivery System\",\n    \"inventors\": [\n        {\n            \"name\": \"David Utley\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University Medical Center\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-12-15\",\n    \"filing_date\": \"2019-06-20\",\n    \"issue_date\": \"2021-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel stent delivery system designed for minimally invasive procedures, featuring enhanced precision and reduced risk of complications in cardiovascular applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in stent design\"\n        }\n    ],\n    \"claims\": [\n        \"A stent delivery system comprising...\",\n        \"A method for delivering a stent...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67950", "text": "{\n    \"patent_title\": \"Improved Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2019-05-01\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2022-07-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An advanced battery management system for electric vehicles, enhancing energy efficiency and extending battery lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related to battery cell monitoring\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery performance...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67951", "text": "{\n    \"patent_title\": \"Enhanced Resolution Medical Imaging System Utilizing Adaptive Filtering\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2015-03-15\",\n    \"filing_date\": \"2015-05-20\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a medical imaging system and method for enhancing image resolution and clarity by utilizing adaptive filtering techniques. The system incorporates real-time noise reduction algorithms to improve diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A medical imaging system comprising:...\",\n        \"A method for enhancing image resolution...\",\n        \"The system of claim 1, wherein...\",\n        \"The method of claim 2, further comprising...\",\n        \"The system of claim 1, wherein the adaptive filter...\",\n        \"The method of claim 2, wherein the noise reduction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67951", "text": "{\n    \"patent_title\": \"Novel Apparatus for Dental X-Ray Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2016-06-10\",\n    \"filing_date\": \"2016-08-15\",\n    \"issue_date\": \"2018-02-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a new dental X-ray imaging apparatus designed to minimize patient radiation exposure. The device features a compact design and improved safety mechanisms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A dental X-ray imaging apparatus comprising:...\",\n        \"The apparatus of claim 1, wherein...\",\n        \"The apparatus of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67952", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system incorporating a novel fiber optic bundle and image processing algorithms to provide surgeons with enhanced visualization during complex procedures, leading to improved patient outcomes and reduced recovery times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related prior art on image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising a fiber optic bundle...\",\n        \"A method for enhancing visualization during surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67952", "text": "{\n    \"patent_title\": \"Automated Pharmaceutical Dispensing Machine\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Sarah Chen\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-02-20\",\n    \"filing_date\": \"2017-02-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for dispensing pharmaceuticals in a hospital setting, reducing medication errors and improving efficiency of pharmacy operations. The system includes robotic arms and barcode scanning technology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related prior art on automated dispensing\"\n        }\n    ],\n    \"claims\": [\n        \"A pharmaceutical dispensing system comprising a robotic arm...\",\n        \"A method for automating pharmaceutical dispensing...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67953", "text": "{\n    \"patent_title\": \"Miniaturized Robotic Surgical System with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"David Gracias\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Allison Okamura\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11876923B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-12-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized robotic surgical system for performing minimally invasive procedures with enhanced precision and dexterity. The system utilizes micro-robotics and advanced control algorithms to navigate complex anatomical structures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in micro-robotics\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system comprising a miniaturized robotic arm...\",\n        \"A control method for precise navigation of the robotic arm...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67953", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Vascular Access\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Langer\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Paula Hammond\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2022-01-10\",\n    \"filing_date\": \"2022-01-10\",\n    \"issue_date\": \"2023-11-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel catheter design that improves vascular access and reduces the risk of complications. The catheter features a biocompatible coating and a streamlined profile.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10234567B2\",\n            \"relevance\": \"Related to vascular access devices\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a biocompatible coating...\",\n        \"A method for inserting the catheter into a blood vessel...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67954", "text": "{\n    \"patent_title\": \"Enhanced Medical Image Reconstruction for Improved Diagnostic Accuracy\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing medical images from raw data, leading to improved clarity and diagnostic accuracy. This invention utilizes a deep learning algorithm to reduce noise and enhance image resolution, enabling earlier and more accurate detection of subtle anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"title\": \"Prior Art Image Reconstruction Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for performing medical image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67954", "text": "{\n    \"patent_title\": \"Improved Display Technology for Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2018-08-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new display technology that enhances the visual clarity of medical images. The display utilizes a high-resolution OLED screen and advanced color calibration algorithms. It does not impact image reconstruction or diagnostic algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Prior Art Display Technology\"\n        }\n    ],\n    \"claims\": [\n        \"A display device for visualizing medical images comprising...\",\n        \"A method for calibrating colors on a medical display...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67955", "text": "{\n    \"patent_title\": \"Improved Method for Early-Stage Breast Cancer Detection Using Dynamic Contrast-Enhanced MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel method for detecting early-stage breast cancer utilizing dynamic contrast-enhanced MRI with advanced image processing techniques. The method enhances sensitivity and specificity for identifying small tumors.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting early-stage breast cancer comprising...\",\n        \"The method of claim 1, wherein the dynamic contrast-enhanced MRI...\",\n        \"A system for implementing the method of claim 1...\",\n        \"The system of claim 3, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67955", "text": "{\n    \"patent_title\": \"Digital X-ray Image Enhancement Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2018-02-15\",\n    \"issue_date\": \"2022-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new digital X-ray image enhancement technique for improving image clarity and reducing noise. The method utilizes a novel filtering algorithm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing digital X-ray images comprising...\",\n        \"The method of claim 1, wherein the filtering algorithm...\",\n        \"A system for implementing the method of claim 1...\",\n        \"The system of claim 3, including a display device...\",\n        \"The system of claim 3, including a user interface...\",\n        \"The system of claim 3, including a storage device...\",\n        \"The system of claim 3, including a processing unit...\",\n        \"The system of claim 3, including an image acquisition device...\",\n        \"The system of claim 3, including a network connection...\",\n        \"The system of claim 3, including a power supply...\",\n        \"The method of claim 1, wherein the filtering algorithm is adaptive...\",\n        \"The method of claim 1, wherein the image is a radiographic image...\",\n        \"The method of claim 1, wherein the image is a fluoroscopic image...\",\n        \"The method of claim 1, wherein the image is a mammographic image...\",\n        \"The method of claim 1, wherein the image is a computed tomographic image...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67956", "text": "{\n    \"patent_title\": \"Improved MRI Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2023-11-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing Magnetic Resonance Images (MRI) using deep learning techniques, resulting in higher resolution and reduced scan times.  This improves diagnostic accuracy for various medical conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in MRI reconstruction.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67956", "text": "{\n    \"patent_title\": \"Enhanced X-Ray Tube Design for Dental Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-05-10\",\n    \"filing_date\": \"2018-05-10\",\n    \"issue_date\": \"2022-09-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved design for X-ray tubes used in dental imaging, leading to reduced radiation exposure and improved image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Previous X-ray tube designs.\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube comprising...\",\n        \"A dental imaging system utilizing the X-ray tube...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67957", "text": "{\n    \"patent_title\": \"Method and System for Accelerated MRI Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"David S. Bernstein\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Christopher J. Thompson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-10-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel method for accelerated Magnetic Resonance Imaging (MRI) reconstruction using a deep convolutional neural network. The network learns to map undersampled k-space data directly to high-quality images, significantly reducing scan time. This addresses a critical need in clinical MRI, allowing for faster and more patient-friendly imaging procedures. The method demonstrates superior performance compared to conventional reconstruction techniques in both simulation and in-vivo experiments.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8766854B2\"\n        },\n        {\n            \"patent_number\": \"US9123345B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising:...\",\n        \"A system for performing MRI reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67957", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Angiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2016-11-20\",\n    \"filing_date\": \"2016-11-20\",\n    \"issue_date\": \"2019-05-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved catheter design for angiography, featuring a more flexible tip and enhanced visualization capabilities. The catheter is designed to navigate complex vascular structures with reduced trauma to vessel walls. It offers improved control and maneuverability for interventional procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter for angiography comprising:...\",\n        \"A method for performing angiography using the catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67958", "text": "{\n    \"patent_title\": \"High-Resolution Optical Coherence Tomography System with Adaptive Scanning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel optical coherence tomography (OCT) system is disclosed, incorporating an adaptive scanning algorithm that significantly enhances image resolution and depth of penetration. The system utilizes a tunable laser source and a real-time image processing unit to reconstruct high-resolution 3D images of biological tissues.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Optical Coherence Tomography Apparatus\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating a high-resolution image using optical coherence tomography.\",\n        \"An optical coherence tomography system comprising an adaptive scanning module.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67958", "text": "{\n    \"patent_title\": \"Improved X-Ray Shielding for Dental Radiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"State University\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2017-05-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved X-ray shielding apparatus for dental radiography is presented. The apparatus utilizes a lead-based composite material to reduce radiation exposure to patients and dental personnel.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Dental X-Ray Shielding Device\"\n        }\n    ],\n    \"claims\": [\n        \"A dental X-ray shielding apparatus comprising a lead-based composite material.\",\n        \"A method for reducing radiation exposure during dental radiography.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67959", "text": "{\n    \"patent_title\": \"Method and System for Reducing Radiation Dose in Computed Tomography\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for reducing radiation dose in computed tomography (CT) imaging by utilizing iterative reconstruction techniques and adaptive statistical iterative reconstruction (ASIR). The invention improves image quality while minimizing patient exposure to ionizing radiation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8766854B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing radiation dose in CT imaging...\",\n        \"A system comprising a CT scanner...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67959", "text": "{\n    \"patent_title\": \"Improved Algorithm for Processing Financial Transactions\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved algorithm for processing financial transactions with enhanced security and efficiency. The algorithm utilizes blockchain technology and cryptography to ensure data integrity and prevent fraud.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing financial transactions...\",\n        \"A computer-implemented system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67960", "text": "{\n    \"patent_title\": \"Deep Learning-Based Intrusion Detection System Using Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-08-15\",\n    \"issue_date\": \"2021-03-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for detecting network intrusions using deep learning and image recognition techniques. The system converts network traffic data into visual representations and applies convolutional neural networks to identify malicious patterns.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting network intrusions comprising...\",\n        \"A system for analyzing network traffic data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67960", "text": "{\n    \"patent_title\": \"Improved Algorithm for Facial Recognition in Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"California Institute of Technology\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-02-28\",\n    \"issue_date\": \"2020-12-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved algorithm for facial recognition in mobile devices, enhancing speed and accuracy. The invention focuses on optimizing feature extraction and matching techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10112233A1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for facial recognition comprising...\",\n        \"A mobile device with an integrated facial recognition system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67961", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Super-Resolution for Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Research\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-06-15\",\n    \"issue_date\": \"2021-01-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for enhancing the resolution of medical images, enabling more accurate diagnosis. This method addresses the challenge of limited data and high computational cost in traditional super-resolution techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image enhancement\"\n        }\n    ],\n    \"claims\": [\n        \"A method for super-resolving an image comprising...\",\n        \"A deep learning model configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67961", "text": "{\n    \"patent_title\": \"Method for Applying Filters to Photographs\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Independent Inventor\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-03-10\",\n    \"filing_date\": \"2018-04-10\",\n    \"issue_date\": \"2020-09-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for applying basic color filters (e.g., sepia, grayscale, black and white) to digital photographs using a mobile application.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for altering the color composition of a digital image...\",\n        \"A mobile application implementing said method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67962", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction Algorithm for Low-Dose CT Scans\",\n    \"inventors\": [\n        {\n            \"name\": \"David A. Hanlon\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Maria Fernandez\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-11-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel image reconstruction algorithm for computed tomography (CT) scans that significantly reduces radiation exposure while maintaining high image quality. The algorithm utilizes a deep learning model to denoise images acquired with low radiation doses, resulting in diagnostic-quality images with reduced patient risk.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in image denoising\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an image from low-dose CT scan data comprising...\",\n        \"A system for performing CT imaging with reduced radiation exposure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67962", "text": "{\n    \"patent_title\": \"Automated Analysis of Mammograms Using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2021-05-20\",\n    \"filing_date\": \"2021-05-20\",\n    \"issue_date\": \"2023-09-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a machine learning system for automatically detecting and classifying abnormalities in mammogram images. The system utilizes convolutional neural networks to identify potential cancerous lesions, aiding radiologists in their diagnostic process.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related art in image classification\"\n        }\n    ],\n    \"claims\": [\n        \"A system for automated mammogram analysis comprising...\",\n        \"A method for identifying potential cancerous lesions in mammogram images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67963", "text": "{\n    \"patent_title\": \"High-Resolution Magnetic Resonance Imaging with Artificial Intelligence Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2023-11-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel MRI technique utilizing artificial intelligence algorithms to enhance image resolution and reduce scan time.  The system provides significantly improved diagnostic accuracy for early cancer detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in MRI pulse sequences\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating high-resolution MRI images comprising...\",\n        \"An MRI system configured to implement the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67963", "text": "{\n    \"patent_title\": \"Improved X-Ray Shielding for Dental Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2014-12-10\",\n    \"filing_date\": \"2014-12-10\",\n    \"issue_date\": \"2022-09-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an improved shielding apparatus for dental X-ray procedures, reducing radiation exposure to patients and operators.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in X-ray shielding materials\"\n        }\n    ],\n    \"claims\": [\n        \"A shielding apparatus for dental X-ray equipment comprising...\",\n        \"The apparatus of claim 1, wherein the shielding material is lead-based...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67964", "text": "{\n    \"patent_title\": \"Enhanced Image Reconstruction Method for Low-Dose CT Scans\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-06-20\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel image reconstruction algorithm for computed tomography (CT) scans that significantly reduces radiation dose while maintaining high image quality. The method utilizes a deep learning approach to denoise and reconstruct images from limited projection data, resulting in improved diagnostic accuracy and patient safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a CT image...\",\n        \"A system for performing low-dose CT imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67964", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Angiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-08-12\",\n    \"issue_date\": \"2023-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel catheter design for angiography procedures. The catheter features an improved tip geometry and material composition for enhanced maneuverability and reduced patient discomfort. The design enables more precise delivery of contrast agents.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a distal tip...\",\n        \"A method for performing angiography...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67965", "text": "{\n    \"patent_title\": \"Non-Invasive Glucose Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Jennifer Dickinson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Chen\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive glucose monitoring system using optical sensors to determine blood glucose levels. This technology aims to improve patient compliance and reduce the discomfort associated with traditional methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for non-invasively measuring blood glucose levels using optical sensors.\",\n        \"A device comprising an optical sensor and a processing unit for analyzing glucose levels.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67965", "text": "{\n    \"patent_title\": \"Surgical Robotic Arm with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Michael Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical robotic arm designed to provide enhanced precision and dexterity during minimally invasive surgeries. This system incorporates advanced control algorithms and feedback mechanisms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic arm comprising a plurality of joints and actuators.\",\n        \"A control system for operating the robotic arm with enhanced precision.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67966", "text": "{\n    \"patent_title\": \"Advanced Modulation Techniques for 5G Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Qualcomm Technologies, Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Samsung Research America\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel modulation schemes for 5G wireless communication, improving spectral efficiency and data rates.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art related to OFDM modulation\"\n        }\n    ],\n    \"claims\": [\n        \"A method for transmitting data comprising...\",\n        \"An apparatus for receiving data comprising...\",\n        \"A wireless communication system comprising...\",\n        \"The method of claim 1, wherein...\",\n        \"The apparatus of claim 2, wherein...\",\n        \"The system of claim 3, wherein...\",\n        \"A modulation scheme as described herein.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67966", "text": "{\n    \"patent_title\": \"Improved Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla, Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2014-11-10\",\n    \"filing_date\": \"2014-11-10\",\n    \"issue_date\": \"2022-05-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery management system designed to enhance the performance and lifespan of lithium-ion batteries in electric vehicles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art related to battery charging control\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling battery charging comprising...\",\n        \"The system of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67967", "text": "{\n    \"patent_title\": \"Novel MRI Contrast Agent for Enhanced Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Robert Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-10-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel MRI contrast agent utilizing nanoparticles for targeted tumor detection, exhibiting significantly enhanced signal-to-noise ratio and improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in nanoparticle-based contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising nanoparticles...\",\n        \"A method for detecting tumors...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67967", "text": "{\n    \"patent_title\": \"Improved X-Ray Shielding Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Mr. David Lee\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"Ms. Sarah Brown\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2022-05-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new composite material for enhanced X-ray shielding, reducing radiation exposure during medical imaging procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous work on shielding materials\"\n        }\n    ],\n    \"claims\": [\n        \"A shielding material comprising...\",\n        \"A method for reducing radiation exposure...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67968", "text": "{\n    \"patent_title\": \"Enhanced Resolution MRI Using AI-Based Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing MRI images using artificial intelligence to significantly improve resolution and reduce noise, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Prior art in MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"An MRI system configured to perform...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67968", "text": "{\n    \"patent_title\": \"Novel Drug Delivery System for Cancer Treatment\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Williams\",\n            \"affiliation\": \"Pfizer Inc.\"\n        },\n        {\n            \"name\": \"Sarah Johnson\",\n            \"affiliation\": \"Pfizer Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-05-10\",\n    \"filing_date\": \"2022-05-10\",\n    \"issue_date\": \"2024-01-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new drug delivery system utilizing nanoparticles to target cancer cells with increased precision and efficacy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US1012345678B2\",\n            \"relevance\": \"Related prior art in nanoparticle drug delivery\"\n        }\n    ],\n    \"claims\": [\n        \"A drug delivery system comprising...\",\n        \"A method for treating cancer comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67969", "text": "{\n    \"patent_title\": \"Medical Image Enhancement Using Adaptive Histogram Equalization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-06-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the contrast of medical images using adaptive histogram equalization, improving diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\"\n        },\n        {\n            \"patent_number\": \"US98765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing a medical image comprising...\",\n        \"A system for implementing the method...\",\n        \"The method of claim 1, wherein...\",\n        \"The system of claim 2, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67969", "text": "{\n    \"patent_title\": \"Advanced Image Compression Algorithm for Satellite Imagery\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"NASA\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-01-10\",\n    \"issue_date\": \"2023-04-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An advanced image compression algorithm designed for high-resolution satellite imagery, significantly reducing storage and transmission bandwidth.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10111213B2\"\n        },\n        {\n            \"patent_number\": \"US76543210B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image comprising...\",\n        \"A system for implementing the method...\",\n        \"The method of claim 1, wherein...\",\n        \"The system of claim 2, wherein...\",\n        \"Claim 5...\",\n        \"Claim 6...\",\n        \"Claim 7...\",\n        \"Claim 8...\",\n        \"Claim 9...\",\n        \"Claim 10...\",\n        \"Claim 11...\",\n        \"Claim 12...\",\n        \"Claim 13...\",\n        \"Claim 14...\",\n        \"Claim 15...\",\n        \"Claim 16...\",\n        \"Claim 17...\",\n        \"Claim 18...\",\n        \"Claim 19...\",\n        \"Claim 20...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67970", "text": "{\n    \"patent_title\": \"Adaptive Image Enhancement for Low-Light Photography\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-04-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for adaptively enhancing images captured under low-light conditions. The system analyzes image characteristics and applies targeted adjustments to improve brightness, contrast, and overall visual quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Noise Reduction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image comprising...\",\n        \"A system for adaptively adjusting image parameters...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67970", "text": "{\n    \"patent_title\": \"Method for Compressing Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Healthcare Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-15\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for compressing medical images, reducing storage space and transmission bandwidth while maintaining diagnostic quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Lossless Image Compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a medical image comprising...\",\n        \"A system for encoding image data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67971", "text": "{\n    \"patent_title\": \"Miniaturized Robotic Catheter for Cardiac Ablation\",\n    \"inventors\": [\n        {\n            \"name\": \"David Chen\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Maria Rodriguez\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized robotic catheter system for performing minimally invasive cardiac ablation procedures. The system provides enhanced precision and control compared to existing methods, reducing patient trauma and recovery time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Prior art in robotic catheter design\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic catheter system comprising...\",\n        \"A method for performing cardiac ablation...\",\n        \"A control system for precise catheter manipulation...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67971", "text": "{\n    \"patent_title\": \"Improved Stent Design for Coronary Artery Disease\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2021-08-01\",\n    \"filing_date\": \"2021-10-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved stent design for treating coronary artery disease, offering enhanced biocompatibility and reduced risk of restenosis. The stent is constructed from a novel alloy and features a unique geometric configuration.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\",\n            \"relevance\": \"Previous stent designs\"\n        }\n    ],\n    \"claims\": [\n        \"A stent comprising...\",\n        \"A method for deploying a stent...\",\n        \"A biocompatible coating for a stent...\",\n        \"A geometric configuration for optimal stent performance...\",\n        \"An alloy composition for a stent...\",\n        \"A process for manufacturing a stent...\",\n        \"A deployment device for a stent...\",\n        \"A method of treating coronary artery disease...\",\n        \"A system for delivering a stent...\",\n        \"A method for assessing stent placement...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67972", "text": "{\n    \"patent_title\": \"Low-Light Image Enhancement Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2021-03-01\",\n    \"patent_office\": \"US\",\n    \"abstract\": \"This invention discloses a method and system for enhancing the visual quality of images captured in low-light conditions using deep convolutional neural networks. The system utilizes a novel training approach to improve image clarity and reduce noise.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing low-light images comprising...\",\n        \"A system for processing images in low-light conditions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67972", "text": "{\n    \"patent_title\": \"Method for Compressing Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Mayo Clinic\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-11-20\",\n    \"filing_date\": \"2020-03-05\",\n    \"issue_date\": \"2021-04-15\",\n    \"patent_office\": \"US\",\n    \"abstract\": \"This invention relates to a method for compressing medical images to reduce storage space and transmission bandwidth. The method utilizes a wavelet transform and entropy encoding.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing medical images comprising...\",\n        \"A system for storing and transmitting compressed medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67973", "text": "{\n    \"patent_title\": \"Contrast-Enhanced Micro-CT Imaging for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel contrast agent and imaging protocol for micro-CT, significantly improving cancer detection rates while minimizing radiation dosage. The contrast agent enhances image clarity by selectively targeting tumor cells.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"A method for imaging comprising...\",\n        \"An imaging system comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67973", "text": "{\n    \"patent_title\": \"Improved Algorithm for MRI Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a new algorithm for accelerating MRI reconstruction, reducing scan time without compromising image quality.  The algorithm focuses on efficient data processing and noise reduction.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US1012345678B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image...\",\n        \"A computer-readable medium storing...\",\n        \"A system for performing MRI...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67974", "text": "{\n    \"patent_title\": \"Improved Resolution Medical Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel medical imaging system utilizing advanced signal processing techniques to significantly improve image resolution and clarity, enabling more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A medical imaging system comprising a signal acquisition module and a signal processing module configured to enhance image resolution.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67974", "text": "{\n    \"patent_title\": \"Portable ECG Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US1234567B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A portable electrocardiogram (ECG) device for continuous heart rate monitoring. The device is compact and designed for remote patient monitoring.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A portable ECG device comprising a sensor module and a wireless transmission module.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67975", "text": "{\n    \"patent_title\": \"Adaptive Statistical Iterative Reconstruction for Low-Dose CT Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"University of California, San Francisco\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10887456B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2020-01-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for reducing radiation dose in computed tomography (CT) imaging while maintaining diagnostic image quality. The invention utilizes an adaptive statistical iterative reconstruction (ASIR) algorithm tailored to patient anatomy and imaging parameters.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9232456B1\"\n        },\n        {\n            \"patent_number\": \"US8780654B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a CT image comprising...\",\n        \"A system for performing CT imaging comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67975", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Sarah Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-11-20\",\n    \"filing_date\": \"2019-11-20\",\n    \"issue_date\": \"2021-03-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel gadolinium-based contrast agent for magnetic resonance imaging (MRI) with enhanced relaxivity properties. The agent offers a slight improvement in image contrast compared to existing agents.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent composition comprising...\",\n        \"A method of using the contrast agent composition...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67976", "text": "{\n    \"patent_title\": \"Method and System for Enhancing Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jia Deng\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-01-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the resolution of digital images using a deep convolutional neural network. The network is trained to predict high-resolution images from low-resolution inputs, improving overall image clarity and detail.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Super-Resolution Using Generative Adversarial Networks\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising: training a deep neural network...\",\n        \"A system for enhancing image resolution...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67976", "text": "{\n    \"patent_title\": \"Method for Lossless Image Compression Using Wavelet Transform\",\n    \"inventors\": [\n        {\n            \"name\": \"Marc Levoy\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Kayvon Fatahalian\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-11-20\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2021-03-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for compressing digital images without loss of information using a wavelet transform.  The method provides high compression ratios while maintaining image quality, suitable for archiving and transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Efficient Wavelet-Based Image Coding\"\n        }\n    ],\n    \"claims\": [\n        \"A method for lossless image compression comprising: applying a wavelet transform...\",\n        \"A system for lossless image compression...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67977", "text": "{\n    \"patent_title\": \"Pediatric Cardiac Imaging with Reduced Radiation Dose\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-06-01\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reducing radiation exposure during cardiac imaging in pediatric patients utilizing advanced image reconstruction algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Advanced Image Reconstruction Techniques\"\n        },\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"title\": \"Radiation Dose Optimization in Medical Imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing radiation dose in pediatric cardiac imaging.\",\n        \"An image reconstruction algorithm optimized for low-dose imaging.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67977", "text": "{\n    \"patent_title\": \"Enhanced MRI Contrast Agents\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2019-12-10\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2022-06-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new class of MRI contrast agents with improved signal amplification for detecting subtle tissue anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Novel Contrast Agent Formulations\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent composition for enhanced MRI signal.\",\n        \"A method for visualizing tissue anomalies using the contrast agent.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67978", "text": "{\n    \"patent_title\": \"Lithium-Sulfur Battery with Improved Electrolyte Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-01\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-sulfur battery design utilizing a modified electrolyte composition to enhance stability and cycle life, contributing to more sustainable energy storage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on lithium-sulfur battery electrolytes.\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-sulfur battery comprising...\",\n        \"An electrolyte composition for a lithium-sulfur battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67978", "text": "{\n    \"patent_title\": \"Improved Lead-Acid Battery Charging Method\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Exide Technologies\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-08-20\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2020-12-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new method for charging lead-acid batteries to improve efficiency and reduce charging time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Previous work on lead-acid battery charging algorithms.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for charging a lead-acid battery...\",\n        \"A charging circuit configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67979", "text": "{\n    \"patent_title\": \"Method and System for Adaptive Power Management in Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Qualcomm Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-09-20\",\n    \"issue_date\": \"2019-04-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for adaptively managing power consumption in mobile devices by dynamically adjusting the operating frequency and voltage of different components based on real-time usage patterns. The system leverages machine learning algorithms to predict user behavior and optimize power usage, significantly extending battery life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on power management\"\n        }\n    ],\n    \"claims\": [\n        \"A method for managing power consumption in a mobile device...\",\n        \"A system for adaptively adjusting operating parameters...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67979", "text": "{\n    \"patent_title\": \"Improved Charging Circuit for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Motors\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2018-12-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved charging circuit designed to reduce charging time for electric vehicles. The circuit utilizes advanced power electronics to efficiently convert AC power to DC power and deliver it to the vehicle's battery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related to EV charging technologies\"\n        }\n    ],\n    \"claims\": [\n        \"A charging circuit for an electric vehicle...\",\n        \"A method for efficiently converting AC power to DC power...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67980", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for reconstructing medical images from raw data, utilizing advanced algorithms to improve image quality and reduce scanning time. The method incorporates deep learning techniques for artifact reduction and noise suppression.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"count\": 5\n        },\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"count\": 3\n        },\n        {\n            \"patent_number\": \"US9234567B1\",\n            \"count\": 7\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for performing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67980", "text": "{\n    \"patent_title\": \"Apparatus for Displaying Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US1234567B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2018-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An apparatus for displaying medical images on a monitor, including a user interface for adjusting brightness and contrast. The apparatus is designed for ease of use and improved clinical workflow.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"count\": 1\n        }\n    ],\n    \"claims\": [\n        \"An apparatus for displaying a medical image comprising...\",\n        \"A user interface for adjusting the brightness of the image...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67981", "text": "{\n    \"patent_title\": \"Implantable Cardiac Monitor with Remote Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Medtronic Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac monitor capable of continuously monitoring heart rhythm and transmitting data wirelessly to a remote monitoring station. Addresses the need for long-term cardiac monitoring in patients at risk of arrhythmias.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art on implantable pacemakers\"\n        }\n    ],\n    \"claims\": [\n        \"A method for continuously monitoring cardiac rhythm...\",\n        \"An implantable device comprising a sensor...\",\n        \"A system for remotely transmitting cardiac data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67981", "text": "{\n    \"patent_title\": \"Improved Surgical Stapler Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Ethicon\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2014-12-10\",\n    \"filing_date\": \"2014-12-10\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new design for surgical staplers improving staple formation and reducing tissue damage. Provides more precise and efficient tissue closure during surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Previous stapler designs\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"A staple cartridge...\",\n        \"A method for stapling tissue...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67982", "text": "{\n    \"patent_title\": \"Implantable Cardiac Monitor with Remote Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Boston Medical Center\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2021-02-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac monitor wirelessly transmits data to a remote server for real-time patient monitoring. This allows for early detection of arrhythmias and reduces the need for frequent hospital visits.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Prior Art Cardiac Monitor\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Wireless Data Transmission System\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Implantable Device Power Management\"\n        },\n        {\n            \"patent_number\": \"US11000001B2\",\n            \"title\": \"Remote Patient Monitoring Platform\"\n        },\n        {\n            \"patent_number\": \"US11111111B2\",\n            \"title\": \"Arrhythmia Detection Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A method for remotely monitoring a patient's cardiac activity.\",\n        \"An implantable device comprising a sensor and a wireless transmitter.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67982", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical stapler with a redesigned handle for improved grip and reduced surgeon fatigue during lengthy procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Standard Surgical Stapler\"\n        },\n        {\n            \"patent_number\": \"US8543210B2\",\n            \"title\": \"Ergonomic Tool Handle Design\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an improved handle design.\",\n        \"A handle configured for enhanced grip and reduced fatigue.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67983", "text": "{\n    \"patent_title\": \"AI-Powered Diagnostic System for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Health\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel machine learning system utilizing deep convolutional neural networks to analyze medical images (MRI, CT scans) for the early detection of cancerous tumors. The system exhibits significantly improved accuracy and sensitivity compared to existing methods, leading to earlier diagnoses and improved patient outcomes. The core innovation lies in the use of a proprietary attention mechanism that focuses on subtle anomalies often missed by human radiologists. Furthermore, the system can provide probabilistic risk assessments, aiding clinicians in personalized treatment planning.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancerous tumors in medical images using deep learning.\",\n        \"A system comprising a convolutional neural network with an attention mechanism.\",\n        \"A method for generating probabilistic risk assessments for cancer based on medical image analysis.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67983", "text": "{\n    \"patent_title\": \"Automated Appointment Scheduling System for Healthcare Providers\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-07-15\",\n    \"filing_date\": \"2020-07-15\",\n    \"issue_date\": \"2022-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for scheduling patient appointments with healthcare providers. The system utilizes a rule-based engine to optimize appointment slots and minimize wait times.  It integrates with existing electronic health record systems to automatically confirm appointments and send reminders to patients. The system aims to improve operational efficiency for healthcare practices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US12345678B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for automated appointment scheduling.\",\n        \"A method for optimizing appointment slots based on provider availability.\",\n        \"A method for sending appointment reminders to patients.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67984", "text": "{\n    \"patent_title\": \"Low-Light Image Enhancement Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing images captured in low-light conditions using deep convolutional neural networks. The method involves training a network to map low-light images to corresponding high-quality images, improving visibility and detail.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Enhancement Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing low-light images comprising...\",\n        \"A system for processing images in low-light conditions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67984", "text": "{\n    \"patent_title\": \"Object Detection in Aerial Imagery\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Google Research\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Google Research\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-11-10\",\n    \"filing_date\": \"2021-02-15\",\n    \"issue_date\": \"2023-08-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for accurately detecting objects in aerial imagery using machine learning techniques. This invention focuses on improving the efficiency and precision of object identification in complex aerial scenes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Aerial Image Processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting objects in aerial images comprising...\",\n        \"A system for processing aerial imagery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67985", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10246879B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2017-05-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the resolution of an image using deep convolutional neural networks. The system learns a mapping from low-resolution images to high-resolution images, significantly improving perceived image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9785551B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising...\",\n        \"A system for processing images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67985", "text": "{\n    \"patent_title\": \"Image Compression Technique Utilizing Wavelet Transforms\",\n    \"inventors\": [\n        {\n            \"name\": \"Alan Jay Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Robert L. Webb\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2015-03-10\",\n    \"filing_date\": \"2016-03-10\",\n    \"issue_date\": \"2018-12-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image compression technique based on wavelet transforms is described. This technique achieves high compression ratios while maintaining acceptable image quality.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for compressing an image...\",\n        \"An apparatus for image compression...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67986", "text": "{\n    \"patent_title\": \"Method and System for Accelerated MRI Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-01-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for accelerating Magnetic Resonance Imaging (MRI) reconstruction using a deep convolutional neural network. This technique significantly reduces scan time without compromising image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on compressed sensing in MRI.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising: training a deep neural network...\",\n        \"A system for performing MRI reconstruction…\"\n    ]\n}"}
{"_id": "Academic--patents--n--67986", "text": "{\n    \"patent_title\": \"Improved X-Ray Tube Design for Enhanced Image Clarity\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Philips Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9234567B1\",\n    \"priority_date\": \"2014-12-10\",\n    \"filing_date\": \"2014-12-10\",\n    \"issue_date\": \"2016-01-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved X-ray tube design incorporating a novel filament geometry to produce sharper and more detailed X-ray images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"relevance\": \"Previous designs for X-ray tubes.\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube comprising a filament with a specific geometry...\",\n        \"A method for producing X-rays…\"\n    ]\n}"}
{"_id": "Academic--patents--p--67987", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Cardiac Monitor with Enhanced Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"BioTech Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable cardiac monitor designed for long-term monitoring of heart rhythm.  Improved data transmission algorithms and biocompatible materials enhance patient comfort and diagnostic accuracy, leading to better clinical outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in implantable cardiac devices\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable cardiac monitor comprising...\",\n        \"A data transmission system for said monitor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67987", "text": "{\n    \"patent_title\": \"Surgical Instrument Sterilization System\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Williams\",\n            \"affiliation\": \"Sterile Solutions Corp.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-08-01\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2021-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for sterilizing surgical instruments using a combination of high-pressure steam and chemical disinfectants. The system improves sterilization efficiency and reduces the risk of contamination.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous sterilization methods\"\n        }\n    ],\n    \"claims\": [\n        \"A sterilization system comprising...\",\n        \"A method for sterilizing surgical instruments...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67988", "text": "{\n    \"patent_title\": \"Method for Improving Image Clarity in Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for enhancing the clarity and resolution of images obtained through magnetic resonance imaging (MRI). The method utilizes a post-processing algorithm that reduces noise and artifacts, resulting in improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"type\": \"Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for improving image clarity in MRI comprising...\",\n        \"A system for implementing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67988", "text": "{\n    \"patent_title\": \"System for Automated Ultrasound Image Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Philips Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-15\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system for automatically analyzing ultrasound images to detect potential abnormalities. It includes image segmentation and classification algorithms to assist radiologists in their diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9456789B2\",\n            \"type\": \"Related Application\"\n        }\n    ],\n    \"claims\": [\n        \"A system for automated ultrasound image analysis comprising...\",\n        \"A method for segmenting ultrasound images using machine learning...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67989", "text": "{\n    \"patent_title\": \"Enhanced Magnetic Resonance Imaging with Artificial Intelligence Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"David A. Haussler\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Chen\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel method for improving the clarity and resolution of MRI images using deep learning reconstruction algorithms. The system enhances diagnostic accuracy by reducing noise and artifacts, leading to earlier and more reliable disease detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"MRI Image Reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images using a convolutional neural network.\",\n        \"A system for enhancing the resolution of MRI images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67989", "text": "{\n    \"patent_title\": \"Automated Analysis of Histopathology Slides\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2024-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a system for automated analysis of histopathology slides, identifying cancerous cells with high accuracy. It uses image processing techniques and machine learning algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Digital Pathology Image Analysis\"\n        }\n    ],\n    \"claims\": [\n        \"A system for identifying cancerous cells in histopathology images.\",\n        \"A method for automated analysis of tissue samples.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67990", "text": "{\n    \"patent_title\": \"Wireless Physiological Monitoring System with Adaptive Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Professor David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2017-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless physiological monitoring system that adaptively compresses data based on signal complexity, improving battery life and reducing bandwidth requirements.  This allows for continuous, long-term monitoring of patients outside of traditional clinical settings.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Remote Patient Monitoring System\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless physiological monitoring system comprising...\",\n        \"A method for adaptively compressing physiological data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67990", "text": "{\n    \"patent_title\": \"Improved Surgical Scalpel Design\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US9123456B2\",\n    \"priority_date\": \"2016-03-10\",\n    \"filing_date\": \"2016-03-10\",\n    \"issue_date\": \"2018-09-04\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical scalpel with an improved blade geometry for more precise and controlled incisions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Surgical Scalpel with Vibration Reduction\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical scalpel comprising...\",\n        \"A blade geometry for improved incision control...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67991", "text": "{\n    \"patent_title\": \"Enhanced MRI Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for reconstructing MRI images using a deep learning algorithm, resulting in significantly improved image clarity and diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images using a deep neural network.\",\n        \"An MRI system comprising a deep learning module for image enhancement.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67991", "text": "{\n    \"patent_title\": \"Novel Catheter Design for Cardiovascular Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-05-10\",\n    \"filing_date\": \"2022-05-10\",\n    \"issue_date\": \"2024-01-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new catheter design with improved maneuverability and reduced risk of vascular injury during cardiovascular procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter with a flexible tip for navigating tortuous vessels.\",\n        \"A method for inserting a catheter into a blood vessel.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67992", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Implantable Medical Device for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized, fully implantable, wireless glucose monitoring device capable of continuous, real-time glucose level tracking and data transmission to an external receiver. The device utilizes a novel enzymatic biosensor and a low-power communication protocol to provide accurate and reliable glucose measurements, improving diabetes management and patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8562721B2\",\n            \"relevance\": \"Prior art on implantable glucose sensors\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable glucose monitoring device comprising...\",\n        \"A wireless communication system for transmitting glucose data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67992", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9234567B1\",\n    \"priority_date\": \"2015-07-20\",\n    \"filing_date\": \"2015-07-20\",\n    \"issue_date\": \"2016-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design featuring a modified tip geometry to enhance drug delivery efficiency and reduce patient discomfort during catheterization procedures. The catheter utilizes a biocompatible polymer material and a streamlined design to minimize flow resistance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"relevance\": \"Prior art on catheter tip designs\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a distal tip with a modified geometry...\",\n        \"A biocompatible polymer material for catheter construction...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67993", "text": "{\n    \"patent_title\": \"Efficient Image Denoising Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for image denoising, reducing computational complexity while maintaining high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760789B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for denoising an image comprising...\",\n        \"An apparatus for denoising an image comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67993", "text": "{\n    \"patent_title\": \"Method for Compressing Digital Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Michael Wong\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new compression algorithm for digital images, achieving high compression ratios with minimal loss of quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a digital image comprising...\",\n        \"A system for compressing a digital image comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67994", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Radiology Associates Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-06-15\",\n    \"filing_date\": \"2020-09-20\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for enhancing the quality of medical images reconstructed from various imaging modalities, such as MRI and CT scans. The technique utilizes a novel algorithm to reduce noise and improve resolution, resulting in clearer and more accurate diagnostic images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image denoising algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing medical images comprising...\",\n        \"A system for processing medical images...\",\n        \"A computer-readable medium...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67994", "text": "{\n    \"patent_title\": \"Digital Image Watermarking Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2022-03-10\",\n    \"filing_date\": \"2021-05-05\",\n    \"issue_date\": \"2023-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a digital image watermarking technique to protect copyrighted image content. The watermark is embedded into the image in a manner that is robust against various image processing operations.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Robust watermarking method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for watermarking digital images comprising...\",\n        \"A system for embedding watermarks...\",\n        \"A computer program...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67995", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Sensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-06-22\",\n    \"issue_date\": \"2022-12-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable sensor for continuous glucose monitoring, offering improved accuracy and patient comfort. The sensor utilizes a novel biocompatible material and wireless communication protocol.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on glucose sensing technology\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable glucose sensor comprising...\",\n        \"A wireless communication system for transmitting glucose data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67995", "text": "{\n    \"patent_title\": \"Surgical Instrument Handle Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Davis\",\n            \"affiliation\": \"Small Manufacturing Company\"\n        },\n        {\n            \"name\": \"John Wilson\",\n            \"affiliation\": \"Independent Consultant\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2021-04-10\",\n    \"issue_date\": \"2023-01-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved ergonomic design for surgical instrument handles, enhancing surgeon comfort and precision during operations.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous designs for surgical handles\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument handle with an improved grip...\",\n        \"A handle design that reduces surgeon fatigue...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67996", "text": "{\n    \"patent_title\": \"Miniature Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature implantable biosensor is disclosed for continuous glucose monitoring in diabetic patients. The device provides real-time data transmission to a mobile application, enabling proactive management of glucose levels and improving patient outcomes through timely interventions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A biosensor for continuous glucose monitoring comprising...\",\n        \"A system for transmitting glucose data to a mobile device...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67996", "text": "{\n    \"patent_title\": \"Surgical Instrument Sterilization System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Williams\",\n            \"affiliation\": \"Sterilization Technologies Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-04-01\",\n    \"filing_date\": \"2020-06-15\",\n    \"issue_date\": \"2022-12-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A sterilization system for surgical instruments utilizing high-pressure steam and formaldehyde gas. The system provides a rapid and effective method for sterilizing instruments between surgical procedures, ensuring hospital compliance with safety regulations.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A sterilization system comprising...\",\n        \"A method for sterilizing surgical instruments...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67997", "text": "{\n    \"patent_title\": \"Automated Tumor Detection in MRI Images Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-12-15\",\n    \"filing_date\": \"2019-06-20\",\n    \"issue_date\": \"2021-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for automated detection of tumors in magnetic resonance imaging (MRI) scans using a deep convolutional neural network. The system is designed to assist radiologists in identifying potential tumors with improved accuracy and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Medical Image Analysis System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting tumors in MRI images comprising...\",\n        \"A system for assisting radiologists in tumor detection...\",\n        \"A deep learning model trained for MRI tumor identification...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67997", "text": "{\n    \"patent_title\": \"Image Enhancement Algorithm for Satellite Photography\",\n    \"inventors\": [\n        {\n            \"name\": \"David Donoho\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Ingrid Daubechies\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2018-11-12\",\n    \"issue_date\": \"2020-12-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An image enhancement algorithm for improving the visual quality of satellite photographs, particularly for enhancing details in low-contrast regions. The algorithm utilizes wavelet transforms and adaptive filtering techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Wavelet-Based Image Processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing satellite images comprising...\",\n        \"An image processing algorithm utilizing wavelet transforms...\",\n        \"A system for improving image clarity in remote sensing...\"\n    ]\n}"}
{"_id": "Academic--patents--p--67998", "text": "{\n    \"patent_title\": \"High-Resolution Magnetic Resonance Imaging with Reduced Scan Time\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel magnetic resonance imaging (MRI) technique is disclosed that significantly reduces scan time while maintaining high image resolution. This is achieved through a combination of advanced pulse sequences and image reconstruction algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8785732B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI comprising applying a modified pulse sequence to reduce scan time by at least 30%.\",\n        \"An MRI system configured to implement the method of claim 1.\",\n        \"An image reconstruction algorithm that enhances image resolution in MRI.\"\n    ]\n}"}
{"_id": "Academic--patents--n--67998", "text": "{\n    \"patent_title\": \"Dermal Imaging System for Cosmetic Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Sarah Johnson\",\n            \"affiliation\": \"Cosmetic Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2019-09-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A dermal imaging system is presented for analyzing skin conditions and providing personalized cosmetic recommendations. The system utilizes spectral imaging to identify pigmentation irregularities and wrinkles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A dermal imaging system comprising a spectral imaging camera and a software module for analyzing skin parameters.\",\n        \"A method for identifying skin pigmentation irregularities using spectral imaging.\",\n        \"A cosmetic recommendation system based on dermal imaging analysis.\"\n    ]\n}"}
{"_id": "Academic--patents--p--67999", "text": "{\n    \"patent_title\": \"Ultrasound Image Enhancement for Improved Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n        },\n        {\n            \"name\": \"Dr. Jian Li\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method for enhancing ultrasound images, resulting in improved detection of small tumors and increased diagnostic accuracy in breast cancer screening. The method utilizes a multi-frequency beamforming technique coupled with adaptive filtering to reduce noise and artifacts, leading to clearer visualization of subtle tissue abnormalities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"relevance\": \"cited by\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"also cited by\"\n        },\n        {\n            \"patent_number\": \"US10234567B2\",\n            \"relevance\": \"cited by\"\n        },\n        {\n            \"patent_number\": \"US11345678B2\",\n            \"relevance\": \"cited by\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing ultrasound images comprising...\",\n        \"An ultrasound imaging system configured to...\",\n        \"A computer-readable medium storing instructions for...\"\n    ]\n}"}
{"_id": "Academic--patents--n--67999", "text": "{\n    \"patent_title\": \"High-Resolution Magnetic Resonance Imaging with Improved Contrast\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Chen\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2017-09-28\",\n    \"filing_date\": \"2017-09-28\",\n    \"issue_date\": \"2021-03-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a new pulse sequence for Magnetic Resonance Imaging (MRI) that significantly enhances image resolution and contrast, particularly for neurological applications. The technique utilizes optimized gradient waveforms and advanced reconstruction algorithms to overcome limitations of conventional MRI.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US9654321B1\",\n            \"relevance\": \"cited by\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"also cited by\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI pulse sequence characterized by...\",\n        \"An MRI system configured to perform...\",\n        \"A method for reconstructing MRI images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68000", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Sensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-04-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized wireless sensor for continuous glucose monitoring, designed to improve patient compliance and provide real-time data for better diabetes management. The sensor utilizes a novel biocompatible material and low-power communication protocol.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on glucose monitoring\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized wireless glucose sensor comprising...\",\n        \"A system for continuous glucose monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68000", "text": "{\n    \"patent_title\": \"Improved Scalpel Handle for Enhanced Surgical Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-02-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved scalpel handle designed for enhanced surgical precision and ergonomics. The handle features a textured grip and balanced weight distribution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous scalpel handle designs\"\n        }\n    ],\n    \"claims\": [\n        \"A scalpel handle comprising a textured grip...\",\n        \"A surgical instrument with improved balance...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68001", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Chen\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-11-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable biosensor for continuous glucose monitoring, utilizing novel nanomaterials and a wireless power transfer system. This device provides real-time glucose data with high accuracy and minimal invasiveness.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on glucose monitoring techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable biosensor...\",\n        \"A system for wireless power transfer to said biosensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68001", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Mr. Robert Jones\",\n            \"affiliation\": \"Acme Surgical Devices Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-08-01\",\n    \"filing_date\": \"2019-11-05\",\n    \"issue_date\": \"2023-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler design with enhanced ergonomics and a more reliable firing mechanism. This stapler aims to reduce surgeon fatigue and improve surgical outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Existing stapler designs\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler with an ergonomic handle...\",\n        \"A firing mechanism with increased reliability...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68002", "text": "{\n    \"patent_title\": \"Robotic Surgical System with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2022-12-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a robotic surgical system designed for minimally invasive procedures. The system utilizes advanced sensors and algorithms to provide surgeons with enhanced precision and control during complex operations, offering robotic assistance for improved patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related art in robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system comprising...\",\n        \"A method for performing a minimally invasive surgery...\",\n        \"A control system for robotic arm movement...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68002", "text": "{\n    \"patent_title\": \"Improved Surgical Stapler\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Acme Medical Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2021-07-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved surgical stapler with enhanced reliability and ease of use for general surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art stapler designs\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"A staple cartridge for use in a surgical stapler...\",\n        \"A method of using a surgical stapler...\",\n        \"A locking mechanism...\",\n        \"A release mechanism...\",\n        \"A housing...\",\n        \"A handle...\",\n        \"A trigger...\",\n        \"A shaft...\",\n        \"An anvil...\",\n        \"A driver...\",\n        \"A clamp...\",\n        \"A cutting blade...\",\n        \"A staple...\",\n        \"A fastener...\",\n        \"A retention feature...\",\n        \"A safety feature...\",\n        \"A sterilization process...\",\n        \"A material composition...\",\n        \"A manufacturing process...\",\n        \"A quality control step...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68003", "text": "{\n    \"patent_title\": \"Method and System for Dynamic Power Management in Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Qualcomm\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2022-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for dynamically adjusting power consumption based on usage patterns to extend battery life in mobile devices. The system employs machine learning to predict user behavior and optimize power allocation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for dynamically managing power in a mobile device...\",\n        \"A system for predicting user behavior and optimizing power allocation...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68003", "text": "{\n    \"patent_title\": \"Wireless Charging System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-08-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless charging system for electric vehicles using inductive coupling. The system aims to improve the convenience of charging electric vehicles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless charging system for electric vehicles...\",\n        \"A method for transferring power wirelessly to an electric vehicle...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68004", "text": "{\n    \"patent_title\": \"Magnetic Resonance Imaging with Artificial Intelligence Enhancement for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel MRI technique incorporating deep learning algorithms for improved cancer detection sensitivity and specificity. The method utilizes adaptive coil sensitivity encoding and a convolutional neural network for image reconstruction.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"MRI Image Reconstruction Techniques\"\n        },\n        {\n            \"patent_number\": \"US8789012B2\",\n            \"title\": \"Deep Learning for Image Analysis\"\n        }\n    ],\n    \"claims\": [\n        \"A method for magnetic resonance imaging comprising...\",\n        \"A system for detecting cancer using MRI and artificial intelligence...\",\n        \"A non-transitory computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68004", "text": "{\n    \"patent_title\": \"Improved X-ray Imaging System with Digital Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"University of Michigan\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved X-ray imaging system incorporating digital image enhancement techniques for clearer visualization of bone structures. This system reduces radiation exposure and improves image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Digital X-ray Imaging\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"title\": \"Radiation Dose Reduction in X-ray Imaging\"\n        },\n        {\n            \"patent_number\": \"US6543210B2\",\n            \"title\": \"X-ray Detector Technology\"\n        },\n        {\n            \"patent_number\": \"US5432109B2\",\n            \"title\": \"Image Processing Algorithms for X-rays\"\n        },\n        {\n            \"patent_number\": \"US4321098B2\",\n            \"title\": \"X-Ray Source Enhancement\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A method for reducing radiation dose in X-ray imaging...\",\n        \"A digital image processing algorithm for X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68005", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Boston Medical Center\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-06-15\",\n    \"issue_date\": \"2019-12-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system utilizing a small-diameter robotic arm with enhanced 3D visualization capabilities. The system allows surgeons to perform complex procedures with greater precision and reduced patient trauma.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A minimally invasive surgical system comprising a robotic arm...\",\n        \"A method for performing a surgical procedure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68005", "text": "{\n    \"patent_title\": \"Novel Diagnostic Imaging Device for Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-12-20\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel imaging device utilizing advanced spectral analysis techniques to detect cancerous cells with high accuracy. The device provides detailed images of internal tissues and organs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related technology in medical imaging\"\n        }\n    ],\n    \"claims\": [\n        \"An imaging device comprising a spectral analyzer...\",\n        \"A method for detecting cancer using spectral analysis...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68006", "text": "{\n    \"patent_title\": \"Ultrasound-based early cancer detection system\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-09-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel ultrasound system for early detection of cancerous tumors using advanced signal processing techniques. The system provides high-resolution images and improves diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancerous tumors using ultrasound imaging.\",\n        \"An ultrasound system comprising a transducer and a signal processing unit.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68006", "text": "{\n    \"patent_title\": \"Improved MRI Coil Design for Enhanced Image Quality\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"GE Healthcare\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2015-11-10\",\n    \"filing_date\": \"2015-11-10\",\n    \"issue_date\": \"2018-05-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved MRI coil design that provides enhanced signal-to-noise ratio and image quality. The coil incorporates a novel shielding technique to reduce interference.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil comprising a shielding layer.\",\n        \"A method for improving image quality using an MRI coil.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68007", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-05-20\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method for reconstructing medical images from raw data, resulting in improved image clarity and reduced noise. The system utilizes advanced algorithms to enhance diagnostic accuracy in various medical imaging modalities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Prior Art Image Reconstruction Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for enhancing image clarity in medical imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68007", "text": "{\n    \"patent_title\": \"Novel Signal Processing Technique for Telecommunications\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Bell Labs\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2017-02-10\",\n    \"issue_date\": \"2021-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel signal processing technique for improving the efficiency of wireless communication systems. The method reduces interference and increases data transmission rates.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Prior Art Wireless Communication System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing a signal comprising...\",\n        \"A system for improving wireless communication...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68008", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Physiological Sensor System for Remote Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-06-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a miniaturized, wireless physiological sensor system for continuous remote monitoring of vital signs. The system utilizes advanced sensor technology to detect and transmit data, enabling early detection of health deterioration and improved patient care in remote settings. This is a breakthrough in non-invasive monitoring.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in wireless sensing\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor system for remote patient monitoring comprising...\",\n        \"A method for continuously monitoring vital signs using said system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68008", "text": "{\n    \"patent_title\": \"Improved Syringe Design for Insulin Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Williams\",\n            \"affiliation\": \"Johnson & Johnson\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-08-22\",\n    \"filing_date\": \"2017-08-22\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents an improved syringe design for more accurate and comfortable insulin delivery. The syringe features a redesigned plunger and needle to reduce pain and improve dosage control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Prior art in syringe technology\"\n        }\n    ],\n    \"claims\": [\n        \"A syringe comprising a plunger with a modified shape...\",\n        \"A needle assembly for use with said syringe...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68009", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Sepsis Diagnosis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device is disclosed for rapid and accurate detection of sepsis biomarkers in whole blood. The device enables point-of-care diagnosis, facilitating timely treatment and improved patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device for detecting sepsis biomarkers.\",\n        \"A method for diagnosing sepsis using the device.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68009", "text": "{\n    \"patent_title\": \"Magnetic Resonance Imaging System with Improved Resolution\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-01-10\",\n    \"filing_date\": \"2022-01-10\",\n    \"issue_date\": \"2024-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved magnetic resonance imaging (MRI) system is presented, featuring enhanced spatial resolution and reduced scan time. The system utilizes novel gradient coil designs and advanced image reconstruction algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI system with improved spatial resolution.\",\n        \"A method for reducing scan time in MRI.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68010", "text": "{\n    \"patent_title\": \"High Energy Density Lithium-Ion Battery with Novel Electrolyte\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery with a novel electrolyte composition exhibiting increased energy density and improved cycle life. The electrolyte includes a unique blend of lithium salts and additives designed to enhance ion conductivity and suppress dendrite formation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Lithium-Ion Battery with Improved Thermal Stability\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Electrolyte Additives for Lithium-Ion Batteries\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising a cathode, an anode, and an electrolyte.\",\n        \"The battery of claim 1, wherein the electrolyte comprises a lithium salt.\",\n        \"The battery of claim 2, wherein the lithium salt is LiPF6.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68010", "text": "{\n    \"patent_title\": \"Method for Producing Silicon Anodes for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"General Motors Research\"\n        }\n    ],\n    \"patent_number\": \"US11123456B1\",\n    \"priority_date\": \"2017-08-20\",\n    \"filing_date\": \"2017-08-20\",\n    \"issue_date\": \"2021-09-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for producing silicon anodes with enhanced structural integrity for use in lithium-ion batteries, improving cycle life and reducing capacity fade. The process involves a novel doping technique.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9234567B2\",\n            \"title\": \"Silicon Anode Materials for Lithium-Ion Batteries\"\n        },\n        {\n            \"patent_number\": \"US8345678B1\",\n            \"title\": \"Lithium-Ion Battery Fabrication Techniques\"\n        },\n        {\n            \"patent_number\": \"US7456789B2\",\n            \"title\": \"Silicon-Carbon Composite Anodes\"\n        },\n        {\n            \"patent_number\": \"US6567890B1\",\n            \"title\": \"Surface Modification of Silicon for Battery Applications\"\n        }\n    ],\n    \"claims\": [\n        \"A method for producing a silicon anode comprising...\",\n        \"The method of claim 1, further comprising...\",\n        \"The method of claim 2, wherein the silicon is...\",\n        \"The anode produced by the method of claim 1.\",\n        \"A lithium-ion battery comprising the anode of claim 4.\",\n        \"The lithium-ion battery of claim 5, wherein...\",\n        \"The lithium-ion battery of claim 6, further...\",\n        \"The lithium-ion battery of claim 7, wherein...\",\n        \"The lithium-ion battery of claim 8, and...\",\n        \"The lithium-ion battery of claim 9, wherein...\",\n        \"The lithium-ion battery of claim 10, further...\",\n        \"The lithium-ion battery of claim 11, and...\",\n        \"The lithium-ion battery of claim 12, wherein...\",\n        \"The lithium-ion battery of claim 13, and...\",\n        \"The lithium-ion battery of claim 14, wherein...\",\n        \"The lithium-ion battery of claim 15, further...\",\n        \"The lithium-ion battery of claim 16, and...\",\n        \"The lithium-ion battery of claim 17, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68011", "text": "{\n    \"patent_title\": \"Enhanced MRI Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-04-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing high-resolution MRI images using a deep convolutional neural network. The method significantly reduces scan time and improves image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images using a deep learning model.\",\n        \"The method of claim 1, wherein the deep learning model is a convolutional neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68011", "text": "{\n    \"patent_title\": \"System and Method for Medical Image Analysis using Cloud Computing\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"IBM Research\"\n        }\n    ],\n    \"patent_number\": \"EP3123456B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-14\",\n    \"issue_date\": \"2020-02-26\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"A system and method for analyzing medical images using cloud-based computing resources. The system provides scalability and cost-effectiveness for medical image processing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related to cloud-based image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A system for analyzing medical images comprising a cloud computing platform.\",\n        \"The system of claim 1, wherein the medical images are stored in a cloud storage service.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68012", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Enhancement for Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"EP3876543B1\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-09-20\",\n    \"issue_date\": \"2022-12-01\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"A novel image enhancement technique utilizing deep convolutional neural networks for improving the quality of medical images, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US20180192345A1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing medical images comprising: applying a deep neural network to a medical image to improve its quality; and displaying the enhanced image.\",\n        \"The method of claim 1, wherein the deep neural network is a convolutional neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68012", "text": "{\n    \"patent_title\": \"Image Compression using Discrete Cosine Transform\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A system for compressing images using a Discrete Cosine Transform (DCT) algorithm, resulting in reduced file sizes without significant loss of quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image comprising: applying a discrete cosine transform to the image; quantizing the transformed image; and encoding the quantized image.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68013", "text": "{\n    \"patent_title\": \"Implantable Cardioverter Defibrillator with Adaptive Stimulation\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Boston Scientific\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-11-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardioverter defibrillator (ICD) with adaptive stimulation parameters to minimize discomfort and maximize efficacy in treating ventricular arrhythmias. The device utilizes a novel algorithm for detecting and classifying arrhythmias, reducing false positive detections and unnecessary shocks. This represents a significant improvement over prior art ICDs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art ICD design\"\n        }\n    ],\n    \"claims\": [\n        \"A method for adaptively stimulating a patient's heart...\",\n        \"An implantable cardioverter defibrillator comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68013", "text": "{\n    \"patent_title\": \"Catheter Design for Angiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2018-12-10\",\n    \"filing_date\": \"2018-12-10\",\n    \"issue_date\": \"2020-05-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel catheter design with improved flexibility for navigating through complex vascular structures during angiography. The catheter incorporates a tapered tip and lubricious coating.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Previous catheter design\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible shaft...\",\n        \"A method for performing angiography using the catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68014", "text": "{\n    \"patent_title\": \"Wind Turbine Blade Design with Enhanced Aerodynamic Efficiency\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-09-20\",\n    \"issue_date\": \"2022-04-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel wind turbine blade design incorporating advanced materials and aerodynamic principles to improve energy capture efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on blade airfoil design\"\n        }\n    ],\n    \"claims\": [\n        \"A wind turbine blade comprising a composite material with a specific fiber orientation.\",\n        \"A wind turbine blade with an airfoil shape optimized for high wind speeds.\",\n        \"A wind turbine system incorporating the aforementioned blade design.\",\n        \"A method for manufacturing a wind turbine blade with improved aerodynamic characteristics.\",\n        \"A control system for adjusting the pitch of the wind turbine blade based on wind conditions.\",\n        \"A method for increasing power output of a wind turbine.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68014", "text": "{\n    \"patent_title\": \"High-Efficiency Silicon Solar Cell with Perovskite Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"SunPower Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-07-01\",\n    \"issue_date\": \"2021-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved silicon solar cell incorporating a perovskite layer to enhance light absorption and energy conversion efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art on perovskite solar cell technology\"\n        }\n    ],\n    \"claims\": [\n        \"A solar cell comprising a silicon substrate and a perovskite layer.\",\n        \"A method for fabricating a solar cell with enhanced efficiency.\",\n        \"A solar panel incorporating the aforementioned solar cell.\",\n        \"A method for improving the stability of a perovskite layer.\",\n        \"A system for converting sunlight into electricity.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68015", "text": "{\n    \"patent_title\": \"Micro-Robotic System for Targeted Drug Delivery During Minimally Invasive Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"EP3845921B1\",\n    \"priority_date\": \"2019-07-15\",\n    \"filing_date\": \"2020-07-10\",\n    \"issue_date\": \"2021-11-24\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"This invention discloses a micro-robotic system designed for precise drug delivery within the body during minimally invasive surgical procedures. The system utilizes advanced imaging techniques for real-time navigation and control, enhancing therapeutic efficacy and reducing patient recovery times. It also incorporates novel biocompatible materials for improved performance and safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8540023B2\",\n            \"title\": \"Micro-Robot for Internal Surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A micro-robotic system comprising a micro-robot, a control unit, and an imaging module.\",\n        \"The system of claim 1, wherein the micro-robot is configured for targeted drug delivery.\",\n        \"The system of claim 1, wherein the imaging module provides real-time feedback for navigation.\",\n        \"The system of claim 1, wherein the micro-robot is constructed from biocompatible materials.\",\n        \"A method for performing a minimally invasive surgical procedure using the system of claim 1.\",\n        \"The method of claim 5, further comprising monitoring the patient's physiological parameters during the procedure.\",\n        \"The micro-robotic system of claim 1, designed for diagnostic imaging.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68015", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Cardiovascular Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emily Wilson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-01\",\n    \"filing_date\": \"2020-03-01\",\n    \"issue_date\": \"2022-01-18\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"An improved catheter design for navigating the cardiovascular system. The catheter features a flexible tip and enhanced maneuverability for precise placement during diagnostic and interventional procedures. It's aimed at improving the efficiency and safety of common cardiovascular procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Flexible Catheter with Enhanced Tip\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible tip and a shaft.\",\n        \"The catheter of claim 1, wherein the flexible tip is made of a biocompatible material.\",\n        \"The catheter of claim 1, further comprising a guidewire lumen.\",\n        \"The catheter of claim 1, designed for diagnostic imaging.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68016", "text": "{\n    \"patent_title\": \"Robotic Surgical Assistance System with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A robotic system for assisting surgeons during complex procedures. The system utilizes advanced sensors and AI algorithms to provide enhanced precision and control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        },\n        {\n            \"patent_number\": \"US11789012B2\"\n        },\n        {\n            \"patent_number\": \"US10987654B2\"\n        },\n        {\n            \"patent_number\": \"US12345678B2\"\n        },\n        {\n            \"patent_number\": \"US11223344B2\"\n        },\n        {\n            \"patent_number\": \"US10556677B2\"\n        },\n        {\n            \"patent_number\": \"US99887766B2\"\n        },\n        {\n            \"patent_number\": \"US11990011B2\"\n        },\n        {\n            \"patent_number\": \"US10224466B2\"\n        },\n        {\n            \"patent_number\": \"US12112233B2\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system comprising...\",\n        \"A method for assisting a surgeon...\",\n        \"A sensor for providing real-time feedback...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68016", "text": "{\n    \"patent_title\": \"Improved Bandage Material\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Small Biotech Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11890123B1\",\n    \"priority_date\": \"2020-02-15\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2023-05-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new bandage material with improved absorption capabilities and comfort.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A bandage material comprising...\",\n        \"A method for applying a bandage...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68017", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-07-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable biosensor for continuous glucose monitoring, utilizing novel nanomaterials and a biocompatible encapsulation technique. Provides real-time glucose readings for improved diabetes management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in glucose monitoring\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable biosensor comprising...\",\n        \"A method for continuous glucose monitoring using said biosensor...\",\n        \"A system for displaying glucose readings...\",\n        \"A biocompatible encapsulation material...\",\n        \"A nanomaterial-based glucose sensing element...\",\n        \"A communication module for transmitting data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68017", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2014-11-01\",\n    \"filing_date\": \"2014-11-01\",\n    \"issue_date\": \"2019-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler featuring an ergonomic handle design and enhanced staple deployment mechanism. Aimed at reducing surgeon fatigue and improving surgical precision.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous surgical stapler designs\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an ergonomic handle...\",\n        \"A staple cartridge designed for...\",\n        \"A deployment mechanism...\",\n        \"A safety lock feature...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68018", "text": "{\n    \"patent_title\": \"Advanced Modulation Techniques for High-Throughput Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Qualcomm Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-11-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention introduces a novel modulation scheme that significantly increases data throughput in wireless communication systems. It utilizes a combination of orthogonal frequency-division multiplexing (OFDM) and a new type of space-time coding, resulting in improved spectral efficiency and reduced bit error rates.  The technique enables faster and more reliable wireless connections for various applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8781012B2\",\n            \"title\": \"OFDM-Based Wireless Communication System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for transmitting data wirelessly comprising...\",\n        \"An apparatus for modulating data for wireless transmission comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68018", "text": "{\n    \"patent_title\": \"Improved Antenna Design for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Apple Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an improved antenna design for mobile devices, enhancing signal strength and reducing interference. The antenna features a novel geometry and material composition, leading to better performance in challenging wireless environments. The design focuses on optimizing antenna efficiency within the constraints of small form factor devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Miniature Antenna for Mobile Communication\"\n        }\n    ],\n    \"claims\": [\n        \"An antenna for a mobile device comprising...\",\n        \"A method for manufacturing an antenna with improved signal strength comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68019", "text": "{\n    \"patent_title\": \"Deep Learning-Based Reconstruction for Accelerated MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for reconstructing MRI images using deep learning to significantly reduce scan time while maintaining image quality. The approach employs a novel convolutional neural network architecture trained on a large dataset of MRI scans.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"MRI Reconstruction using Compressed Sensing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"A system for performing MRI reconstruction...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68019", "text": "{\n    \"patent_title\": \"Improved Gadolinium-Based Contrast Agent for MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"GE Healthcare\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2023-05-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel gadolinium-based contrast agent with improved relaxivity and reduced toxicity for use in magnetic resonance imaging. The agent exhibits enhanced signal intensity and biocompatibility.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Gadolinium Chelate Complexes\"\n        }\n    ],\n    \"claims\": [\n        \"A gadolinium-based contrast agent comprising...\",\n        \"A method of enhancing MRI imaging...\",\n        \"A pharmaceutical composition...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68020", "text": "{\n    \"patent_title\": \"Miniature Implantable Cardiac Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-06-22\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A miniaturized, fully implantable cardiac monitoring system for long-term detection of arrhythmias. This device addresses the unmet need for continuous cardiac monitoring without the limitations of traditional Holter monitors or event recorders. The system incorporates advanced signal processing and wireless communication capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in implantable cardiac devices\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable cardiac monitoring system comprising...\",\n        \"A method for continuous cardiac monitoring using said system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68020", "text": "{\n    \"patent_title\": \"Surgical Instrument for Bone Cutting\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"Smith & Nephew\"\n        }\n    ],\n    \"patent_number\": \"EP3210987B1\",\n    \"priority_date\": \"2019-12-01\",\n    \"filing_date\": \"2020-04-10\",\n    \"issue_date\": \"2021-09-15\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"An improved surgical instrument for precise bone cutting during orthopedic procedures. The instrument incorporates a novel blade design for enhanced cutting efficiency and reduced tissue damage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Existing surgical bone cutting tools\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising a cutting blade...\",\n        \"A method for bone cutting using said instrument...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68021", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-06-15\",\n    \"issue_date\": \"2018-02-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system incorporating a high-resolution imaging module and robotic arms for precise manipulation of surgical instruments. The system reduces patient trauma and recovery time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Robotic Surgical System\"\n        }\n    ],\n    \"claims\": [\n        \"A minimally invasive surgical system comprising...\",\n        \"A method for performing surgery using the system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68021", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Fluid Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2014-12-15\",\n    \"filing_date\": \"2015-01-20\",\n    \"issue_date\": \"2017-05-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design for efficient and reliable fluid delivery to patients. The catheter features a novel tip geometry to minimize blockage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Catheter with Flexible Tip\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible tip...\",\n        \"A method for delivering fluids using the catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68022", "text": "{\n    \"patent_title\": \"Miniature Wireless Sensor for Remote Physiological Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless sensor is disclosed for remotely monitoring physiological parameters. The device allows for minimally invasive data collection, improving patient comfort and enabling early diagnosis of medical conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Prior art in wireless sensor technology\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor comprising a miniaturized housing.\",\n        \"A system for remotely monitoring physiological parameters.\",\n        \"A method for minimally invasive data collection.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68022", "text": "{\n    \"patent_title\": \"Automated Surgical Robotic System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-01-05\",\n    \"filing_date\": \"2019-03-10\",\n    \"issue_date\": \"2021-07-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated surgical robotic system is described, enabling surgeons to perform complex procedures with enhanced precision and control. The system utilizes advanced imaging and robotic manipulation techniques to improve surgical outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US1011223344B2\",\n            \"relevance\": \"Related art in robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic system comprising a robotic arm.\",\n        \"A method for performing surgical procedures using robotic assistance.\",\n        \"A control system for manipulating the robotic arm.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68023", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction with Reduced Radiation Dose\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing medical images from limited data, resulting in significant reduction of radiation exposure while maintaining diagnostic image quality. The method utilizes advanced iterative reconstruction algorithms and regularization techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for reducing radiation dose during medical imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68023", "text": "{\n    \"patent_title\": \"Apparatus for Processing Photographic Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Kodak Research Labs\"\n        }\n    ],\n    \"patent_number\": \"US4500000\",\n    \"priority_date\": \"1984-01-15\",\n    \"filing_date\": \"1984-01-15\",\n    \"issue_date\": \"1985-04-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An apparatus for the automatic processing of photographic images, including developing, fixing, and washing stages.\",\n    \"citations\": [],\n    \"claims\": [\n        \"An apparatus for processing photographic images comprising...\",\n        \"A method for automatically developing photographic film...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68024", "text": "{\n    \"patent_title\": \"Patient-Comfortable Wearable Cardiac Monitor\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-03-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel wearable cardiac monitor designed for extended patient comfort. The device utilizes flexible sensors and a bio-compatible adhesive to minimize skin irritation during long-term monitoring. It focuses on non-invasive heart rhythm analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9120345B2\",\n            \"relevance\": \"Prior art in wearable sensor technology.\"\n        }\n    ],\n    \"claims\": [\n        \"A wearable cardiac monitor comprising flexible sensors.\",\n        \"A bio-compatible adhesive for secure and comfortable attachment.\",\n        \"A non-invasive heart rhythm analysis system.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68024", "text": "{\n    \"patent_title\": \"High-Resolution Medical Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. James Wilson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Sarah Chen\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2021-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A high-resolution medical imaging system utilizing advanced X-ray technology. This system provides detailed anatomical images for diagnostic purposes.  The system's software enhances image clarity and reduces radiation exposure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8987654B2\",\n            \"relevance\": \"Prior art in medical imaging systems.\"\n        }\n    ],\n    \"claims\": [\n        \"A medical imaging system comprising an X-ray source and detector.\",\n        \"Image enhancement software for increased clarity.\",\n        \"Radiation reduction techniques.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68025", "text": "{\n    \"patent_title\": \"Non-Invasive Cardiac Monitoring System with AI-Powered Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Chen\",\n            \"affiliation\": \"National Institutes of Health\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-11-20\",\n    \"issue_date\": \"2023-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive cardiac monitoring system utilizing advanced sensors and artificial intelligence algorithms to detect and analyze cardiac abnormalities in real-time, providing early warning for potential cardiovascular events. This system aims to address the limitations of current diagnostic methods by offering continuous, remote monitoring with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in sensor technology\"\n        }\n    ],\n    \"claims\": [\n        \"A system for non-invasive cardiac monitoring comprising...\",\n        \"An AI algorithm for analyzing ECG signals...\",\n        \"A method for detecting arrhythmias...\",\n        \"A remote patient monitoring platform...\",\n        \"A sensor module for measuring heart rate variability...\",\n        \"A data transmission module for secure data transfer...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68025", "text": "{\n    \"patent_title\": \"Surgical Robotic System with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Klein\",\n            \"affiliation\": \"Intuitive Surgical\"\n        },\n        {\n            \"name\": \"Sarah Lee\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-12-01\",\n    \"filing_date\": \"2021-06-15\",\n    \"issue_date\": \"2022-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical robotic system designed for minimally invasive surgical procedures. The system incorporates advanced sensors and control algorithms to enhance the surgeon's precision and dexterity, improving surgical outcomes and reducing patient recovery times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous robotic surgery systems\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic system comprising...\",\n        \"A control interface for surgeon input...\",\n        \"A robotic arm with multiple degrees of freedom...\",\n        \"A visualization system for enhanced surgical view...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68026", "text": "{\n    \"patent_title\": \"Implantable Cardiac Monitoring System with Wireless Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2015-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac monitoring system for continuous monitoring of heart activity, with wireless data transmission capabilities to a remote monitoring station. This system addresses the need for long-term, non-invasive cardiac monitoring.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Prior Art Cardiac Monitor\"\n        }\n    ],\n    \"claims\": [\n        \"A system for monitoring cardiac activity comprising...\",\n        \"A wireless communication module...\",\n        \"A method for transmitting cardiac data...\",\n        \"A remote monitoring station...\",\n        \"A power source for the implantable device...\",\n        \"A data analysis algorithm...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68026", "text": "{\n    \"patent_title\": \"Improved Stethoscope Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A redesigned stethoscope with enhanced acoustic properties and improved noise cancellation. Offers a more accurate and comfortable auscultation experience.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A stethoscope comprising a chest piece...\",\n        \"A tubing connecting the chest piece...\",\n        \"Eartips for placement in the user's ears...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68027", "text": "{\n    \"patent_title\": \"Enhanced MRI Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method for reconstructing high-resolution MRI images using deep convolutional neural networks. The method significantly reduces image artifacts and improves diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"office\": \"USPTO\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image...\",\n        \"A system for performing MRI image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68027", "text": "{\n    \"patent_title\": \"Improved X-ray Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2018-01-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved X-ray imaging system with reduced radiation exposure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"EP1234567B1\",\n            \"office\": \"EPO\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A method for operating an X-ray imaging system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68028", "text": "{\n    \"patent_title\": \"Novel MRI Contrast Agent for Enhanced Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-11-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel MRI contrast agent that significantly enhances the detection of cancerous tumors. The agent improves image clarity and sensitivity, leading to earlier and more accurate disease diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Prior art on MRI contrast agents\"\n        },\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"relevance\": \"Related research on tumor targeting\"\n        },\n        {\n            \"patent_number\": \"US55667788B1\",\n            \"relevance\": \"Early work on image enhancement\"\n        },\n        {\n            \"patent_number\": \"US22334455B1\",\n            \"relevance\": \"Similar approaches to cancer detection\"\n        },\n        {\n            \"patent_number\": \"US77889900B2\",\n            \"relevance\": \"Alternative contrast agents\"\n        },\n        {\n            \"patent_number\": \"US12345000B1\",\n            \"relevance\": \"Image processing techniques\"\n        },\n        {\n            \"patent_number\": \"US99001122B2\",\n            \"relevance\": \"Biomarker identification\"\n        },\n        {\n            \"patent_number\": \"US88990011B1\",\n            \"relevance\": \"Nanoparticle-based imaging\"\n        },\n        {\n            \"patent_number\": \"US44556677B2\",\n            \"relevance\": \"In vivo imaging studies\"\n        },\n        {\n            \"patent_number\": \"US33445566B1\",\n            \"relevance\": \"Contrast agent delivery systems\"\n        },\n        {\n            \"patent_number\": \"US66778899B2\",\n            \"relevance\": \"Molecular imaging probes\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI image contrast using a novel contrast agent.\",\n        \"The contrast agent comprising a specific nanoparticle formulation.\",\n        \"A system for detecting cancer using the contrast agent.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68028", "text": "{\n    \"patent_title\": \"Improved Algorithm for CT Scan Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"EP12345678B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2023-04-15\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"This invention describes an improved algorithm for reconstructing images from CT scan data. The algorithm reduces noise and artifacts, resulting in clearer images for diagnostic purposes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11112222B2\",\n            \"relevance\": \"Prior art on CT scan reconstruction\"\n        },\n        {\n            \"patent_number\": \"US33334444B1\",\n            \"relevance\": \"Related work on image filtering\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing images from CT scan data.\",\n        \"The algorithm comprising a novel filtering technique.\",\n        \"A system for performing CT scans using the algorithm.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68029", "text": "{\n    \"patent_title\": \"Magnetic Resonance Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing magnetic resonance images (MRI) using deep learning techniques. This method improves image quality and reduces scan time, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image...\",\n        \"A system for performing MRI reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68029", "text": "{\n    \"patent_title\": \"Improved X-Ray Image Enhancement Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2019-11-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved technique for enhancing the quality of X-ray images, leading to better visualization of bone fractures and other anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an X-ray image...\",\n        \"A system for processing X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68030", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging with Reduced Artifacts\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method for reducing artifacts in magnetic resonance imaging (MRI) by utilizing advanced signal processing techniques. The method is non-invasive and improves image clarity, aiding in more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on MRI signal processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing artifacts in MRI comprising...\",\n        \"An MRI system configured to implement the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68030", "text": "{\n    \"patent_title\": \"Enhanced X-Ray Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"GE Global Research\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2020-07-01\",\n    \"filing_date\": \"2020-07-01\",\n    \"issue_date\": \"2023-04-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved X-ray imaging system with enhanced resolution and reduced radiation exposure. The system utilizes a novel detector array and image reconstruction algorithm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US4567890\",\n            \"relevance\": \"Previous X-ray detector technology\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Image processing techniques\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A detector array with improved sensitivity...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68031", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Early Cancer Detection via Spectral CT Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2018-03-01\",\n    \"issue_date\": \"2021-11-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing early cancer detection utilizing spectral computed tomography (CT) imaging. The system analyzes spectral data to identify subtle tissue changes indicative of early-stage cancerous growth, improving diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in spectral CT imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancer comprising: acquiring spectral CT data; analyzing the spectral data to identify tissue anomalies; and providing a diagnostic assessment.\",\n        \"A system for performing the method of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68031", "text": "{\n    \"patent_title\": \"Digital Radiography System with Automated Image Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2016-11-20\",\n    \"filing_date\": \"2017-12-15\",\n    \"issue_date\": \"2022-05-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A digital radiography system incorporating advanced image enhancement algorithms to improve image quality and reduce radiation dose. The system provides automated adjustments to contrast, brightness, and sharpness.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Previous work on image enhancement in radiography.\"\n        }\n    ],\n    \"claims\": [\n        \"A digital radiography system comprising: an X-ray source; an image detector; an image processing module; and a display unit.\",\n        \"The system of claim 1, wherein the image processing module includes an automated contrast enhancement algorithm.\",\n        \"The system of claim 1, further comprising a radiation dose reduction module.\",\n        \"A method for operating the digital radiography system to improve image quality.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68032", "text": "{\n    \"patent_title\": \"High-Resolution Spectral CT Imaging System with AI-Powered Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel spectral computed tomography (CT) imaging system is disclosed, incorporating advanced detector technology and artificial intelligence-based image reconstruction algorithms. This system provides significantly improved image quality, reduced radiation dose, and enhanced diagnostic accuracy, particularly for characterizing subtle tissue abnormalities. The AI component is capable of denoising and artifact reduction, resulting in clinically useful images even with low-dose protocols.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in spectral CT imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A CT imaging system comprising...\",\n        \"A method for reconstructing CT images using AI...\",\n        \"An AI algorithm for artifact reduction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68032", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for MRI Scans\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2017-12-15\",\n    \"issue_date\": \"2022-03-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new formulation of gadolinium-based contrast agent for magnetic resonance imaging (MRI). The improved formulation exhibits enhanced relaxivity and reduced toxicity compared to existing contrast agents, resulting in brighter images and improved patient safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous contrast agent formulations\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent composition comprising...\",\n        \"A method for enhancing MRI images using the composition...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68033", "text": "{\n    \"patent_title\": \"Miniaturized Optical Coherence Tomography System for In-Vivo Tissue Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-01\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A compact and high-resolution optical coherence tomography (OCT) system for in-vivo tissue imaging. The device enables minimally invasive diagnosis of early-stage cancers and cardiovascular diseases. The system utilizes a novel fiber optic probe design and advanced image processing algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in OCT imaging techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for in-vivo tissue imaging using OCT.\",\n        \"An OCT system comprising a fiber optic probe and an image processing unit.\",\n        \"A device for minimally invasive diagnosis of diseases.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68033", "text": "{\n    \"patent_title\": \"Automated Surgical Stapler with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Jane Doe\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2018-05-20\",\n    \"filing_date\": \"2020-08-15\",\n    \"issue_date\": \"2022-06-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated surgical stapler designed to improve precision and efficiency in surgical procedures. The stapler incorporates a feedback control system and advanced sensor technology to ensure accurate staple placement and minimize tissue damage. This system is intended for complex surgical operations.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Existing surgical stapler designs.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an automated control system.\",\n        \"A method for precise staple placement during surgical procedures.\",\n        \"A surgical stapler with integrated sensor technology.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68034", "text": "{\n    \"patent_title\": \"Remote Physiological Monitoring System and Method\",\n    \"inventors\": [\n        {\n            \"name\": \"David Ha\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A remote physiological monitoring system and method for continuously tracking vital signs of patients outside of traditional clinical settings. The system utilizes wearable sensors and a cloud-based platform to transmit data to healthcare providers, enabling proactive intervention and improved patient outcomes.  The system features advanced algorithms for anomaly detection and personalized alerts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"kind\": \"Cited by Applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A system for remotely monitoring physiological parameters comprising...\",\n        \"A method for analyzing physiological data to predict patient deterioration...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68034", "text": "{\n    \"patent_title\": \"Surgical Instrument with Improved Grip\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"EP3456789A1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-04-06\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"A novel surgical instrument designed to provide enhanced grip and control for surgeons during minimally invasive procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"kind\": \"Cited by Examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising a handle and a grasping mechanism...\",\n        \"The surgical instrument according to claim 1, wherein the handle is ergonomically designed...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68035", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Sensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized wireless sensor for continuous glucose monitoring, enabling remote patient monitoring and improved diabetes management. The device utilizes a novel enzymatic biofuel cell for self-powering and integrates Bluetooth connectivity for data transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"citation_type\": \"Cited by\"\n        },\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"citation_type\": \"Cited by\"\n        },\n        {\n            \"patent_number\": \"US76543210B1\",\n            \"citation_type\": \"Cited by\"\n        },\n        {\n            \"patent_number\": \"US65432109B2\",\n            \"citation_type\": \"Cited by\"\n        },\n        {\n            \"patent_number\": \"US54321098B1\",\n            \"citation_type\": \"Cited by\"\n        },\n        {\n            \"patent_number\": \"US43210987B2\",\n            \"citation_type\": \"Cited by\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless glucose monitoring sensor comprising...\",\n        \"A method for remote patient monitoring using the sensor...\",\n        \"A system for managing diabetes utilizing the sensor data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68035", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Minimally Invasive Surgery\",\n    \"inventors\": [\n        {\n            \"name\": \"Li Wei\",\n            \"affiliation\": \"Shanghai Jiao Tong University\"\n        }\n    ],\n    \"patent_number\": \"CN112233445A\",\n    \"priority_date\": \"2019-12-01\",\n    \"filing_date\": \"2020-06-15\",\n    \"issue_date\": \"2021-09-01\",\n    \"patent_office\": \"SIPO\",\n    \"abstract\": \"A novel catheter design offering improved flexibility and maneuverability for minimally invasive surgical procedures. The catheter incorporates a shape memory alloy for enhanced control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"CN101234567A\",\n            \"citation_type\": \"Cited by\"\n        },\n        {\n            \"patent_number\": \"CN202233445B\",\n            \"citation_type\": \"Cited by\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a shape memory alloy...\",\n        \"A method for performing minimally invasive surgery using the catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68036", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Reconstruction in Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel method for improving the quality of images reconstructed from magnetic resonance imaging (MRI) data. The method utilizes a deep learning algorithm to reduce noise and enhance resolution, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"MRI Image Enhancement Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an image from MRI data comprising...\",\n        \"A system for implementing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68036", "text": "{\n    \"patent_title\": \"Novel Iodinated Contrast Agent for Computed Tomography\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new iodinated contrast agent with improved properties for use in computed tomography (CT) scans. The agent provides enhanced visualization of blood vessels and tissues.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"CT Contrast Agent Formulation\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent composition comprising...\",\n        \"A method for enhancing CT imaging using the composition of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68037", "text": "{\n    \"patent_title\": \"Enhanced Medical Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-01-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing medical images from incomplete data using deep convolutional neural networks. The invention significantly improves image quality and reduces artifacts, leading to more accurate diagnoses. The system leverages artificial intelligence for faster and more precise reconstruction.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for medical image reconstruction utilizing...\",\n        \"A computer-readable medium storing instructions for...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68037", "text": "{\n    \"patent_title\": \"Improved X-ray Tube Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Karl Schmidt\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2016-11-01\",\n    \"issue_date\": \"2019-05-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved design for X-ray tubes that enhances radiation efficiency and reduces heat generation. This results in clearer images and lower patient exposure. While it increases the quality of images, it does not involve any artificial intelligence.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube comprising...\",\n        \"A method for manufacturing an X-ray tube...\",\n        \"A radiation source utilizing the improved tube design...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68038", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2019-06-15\",\n    \"filing_date\": \"2019-06-14\",\n    \"issue_date\": \"2020-11-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system incorporating advanced imaging technology for improved precision and patient outcomes. The system provides real-time feedback to the surgeon, reducing complications and recovery time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art in surgical imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising an imaging module...\",\n        \"A method for performing minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68038", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"EP3876543A1\",\n    \"priority_date\": \"2020-03-10\",\n    \"filing_date\": \"2020-03-09\",\n    \"issue_date\": \"2021-07-07\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"An improved catheter design for targeted drug delivery, enhancing therapeutic efficacy and minimizing side effects. This design incorporates biocompatible materials and a novel flow control mechanism.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related to catheter materials\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a biocompatible polymer...\",\n        \"A method for delivering drugs using the catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68039", "text": "{\n    \"patent_title\": \"Ultrasound Image Enhancement System for Improved Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing ultrasound images to improve the detection of tumors. The system employs adaptive filtering techniques to reduce noise and highlight subtle features, enhancing diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8545321B2\"\n        },\n        {\n            \"patent_number\": \"US9233456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing ultrasound images comprising...\",\n        \"An ultrasound imaging system comprising...\",\n        \"The method of claim 1, wherein the adaptive filter...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68039", "text": "{\n    \"patent_title\": \"Method for Rapid MRI Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-09-20\",\n    \"filing_date\": \"2017-09-20\",\n    \"issue_date\": \"2020-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for rapid reconstruction of magnetic resonance images. This technique utilizes advanced algorithms to significantly reduce image processing time, enabling faster clinical diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images...\",\n        \"The method of claim 1, wherein the algorithm...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68040", "text": "{\n    \"patent_title\": \"Non-Invasive Medical Imaging System Using Photoacoustic Tomography\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive medical imaging system utilizing photoacoustic tomography for high-resolution subsurface imaging of biological tissues. This system offers improved contrast and penetration depth compared to traditional optical imaging methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Photoacoustic Imaging Apparatus\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Ultrasound Imaging System\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Optical Coherence Tomography\"\n        },\n        {\n            \"patent_number\": \"US8987654B1\",\n            \"title\": \"Medical Imaging Device\"\n        },\n        {\n            \"patent_number\": \"US9234567B2\",\n            \"title\": \"Contrast Agents for Medical Imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A medical imaging system comprising a photoacoustic transducer...\",\n        \"A method for non-invasive imaging of biological tissues...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68040", "text": "{\n    \"patent_title\": \"Contrast Enhancement Technique for X-Ray Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        }\n    ],\n    \"patent_number\": \"US10456789B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel contrast enhancement technique for X-ray imaging utilizing a new class of iodinated contrast agents. The technique provides improved visualization of blood vessels and tissues.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"X-Ray Imaging System\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Contrast Agents for X-Ray Imaging\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Digital Radiography\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising an iodinated compound...\",\n        \"A method for enhancing X-ray images using the contrast agent...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68041", "text": "{\n    \"patent_title\": \"High-Resolution Spectral CT Imaging System with AI-Powered Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2023-11-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel spectral computed tomography (CT) imaging system coupled with an artificial intelligence (AI) reconstruction algorithm. The system utilizes advanced detector technology to capture spectral data, enabling improved material differentiation and reduced radiation dose.  The AI algorithm reconstructs high-resolution images from sparse projection data, surpassing conventional iterative reconstruction methods. This breakthrough promises significant advancements in medical diagnostics and treatment planning.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art on spectral CT detectors\"\n        }\n    ],\n    \"claims\": [\n        \"A spectral CT imaging system comprising...\",\n        \"An AI-powered reconstruction algorithm for...\",\n        \"A method for reducing radiation dose in CT imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68041", "text": "{\n    \"patent_title\": \"Improved X-Ray Tube Cooling System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2018-04-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved cooling system for X-ray tubes used in medical imaging. The system utilizes a more efficient heat sink and coolant to dissipate heat, thereby increasing the lifespan of the X-ray tube and improving image quality. It's a relatively incremental improvement to existing technologies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US4200000\",\n            \"relevance\": \"Prior art related to X-ray tube design\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube cooling system comprising...\",\n        \"A heat sink with enhanced surface area...\",\n        \"A coolant circulation system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68042", "text": "{\n    \"patent_title\": \"Enhanced Magnetic Resonance Imaging for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-07-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for enhancing the resolution of magnetic resonance images, leading to improved detection of early-stage cancerous tumors. The method employs a unique pulse sequence and image reconstruction algorithm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Similar MRI techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI image resolution comprising...\",\n        \"An MRI apparatus configured to implement the method...\",\n        \"A system for detecting cancerous tumors using the enhanced MRI images...\",\n        \"The method of claim 1, wherein the pulse sequence...\",\n        \"The system of claim 3, further comprising a user interface...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68042", "text": "{\n    \"patent_title\": \"Novel X-ray Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2018-11-01\",\n    \"issue_date\": \"2021-04-13\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new X-ray imaging system with improved radiation shielding. It utilizes a novel detector array for faster image acquisition.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related X-ray technology\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A radiation shield for the X-ray imaging system...\",\n        \"A detector array for the X-ray imaging system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68043", "text": "{\n    \"patent_title\": \"Non-Invasive Glucose Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive glucose monitoring system utilizing optical sensors to determine glucose levels in interstitial fluid, improving patient comfort and reducing the need for frequent blood draws.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Continuous Glucose Monitoring Device\"\n        }\n    ],\n    \"claims\": [\n        \"A non-invasive glucose monitoring system comprising...\",\n        \"A method for determining glucose levels...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68043", "text": "{\n    \"patent_title\": \"Surgical Stapler with Enhanced Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Intuitive Surgical\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-07-01\",\n    \"filing_date\": \"2021-09-15\",\n    \"issue_date\": \"2024-02-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler featuring a redesigned handle and firing mechanism for enhanced precision and reduced surgeon fatigue during minimally invasive procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Automated Surgical Stapler\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"A firing mechanism for a surgical stapler...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68044", "text": "{\n    \"patent_title\": \"Method for Enhancing MRI Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10543217B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2020-01-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for enhancing the resolution of Magnetic Resonance Images (MRI) using a deep convolutional neural network. The method significantly improves image clarity, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in MRI image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI image resolution comprising...\",\n        \"A system for implementing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68044", "text": "{\n    \"patent_title\": \"Contrast Agent for Improved X-ray Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"EP3854721B1\",\n    \"priority_date\": \"2018-09-20\",\n    \"filing_date\": \"2018-09-19\",\n    \"issue_date\": \"2020-07-15\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"A novel contrast agent for use in X-ray imaging. The agent increases the visibility of blood vessels, leading to improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related to prior art contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"A method for using the contrast agent...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68045", "text": "{\n    \"patent_title\": \"Method and System for Adaptive Power Management in Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2020-04-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for adaptively managing power consumption in mobile devices based on user behavior and application usage patterns, employing a novel energy-efficient algorithm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for adaptively managing power consumption in a mobile device.\",\n        \"The method comprising identifying user behavior patterns.\",\n        \"The method further comprising adjusting power allocation based on identified patterns.\",\n        \"A system for implementing the method.\",\n        \"The system including a processor and memory.\",\n        \"The system designed for energy efficiency.\",\n        \"The method improving battery life.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68045", "text": "{\n    \"patent_title\": \"Miniaturized Battery Design for Mobile Phones\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US11345678B2\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2021-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel design for a miniaturized lithium-ion battery intended for use in mobile phones, featuring a new electrode material and packaging technique. Improves energy density.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell for a mobile phone.\",\n        \"The battery cell comprising a novel electrode material.\",\n        \"The battery cell having a miniaturized form factor.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68046", "text": "{\n    \"patent_title\": \"Minimally Invasive Glucose Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"US\",\n    \"abstract\": \"A minimally invasive glucose monitoring system utilizing biocompatible sensors for continuous glucose level detection, improving diabetes management and patient quality of life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in glucose sensor technology.\"\n        }\n    ],\n    \"claims\": [\n        \"A glucose monitoring system comprising a biocompatible sensor.\",\n        \"A method for continuous glucose monitoring using said system.\",\n        \"A system for transmitting glucose data to a mobile device.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68046", "text": "{\n    \"patent_title\": \"Complex Surgical Robotic Arm\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"General Electric\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"US\",\n    \"abstract\": \"A highly advanced surgical robotic arm with multiple degrees of freedom, designed for complex surgical procedures. Integrates AI-powered image guidance and precision control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art in robotic surgery.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic arm comprising at least ten degrees of freedom.\",\n        \"A control system for precise manipulation of surgical instruments.\",\n        \"An image guidance system integrated with the robotic arm.\",\n        \"A method for performing surgery using the robotic arm.\",\n        \"A data processing unit for analyzing surgical images.\",\n        \"A feedback control loop for optimizing surgical performance.\",\n        \"A safety mechanism to prevent unintended movements.\",\n        \"A user interface for controlling the robotic arm.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68047", "text": "{\n    \"patent_title\": \"High-Capacity Lithium-Ion Battery with Enhanced Energy Density\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel lithium-ion battery design achieving significantly enhanced energy density through the incorporation of a three-dimensional electrode architecture and a new electrolyte formulation. The improved energy density enables longer operating times and increased performance in various applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art on electrolyte compositions.\"\n        }\n    ],\n    \"claims\": [\n        \"1. A lithium-ion battery comprising...\",\n        \"2. The battery of claim 1, wherein the battery is suitable for automotive applications.\",\n        \"3. The battery of claim 2, comprising an energy density exceeding 300 Wh/kg.\",\n        \"4. The battery of claim 3, for use in electric transportation.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68047", "text": "{\n    \"patent_title\": \"Improved Fuel Cell Technology for Stationary Power Generation\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Dr. Emily Foster\",\n            \"affiliation\": \"University of Texas at Austin\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2022-02-15\",\n    \"filing_date\": \"2022-02-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details advancements in proton exchange membrane fuel cell (PEMFC) technology, focusing on catalyst optimization and membrane durability for stationary power generation applications. The design improves efficiency and reduces manufacturing costs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Prior art related to PEMFC catalysts.\"\n        }\n    ],\n    \"claims\": [\n        \"1. A fuel cell comprising...\",\n        \"2. The fuel cell of claim 1, designed for stationary power systems.\",\n        \"3. The fuel cell of claim 2, achieving an efficiency of 60%.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68048", "text": "{\n    \"patent_title\": \"Enhanced Magnetic Resonance Imaging Contrast Agent for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel contrast agent for magnetic resonance imaging (MRI) that significantly enhances the detection of early-stage cancers. The agent targets specific biomarkers expressed in tumor cells, leading to improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on MRI contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"A method for detecting cancer...\",\n        \"An MRI apparatus configured to use the contrast agent...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68048", "text": "{\n    \"patent_title\": \"Fast Image Reconstruction Algorithm for Computed Tomography\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2022-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An efficient algorithm for reconstructing images from computed tomography (CT) scans, reducing processing time and radiation exposure. Focuses on optimizing the iterative reconstruction process.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related work on iterative reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an image...\",\n        \"A computer system for performing the method...\",\n        \"A computer-readable medium...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68049", "text": "{\n    \"patent_title\": \"Enhanced Battery Life via Integrated Energy Harvesting and Dynamic Power Management\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-11-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-08-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel system for extending battery life in portable electronic devices by integrating energy harvesting from ambient sources (e.g., RF, solar) with a dynamic power management algorithm. The system intelligently switches between harvested energy and battery power, optimizing for efficiency and minimizing energy waste. The power management component utilizes machine learning to predict user behavior and adjust power consumption accordingly.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"cited_by\": \"This patent builds on the principles outlined in US9876543B1, but introduces a more robust energy harvesting component.\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"cited_by\": \"The dynamic power management algorithm improves upon the techniques described in US10123456B2.\"\n        }\n    ],\n    \"claims\": [\n        \"A portable electronic device comprising an energy harvesting module.\",\n        \"A dynamic power management system for optimizing battery life.\",\n        \"A method for switching between harvested energy and battery power.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68049", "text": "{\n    \"patent_title\": \"Improved Battery Connector for Mobile Phones\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Samsung Electronics\"\n        }\n    ],\n    \"patent_number\": \"US11456789B1\",\n    \"priority_date\": \"2020-05-01\",\n    \"filing_date\": \"2020-09-18\",\n    \"issue_date\": \"2022-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved battery connector design for mobile phones, providing a more secure and reliable connection between the battery and the device. The connector features a novel locking mechanism and improved conductivity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"cited_by\": \"This invention improves upon the connector design described in US8765432B2.\"\n        }\n    ],\n    \"claims\": [\n        \"A battery connector for a mobile phone.\",\n        \"A locking mechanism for securing a battery connection.\",\n        \"A connector with improved electrical conductivity.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68050", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"11234567\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical system incorporating real-time image guidance and robotic assistance for minimally invasive procedures. The system enhances surgical precision, reduces patient trauma, and improves post-operative recovery times, leading to better patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"10123456\",\n            \"kind\": \"US Patent\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising a robotic arm...\",\n        \"A method for performing a minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68050", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Vascular Access\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"General Hospital Corp.\"\n        },\n        {\n            \"name\": \"Emily Chen\",\n            \"affiliation\": \"General Hospital Corp.\"\n        }\n    ],\n    \"patent_number\": \"11890123\",\n    \"priority_date\": \"2020-11-15\",\n    \"filing_date\": \"2020-11-15\",\n    \"issue_date\": \"2022-10-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design with enhanced flexibility and reduced friction for easier navigation through blood vessels during vascular access procedures.  Focus is on ease of insertion, not necessarily long-term patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"9876543\",\n            \"kind\": \"US Patent\"\n        },\n        {\n            \"patent_number\": \"10987654\",\n            \"kind\": \"US Patent\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible shaft...\",\n        \"A method for inserting a catheter into a blood vessel...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68051", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Sensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"MedTech Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2022-12-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable glucose sensor utilizing advanced microfabrication techniques for continuous and real-time glucose monitoring in diabetic patients. The sensor provides improved accuracy and biocompatibility compared to existing devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Implantable Glucose Sensor with Wireless Communication\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable glucose sensor comprising...\",\n        \"A method for continuous glucose monitoring using the sensor...\",\n        \"A system for wireless transmission of glucose data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68051", "text": "{\n    \"patent_title\": \"Novel Surgical Instrument for Laparoscopic Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"General Hospital\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Surgical Devices Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2021-08-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical instrument designed for improved precision and dexterity during laparoscopic procedures. The instrument incorporates an ergonomic handle and articulated tip.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Laparoscopic Surgical Instrument with Enhanced Visualization\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising an articulated tip...\",\n        \"A method for performing laparoscopic surgery using the instrument...\",\n        \"An ergonomic handle for improved surgical control...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68052", "text": "{\n    \"patent_title\": \"Method and System for Dynamically Adjusting Display Refresh Rate to Extend Mobile Device Battery Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-06-20\",\n    \"issue_date\": \"2021-12-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel method for dynamically adjusting the display refresh rate of a mobile device based on the content being displayed and user interaction, resulting in significant battery life extension. The system utilizes machine learning to predict optimal refresh rates.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art on display power management\"\n        }\n    ],\n    \"claims\": [\n        \"A method for dynamically adjusting display refresh rate comprising...\",\n        \"A mobile device comprising a display and a processor configured...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68052", "text": "{\n    \"patent_title\": \"Improved Charging Circuit for Mobile Phones\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Samsung Electronics\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2017-11-22\",\n    \"filing_date\": \"2018-01-10\",\n    \"issue_date\": \"2020-04-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved charging circuit for mobile phones that reduces charging time by optimizing current delivery. It builds upon existing fast-charging technologies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art on fast charging technologies\"\n        }\n    ],\n    \"claims\": [\n        \"A charging circuit comprising...\",\n        \"A mobile phone comprising a charging port and a circuit...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68053", "text": "{\n    \"patent_title\": \"AI-Enhanced MRI Reconstruction for Improved Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"11,876,543\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2023-04-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel method for reconstructing magnetic resonance images (MRI) using deep learning techniques. The proposed approach significantly reduces scan time and improves image quality, leading to enhanced diagnostic accuracy, particularly in cancer detection. Artificial intelligence algorithms are used to fill in missing data and reduce noise.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"9,988,765\",\n            \"kind\": \"Cited by Examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for improving diagnostic accuracy using AI...\",\n        \"An MRI apparatus utilizing a deep learning reconstruction algorithm...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68053", "text": "{\n    \"patent_title\": \"Improved X-Ray Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. John Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"7,890,123\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2018-12-04\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new x-ray imaging system with improved radiation shielding and image processing capabilities. The system reduces patient exposure to harmful radiation and enhances the visibility of subtle anatomical features. The system does not utilize artificial intelligence.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"7,200,000\",\n            \"kind\": \"Cited by Examiner\"\n        }\n    ],\n    \"claims\": [\n        \"An x-ray imaging system comprising...\",\n        \"A radiation shielding apparatus...\",\n        \"A method for enhancing x-ray image clarity...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68054", "text": "{\n    \"patent_title\": \"High-Resolution Magnetic Resonance Imaging with Artificial Intelligence Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-11-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel magnetic resonance imaging (MRI) system utilizing artificial intelligence (AI) algorithms to enhance image resolution and improve diagnostic accuracy. The system employs deep learning models to reconstruct images from raw data, reducing noise and artifacts and increasing the visibility of subtle anatomical features.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"year\": \"2018\"\n        },\n        {\n            \"patent_number\": \"US10234567B2\",\n            \"year\": \"2019\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating high-resolution MRI images comprising...\",\n        \"An MRI system configured to utilize deep learning...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68054", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for X-Ray Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2014-12-01\",\n    \"filing_date\": \"2014-12-01\",\n    \"issue_date\": \"2017-09-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved contrast agent for X-ray imaging based on a novel iodine compound. This agent provides enhanced contrast and reduced toxicity compared to existing agents.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US5432109A\",\n            \"year\": \"1995\"\n        },\n        {\n            \"patent_number\": \"US6123456A\",\n            \"year\": \"1999\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising a novel iodine compound...\",\n        \"A method for enhancing X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68055", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Tissue Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Boston Scientific\"\n        }\n    ],\n    \"patent_number\": \"US11245678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-04-25\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"This invention relates to a surgical stapler designed for minimally invasive procedures. The stapler incorporates a novel tissue compression mechanism to reduce tissue damage and improve patient comfort during closure. It addresses a significant clinical need for enhanced surgical outcomes with reduced post-operative pain.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art relating to tissue compression\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"A tissue compression mechanism...\",\n        \"A method of using the stapler...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68055", "text": "{\n    \"patent_title\": \"Automated Drug Delivery System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Pharmaceutical Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"EP3987654A1\",\n    \"priority_date\": \"2022-01-10\",\n    \"filing_date\": \"2022-01-10\",\n    \"issue_date\": \"2023-09-18\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"An automated drug delivery system for precise and controlled medication administration. The system utilizes a microfluidic pump and feedback control to ensure accurate dosage. This addresses the clinical need for reliable and consistent drug delivery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related to microfluidic pumps\"\n        }\n    ],\n    \"claims\": [\n        \"A drug delivery system comprising...\",\n        \"A microfluidic pump...\",\n        \"A control system for dosage regulation...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68056", "text": "{\n    \"patent_title\": \"High-Capacity Lithium-Sulfur Battery with Novel Electrolyte Additive\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11876543B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-12-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-sulfur battery with a novel electrolyte additive that significantly enhances energy density and cycle life, overcoming the polysulfide shuttle effect. The additive facilitates stable lithium deposition and improves sulfur utilization, leading to a higher specific capacity and reduced capacity fade. Potential applications include electric vehicles and grid-scale energy storage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art on lithium-sulfur battery technology\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-sulfur battery comprising an electrolyte additive...\",\n        \"The battery of claim 1, wherein the electrolyte additive is...\",\n        \"A method for improving the energy density of a lithium-sulfur battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68056", "text": "{\n    \"patent_title\": \"Improved Lead-Acid Battery Design for Automotive Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Exide Technologies\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Exide Technologies\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-20\",\n    \"filing_date\": \"2021-05-20\",\n    \"issue_date\": \"2023-08-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lead-acid battery design with optimized plate geometry and electrolyte composition for improved charge acceptance and cold cranking performance in automotive applications. The design incorporates enhanced ventilation to reduce gassing and improve battery life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art on lead-acid battery designs\"\n        }\n    ],\n    \"claims\": [\n        \"A lead-acid battery comprising plates with a specific geometry...\",\n        \"The battery of claim 1, wherein the electrolyte composition includes...\",\n        \"A method for improving the cold cranking performance of a lead-acid battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68057", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical system for minimally invasive procedures, utilizing enhanced optical coherence tomography for real-time tissue visualization. The system allows for precise and targeted interventions with reduced patient trauma.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"field\": \"Cardiovascular\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"field\": \"Surgical Robotics\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising an optical coherence tomography module...\",\n        \"A method for performing a minimally invasive surgical procedure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68057", "text": "{\n    \"patent_title\": \"Enhanced Stent Design for Arterial Support\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Mayo Clinic\"\n        }\n    ],\n    \"patent_number\": \"US11890123B1\",\n    \"priority_date\": \"2022-05-10\",\n    \"filing_date\": \"2022-05-10\",\n    \"issue_date\": \"2024-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved stent design with enhanced biocompatibility and reduced risk of thrombosis. The stent provides robust support for arterial walls after angioplasty.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"field\": \"Cardiovascular\"\n        }\n    ],\n    \"claims\": [\n        \"A stent comprising a biocompatible alloy...\",\n        \"A method for deploying a stent within an artery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68058", "text": "{\n    \"patent_title\": \"Solid-State Electrolyte for High-Performance Sodium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-09-20\",\n    \"issue_date\": \"2023-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel solid-state electrolyte material for sodium-ion batteries, exhibiting enhanced ionic conductivity and improved energy density compared to existing technologies. The electrolyte is designed for use in next-generation energy storage systems, particularly for electric vehicle applications.  This design avoids the safety concerns of traditional lithium-ion batteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on sodium-ion battery electrolytes\"\n        }\n    ],\n    \"claims\": [\n        \"A solid-state electrolyte comprising...\",\n        \"A sodium-ion battery comprising the electrolyte...\",\n        \"A method for manufacturing the electrolyte...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68058", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Cathode Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Samsung Research America\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2021-05-05\",\n    \"issue_date\": \"2022-12-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a modified lithium nickel manganese cobalt oxide (NMC) cathode material for lithium-ion batteries. The modification improves the cycle life and rate capability of the battery. The invention is applicable to a wide range of battery-powered devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10111222B2\",\n            \"relevance\": \"Prior art on NMC cathode materials\"\n        }\n    ],\n    \"claims\": [\n        \"A cathode material comprising...\",\n        \"A lithium-ion battery comprising the cathode material...\",\n        \"A method for preparing the cathode material...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68059", "text": "{\n    \"patent_title\": \"Non-Invasive Glucose Monitoring System Utilizing Nanomaterial Enhanced Sensors\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive glucose monitoring system utilizing novel nanomaterials to enhance sensor sensitivity and accuracy, improving patient management of diabetes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on glucose sensing techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"A non-invasive glucose monitoring device comprising...\",\n        \"A sensor utilizing nanomaterials for enhanced sensitivity...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68059", "text": "{\n    \"patent_title\": \"Surgical Robotic System with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Chen\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emily Wilson\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-12-01\",\n    \"filing_date\": \"2020-06-15\",\n    \"issue_date\": \"2023-04-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical robotic system designed for enhanced precision and control during minimally invasive surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Previous robotic surgical systems.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic system comprising...\",\n        \"A control system for precise manipulation of surgical instruments...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68060", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Reconstruction for Accelerated MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel deep learning architecture for accelerating Magnetic Resonance Imaging (MRI) reconstruction. The method significantly reduces scan time while maintaining high image quality. The network utilizes convolutional neural networks (CNNs) to learn the mapping between undersampled k-space data and high-resolution images. This is particularly applicable to medical imaging for faster and more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"kind\": \"cited_by\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image...\",\n        \"A system comprising a deep learning model...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68060", "text": "{\n    \"patent_title\": \"Color Image Processing for Digital Cameras\",\n    \"inventors\": [\n        {\n            \"name\": \"Kenji Tanaka\",\n            \"affiliation\": \"Fujifilm Corporation\"\n        }\n    ],\n    \"patent_number\": \"JP2022123456A\",\n    \"priority_date\": \"2021-11-01\",\n    \"filing_date\": \"2021-11-01\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"JPO\",\n    \"abstract\": \"This invention relates to a method for enhancing color reproduction in digital camera images. It involves a novel algorithm for white balance adjustment and color correction. The algorithm aims to produce more natural and vibrant colors in captured photographs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"kind\": \"cited_by\"\n        }\n    ],\n    \"claims\": [\n        \"A method for adjusting white balance in a digital image...\",\n        \"A digital camera comprising a color correction module...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68061", "text": "{\n    \"patent_title\": \"Lithium-Air Battery with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Princeton University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Argonne National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2023-12-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-air battery with a novel electrolyte formulation exhibiting enhanced stability and improved energy density. The electrolyte incorporates a redox mediator to facilitate efficient oxygen reduction and evolution reactions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in lithium-air battery technology\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-air battery comprising...\",\n        \"An electrolyte formulation...\",\n        \"A method for enhancing the stability of a lithium-air battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68061", "text": "{\n    \"patent_title\": \"Sodium-Ion Battery with Improved Cycling Performance\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. James Chen\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Sarah Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-01-20\",\n    \"filing_date\": \"2020-01-20\",\n    \"issue_date\": \"2023-07-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A sodium-ion battery with a novel cathode material exhibiting improved cycling performance and rate capability. The cathode material is a layered oxide with a unique crystal structure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art in sodium-ion battery technology\"\n        }\n    ],\n    \"claims\": [\n        \"A sodium-ion battery comprising...\",\n        \"A cathode material...\",\n        \"A method for improving the cycling performance of a sodium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68062", "text": "{\n    \"patent_title\": \"Enhanced Resolution Medical Imaging System Utilizing Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-10-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel medical imaging system employing deep learning algorithms to significantly enhance image resolution and contrast, enabling earlier and more accurate disease detection. The system improves visualization of subtle anatomical structures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A medical imaging system comprising a deep learning module for image enhancement.\",\n        \"The system of claim 1, wherein the deep learning module is trained on a dataset of medical images.\",\n        \"The system of claim 2, wherein the medical images are from various modalities.\",\n        \"A method for enhancing medical images using deep learning.\",\n        \"The method of claim 4, further comprising analyzing the enhanced image for disease indicators.\",\n        \"The system of claim 1, utilizing a convolutional neural network.\",\n        \"The method of claim 4, wherein the disease indicators relate to cancerous tissue.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68062", "text": "{\n    \"patent_title\": \"Cardiovascular Imaging Device with Improved Signal Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Philips Healthcare\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-05-20\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2020-08-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A cardiovascular imaging device featuring enhanced signal processing techniques to improve the clarity of images of the heart and blood vessels. The device utilizes advanced filtering algorithms to reduce noise and improve visualization of coronary arteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiovascular imaging device comprising a signal processing module.\",\n        \"The device of claim 1, wherein the signal processing module utilizes a Kalman filter.\",\n        \"The device of claim 2, wherein the Kalman filter is adaptive.\",\n        \"A method for processing signals from a cardiovascular imaging device.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68063", "text": "{\n    \"patent_title\": \"AI-Enhanced MRI Reconstruction for Improved Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-06-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel method for reconstructing MRI images using artificial intelligence techniques. The system leverages deep learning to enhance image resolution and reduce noise, leading to significantly improved detection of cancerous tissues. The approach enhances diagnostic accuracy by minimizing false positives and negatives.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"MRI Image Reconstruction using Wavelet Transforms\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images using a deep learning model.\",\n        \"A system for improving diagnostic accuracy in MRI scans.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68063", "text": "{\n    \"patent_title\": \"Positron Emission Tomography with Novel Radiotracer for Heart Disease\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-11-10\",\n    \"filing_date\": \"2017-11-10\",\n    \"issue_date\": \"2021-04-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a new radiotracer for use in Positron Emission Tomography (PET) scans to detect and quantify myocardial perfusion. The radiotracer provides enhanced image contrast and improved diagnostic capabilities for patients with suspected heart disease.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Methods for PET Image Reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A radiotracer composition for PET imaging.\",\n        \"A method for detecting heart disease using PET and the disclosed radiotracer.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68064", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Point-of-Care Diagnosis of Sepsis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2018-06-20\",\n    \"issue_date\": \"2021-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for rapid and accurate detection of biomarkers associated with sepsis, enabling faster diagnosis and treatment initiation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for detecting sepsis biomarkers...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68064", "text": "{\n    \"patent_title\": \"Improved Dental Implant with Enhanced Osseointegration\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Los Angeles\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2017-12-01\",\n    \"filing_date\": \"2019-03-10\",\n    \"issue_date\": \"2020-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel dental implant design featuring a modified surface to promote faster osseointegration and improved long-term stability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A dental implant comprising...\",\n        \"A method for implanting a dental implant...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68065", "text": "{\n    \"patent_title\": \"Enhanced Magnetic Resonance Imaging Technique for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel magnetic resonance imaging (MRI) technique utilizing advanced pulse sequences and image reconstruction algorithms to enhance contrast and resolution, leading to improved detection of early-stage cancerous tumors. The system provides clearer images and therefore helps in more accurate diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on MRI pulse sequences\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI comprising...\",\n        \"An MRI system configured to...\",\n        \"A computer-readable medium storing instructions for...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68065", "text": "{\n    \"patent_title\": \"Method for Optimizing Contrast in X-ray Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Johnson & Johnson\"\n        },\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"Johnson & Johnson\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a method for adjusting the contrast of X-ray images to improve visualization of bone structures. The method involves digital image processing techniques to enhance the visibility of fractures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related X-ray imaging techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing X-ray images comprising...\",\n        \"A system for enhancing X-ray contrast...\",\n        \"A computer program for X-ray image adjustment...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68066", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Electrolyte for Improved Performance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery featuring a novel electrolyte composition exhibiting enhanced ionic conductivity and thermal stability, leading to improved energy density and cycle life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"citation_count\": 3\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"citation_count\": 2\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition...\",\n        \"A method for improving battery performance...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68066", "text": "{\n    \"patent_title\": \"Improved Lead-Acid Battery for Automotive Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Exide Technologies\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Ford Motor Company\"\n        }\n    ],\n    \"patent_number\": \"US7654321B1\",\n    \"priority_date\": \"2014-11-01\",\n    \"filing_date\": \"2014-11-01\",\n    \"issue_date\": \"2017-09-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved lead-acid battery design incorporating a modified electrode structure to enhance charge acceptance and lifespan in automotive starting-lighting-ignition (SLI) applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"citation_count\": 1\n        }\n    ],\n    \"claims\": [\n        \"A lead-acid battery comprising...\",\n        \"An electrode structure...\",\n        \"A method for enhancing charge acceptance...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68067", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging Technique for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A novel MRI technique utilizing enhanced contrast agents and advanced image processing algorithms for significantly improved early-stage cancer detection.  This allows for more accurate diagnosis and treatment planning.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on contrast agents.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating MRI images with enhanced contrast.\",\n        \"A system for diagnosing cancer using the generated MRI images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68067", "text": "{\n    \"patent_title\": \"Method for Enhancing X-Ray Image Quality\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Oxford\"\n        }\n    ],\n    \"patent_number\": \"EP11223344B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2023-11-15\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"An improved X-ray imaging system that reduces radiation exposure while maintaining high image clarity. The system uses a new filtering technique to minimize noise.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10112233B2\",\n            \"relevance\": \"Related to X-ray filtering techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system with reduced radiation output.\",\n        \"A method for filtering X-ray images.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68068", "text": "{\n    \"patent_title\": \"Miniaturized Biosensor for Real-Time Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel miniaturized biosensor for continuous and real-time glucose monitoring. The device utilizes a minimally invasive subcutaneous insertion method and demonstrates significantly improved accuracy and response time compared to existing glucose monitoring systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art related to glucose monitoring\"\n        }\n    ],\n    \"claims\": [\n        \"A biosensor comprising a miniaturized sensing element for detecting glucose levels.\",\n        \"A method for minimally invasive glucose monitoring using the aforementioned biosensor.\",\n        \"A system for real-time glucose data transmission and analysis.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68068", "text": "{\n    \"patent_title\": \"Improved Surgical Instrument for Open Heart Surgery\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"General Hospital Research Center\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a surgical instrument designed for improved precision during open heart surgery. The instrument enhances visibility and maneuverability within the surgical field.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art related to surgical instruments\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising a handle and a distal end with improved articulation.\",\n        \"A method for performing open heart surgery using the aforementioned instrument.\",\n        \"A system for enhancing surgical precision.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68069", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-06-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"This invention discloses a novel method for reconstructing high-resolution images from low-resolution data using a deep learning approach. The method improves image quality by reducing noise and enhancing details, with potential applications in medical imaging and satellite imagery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11111111B1\",\n            \"title\": \"Image Denoising Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an image comprising...\",\n        \"The method of claim 1, wherein the deep learning model is a convolutional neural network.\",\n        \"The method of claim 1, wherein the image is a medical image.\",\n        \"The method of claim 1, wherein the image is a satellite image.\",\n        \"A system for implementing the method of claim 1.\",\n        \"The system of claim 5, further comprising a display.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68069", "text": "{\n    \"patent_title\": \"Image Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"Siemens AG\"\n        }\n    ],\n    \"patent_number\": \"EP3210987B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-08-25\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"This invention provides an efficient image compression algorithm based on wavelet transform. It aims to reduce storage space and transmission bandwidth for digital images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Wavelet-Based Image Coding\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image comprising...\",\n        \"The method of claim 1, wherein the wavelet transform is a Daubechies wavelet.\",\n        \"The method of claim 1, wherein the compressed image is stored in a JPEG 2000 format.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68070", "text": "{\n    \"patent_title\": \"High-Performance Lithium-Ion Battery with Novel Electrolyte Composition\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-06-20\",\n    \"issue_date\": \"2021-11-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel electrolyte composition for lithium-ion batteries, significantly enhancing energy density and cycle life. The electrolyte incorporates a unique additive that mitigates dendrite formation and improves ion conductivity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on electrolyte additives\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrolyte composition...\",\n        \"The electrolyte composition according to claim 1, further comprising...\",\n        \"A method for fabricating a lithium-ion battery...\",\n        \"The method according to claim 3, wherein...\",\n        \"A system for energy storage utilizing the lithium-ion battery...\",\n        \"The system according to claim 5, wherein...\",\n        \"The system according to claim 6, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68070", "text": "{\n    \"patent_title\": \"Improved Method for Manufacturing Nickel-Metal Hydride Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2022-07-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an efficient and cost-effective method for manufacturing nickel-metal hydride batteries, reducing production time and material waste.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art on nickel-metal hydride battery fabrication\"\n        }\n    ],\n    \"claims\": [\n        \"A method for manufacturing a nickel-metal hydride battery...\",\n        \"The method according to claim 1, further comprising...\",\n        \"An apparatus for carrying out the method...\",\n        \"The apparatus according to claim 3, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68071", "text": "{\n    \"patent_title\": \"Deep Learning Based Image Enhancement for Low-Light Conditions\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Independent Researcher\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for enhancing images captured in low-light conditions. The system utilizes a generative adversarial network to reconstruct high-quality images with improved visibility and reduced noise.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"Prior art in image denoising\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image captured in low-light conditions comprising...\",\n        \"A deep learning model configured to reconstruct a high-quality image from a low-light image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68071", "text": "{\n    \"patent_title\": \"Method for Data Compression Using Huffman Coding\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"TechCorp Inc.\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A data compression method using Huffman coding to reduce file sizes. The method assigns variable-length codes to input characters based on their frequency of occurrence.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"relevance\": \"Prior art in data compression techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data comprising...\",\n        \"A system for encoding data using Huffman coding...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68072", "text": "{\n    \"patent_title\": \"High-Capacity Lithium-Ion Battery with Enhanced Cycle Life for Grid-Scale Energy Storage\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-06-20\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery with a novel electrolyte composition and electrode structure, resulting in significantly improved capacity retention and cycle life. The battery is designed for large-scale energy storage applications, such as grid stabilization and renewable energy integration.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in electrolyte additives\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition comprising...\",\n        \"A method for manufacturing...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68072", "text": "{\n    \"patent_title\": \"Advanced Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-05-01\",\n    \"filing_date\": \"2020-08-15\",\n    \"issue_date\": \"2023-03-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A sophisticated battery management system (BMS) for electric vehicles, optimizing battery performance, safety, and lifespan. The BMS includes advanced algorithms for state-of-charge estimation, thermal management, and fault detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related to battery cell balancing techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68073", "text": "{\n    \"patent_title\": \"AI-Powered System for Early Sepsis Detection Using Electronic Health Records\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel AI system utilizing electronic health records to predict the onset of sepsis hours before clinical manifestation. The system employs machine learning algorithms trained on a large dataset of patient data to identify subtle patterns indicative of early sepsis.  It provides a risk score enabling proactive intervention and improved patient outcomes. The system incorporates explainable AI techniques for clinical trust and transparency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on machine learning in healthcare\"\n        }\n    ],\n    \"claims\": [\n        \"A method for predicting sepsis using electronic health records.\",\n        \"A system for providing a sepsis risk score.\",\n        \"A computer-implemented method for analyzing patient data to identify early indicators of sepsis.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68073", "text": "{\n    \"patent_title\": \"Automated Lung Nodule Detection in CT Scans Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2022-01-15\",\n    \"filing_date\": \"2022-01-15\",\n    \"issue_date\": \"2024-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a deep learning algorithm for automated detection of lung nodules in computed tomography (CT) scans.  The algorithm utilizes convolutional neural networks to identify and classify suspicious nodules, aiding radiologists in early diagnosis of lung cancer. This improves efficiency and accuracy in image analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Prior art on image processing techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A system for detecting lung nodules in CT scans.\",\n        \"A method for classifying lung nodules using deep learning.\",\n        \"A computer-implemented method for analyzing CT scan images.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68074", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-11-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable biosensor for continuous glucose monitoring, utilizing a novel enzymatic reaction and microfabrication techniques to achieve high accuracy and long-term stability. This device aims to improve the management of diabetes and enhance patient quality of life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art on glucose sensing\"\n        }\n    ],\n    \"claims\": [\n        \"A biosensor comprising a microfabricated enzymatic reaction chamber.\",\n        \"A method for continuous glucose monitoring using said biosensor.\",\n        \"A system for transmitting glucose data to a mobile device.\",\n        \"A biocompatible coating for the biosensor.\",\n        \"A method for calibrating the biosensor.\",\n        \"A method for alerting patients to abnormal glucose levels.\",\n        \"A device for delivering insulin based on glucose readings.\",\n        \"A packaging method for sterile biosensor deployment.\",\n        \"A power management system for long-term operation.\",\n        \"A microfluidic system for analyte delivery.\",\n        \"A sensor for detecting other metabolites.\",\n        \"A system for data analysis and reporting.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68074", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Peripheral Vascular Access\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Wilson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2021-06-01\",\n    \"filing_date\": \"2021-06-01\",\n    \"issue_date\": \"2023-09-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design with enhanced flexibility and reduced risk of vessel damage during peripheral vascular access procedures.  It incorporates a novel tip geometry and a lubricious coating.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US4232598\",\n            \"relevance\": \"Early catheter designs\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related prior art on catheter materials\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible shaft.\",\n        \"A catheter tip with a rounded geometry.\",\n        \"A lubricious coating applied to the catheter.\",\n        \"A method for inserting a catheter into a blood vessel.\",\n        \"A method for minimizing vessel damage during catheter insertion.\",\n        \"A catheter with a specific diameter range.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68075", "text": "{\n    \"patent_title\": \"Novel MRI Contrast Agent for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel MRI contrast agent enhancing early cancer detection through targeted molecular imaging. The agent specifically binds to tumor biomarkers, providing high sensitivity and specificity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\",\n            \"relevance\": \"Prior art on MRI contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancer using the novel MRI contrast agent.\",\n        \"The MRI contrast agent comprising a targeting moiety and a paramagnetic metal complex.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68075", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Cardiovascular Angiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of Michigan\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of Michigan\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2022-05-10\",\n    \"filing_date\": \"2022-05-10\",\n    \"issue_date\": \"2024-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design for more efficient and safer cardiovascular angiography procedures. The catheter features a novel tip configuration for enhanced maneuverability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"relevance\": \"Existing catheter designs\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible shaft and a novel tip configuration.\",\n        \"A method for performing angiography using the improved catheter.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68076", "text": "{\n    \"patent_title\": \"AI-Powered Diagnostic System for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel system utilizing deep learning algorithms to analyze medical imaging data for the early detection of cancerous tumors. The system demonstrates superior accuracy compared to traditional diagnostic methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for diagnosing cancer comprising...\",\n        \"A system for analyzing medical images...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The method of claim 1, wherein the cancer is lung cancer.\",\n        \"The system of claim 2, wherein the medical images are CT scans.\",\n        \"The system of claim 2, wherein the medical images are MRI scans.\",\n        \"The method of claim 1, further comprising displaying a risk score.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68076", "text": "{\n    \"patent_title\": \"Improved Algorithm for General Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2024-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new optimization algorithm for training machine learning models, providing faster convergence and improved accuracy for various tasks.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for optimizing a machine learning model comprising...\",\n        \"A computer system for performing machine learning...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68077", "text": "{\n    \"patent_title\": \"MRI Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-10-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for magnetic resonance image reconstruction using deep convolutional neural networks. This approach significantly reduces scan time and improves image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images using a deep neural network.\",\n        \"A system for performing MRI with accelerated scan times.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68077", "text": "{\n    \"patent_title\": \"Improved X-Ray Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US11223344B2\",\n    \"priority_date\": \"2017-05-01\",\n    \"filing_date\": \"2017-05-01\",\n    \"issue_date\": \"2019-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved X-ray imaging system with enhanced resolution and reduced radiation dose. The system utilizes a novel detector array and image processing algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system with improved resolution.\",\n        \"A method for reducing radiation dose in X-ray imaging.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68078", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Enhanced Biocompatibility\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor with a novel biocompatible coating for long-term monitoring of glucose levels in diabetic patients. The sensor utilizes a microfluidic design for enhanced accuracy and reduced biofouling, addressing the need for continuous glucose monitoring without frequent replacements.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on glucose sensing technology\"\n        }\n    ],\n    \"claims\": [\n        \"A glucose sensor comprising a biocompatible coating...\",\n        \"A method for continuous glucose monitoring using the sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68078", "text": "{\n    \"patent_title\": \"AI-Powered Diagnostic Tool for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alex Chen\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A software-based diagnostic tool leveraging artificial intelligence algorithms to analyze medical images and identify potential cancerous tumors at an early stage. The system provides radiologists with a second opinion, improving diagnostic accuracy and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"relevance\": \"Related to image processing algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"A computer-implemented method for cancer detection...\",\n        \"A system for analyzing medical images using machine learning...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68079", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Cardiac Monitor with Wireless Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Mark Johnson\",\n            \"affiliation\": \"Medtronic Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-05-15\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable cardiac monitor providing real-time data transmission for improved arrhythmia detection and management. Addresses the unmet need for long-term, continuous cardiac monitoring with minimal patient burden.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on implantable cardiac devices\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable cardiac monitor comprising...\",\n        \"A wireless data transmission system for transmitting cardiac data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68079", "text": "{\n    \"patent_title\": \"Improved Surgical Stapler Design\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Acme Surgical Corp.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-12-01\",\n    \"filing_date\": \"2019-12-01\",\n    \"issue_date\": \"2021-04-13\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler design with enhanced ergonomics and faster staple deployment. Offers minor improvements to existing stapler technology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related to staple cartridge mechanisms\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"A staple cartridge configured for rapid deployment...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68080", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction for MRI using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method for reconstructing medical images from MRI data using a deep learning network. The network is trained to reduce noise and artifacts, resulting in higher quality images with improved diagnostic accuracy. The method allows for faster scan times and reduced radiation exposure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"MRI Image Enhancement\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Deep Learning for Image Analysis\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing medical images comprising...\",\n        \"A computer-readable medium storing instructions for...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68080", "text": "{\n    \"patent_title\": \"Portable X-Ray Device with Wireless Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US91234567B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2017-09-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A portable X-ray device designed for field use. The device incorporates wireless transmission capabilities for immediate image viewing. This innovation enables rapid diagnostics in remote locations and emergency situations. Its modular design simplifies maintenance and repair.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Wireless Medical Imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A portable X-ray device comprising...\",\n        \"A wireless communication module...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68081", "text": "{\n    \"patent_title\": \"Method and System for Dynamic Voltage and Frequency Scaling in Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"TechCorp Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10456789B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-02-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for dynamic voltage and frequency scaling (DVFS) in mobile devices to improve battery life. The system utilizes machine learning to predict workload demands and optimize power consumption through intelligent power management techniques, enhancing energy efficiency for lithium-ion batteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Power Saving Mode Implementation\"\n        }\n    ],\n    \"claims\": [\n        \"A method for dynamically adjusting voltage and frequency...\",\n        \"A system comprising a processor and a memory...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68081", "text": "{\n    \"patent_title\": \"Solid-State Electrolyte for Next Generation Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Energy Solutions Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2020-01-20\",\n    \"filing_date\": \"2020-01-20\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel solid-state electrolyte material for use in next-generation batteries, offering improved safety and energy density. This invention significantly advances battery technology beyond conventional lithium-ion configurations.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Solid Electrolyte Composition\"\n        }\n    ],\n    \"claims\": [\n        \"A solid-state electrolyte comprising...\",\n        \"A battery cell including the solid-state electrolyte...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68082", "text": "{\n    \"patent_title\": \"Enhanced MRI Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2023-12-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel deep learning approach for reconstructing high-resolution MRI images from undersampled k-space data, resulting in improved image clarity and reduced scan time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68082", "text": "{\n    \"patent_title\": \"Secure Medical Image Archiving System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"EP3456789A1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-01-15\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"An image archiving system that uses blockchain technology to ensure secure and tamper-proof storage of medical imaging data. The system provides efficient access control and data integrity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for securely storing medical images comprising...\",\n        \"A method for accessing medical images using blockchain...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68083", "text": "{\n    \"patent_title\": \"Enhanced Contrast Agent for Magnetic Resonance Angiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-08-20\",\n    \"issue_date\": \"2021-11-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel contrast agent for magnetic resonance angiography (MRA) exhibiting improved signal-to-noise ratio and enhanced vessel visualization. The agent comprises nanoparticles coated with a targeting ligand for specific adhesion to vascular endothelium, resulting in clearer images and improved diagnostic capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on nanoparticle contrast agents.\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising nanoparticles coated with a targeting ligand.\",\n        \"A method for visualizing blood vessels using the contrast agent.\",\n        \"An MRA imaging system optimized for use with the contrast agent.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68083", "text": "{\n    \"patent_title\": \"Low-Dose Computed Tomography Protocol with Iterative Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2020-03-10\",\n    \"filing_date\": \"2020-06-12\",\n    \"issue_date\": \"2022-04-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A computed tomography (CT) imaging protocol designed to minimize radiation exposure while maintaining diagnostic image quality. The protocol employs iterative reconstruction algorithms to reduce noise and artifacts, enabling the use of lower radiation doses without compromising image clarity. This reduces patient risk.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on iterative reconstruction techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"A CT imaging protocol utilizing iterative reconstruction.\",\n        \"A method for reducing radiation dose in CT imaging.\",\n        \"A CT scanner configured to implement the low-dose protocol.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68084", "text": "{\n    \"patent_title\": \"Deep Learning-Enhanced MRI Reconstruction for Improved Diagnostic Accuracy\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"EP3876543B1\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2021-01-20\",\n    \"issue_date\": \"2022-09-14\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"This invention discloses a method for reconstructing Magnetic Resonance Images (MRI) using deep learning techniques. By training a convolutional neural network on a large dataset of MRI scans, the method significantly improves image quality, reducing noise and artifacts, leading to more accurate diagnoses. The system incorporates an artificial intelligence module for automated image analysis and anomaly detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"MRI Image Reconstruction Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images using a deep learning model.\",\n        \"A system for automated MRI image analysis.\",\n        \"The use of artificial intelligence for anomaly detection in MRI scans.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68084", "text": "{\n    \"patent_title\": \"Improved X-Ray Image Filtering Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-05-22\",\n    \"filing_date\": \"2021-02-10\",\n    \"issue_date\": \"2023-01-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents an improved filtering technique for X-ray images. The method enhances contrast and reduces noise, resulting in clearer images for diagnostic purposes. It uses a traditional image processing algorithm based on wavelet transforms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"X-Ray Image Enhancement System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for filtering X-ray images using wavelet transforms.\",\n        \"An X-ray imaging system with improved contrast.\",\n        \"A method for reducing noise in X-ray images.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68085", "text": "{\n    \"patent_title\": \"Method and System for Enhancing Medical Images Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10245789B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A method and system for enhancing the quality of medical images, such as X-rays, CT scans, and MRIs, using deep learning algorithms. The system improves image clarity and contrast to aid in diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing a medical image comprising...\",\n        \"A system for processing medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68085", "text": "{\n    \"patent_title\": \"Image Processing for Satellite Imagery\",\n    \"inventors\": [\n        {\n            \"name\": \"Hans Schmidt\",\n            \"affiliation\": \"Technical University of Munich\"\n        }\n    ],\n    \"patent_number\": \"EP3847291A1\",\n    \"priority_date\": \"2018-09-20\",\n    \"filing_date\": \"2018-09-20\",\n    \"issue_date\": \"2020-01-15\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"A method for processing satellite imagery to enhance visual clarity and identify features of interest. Includes techniques for noise reduction and color correction.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing satellite images comprising...\",\n        \"A system for analyzing satellite data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68086", "text": "{\n    \"patent_title\": \"Surgical Stapler with Enhanced Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Boston Medical Devices Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a surgical stapler designed for minimally invasive procedures. The stapler features an ergonomic handle and improved firing mechanism to enhance precision and reduce surgeon fatigue, ultimately leading to better patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related prior art in surgical stapling\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an ergonomic handle...\",\n        \"A stapler with a firing mechanism providing increased precision...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68086", "text": "{\n    \"patent_title\": \"Advanced Cardiac Pacemaker System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Medtronic Inc.\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an advanced cardiac pacemaker system with improved battery life and diagnostic capabilities. The system is designed for long-term implantation and monitoring of heart rhythm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related prior art in cardiac pacing\"\n        },\n        {\n            \"patent_number\": \"US8901234B1\",\n            \"relevance\": \"Diagnostic methods in cardiology\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Battery technology for implantable devices\"\n        },\n        {\n            \"patent_number\": \"US10234567B1\",\n            \"relevance\": \"Remote monitoring systems\"\n        },\n        {\n            \"patent_number\": \"US11345678B1\",\n            \"relevance\": \"Signal processing algorithms\"\n        },\n        {\n            \"patent_number\": \"US12456789B1\",\n            \"relevance\": \"Biocompatible materials\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiac pacemaker system comprising a long-life battery...\",\n        \"A system with advanced diagnostic features...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68087", "text": "{\n    \"patent_title\": \"Enhanced Magnetic Resonance Imaging for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-11-20\",\n    \"issue_date\": \"2022-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel magnetic resonance imaging (MRI) technique utilizing advanced pulse sequences and image reconstruction algorithms to significantly enhance image resolution and improve the accuracy of early cancer detection. The method allows for more precise tumor identification, leading to better treatment outcomes and potentially personalized medicine approaches.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in MRI pulse sequences.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI image resolution comprising...\",\n        \"An MRI system configured to implement the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68087", "text": "{\n    \"patent_title\": \"Improved X-ray Image Processing for Bone Fracture Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Michael Brown\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-02-10\",\n    \"filing_date\": \"2018-08-15\",\n    \"issue_date\": \"2021-01-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new method for processing X-ray images to improve the detection of bone fractures. The system utilizes a combination of filtering techniques and edge enhancement algorithms to provide clearer images for diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous work in X-ray image processing.\"\n        }\n    ],\n    \"claims\": [\n        \"A system for processing X-ray images comprising...\",\n        \"A method for enhancing bone fracture visibility in X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68088", "text": "{\n    \"patent_title\": \"Deep Convolutional Neural Networks for Enhanced Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep convolutional neural network architecture for significantly improving image reconstruction quality from undersampled data. The network learns a complex non-linear mapping from undersampled data to high-quality images, achieving state-of-the-art results.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760821B2\",\n            \"title\": \"Image Reconstruction Using Sparse Representations\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an image from undersampled data comprising: applying a deep convolutional neural network to the undersampled data to generate a reconstructed image.\",\n        \"The method of claim 1, wherein the deep convolutional neural network comprises multiple convolutional layers and pooling layers.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68088", "text": "{\n    \"patent_title\": \"Automated Detection of Tumors in Mammograms Using Image Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University Medical Center\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-08-01\",\n    \"filing_date\": \"2016-08-01\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for automatically detecting tumors in mammogram images using image processing algorithms and machine learning techniques. This system aims to improve the accuracy and efficiency of breast cancer screening.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Image Processing Techniques for Medical Imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A system for detecting tumors in mammogram images comprising: an image acquisition module, an image processing module, and a machine learning module.\",\n        \"The system of claim 1, wherein the image processing module comprises a filtering algorithm for noise reduction.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68089", "text": "{\n    \"patent_title\": \"Non-Invasive Glucose Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel non-invasive glucose monitoring system utilizing advanced spectroscopic techniques. This groundbreaking technology provides continuous glucose readings without the need for skin puncture, offering a significant improvement over existing methods and revolutionizing diabetes management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321\",\n            \"relevance\": \"Prior art on glucose sensing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for non-invasively monitoring glucose levels...\",\n        \"A device comprising a spectroscopic sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68089", "text": "{\n    \"patent_title\": \"Improved Scalpel Design for Minimally Invasive Surgery\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-05\",\n    \"issue_date\": \"2023-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents an improved scalpel design incorporating ergonomic features and enhanced blade sharpness. The design allows for greater precision during minimally invasive surgical procedures, leading to reduced patient trauma and faster recovery times. The innovation provides incremental improvements in existing surgical techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210\",\n            \"relevance\": \"Prior art on scalpel designs\"\n        }\n    ],\n    \"claims\": [\n        \"A scalpel comprising an ergonomic handle...\",\n        \"A blade with a specific angle for optimal cutting...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68090", "text": "{\n    \"patent_title\": \"Deep Learning Framework for Real-Time Object Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-09-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning framework for fast and accurate object detection in images and video streams. The framework utilizes a new attention mechanism to improve performance on complex scenes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for object detection comprising...\",\n        \"A system for real-time image analysis...\",\n        \"A deep learning model with an attention mechanism...\",\n        \"The method of claim 1, wherein the object is a vehicle.\",\n        \"The system of claim 2, wherein the image is from a surveillance camera.\",\n        \"The model of claim 3, wherein the attention mechanism is self-attention.\",\n        \"The method of claim 1, wherein the object detection is performed on a mobile device.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68090", "text": "{\n    \"patent_title\": \"AI-Powered Diagnostic System for Retinal Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2022-05-10\",\n    \"filing_date\": \"2022-11-15\",\n    \"issue_date\": \"2024-02-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A diagnostic system leveraging deep learning to analyze retinal images for early detection of diabetic retinopathy. The system uses convolutional neural networks to identify key indicators of the disease.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10345678B1\"\n        },\n        {\n            \"patent_number\": \"US11012345B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for diagnosing diabetic retinopathy comprising...\",\n        \"A system for analyzing retinal images...\",\n        \"A deep learning model trained on retinal image data...\",\n        \"The method of claim 1, wherein the retinal image is obtained using optical coherence tomography.\",\n        \"The system of claim 2, wherein the system provides a risk score to the physician.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68091", "text": "{\n    \"patent_title\": \"High-Resolution Photoacoustic Tomography System for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-06-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel photoacoustic tomography system is disclosed, offering significantly improved resolution and depth penetration for early cancer detection. The system utilizes pulsed laser excitation and advanced signal processing techniques, providing a significant improvement over existing imaging modalities. This allows for non-invasive visualization of microvasculature and tumor angiogenesis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9232987B2\",\n            \"relevance\": \"Related prior art in photoacoustic imaging.\"\n        }\n    ],\n    \"claims\": [\n        \"A photoacoustic tomography system comprising...\",\n        \"A method for detecting cancer using the system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68091", "text": "{\n    \"patent_title\": \"Improved MRI Technique with Gadolinium Contrast Agents\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Michael Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Sarah Green\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2021-03-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details an improved magnetic resonance imaging (MRI) technique utilizing a novel gadolinium-based contrast agent for enhanced image clarity. The technique allows for better visualization of blood vessels and tissue abnormalities. This agent provides a significant improvement in image contrast.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art in MRI contrast agents.\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI technique using a gadolinium contrast agent...\",\n        \"A method for enhancing image clarity using the technique...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68092", "text": "{\n    \"patent_title\": \"Deep Learning for Enhanced Medical Image Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-09-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a deep learning framework for improved analysis of medical images, including CT scans and MRIs. The system uses convolutional neural networks to detect subtle anomalies indicative of disease, providing clinicians with more accurate diagnostic information. It significantly reduces false positives and improves early detection rates.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image segmentation\"\n        }\n    ],\n    \"claims\": [\n        \"A method for analyzing medical images using deep learning.\",\n        \"A system for detecting anomalies in medical images.\",\n        \"A computer-readable medium storing instructions for performing the method.\",\n        \"The method of claim 1, wherein the deep learning model is a convolutional neural network.\",\n        \"The system of claim 2, comprising a user interface for displaying the analyzed images.\",\n        \"The method of claim 1, further comprising generating a report summarizing the findings.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68092", "text": "{\n    \"patent_title\": \"Image Compression Technique for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Apple Inc.\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Samsung Electronics\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2022-05-22\",\n    \"filing_date\": \"2022-11-15\",\n    \"issue_date\": \"2024-02-29\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel image compression technique optimized for mobile devices. The algorithm utilizes wavelet transforms and entropy coding to achieve high compression ratios while maintaining acceptable image quality. It also incorporates security features to protect sensitive image data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"Related to wavelet-based compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image.\",\n        \"A mobile device implementing the compression method.\",\n        \"A computer-readable medium storing instructions for performing the compression method.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68093", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2021-12-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized, implantable biosensor for continuous glucose monitoring, utilizing advanced nanotechnology to enhance accuracy and biocompatibility. This device aims to improve the management of diabetes and enhance patient quality of life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Implantable Glucose Sensor\"\n        }\n    ],\n    \"claims\": [\n        \"A biosensor comprising a nanoscale sensing element.\",\n        \"A method for continuous glucose monitoring using said biosensor.\",\n        \"A system for data transmission and analysis.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68093", "text": "{\n    \"patent_title\": \"Complex System for Automated Drug Delivery with Feedback Control\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"State University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-10\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-09-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A highly complex automated drug delivery system incorporating multiple feedback loops, AI-powered control algorithms, and a distributed sensor network. Designed for treating chronic conditions with precise drug dosage control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Automated Drug Infusion Pump\"\n        }\n    ],\n    \"claims\": [\n        \"A drug delivery system comprising a plurality of sensors.\",\n        \"A control algorithm for optimizing drug dosage.\",\n        \"A communication module for remote monitoring.\",\n        \"A feedback loop for adjusting drug delivery based on patient response.\",\n        \"A safety mechanism to prevent overdosing.\",\n        \"A data storage module for recording drug delivery history.\",\n        \"A user interface for displaying system status.\",\n        \"A power management unit for ensuring reliable operation.\",\n        \"A calibration routine for maintaining sensor accuracy.\",\n        \"A diagnostic module for detecting system errors.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68094", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Electrolyte for Improved Cycle Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11254321B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-12-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery incorporating a novel electrolyte composition to improve cycle life and reduce degradation. The electrolyte is designed for enhanced ion conductivity and stability at high voltages.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"1. A lithium-ion battery comprising...\",\n        \"2. The lithium-ion battery of claim 1, wherein...\",\n        \"3. The lithium-ion battery of claim 2, further comprising...\",\n        \"4. An electrolyte composition for use in a lithium-ion battery...\",\n        \"5. The electrolyte composition of claim 4, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68094", "text": "{\n    \"patent_title\": \"Solid-State Battery with Novel Electrode Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2020-07-01\",\n    \"filing_date\": \"2020-07-01\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A solid-state battery utilizing a new electrode material with high energy density. This design eliminates the need for liquid electrolytes, enhancing safety and performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"1. A solid-state battery comprising...\",\n        \"2. The solid-state battery of claim 1, wherein...\",\n        \"3. The solid-state battery of claim 2, further comprising...\",\n        \"4. An electrode material for use in a solid-state battery...\",\n        \"5. The electrode material of claim 4, wherein...\",\n        \"6. A method for manufacturing a solid-state battery...\",\n        \"7. The method of claim 6, wherein...\",\n        \"8. A device incorporating the solid-state battery...\",\n        \"9. The device of claim 8, wherein...\",\n        \"10. The device of claim 9, further comprising...\",\n        \"11. The device of claim 10, wherein...\",\n        \"12. The device of claim 11, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68095", "text": "{\n    \"patent_title\": \"Ultrasound Image Enhancement Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-06-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing ultrasound images using deep learning algorithms to improve the visualization of anatomical structures and pathology, thereby enhancing diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an ultrasound image comprising...\",\n        \"A system for displaying an enhanced ultrasound image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68095", "text": "{\n    \"patent_title\": \"Contrast-Enhanced MRI for Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-08-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An MRI technique utilizing contrast agents to improve the detection and characterization of tumors in various organs. The contrast agent enhances the visibility of tumor vasculature.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US1012345678B2\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI system incorporating a contrast agent delivery mechanism...\",\n        \"A method for imaging tumors using a contrast agent...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68096", "text": "{\n    \"patent_title\": \"Deep Learning for Enhanced MRI Image Reconstruction and Disease Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10456789B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2021-02-23\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"This invention presents a deep learning framework for reconstructing high-quality MRI images from limited data, coupled with a diagnostic module for identifying subtle disease markers. The system significantly improves diagnostic accuracy in early-stage cancer detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in MRI reconstruction\"\n        },\n        {\n            \"patent_number\": \"US10234567B1\",\n            \"relevance\": \"Related work on deep learning in medical imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images using a convolutional neural network.\",\n        \"A system for diagnosing diseases based on reconstructed MRI images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68096", "text": "{\n    \"patent_title\": \"Improved X-Ray Tube Design for Enhanced Image Clarity\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"EP3876543A1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2022-07-14\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"This invention describes a novel X-ray tube design featuring an optimized filament and cooling system, resulting in improved image clarity and reduced radiation dose.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Previous X-ray tube designs\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube with a specific filament geometry.\",\n        \"A cooling system for maintaining optimal tube temperature.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68097", "text": "{\n    \"patent_title\": \"AI-Enhanced Echocardiogram Analysis for Early Cardiovascular Disease Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2022-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel system for automated echocardiogram analysis using deep learning algorithms to detect early indicators of cardiovascular disease. The system improves diagnostic accuracy and reduces the workload for cardiologists.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Prior art in echocardiogram image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for automated analysis of echocardiogram images.\",\n        \"A system comprising a deep learning model trained to identify cardiac abnormalities.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68097", "text": "{\n    \"patent_title\": \"Novel Stent Design for Coronary Artery Blockage\",\n    \"inventors\": [\n        {\n            \"name\": \"Wei Zhang\",\n            \"affiliation\": \"Huazhong University of Science and Technology\"\n        }\n    ],\n    \"patent_number\": \"CN108765432A\",\n    \"priority_date\": \"2018-03-10\",\n    \"filing_date\": \"2018-03-10\",\n    \"issue_date\": \"2020-07-15\",\n    \"patent_office\": \"SIPO\",\n    \"abstract\": \"A new stent design utilizing a biocompatible alloy for improved coronary artery blockage treatment. The stent exhibits enhanced flexibility and reduced risk of restenosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related stent technology\"\n        }\n    ],\n    \"claims\": [\n        \"A stent comprising a biocompatible alloy.\",\n        \"A method for treating coronary artery blockage using the novel stent.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68098", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Boston Medical Center\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel minimally invasive surgical system incorporating ergonomic handles and real-time feedback for improved precision and reduced patient discomfort during procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in minimally invasive surgery\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related technology in surgical robotics\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Similar concept for ergonomic design\"\n        },\n        {\n            \"patent_number\": \"US11000001B2\",\n            \"relevance\": \"Enhanced image guidance systems\"\n        },\n        {\n            \"patent_number\": \"US10500005B2\",\n            \"relevance\": \"Patient feedback systems in surgical settings\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising...\",\n        \"An ergonomic handle...\",\n        \"A method for performing a minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68098", "text": "{\n    \"patent_title\": \"External Cardiac Pacing System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2022-01-10\",\n    \"filing_date\": \"2022-01-10\",\n    \"issue_date\": \"2023-10-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An external pacing system designed to deliver controlled electrical impulses to the heart for regulating heart rhythm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Early cardiac pacing technology\"\n        },\n        {\n            \"patent_number\": \"US8901234B1\",\n            \"relevance\": \"Improved electrode design\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Advanced waveform control\"\n        }\n    ],\n    \"claims\": [\n        \"A pacing system comprising...\",\n        \"An electrode array...\",\n        \"A method for external cardiac pacing...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68099", "text": "{\n    \"patent_title\": \"Method for Noise Reduction in Magnetic Resonance Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reducing noise in magnetic resonance images using a wavelet-based filtering technique. The method improves image clarity and diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for noise reduction in MRI images comprising...\",\n        \"An MRI system configured to perform the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68099", "text": "{\n    \"patent_title\": \"Theoretical Model for Signal Processing in Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A theoretical model for signal processing in medical imaging, focusing on the mathematical foundations of image reconstruction. It does not detail specific implementations.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A theoretical model for signal processing...\",\n        \"An abstract representation of image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68100", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical Stapler with Enhanced Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a surgical stapler designed for minimally invasive procedures. The stapler incorporates ergonomic features to improve surgeon comfort and reduce fatigue, leading to increased precision and improved patient outcomes. The device is suitable for a range of soft tissue procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11111111B2\",\n            \"relevance\": \"Similar stapler design\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an ergonomic handle...\",\n        \"A stapler for minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68100", "text": "{\n    \"patent_title\": \"Cardiovascular Stent with Drug-Eluting Coating\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a drug-eluting stent designed for the treatment of coronary artery disease. The stent is coated with a biocompatible polymer and a therapeutic agent to prevent restenosis. The stent is deployed using conventional methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"relevance\": \"Prior art stent design\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiovascular stent comprising a drug-eluting coating...\",\n        \"A stent for treating coronary artery disease...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68101", "text": "{\n    \"patent_title\": \"Low-Dose Computed Tomography Imaging System and Method\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A system and method for reducing radiation dose in computed tomography (CT) imaging while maintaining image quality. The invention utilizes iterative reconstruction algorithms and advanced detector technology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing CT imaging comprising reducing radiation dose by at least 20%.\",\n        \"A CT imaging system comprising an iterative reconstruction algorithm.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68101", "text": "{\n    \"patent_title\": \"Enhanced X-Ray Imaging Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Kenji Tanaka\",\n            \"affiliation\": \"Tokyo Medical Imaging Inc.\"\n        }\n    ],\n    \"patent_number\": \"JP2017123456A\",\n    \"priority_date\": \"2017-05-01\",\n    \"filing_date\": \"2017-05-01\",\n    \"issue_date\": \"2020-01-10\",\n    \"patent_office\": \"Japan Patent Office\",\n    \"abstract\": \"An X-ray imaging device with improved image resolution and contrast. The device incorporates a novel filtration system.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging device comprising a novel filtration system.\",\n        \"A method for obtaining high-resolution X-ray images.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68102", "text": "{\n    \"patent_title\": \"Deep Learning Enhanced MRI Reconstruction for Accelerated Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for Magnetic Resonance Image (MRI) reconstruction utilizing deep learning techniques to significantly reduce scan time while maintaining image quality. This represents a significant advancement over traditional compressed sensing methods. The technique is entirely non-invasive.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8766854B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images using a deep convolutional neural network.\",\n        \"A system for accelerated MRI scanning incorporating said method.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68102", "text": "{\n    \"patent_title\": \"Improved X-Ray Detection System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"City Hospital\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"City Hospital\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an improved X-ray detection system utilizing a new type of sensor for enhanced image clarity. It offers a faster image acquisition process than previously available systems. This method relies on physical sensor enhancement.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray detection system comprising a novel sensor.\",\n        \"A method for improving X-ray image clarity.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68103", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel minimally invasive surgical system incorporating advanced optical coherence tomography for real-time tissue visualization during procedures. The system reduces trauma and improves surgical precision.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in optical imaging\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related surgical robotic technology\"\n        },\n        {\n            \"patent_number\": \"US11000001B2\",\n            \"relevance\": \"Similar visualization systems\"\n        }\n    ],\n    \"claims\": [\n        \"A minimally invasive surgical system comprising an optical coherence tomography module...\",\n        \"A method for performing a surgical procedure using the system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68103", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Cardiovascular Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Medtronic Inc.\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Medtronic Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2022-01-10\",\n    \"filing_date\": \"2022-01-10\",\n    \"issue_date\": \"2023-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design with enhanced flexibility and reduced friction for cardiovascular procedures. The catheter facilitates navigation through complex vascular structures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art catheter designs\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible distal tip...\",\n        \"A method for navigating a vascular structure...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68104", "text": "{\n    \"patent_title\": \"Improved MRI Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method for reconstructing high-resolution MRI images using a deep learning approach, significantly improving diagnostic accuracy compared to traditional methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"The method of claim 1, wherein the deep learning model is a convolutional neural network.\",\n        \"The method of claim 2, wherein the convolutional neural network is trained on a dataset of...\",\n        \"An MRI system configured to perform the method of claim 1.\",\n        \"...\",\n        \"A non-transitory computer-readable medium storing instructions for...\",\n        \"The method of claim 1, further comprising a quality assessment module.\",\n        \"A system as claimed in claim 8, wherein the quality assessment module is configured to...\",\n        \"A method for reducing noise in MRI images.\",\n        \"A system for automated tumor detection in MRI scans.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68104", "text": "{\n    \"patent_title\": \"Cosmetic Skin Analysis Device Using Optical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2019-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention is a device for analyzing skin conditions for cosmetic purposes, utilizing optical imaging to assess wrinkles and pigmentation. It provides a personalized skin care recommendation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art in optical skin analysis\"\n        }\n    ],\n    \"claims\": [\n        \"A device for analyzing skin comprising...\",\n        \"The device of claim 1, wherein the optical imaging source is a visible light source.\",\n        \"The device of claim 2, further comprising a display for showing skin analysis results.\",\n        \"A method for recommending skincare products based on skin analysis results.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68105", "text": "{\n    \"patent_title\": \"High-Density Lithium-Ion Battery with Enhanced Electrolyte\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Kenji Tanaka\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery with a novel electrolyte composition providing increased energy density and improved safety characteristics. This design incorporates a solid-state electrolyte and a high-capacity cathode material.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8785243B2\",\n            \"title\": \"Lithium Ion Battery Electrode\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition including...\",\n        \"A cathode material with a specific crystal structure...\",\n        \"A method for manufacturing the battery...\",\n        \"The battery as claimed in claim 1, wherein...\",\n        \"The electrolyte exhibits a conductivity of at least...\",\n        \"A battery with improved thermal stability...\",\n        \"A method for controlling the electrolyte's viscosity...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68105", "text": "{\n    \"patent_title\": \"Enhanced Oil Recovery Using Novel Polymer Flooding Techniques\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Miller\",\n            \"affiliation\": \"ExxonMobil\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Chevron Corporation\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-07-20\",\n    \"filing_date\": \"2017-07-20\",\n    \"issue_date\": \"2019-05-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for enhancing oil recovery from subterranean reservoirs using a novel polymer flooding technique. This technique improves oil displacement efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Polymer Flooding Process\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing oil recovery...\",\n        \"A polymer solution comprising...\",\n        \"The method as claimed in claim 1, wherein...\",\n        \"A subterranean reservoir treated with the polymer solution...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68106", "text": "{\n    \"patent_title\": \"Advanced Beamforming Techniques for 5G Wireless Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Qualcomm Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-09-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents novel beamforming algorithms for 5G wireless networks, significantly improving signal strength and reducing interference. The technique dynamically adjusts beam patterns based on real-time channel conditions, resulting in higher data throughput and improved network capacity. The system also incorporates machine learning for predictive beamforming.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Beamforming in MIMO Systems\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Interference Cancellation Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for beamforming in a wireless communication system, comprising...\",\n        \"An apparatus for implementing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68106", "text": "{\n    \"patent_title\": \"Improved Antenna Design for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Samsung Electronics\"\n        }\n    ],\n    \"patent_number\": \"EP3876543B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2022-08-25\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"An improved antenna design for mobile devices. This invention focuses on miniaturizing the antenna while maintaining optimal performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Miniaturized Antenna Designs\"\n        },\n        {\n            \"patent_number\": \"US9654321B2\",\n            \"title\": \"Antenna Impedance Matching\"\n        },\n        {\n            \"patent_number\": \"US10543210B2\",\n            \"title\": \"Antenna Radiation Patterns\"\n        },\n        {\n            \"patent_number\": \"US11432109B2\",\n            \"title\": \"Antenna Efficiency Optimization\"\n        }\n    ],\n    \"claims\": [\n        \"An antenna for a mobile device, characterized by...\",\n        \"A mobile device comprising the antenna of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68107", "text": "{\n    \"patent_title\": \"Improved MRI Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2018-11-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method for reconstructing magnetic resonance images (MRI) using deep learning techniques. The method significantly improves diagnostic accuracy by reducing noise and enhancing image clarity, allowing for earlier and more reliable detection of anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images...\",\n        \"The method of claim 1, wherein the deep learning model is a convolutional neural network...\",\n        \"The method of claim 1, wherein the image reconstruction is performed in real-time...\",\n        \"A system for performing the method of claim 1...\",\n        \"The system of claim 4, comprising a user interface for displaying the reconstructed image...\",\n        \"The system of claim 4, further comprising a storage module...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68107", "text": "{\n    \"patent_title\": \"Digital X-Ray Image Enhancement System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2014-12-15\",\n    \"filing_date\": \"2014-12-15\",\n    \"issue_date\": \"2017-04-04\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a digital X-ray image enhancement system that improves the contrast and clarity of X-ray images. The system utilizes image processing algorithms to enhance the visualization of anatomical structures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"related_art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for enhancing digital X-ray images...\",\n        \"The system of claim 1, wherein the image enhancement algorithm includes a histogram equalization step...\",\n        \"The system of claim 1, further comprising a display device for viewing the enhanced image...\",\n        \"The system of claim 1, wherein the system is integrated with a digital radiography system.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68108", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Pressure Sensor System for Glaucoma Management\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Davis\",\n            \"affiliation\": \"Medtronic Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-05-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable pressure sensor system for continuous monitoring of intraocular pressure in glaucoma patients. The system provides real-time data transmission and alerts for pressure excursions, enabling proactive management and improved patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9233121B2\",\n            \"relevance\": \"Prior art on implantable sensors\"\n        }\n    ],\n    \"claims\": [\n        \"A pressure sensor system for implantation within the eye.\",\n        \"A system comprising a pressure sensor, a transmitter, and a receiver.\",\n        \"A method for monitoring intraocular pressure using the system.\",\n        \"A method for alerting a patient or physician based on pressure readings.\",\n        \"A system with a battery life of at least 6 months.\",\n        \"A system with a data transmission range of at least 1 meter.\",\n        \"A system with biocompatible materials\"\n    ]\n}"}
{"_id": "Academic--patents--n--68108", "text": "{\n    \"patent_title\": \"Surgical Instrument for Laparoscopic Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Chen\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9540012B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical instrument designed for enhanced precision during laparoscopic procedures. Features an ergonomic handle and improved articulation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8877456B2\",\n            \"relevance\": \"Related art in surgical instrumentation\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument with an ergonomic handle.\",\n        \"An instrument with an articulating tip.\",\n        \"A method for performing laparoscopic surgery using the instrument.\",\n        \"An instrument with a detachable blade.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68109", "text": "{\n    \"patent_title\": \"AI-Powered Diagnostic System for Retinal Disease Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2021-11-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for automatically detecting and diagnosing retinal diseases using deep learning algorithms applied to optical coherence tomography (OCT) images. The system provides improved accuracy and efficiency compared to traditional methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"High\"\n        },\n        {\n            \"patent_number\": \"US1012345678B2\",\n            \"relevance\": \"Medium\"\n        },\n        {\n            \"patent_number\": \"US1122334455B2\",\n            \"relevance\": \"High\"\n        },\n        {\n            \"patent_number\": \"US1211223344B2\",\n            \"relevance\": \"Medium\"\n        },\n        {\n            \"patent_number\": \"US1312334455B2\",\n            \"relevance\": \"High\"\n        }\n    ],\n    \"claims\": [\n        \"A method for diagnosing retinal diseases comprising...\",\n        \"A system for analyzing OCT images...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68109", "text": "{\n    \"patent_title\": \"Improved MRI Pulse Sequence for Cardiac Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2022-07-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel MRI pulse sequence designed to enhance image quality and reduce scan time for cardiac imaging applications. The sequence utilizes advanced gradient techniques and optimized radiofrequency pulse shaping.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"High\"\n        },\n        {\n            \"patent_number\": \"US87654321B1\",\n            \"relevance\": \"Medium\"\n        },\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Low\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI pulse sequence comprising...\",\n        \"A method for reducing scan time in cardiac MRI...\",\n        \"An apparatus for generating MRI signals...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68110", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel minimally invasive surgical system comprising a micro-robotic platform with integrated high-resolution imaging for precise tissue manipulation and enhanced visualization during complex procedures. This system aims to improve patient outcomes by reducing recovery times and minimizing surgical trauma.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art on robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising...\",\n        \"A method for minimally invasive surgery...\",\n        \"An imaging system integrated with a robotic platform...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68110", "text": "{\n    \"patent_title\": \"Dermal Filler Injection Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Sarah Johnson\",\n            \"affiliation\": \"University of California, Los Angeles\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2021-02-28\",\n    \"filing_date\": \"2021-04-15\",\n    \"issue_date\": \"2023-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved device for injecting dermal fillers with precise volume control. The device utilizes a micro-needle technology to deliver hyaluronic acid into the subcutaneous layer for cosmetic facial enhancement. The design focuses on minimizing patient discomfort and achieving natural-looking results.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"Related prior art on dermal filler application\"\n        }\n    ],\n    \"claims\": [\n        \"A dermal filler injection device comprising...\",\n        \"A method for injecting dermal fillers...\",\n        \"A micro-needle assembly for subcutaneous delivery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68111", "text": "{\n    \"patent_title\": \"High-Efficiency Perovskite Solar Cells with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Li Wei\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Maria Rodriguez\",\n            \"affiliation\": \"National Renewable Energy Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-12-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel perovskite solar cell structure incorporating a new hole transport material, resulting in a power conversion efficiency exceeding 25%. The device demonstrates significantly improved stability under prolonged exposure to sunlight and humidity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Perovskite Solar Cell Composition\"\n        }\n    ],\n    \"claims\": [\n        \"A perovskite solar cell comprising a perovskite absorber layer.\",\n        \"The perovskite solar cell of claim 1, wherein the perovskite absorber layer includes a methylammonium lead halide.\",\n        \"A method of fabricating a perovskite solar cell...\",\n        \"The method of claim 3, wherein the annealing temperature is between 100°C and 150°C.\",\n        \"A solar module comprising the perovskite solar cell of claim 1.\",\n        \"The solar module of claim 5, wherein the module has an efficiency of at least 20%.\",\n        \"The perovskite solar cell of claim 1, further comprising a stabilizing agent.\",\n        \"The stabilizing agent of claim 7 is a polymer.\",\n        \"The perovskite solar cell of claim 1, wherein the hole transport material is a novel organic molecule.\",\n        \"The novel organic molecule of claim 9 has a high hole mobility.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68111", "text": "{\n    \"patent_title\": \"Concentrated Solar Power System with Improved Mirror Control\",\n    \"inventors\": [\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-01-01\",\n    \"filing_date\": \"2019-07-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a concentrated solar power system with a novel mirror control algorithm. The algorithm improves the precision of the mirror alignment, maximizing the amount of sunlight focused on the receiver.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Solar Tracking System\"\n        }\n    ],\n    \"claims\": [\n        \"A concentrated solar power system comprising a plurality of mirrors.\",\n        \"The system of claim 1, wherein the mirrors are heliostats.\",\n        \"A control system for controlling the mirrors.\",\n        \"The control system of claim 3, wherein the control system uses a feedback loop.\",\n        \"A method of operating a concentrated solar power system.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68112", "text": "{\n    \"patent_title\": \"Low-Dose Computed Tomography with Iterative Reconstruction and Adaptive Statistical Iterative Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-07-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for reducing radiation dose in computed tomography (CT) imaging while maintaining image quality. The technique utilizes iterative reconstruction algorithms with adaptive statistical iterative reconstruction to minimize noise and artifacts at low dose levels.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"title\": \"Computed Tomography Image Reconstruction Method\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Radiation Dose Reduction in CT Imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing radiation dose in computed tomography imaging...\",\n        \"A system comprising a CT scanner and a reconstruction algorithm...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68112", "text": "{\n    \"patent_title\": \"Magnetic Resonance Imaging Pulse Sequence for Enhanced Soft Tissue Contrast\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-01-15\",\n    \"filing_date\": \"2017-01-14\",\n    \"issue_date\": \"2020-03-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved magnetic resonance imaging (MRI) pulse sequence designed to enhance contrast in soft tissue imaging. The pulse sequence incorporates novel gradient waveforms and radiofrequency excitation schemes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"title\": \"MRI Pulse Sequence Optimization\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI pulse sequence comprising a specific gradient waveform...\",\n        \"A method for enhancing soft tissue contrast in MRI...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68113", "text": "{\n    \"patent_title\": \"Method and System for Enhanced MRI Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Robert Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-01-20\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A novel method for improving the quality and speed of MRI image reconstruction using deep learning techniques. The system addresses issues of noise and artifacts commonly found in MRI scans, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"The method of claim 1, wherein the deep learning model is a convolutional neural network.\",\n        \"A system for performing MRI image reconstruction...\",\n        \"The system of claim 3, further comprising a display device.\",\n        \"The method of claim 1, further comprising a step of noise reduction.\",\n        \"The method of claim 5, wherein the noise reduction is performed using a wavelet transform.\",\n        \"The system of claim 3, wherein the deep learning model is trained on a dataset of MRI images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68113", "text": "{\n    \"patent_title\": \"Improved X-Ray Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"EP11223344B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2023-04-12\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"An improved X-ray imaging system with reduced radiation exposure. The system utilizes advanced filtering techniques to enhance image clarity and reduce patient risk.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"The system of claim 1, wherein the radiation dose is reduced by at least 20%.\",\n        \"A method for operating an X-ray imaging system...\",\n        \"The method of claim 3, further comprising a step of image enhancement.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68114", "text": "{\n    \"patent_title\": \"Miniaturized Optical Coherence Tomography System for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-06-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized optical coherence tomography (OCT) system for real-time, high-resolution imaging of subsurface tissues. This system enables minimally invasive early cancer detection with improved patient outcomes compared to traditional biopsy methods. The device's compact size allows for use in point-of-care settings.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in OCT technology\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized OCT system comprising...\",\n        \"A method for early cancer detection using the system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68114", "text": "{\n    \"patent_title\": \"Improved Cardiac Pacemaker with Enhanced Battery Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved cardiac pacemaker featuring a novel battery management system that significantly extends battery life. This device provides reliable pacing for patients with heart rhythm disorders, leading to improved quality of life. The design includes advanced algorithms for optimizing power consumption.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art in cardiac pacing technology\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiac pacemaker comprising...\",\n        \"A battery management system for extending battery life...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68115", "text": "{\n    \"patent_title\": \"Deep Learning for Real-Time Image Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-06-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for enhancing the quality of digital images in real-time, utilizing convolutional neural networks to reduce noise and improve clarity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for real-time image enhancement using a deep learning model.\",\n        \"A system comprising a deep learning model configured to enhance image quality.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68115", "text": "{\n    \"patent_title\": \"Image Compression Using Discrete Cosine Transform\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US5678901A\",\n    \"priority_date\": \"1995-01-05\",\n    \"filing_date\": \"1995-01-05\",\n    \"issue_date\": \"1997-08-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for compressing digital images using a discrete cosine transform (DCT) algorithm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US4868754\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image compression using DCT.\",\n        \"An apparatus for performing DCT-based image compression.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68116", "text": "{\n    \"patent_title\": \"Minimally Invasive Glucose Monitoring System with Enhanced Comfort\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"MIT Lincoln Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive glucose monitoring system utilizing micro-sensors and a biocompatible adhesive patch for continuous glucose monitoring with improved patient comfort and reduced skin irritation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8236123B2\",\n            \"relevance\": \"Prior art in glucose sensing technology\"\n        }\n    ],\n    \"claims\": [\n        \"A glucose monitoring system comprising a micro-sensor...\",\n        \"A biocompatible adhesive patch for securing the micro-sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68116", "text": "{\n    \"patent_title\": \"Pharmaceutical Formulation for Controlled Drug Release\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Wilson\",\n            \"affiliation\": \"Pfizer Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-08-10\",\n    \"filing_date\": \"2017-08-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel pharmaceutical formulation utilizing a polymer matrix for controlled drug release, enhancing drug efficacy and reducing side effects.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7981654B2\",\n            \"relevance\": \"Prior art in controlled release formulations\"\n        }\n    ],\n    \"claims\": [\n        \"A pharmaceutical formulation comprising a polymer matrix...\",\n        \"A method of controlling drug release using the formulation...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68117", "text": "{\n    \"patent_title\": \"Non-Invasive Glucose Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive system for continuous glucose monitoring using near-infrared spectroscopy. The device provides real-time glucose levels without the need for blood samples.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Non-invasive Blood Glucose Meter\"\n        }\n    ],\n    \"claims\": [\n        \"A method for non-invasively determining glucose concentration in a subject.\",\n        \"A device comprising a light source and a detector for measuring glucose levels.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68117", "text": "{\n    \"patent_title\": \"Dental Imaging System with Enhanced Resolution\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2015-11-01\",\n    \"filing_date\": \"2015-11-01\",\n    \"issue_date\": \"2018-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved dental imaging system utilizing cone-beam computed tomography (CBCT) to provide high-resolution images of the teeth and surrounding structures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Dental X-ray Apparatus\"\n        }\n    ],\n    \"claims\": [\n        \"A dental imaging system comprising a CBCT scanner.\",\n        \"A method for generating high-resolution dental images.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68118", "text": "{\n    \"patent_title\": \"Enhanced Resolution MRI with AI-Powered Artifact Reduction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel method for enhancing the resolution of magnetic resonance images (MRI) using artificial intelligence to reduce artifacts and improve diagnostic accuracy. The system utilizes a deep learning algorithm to identify and remove noise, resulting in clearer images and more reliable diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"citation_type\": \"related\"\n        },\n        {\n            \"patent_number\": \"US1012345678B2\",\n            \"citation_type\": \"related\"\n        },\n        {\n            \"patent_number\": \"US1122334455B2\",\n            \"citation_type\": \"related\"\n        },\n        {\n            \"patent_number\": \"US1211223344B2\",\n            \"citation_type\": \"related\"\n        },\n        {\n            \"patent_number\": \"US1313131313B2\",\n            \"citation_type\": \"related\"\n        },\n        {\n            \"patent_number\": \"US1414141414B2\",\n            \"citation_type\": \"related\"\n        },\n        {\n            \"patent_number\": \"US1515151515B2\",\n            \"citation_type\": \"related\"\n        },\n        {\n            \"patent_number\": \"US1616161616B2\",\n            \"citation_type\": \"related\"\n        },\n        {\n            \"patent_number\": \"US1717171717B2\",\n            \"citation_type\": \"related\"\n        },\n        {\n            \"patent_number\": \"US1818181818B2\",\n            \"citation_type\": \"related\"\n        },\n        {\n            \"patent_number\": \"US1919191919B2\",\n            \"citation_type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI image resolution comprising...\",\n        \"An AI-powered artifact reduction system for MRI images...\",\n        \"A diagnostic system utilizing enhanced MRI images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68118", "text": "{\n    \"patent_title\": \"Improved CT Scan Reconstruction Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Karl Schmidt\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"EP23456789B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"This invention details an improved algorithm for reconstructing images from computed tomography (CT) scans, resulting in faster processing times and reduced radiation exposure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"citation_type\": \"related\"\n        },\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"citation_type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A CT image reconstruction algorithm comprising...\",\n        \"A system for reducing radiation exposure in CT scans...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68119", "text": "{\n    \"patent_title\": \"Enhanced MRI Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel deep learning framework for reconstructing Magnetic Resonance Images (MRI) from undersampled k-space data. The proposed method significantly improves image quality and reduces scan time, leading to enhanced diagnostic accuracy in various clinical applications. Detailed experiments on both simulated and real-world datasets demonstrate substantial improvements over state-of-the-art reconstruction techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for implementing the method of claim 1...\",\n        \"A computer-readable medium storing instructions for...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68119", "text": "{\n    \"patent_title\": \"Improved X-ray Image Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"Siemens Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11123456B2\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-11-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method for processing X-ray images to enhance contrast. It improves the clarity of images in certain low-density scenarios.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing X-ray images...\",\n        \"A system for performing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68120", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Cardiac Monitor with Wireless Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable cardiac monitor providing real-time ECG data transmission via Bluetooth Low Energy. The device incorporates advanced arrhythmia detection algorithms and prolonged battery life, significantly improving post-operative patient monitoring and reducing hospital readmissions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on implantable cardiac devices\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable cardiac monitor comprising...\",\n        \"A method for wirelessly transmitting ECG data...\",\n        \"An arrhythmia detection algorithm implemented on the monitor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68120", "text": "{\n    \"patent_title\": \"Surgical Instrument Sterilization Tray\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Acme Medical Supplies\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2023-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A sterilization tray designed to efficiently and safely hold surgical instruments during the sterilization process. The tray is constructed from medical-grade stainless steel and features a locking mechanism to prevent instrument slippage.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A sterilization tray comprising...\",\n        \"A locking mechanism for securing instruments...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68121", "text": "{\n    \"patent_title\": \"Energy-Efficient Beamforming for Millimeter Wave Wireless Communications\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11256789B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-11-28\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A system and method for beamforming in millimeter wave wireless communication systems, reducing energy consumption while maintaining high data rates. The invention utilizes a novel algorithm to dynamically adjust beam patterns based on channel conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Beamforming Techniques for Wireless Networks\"\n        }\n    ],\n    \"claims\": [\n        \"A method for beamforming in a wireless communication system, comprising...\",\n        \"A system for implementing the beamforming method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68121", "text": "{\n    \"patent_title\": \"Improved Signal Processing for 5G Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Nokia Research\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Ericsson\"\n        }\n    ],\n    \"patent_number\": \"EP3876543A1\",\n    \"priority_date\": \"2020-10-20\",\n    \"filing_date\": \"2020-10-20\",\n    \"issue_date\": \"2023-05-10\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"A new signal processing technique for 5G networks improving data throughput. The invention utilizes advanced modulation schemes and error correction codes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Modulation Schemes for Wireless Communication\"\n        }\n    ],\n    \"claims\": [\n        \"A signal processing method for 5G networks, comprising...\",\n        \"A system for implementing the signal processing method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68122", "text": "{\n    \"patent_title\": \"Improved MRI Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning approach for reconstructing high-resolution MRI images from undersampled data, leading to improved diagnostic accuracy and reduced scan times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI reconstruction...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68122", "text": "{\n    \"patent_title\": \"Novel MRI Coil Design for Pediatric Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Boston Children's Hospital\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2015-11-10\",\n    \"filing_date\": \"2015-11-10\",\n    \"issue_date\": \"2017-05-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A specialized MRI coil designed to minimize motion artifacts and improve image quality in pediatric patients.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil comprising...\",\n        \"A method for imaging a pediatric patient...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68123", "text": "{\n    \"patent_title\": \"Deep Learning Based Image Recognition System for Autonomous Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-10-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition using deep learning techniques, specifically convolutional neural networks, for application in autonomous vehicles. The system achieves high accuracy and robustness in real-world driving conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a deep learning model...\",\n        \"The system of claim 1, wherein the deep learning model is a convolutional neural network.\",\n        \"The method of claim 2, wherein the training data comprises images captured from a vehicle.\",\n        \"The system of claim 1, further comprising a processing unit...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68123", "text": "{\n    \"patent_title\": \"Theoretical Framework for Image Feature Extraction\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2019-05-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel theoretical approach to image feature extraction based on wavelet transforms and fractal geometry. It explores the mathematical properties of image data with no specific practical application.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for extracting image features based on wavelet transforms...\",\n        \"The method of claim 1, wherein the wavelet transform is a Daubechies wavelet.\",\n        \"A system for performing the method of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68124", "text": "{\n    \"patent_title\": \"Contrast-Enhanced MRI with Targeted Nanoparticles for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10556789B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method for enhancing Magnetic Resonance Imaging (MRI) contrast using targeted nanoparticles. The nanoparticles are designed to selectively bind to cancer cells, allowing for earlier and more accurate detection of tumors. The improved contrast enables identification of smaller lesions, leading to earlier diagnosis and treatment. The method utilizes a novel surface coating on the nanoparticles to minimize non-specific binding and enhance biocompatibility.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Nanoparticle Synthesis for Medical Imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI contrast comprising...\",\n        \"A nanoparticle comprising a targeting ligand...\",\n        \"An MRI system configured to utilize the nanoparticles...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68124", "text": "{\n    \"patent_title\": \"System and Method for Automated Medical Image Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2017-09-20\",\n    \"filing_date\": \"2017-09-20\",\n    \"issue_date\": \"2022-05-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for automated analysis of medical images, including CT scans, X-rays, and MRIs. The system utilizes machine learning algorithms to identify potential anomalies and provide preliminary diagnostic information. The method includes image preprocessing, feature extraction, and classification stages. This is a broadly applicable system for aiding radiologists in their work.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"title\": \"Machine Learning Techniques for Image Processing\"\n        }\n    ],\n    \"claims\": [\n        \"A system for automated medical image analysis comprising...\",\n        \"A method for identifying anomalies in medical images...\",\n        \"A computer-readable medium storing instructions for performing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68125", "text": "{\n    \"patent_title\": \"High-Performance Solid-State Electrolyte for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel solid-state electrolyte composition for lithium-ion batteries exhibiting enhanced ionic conductivity and improved safety characteristics. This technology contributes to more sustainable energy storage solutions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A solid-state electrolyte composition comprising...\",\n        \"A lithium-ion battery cell incorporating said electrolyte composition...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68125", "text": "{\n    \"patent_title\": \"Battery Management System for Electric Vehicle Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Tesla, Inc.\"\n        },\n        {\n            \"name\": \"Sarah Chen\",\n            \"affiliation\": \"Tesla, Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2018-05-10\",\n    \"filing_date\": \"2018-05-10\",\n    \"issue_date\": \"2021-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system designed to optimize the performance and lifespan of lithium-ion battery packs in electric vehicles. The system incorporates advanced algorithms for cell balancing and thermal management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for cell balancing in a battery pack...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68126", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Boston Medical Center\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-07-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system incorporating advanced imaging and robotic control for precise tissue manipulation. This system addresses the need for less traumatic surgical procedures, leading to faster recovery times and reduced patient discomfort. Specifically designed for complex procedures where access is limited.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art related to robotic surgical systems.\"\n        }\n    ],\n    \"claims\": [\n        \"A minimally invasive surgical system comprising...\",\n        \"A method for performing a surgical procedure using the system...\",\n        \"An imaging system integrated with the surgical system...\",\n        \"A robotic arm adapted for precise tissue manipulation...\",\n        \"A control system for regulating the robotic arm...\",\n        \"A display interface for visualizing surgical field...\",\n        \"A sensor for providing feedback on tissue properties...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68126", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Medical Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11555555B2\",\n    \"priority_date\": \"2022-05-10\",\n    \"filing_date\": \"2022-05-10\",\n    \"issue_date\": \"2024-01-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler with enhanced ergonomic features for increased surgeon comfort and efficiency. The stapler offers improved grip and reduced hand fatigue during prolonged use.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous stapler designs.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"An ergonomic handle...\",\n        \"A staple cartridge...\",\n        \"A firing mechanism...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68127", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Sharpening\",\n    \"inventors\": [\n        {\n            \"name\": \"Marc Levoy\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jiawen Chen\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for enhancing the sharpness of digital images by adaptively applying unsharp masking based on local image characteristics. The system improves visual quality and reduces artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8542251B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for sharpening a digital image comprising...\",\n        \"A system for implementing the sharpening method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68127", "text": "{\n    \"patent_title\": \"Real-Time Ultrasound Image Enhancement for Medical Diagnosis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford Hospital\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2019-09-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An apparatus and method for improving the quality of ultrasound images for enhanced medical diagnosis. The system applies noise reduction and contrast enhancement algorithms tailored for ultrasound data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"An ultrasound image enhancement system comprising...\",\n        \"A method for reducing noise in ultrasound images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68128", "text": "{\n    \"patent_title\": \"Surgical Robotic System with Enhanced Precision and Dexterity\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a surgical robotic system incorporating advanced sensors and algorithms to enhance precision and dexterity during minimally invasive surgical procedures. The system aims to improve patient outcomes by reducing surgical trauma and recovery time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic system comprising...\",\n        \"A method for performing a surgical procedure using the system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68128", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Cardiovascular Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Medtronic\"\n        }\n    ],\n    \"patent_number\": \"EP3456789A1\",\n    \"priority_date\": \"2020-10-20\",\n    \"filing_date\": \"2020-10-20\",\n    \"issue_date\": \"2022-05-11\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"A novel catheter design for improved navigation within the cardiovascular system during diagnostic and therapeutic procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related catheter technology\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising...\",\n        \"A method for navigating a catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68129", "text": "{\n    \"patent_title\": \"Ultrasound-based System for Enhanced Breast Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel ultrasound system incorporating advanced signal processing techniques to improve the detection of small breast tumors. The system utilizes multi-frequency imaging and adaptive filtering to enhance image clarity and reduce false positives.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Method for Improving Ultrasound Image Quality\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting breast cancer using ultrasound imaging.\",\n        \"An ultrasound system comprising a transducer and a signal processing unit.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68129", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging Coil Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel coil design for magnetic resonance imaging (MRI) systems, improving signal-to-noise ratio and image resolution. This coil enables faster scan times and more detailed anatomical images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"MRI Pulse Sequence Optimization\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil with improved signal-to-noise ratio.\",\n        \"A method for using the MRI coil to acquire images.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68130", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel miniaturized implantable biosensor for continuous glucose monitoring is disclosed. The device utilizes a highly sensitive enzymatic reaction coupled with a microfabricated electrochemical cell.  The system is designed for long-term implantation and provides real-time glucose data transmission via Bluetooth to a patient's smartphone. The biosensor incorporates biocompatible materials and a power-harvesting system to minimize battery replacement frequency. The device addresses the need for more accurate and convenient glucose monitoring for diabetic patients.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Implantable Glucose Sensor with Wireless Communication\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable biosensor for continuous glucose monitoring comprising...\",\n        \"A method for continuously monitoring glucose levels in a patient using said biosensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68130", "text": "{\n    \"patent_title\": \"Improved Dental Implant Design for Enhanced Osseointegration\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-01-15\",\n    \"filing_date\": \"2022-01-15\",\n    \"issue_date\": \"2024-02-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved design for dental implants. The implant features a modified surface texture and a novel screw thread geometry to enhance osseointegration and improve long-term stability. The design promotes faster bone growth around the implant and reduces the risk of implant failure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Dental Implant with Bioactive Coating\"\n        }\n    ],\n    \"claims\": [\n        \"A dental implant comprising a titanium alloy body with a roughened surface...\",\n        \"A method for implanting said dental implant into a patient's jawbone...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68131", "text": "{\n    \"patent_title\": \"Micro-Catheter with Integrated Sensor for Real-Time Tissue Characterization\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2023-11-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A micro-catheter incorporating a miniature sensor for real-time tissue characterization during minimally invasive procedures. The sensor provides feedback on tissue density, temperature, and blood flow, aiding surgeons in accurate diagnosis and treatment.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in micro-catheter design.\"\n        }\n    ],\n    \"claims\": [\n        \"A micro-catheter comprising...\",\n        \"A sensor integrated within the catheter...\",\n        \"A method for real-time tissue characterization...\",\n        \"...\",\n        \"A system for displaying sensor data to a surgeon\"\n    ]\n}"}
{"_id": "Academic--patents--n--68131", "text": "{\n    \"patent_title\": \"Robotic Surgical System with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alan Turing\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Grace Hopper\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-07-01\",\n    \"filing_date\": \"2020-07-01\",\n    \"issue_date\": \"2023-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A robotic surgical system providing enhanced precision and dexterity for complex surgical procedures. The system incorporates advanced algorithms and haptic feedback to improve surgical outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art in robotic surgery.\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system comprising...\",\n        \"A robotic arm with multiple degrees of freedom...\",\n        \"A control system for manipulating the robotic arm...\",\n        \"...\",\n        \"A method for performing surgery using the robotic system\"\n    ]\n}"}
{"_id": "Academic--patents--p--68132", "text": "{\n    \"patent_title\": \"Pediatric MRI Enhancement Using Novel Contrast Agents\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-08-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel contrast agents for enhancing MRI image quality in pediatric patients, reducing scan times and radiation exposure. The agents are biocompatible and specifically target tumor markers, improving diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on MRI contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"A method for enhancing MRI image quality...\",\n        \"An MRI system incorporating the contrast agent...\",\n        \"A method for diagnosing pediatric tumors...\",\n        \"The contrast agent is biocompatible...\",\n        \"The contrast agent reduces scan time...\",\n        \"The contrast agent improves diagnostic accuracy...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68132", "text": "{\n    \"patent_title\": \"Automated Image Analysis for Adult Cardiac Health\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2022-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an automated system for analyzing cardiac MRI images to detect abnormalities in adult patients. It utilizes machine learning algorithms to identify areas of concern and provides quantitative metrics for assessing heart health.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art on cardiac image analysis\"\n        }\n    ],\n    \"claims\": [\n        \"A system for analyzing cardiac MRI images...\",\n        \"A method for detecting cardiac abnormalities...\",\n        \"A machine learning algorithm for image analysis...\",\n        \"A method for quantifying heart health metrics...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68133", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Recognition System for Medical Diagnosis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-12-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image recognition system utilizing deep learning techniques for accurate and efficient medical diagnosis. The system employs convolutional neural networks to analyze medical images and identify potential anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Analysis Using Machine Learning\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for medical diagnosis utilizing deep learning...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68133", "text": "{\n    \"patent_title\": \"Improved Method for Object Detection in Video Streams\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"ACME Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2022-05-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a method for detecting objects in video streams using traditional image processing techniques. It offers improved performance in low-light conditions.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for object detection in video streams...\",\n        \"A system for real-time video analysis...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68134", "text": "{\n    \"patent_title\": \"Enhanced MRI Image Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing Magnetic Resonance Images (MRI) utilizing deep learning techniques, resulting in improved image clarity and reduced scan time. This significantly improves diagnostic capabilities for neurological disorders.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"MRI Reconstruction with Compressed Sensing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68134", "text": "{\n    \"patent_title\": \"Cardiac MRI with Contrast Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2017-09-20\",\n    \"filing_date\": \"2017-09-20\",\n    \"issue_date\": \"2021-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved technique for cardiac MRI imaging utilizing contrast agents to enhance visualization of heart structures and function. Offers improved detection of coronary artery disease.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Contrast Agent for Cardiac Imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing cardiac MRI...\",\n        \"A contrast agent composition for use in cardiac MRI...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68135", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Enhancement for Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"TechVision Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"TechVision Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for enhancing the quality of medical images, improving diagnostic accuracy. The system utilizes a generative adversarial network (GAN) to reconstruct high-resolution images from low-resolution inputs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing medical images comprising...\",\n        \"A system for generating high-resolution images...\",\n        \"A deep learning model configured to...\",\n        \"A non-transitory computer-readable medium...\",\n        \"A method for improving diagnostic accuracy...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68135", "text": "{\n    \"patent_title\": \"Image Compression Algorithm for Satellite Imagery\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2020-11-15\",\n    \"filing_date\": \"2020-11-15\",\n    \"issue_date\": \"2022-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new algorithm for compressing satellite images, reducing storage requirements without significant loss of information. This algorithm is based on wavelet transforms and quantization techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing satellite images...\",\n        \"A system for reducing storage requirements...\",\n        \"A wavelet transform-based compression algorithm...\",\n        \"A computer program for implementing...\",\n        \"A method for maintaining image quality...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68136", "text": "{\n    \"patent_title\": \"High-Resolution Magnetic Resonance Imaging for Early Stage Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel magnetic resonance imaging (MRI) technique achieving significantly improved resolution and contrast, enabling the detection of small tumors at early stages. This invention utilizes a unique pulse sequence and advanced image reconstruction algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"relevance\": \"Prior art on MRI pulse sequences\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI with enhanced resolution.\",\n        \"An MRI apparatus configured for early tumor detection.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68136", "text": "{\n    \"patent_title\": \"Improved X-Ray Imaging System with Digital Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Clara Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Ethan Fisher\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9123456B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved X-ray imaging system incorporating digital image processing techniques to enhance image clarity and reduce radiation exposure. This system is particularly suited for diagnosing bone fractures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Previous X-ray systems\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system with digital enhancement.\",\n        \"A method for reducing radiation exposure in X-ray imaging.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68137", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Sensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized wireless sensor for continuous glucose monitoring is disclosed. The sensor utilizes a novel biocompatible material and a low-power communication protocol, enabling real-time data transmission to a mobile device for improved diabetes management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Similar glucose monitoring technology\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless glucose sensor comprising...\",\n        \"A biocompatible material for sensor encapsulation...\",\n        \"A low-power communication protocol...\",\n        \"A method for continuous glucose monitoring...\",\n        \"A system for data transmission to a mobile device...\",\n        \"A method for calibrating the sensor...\",\n        \"The sensor comprising a microfluidic channel...\",\n        \"The sensor powered by inductive coupling...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68137", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Cardiovascular Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Wilson\",\n            \"affiliation\": \"Medtronic Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-11-22\",\n    \"filing_date\": \"2019-11-22\",\n    \"issue_date\": \"2022-07-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design for cardiovascular procedures is described. The catheter incorporates a flexible tip and enhanced maneuverability for precise navigation within blood vessels.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous catheter designs\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible tip...\",\n        \"A catheter with enhanced maneuverability...\",\n        \"A method for navigating blood vessels...\",\n        \"A catheter with a distal sensor...\",\n        \"The catheter constructed from a polymer material...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68138", "text": "{\n    \"patent_title\": \"MRI Image Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for reconstructing Magnetic Resonance Images (MRIs) using deep learning algorithms, significantly improving image quality and diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for MRI image reconstruction comprising...\",\n        \"A system for improved MRI image quality...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68138", "text": "{\n    \"patent_title\": \"Portable X-Ray Device with Digital Readout\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2018-02-13\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A portable X-ray device with a digital readout for immediate image capture and analysis. Provides a compact and efficient solution for on-site medical diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A portable X-ray device comprising...\",\n        \"A digital readout system for X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68139", "text": "{\n    \"patent_title\": \"Micro-Robotic System for Targeted Drug Delivery During Minimally Invasive Surgery\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11245678B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-05-15\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A micro-robotic system for precise drug delivery during minimally invasive surgical procedures. The system utilizes biocompatible materials and features real-time imaging capabilities for targeted therapy, promoting tissue regeneration and reducing post-operative complications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in micro-robotics\"\n        }\n    ],\n    \"claims\": [\n        \"A micro-robotic system comprising...\",\n        \"A method for targeted drug delivery...\",\n        \"A system for real-time imaging during surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68139", "text": "{\n    \"patent_title\": \"Dermal Filler Injection Device with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Wilson\",\n            \"affiliation\": \"Allergan Aesthetics\"\n        },\n        {\n            \"name\": \"Dr. Frank Green\",\n            \"affiliation\": \"Galderma\"\n        }\n    ],\n    \"patent_number\": \"US11321456B1\",\n    \"priority_date\": \"2022-02-10\",\n    \"filing_date\": \"2022-02-10\",\n    \"issue_date\": \"2023-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved dermal filler injection device designed for precise and consistent delivery of cosmetic fillers, minimizing bruising and discomfort. The device includes a feedback mechanism to control injection depth and volume.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Prior art in dermal filler devices\"\n        }\n    ],\n    \"claims\": [\n        \"A dermal filler injection device comprising...\",\n        \"A method for injecting dermal fillers...\",\n        \"A device with a feedback mechanism for controlling injection depth...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68140", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for Early Cancer Detection in MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-09-20\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel contrast agent for magnetic resonance imaging (MRI) that enhances the detection of early-stage tumors by selectively targeting biomarkers associated with cancer initiation. The agent significantly improves image clarity and reduces false positives.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on MRI contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent for MRI comprising...\",\n        \"A method for detecting early-stage cancer using said contrast agent...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68140", "text": "{\n    \"patent_title\": \"Radiation Dose Optimization System for Cancer Treatment\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-07-15\",\n    \"issue_date\": \"2023-02-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"The present invention relates to a system and method for optimizing radiation dose delivery during cancer radiation therapy. It aims to minimize damage to healthy tissue while maximizing tumor eradication.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"relevance\": \"Related art on radiation therapy planning\"\n        }\n    ],\n    \"claims\": [\n        \"A radiation dose optimization system comprising...\",\n        \"A method for delivering radiation therapy using said system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68141", "text": "{\n    \"patent_title\": \"Method for Enhancing Contrast in Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2021-11-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for improving contrast in magnetic resonance imaging (MRI) by utilizing a dynamic pulse sequence and advanced image reconstruction algorithms. This allows for clearer visualization of subtle anatomical features, improving diagnostic capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing contrast in MRI comprising...\",\n        \"An MRI system configured to implement the method...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68141", "text": "{\n    \"patent_title\": \"System and Method for Cardiac Visualization using Ultrasound\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2020-01-15\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2022-07-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for improved visualization of cardiac structures using ultrasound technology. The system utilizes advanced signal processing techniques to enhance image quality and provide real-time feedback to the operator.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        },\n        {\n            \"patent_number\": \"US9654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for visualizing cardiac structures comprising...\",\n        \"A method for processing ultrasound signals...\",\n        \"A user interface for displaying cardiac images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68142", "text": "{\n    \"patent_title\": \"High-Resolution Magnetic Resonance Imaging with Reduced Scan Time\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel magnetic resonance imaging (MRI) technique utilizing a compressed sensing algorithm to significantly reduce scan time while maintaining high image resolution. The method improves diagnostic accuracy and patient comfort.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI comprising...\",\n        \"An MRI system configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68142", "text": "{\n    \"patent_title\": \"Improved X-Ray Image Enhancement Filter\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A digital image processing filter designed to enhance the contrast and clarity of X-ray images. The filter improves the visibility of subtle anatomical features.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A digital filter for X-ray images...\",\n        \"An X-ray imaging system incorporating...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68143", "text": "{\n    \"patent_title\": \"Improved Image Enhancement Technique Using Adaptive Histogram Equalization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Adobe Systems\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents an improved image enhancement technique based on adaptive histogram equalization. The method dynamically adjusts the equalization parameters based on local image characteristics, resulting in enhanced contrast and detail while minimizing artifacts. This builds on existing histogram equalization algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image comprising...\",\n        \"The method of claim 1, wherein the adaptive parameters are determined based on...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68143", "text": "{\n    \"patent_title\": \"Novel Quantum Image Processing Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2022-11-01\",\n    \"filing_date\": \"2022-11-01\",\n    \"issue_date\": \"2024-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention introduces a completely new approach to image processing utilizing quantum computing principles. It presents a fundamentally different algorithm that bypasses traditional image processing methods, achieving significant speed and efficiency gains. This represents a disruptive innovation in the field.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A quantum image processing algorithm comprising...\",\n        \"The algorithm of claim 1, wherein the quantum state is manipulated to...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68144", "text": "{\n    \"patent_title\": \"Miniaturized Surgical Instrument with Integrated Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized surgical instrument incorporating a micro-camera and remote manipulation capabilities for minimally invasive procedures. The device aims to improve precision and reduce patient trauma during complex surgeries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Robotic Surgical System with Enhanced Dexterity\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Micro-Camera for Endoscopic Procedures\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising a miniaturized camera and a remote manipulation system.\",\n        \"The surgical instrument of claim 1, wherein the camera has a diameter of less than 3mm.\",\n        \"A method for performing a minimally invasive surgery using the surgical instrument of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68144", "text": "{\n    \"patent_title\": \"Implantable Cardiovascular Stent with Drug Delivery System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Evans\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2022-03-15\",\n    \"filing_date\": \"2022-03-15\",\n    \"issue_date\": \"2023-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable stent designed for treating cardiovascular diseases, featuring a controlled drug delivery system to prevent restenosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Expandable Stent for Arterial Repair\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Drug-Eluting Coating for Medical Implants\"\n        }\n    ],\n    \"claims\": [\n        \"A stent comprising a metallic framework and a drug-eluting coating.\",\n        \"The stent of claim 1, wherein the drug is a statin.\",\n        \"A method for treating cardiovascular disease using the stent of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68145", "text": "{\n    \"patent_title\": \"AI-Enhanced MRI for Early Alzheimer's Disease Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-09-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method for improving the accuracy of MRI scans for early detection of Alzheimer's disease using artificial intelligence algorithms. The AI analyzes subtle changes in brain structure that are often missed by human radiologists, leading to earlier and more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"MRI Image Enhancement Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for analyzing MRI scans using AI.\",\n        \"A system for detecting Alzheimer's disease.\",\n        \"A computer-readable medium storing instructions for performing the method.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68145", "text": "{\n    \"patent_title\": \"Improved X-ray Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Amelia Stone\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-11-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved X-ray imaging system with enhanced image resolution and reduced radiation exposure. The system utilizes a novel detector array and image processing techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Digital Radiography System\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system with enhanced resolution.\",\n        \"A detector array for reducing radiation exposure.\",\n        \"A method for processing X-ray images.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68146", "text": "{\n    \"patent_title\": \"Novel MRI Sequence for Enhanced Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-08-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new MRI sequence is described that utilizes a novel gradient scheme to significantly enhance the detection of small tumors. The sequence improves signal-to-noise ratio and reduces imaging time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI using a novel gradient sequence.\",\n        \"An MRI system configured to implement the novel gradient sequence.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68146", "text": "{\n    \"patent_title\": \"Improved X-ray Shielding for Dental Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Dental Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2021-05-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new shielding material for dental X-ray machines is disclosed, reducing radiation exposure to patients and operators.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A shielding material for X-ray machines.\",\n        \"A dental X-ray machine incorporating the shielding material.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68147", "text": "{\n    \"patent_title\": \"Deep Convolutional Neural Networks for Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        },\n        {\n            \"name\": \"Alex Krizhevsky\",\n            \"affiliation\": \"University of Toronto\"\n        },\n        {\n            \"name\": \"Ilya Sutskever\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"patent_number\": \"US9188754B2\",\n    \"priority_date\": \"2012-04-26\",\n    \"filing_date\": \"2012-11-26\",\n    \"issue_date\": \"2015-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep convolutional neural network architecture for image recognition. The network utilizes multiple convolutional layers and pooling layers to extract features from images, followed by fully connected layers for classification. This invention demonstrates significant improvement in image recognition accuracy and is applicable to various computer vision tasks.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7634037B2\",\n            \"title\": \"Method and apparatus for object detection in images\"\n        }\n    ],\n    \"claims\": [\n        \"A method for recognizing objects in an image comprising...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68147", "text": "{\n    \"patent_title\": \"Method for Enhancing Contrast in Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"General Hospital\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Medical Imaging Inc.\"\n        }\n    ],\n    \"patent_number\": \"US8502978B2\",\n    \"priority_date\": \"2011-05-10\",\n    \"filing_date\": \"2011-11-10\",\n    \"issue_date\": \"2013-08-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for improving the contrast of medical images, utilizing histogram equalization and adaptive filtering techniques. This invention allows for better visualization of subtle features in medical images, aiding in diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7236533B2\",\n            \"title\": \"Method for contrast enhancement in digital images\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing contrast in a medical image comprising...\",\n        \"An apparatus for processing medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68148", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical Instrument with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2022-05-15\",\n    \"filing_date\": \"2022-06-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical instrument for minimally invasive procedures, incorporating a high-resolution imaging system and improved ergonomic design for enhanced precision and control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising...\",\n        \"The instrument of claim 1, further comprising...\",\n        \"A method for performing a surgical procedure...\",\n        \"The method of claim 3, wherein...\",\n        \"An imaging system integrated with...\",\n        \"The imaging system of claim 5, wherein...\",\n        \"A handle configured for ergonomic...\",\n        \"The handle of claim 7, comprising...\",\n        \"A control mechanism for adjusting...\",\n        \"The control mechanism of claim 9, wherein...\",\n        \"A sterilization process for the instrument.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68148", "text": "{\n    \"patent_title\": \"Orthopedic Implant Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2023-03-01\",\n    \"filing_date\": \"2023-04-15\",\n    \"issue_date\": \"2024-02-20\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"An improved design for orthopedic implants, focusing on biocompatibility and long-term stability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"An orthopedic implant comprising...\",\n        \"The implant of claim 1, further comprising...\",\n        \"A method for implanting the device...\",\n        \"The method of claim 3, wherein...\",\n        \"A biocompatible coating for the implant.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68149", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for reconstructing medical images from projection data using a deep learning algorithm to improve image quality and reduce noise. The method is particularly suited for low-dose CT scanning.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for implementing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68149", "text": "{\n    \"patent_title\": \"Dermal Filler Injection System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Aesthetic Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2017-09-22\",\n    \"filing_date\": \"2017-09-22\",\n    \"issue_date\": \"2021-05-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An injection system for dermal fillers providing enhanced visualization during the injection process for improved cosmetic results. Features a needle guide and integrated illumination.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"An injection system for dermal fillers comprising...\",\n        \"A needle guide for use with the injection system of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68150", "text": "{\n    \"patent_title\": \"Controlled Release Formulation for Diabetes Management\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-05-20\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel oral drug delivery system utilizing biodegradable polymers to achieve sustained release of metformin for improved glycemic control in patients with type 2 diabetes. The formulation enhances drug bioavailability and reduces side effects, representing a significant advancement in diabetes management with substantial commercial potential due to its ease of administration and improved patient compliance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Polymer-Based Drug Delivery Systems\"\n        }\n    ],\n    \"claims\": [\n        \"A pharmaceutical composition comprising...\",\n        \"A method for treating diabetes...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68150", "text": "{\n    \"patent_title\": \"Targeted Nanoparticle Delivery for Cancer Therapy\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-07-01\",\n    \"filing_date\": \"2021-01-15\",\n    \"issue_date\": \"2023-05-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a targeted drug delivery system using nanoparticles to selectively deliver chemotherapeutic agents to cancer cells, minimizing side effects and maximizing therapeutic efficacy. The nanoparticles are surface-modified with antibodies that specifically bind to tumor-associated antigens.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Antibody-Drug Conjugates for Cancer Treatment\"\n        }\n    ],\n    \"claims\": [\n        \"A nanoparticle comprising...\",\n        \"A method for treating cancer...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68151", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"EP3876543B1\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-05-15\",\n    \"issue_date\": \"2022-09-07\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"A novel method for reconstructing medical images from raw data, utilizing deep learning techniques to improve resolution and reduce artifacts, leading to enhanced diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"count\": 62\n        },\n        {\n            \"patent_number\": \"WO2018123456A1\",\n            \"count\": 55\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for performing medical image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68151", "text": "{\n    \"patent_title\": \"Medical Device for Image Guided Surgery\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MedTech Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-02-10\",\n    \"filing_date\": \"2021-02-10\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical device incorporating real-time medical imaging for enhanced precision during minimally invasive procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"count\": 30\n        },\n        {\n            \"patent_number\": \"EP3123456B1\",\n            \"count\": 25\n        }\n    ],\n    \"claims\": [\n        \"A medical device comprising an imaging module...\",\n        \"A system for guiding surgical instruments...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68152", "text": "{\n    \"patent_title\": \"Novel MRI Contrast Agent for Enhanced Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel MRI contrast agent utilizing nanoparticles for improved detection of small tumors, offering enhanced diagnostic capabilities and potential for early cancer diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A composition comprising nanoparticles...\",\n        \"A method for detecting tumors...\",\n        \"An MRI contrast agent...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68152", "text": "{\n    \"patent_title\": \"Improved Formulation for Anti-Aging Facial Cream\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Procter & Gamble\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2016-01-01\",\n    \"filing_date\": \"2017-02-10\",\n    \"issue_date\": \"2019-08-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new formulation for a facial cream designed to reduce wrinkles and improve skin tone, utilizing a novel peptide complex.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A topical composition comprising a peptide complex...\",\n        \"A method for reducing wrinkles...\",\n        \"A facial cream...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68153", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2020-06-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel minimally invasive surgical system utilizing advanced imaging techniques to provide surgeons with enhanced visualization during complex procedures. The system aims to improve surgical precision and reduce patient recovery times, ultimately leading to better patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in minimally invasive surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising an endoscope with integrated optical coherence tomography.\",\n        \"A method for performing a minimally invasive biopsy using the surgical system.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68153", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10543210B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new catheter design for improved drug delivery to target tissues. The catheter features a modified tip geometry to enhance flow characteristics and reduce the risk of occlusion.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8987654B2\",\n            \"relevance\": \"Related to catheter design.\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible shaft and a distal tip with a conical shape.\",\n        \"A method for delivering a therapeutic agent using the catheter.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68154", "text": "{\n    \"patent_title\": \"Method and System for Low-Dose CT Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for reconstructing CT images from low-dose radiation data using iterative reconstruction algorithms. The method improves image quality while minimizing patient radiation exposure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760754B2\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        },\n        {\n            \"patent_number\": \"US9567890B2\"\n        },\n        {\n            \"patent_number\": \"US10012345B2\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a CT image...\",\n        \"The method of claim 1, wherein the radiation dose is reduced by at least 30%...\",\n        \"The method of claim 1, further comprising a noise reduction step...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68154", "text": "{\n    \"patent_title\": \"Improved MRI Imaging with Gadolinium Contrast\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11223344B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for enhancing MRI image contrast using gadolinium-based contrast agents. The method improves visualization of soft tissues and abnormalities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        },\n        {\n            \"patent_number\": \"US8987654B2\"\n        },\n        {\n            \"patent_number\": \"US9234567B2\"\n        },\n        {\n            \"patent_number\": \"US9456789B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI image contrast...\",\n        \"The method of claim 1, wherein the contrast agent is gadolinium-based...\",\n        \"The method of claim 1, further comprising a pre-scan calibration step...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68155", "text": "{\n    \"patent_title\": \"Ultrasound Image Enhancement Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-01-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for enhancing the clarity of ultrasound images using a convolutional neural network. This invention improves diagnostic accuracy by reducing noise and artifacts in ultrasound scans.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Noise Reduction in Medical Images\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing ultrasound images comprising...\",\n        \"A system for processing ultrasound data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68155", "text": "{\n    \"patent_title\": \"Improved X-Ray Image Processing Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-08-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved method for processing X-ray images to enhance contrast and reduce radiation exposure. This invention focuses on optimizing X-ray imaging parameters for improved diagnostic quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\",\n            \"title\": \"Digital X-Ray Image Enhancement\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing X-ray images comprising...\",\n        \"An X-ray imaging system configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68156", "text": "{\n    \"patent_title\": \"Enhanced Battery Management System for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"MIT Lincoln Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2022-01-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system for mobile devices comprising a dynamic voltage scaling module and a predictive power consumption algorithm to extend battery life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for a portable electronic device comprising...\",\n        \"A method for dynamically adjusting voltage scaling based on predicted power consumption...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68156", "text": "{\n    \"patent_title\": \"Improved Fuel Cell Technology for Automotive Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"Toyota Motor Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-03-10\",\n    \"filing_date\": \"2018-03-10\",\n    \"issue_date\": \"2021-07-13\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel fuel cell stack design utilizing a new membrane material to increase efficiency and reduce cost for automotive applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A fuel cell stack comprising a novel membrane...\",\n        \"A method for manufacturing a fuel cell stack...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68157", "text": "{\n    \"patent_title\": \"Miniature Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2022-05-15\",\n    \"filing_date\": \"2022-05-15\",\n    \"issue_date\": \"2023-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable biosensor for continuous glucose monitoring, utilizing a novel enzymatic reaction and microfluidic channel design for improved accuracy and biocompatibility. This device represents a significant advancement in diabetes management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art related to glucose sensors\"\n        }\n    ],\n    \"claims\": [\n        \"A biosensor comprising...\",\n        \"A method for continuous glucose monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68157", "text": "{\n    \"patent_title\": \"Surgical Robotic System with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Foster\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Green\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Dr. Sarah Hall\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Michael Ito\",\n            \"affiliation\": \"University of Washington\"\n        },\n        {\n            \"name\": \"Dr. Olivia Jones\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. William King\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-11-01\",\n    \"filing_date\": \"2021-11-01\",\n    \"issue_date\": \"2024-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A robotic surgical system designed to enhance precision and dexterity during complex procedures. The system incorporates advanced haptic feedback and image-guided navigation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art on surgical robotics\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic system comprising...\",\n        \"A method for performing surgery using a robotic system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68158", "text": "{\n    \"patent_title\": \"AI-Powered Image Reconstruction for Enhanced MRI Scans\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for reconstructing MRI images using deep learning algorithms. The system utilizes a generative adversarial network (GAN) to enhance image resolution and reduce scan time, resulting in significantly improved diagnostic accuracy. This represents a groundbreaking advancement in medical imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Prior Art MRI Reconstruction Technique\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"GAN-based Image Enhancement\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images using a GAN.\",\n        \"A system for reducing MRI scan time.\",\n        \"An MRI system with enhanced image resolution.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68158", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for X-ray Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"Small Biotech Company\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2018-11-01\",\n    \"issue_date\": \"2022-07-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new contrast agent for X-ray imaging that provides increased image clarity. The agent is based on a novel nanoparticle formulation and offers improved biocompatibility.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Existing X-ray Contrast Agent\"\n        },\n        {\n            \"patent_number\": \"US9654321B2\",\n            \"title\": \"Nanoparticle Formulation for Imaging\"\n        },\n        {\n            \"patent_number\": \"US9543210B2\",\n            \"title\": \"Another X-Ray Contrast Agent\"\n        },\n        {\n            \"patent_number\": \"US9432109B2\",\n            \"title\": \"Related Nanoparticle work\"\n        },\n        {\n            \"patent_number\": \"US9321098B2\",\n            \"title\": \"Previous Contrast Agent\"\n        },\n        {\n            \"patent_number\": \"US9210987B2\",\n            \"title\": \"Another Nanoparticle paper\"\n        },\n        {\n            \"patent_number\": \"US9109876B2\",\n            \"title\": \"Some contrast agent literature\"\n        },\n        {\n            \"patent_number\": \"US9098765B2\",\n            \"title\": \"Imaging tech\"\n        },\n        {\n            \"patent_number\": \"US8987654B2\",\n            \"title\": \"Contrast media\"\n        },\n        {\n            \"patent_number\": \"US8876543B2\",\n            \"title\": \"Xray contrast\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Another X-ray contrast agent\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent for X-ray imaging comprising a novel nanoparticle formulation.\",\n        \"A method for enhancing X-ray image clarity using the contrast agent.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68159", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization and Robotic Control\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical system incorporating advanced imaging modalities and robotic precision for minimally invasive procedures. This system aims to improve surgical outcomes and reduce patient recovery times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising a robotic arm...\",\n        \"An imaging module configured to provide real-time visualization...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68159", "text": "{\n    \"patent_title\": \"Improved Bandage Application Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Johnson & Johnson\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-02-10\",\n    \"filing_date\": \"2021-04-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A device for applying bandages with greater ease and precision, designed for home use. Offers a more comfortable and secure bandage application.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A bandage applicator comprising a handle...\",\n        \"A roller mechanism for smoothly applying the bandage...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68160", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Sensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-06-15\",\n    \"issue_date\": \"2023-03-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable sensor for continuous glucose monitoring, providing real-time data transmission to a patient's mobile device.  Improves glycemic control and reduces the need for finger-prick testing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art related to implantable sensors.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for continuously monitoring glucose levels in a patient.\",\n        \"An implantable sensor for glucose monitoring.\",\n        \"A system for transmitting glucose data to a mobile device.\",\n        \"A device comprising a glucose sensor and a wireless transmitter.\",\n        \"A method for calibrating the glucose sensor.\",\n        \"A method for alarming the patient based on glucose levels.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68160", "text": "{\n    \"patent_title\": \"Surgical Instrument Sterilization System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Acme Medical Solutions\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-12-01\",\n    \"issue_date\": \"2022-07-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel sterilization system for surgical instruments utilizing plasma technology.  Provides rapid and complete sterilization.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous sterilization methods.\"\n        }\n    ],\n    \"claims\": [\n        \"A sterilization system comprising a plasma generator.\",\n        \"A method for sterilizing surgical instruments.\",\n        \"A chamber for containing surgical instruments during sterilization.\",\n        \"A control system for regulating plasma parameters.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68161", "text": "{\n    \"patent_title\": \"Low-Dose Computed Tomography Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2017-05-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing computed tomography images from low-dose data using a deep learning framework, significantly reducing patient radiation exposure while maintaining diagnostic image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relation\": \"Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a CT image...\",\n        \"A system comprising a CT scanner and a deep learning module...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68161", "text": "{\n    \"patent_title\": \"Enhanced Contrast Agent for Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-03-10\",\n    \"filing_date\": \"2018-03-10\",\n    \"issue_date\": \"2024-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new contrast agent designed to improve the visibility of specific tissues during MRI scans, providing greater diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relation\": \"Related\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"A method for using the contrast agent in MRI...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68162", "text": "{\n    \"patent_title\": \"Improved Medical Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel deep learning architecture for reconstructing medical images from raw data, resulting in improved image clarity and reduced noise. It has potential applications in various diagnostic imaging modalities, improving the accuracy of disease detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising:...\",\n        \"A system for performing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68162", "text": "{\n    \"patent_title\": \"Enhanced MRI Contrast Agents\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"EP3456789A1\",\n    \"priority_date\": \"2017-07-20\",\n    \"filing_date\": \"2017-07-20\",\n    \"issue_date\": \"2018-11-08\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"This invention relates to novel contrast agents for Magnetic Resonance Imaging (MRI) that enhance image contrast and improve visualization of specific tissues. The contrast agents are based on nanoparticles with improved biocompatibility.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent for MRI comprising:...\",\n        \"A method of using the contrast agent of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68163", "text": "{\n    \"patent_title\": \"Enhanced Image Recognition System for Surveillance Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an enhanced image recognition system designed for real-time surveillance applications. The system utilizes a novel convolutional neural network architecture combined with a robust feature extraction technique to achieve high accuracy in identifying objects and individuals in complex environments. The system incorporates anomaly detection algorithms to flag suspicious activity, significantly improving the effectiveness of security monitoring. The method is robust to varying lighting conditions, occlusions, and camera angles. It is particularly applicable to security systems used in public spaces, transportation hubs, and critical infrastructure. The system allows for facial recognition, object detection and behavioral analysis. This invention represents a significant advancement in the field of computer vision and has broad commercial potential.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for real-time image recognition comprising...\",\n        \"A method for detecting anomalies in video streams...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68163", "text": "{\n    \"patent_title\": \"Method for Automated Plant Species Identification\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"AgriTech Innovations\"\n        }\n    ],\n    \"patent_number\": \"US11890123B2\",\n    \"priority_date\": \"2022-01-15\",\n    \"filing_date\": \"2022-01-15\",\n    \"issue_date\": \"2023-10-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for identifying plant species using image analysis. It uses color and shape features to classify plants. The system is intended for agricultural applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for identifying plant species based on image features...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68164", "text": "{\n    \"patent_title\": \"Improved Contrast Enhancement for Magnetic Resonance Angiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2016-11-20\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method for enhancing contrast in magnetic resonance angiography (MRA) images, improving the visualization of blood vessels and aiding in the diagnosis of vascular diseases. The method utilizes a novel image processing algorithm to reduce noise and amplify subtle contrast differences.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing contrast in MRA images comprising...\",\n        \"An image processing system configured to...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68164", "text": "{\n    \"patent_title\": \"Method for Improving X-ray Image Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Kenji Tanaka\",\n            \"affiliation\": \"Toshiba Medical Systems\"\n        },\n        {\n            \"name\": \"Hiroshi Sato\",\n            \"affiliation\": \"University of Tokyo\"\n        }\n    ],\n    \"patent_number\": \"JP2016123456A\",\n    \"priority_date\": \"2016-03-10\",\n    \"filing_date\": \"2016-09-01\",\n    \"issue_date\": \"2017-12-15\",\n    \"patent_office\": \"JPO\",\n    \"abstract\": \"This invention relates to a method for improving the quality of X-ray images by reducing artifacts and enhancing detail. It is particularly useful in dental radiography.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray image processing method...\",\n        \"A system for processing X-ray images...\",\n        \"A computer program product...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68165", "text": "{\n    \"patent_title\": \"Magnetic Resonance Imaging Enhancement for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Jian Li\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method for enhancing magnetic resonance imaging (MRI) to improve the detection of early-stage cancerous tumors. The method employs a unique pulse sequence and image reconstruction algorithm resulting in significantly increased diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8562349B2\",\n            \"relevance\": \"Prior art on MRI pulse sequences.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI images comprising...\",\n        \"An MRI system configured to implement the method...\",\n        \"A computer-readable medium storing instructions for...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68165", "text": "{\n    \"patent_title\": \"Improved X-Ray Image Processing Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Chen\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-08-10\",\n    \"filing_date\": \"2017-08-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved method for processing X-ray images to enhance contrast and reduce noise. The technique is applicable to various X-ray imaging modalities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7981023B2\",\n            \"relevance\": \"Related art in X-ray image enhancement.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing X-ray images comprising...\",\n        \"A system for implementing the image processing method...\",\n        \"A computer program for performing the image processing...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68166", "text": "{\n    \"patent_title\": \"AI-Powered Diagnostic System for Early Detection of Lung Nodules\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system utilizing deep learning algorithms for the automated detection and classification of lung nodules in CT scans. The system provides diagnostic assistance to radiologists, improving accuracy and reducing false negatives.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting lung nodules in CT scans using a convolutional neural network.\",\n        \"A system for providing diagnostic assistance to radiologists.\",\n        \"A method for classifying lung nodules based on size and shape.\",\n        \"A method for reducing false negatives in lung nodule detection.\",\n        \"A computer-readable medium storing instructions for performing the aforementioned methods.\",\n        \"A method for image reconstruction based on AI algorithms\",\n        \"A system for image enhancement with deep learning models\"\n    ]\n}"}
{"_id": "Academic--patents--n--68166", "text": "{\n    \"patent_title\": \"Method for Optimizing Image Compression in Medical Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Li Wei\",\n            \"affiliation\": \"Huazhong University of Science and Technology\"\n        }\n    ],\n    \"patent_number\": \"CN111111111A\",\n    \"priority_date\": \"2019-05-20\",\n    \"filing_date\": \"2019-05-20\",\n    \"issue_date\": \"2020-01-10\",\n    \"patent_office\": \"SIPO\",\n    \"abstract\": \"This invention discloses a method for optimizing image compression algorithms in medical imaging devices, reducing storage space and transmission bandwidth. The method utilizes wavelet transforms and adaptive quantization.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for compressing medical images using wavelet transforms.\",\n        \"A system for reducing storage space for medical images.\",\n        \"A method for adaptive quantization of image data.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68167", "text": "{\n    \"patent_title\": \"Remote Patient Monitoring System with Minimally Invasive Sensor\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MedTech Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a remotely monitored medical device utilizing a minimally invasive sensor for continuous glucose monitoring. The system enhances patient compliance through real-time data feedback and alerts, improving diabetes management. The sensor is designed for long-term implantation with minimal patient discomfort.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A remote patient monitoring system comprising a minimally invasive sensor...\",\n        \"A method for improving patient compliance using real-time data feedback...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68167", "text": "{\n    \"patent_title\": \"Surgical Instrument with Enhanced Grip\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Instruments Corp.\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2014-12-01\",\n    \"filing_date\": \"2014-12-01\",\n    \"issue_date\": \"2018-04-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a surgical instrument featuring an improved ergonomic grip design. The handle provides increased control and reduces hand fatigue during long surgical procedures. It is designed for standard surgical applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US4562456\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising an ergonomic grip...\",\n        \"The surgical instrument of claim 1, wherein the grip is made of...\",\n        \"A method for improving surgeon control using an ergonomic grip...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68168", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical system designed for minimally invasive procedures. The system incorporates ergonomic handles and intuitive controls to reduce surgeon fatigue and enhance precision, ultimately improving patient comfort and recovery time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Existing Minimally Invasive Surgical Tool\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising an ergonomic handle...\",\n        \"A method for performing a minimally invasive surgery using the instrument...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68168", "text": "{\n    \"patent_title\": \"Advanced Cardiac Monitoring Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"Philips Healthcare\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Philips Healthcare\"\n        }\n    ],\n    \"patent_number\": \"EP3456789B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2022-06-01\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"A sophisticated device for continuous cardiac monitoring, providing real-time data transmission to healthcare professionals. It features advanced algorithms for detecting arrhythmias and alerting medical staff.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Prior Art Cardiac Monitor\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiac monitoring device capable of detecting atrial fibrillation...\",\n        \"A system for transmitting cardiac data to a remote monitoring station...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68169", "text": "{\n    \"patent_title\": \"Implantable Cardiac Monitor with Wireless Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-10-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac monitor provides continuous ECG monitoring and wirelessly transmits data to a remote receiver, improving early detection of arrhythmias and reducing hospital visits. This addresses the unmet need for convenient and reliable long-term cardiac monitoring.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in wireless data transmission\"\n        }\n    ],\n    \"claims\": [\n        \"A method for continuously monitoring cardiac activity...\",\n        \"An implantable device comprising a sensor...\",\n        \"A wireless communication system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68169", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Independent Inventor\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2022-05-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical stapler with a redesigned handle and improved jaw alignment. This enhances surgeon comfort and precision during minimally invasive procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art in surgical stapler design\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising a handle...\",\n        \"A stapler head with improved jaw alignment...\",\n        \"A method of using the stapler...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68170", "text": "{\n    \"patent_title\": \"High-Resolution Magnetic Resonance Imaging with Novel Contrast Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2023-08-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for high-resolution magnetic resonance imaging (MRI) utilizing a new class of contrast agents to enhance image clarity and diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Contrast Agents for Enhanced MRI\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating MRI images with a resolution of at least 1 micrometer.\",\n        \"A contrast agent comprising a biocompatible nanoparticle encapsulating a paramagnetic ion.\",\n        \"An MRI system configured to implement the method of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68170", "text": "{\n    \"patent_title\": \"Improved CT Scanner Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Carl Schmidt\",\n            \"affiliation\": \"Siemens Healthineers\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Siemens AG\"\n        }\n    ],\n    \"patent_number\": \"EP11223344B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-20\",\n    \"issue_date\": \"2022-05-18\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"An improved computed tomography (CT) scanner design focusing on reducing radiation exposure and scan time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Radiation Dose Reduction Techniques in CT Scanning\"\n        }\n    ],\n    \"claims\": [\n        \"A CT scanner comprising a low-dose radiation source.\",\n        \"A method for reducing radiation exposure during CT scanning.\",\n        \"A CT imaging system including automated image reconstruction algorithms.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68171", "text": "{\n    \"patent_title\": \"Wireless Physiological Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2019-03-20\",\n    \"issue_date\": \"2021-11-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless system for continuous monitoring of vital signs, enabling remote patient care and early detection of health anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor for measuring heart rate.\",\n        \"A communication module for transmitting data to a remote server.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68171", "text": "{\n    \"patent_title\": \"Novel Cosmetic Mirror with Integrated Lighting\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-12-01\",\n    \"filing_date\": \"2018-08-10\",\n    \"issue_date\": \"2020-06-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A cosmetic mirror featuring adjustable LED lighting for enhanced makeup application.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A mirror with adjustable LED brightness.\",\n        \"A magnifying feature for detailed makeup application.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68172", "text": "{\n    \"patent_title\": \"Non-Invasive Glucose Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive glucose monitoring system utilizing optical sensors for continuous glucose level tracking. The device aims to improve patient compliance and reduce the need for frequent blood samples, leading to better diabetes management and improved patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for non-invasively monitoring glucose levels.\",\n        \"An optical sensor for glucose detection.\",\n        \"A system for continuous glucose monitoring.\",\n        \"A device for improved diabetes management.\",\n        \"A data processing unit for analyzing glucose levels.\",\n        \"A user interface for displaying glucose data.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68172", "text": "{\n    \"patent_title\": \"Surgical Robotic Arm with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2022-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical robotic arm with enhanced precision and dexterity for minimally invasive surgical procedures. The system incorporates advanced control algorithms and haptic feedback to improve surgical accuracy and reduce patient trauma.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic arm with enhanced precision.\",\n        \"A control system for robotic surgery.\",\n        \"A haptic feedback system for surgical applications.\",\n        \"A method for performing minimally invasive surgery.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68173", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging Technique for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10543217B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-01-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel magnetic resonance imaging (MRI) technique for enhanced detection of early-stage cancerous tumors. The technique utilizes a unique pulse sequence and image reconstruction algorithm to improve contrast and resolution, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"MRI Contrast Agent\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI comprising...\",\n        \"An MRI apparatus comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68173", "text": "{\n    \"patent_title\": \"Cosmetic Skin Treatment Using Focused Ultrasound\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Sarah Johnson\",\n            \"affiliation\": \"Private Dermatology Clinic\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2021-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for non-invasive skin tightening and wrinkle reduction using focused ultrasound energy. The device delivers precisely controlled energy to the dermis, stimulating collagen production and improving skin elasticity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Ultrasound Device\"\n        }\n    ],\n    \"claims\": [\n        \"A method for cosmetic skin treatment...\",\n        \"An ultrasound apparatus for cosmetic use...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68174", "text": "{\n    \"patent_title\": \"Implantable Cardiac Rhythm Management System with Adaptive Pacing\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-11-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-12-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac rhythm management system with adaptive pacing algorithms designed to optimize cardiac output and improve patient quality of life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in pacing algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"A method for adaptively pacing a heart...\",\n        \"An implantable device comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68174", "text": "{\n    \"patent_title\": \"Automated Blood Cell Counter for Rapid Diagnosis\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Chen\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-09-10\",\n    \"filing_date\": \"2019-03-05\",\n    \"issue_date\": \"2020-08-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated blood cell counter providing rapid and accurate diagnostic information for various blood disorders.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous generation blood cell counters\"\n        }\n    ],\n    \"claims\": [\n        \"A blood cell counter comprising...\",\n        \"A method for determining blood cell counts...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68175", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Magnetic Resonance Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for reconstructing magnetic resonance images using a deep learning algorithm to reduce noise and enhance image clarity, improving diagnostic accuracy for detecting subtle anomalies. The method leverages a generative adversarial network (GAN) trained on a large dataset of MRI scans.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Prior Art MRI Reconstruction Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising: applying a deep learning algorithm to reduce noise in the raw MRI data.\",\n        \"The method of claim 1, wherein the deep learning algorithm is a generative adversarial network.\",\n        \"The method of claim 1, further comprising a step of contrast enhancement.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68175", "text": "{\n    \"patent_title\": \"Improved X-Ray Imaging System with Digital Subtraction Angiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9234567B1\",\n    \"priority_date\": \"2014-12-20\",\n    \"filing_date\": \"2015-01-10\",\n    \"issue_date\": \"2016-05-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new digital subtraction angiography system using X-ray imaging for visualizing blood vessels. This invention improves image quality by subtracting bone structures from the image, providing a clearer view of the vasculature.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"title\": \"Conventional X-Ray DSA System\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising: a digital subtraction angiography module for removing bone structures from the image.\",\n        \"The system of claim 1, further comprising a contrast agent injection module.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68176", "text": "{\n    \"patent_title\": \"Bioabsorbable Stent with Enhanced Endothelialization\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2018-12-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A bioabsorbable stent designed for improved biocompatibility and endothelialization, offering a minimally invasive solution for coronary artery disease. The stent is constructed from a novel polymer blend that degrades at a controlled rate, promoting natural healing and reducing the risk of restenosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A bioabsorbable stent comprising a polymer blend...\",\n        \"A method for treating coronary artery disease using the bioabsorbable stent...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68176", "text": "{\n    \"patent_title\": \"Surgical Instrument for Bone Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-01-15\",\n    \"filing_date\": \"2017-01-15\",\n    \"issue_date\": \"2021-03-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical instrument designed for precise bone reconstruction in orthopedic procedures. The instrument utilizes advanced robotic control for increased accuracy and stability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US4567890\",\n            \"kind\": \"Cited by examiner\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising a robotic control system...\",\n        \"A method for performing bone reconstruction using the surgical instrument...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68177", "text": "{\n    \"patent_title\": \"Magnetic Resonance Imaging with Artificial Intelligence Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2022-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel MRI technique utilizing deep learning algorithms to enhance image resolution and detect subtle anomalies, improving diagnostic accuracy for early-stage cancer detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI images using deep learning.\",\n        \"A system for detecting anomalies in MRI images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68177", "text": "{\n    \"patent_title\": \"Improved X-Ray Imaging System with Reduced Radiation Dose\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An X-ray imaging system incorporating a novel filter to reduce radiation exposure while maintaining image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system with reduced radiation.\",\n        \"A filter for reducing radiation exposure.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68178", "text": "{\n    \"patent_title\": \"Novel MRI Contrast Agent for Early-Stage Breast Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel MRI contrast agent that enhances the detection of early-stage breast cancer by targeting specific biomarkers. The contrast agent exhibits improved sensitivity and specificity compared to existing agents.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on MRI contrast agents.\"\n        }\n    ],\n    \"claims\": [\n        \"A composition comprising a gadolinium-based contrast agent modified with a targeting ligand specific to a breast cancer biomarker.\",\n        \"A method for detecting early-stage breast cancer using the aforementioned composition.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68178", "text": "{\n    \"patent_title\": \"Improved X-ray Tube for General Radiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Mr. Robert Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-12-01\",\n    \"filing_date\": \"2019-12-20\",\n    \"issue_date\": \"2021-08-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved design for X-ray tubes used in general radiography, resulting in higher image quality and reduced radiation dose. The new design incorporates a novel anode material and cooling system.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art on X-ray tube technology.\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube comprising an anode made of a tungsten-rhenium alloy.\",\n        \"A radiography system incorporating the aforementioned X-ray tube.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68179", "text": "{\n    \"patent_title\": \"Miniature Implantable Cardiac Monitor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MedTech Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-05-20\",\n    \"issue_date\": \"2021-11-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel miniature implantable cardiac monitor provides continuous ECG monitoring with wireless data transmission to a remote server.  The device incorporates advanced signal processing algorithms for accurate arrhythmia detection and utilizes a low-power communication protocol for extended battery life. The technology represents a significant advancement in remote cardiac care, offering improved patient monitoring and reduced healthcare costs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"date\": \"2018-12-10\"\n        },\n        {\n            \"patent_number\": \"US10456789B2\",\n            \"date\": \"2020-02-18\"\n        }\n    ],\n    \"claims\": [\n        \"A miniature implantable cardiac monitor comprising...\",\n        \"A wireless communication module for transmitting ECG data...\",\n        \"A signal processing algorithm for arrhythmia detection...\",\n        \"A low-power communication protocol...\",\n        \"A method for remotely monitoring cardiac function...\",\n        \"A system for alerting medical personnel to detected arrhythmias...\",\n        \"A housing dimensioned for subcutaneous implantation...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68179", "text": "{\n    \"patent_title\": \"Improved Stethoscope Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"General Hospital\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2017-08-01\",\n    \"filing_date\": \"2017-10-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved stethoscope design incorporating noise cancellation and enhanced acoustics for clearer auscultation.  The device uses standard materials and manufacturing techniques but provides a slightly better audio experience for medical practitioners.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6000123B1\",\n            \"date\": \"2000-01-04\"\n        },\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"date\": \"2002-05-14\"\n        }\n    ],\n    \"claims\": [\n        \"A stethoscope comprising...\",\n        \"A chest piece with enhanced acoustics...\",\n        \"A noise cancellation mechanism...\",\n        \"A tubing for transmitting sound...\",\n        \"An earpiece for auditory reception...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68180", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Medtronic Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a minimally invasive surgical system comprising a robotic arm with high-precision actuators and an integrated enhanced visualization module. The system aims to provide surgeons with improved control and real-time feedback, potentially leading to reduced patient trauma and faster recovery times. Clinical trials show significantly improved surgical accuracy and reduced complications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A minimally invasive surgical system comprising...\",\n        \"A method for performing surgery using the system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68180", "text": "{\n    \"patent_title\": \"Novel In Vitro Diagnostic Assay for Biomarker Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Roche Diagnostics\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-05\",\n    \"issue_date\": \"2023-06-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel in vitro diagnostic assay for the detection of a specific biomarker associated with cancer. The assay utilizes a microfluidic platform and a highly sensitive detection method. This allows for early and accurate diagnosis, improving patient outcomes. The test is performed on blood samples.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"Previous diagnostic assays\"\n        }\n    ],\n    \"claims\": [\n        \"An in vitro diagnostic assay comprising...\",\n        \"A method for detecting a biomarker...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68181", "text": "{\n    \"patent_title\": \"Implantable Bioelectronic Device for Targeted Nerve Stimulation\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Jian Li\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11876543B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-05-14\",\n    \"issue_date\": \"2023-12-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable bioelectronic device providing targeted nerve stimulation for chronic pain management. The device utilizes biocompatible materials and a novel electrode configuration to enhance therapeutic efficacy and minimize side effects. Addresses a significant unmet clinical need in pain management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on neural stimulation techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"A bioelectronic device comprising...\",\n        \"A method for treating chronic pain using...\",\n        \"A system for delivering targeted nerve stimulation...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68181", "text": "{\n    \"patent_title\": \"Machine Learning Algorithm for Predicting Drug Response\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Chen\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2022-03-10\",\n    \"filing_date\": \"2022-03-09\",\n    \"issue_date\": \"2024-01-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A machine learning algorithm for predicting drug response in cancer patients based on genomic data.  The algorithm utilizes deep neural networks to identify biomarkers associated with treatment efficacy. Focuses on computational prediction.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10234567B2\",\n            \"relevance\": \"Related work on genomic biomarkers.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for predicting drug response comprising...\",\n        \"A computer-implemented system for...\",\n        \"A non-transitory computer-readable medium...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68182", "text": "{\n    \"patent_title\": \"Improved Regenerative Braking System for Hybrid Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"MIT Lincoln Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A regenerative braking system for hybrid electric vehicles that optimizes energy capture during deceleration, improving overall fuel efficiency.  The system utilizes a novel control strategy to minimize energy loss.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A regenerative braking system for a hybrid electric vehicle comprising...\",\n        \"A control method for maximizing energy recovery during braking...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68182", "text": "{\n    \"patent_title\": \"Advanced Predictive Cruise Control Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"Tesla, Inc.\"\n        },\n        {\n            \"name\": \"Emily Chen\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2020-07-22\",\n    \"filing_date\": \"2020-07-22\",\n    \"issue_date\": \"2023-03-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A predictive cruise control system utilizing deep learning algorithms to anticipate traffic conditions and optimize vehicle speed for improved fuel efficiency and driver comfort. This system analyzes vast datasets of real-time traffic data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10543210B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A predictive cruise control system comprising a deep neural network...\",\n        \"A method for analyzing traffic data and adjusting vehicle speed using machine learning...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68183", "text": "{\n    \"patent_title\": \"Miniaturized Robotic System for Transcatheter Cardiac Ablation\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"California Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-05-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized robotic system for precise and minimally invasive transcatheter cardiac ablation. The system incorporates novel micro-actuators and a high-resolution imaging modality to enable accurate targeting of cardiac tissue. Potential application in treating atrial fibrillation and other cardiac arrhythmias.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic system for cardiac ablation comprising...\",\n        \"A method for performing transcatheter ablation using the robotic system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68183", "text": "{\n    \"patent_title\": \"Surgical Stapler with Enhanced Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2022-03-10\",\n    \"filing_date\": \"2022-03-10\",\n    \"issue_date\": \"2024-02-12\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"An improved surgical stapler designed for open surgical procedures. The stapler features an enhanced ergonomic handle and a redesigned cartridge for improved tissue apposition. The design aims to minimize surgeon fatigue and improve surgical precision.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an ergonomic handle...\",\n        \"A cartridge for use in a surgical stapler...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68184", "text": "{\n    \"patent_title\": \"AI-Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-10-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention utilizes artificial intelligence and deep learning techniques to enhance the quality and speed of medical image reconstruction, particularly in MRI and CT scans. It reduces noise and artifacts, leading to improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        },\n        {\n            \"patent_number\": \"US11111111B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"A system comprising a processor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68184", "text": "{\n    \"patent_title\": \"Improved X-Ray Image Detection System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a more effective method for detecting anomalies in X-ray images, utilizing improved signal processing algorithms. It enhances contrast and sharpness, aiding radiologists in diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        },\n        {\n            \"patent_number\": \"US87654320B1\"\n        },\n        {\n            \"patent_number\": \"US98765431B2\"\n        },\n        {\n            \"patent_number\": \"US10123457B2\"\n        },\n        {\n            \"patent_number\": \"US11111112B2\"\n        },\n        {\n            \"patent_number\": \"US12121212B2\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray image detection system...\",\n        \"A method for enhancing X-ray contrast...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68185", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction Method for Positron Emission Tomography\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, San Francisco\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-09-20\",\n    \"issue_date\": \"2020-12-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel image reconstruction method for positron emission tomography (PET) that improves image quality and reduces scan time. The method utilizes a machine learning algorithm to enhance the accuracy of image reconstruction.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"inventor\": \"Franz Bauer\",\n            \"organization\": \"Siemens Medical Solutions\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for reconstructing an image from PET data...\",\n        \"2. The method of claim 1, wherein the machine learning algorithm is a convolutional neural network...\",\n        \"3. The method of claim 1, further comprising a noise reduction step...\",\n        \"4. An apparatus for performing the method of claim 1...\",\n        \"5. The apparatus of claim 4, wherein the processor is configured to...\",\n        \"6. A system comprising the apparatus of claim 4 and a display device...\",\n        \"7. The system of claim 6, wherein the display device is configured to...\",\n        \"8. The method of claim 1, wherein the PET data is acquired from a human subject...\",\n        \"9. The method of claim 1, wherein the PET data is acquired from an animal subject...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68185", "text": "{\n    \"patent_title\": \"Contrast Agent for Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2018-05-10\",\n    \"issue_date\": \"2019-07-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel contrast agent for magnetic resonance imaging (MRI) is disclosed. The contrast agent enhances image contrast and improves the detection of tumors.\",\n    \"citations\": [],\n    \"claims\": [\n        \"1. A contrast agent comprising a gadolinium complex...\",\n        \"2. The contrast agent of claim 1, wherein the gadolinium complex is chelated by a macrocyclic ligand...\",\n        \"3. The contrast agent of claim 1, further comprising a targeting moiety...\",\n        \"4. A method for enhancing MRI image contrast comprising administering the contrast agent of claim 1...\",\n        \"5. The method of claim 4, wherein the MRI is performed on a human subject...\",\n        \"6. The method of claim 4, wherein the MRI is performed to detect a tumor...\",\n        \"7. The method of claim 4, wherein the contrast agent is administered intravenously...\",\n        \"8. The method of claim 4, wherein the contrast agent is administered in a dose of...\",\n        \"9. The method of claim 4, wherein the MRI is a T1-weighted MRI...\",\n        \"10. The method of claim 4, wherein the MRI is a T2-weighted MRI...\",\n        \"11. The method of claim 4, wherein the MRI is a dynamic contrast-enhanced MRI...\",\n        \"12. The contrast agent of claim 1, wherein the gadolinium complex has a relaxivity value of...\",\n        \"13. The contrast agent of claim 1, wherein the gadolinium complex is biocompatible...\",\n        \"14. The contrast agent of claim 1, wherein the gadolinium complex is non-toxic...\",\n        \"15. The contrast agent of claim 1, wherein the gadolinium complex is stable in vivo...\",\n        \"16. The contrast agent of claim 1, wherein the gadolinium complex is readily excreted from the body...\",\n        \"17. The contrast agent of claim 1, wherein the gadolinium complex is water-soluble...\",\n        \"18. The contrast agent of claim 1, wherein the gadolinium complex is formulated in a pharmaceutically acceptable carrier...\",\n        \"19. The contrast agent of claim 1, wherein the gadolinium complex is sterile...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68186", "text": "{\n    \"patent_title\": \"Enhanced Medical Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"This invention relates to a novel method for reconstructing medical images using deep learning techniques. The method significantly improves diagnostic accuracy and reduces image acquisition time compared to conventional approaches. Artificial intelligence algorithms are employed to enhance image quality and reduce noise.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"A system comprising a processor and memory...\",\n        \"The method of claim 1, wherein the deep learning model is a convolutional neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68186", "text": "{\n    \"patent_title\": \"Improved X-Ray Tube Design for Reduced Radiation\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"University of Madrid\"\n        }\n    ],\n    \"patent_number\": \"EP11223344B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-11-05\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"This invention describes a new design for X-ray tubes that reduces radiation exposure while maintaining image quality. The design incorporates advanced materials and cooling techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube comprising a cathode...\",\n        \"A cooling system for an X-ray tube...\",\n        \"The X-ray tube of claim 1, wherein the cathode is made of tungsten.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68187", "text": "{\n    \"patent_title\": \"AI-Powered Biomarker Analysis for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for identifying cancer biomarkers using machine learning algorithms. The system analyzes genomic data to predict cancer risk and personalize treatment plans.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for predicting cancer risk based on genomic data.\",\n        \"A system for personalized cancer treatment planning.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68187", "text": "{\n    \"patent_title\": \"Automated Medical Image Analysis using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-01-20\",\n    \"filing_date\": \"2022-01-20\",\n    \"issue_date\": \"2024-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep learning system for automated analysis of medical images, specifically X-rays and MRIs, to detect anomalies and assist radiologists in diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10112233B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for automated detection of anomalies in medical images.\",\n        \"A method for improving the accuracy of medical diagnoses using deep learning.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68188", "text": "{\n    \"patent_title\": \"AI-Powered Diagnostic System for Early Cancer Detection in MRI Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2022-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel artificial intelligence system for analyzing magnetic resonance images (MRI) to detect early-stage cancer. The system utilizes deep learning algorithms to identify subtle anomalies indicative of malignancy, improving diagnostic accuracy and reducing false positives. The image analysis techniques enhance contrast and clarity, allowing for more precise tumor delineation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancer in MRI images using deep learning.\",\n        \"A system comprising a processor and memory configured to execute the method.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68188", "text": "{\n    \"patent_title\": \"X-Ray Image Enhancement Using Artificial Intelligence\",\n    \"inventors\": [\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"General Electric\"\n        },\n        {\n            \"name\": \"Emily Green\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-04-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an artificial intelligence system designed to improve the quality of X-ray images by reducing noise and enhancing contrast. The system employs convolutional neural networks to analyze images and optimize image clarity, particularly in scenarios involving low-dose radiation. The goal is to reduce patient exposure to radiation while maintaining diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing X-ray images using a convolutional neural network.\",\n        \"A system for processing X-ray images to reduce noise and improve contrast.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68189", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Reconstruction for MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel image reconstruction method for Magnetic Resonance Imaging (MRI) utilizing deep learning techniques, specifically convolutional neural networks, to improve image quality and reduce scan time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"The method of claim 1, wherein the neural network comprises...\",\n        \"The method of claim 1, for use in medical imaging.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68189", "text": "{\n    \"patent_title\": \"Method for Enhancing Contrast in Satellite Imagery\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"NASA\"\n        }\n    ],\n    \"patent_number\": \"EP3456789A1\",\n    \"priority_date\": \"2022-03-01\",\n    \"filing_date\": \"2022-03-01\",\n    \"issue_date\": \"2023-11-20\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"A method for enhancing the contrast of images captured from satellites using histogram equalization. The method improves visibility of features in remote sensing applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing contrast in an image comprising...\",\n        \"The method of claim 1, wherein the image is a satellite image.\",\n        \"The method of claim 1, using histogram equalization.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68190", "text": "{\n    \"patent_title\": \"Magnetic Resonance Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-04-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing magnetic resonance images using a deep learning architecture. This technique improves image quality and reduces scan time, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Prior Art MRI Reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image...\",\n        \"A system comprising a MRI scanner...\",\n        \"A computer-readable medium...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68190", "text": "{\n    \"patent_title\": \"Improved X-Ray Image Enhancement System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US11123456B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-14\",\n    \"issue_date\": \"2020-01-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved system for enhancing the quality of X-ray images, resulting in clearer visualization of bone structures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Traditional X-Ray Enhancement\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray image enhancement system...\",\n        \"A method for filtering X-ray images...\",\n        \"A software module for image processing...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68191", "text": "{\n    \"patent_title\": \"Magnetic Resonance Imaging with Enhanced Contrast Agents\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for enhancing contrast in magnetic resonance imaging (MRI) using targeted nanoparticles. This invention improves the detection of small tumors and other abnormalities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on MRI contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI contrast...\",\n        \"A nanoparticle composition for MRI...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68191", "text": "{\n    \"patent_title\": \"Improved X-Ray Imaging System with Digital Detector\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2018-07-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An X-ray imaging system with a digital detector for improved image quality and reduced radiation dose.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Previous X-ray detector designs\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A digital detector for X-ray imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68192", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Device for Continuous Glucose Monitoring and Insulin Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Medtronic Inc.\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2022-05-15\",\n    \"filing_date\": \"2022-08-20\",\n    \"issue_date\": \"2023-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized, fully implantable device for continuous glucose monitoring and automated insulin delivery. The device utilizes a novel biocompatible sensor and a micro-pump for precise insulin regulation, aiming to improve glycemic control in patients with type 1 diabetes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on implantable glucose sensors\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable device comprising a glucose sensor and an insulin pump.\",\n        \"The device of claim 1, wherein the glucose sensor is biocompatible.\",\n        \"The device of claim 2, wherein the insulin pump delivers insulin based on glucose levels.\",\n        \"A method for monitoring and regulating glucose levels using the device of claim 1.\",\n        \"The method of claim 4, further comprising data transmission to a remote monitoring system.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68192", "text": "{\n    \"patent_title\": \"Surgical Instrument for Laparoscopic Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-04-15\",\n    \"issue_date\": \"2022-09-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical instrument designed for enhanced precision in laparoscopic procedures. The instrument features an articulated tip and improved visualization capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art on laparoscopic surgical instruments\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising an articulated tip.\",\n        \"The instrument of claim 1, wherein the articulated tip allows for increased maneuverability.\",\n        \"A method for performing laparoscopic surgery using the instrument of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68193", "text": "{\n    \"patent_title\": \"Method and System for Improved Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-10-26\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"This invention presents a novel method for improving the accuracy and speed of medical image reconstruction, particularly in MRI and CT scans. The method utilizes a deep learning algorithm to reduce noise and artifacts, leading to clearer and more diagnostic images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image denoising\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for implementing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68193", "text": "{\n    \"patent_title\": \"Enhanced X-Ray Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        }\n    ],\n    \"patent_number\": \"EP3210987A1\",\n    \"priority_date\": \"2017-12-10\",\n    \"filing_date\": \"2018-06-01\",\n    \"issue_date\": \"2020-05-13\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"An improved X-ray imaging system with reduced radiation exposure and enhanced image quality. This system utilizes a novel detector array and image processing techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related technology in detector design\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A detector array for capturing X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68194", "text": "{\n    \"patent_title\": \"Miniature Robotic Surgical System with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-05-20\",\n    \"issue_date\": \"2020-07-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature robotic surgical system offering enhanced precision and dexterity for minimally invasive procedures. Utilizes novel actuator technology and advanced control algorithms to overcome limitations of existing robotic systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system comprising...\",\n        \"A method for performing a minimally invasive surgical procedure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68194", "text": "{\n    \"patent_title\": \"Improved Stent Design for Coronary Artery Disease\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11123456B1\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-03-05\",\n    \"issue_date\": \"2021-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved stent design for treating coronary artery disease, offering enhanced biocompatibility and reduced risk of restenosis. This invention significantly improves patient outcomes in cardiovascular interventions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Previous stent designs\"\n        }\n    ],\n    \"claims\": [\n        \"A stent comprising a biocompatible material...\",\n        \"A method for treating coronary artery disease...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68195", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for reconstructing medical images from raw data, utilizing a novel algorithm to reduce noise and improve image clarity. The technique enhances visualization of anatomical structures for improved diagnosis of various conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for processing medical imaging data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68195", "text": "{\n    \"patent_title\": \"Novel Biomarker Identification for Early Cancer Detection via Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Mayo Clinic\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-01\",\n    \"issue_date\": \"2023-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for identifying novel biomarkers in medical images to enable early detection of cancerous tumors. The technique utilizes machine learning algorithms to analyze image features and predict the presence of cancer.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US12345678B2\",\n            \"relevance\": \"Related work in image analysis\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancer using biomarkers identified from medical images...\",\n        \"A system for analyzing medical imaging data to predict cancer risk...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68196", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11254321B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-11-23\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A miniaturized, implantable biosensor for continuous glucose monitoring, utilizing novel nanomaterials for enhanced sensitivity and biocompatibility. The device wirelessly transmits data to an external receiver for real-time tracking of glucose levels, improving diabetes management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Implantable Glucose Sensor\"\n        }\n    ],\n    \"claims\": [\n        \"A biosensor for continuous glucose monitoring comprising a nanomaterial-based sensing element.\",\n        \"A method for wirelessly transmitting glucose data from an implantable sensor to an external receiver.\",\n        \"A system for improving diabetes management through real-time glucose monitoring and data analysis.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68196", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Vascular Access\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"EP3845678B1\",\n    \"priority_date\": \"2018-12-01\",\n    \"filing_date\": \"2020-06-15\",\n    \"issue_date\": \"2021-09-08\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"An improved catheter design featuring a tapered tip and lubricious coating for easier insertion and reduced patient discomfort during vascular access procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Vascular Access Catheter\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter having a tapered tip for improved insertion.\",\n        \"A catheter coated with a biocompatible lubricant.\",\n        \"A method for reducing patient discomfort during vascular access.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68197", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging with Enhanced Resolution\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-06-10\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for enhancing the resolution of magnetic resonance images using advanced signal processing techniques. The invention improves diagnostic accuracy in detecting subtle anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for improving MRI resolution...\",\n        \"A system for enhanced image processing...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68197", "text": "{\n    \"patent_title\": \"System for Automated X-Ray Image Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2022-08-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for analyzing X-ray images to detect fractures and other abnormalities. The system utilizes machine learning algorithms for improved accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for detecting fractures...\",\n        \"A method for automated image analysis...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68198", "text": "{\n    \"patent_title\": \"Method and System for Interference Cancellation in Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for mitigating interference in wireless communication networks is disclosed. The system utilizes advanced signal processing techniques to identify and cancel interfering signals, improving the quality and reliability of wireless transmissions. The method includes adaptive filtering and interference prediction algorithms to enhance performance in dynamic environments.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Interference Alignment in Wireless Networks\"\n        }\n    ],\n    \"claims\": [\n        \"A method for canceling interference in a wireless communication system.\",\n        \"A system comprising a signal processing unit configured to cancel interference.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68198", "text": "{\n    \"patent_title\": \"Compact Antenna Design for 5G Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-09-01\",\n    \"filing_date\": \"2017-09-01\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel compact antenna design is presented for use in 5G mobile devices. The antenna utilizes a unique geometric structure to achieve high bandwidth and efficiency in a small form factor. The design focuses on optimizing radiation patterns and impedance matching for improved signal transmission and reception.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Antenna Miniaturization Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"An antenna design for a mobile device.\",\n        \"An antenna comprising a compact geometric structure.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68199", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical Stapler with Integrated Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-09-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical stapler incorporating real-time imaging for precise minimally invasive surgical applications. The device allows surgeons to visualize tissue structures during stapling, improving accuracy and reducing complications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art on surgical staplers\"\n        },\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"Prior art on medical imaging techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an imaging module integrated within the stapling head.\",\n        \"A method for performing minimally invasive surgery using the aforementioned stapler.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68199", "text": "{\n    \"patent_title\": \"High-Throughput Drug Screening System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Pharmaceutical Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for high-throughput screening of drug candidates against biological targets. The system utilizes microfluidic devices and automated data analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US12345098B1\",\n            \"relevance\": \"Related prior art on microfluidic devices\"\n        },\n        {\n            \"patent_number\": \"US98765432B2\",\n            \"relevance\": \"Prior art on drug screening assays\"\n        },\n        {\n            \"patent_number\": \"US76543210B1\",\n            \"relevance\": \"Prior art on automated data analysis\"\n        },\n        {\n            \"patent_number\": \"US54321098B2\",\n            \"relevance\": \"Prior art on biological target identification\"\n        },\n        {\n            \"patent_number\": \"US21098765B1\",\n            \"relevance\": \"Prior art on liquid handling systems\"\n        }\n    ],\n    \"claims\": [\n        \"A drug screening system comprising a microfluidic device and an automated data analysis module.\",\n        \"A method for identifying drug candidates using the aforementioned system.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68200", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"EP3854729B1\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2019-09-20\",\n    \"issue_date\": \"2021-07-28\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"This invention presents a novel method and system for reconstructing medical images from projection data, improving diagnostic accuracy by reducing noise and artifacts. The method utilizes a deep learning approach to enhance image quality, enabling more precise identification of anatomical structures and pathological conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"The method of claim 1, wherein the deep learning model...\",\n        \"A system comprising...\",\n        \"The system of claim 3, further comprising...\",\n        \"The method of claim 1, wherein the noise reduction...\",\n        \"The method of claim 2, wherein the deep learning model is a convolutional neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68200", "text": "{\n    \"patent_title\": \"Digital Radiography System with Improved Sensor Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"GE Global Research\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2022-01-18\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A digital radiography system utilizing a new sensor technology to capture high-resolution images. This system improves image clarity and reduces radiation exposure for patients. The system includes a detector array and processing unit for image formation and display.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A digital radiography system comprising...\",\n        \"The system of claim 1, wherein the detector array...\",\n        \"A method for capturing a medical image...\",\n        \"The method of claim 3, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68201", "text": "{\n    \"patent_title\": \"AI-Powered Magnetic Resonance Image Reconstruction for Enhanced Anomaly Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing magnetic resonance images using deep learning to improve the detection of subtle anomalies, particularly in neurological disorders.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"A system for detecting anomalies in MRI images...\",\n        \"A computer-readable medium storing instructions for...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68201", "text": "{\n    \"patent_title\": \"Improved X-Ray Imaging System with Digital Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-12-15\",\n    \"filing_date\": \"2010-01-10\",\n    \"issue_date\": \"2017-08-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An X-ray imaging system with improved digital image processing capabilities for enhanced visualization of bone fractures and other skeletal anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Previous X-ray system designs\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A method for enhancing X-ray images...\",\n        \"A digital image processing algorithm for...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68202", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-11-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable glucose sensor utilizes a novel microfabrication technique for long-term monitoring of glucose levels. The sensor wirelessly transmits data to an external receiver for real-time analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on glucose sensing technology\"\n        }\n    ],\n    \"claims\": [\n        \"A method for continuously monitoring glucose levels in a patient using an implantable sensor.\",\n        \"An implantable glucose sensor comprising a microfabricated sensing element and a wireless communication module.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68202", "text": "{\n    \"patent_title\": \"Magnetic Resonance Imaging System for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-10\",\n    \"issue_date\": \"2021-09-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A magnetic resonance imaging (MRI) system designed for improved early detection of cancerous tumors. The system utilizes advanced imaging techniques to enhance image resolution and contrast.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art on MRI technology\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI system comprising a magnetic field generator and an image processing unit.\",\n        \"A method for detecting cancerous tumors using MRI with enhanced contrast.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68203", "text": "{\n    \"patent_title\": \"Enhanced Resolution Medical Imaging System Using Adaptive Filtering\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MedImage Technologies Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MedImage Technologies Inc.\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel medical imaging system utilizing adaptive filtering techniques to significantly enhance image resolution and improve diagnostic accuracy. The system minimizes noise and artifacts, enabling clearer visualization of anatomical structures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US78901234B1\"\n        }\n    ],\n    \"claims\": [\n        \"A medical imaging system comprising an image acquisition module and an adaptive filtering module.\",\n        \"The system of claim 1, wherein the adaptive filtering module reduces noise in the acquired image.\",\n        \"The system of claim 2, wherein the noise reduction improves diagnostic accuracy.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68203", "text": "{\n    \"patent_title\": \"Improved MRI Coil Design for Pediatric Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2015-11-20\",\n    \"filing_date\": \"2015-11-20\",\n    \"issue_date\": \"2017-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new MRI coil design specifically tailored for pediatric imaging, reducing scan time and improving patient comfort. The coil enhances signal-to-noise ratio in smaller patients.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US54321098B2\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil designed for pediatric imaging.\",\n        \"The coil of claim 1, wherein the coil reduces scan time.\",\n        \"The coil of claim 2, wherein the coil improves patient comfort.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68204", "text": "{\n    \"patent_title\": \"Novel Drug Delivery System for Targeted Cancer Therapy\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-15\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel drug delivery system utilizing biocompatible nanoparticles for targeted cancer therapy, improving drug efficacy and reducing side effects.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A drug delivery system comprising biocompatible nanoparticles...\",\n        \"A method for treating cancer...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68204", "text": "{\n    \"patent_title\": \"Advanced MRI Coil Design for Enhanced Image Resolution\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-03-01\",\n    \"filing_date\": \"2022-03-15\",\n    \"issue_date\": \"2024-02-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved MRI coil design that enhances image resolution and reduces scan time, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil comprising a novel winding pattern...\",\n        \"A method for acquiring MRI images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68205", "text": "{\n    \"patent_title\": \"Improved MRI Contrast Agent for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel MRI contrast agent with enhanced tumor specificity and improved biocompatibility, enabling earlier and more accurate cancer detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Contrast Agent Composition\"\n        }\n    ],\n    \"claims\": [\n        \"A composition comprising a gadolinium-based contrast agent...\",\n        \"A method for detecting cancer...\",\n        \"The method of claim 1, wherein the cancer is breast cancer...\",\n        \"The composition of claim 1, having a relaxivity of...\",\n        \"The method of claim 2, wherein the MRI is performed at...\",\n        \"A pharmaceutical formulation comprising the composition...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68205", "text": "{\n    \"patent_title\": \"Digital X-Ray Image Enhancement Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Wilson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2016-02-29\",\n    \"filing_date\": \"2017-08-10\",\n    \"issue_date\": \"2018-05-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new algorithm for improving the clarity and resolution of digital X-ray images, reducing noise and enhancing diagnostic accuracy.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for enhancing a digital X-ray image...\",\n        \"The method of claim 1, wherein the noise reduction is...\",\n        \"A system for performing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68206", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2019-11-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable glucose sensor is disclosed, utilizing a novel enzymatic reaction and wireless communication protocol for continuous glucose monitoring. The device aims to improve diabetes management by providing real-time data to patients and healthcare providers.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"WO2017123456A1\"\n        }\n    ],\n    \"claims\": [\n        \"A glucose sensor comprising...\",\n        \"A wireless communication module...\",\n        \"A method for monitoring glucose levels...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68206", "text": "{\n    \"patent_title\": \"Surgical Instrument Handle Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"EP3123456B1\",\n    \"priority_date\": \"2016-07-22\",\n    \"filing_date\": \"2016-07-22\",\n    \"issue_date\": \"2018-04-11\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"An improved ergonomic handle design for surgical instruments, enhancing grip and reducing surgeon fatigue during prolonged procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument handle comprising...\",\n        \"A grip portion with a contoured surface...\",\n        \"A locking mechanism...\",\n        \"A method for manufacturing the handle...\",\n        \"An alternative embodiment...\",\n        \"A further alternative embodiment...\",\n        \"Yet another alternative embodiment...\",\n        \"Another variation of the handle...\",\n        \"A different material composition...\",\n        \"A method for adjusting the grip...\",\n        \"A safety feature...\",\n        \"A durability improvement...\",\n        \"An aesthetic enhancement...\",\n        \"A manufacturing process optimization...\",\n        \"A packaging method...\",\n        \"A distribution strategy...\",\n        \"A marketing campaign...\",\n        \"A training program...\",\n        \"A customer support system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68207", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Magnetic Resonance Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2023-01-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing magnetic resonance images with improved resolution and reduced artifacts. This system utilizes advanced algorithms to enhance diagnostic accuracy in detecting subtle anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10987654B1\",\n            \"type\": \"cited_by\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a magnetic resonance image comprising...\",\n        \"A system for performing magnetic resonance imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68207", "text": "{\n    \"patent_title\": \"X-Ray Image Enhancement Filter\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-15\",\n    \"issue_date\": \"2020-03-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An X-ray image filter designed to improve contrast. While providing image clarity, it does not substantially improve diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US4555947\",\n            \"type\": \"cited_by\"\n        }\n    ],\n    \"claims\": [\n        \"A filter for enhancing X-ray images comprising...\",\n        \"An apparatus for applying an X-ray image filter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68208", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Analysis Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for analyzing medical images using deep learning algorithms. The system improves the accuracy and efficiency of disease detection and diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Recognition Using Convolutional Neural Networks\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Object Detection in Images\"\n        }\n    ],\n    \"claims\": [\n        \"A method for analyzing a medical image comprising...\",\n        \"A system for analyzing a medical image comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68208", "text": "{\n    \"patent_title\": \"Improved X-ray Shielding Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Generic Plastics Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2014-12-20\",\n    \"filing_date\": \"2014-12-20\",\n    \"issue_date\": \"2018-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new composite material for improving X-ray shielding in medical facilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Lead-based Shielding Compounds\"\n        }\n    ],\n    \"claims\": [\n        \"A shielding material comprising...\",\n        \"A method for manufacturing a shielding material...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68209", "text": "{\n    \"patent_title\": \"Method and System for Noise Reduction in Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reducing noise in medical images using deep learning techniques, resulting in improved image clarity for diagnostic purposes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing noise in an image comprising...\",\n        \"A system for processing an image to enhance clarity...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68209", "text": "{\n    \"patent_title\": \"Image Enhancement Technique for Satellite Imagery\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"Airbus\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"NASA\"\n        }\n    ],\n    \"patent_number\": \"EP3876543A1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2022-09-22\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"A method for enhancing the visual quality of satellite imagery through contrast adjustment and color correction.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing satellite imagery comprising...\",\n        \"A system for improving the clarity of remotely sensed data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68210", "text": "{\n    \"patent_title\": \"Enhanced MRI Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2021-11-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing magnetic resonance images (MRI) using deep learning algorithms to improve image quality and diagnostic accuracy. The method reduces noise and artifacts, enabling clearer visualization of anatomical structures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for improving MRI image quality...\",\n        \"The method of claim 1, wherein the deep learning algorithm is a convolutional neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68210", "text": "{\n    \"patent_title\": \"Novel Contrast Agent for Enhanced CT Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-03-10\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-08-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new contrast agent designed to improve the visibility of blood vessels and tumors in computed tomography (CT) scans. The agent exhibits enhanced biocompatibility and prolonged circulation time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"A method for enhancing CT images...\",\n        \"The contrast agent of claim 1, wherein the agent is iodine-based.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68211", "text": "{\n    \"patent_title\": \"Non-Invasive Glucose Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US1234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive glucose monitoring system utilizing optical sensors to measure glucose levels through the skin, enhancing patient comfort and reducing the need for blood draws.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Prior Art Glucose Sensor\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Optical Sensor Technology\"\n        }\n    ],\n    \"claims\": [\n        \"A non-invasive glucose monitoring system comprising optical sensors.\",\n        \"A method for measuring glucose levels without blood draw.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68211", "text": "{\n    \"patent_title\": \"Surgical Robotic Arm with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Jessica Brown\",\n            \"affiliation\": \"Boston University\"\n        }\n    ],\n    \"patent_number\": \"US7654321B1\",\n    \"priority_date\": \"2022-05-10\",\n    \"filing_date\": \"2022-05-10\",\n    \"issue_date\": \"2024-01-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A robotic arm designed for precise surgical procedures, offering enhanced dexterity and control to surgeons. This technology requires invasive surgical techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Robotic Surgery Systems\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic arm with multiple degrees of freedom.\",\n        \"A control system for precise surgical movements.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68212", "text": "{\n    \"patent_title\": \"Miniature Implantable Drug Delivery System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature, implantable drug delivery system for controlled release of medication directly to targeted tissues. The system utilizes microfluidic channels and a biocompatible polymer matrix to achieve precise dosing and minimize systemic side effects, significantly improving patient adherence and therapeutic efficacy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Implantable Micro-pump\"\n        }\n    ],\n    \"claims\": [\n        \"A miniature implantable drug delivery system comprising...\",\n        \"A method for controlled release of medication...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68212", "text": "{\n    \"patent_title\": \"Improved X-Ray Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11890123B2\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved X-ray imaging system with enhanced resolution and reduced radiation exposure. The system incorporates a novel detector array and advanced image processing algorithms to provide clearer and more detailed images for diagnostic purposes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Digital Radiography System\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A method for generating a diagnostic image...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68213", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Enhancement for Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel image enhancement technique utilizing deep learning algorithms to improve the quality of medical images. It enhances visibility and facilitates more accurate diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing medical images using a convolutional neural network.\",\n        \"A system for real-time image enhancement in medical imaging devices.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68213", "text": "{\n    \"patent_title\": \"Method for Improving Color Contrast in Digital Photographs\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Independent Consultant\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-02-15\",\n    \"filing_date\": \"2022-02-15\",\n    \"issue_date\": \"2024-01-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method for automatically adjusting the color contrast in digital photographs to improve their visual appeal.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related art in image manipulation\"\n        }\n    ],\n    \"claims\": [\n        \"A method for adjusting color contrast based on histogram equalization.\",\n        \"A digital camera incorporating the contrast adjustment method.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68214", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Electrolyte for Increased Cycle Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery incorporating a novel electrolyte composition that significantly increases cycle life and improves performance at extreme temperatures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68214", "text": "{\n    \"patent_title\": \"Compact Nuclear Reactor Design for Remote Power Generation\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Westinghouse Electric Company\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2017-12-01\",\n    \"filing_date\": \"2017-12-01\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel design for a small-scale nuclear reactor intended for use in remote locations, providing a reliable and independent power source.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A nuclear reactor comprising...\",\n        \"A control system for regulating...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68215", "text": "{\n    \"patent_title\": \"Enhanced Image Sharpening Using Adaptive Filtering\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2022-05-15\",\n    \"filing_date\": \"2022-06-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image sharpening technique using adaptive filtering to improve image clarity and reduce noise. The method dynamically adjusts filter parameters based on local image characteristics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Edge Detection Algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"A method for sharpening an image comprising...\",\n        \"An apparatus for implementing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68215", "text": "{\n    \"patent_title\": \"Real-time MRI Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"EP3210987A1\",\n    \"priority_date\": \"2021-11-01\",\n    \"filing_date\": \"2021-12-15\",\n    \"issue_date\": \"2023-03-01\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"A deep learning-based method for accelerating MRI reconstruction, enabling real-time imaging for diagnostic purposes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Advanced MRI Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A system for reconstructing MRI images...\",\n        \"A method utilizing a convolutional neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68216", "text": "{\n    \"patent_title\": \"AI-Powered Diagnostic System for Early Cancer Detection in Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an AI-based system for analyzing medical images (MRI, CT scans, X-rays) to detect early signs of cancer with improved accuracy and efficiency. The system utilizes deep learning algorithms trained on a large dataset of annotated images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\",\n            \"title\": \"Medical Image Analysis Using Convolutional Neural Networks\"\n        }\n    ],\n    \"claims\": [\n        \"A method for automatically detecting cancerous regions in medical images using a deep learning model.\",\n        \"A system comprising a medical image scanner, a processing unit, and a display device.\",\n        \"The system of claim 1, wherein the deep learning model is a convolutional neural network.\",\n        \"The method of claim 1, further comprising displaying the detected cancerous regions on the display device.\",\n        \"A computer-readable medium storing instructions for executing the method of claim 1.\",\n        \"The method of claim 1, wherein the medical image is an MRI scan.\",\n        \"The system of claim 2, wherein the processing unit is cloud-based.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68216", "text": "{\n    \"patent_title\": \"Method for Enhancing Contrast in Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"EP3876543A1\",\n    \"priority_date\": \"2020-06-10\",\n    \"filing_date\": \"2020-06-10\",\n    \"issue_date\": \"2022-02-16\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"This invention relates to a method for improving the contrast of medical images using a novel filtering technique. The technique enhances the visibility of subtle details, aiding in diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Image Enhancement Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing the contrast of a medical image.\",\n        \"The method of claim 1, wherein the medical image is a CT scan.\",\n        \"The method of claim 1, further comprising applying a noise reduction filter.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68217", "text": "{\n    \"patent_title\": \"High-Density Solid-State Electrolyte for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11254398B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-12-07\",\n    \"patent_office\": \"US Patent and Trademark Office\",\n    \"abstract\": \"A novel solid-state electrolyte composition for lithium-ion batteries exhibiting enhanced ionic conductivity and electrochemical stability, resulting in significantly improved battery life and safety. The electrolyte allows for higher energy density and faster charging rates compared to conventional liquid electrolytes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876234B2\",\n            \"title\": \"Lithium-Ion Battery with Enhanced Cycle Life\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising a solid-state electrolyte having a lithium-ion conductivity of at least 10^-3 S/cm.\",\n        \"The lithium-ion battery of claim 1, wherein the solid-state electrolyte comprises a garnet-type lithium lanthanum zirconium oxide (LLZO) composition.\",\n        \"A method of manufacturing a lithium-ion battery comprising the steps of...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68217", "text": "{\n    \"patent_title\": \"Method for Optimizing Battery Usage Through Software Control\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Apple Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11329876B1\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2022-05-17\",\n    \"patent_office\": \"US Patent and Trademark Office\",\n    \"abstract\": \"A software-based method for dynamically adjusting power consumption of various components in a portable device to extend battery life. The method analyzes usage patterns and selectively reduces the performance of non-essential applications and features.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10544567B2\",\n            \"title\": \"Power Management System for Mobile Devices\"\n        }\n    ],\n    \"claims\": [\n        \"A method for extending battery life in a portable device comprising the steps of: monitoring application usage; identifying non-essential applications; and reducing the processing power allocated to said non-essential applications.\",\n        \"The method of claim 1, wherein the processing power reduction is based on a predefined threshold.\",\n        \"A portable device configured to execute the method of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68218", "text": "{\n    \"patent_title\": \"Adaptive Noise Reduction for Low-Light Image Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2020-06-01\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for reducing noise in low-light images using adaptive filtering techniques. The system analyzes image characteristics to optimize filter parameters, enhancing image clarity without sacrificing detail.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing noise in an image comprising...\",\n        \"An apparatus for processing images, the apparatus comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68218", "text": "{\n    \"patent_title\": \"MRI Image Reconstruction with Accelerated Scanning\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-04-22\",\n    \"filing_date\": \"2020-07-10\",\n    \"issue_date\": \"2022-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing high-resolution magnetic resonance images (MRI) using compressed sensing techniques. This allows for faster scanning times and improved image quality in medical diagnostics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"A system for performing MRI imaging, the system comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68219", "text": "{\n    \"patent_title\": \"Comfortable Post-Surgical Drainage System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2019-10-26\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2021-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel post-surgical drainage system designed to significantly improve patient comfort and minimize recovery time.  The system utilizes a flexible, biocompatible material and a self-adjusting collection chamber, reducing pressure and irritation at the surgical site.  The device also incorporates a biofeedback sensor to monitor drainage levels and alert medical personnel to potential complications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A post-surgical drainage system comprising a flexible drainage tube...\",\n        \"The system of claim 1, wherein the drainage tube is constructed from a biocompatible polymer.\",\n        \"The system of claim 2, further comprising a self-adjusting collection chamber.\",\n        \"The system of claim 3, wherein the collection chamber includes a biofeedback sensor.\",\n        \"A method for reducing patient discomfort post-surgery using the system of claim 1.\",\n        \"The method of claim 5, further comprising monitoring drainage levels using the biofeedback sensor.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68219", "text": "{\n    \"patent_title\": \"Improved Bone Fracture Fixation Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11223344B2\",\n    \"priority_date\": \"2018-05-10\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2022-04-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved bone fracture fixation device utilizing a novel alloy composition and a streamlined surgical insertion technique.  The device provides enhanced stability and promotes faster bone healing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US4567890B2\"\n        },\n        {\n            \"patent_number\": \"US10456789B2\"\n        }\n    ],\n    \"claims\": [\n        \"A bone fracture fixation device comprising an alloy...\",\n        \"The device of claim 1, wherein the alloy comprises titanium and vanadium.\",\n        \"A surgical method for fixing a bone fracture using the device of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68220", "text": "{\n    \"patent_title\": \"Method and System for Real-Time Image Enhancement Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-11-29\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel deep learning architecture for real-time image enhancement. The method significantly improves image quality in low-light conditions and enhances detail for applications such as mobile photography and surveillance. The system utilizes a convolutional neural network trained on a large dataset of images and is optimized for low-latency performance. The technique is suitable for edge computing devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"kind\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image comprising...\",\n        \"A system for real-time image enhancement comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68220", "text": "{\n    \"patent_title\": \"Image Compression Technique Using Wavelet Transforms\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US7890123B1\",\n    \"priority_date\": \"2017-10-26\",\n    \"filing_date\": \"2017-10-26\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel approach to image compression utilizing wavelet transforms. The method achieves high compression ratios while maintaining acceptable image quality. The technique is based on a modified wavelet transform algorithm and is suitable for various image formats. A detailed mathematical description of the algorithm is provided, along with experimental results demonstrating its performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US4500000\",\n            \"kind\": \"cited\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image comprising...\",\n        \"An apparatus for image compression comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68221", "text": "{\n    \"patent_title\": \"Automated Lung Nodule Detection using Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for automated detection of lung nodules in CT scans using a deep convolutional neural network. The system improves diagnostic accuracy and reduces false positive rates.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting lung nodules in a CT scan comprising: obtaining a CT scan image; applying a convolutional neural network to the CT scan image; and identifying potential lung nodules based on the output of the convolutional neural network.\",\n        \"A system for automated lung nodule detection comprising a processor and a memory storing a convolutional neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68221", "text": "{\n    \"patent_title\": \"Improved MRI Coil for Enhanced Image Resolution\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2022-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved MRI coil design that provides significantly enhanced image resolution and signal-to-noise ratio. The coil utilizes a novel geometric configuration for optimized performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil comprising a geometrically optimized configuration for enhanced signal reception.\",\n        \"A method for obtaining high-resolution MRI images using the aforementioned coil.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68222", "text": "{\n    \"patent_title\": \"Magnetic Resonance Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method for reconstructing magnetic resonance images using a deep convolutional neural network. The network is trained to enhance image quality and reduce artifacts, leading to improved diagnostic accuracy. This approach significantly differs from traditional reconstruction methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8786645B2\",\n            \"relevance\": \"Prior art in MR image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MR image comprising...\",\n        \"A system for performing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68222", "text": "{\n    \"patent_title\": \"Improved X-Ray Detector with Enhanced Sensitivity\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved X-ray detector with enhanced sensitivity and reduced noise. The detector utilizes a novel scintillator material and optimized readout electronics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related X-ray detector technology\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray detector comprising...\",\n        \"A method for detecting X-rays...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68223", "text": "{\n    \"patent_title\": \"AI-Enhanced Medical Image Reconstruction for Improved Diagnostic Accuracy\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for reconstructing medical images using artificial intelligence (AI) and machine learning (ML) techniques. The system utilizes a convolutional neural network (CNN) to enhance image quality and improve the accuracy of diagnostic interpretation. The improved image quality leads to earlier and more accurate detection of diseases.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for improving diagnostic accuracy based on reconstructed medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68223", "text": "{\n    \"patent_title\": \"Improved X-ray Tube Design for Reduced Radiation Dose\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Philips Healthcare\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of Michigan\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2016-11-01\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel design for an X-ray tube that reduces the amount of radiation exposure to patients during medical imaging procedures. The design incorporates improved shielding materials and a more efficient electron beam focusing system. The resulting images are of comparable quality to existing systems but with significantly lower radiation doses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"kind\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube design comprising...\",\n        \"A method for reducing radiation exposure in medical imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68224", "text": "{\n    \"patent_title\": \"Enhanced MRI Image Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology, Department of Electrical Engineering and Computer Science\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School, Radiology Department\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel deep learning architecture for reconstructing Magnetic Resonance Images (MRIs) with significantly improved resolution and diagnostic accuracy. The method addresses challenges in image noise reduction and artifact removal, leading to clearer visualization of anatomical structures and enabling earlier and more precise disease detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"MRI Reconstruction Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images using a deep convolutional neural network.\",\n        \"A system for improving the diagnostic accuracy of MRI scans.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68224", "text": "{\n    \"patent_title\": \"Digital Radiography System with Improved Image Filtering\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"University of California, Berkeley, Department of Physics\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved digital radiography system incorporating novel image filtering techniques to enhance contrast and reduce radiation exposure. The system provides sharper, clearer X-ray images for diagnostic purposes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Digital X-ray Image Processing\"\n        }\n    ],\n    \"claims\": [\n        \"A digital radiography system comprising an X-ray source and an image detector.\",\n        \"A method for filtering X-ray images to improve contrast.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68225", "text": "{\n    \"patent_title\": \"Automated Anomaly Detection in MRI Scans Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2021-12-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for automatically detecting anomalies in MRI scans using a deep learning model. The system is designed to assist radiologists in identifying potential issues in various organs and tissues.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"cited\"\n        }\n    ],\n    \"claims\": [\n        \"A method for anomaly detection in MRI scans comprising:...\",\n        \"A system for analyzing MRI images, comprising...\",\n        \"A deep learning model trained to identify...\",\n        \"A non-transitory computer-readable medium...\",\n        \"The method of claim 1, wherein the anomaly is...\",\n        \"The system of claim 2, further comprising...\",\n        \"The deep learning model of claim 3, utilizing...\",\n        \"The computer-readable medium of claim 4, storing...\",\n        \"The method of claim 5, further comprising...\",\n        \"The system of claim 6, configured to...\",\n        \"The deep learning model of claim 7, implementing...\",\n        \"The computer-readable medium of claim 8, encoding...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68225", "text": "{\n    \"patent_title\": \"Deep Learning for Early Cancer Detection in Mammograms\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-01-15\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2022-07-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep learning system for detecting cancerous tumors in mammogram images. The system improves the accuracy and speed of early cancer detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"cited\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancer in mammograms...\",\n        \"A system for analyzing mammographic images...\",\n        \"A deep learning model trained to identify cancerous regions...\",\n        \"A computer-readable medium storing...\",\n        \"The method of claim 1, wherein the cancer is...\",\n        \"The system of claim 2, further comprising...\",\n        \"The deep learning model of claim 3, utilizing...\",\n        \"The computer-readable medium of claim 4, encoding...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68226", "text": "{\n    \"patent_title\": \"Deep Learning Based Image Super-Resolution Using Generative Adversarial Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Chen, Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Wang, Jun\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel image super-resolution technique leveraging deep learning and generative adversarial networks (GANs) to reconstruct high-resolution images from low-resolution counterparts. The system effectively reduces noise and artifacts, enhancing the visual quality of images for various applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Enhancement System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for super-resolving an image comprising:...\",\n        \"A system for enhancing image quality using a GAN...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68226", "text": "{\n    \"patent_title\": \"Method and System for Object Recognition in Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Smith, John\",\n            \"affiliation\": \"Microsoft Research\"\n        },\n        {\n            \"name\": \"Jones, Alice\",\n            \"affiliation\": \"University of Washington\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2023-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a system for identifying objects within images using convolutional neural networks. The system classifies images based on recognized objects and provides relevant metadata.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Classification Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A method for classifying objects in an image...\",\n        \"A system for identifying and labeling objects within an image...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68227", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-12-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel minimally invasive surgical system incorporating advanced fiber optic technology and real-time image processing. The system enhances visualization during surgical procedures, leading to increased precision and improved patient outcomes, especially in complex neurological surgeries. It represents a significant advancement in surgical techniques by minimizing tissue damage and reducing recovery times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in surgical visualization\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising...\",\n        \"A method for performing minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68227", "text": "{\n    \"patent_title\": \"Cosmetic Skin Rejuvenation Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2021-02-15\",\n    \"issue_date\": \"2022-08-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A handheld device for non-invasive skin rejuvenation utilizing focused ultrasound technology. The device targets superficial skin layers to reduce the appearance of wrinkles and improve skin tone. Designed for cosmetic use and minimizing signs of aging. Offers a quick and easy solution for aesthetic improvement.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Prior art in ultrasound skin treatments\"\n        }\n    ],\n    \"claims\": [\n        \"A cosmetic device comprising...\",\n        \"A method for skin rejuvenation...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68228", "text": "{\n    \"patent_title\": \"Deep Learning for Enhanced Mammographic Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2021-12-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for improving the accuracy of breast cancer detection using deep convolutional neural networks applied to mammographic images. The system is trained to identify subtle patterns indicative of malignancy, reducing false positives and improving early diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancer in mammographic images comprising...\",\n        \"A system for automated cancer detection...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68228", "text": "{\n    \"patent_title\": \"Automated Image Analysis for Veterinary Diagnostics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"PetScan Inc.\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"PetScan Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-08-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for analyzing veterinary medical images, such as X-rays and ultrasounds, to identify anomalies and assist in diagnosis. The system utilizes image processing techniques to highlight areas of interest for veterinarians.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for analyzing veterinary images comprising...\",\n        \"A system for identifying anomalies in animal scans...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68229", "text": "{\n    \"patent_title\": \"Implantable Device for Controlled Drug Release\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Boston University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2022-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable device capable of controlled drug release, utilizing microfluidic channels and a biodegradable polymer matrix. This device is designed to improve treatment efficacy for chronic conditions by maintaining therapeutic drug levels.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art relating to implantable devices.\"\n        }\n    ],\n    \"claims\": [\n        \"A device for controlled drug release comprising...\",\n        \"A method for treating a chronic condition using the device...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68229", "text": "{\n    \"patent_title\": \"Method for Early Cancer Detection Using Biomarkers\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for detecting early-stage cancer using a novel combination of biomarkers and a high-throughput screening platform. This method provides a rapid and accurate diagnostic tool for cancer screening.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related to biomarker detection techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancer comprising...\",\n        \"A kit for performing the cancer detection method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68230", "text": "{\n    \"patent_title\": \"Surgical Robotic System with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical robotic system incorporating advanced haptic feedback and machine learning algorithms for increased precision and dexterity during minimally invasive procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art in robotic surgery.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic system comprising...\",\n        \"A method for controlling a surgical robot...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68230", "text": "{\n    \"patent_title\": \"Portable Blood Glucose Monitoring Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US7654321B1\",\n    \"priority_date\": \"2022-01-15\",\n    \"filing_date\": \"2022-01-15\",\n    \"issue_date\": \"2024-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A compact and user-friendly device for real-time blood glucose monitoring, utilizing electrochemical sensors.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"relevance\": \"Prior art in glucose sensor technology.\"\n        }\n    ],\n    \"claims\": [\n        \"A portable blood glucose monitoring device comprising...\",\n        \"A method for measuring blood glucose levels...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68231", "text": "{\n    \"patent_title\": \"Implantable Cardiac Monitor with Remote Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac monitor wirelessly transmits patient data to a remote server for real-time monitoring of cardiovascular health.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for remotely monitoring cardiac function.\",\n        \"An implantable device for detecting arrhythmias.\",\n        \"A system for transmitting cardiac data wirelessly.\",\n        \"A server for storing and analyzing cardiac data.\",\n        \"A user interface for displaying cardiac data to a physician.\",\n        \"Claim 6: The system of claim 3 further comprising a data encryption module.\",\n        \"Claim 7: The method of claim 1, wherein the monitoring is continuous.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68231", "text": "{\n    \"patent_title\": \"Catheter Design for Peripheral Angioplasty\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"Medtronic Inc.\"\n        }\n    ],\n    \"patent_number\": \"EP3456789B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-08-17\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"A novel catheter design for improved maneuverability and efficacy in peripheral angioplasty procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible shaft.\",\n        \"A balloon expandable at the distal end of the catheter.\",\n        \"A method for performing peripheral angioplasty.\",\n        \"A coating applied to the balloon surface.\",\n        \"Claim 5: The catheter of claim 1, wherein the flexible shaft comprises a polymer material.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68232", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Pathogen Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for the rapid and sensitive detection of pathogens in biological samples. The device utilizes a novel combination of microchannel design and surface chemistry to achieve significantly improved detection limits and reduced analysis time, representing a substantial advancement in point-of-care diagnostics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"relevance\": \"Related microfluidic technology\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising a microchannel with dimensions less than 100 microns.\",\n        \"A method for detecting pathogens using the microfluidic device.\",\n        \"A system for point-of-care diagnostics utilizing the microfluidic device.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68232", "text": "{\n    \"patent_title\": \"Implantable Cardiac Pacemaker with Enhanced Battery Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-01-15\",\n    \"filing_date\": \"2017-01-14\",\n    \"issue_date\": \"2020-11-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac pacemaker with an improved battery life achieved through optimized power management circuitry and a novel electrode design. This pacemaker provides reliable pacing for patients with bradycardia, addressing a critical need in cardiac care.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Previous pacemaker designs\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable cardiac pacemaker with a battery life of at least 10 years.\",\n        \"A power management circuit for optimizing battery usage in a cardiac pacemaker.\",\n        \"An electrode design for improved pacing efficiency.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68233", "text": "{\n    \"patent_title\": \"Improved Contrast Enhancement for Low-Dose CT Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel algorithm for enhancing contrast in low-dose computed tomography (CT) images, leading to improved diagnostic accuracy while reducing radiation exposure. The algorithm utilizes a deep learning approach to remove noise and artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Prior art on image denoising\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing contrast in CT images comprising...\",\n        \"A system for processing CT images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68233", "text": "{\n    \"patent_title\": \"Medical Image Analysis System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carl Schmidt\",\n            \"affiliation\": \"Siemens Healthineers\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Siemens Corporate Research\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-03-15\",\n    \"filing_date\": \"2022-03-15\",\n    \"issue_date\": \"2024-02-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An integrated system for analyzing medical images, including features for image segmentation, object detection, and diagnosis. The system is designed for use in a clinical setting.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"relevance\": \"Related to image segmentation techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A system for analyzing medical images comprising...\",\n        \"A method for segmenting objects in medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68234", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-09-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized, fully implantable biosensor for continuous glucose monitoring. The device utilizes a novel enzymatic reaction and microfabrication techniques to provide highly accurate and reliable glucose readings with minimal invasiveness. The system is designed for long-term implantation and wireless data transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related glucose monitoring technology\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable biosensor comprising...\",\n        \"A method for continuous glucose monitoring using...\",\n        \"A wireless communication system for transmitting glucose data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68234", "text": "{\n    \"patent_title\": \"Improved Syringe Design for Insulin Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"State University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-01-10\",\n    \"filing_date\": \"2018-01-10\",\n    \"issue_date\": \"2021-05-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved syringe design for more accurate and comfortable insulin delivery. The syringe incorporates ergonomic features and a graduated scale for precise dosage measurement.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art syringe design\"\n        },\n        {\n            \"patent_number\": \"US65432109B1\",\n            \"relevance\": \"Related insulin delivery systems\"\n        },\n        {\n            \"patent_number\": \"US54321098B2\",\n            \"relevance\": \"Alternative syringe designs\"\n        }\n    ],\n    \"claims\": [\n        \"A syringe comprising an ergonomic grip...\",\n        \"A graduated scale for precise dosage...\",\n        \"A plunger mechanism for controlled insulin delivery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68235", "text": "{\n    \"patent_title\": \"Enhanced MRI Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for reconstructing high-resolution MRI images using deep learning techniques. The method significantly reduces scan time and improves image clarity, leading to more accurate diagnoses. This cutting-edge technology has broad applications in various medical imaging scenarios.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on image reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68235", "text": "{\n    \"patent_title\": \"Targeted Drug Delivery System Using MRI Guidance\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2015-11-10\",\n    \"filing_date\": \"2015-11-10\",\n    \"issue_date\": \"2017-05-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system for targeted drug delivery using MRI guidance combined with radiation therapy to precisely deliver therapeutic agents to tumor sites. The system utilizes real-time MRI feedback to optimize drug deposition and minimize damage to healthy tissue.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\",\n            \"relevance\": \"Prior art on drug delivery systems\"\n        }\n    ],\n    \"claims\": [\n        \"A system for targeted drug delivery comprising...\",\n        \"A method for delivering therapeutic agents using MRI guidance...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68236", "text": "{\n    \"patent_title\": \"Enhanced MRI Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-11-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing high-resolution MRI images using a deep convolutional neural network, leading to improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68236", "text": "{\n    \"patent_title\": \"Improved CT Scanning Technique for Lung Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"CN123456789A\",\n    \"priority_date\": \"2018-05-20\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2020-01-10\",\n    \"patent_office\": \"CNIPA\",\n    \"abstract\": \"A new technique for CT scanning that improves the detection rate of lung cancer nodules.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for performing CT scanning of the lungs comprising...\",\n        \"A system for detecting lung cancer nodules...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68237", "text": "{\n    \"patent_title\": \"Enhanced Magnetic Resonance Imaging with Artificial Intelligence Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-01-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for improving the resolution and clarity of magnetic resonance images using artificial intelligence-based image reconstruction algorithms. This invention enhances diagnostic capabilities across a broad range of medical conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8780543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing magnetic resonance images comprising...\",\n        \"An apparatus for performing magnetic resonance imaging...\",\n        \"A system for diagnosing medical conditions using reconstructed images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68237", "text": "{\n    \"patent_title\": \"Automated X-Ray Analysis for Pneumonia Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Sarah Johnson\",\n            \"affiliation\": \"Hospital Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-07-20\",\n    \"filing_date\": \"2017-07-20\",\n    \"issue_date\": \"2021-05-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for detecting pneumonia from X-ray images using computer vision techniques. The system is specifically designed for rapid and accurate diagnosis of pneumonia.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9234567B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for detecting pneumonia comprising...\",\n        \"A method for analyzing X-ray images...\",\n        \"A computer-implemented method for identifying pneumonia...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68238", "text": "{\n    \"patent_title\": \"Miniaturized Robotic Surgical System with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized robotic surgical system designed for enhanced precision in minimally invasive procedures. The system incorporates novel micro-actuators and real-time imaging feedback to improve surgical outcomes. This builds upon existing advancements in cardiovascular stent delivery systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8562489B2\",\n            \"title\": \"Cardiovascular Stent Delivery System\"\n        },\n        {\n            \"patent_number\": \"US9125763B2\",\n            \"title\": \"Minimally Invasive Surgical Instrument\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system comprising...\",\n        \"A method for performing a minimally invasive surgical procedure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68238", "text": "{\n    \"patent_title\": \"Improved Method for External Cardiac Pacemaker Operation\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Wilson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2014-11-01\",\n    \"filing_date\": \"2014-11-01\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved method for operating an external cardiac pacemaker, enhancing battery life and signal clarity. The system utilizes advanced algorithms for pulse generation and synchronization.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Cardiac Pacemaker with Adaptive Pacing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for operating a cardiac pacemaker...\",\n        \"A system for providing pacing signals...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68239", "text": "{\n    \"patent_title\": \"Enhanced Resolution Medical Imaging System Utilizing Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel medical imaging system incorporating deep learning algorithms to enhance image resolution and clarity. The system provides improved diagnostic capabilities for various medical conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"filing_date\": \"2018-05-10\"\n        },\n        {\n            \"patent_number\": \"US11234567B2\",\n            \"filing_date\": \"2019-11-22\"\n        }\n    ],\n    \"claims\": [\n        \"A medical imaging system comprising a deep learning module for image enhancement.\",\n        \"The system of claim 1, wherein the deep learning module utilizes a convolutional neural network.\",\n        \"A method for enhancing medical images using the system of claim 1.\",\n        \"The method of claim 3, wherein the image enhancement improves diagnostic accuracy.\",\n        \"The system of claim 1, further comprising a user interface for displaying the enhanced images.\",\n        \"The system of claim 1, further comprising a module for image segmentation.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68239", "text": "{\n    \"patent_title\": \"Computed Tomography Image Reconstruction Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"University of Michigan\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2020-06-01\",\n    \"filing_date\": \"2020-06-01\",\n    \"issue_date\": \"2022-12-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for reconstructing images from computed tomography data, improving speed and reducing artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US5432109B1\",\n            \"filing_date\": \"1995-01-05\"\n        },\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"filing_date\": \"1998-07-14\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"filing_date\": \"2001-09-28\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing images from computed tomography data.\",\n        \"The method of claim 1, wherein the reconstruction algorithm utilizes iterative techniques.\",\n        \"A system for performing computed tomography imaging.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68240", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Electrolyte for Improved Energy Density\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Tesla Inc.\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-04-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a lithium-ion battery with a novel electrolyte composition that significantly enhances energy density and cycle life, making it ideal for electric vehicle and grid-scale energy storage applications. The electrolyte minimizes degradation and improves overall battery performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition...\",\n        \"A method for improving battery performance...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68240", "text": "{\n    \"patent_title\": \"Improved Lead-Acid Battery with Enhanced Charging Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"Exide Technologies\"\n        },\n        {\n            \"name\": \"Eve Martinez\",\n            \"affiliation\": \"Johnson Controls\"\n        }\n    ],\n    \"patent_number\": \"US8987654B1\",\n    \"priority_date\": \"2014-11-15\",\n    \"filing_date\": \"2014-11-15\",\n    \"issue_date\": \"2016-03-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents an improved lead-acid battery featuring a novel charging algorithm that extends battery life and optimizes performance. The algorithm reduces sulfation and improves charge acceptance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A lead-acid battery comprising...\",\n        \"A charging algorithm...\",\n        \"A method for extending battery life...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68241", "text": "{\n    \"patent_title\": \"Method and System for Enhancing Image Clarity using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-12-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for enhancing the clarity and resolution of digital images using deep learning techniques. The system employs a convolutional neural network trained on a large dataset of images to remove noise and artifacts, resulting in improved image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image clarity comprising...\",\n        \"A system for processing digital images to improve resolution...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68241", "text": "{\n    \"patent_title\": \"MRI Image Reconstruction Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-09-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for reconstructing high-quality images from MRI data, utilizing a novel algorithm to reduce noise and improve spatial resolution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for processing MRI data to enhance image clarity...\",\n        \"The method of claim 1, wherein the MRI images are used for diagnostic purposes.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68242", "text": "{\n    \"patent_title\": \"AI-Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2018-05-10\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2023-12-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method for medical image reconstruction using artificial intelligence techniques, specifically deep convolutional neural networks. The method improves image quality and reduces radiation exposure for patients undergoing CT scans.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for implementing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68242", "text": "{\n    \"patent_title\": \"Improved X-Ray Tube Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US7543210B1\",\n    \"priority_date\": \"2010-01-20\",\n    \"filing_date\": \"2011-07-15\",\n    \"issue_date\": \"2013-05-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved design for X-ray tubes, enhancing their efficiency and lifespan. The new design incorporates a novel cooling mechanism and filament material.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US4500000\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube comprising...\",\n        \"A cooling system for an X-ray tube...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68243", "text": "{\n    \"patent_title\": \"Method and System for Real-Time Anomaly Detection in Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-09-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A method and system for detecting anomalies in medical images using deep learning techniques. The system identifies regions of interest and flags potential abnormalities in real-time, improving diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting anomalies in medical images...\",\n        \"A system comprising a deep learning model...\",\n        \"The system of claim 1, wherein the medical images are X-ray images.\",\n        \"The method of claim 1, further comprising...\",\n        \"The method of claim 2, wherein the anomaly is a tumor.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68243", "text": "{\n    \"patent_title\": \"Image Compression Technique Using Wavelet Transform\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"EP3456789B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-08-25\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"A novel image compression technique based on wavelet transform for efficient storage and transmission of digital images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image...\",\n        \"A system for decompressing an image...\",\n        \"The method of claim 1, wherein the wavelet transform is a Daubechies wavelet.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68244", "text": "{\n    \"patent_title\": \"Method for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing medical images from limited data, resulting in improved image clarity and reduced noise.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Prior art in image reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"The method of claim 1, wherein the medical image is a CT scan...\",\n        \"The method of claim 1, wherein the medical image is an MRI...\",\n        \"A system for performing the method of claim 1...\",\n        \"The system of claim 4, comprising a processor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68244", "text": "{\n    \"patent_title\": \"Advanced Medical Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"Diana Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-04-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An advanced medical imaging system utilizing multiple modalities for comprehensive diagnostic imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US12345678B2\",\n            \"relevance\": \"Related technology in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A medical imaging system comprising...\",\n        \"The system of claim 1, further comprising...\",\n        \"The system of claim 2, wherein...\",\n        \"A method for operating the system of claim 1...\",\n        \"The method of claim 4, comprising the steps of...\",\n        \"The system of claim 1, capable of performing...\",\n        \"The system of claim 6, including a user interface...\",\n        \"The user interface of claim 7, displaying...\",\n        \"The system of claim 1, utilizing artificial intelligence...\",\n        \"The artificial intelligence of claim 9, trained on...\",\n        \"The system of claim 1, incorporating feedback mechanisms...\",\n        \"The feedback mechanisms of claim 11, adjusting...\",\n        \"The system of claim 1, implementing data encryption...\",\n        \"The data encryption of claim 13, adhering to...\",\n        \"The system of claim 1, enabling remote diagnostics...\",\n        \"The remote diagnostics of claim 15, utilizing secure protocols...\",\n        \"The system of claim 1, configured for personalized medicine...\",\n        \"The personalized medicine of claim 17, based on genomic data...\",\n        \"The system of claim 1, integrating with electronic health records...\",\n        \"The integration of claim 19, complying with HIPAA standards...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68245", "text": "{\n    \"patent_title\": \"Improved MRI Reconstruction for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel magnetic resonance imaging (MRI) reconstruction algorithm that significantly improves image clarity, enabling earlier and more accurate detection of cancerous tumors. The technique leverages deep learning to reduce noise and enhance contrast, leading to improved diagnostic capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"MRI Image Enhancement\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"The method of claim 1, wherein the deep learning model is...\",\n        \"A system for performing MRI reconstruction...\",\n        \"The system of claim 3, further comprising...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The computer-readable medium of claim 5, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68245", "text": "{\n    \"patent_title\": \"Enhanced X-ray System Calibration\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2019-11-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved calibration method for X-ray imaging systems, increasing accuracy and reducing radiation exposure. The method involves a novel algorithm for automatically adjusting the X-ray beam parameters.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\",\n            \"title\": \"X-ray Calibration Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for calibrating an X-ray imaging system comprising...\",\n        \"The method of claim 1, wherein the algorithm utilizes...\",\n        \"An X-ray imaging system calibrated according to...\",\n        \"The system of claim 3, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68246", "text": "{\n    \"patent_title\": \"MRI Enhancement Using Targeted Nanoparticles\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A method for enhancing Magnetic Resonance Imaging (MRI) contrast using targeted nanoparticles, allowing for improved visualization of tumors without invasive procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI contrast...\",\n        \"The method of claim 1, wherein the nanoparticles are targeted to tumor cells...\",\n        \"A composition comprising the nanoparticles...\",\n        \"The composition of claim 3, further comprising...\",\n        \"A diagnostic kit comprising the composition...\",\n        \"A method of diagnosing cancer comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68246", "text": "{\n    \"patent_title\": \"X-Ray Imaging System with Improved Resolution\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University College London\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"University College London\"\n        }\n    ],\n    \"patent_number\": \"EP3456789B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-08-10\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"An X-ray imaging system with improved spatial resolution achieved through novel detector technology and image processing algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"The system of claim 1, wherein the detector is a flat-panel detector...\",\n        \"A method for improving image resolution in an X-ray imaging system...\",\n        \"The method of claim 3, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68247", "text": "{\n    \"patent_title\": \"Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable biosensor for continuous glucose monitoring with improved accuracy and biocompatibility. The sensor utilizes a novel enzymatic reaction and wireless communication protocol.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Glucose Sensor System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for continuously monitoring glucose levels in a patient.\",\n        \"An implantable biosensor comprising a glucose oxidase enzyme.\",\n        \"A wireless communication system for transmitting glucose data.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68247", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Johnson & Johnson\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Johnson & Johnson\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical stapler with an improved ergonomic design for enhanced surgeon comfort and precision. The stapler features a lightweight handle and optimized staple cartridge.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Surgical Stapling Device\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an ergonomic handle.\",\n        \"A staple cartridge with improved staple alignment.\",\n        \"A method for performing surgical stapling.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68248", "text": "{\n    \"patent_title\": \"Minimally Invasive Tissue Ablation Device with Integrated Cooling\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a minimally invasive device for precise tissue ablation using focused energy. Integrated cooling mechanisms prevent collateral damage to surrounding tissues. The device is designed for a variety of surgical applications including tumor removal and scar revision.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on tissue ablation techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A device for minimally invasive tissue ablation, comprising...\",\n        \"The device of claim 1, further comprising an integrated cooling system...\",\n        \"The device of claim 2, wherein the cooling system utilizes...\",\n        \"A method for ablating tissue using the device of claim 1...\",\n        \"The method of claim 4, wherein the energy source is focused ultrasound...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68248", "text": "{\n    \"patent_title\": \"Surgical Robotic System with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Intuitive Surgical\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Johns Hopkins University\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2021-02-01\",\n    \"filing_date\": \"2021-04-15\",\n    \"issue_date\": \"2023-06-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a surgical system employing robotic arms with advanced sensors and control algorithms for enhanced precision during minimally invasive procedures. The system includes a console for surgeon control and a patient-side cart housing the robotic arms and instruments.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art in robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic system comprising...\",\n        \"The system of claim 1, further comprising a console...\",\n        \"The system of claim 2, wherein the console provides...\",\n        \"A method for performing surgery using the system of claim 1...\",\n        \"The method of claim 4, wherein the robotic arms are controlled...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68249", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Pressure Sensor for Glaucoma Management\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"MedTech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"MedTech Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-06-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable pressure sensor for continuous monitoring of intraocular pressure in glaucoma patients, enabling personalized treatment adjustments and improved patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in implantable sensors\"\n        },\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"Related technology in pressure monitoring\"\n        },\n        {\n            \"patent_number\": \"US11000001B2\",\n            \"relevance\": \"Comparative glaucoma treatment methods\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable pressure sensor comprising...\",\n        \"A system for continuous intraocular pressure monitoring...\",\n        \"A method for personalized glaucoma treatment...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68249", "text": "{\n    \"patent_title\": \"Novel Biomaterial Scaffold for Tissue Regeneration\",\n    \"inventors\": [\n        {\n            \"name\": \"Professor Emily Chen\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11555555B2\",\n    \"priority_date\": \"2021-11-01\",\n    \"filing_date\": \"2022-01-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel biomaterial scaffold designed to promote tissue regeneration in damaged organs, offering potential for improved patient recovery. The scaffold is constructed from a biodegradable polymer matrix.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9999999B2\",\n            \"relevance\": \"Prior art in biodegradable polymers\"\n        }\n    ],\n    \"claims\": [\n        \"A biomaterial scaffold comprising...\",\n        \"A method for promoting tissue regeneration...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68250", "text": "{\n    \"patent_title\": \"Adaptive Comfort System for Prolonged Medical Implants\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel medical implant incorporating a dynamic comfort adjustment system.  This system uses biofeedback to optimize implant fit and minimize patient discomfort, leading to improved long-term outcomes and adherence to treatment.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A medical implant comprising a dynamic adjustment mechanism.\",\n        \"A system for monitoring patient comfort levels.\",\n        \"A method for optimizing implant fit based on biofeedback.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68250", "text": "{\n    \"patent_title\": \"Advanced Vascular Stent Design\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Medtronic\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"Medtronic\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2022-12-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved vascular stent design providing enhanced flow dynamics and reduced risk of restenosis. This stent utilizes a novel alloy composition and geometric configuration to optimize performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A vascular stent comprising a specific alloy composition.\",\n        \"A stent with a geometrically optimized configuration.\",\n        \"A method for deploying a vascular stent.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68251", "text": "{\n    \"patent_title\": \"Miniature Robotic Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-03-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature robotic surgical system utilizing fiber optic technology for high-resolution visualization and precise manipulation within confined anatomical spaces. The system is designed for minimally invasive procedures, reducing patient trauma and recovery time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Remote Surgical Control System\"\n        },\n        {\n            \"patent_number\": \"US9120876B2\",\n            \"title\": \"Flexible Endoscope with Improved Imaging\"\n        },\n        {\n            \"patent_number\": \"US7981234B2\",\n            \"title\": \"Micro-Robotic Devices for Medical Applications\"\n        },\n        {\n            \"patent_number\": \"US8454678B2\",\n            \"title\": \"Surgical Instrument Tracking System\"\n        },\n        {\n            \"patent_number\": \"US10000001B2\",\n            \"title\": \"Haptic Feedback System for Robotic Surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system comprising a miniature robotic arm...\",\n        \"The system of claim 1, further comprising a fiber optic endoscope...\",\n        \"A method for performing a minimally invasive surgical procedure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68251", "text": "{\n    \"patent_title\": \"Implantable Cardiovascular Stent with Drug Elution Coating\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Jones\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Maria Garcia\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiovascular stent coated with a drug-eluting polymer to prevent restenosis after percutaneous coronary intervention. The stent is designed to expand within narrowed coronary arteries, restoring blood flow.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7541012B2\",\n            \"title\": \"Drug-Eluting Stent Design\"\n        },\n        {\n            \"patent_number\": \"US8236024B2\",\n            \"title\": \"Biodegradable Polymer Coatings\"\n        },\n        {\n            \"patent_number\": \"US9126789B2\",\n            \"title\": \"Stent Delivery System\"\n        },\n        {\n            \"patent_number\": \"US6890532B2\",\n            \"title\": \"Coronary Stent Material\"\n        },\n        {\n            \"patent_number\": \"US8545783B2\",\n            \"title\": \"Stent Expansion Mechanism\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiovascular stent comprising a metallic framework...\",\n        \"The stent of claim 1, further comprising a drug-eluting coating...\",\n        \"A method for treating coronary artery disease...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68252", "text": "{\n    \"patent_title\": \"Enhanced Resolution Medical Imaging System Using Adaptive Filtering\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A medical imaging system employing adaptive filtering techniques to enhance image resolution and diagnostic accuracy. The system reduces noise and artifacts, resulting in clearer images for improved diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8213123B2\",\n            \"relevance\": \"Prior art in image filtering\"\n        }\n    ],\n    \"claims\": [\n        \"A medical imaging system comprising...\",\n        \"An adaptive filtering module for noise reduction...\",\n        \"A method for enhancing image resolution...\",\n        \"The system of claim 1, wherein the adaptive filter...\",\n        \"The method of claim 3, further comprising...\",\n        \"A user interface for displaying the enhanced image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68252", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University College London\"\n        }\n    ],\n    \"patent_number\": \"EP3456789B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-01-10\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"A novel contrast agent for magnetic resonance imaging, exhibiting improved signal enhancement and biocompatibility. The agent enhances image contrast, allowing for more precise diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"The contrast agent of claim 1, wherein...\",\n        \"A method for enhancing MRI images...\",\n        \"The method of claim 3, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68253", "text": "{\n    \"patent_title\": \"Enhanced Image Reconstruction Method for PET Scanners\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2023-05-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image reconstruction method for Positron Emission Tomography (PET) scanners is disclosed, improving image quality and reducing scan time. The method employs advanced statistical modeling and iterative algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Prior Art PET Reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an image from PET data, comprising...\",\n        \"The method of claim 1, wherein the statistical model is a Poisson model.\",\n        \"The method of claim 2, further comprising...\",\n        \"A system for performing the method of claim 1.\",\n        \"The system of claim 4, comprising a computer processor...\",\n        \"A non-transitory computer-readable medium...\",\n        \"...\",\n        \"A method of improving diagnostic accuracy...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68253", "text": "{\n    \"patent_title\": \"MRI Pulse Sequence Optimization\",\n    \"inventors\": [\n        {\n            \"name\": \"Hans Schmidt\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        },\n        {\n            \"name\": \"Greta Muller\",\n            \"affiliation\": \"Siemens AG\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2020-07-20\",\n    \"filing_date\": \"2020-07-20\",\n    \"issue_date\": \"2022-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved MRI pulse sequence is presented, offering faster scan times and enhanced contrast. The pulse sequence optimizes excitation and refocusing angles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Conventional MRI Pulse Sequence\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI pulse sequence comprising...\",\n        \"The pulse sequence of claim 1, characterized by...\",\n        \"A method for performing MRI using the pulse sequence of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68254", "text": "{\n    \"patent_title\": \"High-Resolution Molecular Contrast Imaging with Targeted Nanoparticles\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-11-20\",\n    \"issue_date\": \"2021-04-13\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method for high-resolution molecular imaging using targeted nanoparticles as contrast agents. The nanoparticles enhance image clarity, enabling early detection of cancerous tumors.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on nanoparticle synthesis\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution in biomedical imaging.\",\n        \"A contrast agent comprising targeted nanoparticles for early disease detection.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68254", "text": "{\n    \"patent_title\": \"MRI Imaging System with Improved Gradient Coils\",\n    \"inventors\": [\n        {\n            \"name\": \"Klaus Schmidt\",\n            \"affiliation\": \"Siemens Healthineers\"\n        },\n        {\n            \"name\": \"Anna Weber\",\n            \"affiliation\": \"Siemens AG\"\n        }\n    ],\n    \"patent_number\": \"EP3876543A1\",\n    \"priority_date\": \"2020-02-01\",\n    \"filing_date\": \"2020-08-10\",\n    \"issue_date\": \"2021-09-29\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"An MRI imaging system incorporating improved gradient coils for faster scan times and reduced artifacts. Offers enhancements in standard MRI procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related to gradient coil technology\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI system comprising improved gradient coils.\",\n        \"A method for reducing scan time in MRI.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68255", "text": "{\n    \"patent_title\": \"AI-Powered Medical Image Analysis for Lung Nodule Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for automated detection of lung nodules in CT scans using deep learning algorithms. The system employs a convolutional neural network trained on a large dataset of annotated images, improving the accuracy and efficiency of diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"High\"\n        },\n        {\n            \"patent_number\": \"US10234567B2\",\n            \"relevance\": \"Medium\"\n        },\n        {\n            \"patent_number\": \"US11111111B2\",\n            \"relevance\": \"High\"\n        },\n        {\n            \"patent_number\": \"US12222222B2\",\n            \"relevance\": \"Medium\"\n        },\n        {\n            \"patent_number\": \"US13333333B2\",\n            \"relevance\": \"High\"\n        },\n        {\n            \"patent_number\": \"US14444444B2\",\n            \"relevance\": \"Medium\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting lung nodules in CT scans using a convolutional neural network.\",\n        \"A system comprising a computer and a deep learning model for image analysis.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68255", "text": "{\n    \"patent_title\": \"Cardiac Imaging Enhancement with AI\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Mayo Clinic\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11555555B2\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-14\",\n    \"issue_date\": \"2021-08-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method for improving the clarity of echocardiograms using artificial intelligence to reduce noise and enhance signal quality. It specifically targets improving the visualization of cardiac structures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10876543B2\",\n            \"relevance\": \"Low\"\n        },\n        {\n            \"patent_number\": \"US99999999B1\",\n            \"relevance\": \"Medium\"\n        },\n        {\n            \"patent_number\": \"US10101010B2\",\n            \"relevance\": \"Low\"\n        },\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"relevance\": \"Medium\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing echocardiogram images using a noise reduction algorithm.\",\n        \"A system for displaying improved cardiac images.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68256", "text": "{\n    \"patent_title\": \"AI-Enhanced MRI Reconstruction for Improved Diagnostic Accuracy\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Chen\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for Magnetic Resonance Image (MRI) reconstruction utilizing artificial intelligence techniques. Specifically, a deep convolutional neural network is trained to reduce noise and artifacts in MRI scans, resulting in significantly improved image clarity and diagnostic accuracy. The method demonstrates a 20% reduction in false negatives in early-stage cancer detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI image reconstruction...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68256", "text": "{\n    \"patent_title\": \"Improved X-Ray Detector for Bone Fracture Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Miller\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2019-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel X-ray detector designed to enhance the visualization of bone fractures. The detector utilizes a new scintillator material and improved signal processing techniques to deliver clearer images. It does not employ artificial intelligence or machine learning.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous X-ray detector designs\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray detector comprising...\",\n        \"A method for detecting bone fractures using...\",\n        \"A system for producing X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68257", "text": "{\n    \"patent_title\": \"Novel Contrast Agent Enhanced MRI for Early-Stage Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel contrast agent formulation for magnetic resonance imaging (MRI) that significantly enhances the detection of small tumors. The contrast agent is designed to selectively accumulate in tumor tissues, providing improved image clarity and enabling earlier diagnosis. This method demonstrably improves diagnostic accuracy and can be integrated into existing clinical workflows.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent composition comprising...\",\n        \"A method for detecting tumors using the contrast agent...\",\n        \"An MRI apparatus configured to utilize the contrast agent...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68257", "text": "{\n    \"patent_title\": \"Improved Method for Image Reconstruction in CT Scanners\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US11321098B2\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2022-01-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved algorithm for reconstructing images from computed tomography (CT) scans. The algorithm reduces noise and artifacts, resulting in higher quality images. This represents an incremental improvement to existing reconstruction techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing images from CT data...\",\n        \"A CT scanner incorporating the reconstruction algorithm...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68258", "text": "{\n    \"patent_title\": \"Surgical Robotic System with Enhanced Precision and Haptic Feedback\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-08-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a surgical robotic system designed to enhance surgical precision and provide real-time haptic feedback to the surgeon. The system utilizes advanced sensors and algorithms to enable minimally invasive procedures with improved accuracy and reduced patient trauma. It features a novel end-effector design and a user-intuitive control interface.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Robotic Surgical Assistant\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic system comprising...\",\n        \"A method for performing a surgical procedure using...\",\n        \"An end-effector for a surgical robot...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68258", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Cardiovascular Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11543210B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-04-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved catheter design for accessing and treating cardiovascular conditions. The catheter features a flexible tip and enhanced maneuverability.  The device allows for precise placement of therapeutic agents within blood vessels.  It’s particularly useful in treating atherosclerosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Flexible Catheter with Steering Mechanism\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising...\",\n        \"A method for treating cardiovascular disease...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68259", "text": "{\n    \"patent_title\": \"Enhanced Image Reconstruction for MRI using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2019-10-29\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a significant advancement in medical image reconstruction, specifically for Magnetic Resonance Imaging (MRI). A deep learning approach is utilized to enhance image quality and reduce scan time, leading to improved diagnostic accuracy. The method demonstrates superior performance compared to traditional reconstruction techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Prior Art MRI Reconstruction Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI reconstruction...\",\n        \"A non-transitory computer-readable medium storing...\",\n        \"The method of claim 1, wherein the deep learning model...\",\n        \"The system of claim 2, further comprising...\",\n        \"The method of claim 3, wherein the image quality is enhanced...\",\n        \"The system of claim 4, wherein the scan time is reduced...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68259", "text": "{\n    \"patent_title\": \"Color Correction Algorithm for Digital Photographs\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US8901234B1\",\n    \"priority_date\": \"2016-01-20\",\n    \"filing_date\": \"2016-01-20\",\n    \"issue_date\": \"2017-07-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an algorithm for automatically adjusting the color balance in digital photographs. The algorithm improves image aesthetics by enhancing color saturation and contrast.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Early Color Correction Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for correcting color in a digital image...\",\n        \"A system for performing color correction...\",\n        \"A computer-readable medium storing...\",\n        \"The method of claim 1, wherein the color saturation...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68260", "text": "{\n    \"patent_title\": \"Deep Learning System for Anomaly Detection in Time Series Data\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-06-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for identifying anomalous patterns in time series data, with applications in fraud detection and predictive maintenance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for anomaly detection comprising a recurrent neural network.\",\n        \"A method for training said recurrent neural network.\",\n        \"A computer-readable medium storing instructions for executing said method.\",\n        \"The system of claim 1, wherein the recurrent neural network is a LSTM.\",\n        \"The method of claim 2, wherein the training data is labeled.\",\n        \"The system of claim 1, further comprising a visualization module.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68260", "text": "{\n    \"patent_title\": \"Improved Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2020-05-01\",\n    \"filing_date\": \"2020-08-15\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An efficient algorithm for compressing data, reducing storage requirements and transmission bandwidth.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising encoding data using a Huffman tree.\",\n        \"A computer-readable medium storing instructions for executing said method.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68261", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for enhancing the resolution and clarity of magnetic resonance images. The invention utilizes a new pulse sequence and reconstruction algorithm to reduce noise and artifacts, leading to improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321\",\n            \"kind\": \"US Patent\"\n        },\n        {\n            \"publication_number\": \"WO2014001234\",\n            \"kind\": \"Patent Application\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing magnetic resonance imaging comprising...\",\n        \"A system for performing magnetic resonance imaging comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68261", "text": "{\n    \"patent_title\": \"Improved X-Ray Detector\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2017-08-10\",\n    \"filing_date\": \"2017-08-10\",\n    \"issue_date\": \"2020-11-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved X-ray detector with enhanced sensitivity and reduced radiation exposure. The detector utilizes a novel scintillator material and readout electronics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210\",\n            \"kind\": \"US Patent\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray detector comprising...\",\n        \"A method for detecting X-rays comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68262", "text": "{\n    \"patent_title\": \"Surgical Robotic System with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-20\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"A surgical robotic system designed for minimally invasive procedures, providing enhanced precision and dexterity compared to traditional laparoscopic surgery. The system utilizes advanced sensor feedback and image guidance techniques to improve surgical outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Laparoscopic Surgical Instrument\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic system comprising...\",\n        \"A method for performing a minimally invasive surgical procedure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68262", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Cardiovascular Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2015-12-01\",\n    \"filing_date\": \"2015-12-01\",\n    \"issue_date\": \"2017-08-10\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A novel catheter design for improved navigation and delivery of therapeutic agents in cardiovascular procedures. The catheter features a flexible tip and enhanced biocompatibility.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Cardiovascular Catheter with Steering Mechanism\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising...\",\n        \"A method for delivering therapeutic agents using the catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68263", "text": "{\n    \"patent_title\": \"Minimally Invasive Cardiac Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology, Biomedical Engineering Department\"\n        },\n        {\n            \"name\": \"Robert Williams\",\n            \"affiliation\": \"Harvard Medical School, Cardiology Division\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel system for continuous cardiac monitoring using a minimally invasive sensor, designed to improve early detection of arrhythmias and reduce patient morbidity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Implantable Cardiac Pacemaker\"\n        }\n    ],\n    \"claims\": [\n        \"A minimally invasive cardiac sensor comprising...\",\n        \"A method for continuous cardiac monitoring...\",\n        \"A system for detecting and alerting to arrhythmias...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68263", "text": "{\n    \"patent_title\": \"New Type of Stent\",\n    \"inventors\": [\n        {\n            \"name\": \"Li Wei\",\n            \"affiliation\": \"Shanghai Jiao Tong University, Biomedical Engineering\"\n        },\n        {\n            \"name\": \"Zhang Mei\",\n            \"affiliation\": \"Huazhong University of Science and Technology, Cardiology\"\n        }\n    ],\n    \"patent_number\": \"CN112233445A\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2021-11-15\",\n    \"patent_office\": \"SIPO\",\n    \"abstract\": \"A novel stent design for improving blood flow in coronary arteries. This stent is made from a bioabsorbable polymer and coated with a drug-eluting material.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Drug-Eluting Stent\"\n        }\n    ],\n    \"claims\": [\n        \"A stent comprising a bioabsorbable polymer...\",\n        \"A drug-eluting coating for a stent...\",\n        \"A method for treating coronary artery disease...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68264", "text": "{\n    \"patent_title\": \"Novel Photoacoustic Imaging System for Enhanced Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel photoacoustic imaging system utilizing pulsed laser excitation and advanced signal processing to achieve high-resolution, deep-tissue imaging for early cancer detection. The system incorporates a unique transducer design and a novel reconstruction algorithm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in photoacoustic imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A photoacoustic imaging system comprising...\",\n        \"A method for detecting cancerous tissue using...\",\n        \"A transducer for generating photoacoustic signals...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68264", "text": "{\n    \"patent_title\": \"Image Analysis Software for Automated Tumor Segmentation\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-09-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"Software for the automated segmentation of tumors in medical images, utilizing deep learning algorithms and convolutional neural networks. This software improves the efficiency and accuracy of tumor analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11234567B2\",\n            \"relevance\": \"Related work in medical image analysis\"\n        }\n    ],\n    \"claims\": [\n        \"A computer-implemented method for segmenting tumors...\",\n        \"A software application comprising a deep learning model...\",\n        \"A system for analyzing medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68265", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Enhanced Patient Comfort\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel catheter design incorporating flexible materials and a reduced diameter tip to minimize discomfort during insertion and use. The catheter features a hydrophilic coating for improved lubricity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art relating to catheter materials\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible shaft...\",\n        \"The catheter of claim 1, further comprising a hydrophilic coating...\",\n        \"The catheter of claim 1, wherein the diameter of the tip is less than 1.5mm...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68265", "text": "{\n    \"patent_title\": \"Surgical Robot with Advanced Imaging Capabilities\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Intuitive Surgical\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2020-03-10\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2023-07-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical robotic system integrating high-resolution 3D imaging and precise robotic arms for minimally invasive surgery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art relating to robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic system comprising a robotic arm...\",\n        \"The surgical robotic system of claim 1, further comprising a 3D imaging module...\",\n        \"The surgical robotic system of claim 1, wherein the robotic arm is controlled by a surgeon...\",\n        \"The surgical robotic system of claim 2, wherein the 3D imaging module utilizes optical coherence tomography...\",\n        \"The surgical robotic system of claim 3, wherein the surgeon controls the robotic arm remotely...\",\n        \"The surgical robotic system of claim 4, wherein the optical coherence tomography provides real-time tissue imaging...\",\n        \"The surgical robotic system of claim 5, wherein the remote control interface includes force feedback...\",\n        \"The surgical robotic system of claim 6, wherein the tissue imaging has a resolution of at least 100 microns...\",\n        \"The surgical robotic system of claim 7, wherein the force feedback allows the surgeon to feel the resistance of the tissue...\",\n        \"The surgical robotic system of claim 8, wherein the system is capable of performing complex surgical procedures...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68266", "text": "{\n    \"patent_title\": \"Method and System for Automated Tumor Detection in Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-10\",\n    \"filing_date\": \"2011-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method and system for the automated detection of tumors in medical images, such as CT scans and MRIs, utilizing deep learning techniques. The system significantly improves diagnostic accuracy and reduces radiologist workload.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting tumors in a medical image comprising...\",\n        \"A system for automated tumor detection...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68266", "text": "{\n    \"patent_title\": \"Image Enhancement Technique for Satellite Imagery\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"TechCorp Inc.\"\n        },\n        {\n            \"name\": \"David Green\",\n            \"affiliation\": \"TechCorp Inc.\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2012-03-01\",\n    \"filing_date\": \"2012-03-01\",\n    \"issue_date\": \"2018-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an image enhancement technique for improving the visual quality of satellite imagery, specifically addressing issues of low contrast and atmospheric distortion. It uses a novel filtering algorithm to sharpen images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing satellite imagery comprising...\",\n        \"A system for image filtering...\",\n        \"A computer-executable process for image enhancement...\",\n        \"An algorithm for improving image contrast...\",\n        \"An image enhancement apparatus...\",\n        \"A method for processing digital images...\",\n        \"An image processing system...\",\n        \"A system for real-time image enhancement...\",\n        \"A digital image processing method...\",\n        \"An image processing apparatus...\",\n        \"A technique for image correction...\",\n        \"A method for improving image clarity...\",\n        \"A method for reducing noise in images...\",\n        \"A system for image restoration...\",\n        \"A method for image compression...\",\n        \"A digital image processing device...\",\n        \"An image processing technique for video...\",\n        \"An image processing method for medical images...\",\n        \"A system for image analysis...\",\n        \"A method for feature extraction from images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68267", "text": "{\n    \"patent_title\": \"Enhanced MRI Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2020-12-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing MRI images using deep convolutional neural networks. This technique significantly reduces scan time and improves image clarity compared to traditional methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"year\": 2019\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"year\": 2018\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"A system for performing MRI image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68267", "text": "{\n    \"patent_title\": \"Improved X-ray Image Processing Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US7890123B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2017-06-13\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A digital image processing method to enhance the contrast of X-ray images. This technique improves the visibility of subtle details in radiographic images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US5678901A\",\n            \"year\": 1997\n        },\n        {\n            \"patent_number\": \"US6123456B1\",\n            \"year\": 2000\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing the contrast of an X-ray image comprising...\",\n        \"A system for processing X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68268", "text": "{\n    \"patent_title\": \"Non-Invasive Cardiac Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-10-26\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive system for continuous cardiac monitoring utilizing advanced sensor technology and data analysis algorithms to detect arrhythmias and other cardiovascular events. The system transmits data wirelessly to a remote monitoring station.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760854B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for non-invasive cardiac monitoring comprising...\",\n        \"A system for detecting arrhythmias...\",\n        \"A wireless communication module...\",\n        \"A data analysis algorithm for identifying cardiovascular events...\",\n        \"A wearable sensor configured to measure ECG signals...\",\n        \"A method for alerting medical personnel...\",\n        \"A system for real-time monitoring...\",\n        \"A non-invasive device for analyzing heart rate variability...\",\n        \"A system for generating reports on cardiovascular health...\",\n        \"A method for providing personalized feedback to patients...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68268", "text": "{\n    \"patent_title\": \"Surgical Implant for Coronary Artery Bypass\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Smith & Jones Medical\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2016-01-10\",\n    \"filing_date\": \"2017-07-20\",\n    \"issue_date\": \"2018-04-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A biocompatible surgical implant designed for use in coronary artery bypass grafting. The implant provides a stable conduit for blood flow, reducing the risk of restenosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical implant comprising...\",\n        \"A biocompatible material...\",\n        \"A conduit for blood flow...\",\n        \"A method for performing coronary artery bypass grafting...\",\n        \"An implant with a textured surface...\",\n        \"An implant with an anti-thrombogenic coating...\",\n        \"A surgical tool for implanting the device...\",\n        \"A method for assessing implant patency...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68269", "text": "{\n    \"patent_title\": \"Novel Contrast Agent for Enhanced MRI Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel contrast agent for magnetic resonance imaging (MRI) that significantly enhances image resolution and diagnostic accuracy. The contrast agent comprises nanoparticles with improved biocompatibility and targeting capabilities, offering a substantial improvement over existing gadolinium-based agents.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art contrast agent\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising nanoparticles...\",\n        \"A method for enhancing MRI image resolution using the contrast agent...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68269", "text": "{\n    \"patent_title\": \"Improved X-Ray Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        },\n        {\n            \"name\": \"Emily Chen\",\n            \"affiliation\": \"Philips Healthcare\"\n        }\n    ],\n    \"patent_number\": \"EP3123456A1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-09\",\n    \"issue_date\": \"2020-01-15\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"This invention relates to an improved X-ray imaging system with reduced radiation exposure and enhanced image quality. The system incorporates a novel detector array and image processing algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art X-ray system\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising a detector array...\",\n        \"A method for reducing radiation exposure in X-ray imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68270", "text": "{\n    \"patent_title\": \"System and Method for Object Detection in Real-Time Video Streams\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for detecting objects in real-time video streams using convolutional neural networks. The system is designed for use in autonomous vehicles and surveillance applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for object detection comprising a camera, a processor, and a memory.\",\n        \"The system of claim 1, wherein the processor is configured to execute a convolutional neural network.\",\n        \"A method for detecting objects in a video stream using a convolutional neural network.\",\n        \"The method of claim 3, wherein the video stream is from an autonomous vehicle.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68270", "text": "{\n    \"patent_title\": \"Method for Automated Cancer Cell Detection in Histological Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-03-15\",\n    \"filing_date\": \"2022-03-15\",\n    \"issue_date\": \"2024-01-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for automatically detecting cancer cells in histological images using deep learning techniques. The method improves the accuracy and efficiency of cancer diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US1012345678B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancer cells in histological images comprising a deep learning model.\",\n        \"The method of claim 1, wherein the deep learning model is a convolutional neural network.\",\n        \"A system for automated cancer cell detection.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68271", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Research\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel deep learning approach for enhancing image reconstruction quality. The method utilizes a generative adversarial network (GAN) to generate high-resolution images from low-resolution inputs. The system is applicable to various image processing tasks including satellite imagery and video enhancement.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in GAN-based image enhancement\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image reconstruction comprising...\",\n        \"A system for implementing the method...\",\n        \"The method of claim 1, wherein the generative adversarial network...\",\n        \"The system of claim 2, further comprising a...\",\n        \"A computer-readable medium storing instructions...\",\n        \"A method for improving image quality...\",\n        \"The method of claim 6, wherein the image is a satellite image...\",\n        \"A method for accelerating image processing...\",\n        \"The method of claim 8, wherein the acceleration is achieved...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68271", "text": "{\n    \"patent_title\": \"Medical Image Analysis System for Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Mayo Clinic\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of Minnesota\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2023-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for automated detection of tumors in medical images, such as X-rays and CT scans. The system uses convolutional neural networks to identify potential tumor regions and provide diagnostic assistance to medical professionals. The system focuses on detecting cancerous cells using image analysis techniques. \",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related to medical image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A system for detecting tumors in medical images comprising...\",\n        \"A method for analyzing medical images...\",\n        \"The system of claim 1, wherein the medical images are X-rays...\",\n        \"The method of claim 2, further comprising a step of...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68272", "text": "{\n    \"patent_title\": \"Robotic Surgical Instrument with Enhanced Dexterity\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A robotic surgical instrument designed for minimally invasive procedures. The instrument features multiple degrees of freedom and remote control capabilities, enabling surgeons to perform complex operations with greater precision and dexterity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art in robotic surgery.\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical instrument comprising a remote control interface.\",\n        \"A method for performing surgery using a remotely operated robotic instrument.\",\n        \"The instrument of claim 1, further comprising a haptic feedback system.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68272", "text": "{\n    \"patent_title\": \"Implantable Cardiac Pacemaker with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac pacemaker incorporating wireless communication capabilities for remote monitoring and adjustment of pacing parameters. The device is designed to improve the quality of life for patients with heart conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"Previous work in implantable cardiac devices.\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable cardiac pacemaker with wireless communication functionality.\",\n        \"A method for remotely monitoring cardiac activity using the pacemaker.\",\n        \"The pacemaker of claim 1, further comprising a battery management system.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68273", "text": "{\n    \"patent_title\": \"Improved MRI Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing MRI images using a deep convolutional neural network. This technique significantly reduces scan time and improves image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Advanced Signal Processing for MRI\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68273", "text": "{\n    \"patent_title\": \"Method for Improving CT Scan Resolution\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"EP3456789A1\",\n    \"priority_date\": \"2015-11-20\",\n    \"filing_date\": \"2015-11-20\",\n    \"issue_date\": \"2017-05-10\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"An improved method for reconstructing CT images to enhance resolution and reduce artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Image Processing Techniques for Medical Imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing CT scan resolution...\",\n        \"A system for processing CT images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68274", "text": "{\n    \"patent_title\": \"Implantable Cardiac Monitor with Remote Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MedTech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"CardioSolutions Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-11-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac monitor capable of transmitting data wirelessly to a remote server for real-time patient monitoring.  The device incorporates advanced algorithms for arrhythmia detection and prediction.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B1\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for remotely monitoring cardiac activity comprising...\",\n        \"An implantable device comprising a sensor...\",\n        \"A system for transmitting cardiac data...\",\n        \"A method for predicting arrhythmia...\",\n        \"A device for detecting atrial fibrillation...\",\n        \"A method for alerting healthcare providers...\",\n        \"A system for data analysis and reporting...\",\n        \"A device with a low power consumption...\",\n        \"A method for improving patient outcomes...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68274", "text": "{\n    \"patent_title\": \"Novel Biomaterial for Vascular Grafting\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-09-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel biodegradable polymer for use in vascular grafts, promoting endothelialization and reducing the risk of thrombosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A biodegradable polymer composition comprising...\",\n        \"A vascular graft comprising the polymer composition...\",\n        \"A method for fabricating a vascular graft...\",\n        \"A method for promoting endothelialization...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68275", "text": "{\n    \"patent_title\": \"Novel Image Enhancement Algorithm for Low-Light Medical Scans\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"EP3876543B1\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-06-20\",\n    \"issue_date\": \"2022-11-02\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"A novel image enhancement algorithm designed for low-light medical scans, significantly improving image clarity and diagnostic accuracy.  The algorithm utilizes a deep convolutional neural network trained on a diverse dataset of medical images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related prior art on image denoising\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing low-light medical images comprising...\",\n        \"An apparatus for implementing the method...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68275", "text": "{\n    \"patent_title\": \"Image Compression Technique Using Wavelet Transform\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-08-12\",\n    \"issue_date\": \"2023-02-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An image compression technique based on wavelet transform, offering improved compression ratios while maintaining acceptable image quality.  Suitable for a variety of applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"EP1234567A1\",\n            \"relevance\": \"Prior art on wavelet-based compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing images using wavelet transform...\",\n        \"A system for implementing the compression method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68276", "text": "{\n    \"patent_title\": \"Deep Learning for Real-Time Image Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a deep learning-based method for real-time image enhancement, significantly improving image quality in low-light conditions. The system utilizes a novel convolutional neural network architecture optimized for speed and accuracy. Applications include autonomous vehicles and surveillance systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        },\n        {\n            \"patent_number\": \"US11223344B1\"\n        },\n        {\n            \"patent_number\": \"US12112233B2\"\n        },\n        {\n            \"patent_number\": \"US13131313B1\"\n        },\n        {\n            \"patent_number\": \"US14141414B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image using a deep neural network.\",\n        \"A system for real-time image enhancement.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68276", "text": "{\n    \"patent_title\": \"Method for Enhanced Medical Image Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2022-01-15\",\n    \"filing_date\": \"2022-01-15\",\n    \"issue_date\": \"2024-01-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a method for enhancing medical images, specifically CT scans and MRIs, to improve the detection of tumors and anomalies. It utilizes a novel filtering technique combined with machine learning algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        },\n        {\n            \"patent_number\": \"US99887766B1\"\n        },\n        {\n            \"patent_number\": \"US100112233B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing medical images.\",\n        \"A system for assisting in medical diagnosis.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68277", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Point-of-Care Diagnostics\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a microfluidic device enabling rapid and accurate point-of-care diagnostics. The device utilizes a novel fluidic architecture resulting in a breakthrough in detection sensitivity and speed, significantly advancing the field of personalized medicine.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for detecting biomarkers...\",\n        \"The device according to claim 1, wherein...\",\n        \"The method according to claim 2, wherein...\",\n        \"A system comprising the device of claim 1...\",\n        \"The system according to claim 5, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68277", "text": "{\n    \"patent_title\": \"Improved Surgical Instrument Handle\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"Medical Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"EP3210987B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2018-05-10\",\n    \"issue_date\": \"2021-08-18\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"An improved handle for surgical instruments, providing enhanced ergonomics and grip. The design reduces hand fatigue during long procedures and improves precision.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument handle comprising...\",\n        \"The handle according to claim 1, wherein...\",\n        \"The handle according to claim 2, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68278", "text": "{\n    \"patent_title\": \"Novel Implantable Cardiac Pacemaker with Adaptive Stimulation\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Boston Medical Devices Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11254321B2\",\n    \"priority_date\": \"2022-05-15\",\n    \"filing_date\": \"2022-06-20\",\n    \"issue_date\": \"2023-12-12\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"This invention discloses a novel implantable cardiac pacemaker featuring adaptive stimulation algorithms designed to minimize patient discomfort and maximize therapeutic efficacy. The device dynamically adjusts pacing parameters based on real-time physiological feedback, reducing energy consumption and improving long-term device performance. The enhanced design aims to improve patient quality of life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art regarding basic pacemaker functionality\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiac pacemaker comprising...\",\n        \"A method for adaptively pacing...\",\n        \"A system for monitoring physiological signals...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68278", "text": "{\n    \"patent_title\": \"Method for Early Detection of Cardiovascular Disease\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alan Smith\",\n            \"affiliation\": \"University of Oxford\"\n        }\n    ],\n    \"patent_number\": \"EP3876543A1\",\n    \"priority_date\": \"2021-11-01\",\n    \"filing_date\": \"2022-03-10\",\n    \"issue_date\": \"2023-09-27\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"This invention provides a novel method for the early detection of cardiovascular disease using advanced biomarker analysis. The method utilizes a combination of blood tests and machine learning algorithms to identify individuals at high risk of developing heart conditions. This is purely a diagnostic tool.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Prior art regarding biomarker analysis techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cardiovascular disease comprising...\",\n        \"A system for analyzing biomarker data...\",\n        \"A diagnostic kit for identifying risk factors...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68279", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Pressure Sensor for Intracranial Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"University of Cambridge\"\n        }\n    ],\n    \"patent_number\": \"EP3842915B1\",\n    \"priority_date\": \"2019-07-15\",\n    \"filing_date\": \"2020-07-15\",\n    \"issue_date\": \"2021-11-10\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"A miniaturized, wireless pressure sensor system for continuous intracranial pressure monitoring. The device is designed to be minimally invasive and provide real-time data transmission for improved patient care in neurocritical settings.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US20170320942A1\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising...\",\n        \"A method for intracranial pressure monitoring...\",\n        \"A communication system for transmitting sensor data...\",\n        \"A miniaturized housing for the sensor...\",\n        \"A system for real-time data analysis...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68279", "text": "{\n    \"patent_title\": \"Surgical Stapler with Enhanced Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11254567B2\",\n    \"priority_date\": \"2020-03-01\",\n    \"filing_date\": \"2020-03-01\",\n    \"issue_date\": \"2021-12-14\",\n    \"patent_office\": \"US Patent and Trademark Office\",\n    \"abstract\": \"An improved surgical stapler designed for enhanced ergonomic control and precise tissue approximation during surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8562555B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"An ergonomic handle...\",\n        \"A cartridge for staples...\",\n        \"A firing mechanism...\",\n        \"A safety locking system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68280", "text": "{\n    \"patent_title\": \"Miniaturized Optical Coherence Tomography Probe for Intravascular Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-11-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized optical coherence tomography (OCT) probe is disclosed for high-resolution intravascular imaging. The probe is designed to be compatible with a 0.018-inch catheter, allowing for minimally invasive access to peripheral vessels for early detection of atherosclerotic plaques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related prior art in OCT imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized OCT probe comprising...\",\n        \"A catheter compatible with the OCT probe...\",\n        \"A method for intravascular imaging using the OCT probe...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68280", "text": "{\n    \"patent_title\": \"Surgical Stapler with Enhanced Tissue Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Johnson & Johnson\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2018-12-01\",\n    \"filing_date\": \"2019-06-15\",\n    \"issue_date\": \"2022-04-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler with a novel tissue compression mechanism is disclosed, resulting in reduced tissue damage and improved hemostasis during surgical procedures. This device is suitable for a wide range of surgical applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related prior art in surgical staplers\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"A tissue compression mechanism integrated with the stapler...\",\n        \"A method for performing surgical anastomosis using the stapler...\",\n        \"A method for securing tissue using the stapler...\",\n        \"A tissue compression mechanism capable of applying variable force...\",\n        \"A stapler including multiple compression stages...\",\n        \"A stapler with feedback indicating compression levels...\",\n        \"A stapler designed for laparoscopic surgery...\",\n        \"A stapler designed for open surgery...\",\n        \"A stapler capable of firing multiple rows of staples...\",\n        \"A stapler utilizing bioabsorbable staples...\",\n        \"A stapler configured for robotic surgical systems...\",\n        \"A stapler with integrated irrigation capabilities...\",\n        \"A stapler incorporating a visualization system...\",\n        \"A stapler adapted for use with different tissue types...\",\n        \"A stapler with a self-adjusting compression feature...\",\n        \"A stapler that has enhanced user ergonomics...\",\n        \"A stapler with a safety lock mechanism...\",\n        \"A stapler designed for use in pediatric surgery...\",\n        \"A stapler comprising 21 distinct claims.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68281", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Magnetic Resonance Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-03-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for reconstructing magnetic resonance images with improved resolution and reduced noise. The technique utilizes a deep learning algorithm to enhance image clarity and detail.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8766842B2\",\n            \"relevance\": \"Prior art in image reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a magnetic resonance image comprising...\",\n        \"A system for performing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68281", "text": "{\n    \"patent_title\": \"Contrast-Enhanced Computed Tomography Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-08-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved computed tomography imaging system utilizing novel contrast agents to enhance visualization of blood vessels and tissues.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art in contrast agent technology\"\n        }\n    ],\n    \"claims\": [\n        \"A computed tomography system comprising...\",\n        \"A method for imaging using the system of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68282", "text": "{\n    \"patent_title\": \"Novel MRI Contrast Agent for Enhanced Tumor Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel MRI contrast agent comprising a gadolinium complex with a targeting ligand for enhanced visualization of cancerous tumors. Demonstrates significant improvement in tumor detection sensitivity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on MRI contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A method for imaging tumors using the novel MRI contrast agent.\",\n        \"The MRI contrast agent comprising a gadolinium complex and a targeting ligand.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68282", "text": "{\n    \"patent_title\": \"Improved Cardiac Catheter with Imaging Capabilities\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2022-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel cardiac catheter equipped with integrated ultrasound imaging for improved visualization of coronary arteries during minimally invasive procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous cardiac catheter designs\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiac catheter with integrated ultrasound imaging.\",\n        \"A method for visualizing coronary arteries using the improved catheter.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68283", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction with Reduced Radiation Dose\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Chen\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Bob Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method and system for reconstructing medical images from limited data, resulting in a significant reduction in radiation exposure while maintaining high image quality. The technique utilizes advanced iterative algorithms and regularization techniques to overcome the challenges associated with low-dose imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\"\n        },\n        {\n            \"patent_number\": \"US1012345678B2\"\n        },\n        {\n            \"patent_number\": \"US1122334455B1\"\n        },\n        {\n            \"patent_number\": \"US1233445566B2\"\n        },\n        {\n            \"patent_number\": \"US1344556677B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"A system comprising a radiation source...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68283", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Carol Williams\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2014-11-01\",\n    \"filing_date\": \"2014-11-01\",\n    \"issue_date\": \"2017-05-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel contrast agent for magnetic resonance imaging (MRI) that enhances image contrast and improves the visualization of tissues. The contrast agent exhibits improved biocompatibility and reduced toxicity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9012345678B2\"\n        },\n        {\n            \"patent_number\": \"US1023456789B1\"\n        },\n        {\n            \"patent_number\": \"US1134567890B2\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"A composition for enhancing MRI...\",\n        \"A method for visualizing tissues...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68284", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Neural Stimulator for Chronic Pain\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"Boston Medical Devices Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable neural stimulator designed for chronic pain management. The device utilizes targeted electrical stimulation to modulate pain signals, offering a non-pharmaceutical alternative. It builds upon prior art in neurostimulation techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760543B2\",\n            \"title\": \"Method and Apparatus for Neuromodulation\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable neural stimulator comprising...\",\n        \"A method for treating chronic pain using...\",\n        \"The stimulator as claimed in claim 1, wherein the stimulation is targeted...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68284", "text": "{\n    \"patent_title\": \"Novel Analgesic Compound for Chronic Pain Relief\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Chen\",\n            \"affiliation\": \"PharmaCorp Innovations\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2020-05-20\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-02-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel analgesic compound with enhanced potency and reduced side effects for the treatment of chronic pain. The compound targets specific opioid receptors in the central nervous system.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Opioid Receptor Agonists\"\n        }\n    ],\n    \"claims\": [\n        \"A novel analgesic compound having the formula...\",\n        \"A method for treating chronic pain comprising administering...\",\n        \"The compound as claimed in claim 1, wherein the dosage is...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68285", "text": "{\n    \"patent_title\": \"Novel MRI Contrast Agent for Enhanced Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel MRI contrast agent comprising a biocompatible nanoparticle encapsulating a paramagnetic substance, designed for enhanced tumor detection through increased signal intensity and targeted delivery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B1\",\n            \"relevance\": \"Prior art on nanoparticle synthesis\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising a nanoparticle...\",\n        \"A method for detecting tumors using the contrast agent...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68285", "text": "{\n    \"patent_title\": \"Improved Calibration Method for Existing CT Scanners\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an improved calibration method for existing CT scanners, leading to slightly increased image clarity and reduced artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Basic CT scanner calibration techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for calibrating a CT scanner...\",\n        \"A system for performing the calibration method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68286", "text": "{\n    \"patent_title\": \"Magnetic Resonance Imaging with Enhanced Contrast for Early-Stage Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2018-06-20\",\n    \"issue_date\": \"2021-11-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel magnetic resonance imaging (MRI) technique utilizing targeted contrast agents to enhance the detection of small tumors in early stages. The technique improves diagnostic accuracy and reduces false positives.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on MRI contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing tumor detection using MRI with targeted contrast agents.\",\n        \"An MRI apparatus configured for use with said method.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68286", "text": "{\n    \"patent_title\": \"Improved X-Ray Image Enhancement System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-12-01\",\n    \"filing_date\": \"2019-02-10\",\n    \"issue_date\": \"2022-05-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an improved system for enhancing the quality of X-ray images, resulting in better visualization of bone structures and foreign objects. The system utilizes a novel filtering algorithm to reduce noise and improve contrast.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Existing X-ray image processing techniques\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray image enhancement system comprising a filtering algorithm.\",\n        \"A method for processing X-ray images to improve contrast.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68287", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction for High-Resolution Computed Tomography\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-09-20\",\n    \"issue_date\": \"2019-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image reconstruction algorithm for computed tomography that significantly improves spatial resolution and reduces artifacts, leading to more accurate diagnostic imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B1\",\n            \"relevance\": \"Prior art in image filtering techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an image from projection data...\",\n        \"The method of claim 1, wherein the projection data is acquired using computed tomography.\",\n        \"The method of claim 1, further comprising a noise reduction step.\",\n        \"An apparatus for performing the method of claim 1.\",\n        \"The apparatus of claim 4, comprising a processor and a memory.\",\n        \"The method of claim 3, wherein the noise reduction step employs a wavelet transform.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68287", "text": "{\n    \"patent_title\": \"Cardiac Rhythm Monitoring System Using Ultrasound Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2017-01-05\",\n    \"filing_date\": \"2017-07-12\",\n    \"issue_date\": \"2020-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive system for monitoring cardiac rhythm utilizing ultrasound imaging techniques. The system provides real-time visualization of heart contractions and detects irregularities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous work on ultrasound signal processing.\"\n        }\n    ],\n    \"claims\": [\n        \"A system for monitoring cardiac rhythm comprising an ultrasound transducer...\",\n        \"The system of claim 1, further comprising a display for visualizing the cardiac rhythm.\",\n        \"The system of claim 1, wherein the ultrasound transducer operates at a frequency of 2-5 MHz.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68288", "text": "{\n    \"patent_title\": \"High-Performance Lithium-Ion Battery with Silicon-Carbon Anode\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-08-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery with a novel silicon-carbon composite anode exhibiting significantly improved energy density and cycle life compared to conventional graphite anodes. The design incorporates a unique electrolyte additive to enhance stability and performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art on silicon anodes\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising a silicon-carbon composite anode.\",\n        \"An electrolyte additive for enhancing battery performance.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68288", "text": "{\n    \"patent_title\": \"Improved Lead-Acid Battery for Automotive Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Exide Technologies\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-06-01\",\n    \"filing_date\": \"2019-12-20\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved lead-acid battery design incorporating a new separator material to reduce internal resistance and enhance performance in automotive starting applications. The separator increases the lifespan of the battery under harsh conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on lead-acid battery separators\"\n        }\n    ],\n    \"claims\": [\n        \"A lead-acid battery comprising a novel separator material.\",\n        \"A method for manufacturing a lead-acid battery with enhanced performance.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68289", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging Technique for Early-Stage Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Jian Li\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"EP3842957B1\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2021-01-20\",\n    \"issue_date\": \"2021-11-17\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"This invention provides a novel MRI sequence and image processing method for enhancing the detection of small cancerous tumors, particularly in the breast. The technique utilizes a combination of diffusion-weighted imaging and advanced reconstruction algorithms to improve signal-to-noise ratio and reduce false positives.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in MRI pulse sequences\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating an MRI image comprising...\",\n        \"An MRI apparatus configured to perform the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68289", "text": "{\n    \"patent_title\": \"Digital Radiography System with Enhanced Image Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Miller\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-10\",\n    \"filing_date\": \"2020-06-01\",\n    \"issue_date\": \"2022-01-04\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A digital radiography system with improved image processing algorithms for enhancing image clarity and reducing radiation dose. The system utilizes a novel filtering technique to suppress noise and artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"EP2987654B1\",\n            \"relevance\": \"Related art in digital radiography\"\n        }\n    ],\n    \"claims\": [\n        \"A digital radiography system comprising...\",\n        \"A method for processing a radiographic image...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68290", "text": "{\n    \"patent_title\": \"Method and System for Enhanced MRI Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-05-15\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing high-resolution MRI images using deep learning techniques, significantly improving diagnostic accuracy for detecting subtle anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"A system for performing MRI image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68290", "text": "{\n    \"patent_title\": \"System and Method for Targeted Radiation Delivery in Cancer Treatment\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2021-01-10\",\n    \"issue_date\": \"2023-07-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for delivering focused radiation beams to cancerous tumors, minimizing damage to surrounding healthy tissue.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A system for targeted radiation therapy comprising...\",\n        \"A method for delivering radiation to a tumor...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68291", "text": "{\n    \"patent_title\": \"Targeted Nanoparticle Drug Delivery System for Cancer Therapy\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel nanoparticle system for targeted drug delivery to cancer cells. The nanoparticles are designed to encapsulate therapeutic agents and release them specifically at tumor sites, improving efficacy and reducing side effects. The system utilizes a biocompatible polymer and surface modifications for enhanced targeting and cellular uptake.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in nanoparticle synthesis.\"\n        }\n    ],\n    \"claims\": [\n        \"A nanoparticle composition comprising a biocompatible polymer and a therapeutic agent.\",\n        \"A method of treating cancer comprising administering the nanoparticle composition to a patient.\",\n        \"The nanoparticle composition of claim 1, wherein the therapeutic agent is a chemotherapeutic drug.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68291", "text": "{\n    \"patent_title\": \"Improved Method for Water Purification\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"AquaTech Industries\"\n        }\n    ],\n    \"patent_number\": \"EP11223344B1\",\n    \"priority_date\": \"2020-11-10\",\n    \"filing_date\": \"2020-11-10\",\n    \"issue_date\": \"2022-08-15\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"This invention describes a new filtration system for purifying water using a novel membrane material. The system removes contaminants and provides clean drinking water.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Previous filtration technologies.\"\n        }\n    ],\n    \"claims\": [\n        \"A water purification system comprising a membrane filter.\",\n        \"The water purification system of claim 1, wherein the membrane filter is made of a polymeric material.\",\n        \"A method of purifying water using the water purification system of claim 1.\",\n        \"A method of removing contaminants from water using the water purification system of claim 1.\",\n        \"A water purification system as described in claim 1, comprising at least 25 claims.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68292", "text": "{\n    \"patent_title\": \"Enhanced Resolution Medical Imaging Using Deep Learning Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"United States Patent and Trademark Office (USPTO)\",\n    \"abstract\": \"This invention discloses a novel deep learning algorithm for reconstructing medical images from low-dose radiation, resulting in enhanced resolution and reduced patient exposure. The system utilizes a convolutional neural network trained on a large dataset of medical images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image reconstruction.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"The method of claim 1, wherein the deep learning model...\",\n        \"The method of claim 2, wherein the medical image is a CT scan.\",\n        \"The method of claim 1, wherein the radiation dose is reduced by at least 30%.\",\n        \"A system for performing the method of claim 1.\",\n        \"The system of claim 5, comprising a user interface...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68292", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"University of Barcelona\"\n        }\n    ],\n    \"patent_number\": \"EP3210987A1\",\n    \"priority_date\": \"2017-12-01\",\n    \"filing_date\": \"2018-01-15\",\n    \"issue_date\": \"2021-05-12\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"This invention describes a novel contrast agent for magnetic resonance imaging (MRI) that enhances image contrast. The agent is based on a nanoparticle formulation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related contrast agent technology.\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent for MRI comprising...\",\n        \"The contrast agent of claim 1, wherein the nanoparticle...\",\n        \"A method of using the contrast agent of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68293", "text": "{\n    \"patent_title\": \"AI-Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method for reconstructing medical images using artificial intelligence techniques. Specifically, a deep learning model is trained to enhance image quality and reduce noise, leading to improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Prior Art Image Processing Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing medical images comprising...\",\n        \"A system for enhancing image quality...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68293", "text": "{\n    \"patent_title\": \"Improved X-Ray Detection System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-01-10\",\n    \"filing_date\": \"2017-01-10\",\n    \"issue_date\": \"2019-05-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an improved X-ray detection system with enhanced sensitivity and resolution. The system utilizes advanced filtering techniques to reduce image artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Existing X-Ray Technology\"\n        },\n        {\n            \"patent_number\": \"US65432109B1\",\n            \"title\": \"Early X-Ray Detection\"\n        },\n        {\n            \"patent_number\": \"US54321098B2\",\n            \"title\": \"Another Relevant X-Ray Patent\"\n        },\n        {\n            \"patent_number\": \"US43210987B1\",\n            \"title\": \"Previous Work in X-Ray\"\n        },\n        {\n            \"patent_number\": \"US32109876B2\",\n            \"title\": \"X-Ray Detection System\"\n        },\n        {\n            \"patent_number\": \"US21098765B1\",\n            \"title\": \"Image Processing Algorithm\"\n        },\n        {\n            \"patent_number\": \"US10987654B2\",\n            \"title\": \"Alternative Detection Approach\"\n        },\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"title\": \"Competing X-Ray Tech\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray detection system comprising...\",\n        \"A method for reducing image artifacts...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68294", "text": "{\n    \"patent_title\": \"Ultrasound Imaging with Enhanced Resolution and Reduced Artifacts\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-06-01\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel ultrasound imaging technique utilizing advanced signal processing algorithms to significantly enhance image resolution while simultaneously reducing artifacts. The system incorporates a biofeedback mechanism to adapt to patient movement and minimize discomfort during scanning.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11111111B1\",\n            \"title\": \"Prior Art Ultrasound System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for ultrasound imaging comprising...\",\n        \"An ultrasound system configured to...\",\n        \"A signal processing algorithm for artifact reduction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68294", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging Coil Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Emily Foster\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2018-03-10\",\n    \"filing_date\": \"2018-04-01\",\n    \"issue_date\": \"2021-09-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents an improved coil design for magnetic resonance imaging (MRI) systems, resulting in enhanced signal-to-noise ratio and faster scan times. The design utilizes a novel arrangement of conductive elements.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"title\": \"Conventional MRI Coil\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil comprising...\",\n        \"A method for constructing an MRI coil...\",\n        \"An arrangement of conductive elements...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68295", "text": "{\n    \"patent_title\": \"Enhanced Resolution MRI using Deep Learning Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for enhancing the resolution of Magnetic Resonance Images (MRIs) using deep learning reconstruction algorithms. The method significantly improves image clarity and reduces noise, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8785123B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI resolution comprising...\",\n        \"A system for processing MRI data to improve image clarity...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68295", "text": "{\n    \"patent_title\": \"Improved CT Scan Protocol for Lung Nodule Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new CT scan protocol designed to improve the detection of small lung nodules. The protocol utilizes a lower radiation dose while maintaining diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A CT scan protocol comprising...\",\n        \"A method for detecting lung nodules using reduced radiation...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68296", "text": "{\n    \"patent_title\": \"Adaptive Noise Reduction for Enhanced Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reducing noise in medical images using adaptive filtering techniques. The system analyzes image characteristics in real-time to optimize filter parameters, resulting in significantly improved image clarity and diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art in image filtering\"\n        }\n    ],\n    \"claims\": [\n        \"A method for noise reduction in images comprising: analyzing image characteristics; determining filter parameters based on said characteristics; and applying a filter to the image.\",\n        \"The method of claim 1, wherein the image is a medical image.\",\n        \"The method of claim 1, wherein the filter is an adaptive filter.\",\n        \"A system for noise reduction in images, comprising a processor and memory storing instructions to perform the method of claim 1.\",\n        \"The system of claim 4, further comprising a display for viewing the filtered image.\",\n        \"The method of claim 1, wherein the filter parameters are optimized in real-time.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68296", "text": "{\n    \"patent_title\": \"Image Resizing Algorithm Implementation\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corp\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-07-01\",\n    \"filing_date\": \"2022-09-10\",\n    \"issue_date\": \"2024-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An efficient implementation of a standard bicubic image resizing algorithm. Focuses on optimized code for faster processing speeds.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art regarding bicubic interpolation\"\n        }\n    ],\n    \"claims\": [\n        \"A computer-implemented method for resizing an image using bicubic interpolation.\",\n        \"The method of claim 1, wherein the resizing is performed in real-time.\",\n        \"A computer system for resizing an image comprising a processor and memory.\",\n        \"The system of claim 3, further comprising a display.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68297", "text": "{\n    \"patent_title\": \"Real-Time Image Enhancement System Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-11-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for real-time image enhancement using a convolutional neural network. The system processes images to improve clarity and reduce noise, suitable for applications such as video conferencing and live streaming.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image clarity in real-time using a deep learning model.\",\n        \"A system comprising a camera, a processor, and a display, wherein the processor is configured to execute a deep learning model to enhance images received from the camera before displaying them.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68297", "text": "{\n    \"patent_title\": \"Method for Color Correction in Digital Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Adobe Systems Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2017-10-26\",\n    \"filing_date\": \"2017-10-26\",\n    \"issue_date\": \"2021-05-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for automatically correcting color imbalances in digital images. The method adjusts color channels based on a pre-defined color profile.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for color correction in digital images comprising adjusting color channels based on a predefined color profile.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68298", "text": "{\n    \"patent_title\": \"Wearable Sensor for Continuous Monitoring of Vital Signs\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-07-20\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A wearable sensor system for continuously monitoring vital signs, providing real-time data to healthcare professionals and improving patient safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in wearable sensor technology\"\n        }\n    ],\n    \"claims\": [\n        \"A wearable sensor comprising a plurality of electrodes...\",\n        \"A system for monitoring vital signs comprising the wearable sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68298", "text": "{\n    \"patent_title\": \"Surgical Instrument with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"EP3456789B1\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2023-05-12\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"A surgical instrument designed for increased precision during minimally invasive procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related to surgical instrument design\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising a handle and a cutting blade...\",\n        \"A method of performing surgery using the surgical instrument...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68299", "text": "{\n    \"patent_title\": \"Improved MRI Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning approach for reconstructing high-resolution MRI images from undersampled k-space data, leading to faster scan times and improved image quality for diagnostic purposes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on MRI reconstruction techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images...\",\n        \"A system comprising a MRI scanner and a deep learning module...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68299", "text": "{\n    \"patent_title\": \"Dermabrasion Device with Enhanced Skin Rejuvenation\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11123456B2\",\n    \"priority_date\": \"2018-05-20\",\n    \"filing_date\": \"2019-05-20\",\n    \"issue_date\": \"2021-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A dermabrasion device employing micro-needle technology to enhance skin exfoliation and rejuvenation, resulting in improved skin texture and appearance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Previous dermabrasion technologies\"\n        }\n    ],\n    \"claims\": [\n        \"A dermabrasion device comprising a handpiece with micro-needles...\",\n        \"A method for skin rejuvenation using the dermabrasion device...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68300", "text": "{\n    \"patent_title\": \"Method and System for Enhanced MRI Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing high-resolution MRI images from undersampled k-space data using a deep learning approach. The system enhances image quality and reduces artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"MRI Image Reconstruction Using Compressed Sensing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"A system for performing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68300", "text": "{\n    \"patent_title\": \"Radiation Dose Reduction Technique for CT Scans\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Sarah Johnson\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-02-15\",\n    \"filing_date\": \"2017-02-15\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for reducing radiation exposure during CT scans while maintaining image quality. This involves iterative reconstruction algorithms and optimized scanning protocols.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Adaptive Statistical Iterative Reconstruction for CT\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing a CT scan with reduced radiation...\",\n        \"A CT scanner configured to implement the method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68301", "text": "{\n    \"patent_title\": \"Deep Learning for Enhanced MRI Image Segmentation\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-09-20\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention utilizes deep convolutional neural networks to improve the accuracy and speed of MRI image segmentation, aiding in the diagnosis of various medical conditions.  It reduces manual effort and improves patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US1012345678B2\",\n            \"relevance\": \"cited\"\n        },\n        {\n            \"patent_number\": \"US1122334455B2\",\n            \"relevance\": \"referenced\"\n        },\n        {\n            \"patent_number\": \"US1234987654B2\",\n            \"relevance\": \"relevant\"\n        },\n        {\n            \"patent_number\": \"US5555555555B2\",\n            \"relevance\": \"cited\"\n        },\n        {\n            \"patent_number\": \"US6666666666B2\",\n            \"relevance\": \"referenced\"\n        }\n    ],\n    \"claims\": [\n        \"A method for segmenting MRI images using a deep convolutional neural network.\",\n        \"A system comprising a processor and memory for implementing the method.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68301", "text": "{\n    \"patent_title\": \"Automated Radiation Dose Planning System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2020-12-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for automatically planning radiation doses for cancer treatment, optimizing targeting and minimizing damage to healthy tissue. The system uses algorithms to calculate the optimal radiation path.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"cited\"\n        },\n        {\n            \"patent_number\": \"US1012345678B2\",\n            \"relevance\": \"referenced\"\n        },\n        {\n            \"patent_number\": \"US1122334455B2\",\n            \"relevance\": \"relevant\"\n        }\n    ],\n    \"claims\": [\n        \"A system for automated radiation dose planning.\",\n        \"A method for optimizing radiation delivery.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68302", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor for Intracranial Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized, wireless pressure sensor designed for continuous intracranial pressure monitoring. The device transmits data wirelessly to an external receiver, providing real-time feedback for clinicians managing patients with traumatic brain injury or hydrocephalus.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art in wireless sensor technology.\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising a piezoelectric element and a wireless transmitter.\",\n        \"A method for continuous intracranial pressure monitoring using said sensor.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68302", "text": "{\n    \"patent_title\": \"Cosmetic Device for Skin Tightening\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"BeautyTech Innovations\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2023-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A cosmetic device utilizing radiofrequency energy to stimulate collagen production and reduce the appearance of wrinkles and fine lines. The device is intended for non-invasive skin rejuvenation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related prior art in radiofrequency skin treatment.\"\n        }\n    ],\n    \"claims\": [\n        \"A cosmetic device for skin tightening comprising a radiofrequency applicator.\",\n        \"A method for reducing wrinkles using said device.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68303", "text": "{\n    \"patent_title\": \"Miniaturized Robotic System for Minimally Invasive Cardiac Surgery\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-15\",\n    \"issue_date\": \"2023-03-28\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A miniaturized robotic system designed for performing minimally invasive cardiac surgery, enhancing precision and reducing patient recovery time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic system comprising a miniaturized surgical tool...\",\n        \"A method for performing cardiac surgery using the robotic system...\",\n        \"A control system for remotely operating the surgical tool...\",\n        \"A imaging system integrated with the robotic system...\",\n        \"A patient monitoring system integrated with the robotic system...\",\n        \"A system for adjusting the stiffness of the surgical tool...\",\n        \"A navigation system for guiding the surgical tool...\",\n        \"A method of sterilizing the surgical tool...\",\n        \"A sensor for measuring force applied by the surgical tool...\",\n        \"A system for providing haptic feedback to the surgeon...\",\n        \"A safety mechanism to prevent accidental tissue damage...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68303", "text": "{\n    \"patent_title\": \"Surgical Instrument with Enhanced Grip\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Klaus Mueller\",\n            \"affiliation\": \"Technical University of Munich\"\n        }\n    ],\n    \"patent_number\": \"EP12345678B1\",\n    \"priority_date\": \"2022-01-15\",\n    \"filing_date\": \"2022-01-20\",\n    \"issue_date\": \"2023-11-10\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"An improved surgical instrument featuring an ergonomic handle for enhanced grip and control during procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising a handle with a textured surface...\",\n        \"A locking mechanism for securing the instrument's position...\",\n        \"A material composition for optimal grip strength...\",\n        \"A method for manufacturing the instrument's handle...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68304", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Point-of-Care Diagnostics\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2022-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device is disclosed for rapid and accurate detection of biomarkers in biological fluids, enabling point-of-care diagnostics. The device integrates sample preparation, amplification, and detection, significantly reducing analysis time and improving accessibility to healthcare.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for detecting a biomarker...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68304", "text": "{\n    \"patent_title\": \"Surgical Instrument with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Medical Inc.\"\n        }\n    ],\n    \"patent_number\": \"EP3210987B1\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2021-08-04\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"A surgical instrument is disclosed with an improved ergonomic handle design to reduce surgeon fatigue during long procedures.  The handle incorporates a novel grip material and weight distribution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument handle comprising...\",\n        \"A grip material having a durometer of...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68305", "text": "{\n    \"patent_title\": \"Surgical Robotic System with Enhanced Dexterity and Force Feedback\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2020-06-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A robotic surgical system incorporating advanced force feedback and miniaturized surgical instruments for minimally invasive procedures. The system allows surgeons to perform complex operations with greater precision and control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in robotic surgery\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Early force feedback systems\"\n        },\n        {\n            \"patent_number\": \"US20150239723A1\",\n            \"relevance\": \"Minimally invasive instrument design\"\n        },\n        {\n            \"patent_number\": \"US20180123456A1\",\n            \"relevance\": \"Advanced control algorithms\"\n        },\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"relevance\": \"Haptic feedback enhancement\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system comprising a miniaturized surgical instrument...\",\n        \"A method for performing a minimally invasive surgical procedure...\",\n        \"A force feedback system for providing tactile information to a surgeon...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68305", "text": "{\n    \"patent_title\": \"Portable Ultrasound Device for Point-of-Care Diagnostics\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11112222B2\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2021-07-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A portable ultrasound device designed for rapid diagnostic imaging at the point of care. The device utilizes advanced signal processing techniques to improve image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Ultrasound imaging technology\"\n        },\n        {\n            \"patent_number\": \"US9654321B2\",\n            \"relevance\": \"Signal processing algorithms\"\n        },\n        {\n            \"patent_number\": \"US20160326377A1\",\n            \"relevance\": \"Portable medical devices\"\n        },\n        {\n            \"patent_number\": \"US20190012345A1\",\n            \"relevance\": \"Image enhancement techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A portable ultrasound device comprising a transducer...\",\n        \"A method for generating an ultrasound image...\",\n        \"A signal processing system for enhancing image quality...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68306", "text": "{\n    \"patent_title\": \"High-Capacity Lithium-Ion Battery with Enhanced Cycling Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Princeton University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"QuantumScape Corporation\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2023-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery design incorporating a silicon-carbon composite anode and a lithium-rich NMC cathode, resulting in significantly improved energy density and cycle life for energy storage applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art on silicon anode materials\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"The battery of claim 1, wherein the anode comprises...\",\n        \"The battery of claim 2, wherein the cathode comprises...\",\n        \"A method of manufacturing the battery of claim 1...\",\n        \"...\",\n        \"The battery of claim 1, for use in electric vehicles.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68306", "text": "{\n    \"patent_title\": \"Theoretical Model for Lithium-Ion Diffusion in Solid Electrolytes\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alex Johnson\",\n            \"affiliation\": \"National Renewable Energy Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-05-20\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-09-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A computational model describing lithium-ion diffusion mechanisms in solid-state electrolytes, providing insights into ionic conductivity and transport properties.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Foundation work on solid electrolyte modeling\"\n        }\n    ],\n    \"claims\": [\n        \"A method for simulating lithium-ion diffusion...\",\n        \"The method of claim 1, wherein the simulation comprises...\",\n        \"A computer program for performing the method of claim 1...\",\n        \"A system for simulating lithium-ion diffusion...\",\n        \"...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68307", "text": "{\n    \"patent_title\": \"Enhanced Magnetic Resonance Imaging with Artificial Intelligence Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel approach to magnetic resonance imaging (MRI) reconstruction using deep learning techniques. The method significantly reduces scan time while maintaining high image quality, offering improved diagnostic capabilities for a wide range of medical conditions. The core of the invention lies in a convolutional neural network trained on a large dataset of MRI images, enabling rapid and accurate reconstruction of images from undersampled k-space data. The resultant images demonstrate improved signal-to-noise ratio and reduced artifacts compared to conventional reconstruction methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8766654B2\",\n            \"title\": \"MRI Reconstruction Using Compressed Sensing\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Deep Learning for Image Processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68307", "text": "{\n    \"patent_title\": \"Portable X-Ray Device for Veterinary Use\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Veterinary Equipment\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-05-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A compact and portable X-ray device designed for veterinary applications. The device is lightweight and easy to use, allowing for convenient on-site diagnosis in veterinary clinics and field settings.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Portable X-Ray Apparatus\"\n        }\n    ],\n    \"claims\": [\n        \"A portable X-ray device comprising...\",\n        \"A method for using a portable X-ray device...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68308", "text": "{\n    \"patent_title\": \"Enhanced MRI Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-05-20\",\n    \"issue_date\": \"2019-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method for reconstructing high-resolution MRI images using deep convolutional neural networks, leading to improved diagnostic accuracy in neurological disorders.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for processing MRI data...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The method of claim 1, wherein...\",\n        \"The system of claim 2, further comprising...\",\n        \"The method of claim 1, wherein the neural network is a convolutional neural network.\",\n        \"The system of claim 2, wherein the processing unit is a GPU.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68308", "text": "{\n    \"patent_title\": \"Cardiac Imaging with Improved Contrast Agents\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2018-02-15\",\n    \"issue_date\": \"2020-05-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to novel contrast agents for enhancing the clarity of cardiac MRI images, facilitating the diagnosis of heart disease.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous work on contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent for cardiac MRI comprising...\",\n        \"A method for imaging the heart...\",\n        \"A pharmaceutical composition including...\",\n        \"The contrast agent of claim 1, wherein...\",\n        \"The method of claim 2, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68309", "text": "{\n    \"patent_title\": \"High-Resolution Magnetic Resonance Imaging for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2020-12-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method for high-resolution magnetic resonance imaging (MRI) capable of detecting early-stage cancerous tumors. The technique utilizes advanced pulse sequences and image reconstruction algorithms to enhance image clarity and sensitivity. This approach aims to improve diagnostic accuracy and patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Improved MRI Coil Design\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI comprising...\",\n        \"An MRI system configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68309", "text": "{\n    \"patent_title\": \"Pediatric Ultrasound Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Sarah Chen\",\n            \"affiliation\": \"Children's Hospital Los Angeles\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2021-05-20\",\n    \"issue_date\": \"2021-08-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A specialized ultrasound imaging system designed for pediatric applications. The system incorporates low-power transducers and optimized imaging parameters to minimize discomfort and ensure accurate diagnosis in young patients. This system employs a specific contrast agent for enhanced visualization.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Ultrasound Beamforming Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"An ultrasound imaging system for pediatric use comprising...\",\n        \"A method for performing ultrasound imaging on a child...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68310", "text": "{\n    \"patent_title\": \"Novel MRI Technique for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10456789B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2021-02-23\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A new MRI technique utilizing advanced pulse sequences and image reconstruction algorithms for improved early cancer detection. The method enhances contrast and reduces scan time, leading to more accurate and efficient diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"count\": 150\n        },\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"count\": 100\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI scans...\",\n        \"An MRI apparatus configured to...\",\n        \"A system for detecting cancer...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68310", "text": "{\n    \"patent_title\": \"Improved X-Ray Shielding Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"EP3210987B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-11-04\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"A novel shielding material for X-ray machines, providing improved radiation protection for patients and operators.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"count\": 25\n        }\n    ],\n    \"claims\": [\n        \"A shielding material comprising...\",\n        \"An X-ray machine incorporating...\",\n        \"A method for reducing radiation exposure...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68311", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Drug Delivery System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable drug delivery system for controlled release of therapeutic agents, designed to improve patient compliance and treatment efficacy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art on implantable devices.\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable device comprising...\",\n        \"A method for controlled drug release using said device...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68311", "text": "{\n    \"patent_title\": \"Advanced MRI Coil Design for High-Resolution Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Evans\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-06-01\",\n    \"filing_date\": \"2020-06-01\",\n    \"issue_date\": \"2022-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel MRI coil design providing significantly improved image resolution and signal-to-noise ratio for diagnostic applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art in MRI coil technology.\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil comprising...\",\n        \"A method for obtaining high-resolution images using said coil...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68312", "text": "{\n    \"patent_title\": \"Method and System for Noise Reduction in Computed Tomography Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for reducing noise in computed tomography (CT) images using a novel filtering algorithm. This algorithm significantly improves image clarity while minimizing radiation dose to the patient.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8785021B2\",\n            \"relevance\": \"Similar noise reduction technique\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related image processing methods\"\n        },\n        {\n            \"patent_number\": \"US9567890B2\",\n            \"relevance\": \"Radiation dose optimization in CT scanning\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing noise in a CT image comprising...\",\n        \"A system for performing CT imaging with reduced noise...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68312", "text": "{\n    \"patent_title\": \"Novel Drug Delivery System for Targeted Cancer Therapy\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"PharmaCorp Innovations\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2021-01-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel drug delivery system utilizing nanoparticles to target cancer cells with enhanced efficacy and reduced side effects.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"relevance\": \"Related nanoparticle technology\"\n        },\n        {\n            \"patent_number\": \"US9234567B2\",\n            \"relevance\": \"Cancer treatment methods\"\n        }\n    ],\n    \"claims\": [\n        \"A drug delivery system comprising...\",\n        \"A nanoparticle formulation for targeted drug delivery...\",\n        \"A method of treating cancer...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68313", "text": "{\n    \"patent_title\": \"Enhanced Magnetic Resonance Imaging with Artificial Intelligence Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for improving the resolution and reducing artifacts in magnetic resonance images using deep learning algorithms. The system achieves faster image reconstruction times, leading to improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing magnetic resonance images...\",\n        \"A system for improving image clarity in MRI...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68313", "text": "{\n    \"patent_title\": \"Ultrasound Image Processing for Cardiovascular Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2015-11-01\",\n    \"filing_date\": \"2015-11-01\",\n    \"issue_date\": \"2017-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved method for processing ultrasound images to enhance visualization of cardiovascular structures and blood flow.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing ultrasound signals...\",\n        \"A system for visualizing blood flow in real-time...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68314", "text": "{\n    \"patent_title\": \"High-Resolution Magnetic Resonance Imaging for Enhanced Cardiovascular Disease Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for enhancing the resolution of magnetic resonance images, leading to improved detection of subtle indicators of cardiovascular disease. The invention utilizes novel signal processing techniques to reduce noise and artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related prior art in MRI signal processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing the resolution of MRI images comprising...\",\n        \"An MRI system configured to implement the method of claim 1...\",\n        \"A computer-readable medium storing instructions for...\",\n        \"The method of claim 1, wherein the cardiovascular disease is atherosclerosis.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68314", "text": "{\n    \"patent_title\": \"Contrast-Enhanced Ultrasound Imaging for Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-02-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for enhancing tumor visualization using contrast-enhanced ultrasound imaging. This invention utilizes microbubble contrast agents to improve image clarity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art on ultrasound contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing tumor visualization comprising administering a contrast agent...\",\n        \"An ultrasound system configured to implement the method of claim 1...\",\n        \"A contrast agent formulation for use in the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68315", "text": "{\n    \"patent_title\": \"Microfluidic Device for Targeted Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for precise and targeted drug delivery utilizing biocompatible materials and controlled release mechanisms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for targeted drug delivery...\",\n        \"A biocompatible material for microfluidic devices...\",\n        \"A system for controlled drug release...\",\n        \"A method for manufacturing a microfluidic device...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68315", "text": "{\n    \"patent_title\": \"Surgical Instrument for Bone Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical instrument designed for precise bone reconstruction procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising...\",\n        \"A method for bone reconstruction...\",\n        \"A handle for manipulating the instrument...\",\n        \"A blade for cutting bone...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68316", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging Technique for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel magnetic resonance imaging (MRI) technique utilizing advanced pulse sequences and image reconstruction algorithms to enhance the detection of early-stage cancerous tumors. The method provides significantly improved contrast and resolution compared to conventional MRI, leading to earlier and more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Prior art in MRI pulse sequence design\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating MRI images comprising...\",\n        \"The method of claim 1, wherein the pulse sequence...\",\n        \"An MRI system configured to perform the method of claim 1...\",\n        \"The MRI system of claim 3, further comprising...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The computer-readable medium of claim 5, wherein...\",\n        \"A method for diagnosing cancer...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68316", "text": "{\n    \"patent_title\": \"System for Automated X-ray Image Archiving\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-06-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for automatically archiving and retrieving X-ray images using a cloud-based storage solution. The system provides secure and efficient access to medical images for authorized personnel.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\",\n            \"relevance\": \"Prior art in medical image storage\"\n        }\n    ],\n    \"claims\": [\n        \"A system for archiving X-ray images comprising...\",\n        \"The system of claim 1, wherein the storage medium...\",\n        \"A method for retrieving X-ray images...\",\n        \"The method of claim 3, wherein the retrieval is...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68317", "text": "{\n    \"patent_title\": \"Magnetic Resonance Imaging with Enhanced Contrast Agents\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-01-29\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method for enhancing contrast in magnetic resonance imaging (MRI) using targeted nanoparticles. The improved contrast allows for earlier and more accurate diagnosis of cancerous tumors.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9012345B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing contrast in MRI comprising...\",\n        \"Nanoparticles for targeted delivery to tumor cells...\",\n        \"A diagnostic system utilizing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68317", "text": "{\n    \"patent_title\": \"Improved Ultrasound Imaging for Fetal Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"University of California, San Francisco\"\n        },\n        {\n            \"name\": \"Emily Chen\",\n            \"affiliation\": \"UCSF Medical Center\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-04-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved ultrasound imaging technique for enhanced fetal monitoring during pregnancy. The system utilizes advanced signal processing to reduce noise and improve image resolution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"An ultrasound imaging system for fetal monitoring...\",\n        \"A method for reducing noise in ultrasound images...\",\n        \"A signal processing algorithm for improving image resolution...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68318", "text": "{\n    \"patent_title\": \"Method for Enhanced Cancer Detection Using Dynamic Contrast-Enhanced MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10500000B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-11-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel method for enhancing cancer detection using dynamic contrast-enhanced MRI. By analyzing the temporal changes in signal intensity, the method provides improved sensitivity and specificity in identifying malignant tumors, particularly in early stages.  The technique utilizes advanced image processing algorithms to differentiate cancerous tissue from healthy tissue based on their distinct vascular characteristics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9800000B2\",\n            \"relevance\": \"Related prior art in MRI imaging.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancer...\",\n        \"The method of claim 1, wherein the cancer is breast cancer.\",\n        \"The method of claim 1, wherein the dynamic contrast agent is gadolinium-based.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68318", "text": "{\n    \"patent_title\": \"Improved X-Ray Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Carol Davis\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US8999999B1\",\n    \"priority_date\": \"2014-12-20\",\n    \"filing_date\": \"2014-12-20\",\n    \"issue_date\": \"2018-04-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved X-ray imaging system with enhanced image resolution. The system utilizes a novel detector array and signal processing techniques to produce clearer and more detailed images. This system is generally applicable to diagnostic imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US4500000\",\n            \"relevance\": \"Early X-ray imaging technology.\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"The system of claim 1, wherein the detector array comprises...\",\n        \"The system of claim 1, further comprising a digital image processing unit.\",\n        \"A method for generating an image using the system of claim 1.\",\n        \"...\",\n        \"A method for generating an image using the system of claim 1.\",\n        \"...\",\n        \"A method for generating an image using the system of claim 1.\",\n        \"...\",\n        \"A method for generating an image using the system of claim 1.\",\n        \"...\",\n        \"A method for generating an image using the system of claim 1.\",\n        \"...\",\n        \"A method for generating an image using the system of claim 1.\",\n        \"...\",\n        \"A method for generating an image using the system of claim 1.\",\n        \"...\",\n        \"A method for generating an image using the system of claim 1.\",\n        \"...\",\n        \"A method for generating an image using the system of claim 1.\",\n        \"...\",\n        \"A method for generating an image using the system of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68319", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Point-of-Care Diagnostic Testing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel microfluidic device enabling rapid and accurate point-of-care diagnostics for infectious diseases. The device integrates sample preparation, nucleic acid amplification, and detection on a single chip, significantly reducing time and cost compared to traditional methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for detecting a pathogen...\",\n        \"A system for point-of-care diagnostics...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68319", "text": "{\n    \"patent_title\": \"Improved Syringe Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US7654321B1\",\n    \"priority_date\": \"2018-12-01\",\n    \"filing_date\": \"2019-10-10\",\n    \"issue_date\": \"2021-06-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved syringe design with a more ergonomic grip and a slightly modified plunger mechanism for smoother injection.  The design aims to reduce user fatigue during prolonged use.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US5432109B2\"\n        }\n    ],\n    \"claims\": [\n        \"A syringe comprising an ergonomic grip...\",\n        \"A plunger mechanism with reduced friction...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68320", "text": "{\n    \"patent_title\": \"Microscopic Surgical Instrument with Integrated Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2020-03-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized surgical instrument incorporating high-resolution imaging capabilities for precise minimally invasive procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8545231B2\",\n            \"title\": \"Minimally Invasive Surgical System\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising a microscopic imaging device.\",\n        \"A method for performing minimally invasive surgery using the instrument.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68320", "text": "{\n    \"patent_title\": \"Automated Drug Delivery System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Pharmaceutical Corp\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-12-01\",\n    \"filing_date\": \"2017-12-01\",\n    \"issue_date\": \"2019-04-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for delivering precise dosages of medication to patients.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Drug Infusion Pump\"\n        }\n    ],\n    \"claims\": [\n        \"A drug delivery system comprising a programmable pump.\",\n        \"A method for controlling drug dosage using the system.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68321", "text": "{\n    \"patent_title\": \"Non-Invasive Patient Monitoring System Utilizing Wearable Sensors\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Independent Consultant\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2020-05-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive patient monitoring system utilizing wearable sensors to continuously track vital signs and alert medical personnel to potential health issues. The system employs advanced algorithms for accurate data analysis and personalized patient care.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for non-invasive patient monitoring comprising...\",\n        \"A method for analyzing physiological data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68321", "text": "{\n    \"patent_title\": \"Automated Surgical Stapler with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Wilson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Sarah Chen\",\n            \"affiliation\": \"MedTech Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11123456B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2022-02-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated surgical stapler designed for enhanced precision and efficiency during minimally invasive surgical procedures. The device incorporates advanced sensors and control mechanisms to optimize staple placement and minimize tissue damage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"A method for automated staple placement...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68322", "text": "{\n    \"patent_title\": \"Adaptive Power Allocation for Extended Battery Life in Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2020-06-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for dynamically allocating power to different components of a mobile device to maximize battery life. The system utilizes machine learning to predict user behavior and optimize power consumption accordingly.\",\n    \"citations\": [\n        {\n            \"document_id\": \"US9876543B2\",\n            \"date\": \"2018-12-10\"\n        }\n    ],\n    \"claims\": [\n        \"A method for dynamically allocating power to a mobile device comprising...\",\n        \"A system for optimizing battery life...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68322", "text": "{\n    \"patent_title\": \"Improved Electrolyte Composition for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US9234567B1\",\n    \"priority_date\": \"2016-01-05\",\n    \"filing_date\": \"2016-01-05\",\n    \"issue_date\": \"2016-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel electrolyte composition for lithium-ion batteries that improves energy density and cycle life. The composition includes a new additive that enhances ionic conductivity.\",\n    \"citations\": [\n        {\n            \"document_id\": \"US6456789B1\",\n            \"date\": \"1993-05-03\"\n        }\n    ],\n    \"claims\": [\n        \"An electrolyte composition comprising...\",\n        \"A lithium-ion battery utilizing the electrolyte composition...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68323", "text": "{\n    \"patent_title\": \"Novel Biocompatible Material for Implantable Glucose Sensors\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel biocompatible polymer is disclosed for use in implantable glucose sensors, designed to minimize inflammatory response and enhance patient comfort. The material exhibits superior flexibility and reduced biofouling characteristics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A biocompatible polymer composition comprising...\",\n        \"An implantable glucose sensor incorporating the biocompatible polymer...\",\n        \"A method for manufacturing an implantable glucose sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68323", "text": "{\n    \"patent_title\": \"Drug-Eluting Stent with Improved Coating\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2022-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A drug-eluting stent is described with an improved polymer coating designed to minimize restenosis and enhance drug delivery. The stent structure is optimized for radial support and flexibility.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A drug-eluting stent comprising a metallic scaffold and a polymer coating...\",\n        \"The drug-eluting stent of claim 1, wherein the polymer coating comprises...\",\n        \"A method for treating coronary artery disease using the drug-eluting stent...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68324", "text": "{\n    \"patent_title\": \"Adaptive Noise Reduction in Medical Images using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for adaptive noise reduction in medical images using a deep learning model. The model is trained to identify and remove noise while preserving important image details, leading to improved image clarity for diagnostic purposes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in image filtering\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing noise in a medical image...\",\n        \"A system comprising a deep learning model...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68324", "text": "{\n    \"patent_title\": \"Improved Image Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2022-02-15\",\n    \"filing_date\": \"2022-02-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved algorithm for compressing digital images, achieving higher compression ratios with minimal loss of image quality.  Suitable for general purpose image storage and transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US4555734\",\n            \"relevance\": \"Related to image data manipulation\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image...\",\n        \"A system for encoding image data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68325", "text": "{\n    \"patent_title\": \"Improved Mammographic Image Analysis System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for analyzing mammographic images to detect early signs of breast cancer with improved accuracy using deep learning algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for analyzing mammographic images...\",\n        \"A system comprising a processor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68325", "text": "{\n    \"patent_title\": \"Echocardiographic Image Enhancement Method\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-11-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for enhancing the quality of echocardiographic images to improve the visualization of heart structures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing echocardiographic images...\",\n        \"A system for processing ultrasound data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68326", "text": "{\n    \"patent_title\": \"Method and Apparatus for Dynamic Power Management in Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2019-07-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and apparatus for dynamically managing power consumption in mobile devices based on user activity and network conditions to extend battery life.  The system utilizes machine learning to predict power usage patterns.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8654321B1\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for managing power consumption in a mobile device, comprising: monitoring user activity; predicting future power consumption based on said user activity; and dynamically adjusting power settings to optimize battery life.\",\n        \"An apparatus for managing power consumption in a mobile device, comprising: a processor; a memory storing instructions for monitoring user activity, predicting future power consumption, and dynamically adjusting power settings; and a power management module configured to execute said instructions.\",\n        \"The method of claim 1, wherein predicting future power consumption utilizes a machine learning algorithm.\",\n        \"The apparatus of claim 2, wherein the power management module is further configured to communicate with a network to adjust power settings based on network conditions.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68326", "text": "{\n    \"patent_title\": \"Improved Battery Design Using Nanomaterials\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2018-05-20\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery design utilizing carbon nanotubes to increase energy density and improve charge/discharge rates.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7531842B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery comprising a cathode, an anode, and an electrolyte, wherein the cathode comprises carbon nanotubes.\",\n        \"The battery of claim 1, wherein the carbon nanotubes have a diameter of between 1 and 10 nanometers.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68327", "text": "{\n    \"patent_title\": \"Non-Invasive Glucose Monitoring System Using Optical Coherence Tomography\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-11-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive glucose monitoring system utilizing optical coherence tomography to determine glucose levels in interstitial fluid. The device is designed for comfortable and frequent monitoring without the need for skin punctures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"cited_by\": \"Alice Johnson\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"cited_by\": \"Bob Williams\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"cited_by\": \"Alice Johnson\"\n        },\n        {\n            \"patent_number\": \"US11000000B2\",\n            \"cited_by\": \"Bob Williams\"\n        },\n        {\n            \"patent_number\": \"US10555555B2\",\n            \"cited_by\": \"Alice Johnson\"\n        },\n        {\n            \"patent_number\": \"US9999999B2\",\n            \"cited_by\": \"Bob Williams\"\n        },\n        {\n            \"patent_number\": \"US11111111B2\",\n            \"cited_by\": \"Alice Johnson\"\n        },\n        {\n            \"patent_number\": \"US8888888B2\",\n            \"cited_by\": \"Bob Williams\"\n        },\n        {\n            \"patent_number\": \"US10222222B2\",\n            \"cited_by\": \"Alice Johnson\"\n        },\n        {\n            \"patent_number\": \"US9777777B2\",\n            \"cited_by\": \"Bob Williams\"\n        },\n        {\n            \"patent_number\": \"US11333333B2\",\n            \"cited_by\": \"Alice Johnson\"\n        }\n    ],\n    \"claims\": [\n        \"A non-invasive glucose monitoring system comprising...\",\n        \"A method for determining glucose levels...\",\n        \"A device configured for comfortable skin contact...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68327", "text": "{\n    \"patent_title\": \"Surgical Robotic System with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-02-10\",\n    \"filing_date\": \"2021-08-05\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical robotic system offering increased precision and control for minimally invasive surgical procedures.  The system incorporates advanced haptic feedback and image guidance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US91234567B2\",\n            \"cited_by\": \"Carol Davis\"\n        },\n        {\n            \"patent_number\": \"US10765432B2\",\n            \"cited_by\": \"Carol Davis\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic system comprising...\",\n        \"A method for performing minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68328", "text": "{\n    \"patent_title\": \"Minimally Invasive Cardiac Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Medtronic Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-04-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive cardiac monitoring system utilizing implantable sensors to continuously monitor heart activity and transmit data wirelessly to a physician's console. This system improves patient outcomes by enabling early detection of arrhythmias and other cardiac events, allowing for timely intervention and reducing hospital readmissions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiac monitoring system comprising...\",\n        \"A method for detecting arrhythmias...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68328", "text": "{\n    \"patent_title\": \"Novel Dental Implant Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"University of California, Los Angeles\"\n        },\n        {\n            \"name\": \"Sarah Johnson\",\n            \"affiliation\": \"Straumann USA\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-01-10\",\n    \"issue_date\": \"2023-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel dental implant design featuring a porous titanium surface to promote osseointegration and improve long-term implant stability. The design incorporates features to reduce stress concentration and enhance biocompatibility.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A dental implant comprising...\",\n        \"A method for improving osseointegration...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68329", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Sensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"MIT Lincoln Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable sensor for continuous glucose monitoring is disclosed. The sensor utilizes a novel enzymatic reaction and microfabrication techniques to provide accurate and reliable glucose readings with minimal invasiveness.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"relevance\": \"Prior art on glucose sensing technology\"\n        }\n    ],\n    \"claims\": [\n        \"1. A sensor for continuous glucose monitoring comprising...\",\n        \"2. The sensor of claim 1, wherein the sensor is implantable...\",\n        \"3. The sensor of claim 1, wherein the sensor utilizes an enzymatic reaction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68329", "text": "{\n    \"patent_title\": \"Improved Stent Design for Coronary Artery Disease\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Williams\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Sarah Johnson\",\n            \"affiliation\": \"Stanford Hospital\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-09-10\",\n    \"filing_date\": \"2017-09-10\",\n    \"issue_date\": \"2020-11-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved stent design for treating coronary artery disease is disclosed. The stent utilizes a novel alloy composition and geometric configuration to minimize restenosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art related to stent materials\"\n        }\n    ],\n    \"claims\": [\n        \"1. A stent for treating coronary artery disease comprising...\",\n        \"2. The stent of claim 1, wherein the stent is made of a nickel-titanium alloy...\",\n        \"3. The stent of claim 1, wherein the stent has a sinusoidal geometric configuration...\",\n        \"4. The stent of claim 1, further comprising a drug-eluting coating...\",\n        \"5. The stent of claim 4, wherein the drug-eluting coating comprises sirolimus...\",\n        \"6. The stent of claim 4, wherein the drug-eluting coating comprises paclitaxel...\",\n        \"7. The stent of claim 1, wherein the stent is expandable...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68330", "text": "{\n    \"patent_title\": \"Neural Network-Based Image Enhancement for Low-Light Photography\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel image enhancement technique utilizing deep convolutional neural networks to improve the quality of images captured in low-light conditions. The network is trained on a large dataset of low-light and normal-light image pairs, learning to map low-light images to their enhanced counterparts. The method incorporates a perceptual loss function to preserve image details and minimize artifacts.  Experimental results demonstrate significant improvements in image brightness, contrast, and visual quality compared to existing techniques. Furthermore, it’s computationally efficient for real-time applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Denoising using Wavelet Transform\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image captured in low-light conditions, comprising:...\",\n        \"A system for enhancing an image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68330", "text": "{\n    \"patent_title\": \"Method for Lossless Image Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corp\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2022-08-01\",\n    \"filing_date\": \"2022-10-15\",\n    \"issue_date\": \"2024-02-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method for lossless compression of image data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"JPEG Standard\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image without loss of information, comprising...\",\n        \"A system for lossless image compression...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68331", "text": "{\n    \"patent_title\": \"Enhanced Magnetic Resonance Imaging with Artificial Intelligence\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for improving the resolution and clarity of MRI images using deep learning algorithms. This allows for earlier and more accurate diagnosis of various diseases.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in MRI image processing.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI images comprising...\",\n        \"A system for diagnosing diseases using enhanced MRI images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68331", "text": "{\n    \"patent_title\": \"Improved X-Ray Detection System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Klaus Schmidt\",\n            \"affiliation\": \"Max Planck Institute\"\n        }\n    ],\n    \"patent_number\": \"EP3456789B1\",\n    \"priority_date\": \"2016-06-20\",\n    \"filing_date\": \"2016-06-20\",\n    \"issue_date\": \"2018-11-07\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"A new X-ray detection system featuring reduced radiation exposure and improved image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related art in X-ray technology.\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray detection system comprising...\",\n        \"A method for reducing radiation exposure during X-ray imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68332", "text": "{\n    \"patent_title\": \"Deep Convolutional Neural Networks for Enhanced Object Detection in Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-05-20\",\n    \"issue_date\": \"2021-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel deep convolutional neural network architecture that significantly improves object detection accuracy and speed in images. It incorporates a new attention mechanism and loss function to overcome limitations of existing methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Convolutional Neural Networks for Image Recognition\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting objects in an image using a deep convolutional neural network...\",\n        \"An apparatus comprising a processor configured to implement the method of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68332", "text": "{\n    \"patent_title\": \"Image Compression Using Discrete Cosine Transform\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"IBM\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2017-01-10\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-05-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method for compressing images using the discrete cosine transform (DCT) algorithm. It improves upon existing DCT-based compression techniques by optimizing the quantization process.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"title\": \"Method and Apparatus for Image Compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image using a discrete cosine transform...\",\n        \"An apparatus configured to implement the method of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68333", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Magnetic Resonance Imaging with Novel Contrast Agents\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Chen\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2020-03-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method and system for enhanced magnetic resonance imaging (MRI) utilizing a novel class of contrast agents. The contrast agents significantly improve image resolution and diagnostic accuracy, particularly in detecting early-stage tumors. The method minimizes artifacts and enhances signal-to-noise ratio.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9789521B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing magnetic resonance imaging comprising...\",\n        \"A contrast agent composition...\",\n        \"A system for performing MRI...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68333", "text": "{\n    \"patent_title\": \"Artificial Intelligence-Powered Image Analysis for Medical Diagnosis\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Google AI Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2021-04-13\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an artificial intelligence (AI) system for automated analysis of medical images, providing rapid and accurate diagnoses of various diseases. The system employs deep learning algorithms to identify patterns indicative of pathology, increasing diagnostic efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"An AI system for medical image analysis...\",\n        \"A method for automated disease detection...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68334", "text": "{\n    \"patent_title\": \"Implantable Microfluidic Device for Controlled Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable microfluidic device for the controlled release of therapeutic agents. The device utilizes microchannels and feedback mechanisms to regulate drug delivery based on real-time physiological parameters, aiming to improve treatment efficacy and minimize side effects.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on microfluidic drug delivery systems.\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising a plurality of microchannels...\",\n        \"A method for controlled drug delivery using the device...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68334", "text": "{\n    \"patent_title\": \"Portable Ultrasound Device with Advanced Image Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2022-03-15\",\n    \"filing_date\": \"2022-03-15\",\n    \"issue_date\": \"2024-02-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A portable ultrasound device utilizing advanced signal processing techniques for enhanced image quality. The device is designed for rapid and accurate diagnostic imaging in various clinical settings.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related to portable ultrasound technology.\"\n        }\n    ],\n    \"claims\": [\n        \"A portable ultrasound device comprising a transducer...\",\n        \"A method for image processing in an ultrasound device...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68335", "text": "{\n    \"patent_title\": \"Real-Time 3D Reconstruction for Intraoperative Optical Coherence Tomography\",\n    \"inventors\": [\n        {\n            \"name\": \"David B. Cooke\",\n            \"affiliation\": \"University of Michigan\"\n        },\n        {\n            \"name\": \"Rajan G. Patel\",\n            \"affiliation\": \"University of Michigan\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2023-12-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for real-time 3D reconstruction of tissue during surgical procedures using optical coherence tomography (OCT). The system provides immediate feedback to surgeons improving precision and minimizing damage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for real-time 3D reconstruction...\",\n        \"A system comprising an OCT scanner...\",\n        \"The method of claim 1, wherein the tissue is cancerous.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68335", "text": "{\n    \"patent_title\": \"Novel Iodinated Contrast Agents for Computed Tomography\",\n    \"inventors\": [\n        {\n            \"name\": \"Maria Hernandez\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2023-05-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel iodinated contrast agents with improved biocompatibility and imaging characteristics for use in computed tomography (CT) scans. These agents enhance image clarity and diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising an iodinated compound...\",\n        \"The contrast agent of claim 1, wherein the iodinated compound has a molecular weight...\",\n        \"A method for enhancing CT images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68336", "text": "{\n    \"patent_title\": \"Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Jian Li\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"EP3842915A1\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-09-22\",\n    \"issue_date\": \"2021-11-10\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"A novel implantable biosensor for continuous and real-time monitoring of glucose levels. The device utilizes a biocompatible nanomaterial to enhance sensitivity and accuracy, offering a significant improvement over existing methods for diabetes management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8574856B2\",\n            \"title\": \"Microfluidic Glucose Sensor\"\n        }\n    ],\n    \"claims\": [\n        \"A biosensor for continuous glucose monitoring comprising...\",\n        \"A method for determining glucose levels in a subject comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68336", "text": "{\n    \"patent_title\": \"Enhanced Anti-Wrinkle Cream Formulation\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-05-01\",\n    \"filing_date\": \"2018-11-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A new formulation of anti-wrinkle cream containing a unique blend of peptides and antioxidants, designed to reduce the appearance of fine lines and wrinkles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Retinol Cream Composition\"\n        }\n    ],\n    \"claims\": [\n        \"A cosmetic composition comprising...\",\n        \"A method for reducing wrinkles comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68337", "text": "{\n    \"patent_title\": \"Miniature Implantable Pressure Sensor for Glaucoma Management\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11254321B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-12-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature, implantable pressure sensor for continuous monitoring of intraocular pressure in glaucoma patients. The sensor wirelessly transmits data to an external device, allowing for proactive management of the disease and potentially preventing vision loss.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"type\": \"Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A miniature pressure sensor comprising...\",\n        \"A wireless communication module...\",\n        \"A method for monitoring intraocular pressure...\",\n        \"A system for glaucoma management...\",\n        \"A biocompatible housing for the sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68337", "text": "{\n    \"patent_title\": \"Surgical Instrument for Bone Cutting\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"General Electric\"\n        },\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US8876543B1\",\n    \"priority_date\": \"2019-01-10\",\n    \"filing_date\": \"2019-01-10\",\n    \"issue_date\": \"2021-05-04\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical instrument for precise bone cutting during orthopedic procedures. The instrument incorporates a novel blade design and ergonomic handle for enhanced control and reduced surgeon fatigue.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9000000B2\",\n            \"type\": \"Prior Art\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"type\": \"Related\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising...\",\n        \"A blade with a specific cutting angle...\",\n        \"An ergonomic handle...\",\n        \"A locking mechanism...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68338", "text": "{\n    \"patent_title\": \"AI-Powered Diagnostic System for Early Cancer Detection in Mammograms\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2022-05-15\",\n    \"filing_date\": \"2022-08-20\",\n    \"issue_date\": \"2024-01-30\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel artificial intelligence system utilizing deep learning algorithms to analyze mammogram images, significantly improving the accuracy and early detection of breast cancer. The system incorporates a unique attention mechanism to highlight subtle anomalies often missed by human radiologists.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image analysis\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting breast cancer in mammogram images using a deep learning model.\",\n        \"A system comprising a deep learning model configured to analyze mammogram images and generate a diagnostic report.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68338", "text": "{\n    \"patent_title\": \"Image Enhancement Technique for Medical Scanners\",\n    \"inventors\": [\n        {\n            \"name\": \"Li Wei\",\n            \"affiliation\": \"Tsinghua University\"\n        },\n        {\n            \"name\": \"Zhang Hong\",\n            \"affiliation\": \"Beijing General Hospital\"\n        }\n    ],\n    \"patent_number\": \"CN101234567B\",\n    \"priority_date\": \"2021-11-01\",\n    \"filing_date\": \"2022-03-10\",\n    \"issue_date\": \"2023-09-15\",\n    \"patent_office\": \"SIPO\",\n    \"abstract\": \"This invention relates to an image enhancement technique for improving the clarity and contrast of images produced by medical scanning devices. The technique utilizes a novel filtering algorithm to reduce noise and enhance image details.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related image processing methods\"\n        }\n    ],\n    \"claims\": [\n        \"An image enhancement method comprising applying a filtering algorithm to a medical image.\",\n        \"A medical imaging system incorporating an image enhancement module.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68339", "text": "{\n    \"patent_title\": \"Micro-Stimulation Device for Chronic Neuropathic Pain\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10567890B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-02-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A micro-stimulation device designed for the non-invasive treatment of chronic neuropathic pain. The device utilizes targeted electrical pulses to modulate nerve activity, offering a potential alternative to opioid-based pain management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in neural stimulation techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A micro-stimulation device comprising...\",\n        \"A method for treating chronic neuropathic pain...\",\n        \"The device according to claim 1, wherein...\",\n        \"The method according to claim 2, wherein...\",\n        \"The device according to claim 3, further comprising...\",\n        \"The method according to claim 4, further comprising...\",\n        \"A system for delivering the stimulation...\",\n        \"A controller for regulating the stimulation parameters...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68339", "text": "{\n    \"patent_title\": \"Surgical Instrument for Minimally Invasive Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Acme Medical Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical instrument designed for minimally invasive procedures. The instrument features enhanced articulation and precision for improved surgical outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related surgical instrument design\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising...\",\n        \"The instrument according to claim 1, wherein...\",\n        \"A handle for manipulating the instrument...\",\n        \"A shaft connected to the handle...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68340", "text": "{\n    \"patent_title\": \"Method and System for Extending Mobile Device Battery Life via Adaptive Power Management\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel adaptive power management system for mobile devices that leverages energy harvesting techniques from ambient radio frequency (RF) signals to supplement battery power. The system dynamically adjusts CPU frequency and display brightness based on user activity and environmental conditions, significantly extending battery life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in adaptive power scaling\"\n        },\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"Related work on RF energy harvesting\"\n        },\n        {\n            \"patent_number\": \"US11000001B2\",\n            \"relevance\": \"Comparison with existing battery management systems.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for extending battery life in a mobile device comprising: monitoring user activity...\",\n        \"A system for adaptive power management including an RF energy harvester...\",\n        \"A mobile device configured to dynamically adjust CPU frequency based on user behavior.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68340", "text": "{\n    \"patent_title\": \"Solid-State Battery with Enhanced Energy Density for Mobile Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Emily Wilson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2023-08-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel solid-state battery architecture with significantly improved energy density and safety characteristics for use in mobile devices. The battery utilizes a new electrolyte material and a unique electrode structure to achieve enhanced performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in solid-state electrolyte materials\"\n        },\n        {\n            \"patent_number\": \"US9654321B2\",\n            \"relevance\": \"Related work on electrode structure optimization\"\n        }\n    ],\n    \"claims\": [\n        \"A solid-state battery comprising: a solid electrolyte layer...\",\n        \"An electrode structure for a solid-state battery...\",\n        \"A mobile device powered by a solid-state battery as claimed in claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68341", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-20\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A minimally invasive surgical system incorporating advanced imaging techniques to provide surgeons with real-time visualization and improved precision, leading to better patient outcomes and reduced recovery times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Similar imaging technology\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in minimally invasive surgery\"\n        },\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"relevance\": \"Related surgical navigation system\"\n        }\n    ],\n    \"claims\": [\n        \"A minimally invasive surgical system comprising...\",\n        \"An imaging module for providing real-time visualization...\",\n        \"A method for performing a surgical procedure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68341", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"Pharmaceutical Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"EP19876543B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"An improved catheter design with enhanced drug delivery capabilities for targeted therapy.  Improved materials and construction for better flow rates.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Existing catheter designs\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising...\",\n        \"A lumen for delivering a therapeutic agent...\",\n        \"A distal tip configured for targeted delivery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68342", "text": "{\n    \"patent_title\": \"Non-Invasive Glucose Monitoring System Using Raman Spectroscopy\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University, Department of Bioengineering\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University, Department of Electrical Engineering\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive glucose monitoring system utilizing Raman spectroscopy for real-time blood glucose level detection without requiring blood samples. The system comprises a handheld device and a disposable sensor patch.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Raman Spectroscopy for Biomedical Applications\",\n            \"assignee\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"claims\": [\n        \"A non-invasive glucose monitoring system comprising...\",\n        \"A sensor patch for use with the glucose monitoring system...\",\n        \"A method for determining blood glucose levels using Raman spectroscopy...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68342", "text": "{\n    \"patent_title\": \"Improved Scalpel Handle Design for Enhanced Surgical Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2024-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved scalpel handle design incorporating ergonomic features and vibration dampening technology for increased surgical precision and reduced hand fatigue.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Surgical Instrument Handle Design\",\n            \"assignee\": \"Johnson & Johnson\"\n        }\n    ],\n    \"claims\": [\n        \"A scalpel handle comprising an ergonomic grip...\",\n        \"A vibration dampening system integrated into the scalpel handle...\",\n        \"A surgical scalpel assembly including the improved handle...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68343", "text": "{\n    \"patent_title\": \"Rapid MRI Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A novel deep learning framework for accelerating MRI reconstruction, enabling significantly faster diagnostic imaging while maintaining high image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on MRI reconstruction techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images...\",\n        \"A system comprising a deep learning model...\",\n        \"The method of claim 1, wherein the reconstruction time is reduced by at least 50%...\",\n        \"The system of claim 2, further comprising a user interface...\",\n        \"The method of claim 1, further comprising a quality assessment module...\",\n        \"The system of claim 2, wherein the deep learning model is trained on a large dataset of MRI images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68343", "text": "{\n    \"patent_title\": \"Improved X-Ray Shielding Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"EP3456789B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-14\",\n    \"issue_date\": \"2021-11-01\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"Novel materials for X-ray shielding, offering improved protection and reduced weight.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous shielding materials\"\n        }\n    ],\n    \"claims\": [\n        \"A shielding material comprising...\",\n        \"The material of claim 1, further comprising...\",\n        \"A method of using the material of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68344", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-11-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable biosensor capable of continuous and real-time glucose monitoring. The device utilizes a novel enzymatic reaction and microfluidic design for improved accuracy and biocompatibility, offering significant advancements in diabetes management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on glucose sensing technology\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable biosensor comprising...\",\n        \"A method for continuous glucose monitoring using said biosensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68344", "text": "{\n    \"patent_title\": \"Enhanced Skin Rejuvenation Device with LED Therapy\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11890123B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2024-01-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved skin rejuvenation device utilizing a combination of LED light therapy and microcurrent stimulation. The device aims to reduce wrinkles and improve skin tone through non-invasive procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10456789B2\",\n            \"relevance\": \"Previous LED skin therapy devices.\"\n        }\n    ],\n    \"claims\": [\n        \"A skin rejuvenation device comprising an array of LEDs...\",\n        \"A method for reducing wrinkles using said device...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68345", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical Stapler with Enhanced Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-04-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical stapler designed for minimally invasive procedures, incorporating ergonomic features to reduce surgeon fatigue and improve precision. The device utilizes a novel staple cartridge and firing mechanism for enhanced tissue approximation and reduced post-operative discomfort.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on surgical staplers\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an ergonomic handle...\",\n        \"A staple cartridge for use in a minimally invasive procedure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68345", "text": "{\n    \"patent_title\": \"Portable Ultrasound Diagnostic Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A compact and portable ultrasound device for point-of-care diagnostics. The device utilizes advanced signal processing techniques to generate high-resolution images of internal organs and tissues.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art on ultrasound imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A portable ultrasound device comprising a transducer...\",\n        \"A signal processing system for generating ultrasound images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68346", "text": "{\n    \"patent_title\": \"Enhanced Image Recognition System Utilizing Lightweight Convolutional Neural Networks for Medical Diagnosis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-11-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for enhancing image recognition accuracy, particularly in medical imaging. A lightweight convolutional neural network is employed to minimize computational complexity while achieving high performance. The system improves image clarity through a novel pre-processing step and avoids the use of complex mathematical formulas for faster processing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Convolutional Neural Networks for Image Recognition\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image recognition accuracy comprising...\",\n        \"A system for processing medical images comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68346", "text": "{\n    \"patent_title\": \"Deep Learning Framework for Financial Fraud Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Citigroup\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"JPMorgan Chase\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2022-05-10\",\n    \"filing_date\": \"2022-05-10\",\n    \"issue_date\": \"2024-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a deep learning framework designed for identifying fraudulent transactions in financial data. It utilizes recurrent neural networks and complex mathematical models to analyze patterns and anomalies in transaction history.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Anomaly Detection in Financial Data\"\n        }\n    ],\n    \"claims\": [\n        \"A system for detecting fraudulent transactions comprising...\",\n        \"A method for analyzing financial data using recurrent neural networks...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68347", "text": "{\n    \"patent_title\": \"Method for Enhanced MRI Image Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-09-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for improving the quality and speed of MRI image reconstruction using a deep learning approach. The method addresses artifacts and noise common in MRI images, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"The method of claim 1, wherein the deep learning model is a convolutional neural network.\",\n        \"The method of claim 1, wherein the MRI image is used for diagnosing neurological disorders.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68347", "text": "{\n    \"patent_title\": \"Theoretical Framework for Quantum Entanglement in Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This patent details a theoretical framework exploring the potential of quantum entanglement for enhancing the resolution and sensitivity of medical imaging techniques. It focuses on the fundamental principles and mathematical models governing this phenomenon.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\"\n        }\n    ],\n    \"claims\": [\n        \"A theoretical framework for utilizing quantum entanglement in medical imaging.\",\n        \"The framework of claim 1, wherein the entanglement is achieved through...\",\n        \"The framework of claim 1, comprising a mathematical model for...\",\n        \"A method for simulating quantum entanglement effects in medical imaging systems.\",\n        \"A system comprising components to explore the principles of quantum entanglement.\",\n        \"A method for theoretical quantum medical imaging\",\n        \"A model for quantum-enhanced image formation\",\n        \"A simulation protocol for quantum phenomena\",\n        \"A framework for theoretical image analysis\",\n        \"A system for investigating the impact of entangled photons\",\n        \"A conceptual design for quantum-assisted diagnostics\",\n        \"An analysis of quantum coherence in imaging\",\n        \"A theory of quantum state manipulation in imaging\",\n        \"A mathematical formulation of quantum image processing\",\n        \"A method for simulating quantum interactions\",\n        \"A framework for modelling entangled states\",\n        \"A theory of quantum measurement in medical imaging\",\n        \"A simulation environment for quantum image reconstruction\"\n    ]\n}"}
{"_id": "Academic--patents--p--68348", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Pressure Sensor for Glaucoma Management\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Davis\",\n            \"affiliation\": \"Boston University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable pressure sensor is disclosed for continuous monitoring of intraocular pressure in glaucoma patients. The sensor transmits data wirelessly to an external receiver, enabling proactive management of the disease and potentially preventing vision loss.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in implantable sensors.\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable pressure sensor comprising...\",\n        \"A wireless communication module for transmitting data...\",\n        \"A method for monitoring intraocular pressure...\",\n        \"A system for glaucoma management...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68348", "text": "{\n    \"patent_title\": \"Surgical Instrument Sterilization Method\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Wilson\",\n            \"affiliation\": \"SterilTech Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-11-15\",\n    \"filing_date\": \"2020-11-15\",\n    \"issue_date\": \"2022-07-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for sterilizing surgical instruments using a combination of ultrasonic cleaning and plasma treatment. The method ensures complete removal of pathogens and reduces the risk of post-operative infections.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art in sterilization techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for sterilizing surgical instruments...\",\n        \"The use of ultrasonic cleaning...\",\n        \"The use of plasma treatment...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68349", "text": "{\n    \"patent_title\": \"Ultrasound-Based Cancer Detection System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-05-20\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel ultrasound system that uses advanced signal processing techniques to improve the accuracy of cancer detection in early stages. The system utilizes a new algorithm for analyzing ultrasound images, resulting in a significant reduction in false-positive rates.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Improved Ultrasound Transducer Design\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancer using ultrasound comprising...\",\n        \"An ultrasound system comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68349", "text": "{\n    \"patent_title\": \"MRI-Guided Biopsy Needle System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-03-12\",\n    \"issue_date\": \"2023-05-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for guiding biopsy needles during MRI procedures, enhancing accuracy and minimizing invasiveness. The system integrates real-time MRI imaging with a robotic arm to precisely position the biopsy needle.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"title\": \"Advanced MRI Coil Design\"\n        }\n    ],\n    \"claims\": [\n        \"A system for MRI-guided biopsy comprising...\",\n        \"A method for performing a biopsy using MRI...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68350", "text": "{\n    \"patent_title\": \"Implantable Cardioverter-Defibrillator with Enhanced Lead Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Boston University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardioverter-defibrillator (ICD) incorporating advanced lead monitoring capabilities for early detection of lead failure and improved patient safety. The device utilizes impedance measurements and waveform analysis to assess lead integrity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related technology in ICD lead design\"\n        },\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"Background on impedance-based monitoring\"\n        }\n    ],\n    \"claims\": [\n        \"1. An implantable cardioverter-defibrillator comprising...\",\n        \"2. The cardioverter-defibrillator of claim 1, wherein...\",\n        \"3. A method for monitoring the integrity of a lead in an...\",\n        \"4. The method of claim 3, further comprising...\",\n        \"5. The cardioverter-defibrillator of claim 1, further comprising...\",\n        \"6. The method of claim 3, wherein the impedance measurement is...\",\n        \"7. A system for monitoring the integrity of a lead in an...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68350", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Medical Devices Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2022-02-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical stapler designed for improved ergonomics and ease of use during laparoscopic procedures. Features include a redesigned handle and a more precise staple delivery mechanism.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in surgical stapler design\"\n        },\n        {\n            \"patent_number\": \"US9654321B2\",\n            \"relevance\": \"Relevant art for laparoscopic instruments\"\n        },\n        {\n            \"patent_number\": \"US5432109B2\",\n            \"relevance\": \"Early stapler design.\"\n        }\n    ],\n    \"claims\": [\n        \"1. A surgical stapler comprising...\",\n        \"2. The surgical stapler of claim 1, wherein...\",\n        \"3. A staple cartridge for use with the surgical stapler of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68351", "text": "{\n    \"patent_title\": \"Method and System for Enhanced MRI Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2017-05-15\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing magnetic resonance images (MRI) with improved clarity and reduced noise, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8766234B2\",\n            \"relevance\": \"Prior art in MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68351", "text": "{\n    \"patent_title\": \"Improved X-ray Imaging System with Reduced Radiation Dosage\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Dr. Jane Doe\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2018-11-01\",\n    \"issue_date\": \"2020-05-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved X-ray imaging system designed to minimize radiation exposure while maintaining image quality for diagnostic purposes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art in X-ray imaging\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A method for reducing radiation dosage in X-ray imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68352", "text": "{\n    \"patent_title\": \"Novel Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel biosensor for continuous glucose monitoring utilizing a minimally invasive microfluidic approach. The device improves patient outcomes by providing real-time glucose data, enabling better diabetes management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on glucose sensors\"\n        }\n    ],\n    \"claims\": [\n        \"A biosensor comprising a microfluidic channel...\",\n        \"A method for continuous glucose monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68352", "text": "{\n    \"patent_title\": \"Advanced Surgical Stapler with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2022-01-10\",\n    \"filing_date\": \"2022-01-10\",\n    \"issue_date\": \"2023-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An advanced surgical stapler designed to provide enhanced precision and control during surgical procedures. Improves surgical efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on surgical staplers\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising a staple cartridge...\",\n        \"A method for stapling tissue...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68353", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Boston Medical Devices Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system comprising an endoscope with enhanced image processing and a set of specialized instruments designed to reduce trauma and accelerate patient recovery. The system allows for precise tissue manipulation and improved visualization during surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Minimally Invasive Surgical Instrument\"\n        }\n    ],\n    \"claims\": [\n        \"A minimally invasive surgical system comprising an endoscope and a set of surgical instruments.\",\n        \"The surgical system of claim 1, wherein the endoscope includes an image processing unit.\",\n        \"The surgical system of claim 2, wherein the image processing unit enhances image clarity.\",\n        \"A method for performing minimally invasive surgery using the system of claim 1.\",\n        \"The method of claim 4, further comprising monitoring patient vital signs during the procedure.\",\n        \"The method of claim 4, wherein the surgical instruments are designed to minimize tissue trauma.\",\n        \"The method of claim 4, wherein the surgical procedure is performed to improve patient recovery time.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68353", "text": "{\n    \"patent_title\": \"Robotic Surgical System for Precise Tissue Removal\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-01-10\",\n    \"filing_date\": \"2017-01-10\",\n    \"issue_date\": \"2020-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A robotic surgical system with high precision capabilities for tissue removal and reconstruction. The system utilizes a robotic arm controlled by a surgeon to perform complex surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Robotic Surgical Arm\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system comprising a robotic arm and a control interface.\",\n        \"The robotic surgical system of claim 1, wherein the robotic arm includes multiple degrees of freedom.\",\n        \"The robotic surgical system of claim 2, wherein the control interface allows a surgeon to manipulate the robotic arm.\",\n        \"A method for performing surgery using the robotic surgical system of claim 1.\",\n        \"The method of claim 4, further comprising providing real-time feedback to the surgeon.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68354", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Analysis Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing medical image analysis using deep learning techniques. The invention utilizes convolutional neural networks to automatically detect and classify anomalies in medical images, improving diagnostic accuracy and reducing physician workload. The system is applicable to various imaging modalities including MRI, CT, and X-ray.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image segmentation\"\n        }\n    ],\n    \"claims\": [\n        \"A method for analyzing a medical image comprising...\",\n        \"A system for detecting anomalies in a medical image...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68354", "text": "{\n    \"patent_title\": \"Cosmetic Skin Analysis Device and Method\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"L'Oreal\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-02-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A device and method for analyzing skin condition and providing personalized cosmetic recommendations. The invention uses image processing to assess skin tone, texture, and the presence of wrinkles and blemishes. The system provides customized product suggestions based on the analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Prior art in skin analysis\"\n        }\n    ],\n    \"claims\": [\n        \"A cosmetic analysis device comprising...\",\n        \"A method for assessing skin condition...\",\n        \"A system for providing personalized cosmetic recommendations...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68355", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-05-15\",\n    \"issue_date\": \"2023-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a minimally invasive surgical system incorporating a high-resolution imaging module and robotic arms for precise tissue manipulation, ultimately improving patient outcomes by reducing recovery times and minimizing scarring.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in surgical robotics.\"\n        }\n    ],\n    \"claims\": [\n        \"A minimally invasive surgical system comprising...\",\n        \"A method for performing surgery using the system...\",\n        \"An imaging module for visualization...\",\n        \"A robotic arm for tissue manipulation...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68355", "text": "{\n    \"patent_title\": \"Complex Cardiac Rhythm Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2022-07-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A sophisticated system for monitoring and regulating cardiac rhythms using advanced algorithms and multiple sensor inputs. Designed for patients with complex arrhythmias.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related prior art on cardiac pacemakers.\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiac rhythm management system comprising...\",\n        \"A method for detecting arrhythmias...\",\n        \"An algorithm for adjusting pacing parameters...\",\n        \"A sensor for measuring cardiac activity...\",\n        \"A communication module for transmitting data...\",\n        \"A power supply for providing energy...\",\n        \"A housing for protecting the components...\",\n        \"A user interface for displaying information...\",\n        \"A data storage module for recording data...\",\n        \"A processing unit for analyzing data...\",\n        \"A control module for controlling the system...\",\n        \"A safety mechanism for preventing malfunction...\",\n        \"A diagnostic tool for identifying problems...\",\n        \"A reporting module for generating reports...\",\n        \"A calibration module for adjusting settings...\",\n        \"An authentication module for security...\",\n        \"An encryption module for data protection...\",\n        \"A backup system for data recovery...\",\n        \"A remote monitoring system for telehealth...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68356", "text": "{\n    \"patent_title\": \"Adaptive Histogram Equalization for Low-Light Image Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method for enhancing the contrast of images captured in low-light conditions using adaptive histogram equalization. The method dynamically adjusts the histogram equalization parameters based on the local image characteristics, resulting in improved image quality and visibility.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        },\n        {\n            \"patent_number\": \"US8987654B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing the contrast of an image comprising...\",\n        \"An apparatus for performing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68356", "text": "{\n    \"patent_title\": \"Automated Diagnosis System Using Medical Image Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-05-20\",\n    \"issue_date\": \"2019-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a system for automated diagnosis of diseases using medical image analysis. The system utilizes advanced image processing techniques and machine learning algorithms to identify and classify anomalies in medical images, aiding in the accurate and timely diagnosis of various medical conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for automated diagnosis of diseases comprising...\",\n        \"A method for analyzing medical images using machine learning...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68357", "text": "{\n    \"patent_title\": \"Miniaturized Optical Coherence Tomography System for In-Vivo Retinal Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A miniaturized optical coherence tomography (OCT) system for high-resolution, non-invasive in-vivo retinal imaging. The system incorporates a swept-source laser and a novel scanning mechanism to achieve improved image quality and speed, enabling early detection of retinal diseases.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in OCT technology\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized optical coherence tomography system comprising...\",\n        \"The system of claim 1, wherein the OCT system is configured for in-vivo retinal imaging.\",\n        \"The system of claim 1, further comprising a scanning mechanism...\",\n        \"A method for diagnosing retinal diseases using the system of claim 1.\",\n        \"The method of claim 4, wherein the diagnosis is performed non-invasively.\",\n        \"The method of claim 4, comprising analyzing the OCT images...\",\n        \"The system of claim 1, wherein the system is portable.\",\n        \"The system of claim 1, wherein the system is used for early detection of retinal degeneration.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68357", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Angioplasty\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-11-20\",\n    \"filing_date\": \"2019-11-20\",\n    \"issue_date\": \"2022-06-01\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"An improved catheter design for performing angioplasty procedures. The catheter features a more flexible tip and enhanced balloon material to facilitate access to difficult-to-reach vessels.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art in catheter design\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter for angioplasty comprising...\",\n        \"The catheter of claim 1, wherein the tip is flexible.\",\n        \"The catheter of claim 1, wherein the balloon is made of a polymer material.\",\n        \"A method for performing angioplasty using the catheter of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68358", "text": "{\n    \"patent_title\": \"AI-Powered Diagnostic System for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel AI system utilizing deep learning algorithms to analyze medical images for early detection of cancerous tumors, improving diagnostic accuracy and patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image processing for medical applications.\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for detecting cancer...\",\n        \"2. The method of claim 1, wherein...\",\n        \"3. A system comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68358", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2022-03-15\",\n    \"filing_date\": \"2022-03-15\",\n    \"issue_date\": \"2024-01-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an improved algorithm for compressing digital data, leading to increased storage efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related to data compression techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for compressing data...\",\n        \"2. The method of claim 1, wherein...\",\n        \"3. A system for data compression...\",\n        \"4. An apparatus for data compression...\",\n        \"5. A computer-readable medium...\",\n        \"6. The method of claim 1, further comprising...\",\n        \"7. The system of claim 3, wherein...\",\n        \"8. The apparatus of claim 4, comprising...\",\n        \"9. A network system...\",\n        \"10. The method of claim 6, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68359", "text": "{\n    \"patent_title\": \"Enhanced MRI Image Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-08-20\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel deep learning architecture for reconstructing high-resolution MRI images from undersampled k-space data, leading to faster scan times and improved image quality. The method utilizes a convolutional neural network trained on a large dataset of MRI images to accurately estimate the missing k-space values, resulting in significantly reduced artifacts and enhanced diagnostic capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Compressed Sensing MRI\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"A system for performing MRI reconstruction...\",\n        \"A non-transitory computer-readable medium...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68359", "text": "{\n    \"patent_title\": \"Improved Echocardiography System with Real-Time 3D Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Carlos Rodriguez\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2018-02-15\",\n    \"issue_date\": \"2019-07-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel echocardiography system capable of real-time 3D visualization of the heart. The system utilizes advanced signal processing techniques to improve image clarity and accuracy, allowing for more precise diagnosis of cardiovascular diseases.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Automated Cardiac Segmentation\"\n        }\n    ],\n    \"claims\": [\n        \"An echocardiography system comprising...\",\n        \"A method for 3D cardiac visualization...\",\n        \"A software module for automated heart segmentation...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68360", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Neurological Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Jian Li\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-03-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method and system for enhancing the clarity of neurological images obtained through MRI and CT scanning. The technique utilizes a deep learning algorithm trained on a vast dataset of patient scans to reduce noise and improve resolution. The resulting images allow for more accurate diagnosis of neurological conditions such as Alzheimer's disease, Parkinson's disease, and multiple sclerosis. The system also includes a user interface for radiologists to easily adjust parameters and visualize the enhanced images. Clinical trials have demonstrated a significant improvement in diagnostic accuracy with this system compared to conventional imaging techniques. This is a significant advancement in the field of medical imaging, providing more robust tools for detecting and monitoring neurological diseases.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"citation_type\": \"Cited by\"\n        },\n        {\n            \"patent_number\": \"US10012345B2\",\n            \"citation_type\": \"Cited by\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"citation_type\": \"Cited by\"\n        },\n        {\n            \"patent_number\": \"US10345678B2\",\n            \"citation_type\": \"Cited by\"\n        },\n        {\n            \"patent_number\": \"US10456789B2\",\n            \"citation_type\": \"Cited by\"\n        },\n        {\n            \"patent_number\": \"US10567890B2\",\n            \"citation_type\": \"Cited by\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing the clarity of neurological images...\",\n        \"A system for implementing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68360", "text": "{\n    \"patent_title\": \"Portable X-Ray Device for Fracture Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2015-05-18\",\n    \"issue_date\": \"2017-03-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A compact and portable X-ray device designed for rapid fracture detection in emergency medical settings. The device utilizes a low-dose X-ray source and a digital detector for instant image acquisition. It's lightweight and can be easily transported to the patient’s location. \",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"citation_type\": \"Cited by\"\n        },\n        {\n            \"patent_number\": \"US9456789B2\",\n            \"citation_type\": \"Cited by\"\n        }\n    ],\n    \"claims\": [\n        \"A portable X-ray device comprising...\",\n        \"A method for detecting fractures using the device of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68361", "text": "{\n    \"patent_title\": \"Efficient Deep Learning via Network Pruning and Quantization\",\n    \"inventors\": [\n        {\n            \"name\": \"Liang Zhao\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Mark Chen\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11876452B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-05-14\",\n    \"issue_date\": \"2023-09-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for pruning and quantizing deep neural networks to reduce computational complexity and memory footprint without significant accuracy loss. The method utilizes a novel iterative pruning algorithm combined with mixed-precision quantization.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10546587B2\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US11237890B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for pruning a deep neural network comprising...\",\n        \"A system for quantizing a deep neural network comprising...\",\n        \"A non-transitory computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68361", "text": "{\n    \"patent_title\": \"Real-Time Object Detection in Images Using Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11789234B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-10-30\",\n    \"issue_date\": \"2023-03-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for real-time object detection in images utilizing convolutional neural networks. The system is optimized for high accuracy and low latency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9892023B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A system for detecting objects in an image comprising...\",\n        \"A method for processing an image to identify objects comprising...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68362", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Reconstruction in Positron Emission Tomography\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10556789B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel method for image reconstruction in positron emission tomography (PET) utilizing advanced statistical modeling to enhance image quality and diagnostic accuracy. The system demonstrates a significant improvement in lesion detectability, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"inventor\": \"Siemens AG\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an image from PET data...\",\n        \"A system for performing PET image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68362", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Vascular Access\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-09-20\",\n    \"filing_date\": \"2017-09-20\",\n    \"issue_date\": \"2021-07-13\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel design for a vascular access catheter is presented, featuring improved flexibility and reduced risk of thrombosis. This device aims to improve patient comfort and reduce complications during medical procedures.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A vascular access catheter comprising...\",\n        \"A method for inserting a catheter into a blood vessel...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68363", "text": "{\n    \"patent_title\": \"Enhanced Magnetic Resonance Imaging with Artificial Intelligence-Assisted Diagnosis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US10456789B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for improving the accuracy of medical diagnoses using magnetic resonance imaging (MRI) and artificial intelligence (AI). The system analyzes MRI data to identify subtle anomalies indicative of disease, providing clinicians with enhanced diagnostic support.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art in MRI image processing.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for analyzing MRI data comprising...\",\n        \"A system for assisting in medical diagnosis...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The method of claim 1, wherein the AI algorithm utilizes a deep learning model.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68363", "text": "{\n    \"patent_title\": \"Improved X-Ray Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2017-05-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An X-ray imaging system with improved image clarity and reduced radiation dose. The system utilizes a novel detector and image processing algorithm to enhance image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related prior art in X-ray technology.\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A detector for converting X-rays into an electrical signal...\",\n        \"An image processing algorithm for enhancing image clarity...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68364", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Diagnostic Testing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-11-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for rapid and accurate diagnostic testing, enabling point-of-care applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for detecting biomarkers...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68364", "text": "{\n    \"patent_title\": \"Improved Drug Delivery System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Pfizer Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-03-01\",\n    \"filing_date\": \"2019-09-05\",\n    \"issue_date\": \"2021-06-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel drug delivery system designed to enhance bioavailability and efficacy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A drug delivery system comprising...\",\n        \"A method for administering drugs...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68365", "text": "{\n    \"patent_title\": \"Non-Invasive Glucose Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive system for continuous glucose monitoring utilizing optical sensors. Improves patient management of diabetes by providing real-time glucose levels without the need for blood draws.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for non-invasive glucose monitoring...\",\n        \"A device comprising optical sensors for glucose detection...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68365", "text": "{\n    \"patent_title\": \"Surgical Robotic Arm with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Intuitive Surgical\"\n        },\n        {\n            \"name\": \"Emily Wilson\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-01-10\",\n    \"filing_date\": \"2022-01-10\",\n    \"issue_date\": \"2023-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical robotic arm system designed for increased precision and dexterity during minimally invasive procedures.  Enhances surgical control and reduces patient recovery time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic arm comprising...\",\n        \"A control system for precise movement of the robotic arm...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68366", "text": "{\n    \"patent_title\": \"Adaptive Histogram Equalization for Enhanced Low-Light Image Visibility\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-02-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for enhancing the visibility of images captured in low-light conditions using adaptive histogram equalization. The method dynamically adjusts the histogram based on local image characteristics, resulting in improved contrast and detail.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\",\n            \"relevance\": \"Prior art on histogram equalization\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing the visibility of images captured in low-light conditions, comprising...\",\n        \"A system for implementing the method according to claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68366", "text": "{\n    \"patent_title\": \"Automated Cancer Cell Detection in Histological Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"EP3456789A1\",\n    \"priority_date\": \"2022-01-15\",\n    \"filing_date\": \"2022-01-15\",\n    \"issue_date\": \"2023-08-15\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"A system and method for automatically detecting cancer cells in histological images using deep learning techniques. The system provides accurate and efficient analysis of tissue samples.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Prior art on image segmentation\"\n        }\n    ],\n    \"claims\": [\n        \"A system for detecting cancer cells in histological images, comprising...\",\n        \"A method for analyzing tissue samples using the system according to claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68367", "text": "{\n    \"patent_title\": \"Minimally Invasive Glucose Sensor with Enhanced Patient Comfort\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-06-15\",\n    \"issue_date\": \"2019-03-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel minimally invasive glucose sensor utilizing biocompatible materials and a reduced sensor size for enhanced patient comfort and accurate glucose monitoring.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A glucose sensor comprising a biocompatible material.\",\n        \"A method for non-invasive glucose monitoring.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68367", "text": "{\n    \"patent_title\": \"Surgical Retractor with Improved Articulation\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Jessica Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2018-02-15\",\n    \"issue_date\": \"2020-10-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical retractor designed for enhanced visibility and maneuverability during surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical retractor with articulated arms.\",\n        \"A method for performing surgery using the retractor.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68368", "text": "{\n    \"patent_title\": \"High-Energy Density Lithium-Sulfur Battery with Graphene-Reinforced Electrolyte\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11245678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-22\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-sulfur battery design incorporating a graphene-reinforced electrolyte exhibiting significantly improved energy density and cycle life. This technology is suitable for electric vehicle and grid-scale energy storage applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-sulfur battery comprising...\",\n        \"A graphene-reinforced electrolyte...\",\n        \"An electric vehicle utilizing the battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68368", "text": "{\n    \"patent_title\": \"Improved Lead-Acid Battery for Automotive Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Exide Technologies\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2021-04-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved lead-acid battery design focusing on enhanced durability and reduced manufacturing costs for use in conventional automotive systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A lead-acid battery comprising...\",\n        \"A separator with improved porosity...\",\n        \"An automotive system utilizing the battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68369", "text": "{\n    \"patent_title\": \"Adaptive Modulation and Coding Scheme for Millimeter Wave Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-01-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and apparatus for dynamically adjusting modulation and coding schemes in millimeter wave communication systems to optimize data throughput and reliability. The system adapts to channel conditions in real-time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in modulation techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for adapting modulation and coding schemes...\",\n        \"An apparatus comprising a processor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68369", "text": "{\n    \"patent_title\": \"Improved Handover Procedure in LTE Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Karl Svensson\",\n            \"affiliation\": \"Ericsson AB\"\n        }\n    ],\n    \"patent_number\": \"US9235412B1\",\n    \"priority_date\": \"2014-09-20\",\n    \"filing_date\": \"2015-03-20\",\n    \"issue_date\": \"2016-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for seamless handover between LTE base stations, reducing interruption during mobile communication.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8560123B2\",\n            \"relevance\": \"Related to LTE handover protocols\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing handover...\",\n        \"A network element configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68370", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel contrast agent for magnetic resonance imaging (MRI) that enhances image clarity and provides improved diagnostic accuracy. The agent utilizes targeted nanoparticles to selectively bind to cancerous tissues, leading to brighter and more defined images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Targeted Nanoparticles for Cancer Imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising targeted nanoparticles.\",\n        \"A method for enhancing MRI image clarity using the contrast agent.\",\n        \"A method for diagnosing cancer using the contrast agent.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68370", "text": "{\n    \"patent_title\": \"New Algorithm for Image Compression in Digital Photography\",\n    \"inventors\": [\n        {\n            \"name\": \"Mr. John Smith\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2017-08-22\",\n    \"filing_date\": \"2017-08-22\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved algorithm for compressing digital images, reducing file size without significant loss of quality. This algorithm utilizes wavelet transforms and quantization techniques to achieve high compression ratios.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Wavelet-Based Image Compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing digital images using wavelet transforms.\",\n        \"A digital image compression algorithm with a compression ratio of at least 2:1.\",\n        \"A digital image storage system utilizing the compression algorithm.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68371", "text": "{\n    \"patent_title\": \"Enhanced MRI Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10456789B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-02-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing magnetic resonance images (MRI) using deep learning techniques. This method significantly improves image clarity and reduces noise, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for processing MRI data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68371", "text": "{\n    \"patent_title\": \"Improved X-ray Image Processing Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-09-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A technique for enhancing the contrast and reducing artifacts in X-ray images, leading to improved diagnostic capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing X-ray images...\",\n        \"A system for analyzing X-ray data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68372", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction Method for MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10555555B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel image reconstruction method for Magnetic Resonance Imaging (MRI) that significantly improves image quality and reduces scan time. The method utilizes a compressed sensing algorithm with a learned regularization term based on deep convolutional neural networks. The resulting images exhibit higher resolution and reduced artifacts, leading to more accurate diagnoses. The invention incorporates a feedback loop to refine the reconstruction process iteratively, enhancing the overall performance and reliability of the MRI system.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8888888B1\",\n            \"title\": \"MRI Image Reconstruction using Compressed Sensing\"\n        },\n        {\n            \"patent_number\": \"US9999999B2\",\n            \"title\": \"Deep Learning for Medical Image Analysis\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"The method of claim 1, wherein the regularization term is learned using a deep convolutional neural network.\",\n        \"The method of claim 1, further comprising a feedback loop for refining the reconstruction process.\",\n        \"An MRI system configured to implement the method of claim 1.\",\n        \"A computer-readable medium storing instructions for performing the method of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68372", "text": "{\n    \"patent_title\": \"Contrast Agent for X-Ray Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of Berlin\"\n        }\n    ],\n    \"patent_number\": \"EP3333333B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-10-25\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"A new contrast agent for X-ray imaging with improved visibility.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"The contrast agent of claim 1 for use in X-ray imaging.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68373", "text": "{\n    \"patent_title\": \"Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable biosensor for continuous glucose monitoring, providing real-time data for improved diabetes management.  The device utilizes a novel enzyme-based detection system and biocompatible materials.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8545001B2\"\n        },\n        {\n            \"patent_number\": \"US9126002B2\"\n        }\n    ],\n    \"claims\": [\n        \"A biosensor comprising a glucose oxidase enzyme immobilized on a substrate.\",\n        \"A method for continuous glucose monitoring using the biosensor.\",\n        \"A system for transmitting glucose data to a remote monitoring device.\",\n        \"A biocompatible coating for the biosensor.\",\n        \"A method of calibrating the biosensor.\",\n        \"A device for automatic insulin delivery based on biosensor data.\",\n        \"A wireless communication module integrated with the biosensor.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68373", "text": "{\n    \"patent_title\": \"Novel Dental Implant Design for Enhanced Osseointegration\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-09-01\",\n    \"filing_date\": \"2017-09-01\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel dental implant design featuring a micro-porous surface to enhance osseointegration and long-term stability.  The implant is fabricated from titanium alloy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A dental implant comprising a titanium alloy body.\",\n        \"A micro-porous surface structure on the implant body.\",\n        \"A method for fabricating the implant using additive manufacturing.\",\n        \"A coating to promote bone growth on the implant.\",\n        \"A surgical tool for precise implant placement.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68374", "text": "{\n    \"patent_title\": \"Remote Physiological Data Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for remotely monitoring a patient's physiological data, including heart rate, blood pressure, and oxygen saturation. The system transmits the data to a healthcare provider for analysis and intervention.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for remotely monitoring a patient's vital signs.\",\n        \"A method for transmitting physiological data to a healthcare provider.\",\n        \"A device for measuring heart rate and blood pressure.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68374", "text": "{\n    \"patent_title\": \"Surgical Robotic System with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2022-01-10\",\n    \"filing_date\": \"2022-01-10\",\n    \"issue_date\": \"2024-01-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A robotic surgical system that provides surgeons with enhanced precision and control during complex surgical procedures. The system includes a robotic arm, a vision system, and a control console.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system with enhanced precision.\",\n        \"A method for performing minimally invasive surgery.\",\n        \"A robotic arm for surgical applications.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68375", "text": "{\n    \"patent_title\": \"Deep Learning Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention utilizes deep learning techniques to enhance the resolution and clarity of medical images obtained from MRI and CT scans. The system significantly reduces noise and artifacts, improving diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Prior Art Medical Imaging System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing medical images using a convolutional neural network.\",\n        \"A system comprising a medical imaging device and a deep learning module.\",\n        \"The method of claim 1, wherein the medical imaging device is an MRI scanner.\",\n        \"The system of claim 2, wherein the deep learning module is trained on a dataset of medical images.\",\n        \"The method of claim 1, further comprising a noise reduction step.\",\n        \"The system of claim 2, further comprising a user interface for displaying the reconstructed images.\",\n        \"A computer-readable medium storing instructions for performing the method of claim 1.\",\n        \"The method of claim 5, wherein the noise reduction step utilizes a wavelet transform.\",\n        \"The system of claim 2, wherein the deep learning module comprises multiple layers.\",\n        \"The method of claim 1, wherein the reconstructed image has an improved signal-to-noise ratio.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68375", "text": "{\n    \"patent_title\": \"Improved X-Ray Tube Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2015-05-18\",\n    \"issue_date\": \"2017-03-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel design for X-ray tubes that improves efficiency and reduces radiation exposure. The design incorporates a new filament material and cooling system.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Conventional X-Ray Tube\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube comprising a filament made of lanthanum hexaboride.\",\n        \"The X-ray tube of claim 1, further comprising a cooling system utilizing liquid metal.\",\n        \"A method for manufacturing an X-ray tube according to claim 1.\",\n        \"The method of claim 3, wherein the liquid metal is gallium.\",\n        \"The X-ray tube of claim 1, wherein the filament is coated with a protective layer.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68376", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Pathogen Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device is disclosed for the rapid detection of pathogens in biological samples. The device utilizes a novel polymer material with enhanced biocompatibility and sensitivity, allowing for point-of-care diagnostics. The device integrates microchannels, reaction chambers, and optical detection systems for automated analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"title\": \"Microfluidic Device for Cell Sorting\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising a polymer material...\",\n        \"A method for detecting pathogens using the device...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68376", "text": "{\n    \"patent_title\": \"Implantable Cardiac Pacemaker with Advanced Rhythm Control\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Medtronic Inc.\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Medtronic Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-01-10\",\n    \"filing_date\": \"2017-01-10\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac pacemaker system with enhanced rhythm control algorithms is disclosed. The system features advanced sensors and a miniaturized power supply. Improved battery life and patient comfort are achieved.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Implantable Defibrillator\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable cardiac pacemaker comprising a rhythm control algorithm...\",\n        \"A method for controlling heart rhythm using the pacemaker...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68377", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Cardiac Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"David M. Guttman\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"James R. Goodfellow\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11871352B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-05-14\",\n    \"issue_date\": \"2023-12-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized wireless sensor system for continuous monitoring of cardiac function, enabling early detection of arrhythmias and heart failure. The device is fully implantable and utilizes biocompatible materials for long-term performance. Addresses the need for non-invasive cardiac monitoring.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876234B2\",\n            \"relevance\": \"Prior art in wireless power transfer for implants\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless cardiac sensor system comprising...\",\n        \"A method for monitoring cardiac function using the sensor system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68377", "text": "{\n    \"patent_title\": \"Drug-Eluting Stent with Improved Polymer Coating\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert A. Byrnes\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jennifer L. Hall\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11642897B2\",\n    \"priority_date\": \"2022-01-20\",\n    \"filing_date\": \"2022-01-19\",\n    \"issue_date\": \"2023-05-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A drug-eluting stent with a novel polymer coating designed to reduce restenosis after percutaneous coronary intervention. The polymer coating provides sustained drug release and improved biocompatibility. This stent is a substantial improvement on existing stent technologies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9546123B2\",\n            \"relevance\": \"Prior art on drug-eluting stents\"\n        }\n    ],\n    \"claims\": [\n        \"A drug-eluting stent comprising...\",\n        \"A method for treating coronary artery disease using the stent...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68378", "text": "{\n    \"patent_title\": \"Efficient Image Enhancement Algorithm for Satellite Imagery\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an efficient algorithm for enhancing the quality of satellite imagery, improving visual clarity and feature detection. The algorithm utilizes a novel approach to contrast stretching and noise reduction.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Processing Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing satellite imagery comprising...\",\n        \"An algorithm for contrast stretching...\",\n        \"A system for processing and displaying satellite images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68378", "text": "{\n    \"patent_title\": \"Medical Image Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a deep learning method for reconstructing medical images from limited data, improving diagnostic accuracy. The algorithm is specifically designed for MRI scans.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Medical Imaging System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing medical images using a deep neural network...\",\n        \"A system for processing MRI data...\",\n        \"A computer-implemented method for improving image quality...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68379", "text": "{\n    \"patent_title\": \"Wearable Sensor System for Continuous Non-Invasive Blood Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-09-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wearable sensor system for continuous, non-invasive monitoring of blood glucose levels using optical sensing technology. The system provides real-time data and alerts to patients and healthcare providers.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A wearable sensor system comprising an optical sensor...\",\n        \"A method for non-invasive blood glucose monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68379", "text": "{\n    \"patent_title\": \"Improved Dental Implant with Enhanced Osseointegration\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Los Angeles\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-05-01\",\n    \"filing_date\": \"2020-11-15\",\n    \"issue_date\": \"2022-08-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel dental implant design featuring a porous surface structure to promote enhanced osseointegration and long-term stability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A dental implant comprising a titanium alloy...\",\n        \"A porous surface structure for osseointegration...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68380", "text": "{\n    \"patent_title\": \"Deep Learning for Real-Time Image Segmentation\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for efficient and accurate image segmentation, enabling real-time applications in autonomous driving and medical imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image segmentation using a convolutional neural network.\",\n        \"A system for real-time image processing.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68380", "text": "{\n    \"patent_title\": \"Improved Image Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"EP11223344B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-11-15\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"A new image compression technique that achieves higher compression ratios while maintaining acceptable image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10112233B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing digital images.\",\n        \"An image compression system.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68381", "text": "{\n    \"patent_title\": \"Novel Contrast Agent for Enhanced Cardiovascular Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel contrast agent for improving the resolution and accuracy of cardiovascular imaging techniques, leading to earlier and more precise diagnosis of heart conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Prior art on contrast agents.\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"A method for enhancing cardiovascular imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68381", "text": "{\n    \"patent_title\": \"Method for Biomedical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Robert Brown\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method for reconstructing biomedical images from raw data, improving image quality and reducing processing time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US1012345678B1\",\n            \"relevance\": \"Related to image processing algorithms.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a biomedical image...\",\n        \"A system for implementing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68382", "text": "{\n    \"patent_title\": \"Automated Medical Image Analysis Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for automated medical image analysis utilizing deep learning techniques, specifically convolutional neural networks, to enhance the identification of anomalies and improve diagnostic accuracy. This technology facilitates more efficient and reliable image interpretation for a variety of medical conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image segmentation.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for analyzing a medical image comprising...\",\n        \"A system for identifying anomalies in a medical image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68382", "text": "{\n    \"patent_title\": \"Method for Early Cancer Detection in Mammograms\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2023-04-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for the early detection of cancer in mammographic images using deep learning algorithms. The system analyzes image features to identify suspicious areas with high accuracy, aiding radiologists in early diagnosis and treatment.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior work on mammographic image analysis.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancer in a mammogram...\",\n        \"A system for identifying cancerous tissues...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68383", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a minimally invasive surgical system utilizing advanced imaging techniques to enhance visualization during procedures, leading to improved patient outcomes and reduced recovery times. The system includes a small incision access port, a high-resolution camera, and robotic surgical instruments.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Similar surgical system\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Enhanced imaging techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A minimally invasive surgical system comprising...\",\n        \"A method for performing surgery using the system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68383", "text": "{\n    \"patent_title\": \"Surgical Instrument Cleaning Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Williams\",\n            \"affiliation\": \"Johnson & Johnson\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-11-01\",\n    \"filing_date\": \"2022-11-01\",\n    \"issue_date\": \"2024-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A device for automated cleaning and sterilization of surgical instruments after use. The device utilizes high-pressure steam and specialized cleaning agents to ensure complete decontamination, improving hospital hygiene standards.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art sterilization methods\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument cleaning device comprising...\",\n        \"A method for cleaning surgical instruments...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68384", "text": "{\n    \"patent_title\": \"Microfluidic Device for Targeted Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for precisely delivering drugs to targeted cells, improving therapeutic efficacy and reducing side effects.  Utilizes novel polymer materials and fluid dynamics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"citation_type\": \"related\"\n        },\n        {\n            \"patent_number\": \"US1012345678B2\",\n            \"citation_type\": \"related\"\n        },\n        {\n            \"patent_number\": \"US1111111111B2\",\n            \"citation_type\": \"related\"\n        },\n        {\n            \"patent_number\": \"US1212121212B2\",\n            \"citation_type\": \"related\"\n        },\n        {\n            \"patent_number\": \"US1313131313B2\",\n            \"citation_type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising a channel network...\",\n        \"A method for targeted drug delivery...\",\n        \"A polymer material for use in a microfluidic device...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68384", "text": "{\n    \"patent_title\": \"In-Vitro Cell Culture Analysis System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2021-06-01\",\n    \"filing_date\": \"2021-08-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for analyzing cell cultures in vitro, providing high-throughput screening and analysis capabilities. Useful for drug discovery and toxicology studies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"citation_type\": \"related\"\n        },\n        {\n            \"patent_number\": \"US1012345678B2\",\n            \"citation_type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A cell culture analysis system comprising a chamber...\",\n        \"A method for in-vitro cell analysis...\",\n        \"A software interface for data processing...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68385", "text": "{\n    \"patent_title\": \"Miniaturized Surgical Robot with Haptic Feedback\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-06-01\",\n    \"issue_date\": \"2022-12-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized surgical robot designed for minimally invasive procedures, incorporating haptic feedback for enhanced precision and control. The robot utilizes advanced micro-actuators and a novel control system.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art on robotic surgery\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Relevant to haptic feedback systems\"\n        },\n        {\n            \"patent_number\": \"US11000000B2\",\n            \"relevance\": \"Prior art on miniaturization techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized surgical robot comprising a robotic arm with at least three degrees of freedom.\",\n        \"A haptic feedback system integrated with the robotic arm.\",\n        \"A control system for precise manipulation of the robotic arm.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68385", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Williams\",\n            \"affiliation\": \"General Hospital\"\n        }\n    ],\n    \"patent_number\": \"US11345678B2\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-04-15\",\n    \"issue_date\": \"2023-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design for targeted drug delivery, featuring a novel tip geometry and enhanced biocompatibility.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on catheter designs\"\n        },\n        {\n            \"patent_number\": \"US9654321B2\",\n            \"relevance\": \"Related to biocompatible materials\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible shaft and a distal tip.\",\n        \"The distal tip having a specific geometric shape for improved drug delivery.\",\n        \"The catheter being constructed from a biocompatible material.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68386", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical Device with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"MedTech Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel minimally invasive surgical device incorporating a high-resolution imaging system and robotic control for improved precision and patient outcomes. The device allows for smaller incisions and faster recovery times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art in minimally invasive surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical device comprising a robotic arm...\",\n        \"A high-resolution imaging system integrated with the surgical device...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68386", "text": "{\n    \"patent_title\": \"Advanced Pharmaceutical Formulation for Pain Management\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"PharmaCorp Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2022-08-01\",\n    \"filing_date\": \"2022-08-01\",\n    \"issue_date\": \"2024-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new pharmaceutical formulation designed to provide long-lasting pain relief with reduced side effects. The formulation utilizes a novel drug delivery system.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related prior art in pain management\"\n        }\n    ],\n    \"claims\": [\n        \"A pharmaceutical formulation comprising a novel drug delivery system...\",\n        \"A method for treating pain using the aforementioned formulation...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68387", "text": "{\n    \"patent_title\": \"Enhanced Resolution MRI with Artificial Intelligence Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-05-10\",\n    \"filing_date\": \"2018-05-10\",\n    \"issue_date\": \"2022-12-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for enhancing the resolution of Magnetic Resonance Imaging (MRI) through the application of deep learning algorithms. The AI-based reconstruction technique significantly improves image clarity and allows for more accurate diagnostic assessment of soft tissues, leading to earlier and more precise detection of anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images using a deep neural network.\",\n        \"An MRI system configured to implement the reconstruction method.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68387", "text": "{\n    \"patent_title\": \"Improved X-ray Film Processing Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Carol Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-02-15\",\n    \"filing_date\": \"2009-02-15\",\n    \"issue_date\": \"2014-07-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a new chemical formulation for processing X-ray films, resulting in faster development times and increased image contrast. It improves existing techniques for traditional X-ray imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A chemical formulation for X-ray film development.\",\n        \"A process for using the formulation to develop X-ray films.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68388", "text": "{\n    \"patent_title\": \"Enhanced MRI Image Reconstruction using Compressed Sensing\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2020-03-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method for reconstructing high-resolution MRI images from undersampled k-space data using compressed sensing techniques. The method employs a regularization term based on total variation to promote sparsity in the image domain, leading to improved image quality and reduced scan time. The technique simplifies the image reconstruction pipeline while maintaining diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on compressed sensing in MRI\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image...\",\n        \"The method of claim 1, wherein the regularization term is based on total variation.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68388", "text": "{\n    \"patent_title\": \"AI-Powered Medical Image Diagnosis System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. John Smith\",\n            \"affiliation\": \"TechCorp Inc.\"\n        },\n        {\n            \"name\": \"Dr. Alice Brown\",\n            \"affiliation\": \"TechCorp Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11123456B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2022-07-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel medical image diagnosis system powered by deep learning algorithms. The system utilizes convolutional neural networks to analyze X-ray, CT, and MRI images to detect anomalies and assist radiologists in making accurate diagnoses. The system leverages artificial intelligence to dramatically improve diagnostic accuracy and speed.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10987654B2\",\n            \"relevance\": \"Prior art on deep learning in image analysis\"\n        }\n    ],\n    \"claims\": [\n        \"A medical image diagnosis system comprising a deep learning model...\",\n        \"The system of claim 1, wherein the deep learning model is a convolutional neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68389", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"EP3123456B1\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-09-20\",\n    \"issue_date\": \"2018-04-11\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"This invention provides a novel method and system for enhancing the quality of medical images through advanced image reconstruction techniques. The method utilizes iterative algorithms to reduce noise and improve resolution, leading to more accurate diagnoses and potentially reduced radiation exposure for patients. It is particularly effective for CT and MRI imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8987654B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"A system comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68389", "text": "{\n    \"patent_title\": \"Portable X-Ray Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2014-12-10\",\n    \"filing_date\": \"2015-06-05\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A compact and portable X-ray device for use in emergency medical situations. The device is designed for ease of use and rapid image acquisition. It includes a radiation shield and a digital image sensor.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A portable X-ray device comprising...\",\n        \"A radiation shield for...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68390", "text": "{\n    \"patent_title\": \"Enhanced X-ray Imaging System with Novel Scintillator Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10253746B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-04-09\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"An X-ray imaging system incorporating a novel scintillator material for improved image resolution and reduced radiation dose. The scintillator material exhibits enhanced light output and faster decay time compared to conventional materials, leading to clearer images and faster scan times. The system's design simplifies the imaging process and enhances diagnostic capability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8500421B2\",\n            \"relevance\": \"Related scintillator material\"\n        }\n    ],\n    \"claims\": [\n        \"A method for producing a scintillator material comprising...\",\n        \"An X-ray imaging system comprising the scintillator material...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68390", "text": "{\n    \"patent_title\": \"Automated Tumor Detection Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11876543B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-19\",\n    \"issue_date\": \"2023-12-12\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"A system and method for automated tumor detection in medical images using deep convolutional neural networks. The system is trained on a large dataset of labeled images and can accurately identify tumors with high sensitivity and specificity. The method involves complex algorithms for image processing and feature extraction.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9987654B2\",\n            \"relevance\": \"Related CNN architecture\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting tumors in medical images using a deep convolutional neural network...\",\n        \"A computer-readable medium storing a program for...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68391", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Sensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized wireless sensor for continuous glucose monitoring, enabling real-time data transmission to a mobile device for improved diabetes management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in glucose sensing technology\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless glucose sensor comprising a microchip and a glucose oxidase enzyme.\",\n        \"A method for continuously monitoring glucose levels using the wireless sensor.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68391", "text": "{\n    \"patent_title\": \"Novel Dental Implant with Enhanced Osseointegration\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2022-03-15\",\n    \"filing_date\": \"2022-03-15\",\n    \"issue_date\": \"2024-02-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new dental implant design promoting faster and stronger osseointegration for improved long-term stability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Previous dental implant designs\"\n        }\n    ],\n    \"claims\": [\n        \"A dental implant comprising a titanium alloy with a porous surface.\",\n        \"A method for implanting the dental implant into a jawbone.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68392", "text": "{\n    \"patent_title\": \"Ultrasound Image Enhancement for Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing ultrasound images to improve the detection of cancerous tumors. The method utilizes adaptive filtering techniques to reduce noise and enhance contrast.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing ultrasound images comprising...\",\n        \"A system for detecting cancerous tumors...\",\n        \"The method of claim 1, wherein the adaptive filtering...\",\n        \"The system of claim 2, further comprising...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68392", "text": "{\n    \"patent_title\": \"Improved MRI Coil Design for Enhanced Image Resolution\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2023-05-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved MRI coil design that enhances image resolution and signal-to-noise ratio. The coil utilizes a novel arrangement of conductive elements.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil comprising...\",\n        \"The MRI coil of claim 1, wherein the conductive elements...\",\n        \"A method for acquiring MRI images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68393", "text": "{\n    \"patent_title\": \"Medical Image Enhancement using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-06-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for enhancing the quality of medical images using a convolutional neural network. The network is trained to reduce noise and improve contrast, leading to more accurate diagnoses. The method utilizes a novel loss function that prioritizes the preservation of clinically relevant features.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11111111B1\"\n        },\n        {\n            \"patent_number\": \"US22222222B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing a medical image comprising...\",\n        \"The method of claim 1, wherein the medical image is a CT scan.\",\n        \"The method of claim 1, wherein the medical image is an MRI.\",\n        \"A system for performing the method of claim 1.\",\n        \"A computer program product for performing the method of claim 1.\",\n        \"The method of claim 1, further comprising displaying the enhanced image.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68393", "text": "{\n    \"patent_title\": \"Novel Algorithm for Image Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"TechCorp Inc.\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2022-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new algorithm for lossless image compression. The algorithm utilizes a complex wavelet transform and entropy encoding scheme to achieve high compression ratios. The invention requires significant computational resources for encoding and decoding.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image comprising...\",\n        \"The method of claim 1, wherein the wavelet transform is a Daubechies wavelet.\",\n        \"The method of claim 1, wherein the entropy encoding scheme is Huffman coding.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68394", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Physiological Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"EP3876543B1\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-09-10\",\n    \"issue_date\": \"2022-01-26\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"A novel miniaturized wireless system for continuous physiological monitoring of patients. Unlike existing systems, this device employs a bio-integrated sensor capable of simultaneously measuring multiple vital signs with exceptional accuracy and minimal invasiveness. The system utilizes a new data transmission protocol offering enhanced security and reduced power consumption, enabling long-term remote patient monitoring.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Similar prior art in wearable sensor technology\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless physiological monitoring system comprising a bio-integrated sensor, a data transmitter, and a remote monitoring unit.\",\n        \"The system according to claim 1, wherein the bio-integrated sensor is capable of measuring at least three vital signs simultaneously.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68394", "text": "{\n    \"patent_title\": \"Improved Cardiac Pacemaker Lead Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Wilson\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-05-15\",\n    \"issue_date\": \"2021-10-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved design for cardiac pacemaker leads, focusing on enhanced durability and reduced risk of dislodgement. The lead incorporates a novel anchoring mechanism and a more flexible material composition. While improving current pacemaker technology, it does not introduce a fundamentally new approach to patient monitoring.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on pacemaker lead anchoring systems\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiac pacemaker lead comprising an anchoring mechanism for secure attachment to cardiac tissue.\",\n        \"The lead according to claim 1, wherein the anchoring mechanism utilizes a helical screw design.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68395", "text": "{\n    \"patent_title\": \"Rapid MRI Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2021-12-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing MRI images using deep learning, enabling significantly faster scan times without compromising image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68395", "text": "{\n    \"patent_title\": \"Improved X-ray Image Enhancement Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-01-15\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2022-07-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a new technique for enhancing the quality of X-ray images, improving diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"type\": \"cited by\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing X-ray images comprising...\",\n        \"A system for processing X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68396", "text": "{\n    \"patent_title\": \"Enhanced Image Sharpening using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for enhancing the sharpness and clarity of digital images using deep convolutional neural networks. The system employs a novel loss function that combines perceptual loss and adversarial loss to generate images that are both visually appealing and perceptually realistic. The method effectively reduces noise and artifacts, resulting in significant improvement in image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image sharpness comprising: training a deep convolutional neural network with a perceptual loss function and an adversarial loss function; applying the trained network to an input image; and outputting an enhanced image.\",\n        \"A system for enhancing image sharpness comprising: a training module for training a deep convolutional neural network; an image processing module for applying the trained network to an input image; and an output module for displaying the enhanced image.\",\n        \"The method of claim 1, wherein the perceptual loss function comprises a VGG loss.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68396", "text": "{\n    \"patent_title\": \"Improved Contrast in Mammographic Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method for improving contrast in mammographic images to aid in the early detection of breast cancer. The method involves applying a specific filtering technique to enhance the visibility of microcalcifications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for improving contrast in mammographic images comprising: applying a filtering technique to enhance microcalcifications.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68397", "text": "{\n    \"patent_title\": \"Miniaturized Wearable Sensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized wearable sensor system for continuous glucose monitoring, utilizing microfluidic technology and wireless data transmission for remote patient monitoring.  Designed for ease of use and improved patient compliance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A wearable sensor for continuous glucose monitoring comprising...\",\n        \"A wireless communication module for transmitting data...\",\n        \"A microfluidic channel for glucose detection...\",\n        \"A power management system for prolonged operation...\",\n        \"A data processing unit for analyzing glucose levels...\",\n        \"A system for remotely monitoring patient glucose levels...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68397", "text": "{\n    \"patent_title\": \"Implantable Cardiac Pacemaker with Remote Monitoring Capabilities\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Emily Wilson\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac pacemaker with remote monitoring capabilities, allowing physicians to monitor and adjust pacemaker settings without requiring in-person visits. Enables early detection and intervention for cardiac arrhythmias.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable cardiac pacemaker comprising...\",\n        \"A remote monitoring system for transmitting cardiac data...\",\n        \"A pacing module for delivering electrical impulses...\",\n        \"A battery for powering the pacemaker...\",\n        \"A communication interface for data transmission...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68398", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Cardiac MRI Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-12-21\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A novel method for reconstructing high-resolution cardiac MRI images using deep learning techniques, improving image clarity and reducing scan time. The method focuses on minimizing artifacts and enhancing contrast for accurate diagnosis of cardiovascular diseases.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relation\": \"Cited as prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a cardiac MRI image comprising...\",\n        \"The method of claim 1, wherein the deep learning model is a convolutional neural network.\",\n        \"The method of claim 1, further comprising displaying the reconstructed image on a monitor.\",\n        \"A system for performing the method of claim 1.\",\n        \"The system of claim 4, comprising a GPU for accelerating the deep learning model.\",\n        \"The method of claim 1, for detecting and diagnosing coronary artery disease.\",\n        \"The method of claim 1, for quantifying ventricular function.\",\n        \"The method of claim 1, wherein the image clarity is improved by at least 20%.\",\n        \"The method of claim 1, wherein the scan time is reduced by at least 30%.\",\n        \"The method of claim 1, for improving visualization of cardiac structures.\",\n        \"The method of claim 1, comprising a user interface for adjusting image parameters.\",\n        \"The method of claim 1, wherein the reconstructed image has a resolution of at least 512x512 pixels.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68398", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Angiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"EP3456789A1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2018-11-01\",\n    \"issue_date\": \"2020-05-13\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"A new catheter design for improved navigation and visualization during angiography procedures. The catheter features a flexible tip and enhanced contrast delivery system.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relation\": \"Cited as prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter for angiography comprising...\",\n        \"The catheter of claim 1, wherein the tip is made of a polymer material.\",\n        \"The catheter of claim 1, further comprising a guide wire.\",\n        \"The catheter of claim 1, for use in coronary angiography.\",\n        \"The catheter of claim 1, wherein the contrast delivery system provides a uniform distribution of contrast agent.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68399", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical Navigation System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-12-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical navigation system utilizing augmented reality to enhance precision during minimally invasive procedures. The system provides real-time feedback to surgeons, reducing the risk of complications and improving patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on surgical navigation\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical navigation system comprising...\",\n        \"A method for guiding a surgical instrument...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68399", "text": "{\n    \"patent_title\": \"Advanced Material for Orthopedic Implants\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Materials Research Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-11-10\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2021-08-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel titanium alloy with enhanced biocompatibility for use in orthopedic implants. The alloy exhibits improved corrosion resistance and mechanical strength.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art on titanium alloys\"\n        }\n    ],\n    \"claims\": [\n        \"A titanium alloy comprising...\",\n        \"An orthopedic implant constructed from the alloy...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68400", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A minimally invasive surgical system designed to improve ergonomics for surgeons and reduce patient recovery time through smaller incisions and enhanced visualization.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in minimally invasive surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising...\",\n        \"A method for performing minimally invasive surgery...\",\n        \"An ergonomic handle for surgical instruments...\",\n        \"A visualization system with enhanced clarity...\",\n        \"A tissue retraction mechanism...\",\n        \"A control system for precise instrument manipulation...\",\n        \"A data analysis module for surgical performance feedback...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68400", "text": "{\n    \"patent_title\": \"Improved Stent Design for Coronary Artery Disease\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Lars Olsen\",\n            \"affiliation\": \"University of Copenhagen\"\n        }\n    ],\n    \"patent_number\": \"EP3876543B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-02-15\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"An improved stent design for treating coronary artery disease, offering increased flexibility and reduced risk of restenosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Existing stent technology\"\n        }\n    ],\n    \"claims\": [\n        \"A stent comprising...\",\n        \"A method for deploying a stent...\",\n        \"A coating for reducing restenosis...\",\n        \"A structural element for flexibility...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68401", "text": "{\n    \"patent_title\": \"Remote Physiological Monitoring System with Wireless Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for remotely monitoring a patient's physiological parameters using wireless sensors and a central processing unit. The system allows healthcare professionals to track patient health in real-time, enabling early detection of potential problems and improved patient care.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"kind\": \"Cited by Examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A system for remotely monitoring physiological parameters...\",\n        \"A wireless sensor for transmitting physiological data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68401", "text": "{\n    \"patent_title\": \"Wearable Fitness Tracker with Heart Rate Monitoring and GPS\",\n    \"inventors\": [\n        {\n            \"name\": \"Sarah Johnson\",\n            \"affiliation\": \"FitTech Innovations\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2011-11-01\",\n    \"filing_date\": \"2011-11-01\",\n    \"issue_date\": \"2018-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wearable device that tracks fitness activity, including steps, heart rate, and GPS location. The device provides data to the user through a mobile application.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"Cited by Applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A wearable device comprising a heart rate sensor...\",\n        \"A GPS module for tracking location...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68402", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Patient Feedback\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2012-05-15\",\n    \"filing_date\": \"2012-05-15\",\n    \"issue_date\": \"2019-08-20\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A minimally invasive surgical system incorporating haptic feedback and real-time tissue analysis for improved precision and patient comfort. The system reduces trauma and recovery time compared to traditional surgical methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Surgical Navigation System\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising a haptic feedback module.\",\n        \"A method for minimizing surgical trauma.\",\n        \"A tissue analysis module for real-time feedback.\",\n        \"A user interface for controlling surgical parameters.\",\n        \"A system for reducing patient recovery time.\",\n        \"A surgical instrument with integrated sensors.\",\n        \"A control system to adjust haptic feedback intensity.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68402", "text": "{\n    \"patent_title\": \"Automated Drug Delivery System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Pharmaceutical Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"EP2987654B1\",\n    \"priority_date\": \"2011-11-01\",\n    \"filing_date\": \"2011-11-01\",\n    \"issue_date\": \"2017-03-15\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"An automated system for delivering precise dosages of medication to patients. The system utilizes microfluidic technology and remote monitoring capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Controlled Release Drug Formulation\"\n        }\n    ],\n    \"claims\": [\n        \"A drug delivery system comprising a microfluidic pump.\",\n        \"A method for remotely monitoring drug dosage.\",\n        \"A control algorithm for adjusting drug delivery rates.\",\n        \"A system for maintaining drug stability.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68403", "text": "{\n    \"patent_title\": \"Contrast-Enhanced Magnetic Resonance Imaging for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-06-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel contrast agent for magnetic resonance imaging, enabling earlier and more accurate detection of cancerous tumors. The contrast agent enhances image clarity and specificity, improving diagnostic capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"count\": 15\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"count\": 12\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent composition for magnetic resonance imaging.\",\n        \"A method for detecting cancer using the contrast agent composition.\",\n        \"An imaging system utilizing the contrast agent composition.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68403", "text": "{\n    \"patent_title\": \"Improved X-Ray Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2017-05-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved X-ray imaging system with reduced radiation exposure and enhanced image resolution. The system utilizes advanced filtering techniques to minimize noise and improve image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"count\": 8\n        },\n        {\n            \"patent_number\": \"US89012345B1\",\n            \"count\": 5\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system with reduced radiation exposure.\",\n        \"A filtering technique for improving image quality.\",\n        \"A method for processing X-ray images.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68404", "text": "{\n    \"patent_title\": \"Miniature Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"MIT Lincoln Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized glucose sensor for continuous monitoring of glucose levels in diabetic patients. The sensor utilizes a biocompatible material and communicates wirelessly to a mobile device.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A glucose sensor comprising a biocompatible material.\",\n        \"A wireless communication module integrated with the glucose sensor.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68404", "text": "{\n    \"patent_title\": \"Robotic Surgical System for Minimally Invasive Cardiac Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alan Turing\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Grace Hopper\",\n            \"affiliation\": \"Stanford Medical Center\"\n        }\n    ],\n    \"patent_number\": \"US10245789B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A robotic surgical system enabling precise and minimally invasive cardiac procedures. The system incorporates advanced imaging and control mechanisms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic arm for surgical manipulation.\",\n        \"A control system for precise movement of the robotic arm.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68405", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical Device with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A novel minimally invasive surgical device incorporating a high-resolution imaging system and robotic assistance for improved precision and reduced patient trauma. Demonstrates significant improvements in post-operative recovery times and reduced complication rates.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in minimally invasive surgical techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical device comprising an imaging system and robotic arm.\",\n        \"A method for performing minimally invasive surgery using said device.\",\n        \"A system for enhancing visualization during surgical procedures.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68405", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Fluid Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"EP11223344B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"An improved catheter design for efficient and accurate fluid delivery during medical procedures. Focuses on reducing the risk of blockage and improving flow rate.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Existing catheter designs and materials.\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter with a modified internal lumen for improved fluid flow.\",\n        \"A method of manufacturing said catheter.\",\n        \"A fluid delivery system incorporating said catheter.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68406", "text": "{\n    \"patent_title\": \"Improved Method for Low-Dose CT Imaging with Artifact Reduction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10456789B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-02-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for reducing radiation dose in computed tomography (CT) imaging while maintaining diagnostic image quality. The invention utilizes an iterative reconstruction algorithm combined with a novel artifact reduction technique.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on iterative reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing CT imaging comprising...\",\n        \"The method of claim 1, wherein the radiation dose is reduced by at least 30%.\",\n        \"The method of claim 1, further comprising...\",\n        \"An imaging system configured to perform the method of claim 1.\",\n        \"The imaging system of claim 4, wherein the reconstruction algorithm is...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68406", "text": "{\n    \"patent_title\": \"Enhanced MRI Coil Design for Improved Signal-to-Noise Ratio\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2021-08-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel design for a magnetic resonance imaging (MRI) coil that provides a significant improvement in signal-to-noise ratio, leading to clearer and more detailed images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Previous coil designs\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil comprising...\",\n        \"The MRI coil of claim 1, wherein the signal-to-noise ratio is improved by at least 10dB.\",\n        \"The MRI coil of claim 1, further comprising...\",\n        \"A method for using the MRI coil of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68407", "text": "{\n    \"patent_title\": \"Magnetic Resonance Imaging System with Adaptive Coil Sensitivity\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A magnetic resonance imaging (MRI) system is disclosed comprising an adaptive coil sensitivity adjustment mechanism. The system automatically optimizes coil sensitivity based on patient anatomy, improving image quality and reducing scan time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"title\": \"MRI Pulse Sequence Optimization\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Coil Array Design for MRI\"\n        }\n    ],\n    \"claims\": [\n        \"A magnetic resonance imaging system comprising: an MRI scanner; a coil array; and a processor configured to adjust coil sensitivity based on patient anatomy.\",\n        \"The system of claim 1, wherein the adjustment of coil sensitivity reduces scan time.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68407", "text": "{\n    \"patent_title\": \"X-Ray Imaging Device with Enhanced Contrast\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US10456789B1\",\n    \"priority_date\": \"2017-09-01\",\n    \"filing_date\": \"2017-09-01\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An X-ray imaging device is described that provides enhanced image contrast through a novel filtration technique. This improves the visualization of subtle anatomical structures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Magnetic Resonance Imaging System with Adaptive Coil Sensitivity\"\n        },\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"title\": \"MRI Pulse Sequence Optimization\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Coil Array Design for MRI\"\n        },\n        {\n            \"patent_number\": \"US6543210B2\",\n            \"title\": \"Digital Radiography System\"\n        },\n        {\n            \"patent_number\": \"US5432109B2\",\n            \"title\": \"X-Ray Tube Design\"\n        },\n        {\n            \"patent_number\": \"US4321098B2\",\n            \"title\": \"Image Processing for X-Ray Images\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging device comprising: an X-ray source; a detector; and a filtration system configured to enhance image contrast.\",\n        \"The device of claim 1, wherein the filtration system utilizes a novel material composition.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68408", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical Stapler with Enhanced Tissue Approximation\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical stapler designed to provide enhanced tissue approximation during surgical procedures, leading to reduced trauma and faster patient recovery. The stapler incorporates a novel cartridge design and improved actuation mechanism.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Similar stapler design\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"A cartridge for use in a surgical stapler...\",\n        \"A method of performing a surgical procedure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68408", "text": "{\n    \"patent_title\": \"Automated Robotic Surgical System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. John Smith\",\n            \"affiliation\": \"Boston Dynamics\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Boston Dynamics\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2020-03-10\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated robotic surgical system designed to perform complex surgical procedures with high precision. The system utilizes advanced image guidance and real-time feedback control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Robotic surgery technology\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system comprising...\",\n        \"A control system for a robotic surgical system...\",\n        \"A method of controlling a robotic surgical system...\",\n        \"A user interface for a robotic surgical system...\",\n        \"A sensor system for a robotic surgical system...\",\n        \"A communication module for a robotic surgical system...\",\n        \"A power supply for a robotic surgical system...\",\n        \"A mechanical arm for a robotic surgical system...\",\n        \"A surgical tool attachment for a robotic surgical system...\",\n        \"A safety mechanism for a robotic surgical system...\",\n        \"A calibration system for a robotic surgical system...\",\n        \"A data processing unit for a robotic surgical system...\",\n        \"An image processing module for a robotic surgical system...\",\n        \"A navigation system for a robotic surgical system...\",\n        \"A remote control module for a robotic surgical system...\",\n        \"A feedback control system for a robotic surgical system...\",\n        \"A diagnostic system for a robotic surgical system...\",\n        \"A maintenance module for a robotic surgical system...\",\n        \"A software application for a robotic surgical system...\",\n        \"A hardware component for a robotic surgical system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68409", "text": "{\n    \"patent_title\": \"Non-Invasive Glucose Monitoring System Using Optical Coherence Tomography\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive glucose monitoring system based on optical coherence tomography (OCT) is disclosed. The system utilizes image processing algorithms to analyze subcutaneous glucose levels without requiring a blood sample. The method allows for continuous and real-time glucose monitoring.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for non-invasive glucose monitoring using OCT.\",\n        \"A system comprising an OCT device and image processing unit.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68409", "text": "{\n    \"patent_title\": \"Implantable Cardiac Rhythm Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-01\",\n    \"issue_date\": \"2023-04-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac rhythm management system is described, capable of pacing and defibrillation. This device utilizes signal analysis to detect and treat cardiac arrhythmias. It provides precise control and improves patient outcomes for those suffering from heart conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable cardiac rhythm management system.\",\n        \"A method for detecting and treating cardiac arrhythmias.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68410", "text": "{\n    \"patent_title\": \"Remote Physiological Parameter Monitoring System and Method\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for remotely monitoring physiological parameters of a patient, utilizing a novel sensor and data transmission protocol to improve accuracy and reliability in home healthcare settings.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"citation_count\": 3\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"citation_count\": 1\n        }\n    ],\n    \"claims\": [\n        \"A system for remote physiological monitoring comprising...\",\n        \"A method for transmitting physiological data...\",\n        \"A sensor configured to detect...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68410", "text": "{\n    \"patent_title\": \"Improved Catheter Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Medical Device Corp.\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-19\",\n    \"issue_date\": \"2020-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design with enhanced flexibility and reduced patient discomfort. The design incorporates minor modifications to existing catheter structures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"citation_count\": 1\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible shaft...\",\n        \"A distal tip configured for insertion...\",\n        \"A lumen for fluid delivery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68411", "text": "{\n    \"patent_title\": \"Energy-Efficient Beamforming for Millimeter Wave Communication Systems\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-06-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel beamforming technique for millimeter wave communication systems that significantly reduces energy consumption while maintaining high data rates. It utilizes a dynamic power allocation scheme based on channel state information.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for beamforming in a millimeter wave communication system, comprising...\",\n        \"A system for implementing the method of claim 1, comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68411", "text": "{\n    \"patent_title\": \"Improved Antenna Design for Mobile Phone Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corp\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2022-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a compact antenna design specifically optimized for mobile phone devices, improving signal strength and reducing interference. It focuses on miniaturization and integration into handheld devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"An antenna for use in a mobile phone, comprising...\",\n        \"A mobile phone incorporating the antenna of claim 1, comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68412", "text": "{\n    \"patent_title\": \"AI-Powered Diagnostic System for Early Detection of Retinal Diseases\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-07-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for automatically diagnosing retinal diseases using deep learning algorithms. The system analyzes retinal images to detect early signs of diabetic retinopathy and macular degeneration, improving diagnostic accuracy and reducing clinician workload.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Processing for Medical Imaging\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Convolutional Neural Networks for Image Classification\"\n        }\n    ],\n    \"claims\": [\n        \"A method for diagnosing retinal diseases comprising...\",\n        \"A system for analyzing retinal images comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68412", "text": "{\n    \"patent_title\": \"Method for Enhanced Image Segmentation in Medical Scans\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Diana Evans\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image segmentation technique for improving the accuracy of medical image analysis. The method utilizes a hybrid approach combining deep learning and traditional image processing techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Advanced Image Filtering Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for segmenting medical images comprising...\",\n        \"An apparatus for processing medical images comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68413", "text": "{\n    \"patent_title\": \"Advanced Power Management Techniques for Extended Battery Life in Smartphones\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10523789B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-06-20\",\n    \"issue_date\": \"2020-01-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel power management techniques for mobile devices, leveraging machine learning to predict and optimize power consumption based on user behavior. It significantly extends battery life without compromising performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for dynamically adjusting CPU frequency based on predicted workload.\",\n        \"A system for optimizing background app activity to minimize power drain.\",\n        \"An apparatus for utilizing machine learning models to forecast power needs.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68413", "text": "{\n    \"patent_title\": \"High-Efficiency Wireless Charging System for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11256789B1\",\n    \"priority_date\": \"2017-12-10\",\n    \"filing_date\": \"2018-01-15\",\n    \"issue_date\": \"2021-03-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a new wireless charging system with improved efficiency and reduced charging time for mobile devices. It utilizes advanced resonant inductive coupling to maximize power transfer.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless charging transmitter comprising a resonant coil.\",\n        \"A receiver circuit for converting wireless power to DC voltage.\",\n        \"A system for controlling the charging process to prevent overheating.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68414", "text": "{\n    \"patent_title\": \"Lithium-Sulfur Battery with Polymer-Derived Carbon Cathode for Enhanced Cycle Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2021-11-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-sulfur battery utilizing a polymer-derived carbon cathode material exhibiting improved cycle life and reduced polysulfide shuttling. The cathode is synthesized from readily available precursors, minimizing reliance on rare earth elements.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art on lithium-sulfur batteries.\"\n        }\n    ],\n    \"claims\": [\n        \"1. A lithium-sulfur battery comprising a cathode material...\",\n        \"2. The battery of claim 1, wherein the cathode material is a polymer-derived carbon...\",\n        \"3. The battery of claim 2, wherein the polymer is polyacrylonitrile...\",\n        \"4. The battery of claim 1, further comprising an electrolyte...\",\n        \"5. A method of manufacturing a lithium-sulfur battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68414", "text": "{\n    \"patent_title\": \"Nickel-Metal Hydride Battery with Improved Electrode Structure\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Panasonic\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Toyota\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2017-12-01\",\n    \"filing_date\": \"2017-12-01\",\n    \"issue_date\": \"2019-04-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved nickel-metal hydride battery with a modified electrode structure designed to enhance energy density and power output. This battery utilizes nickel hydroxide and a metal hydride alloy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art relating to nickel-metal hydride batteries.\"\n        }\n    ],\n    \"claims\": [\n        \"1. A nickel-metal hydride battery comprising a positive electrode...\",\n        \"2. The battery of claim 1, wherein the positive electrode comprises nickel hydroxide...\",\n        \"3. The battery of claim 1, wherein the negative electrode comprises a metal hydride alloy...\",\n        \"4. A method of manufacturing a nickel-metal hydride battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68415", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Electrolyte Additive for Improved Cycle Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11254321B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2022-08-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery incorporating a novel electrolyte additive that significantly improves cycle life and reduces capacity fade, making it suitable for high-demand applications such as electric vehicles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11300789B1\",\n            \"count\": 3\n        },\n        {\n            \"patent_number\": \"US11458234B2\",\n            \"count\": 2\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte additive...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68415", "text": "{\n    \"patent_title\": \"All-Solid-State Lithium-Ion Battery with Polymer Electrolyte\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11567890B2\",\n    \"priority_date\": \"2022-01-10\",\n    \"filing_date\": \"2022-01-10\",\n    \"issue_date\": \"2023-05-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An all-solid-state lithium-ion battery utilizing a novel polymer electrolyte, offering enhanced safety and energy density.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11600123B1\",\n            \"count\": 1\n        }\n    ],\n    \"claims\": [\n        \"An all-solid-state lithium-ion battery comprising...\",\n        \"A polymer electrolyte...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68416", "text": "{\n    \"patent_title\": \"Wireless Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-06-22\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel wireless biosensor for continuous glucose monitoring, utilizing a flexible substrate and biocompatible materials to improve patient comfort and provide highly accurate readings. This device reduces the need for frequent finger pricks and offers real-time data transmission to a mobile application.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in glucose sensing technology\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless glucose sensor comprising a flexible substrate.\",\n        \"The sensor of claim 1, wherein the sensor is configured for minimally invasive insertion.\",\n        \"A system for continuous glucose monitoring utilizing the sensor of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68416", "text": "{\n    \"patent_title\": \"Drug-Eluting Stent with Enhanced Polymer Coating\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2022-05-01\",\n    \"filing_date\": \"2022-08-15\",\n    \"issue_date\": \"2024-02-29\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A drug-eluting stent with an improved polymer coating designed to reduce restenosis after percutaneous coronary intervention.  The stent utilizes a biocompatible polymer and a sustained-release drug formulation to prevent plaque buildup and improve long-term vessel patency. The abstract includes the term 'stent'.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\",\n            \"relevance\": \"Related to prior art stent designs\"\n        }\n    ],\n    \"claims\": [\n        \"A drug-eluting stent comprising a metallic scaffold.\",\n        \"The stent of claim 1, further comprising a polymer coating.\",\n        \"A method of treating coronary artery disease using the stent of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68417", "text": "{\n    \"patent_title\": \"Miniature Robotic Surgical System with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature robotic surgical system designed for minimally invasive procedures, offering enhanced precision and dexterity. The system utilizes advanced sensor technology and feedback mechanisms to improve surgical outcomes and reduce patient recovery time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Related to robotic surgery\"\n        },\n        {\n            \"patent_number\": \"US11223344AA\",\n            \"relevance\": \"Advanced sensor integration\"\n        },\n        {\n            \"patent_number\": \"US13141516BB\",\n            \"relevance\": \"Surgical tools\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system comprising a miniature robotic arm...\",\n        \"The system according to claim 1, wherein the surgical procedure is minimally invasive.\",\n        \"The system according to claim 2, further comprising a sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68417", "text": "{\n    \"patent_title\": \"Cardiac Pacemaker with Wireless Charging Capability\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-01-10\",\n    \"filing_date\": \"2019-01-10\",\n    \"issue_date\": \"2021-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A cardiac pacemaker incorporating wireless charging technology for extended battery life and reduced patient inconvenience. The device utilizes biocompatible materials and advanced algorithms to optimize pacing parameters.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Wireless power transfer\"\n        },\n        {\n            \"patent_number\": \"US10111213AA\",\n            \"relevance\": \"Cardiac pacing algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiac pacemaker comprising a wireless charging receiver...\",\n        \"The pacemaker according to claim 1, further comprising a biocompatible casing...\",\n        \"The pacemaker according to claim 2, utilizing a pacing algorithm...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68418", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Pressure Sensor for Intraoperative Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology, Department of Biomedical Engineering\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School, Bioengineering Research Lab\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-05-15\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel, miniaturized wireless pressure sensor for real-time intraoperative monitoring during minimally invasive surgical procedures. The sensor provides accurate pressure readings with minimal patient discomfort and facilitates improved surgical outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art on wireless sensors.\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising...\",\n        \"A method for intraoperative monitoring using the sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68418", "text": "{\n    \"patent_title\": \"Surgical Stapler with Enhanced Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Wang Wei\",\n            \"affiliation\": \"Shanghai Jiao Tong University\"\n        },\n        {\n            \"name\": \"Li Mei\",\n            \"affiliation\": \"Huazhong University of Science and Technology\"\n        }\n    ],\n    \"patent_number\": \"CN123456789A\",\n    \"priority_date\": \"2022-03-10\",\n    \"filing_date\": \"2022-03-10\",\n    \"issue_date\": \"2023-09-05\",\n    \"patent_office\": \"SIPO\",\n    \"abstract\": \"An improved surgical stapler designed with enhanced ergonomics for increased surgeon comfort and precision. This device addresses the need for more efficient and less fatiguing surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related prior art on surgical staplers.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler with an ergonomic handle...\",\n        \"A method for stapling tissue using the improved stapler...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68419", "text": "{\n    \"patent_title\": \"Method for Enhanced Tumor Detection Using Multi-Modal Image Fusion\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"This invention discloses a method for enhancing tumor detection in medical images by fusing data from multiple modalities, such as MRI and PET scans. The method utilizes advanced image processing algorithms to improve contrast and highlight subtle anomalies indicative of early-stage cancer.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Prior Art MRI Enhancement Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for fusing medical images from multiple modalities.\",\n        \"A system for detecting tumors using fused medical images.\",\n        \"The method of claim 1, wherein the modalities include MRI and PET.\",\n        \"The system of claim 2, comprising a processor for executing image processing algorithms.\",\n        \"The method of claim 1, wherein the image processing algorithms are designed to enhance contrast.\",\n        \"The system of claim 2, further comprising a display for visualizing the fused images.\",\n        \"A method for early cancer detection using the system of claim 2.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68419", "text": "{\n    \"patent_title\": \"Digital Radiography System with Reduced Radiation Dose\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Franz Schmidt\",\n            \"affiliation\": \"University of Heidelberg\"\n        }\n    ],\n    \"patent_number\": \"EP3456789B1\",\n    \"priority_date\": \"2021-01-25\",\n    \"filing_date\": \"2021-03-10\",\n    \"issue_date\": \"2023-05-17\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"This invention describes a digital radiography system designed to minimize patient exposure to radiation while maintaining image quality. It utilizes novel sensor technology and image reconstruction algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Conventional Digital Radiography System\"\n        }\n    ],\n    \"claims\": [\n        \"A digital radiography system comprising a radiation source and a sensor.\",\n        \"The system of claim 1, wherein the radiation source emits X-rays.\",\n        \"The system of claim 1, further comprising an image reconstruction algorithm.\",\n        \"The system of claim 3, wherein the image reconstruction algorithm reduces noise.\",\n        \"A method for operating the digital radiography system.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68420", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction for Low-Dose CT Scans\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10586743B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-02-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method and system for reconstructing medical images from low-dose CT scans, improving image quality and reducing patient radiation exposure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image from projection data, comprising...\",\n        \"The method of claim 1, wherein the radiation dose is reduced by at least 30%.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68420", "text": "{\n    \"patent_title\": \"Novel MRI Coil Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9540123B2\",\n    \"priority_date\": \"2016-05-20\",\n    \"filing_date\": \"2016-05-20\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel design for an MRI coil, improving signal-to-noise ratio and image resolution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8128432B2\"\n        },\n        {\n            \"patent_number\": \"US9234567B2\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil comprising...\",\n        \"The MRI coil of claim 1, wherein the signal-to-noise ratio is increased by at least 10 dB.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68421", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Sepsis Diagnosis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device is disclosed for rapid and accurate diagnosis of sepsis based on biomarker detection. This device allows for faster treatment decisions and improved patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for diagnosing sepsis...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68421", "text": "{\n    \"patent_title\": \"Improved Surgical Stapler Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Kenji Tanaka\",\n            \"affiliation\": \"Olympus Corporation\"\n        },\n        {\n            \"name\": \"Hiroshi Sato\",\n            \"affiliation\": \"Olympus Corporation\"\n        }\n    ],\n    \"patent_number\": \"JP2022112233A\",\n    \"priority_date\": \"2022-01-10\",\n    \"filing_date\": \"2022-01-10\",\n    \"issue_date\": \"2023-11-15\",\n    \"patent_office\": \"JPO\",\n    \"abstract\": \"An improved surgical stapler with enhanced precision and reduced tissue damage is disclosed. The design allows for more efficient surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10112233B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"A method for performing surgical stapling...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68422", "text": "{\n    \"patent_title\": \"High-Resolution Magnetic Resonance Imaging for Early-Stage Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2023-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel magnetic resonance imaging (MRI) technique capable of achieving significantly higher resolution than conventional MRI. This improvement allows for the detection of cancerous tumors at a much earlier stage, enhancing diagnostic accuracy and improving patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in MRI image reconstruction.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating high-resolution MRI images.\",\n        \"An MRI apparatus configured for early-stage cancer detection.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68422", "text": "{\n    \"patent_title\": \"Improved X-ray Image Enhancement System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Wilson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Dr. Sarah Chen\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2017-02-28\",\n    \"filing_date\": \"2017-02-28\",\n    \"issue_date\": \"2022-09-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system for enhancing the quality of X-ray images, improving contrast and reducing noise. This facilitates more accurate diagnosis of bone fractures and other skeletal abnormalities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Previous X-ray image processing techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray image enhancement system.\",\n        \"A method for improving X-ray image contrast.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68423", "text": "{\n    \"patent_title\": \"System and Method for Object Recognition Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for accurately identifying objects within an image using deep convolutional neural networks. The system utilizes multiple convolutional layers to extract features from input images, and a fully connected layer to classify the objects. The method is designed for real-time performance and high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for object recognition comprising...\",\n        \"A system for object recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68423", "text": "{\n    \"patent_title\": \"Medical Image Analysis System Using Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Mayo Clinic\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of Michigan\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for analyzing medical images, such as X-rays and MRIs, using convolutional neural networks to detect anomalies and assist in diagnosis. The system provides enhanced visualization and automated analysis capabilities to improve the accuracy and efficiency of medical imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related Art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for medical image analysis comprising...\",\n        \"A system for medical image analysis comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68424", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Cardiac Monitor with Remote Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-08-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable cardiac monitor capable of continuously monitoring heart activity and wirelessly transmitting data to a remote monitoring station for improved patient care and early detection of arrhythmias.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"count\": 15\n        },\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"count\": 8\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable cardiac monitor...\",\n        \"A system for remotely monitoring cardiac activity...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68424", "text": "{\n    \"patent_title\": \"Automated Insulin Delivery System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Brown\",\n            \"affiliation\": \"State University\"\n        }\n    ],\n    \"patent_number\": \"US11890123B1\",\n    \"priority_date\": \"2019-05-20\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2022-04-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated insulin delivery system that utilizes a closed-loop control algorithm to regulate blood glucose levels in patients with diabetes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"count\": 3\n        }\n    ],\n    \"claims\": [\n        \"An automated insulin delivery system...\",\n        \"A method for controlling blood glucose levels...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68425", "text": "{\n    \"patent_title\": \"High-Resolution Medical Imaging System with AI-Powered Diagnostic Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Davis\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel medical imaging system utilizing deep learning algorithms to enhance image resolution and improve diagnostic accuracy. The system combines advanced hardware components with sophisticated software processing techniques for clearer and more reliable medical diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Prior Art Imaging System\"\n        }\n    ],\n    \"claims\": [\n        \"A medical imaging system comprising...\",\n        \"A method for enhancing image resolution...\",\n        \"A diagnostic method utilizing enhanced images...\",\n        \"A computer-readable medium storing instructions...\",\n        \"A deep learning algorithm for image analysis...\",\n        \"A system for real-time image processing...\",\n        \"An imaging system with reduced noise levels...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68425", "text": "{\n    \"patent_title\": \"Method for Improving X-ray Image Contrast\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Wilson\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2017-09-20\",\n    \"filing_date\": \"2017-09-20\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for improving the contrast of X-ray images using a novel filtering technique. The method provides clearer visualization of anatomical structures in X-ray images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Conventional X-ray Enhancement Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for improving X-ray image contrast...\",\n        \"A filter for enhancing image visibility...\",\n        \"A system for applying the filter...\",\n        \"A method for reducing noise in X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68426", "text": "{\n    \"patent_title\": \"Enhanced Resolution Medical Imaging System Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-01-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel medical imaging system leveraging deep learning algorithms to significantly enhance image resolution and clarity in MRI and CT scans. The system employs a convolutional neural network trained on a large dataset of medical images to reconstruct high-resolution images from low-resolution inputs, reducing noise and artifacts. The results demonstrate substantial improvements in diagnostic accuracy compared to conventional imaging techniques.  The system is particularly useful for detecting subtle anomalies in early-stage disease.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9234567B1\",\n            \"kind\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A medical imaging system comprising a deep learning module for image reconstruction.\",\n        \"A method for enhancing image resolution in medical imaging using a convolutional neural network.\",\n        \"The system of claim 1, wherein the medical imaging modality is MRI.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68426", "text": "{\n    \"patent_title\": \"Portable X-ray Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"SmallTech Innovations\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2014-11-01\",\n    \"filing_date\": \"2014-11-01\",\n    \"issue_date\": \"2017-05-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A portable X-ray device for basic medical diagnostics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US4887259\",\n            \"kind\": \"cited\"\n        }\n    ],\n    \"claims\": [\n        \"A portable X-ray device comprising an X-ray source and a detector.\",\n        \"The device of claim 1, comprising a battery power source.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68427", "text": "{\n    \"patent_title\": \"High-Resolution Medical Imaging Using Compressed Sensing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel compressed sensing technique for high-resolution medical imaging. This invention improves image quality and reduces scan time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8888888B2\",\n            \"year\": \"2014\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an image from undersampled data.\",\n        \"A system comprising a scanner and a reconstruction algorithm.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68427", "text": "{\n    \"patent_title\": \"MRI Enhancement with Contrast Agents\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        }\n    ],\n    \"patent_number\": \"US7654321B1\",\n    \"priority_date\": \"2010-11-01\",\n    \"filing_date\": \"2010-11-01\",\n    \"issue_date\": \"2013-04-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to enhancing MRI images using novel contrast agents.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"year\": \"2001\"\n        },\n        {\n            \"patent_number\": \"US4321098B1\",\n            \"year\": \"1982\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent for MRI.\",\n        \"A method for enhancing MRI images using said contrast agent.\",\n        \"A system for administering the contrast agent.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68428", "text": "{\n    \"patent_title\": \"Enhanced MRI Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-06-01\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning algorithm for reconstructing MRI images, improving image quality and reducing scan time, leading to more accurate diagnoses of various medical conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images using a deep convolutional neural network.\",\n        \"A system for processing MRI data to enhance image clarity.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68428", "text": "{\n    \"patent_title\": \"Skin Rejuvenation Device Using Focused Ultrasound\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"California Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-11-20\",\n    \"filing_date\": \"2021-02-15\",\n    \"issue_date\": \"2023-05-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A device utilizing focused ultrasound to stimulate collagen production in the skin, reducing wrinkles and improving skin texture. Primarily intended for cosmetic applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related technology in ultrasound therapy\"\n        }\n    ],\n    \"claims\": [\n        \"A handheld device for delivering focused ultrasound energy to the skin.\",\n        \"A method for non-invasive skin tightening using ultrasound.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68429", "text": "{\n    \"patent_title\": \"AI-Enhanced Magnetic Resonance Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method for improving the resolution and reducing the scan time of magnetic resonance images using deep learning algorithms. The system utilizes a convolutional neural network to reconstruct images from undersampled k-space data, resulting in higher quality images with reduced patient exposure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a magnetic resonance image comprising...\",\n        \"A system for performing magnetic resonance imaging comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68429", "text": "{\n    \"patent_title\": \"Novel Contrast Agent for Improved Vascular Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Sarah Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-08-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new contrast agent based on nanoparticle technology is described for enhancing visibility of blood vessels in MRI and CT scans. The agent exhibits improved biocompatibility and targeted delivery to vascular tissues.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Prior art related to nanoparticle contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent composition comprising...\",\n        \"A method for enhancing vascular imaging comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68430", "text": "{\n    \"patent_title\": \"Novel MRI Contrast Agent for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-09-20\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel MRI contrast agent utilizing targeted nanoparticles for enhanced detection of early-stage tumors, improving diagnostic accuracy and patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Targeted Nanoparticles for Drug Delivery\"\n        },\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"title\": \"MRI Contrast Agents with Improved Signal Enhancement\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting early-stage tumors comprising...\",\n        \"A contrast agent comprising...\",\n        \"The contrast agent of claim 1, wherein the nanoparticles are targeted to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68430", "text": "{\n    \"patent_title\": \"Improved X-Ray Imaging System with Digital Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"Dr. Jane Doe\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2021-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved X-ray imaging system with advanced digital image processing techniques for enhanced visualization of anatomical structures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Digital X-Ray Image Processing Methods\"\n        },\n        {\n            \"patent_number\": \"US9654321B1\",\n            \"title\": \"X-Ray Detector with Enhanced Sensitivity\"\n        },\n        {\n            \"patent_number\": \"US9543210B2\",\n            \"title\": \"Noise Reduction Techniques for X-Ray Images\"\n        },\n        {\n            \"patent_number\": \"US9432109B1\",\n            \"title\": \"Image Enhancement Algorithms for Medical Imaging\"\n        },\n        {\n            \"patent_number\": \"US9321098B2\",\n            \"title\": \"Automated X-Ray Image Analysis System\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A method for enhancing X-ray images comprising...\",\n        \"The system of claim 1, wherein the image processing algorithm...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68431", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Electrolyte for Extended Cycle Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10523456B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2021-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery incorporating a novel electrolyte composition exhibiting enhanced ionic conductivity and improved stability, leading to extended cycle life and increased energy density.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"count\": 15\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"count\": 10\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition for a lithium-ion battery...\",\n        \"A method for manufacturing a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68431", "text": "{\n    \"patent_title\": \"Vanadium Redox Flow Battery with Improved Membrane Performance\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2020-02-15\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2022-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A vanadium redox flow battery employing a modified membrane structure to enhance ion transport and reduce crossover, resulting in improved efficiency and durability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"count\": 8\n        },\n        {\n            \"patent_number\": \"US10876543B2\",\n            \"count\": 5\n        }\n    ],\n    \"claims\": [\n        \"A vanadium redox flow battery including...\",\n        \"A membrane for a vanadium redox flow battery...\",\n        \"A method for operating a vanadium redox flow battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68432", "text": "{\n    \"patent_title\": \"Improved Nasal Cannula Design for Enhanced Patient Comfort\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel nasal cannula design incorporating flexible and biocompatible materials to minimize pressure points and improve patient comfort during long-term oxygen therapy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A nasal cannula comprising a flexible tube...\",\n        \"The nasal cannula of claim 1, wherein the tube is made of a silicone material...\",\n        \"The nasal cannula of claim 2, further comprising a pressure-reducing flange...\",\n        \"A method for administering oxygen using the nasal cannula of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68432", "text": "{\n    \"patent_title\": \"Automated Surgical Stapler with Force Feedback\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-03-15\",\n    \"filing_date\": \"2022-03-15\",\n    \"issue_date\": \"2024-02-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated surgical stapler system providing real-time force feedback to the surgeon during minimally invasive procedures. The system includes sensors and control algorithms to ensure precise staple placement and minimize tissue damage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising a staple cartridge...\",\n        \"The surgical stapler of claim 1, further comprising a force sensor...\",\n        \"A method for performing surgery using the surgical stapler of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68433", "text": "{\n    \"patent_title\": \"AI-Powered System for Enhanced Mammogram Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel system utilizing deep learning algorithms to analyze mammograms for early detection of breast cancer, achieving significantly improved diagnostic accuracy compared to traditional methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for analyzing medical images using artificial intelligence.\",\n        \"A system for detecting anomalies in medical images.\",\n        \"A computer-readable medium storing instructions for performing the method.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68433", "text": "{\n    \"patent_title\": \"Automated X-ray Analysis for Dental Cavities\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system using convolutional neural networks to analyze dental X-rays for the detection of cavities. Offers improved efficiency in dental diagnostics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Background in image recognition.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for automatically detecting cavities in dental X-rays.\",\n        \"A system for analyzing dental images.\",\n        \"A dental diagnostic apparatus.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68434", "text": "{\n    \"patent_title\": \"Novel Microfluidic Device for Rapid Disease Diagnosis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device is disclosed for the rapid and accurate diagnosis of diseases using a small sample volume. The device integrates sample preparation, amplification, and detection in a single chip.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for diagnosing a disease comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68434", "text": "{\n    \"patent_title\": \"Improved Bicycle Frame Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Independent Inventor\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-11-15\",\n    \"filing_date\": \"2022-11-15\",\n    \"issue_date\": \"2024-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved bicycle frame design providing increased strength and reduced weight.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A bicycle frame comprising...\",\n        \"A method of manufacturing a bicycle frame...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68435", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Sensor for Continuous Blood Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University Bioengineering Lab\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University Bioengineering Lab\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized wireless sensor for continuous blood glucose monitoring utilizing a minimally invasive subcutaneous insertion technique. The device transmits data to a remote monitoring station for real-time patient analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in glucose sensing technology\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless glucose sensor comprising...\",\n        \"A system for remote patient monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68435", "text": "{\n    \"patent_title\": \"Surgical Stapler with Enhanced Tissue Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Johnson & Johnson Medical Devices\"\n        },\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"Johnson & Johnson Medical Devices\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler designed for enhanced tissue compression during surgical procedures. The device features a novel clamping mechanism for secure and reliable tissue closure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Existing surgical stapler designs\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler with a clamping mechanism...\",\n        \"A method for performing surgical anastomosis...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68436", "text": "{\n    \"patent_title\": \"High-Resolution Optical Coherence Tomography System for In-Vivo Retinal Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-06-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel optical coherence tomography (OCT) system providing high-resolution, three-dimensional imaging of retinal structures. The system incorporates advanced signal processing techniques to enhance image quality and improve diagnostic accuracy for detecting early signs of macular degeneration and glaucoma.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8542231B2\",\n            \"relevance\": \"Prior art OCT system\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating a three-dimensional image of a retinal structure using optical coherence tomography.\",\n        \"An optical coherence tomography system comprising a light source, a scanning mechanism, and a detector.\",\n        \"The system of claim 2, further comprising a processing unit for enhancing image quality.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68436", "text": "{\n    \"patent_title\": \"Software Algorithm for Image Enhancement in Medical Diagnostics\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A software algorithm for enhancing the contrast and clarity of medical images, improving diagnostic visualization. The algorithm is applicable to various imaging modalities, including X-ray, CT, and MRI.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Previous image processing algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A computer-implemented method for enhancing the contrast of a medical image.\",\n        \"A computer program product comprising code for executing the method of claim 1.\",\n        \"A system for displaying enhanced medical images.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68437", "text": "{\n    \"patent_title\": \"Minimally Invasive Cardiac Valve Repair System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MedTech Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-09-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel system for minimally invasive repair of cardiac valves, utilizing a catheter-based delivery mechanism and bioresorbable scaffolds. This system aims to reduce surgical trauma and improve patient recovery times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B1\",\n            \"relevance\": \"Prior art regarding catheter design.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for repairing a cardiac valve comprising...\",\n        \"A catheter delivery system...\",\n        \"A bioresorbable scaffold...\",\n        \"The method according to claim 1, wherein the repair is performed percutaneously.\",\n        \"The scaffold according to claim 2, comprising biodegradable polymers.\",\n        \"The catheter delivery system according to claim 2, comprising a steerable guide.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68437", "text": "{\n    \"patent_title\": \"Cardiac Monitoring Device with Extended Battery Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Kenji Tanaka\",\n            \"affiliation\": \"Sony Corporation\"\n        },\n        {\n            \"name\": \"Akira Yamamoto\",\n            \"affiliation\": \"Hitachi Ltd.\"\n        }\n    ],\n    \"patent_number\": \"JP2017000001A\",\n    \"priority_date\": \"2017-01-05\",\n    \"filing_date\": \"2017-01-05\",\n    \"issue_date\": \"2018-07-12\",\n    \"patent_office\": \"JPO\",\n    \"abstract\": \"A wearable cardiac monitoring device featuring an extended battery life and improved signal processing capabilities. The device is designed for continuous monitoring of heart rate and rhythm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Prior art regarding wearable sensors.\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiac monitoring device comprising...\",\n        \"A battery capable of providing power for at least 7 days.\",\n        \"A signal processing unit...\",\n        \"The device according to claim 1, wherein the device is wearable.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68438", "text": "{\n    \"patent_title\": \"Implantable Drug Delivery System with Programmable Release\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-06-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable device for controlled drug delivery, allowing programmable release rates to optimize patient therapy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Microfluidic Drug Delivery Devices\"\n        }\n    ],\n    \"claims\": [\n        \"A drug delivery system comprising...\",\n        \"A method for controlling drug release...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68438", "text": "{\n    \"patent_title\": \"Advanced MRI Contrast Agent for Enhanced Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel contrast agent for magnetic resonance imaging, improving the detection of cancerous tumors.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Gadolinium-Based Contrast Agents\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"A method for imaging tumors...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68439", "text": "{\n    \"patent_title\": \"Convolutional Neural Network for Efficient Image Super-Resolution\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel convolutional neural network architecture for efficient image super-resolution. The method utilizes deep learning techniques to reconstruct high-resolution images from low-resolution inputs, improving image quality and detail for various applications like surveillance and satellite imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image super-resolution comprising...\",\n        \"A convolutional neural network architecture...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68439", "text": "{\n    \"patent_title\": \"Medical Image Analysis using Deep Convolutional Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-01-15\",\n    \"filing_date\": \"2022-01-15\",\n    \"issue_date\": \"2023-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a deep learning-based system for the automated analysis of medical images, specifically MRI and CT scans, for the detection of tumors and other abnormalities. The system utilizes convolutional neural networks to improve the accuracy and efficiency of medical diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10111213B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for medical image analysis comprising...\",\n        \"A convolutional neural network trained on medical image datasets...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68440", "text": "{\n    \"patent_title\": \"Deep Learning-Based MRI Reconstruction for Accelerated Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-09-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel deep learning framework for accelerating Magnetic Resonance Imaging (MRI) reconstruction. The method employs a generative adversarial network (GAN) to generate high-quality images from undersampled k-space data, significantly reducing scan time without compromising image resolution. The architecture includes a novel regularization term that promotes anatomical consistency. The innovative reconstruction approach reduces artifacts commonly seen in accelerated MRI.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art in MRI acceleration\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images using a generative adversarial network.\",\n        \"A system for accelerated MRI scanning utilizing deep learning.\",\n        \"A computer-readable medium storing instructions for performing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68440", "text": "{\n    \"patent_title\": \"Improved X-ray Image Enhancement Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-11-12\",\n    \"issue_date\": \"2022-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a method for enhancing the contrast and clarity of X-ray images using a novel filtering algorithm. The algorithm effectively reduces noise and improves the visibility of subtle anatomical features. It involves adaptive histogram equalization and a spatial frequency filtering approach.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related prior art in X-ray image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing X-ray images using adaptive histogram equalization.\",\n        \"A system for processing X-ray images to improve clarity.\",\n        \"A computer program for implementing the image enhancement method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68441", "text": "{\n    \"patent_title\": \"High-Density Lithium-Ion Battery with Enhanced Cycling Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"MIT Lincoln Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2022-11-29\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery featuring a novel electrolyte composition and electrode architecture, leading to improved energy density and cycle life, particularly suitable for powering portable electronic devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on electrolyte additives.\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"The battery of claim 1, wherein the electrolyte...\",\n        \"The battery of claim 2, further comprising...\",\n        \"A method for manufacturing the battery of claim 1.\",\n        \"The method of claim 4, wherein the coating is applied...\",\n        \"The battery of claim 1, for use in portable electronic devices.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68441", "text": "{\n    \"patent_title\": \"Improved Lead-Acid Battery for Automotive Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Exide Technologies\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2017-12-01\",\n    \"filing_date\": \"2017-12-01\",\n    \"issue_date\": \"2023-03-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lead-acid battery designed for improved cold-cranking performance in automotive engines. Includes a modified grid structure and electrolyte formulation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous work on lead-acid electrode design.\"\n        }\n    ],\n    \"claims\": [\n        \"A lead-acid battery comprising...\",\n        \"The battery of claim 1, wherein the grid...\",\n        \"The battery of claim 2, including a separator...\",\n        \"A method for manufacturing a lead-acid battery.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68442", "text": "{\n    \"patent_title\": \"Method and System for Enhanced MRI Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for reconstructing magnetic resonance images (MRI) using advanced iterative algorithms to improve image clarity and reduce scan time. This invention significantly enhances the diagnostic capabilities of MRI by providing higher resolution images with reduced artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"MRI Image Processing Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI image reconstruction...\",\n        \"A computer-readable medium storing instructions for...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68442", "text": "{\n    \"patent_title\": \"Improved X-Ray Image Enhancement System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of Michigan\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-14\",\n    \"issue_date\": \"2020-05-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved system for enhancing the visibility of details in X-ray images through contrast adjustment and noise reduction techniques. This invention offers a significant improvement in X-ray image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Digital X-Ray Imaging Methods\"\n        }\n    ],\n    \"claims\": [\n        \"A system for enhancing X-ray images comprising...\",\n        \"A method for adjusting the contrast of an X-ray image...\",\n        \"A computer program for X-ray image processing...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68443", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Sensor System for Continuous Physiological Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"BioTech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MedTech Solutions Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized wireless sensor system for continuous and remote monitoring of physiological parameters such as heart rate, blood pressure, and oxygen saturation. The system utilizes advanced microfabrication techniques and low-power communication protocols for long-term, reliable operation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art in wireless sensor networks\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor system for physiological monitoring comprising...\",\n        \"A method for remote data transmission using low-power protocols...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68443", "text": "{\n    \"patent_title\": \"Novel Biosensor for Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-11-20\",\n    \"filing_date\": \"2022-11-20\",\n    \"issue_date\": \"2024-01-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel biosensor for accurate and continuous glucose monitoring. The sensor utilizes enzymatic reactions and electrochemical detection for real-time glucose level measurements.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related prior art in glucose sensor technology\"\n        }\n    ],\n    \"claims\": [\n        \"A biosensor for glucose monitoring comprising...\",\n        \"A method for electrochemical detection of glucose...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68444", "text": "{\n    \"patent_title\": \"Magnetic Resonance Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for reconstructing magnetic resonance images using deep learning techniques to enhance image quality and reduce scan time. The invention improves diagnostic accuracy by providing clearer and more detailed images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a magnetic resonance image...\",\n        \"The method of claim 1, wherein the deep learning model is a convolutional neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68444", "text": "{\n    \"patent_title\": \"Improved X-Ray Image Enhancement Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-01-20\",\n    \"filing_date\": \"2017-01-20\",\n    \"issue_date\": \"2019-04-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel technique for enhancing the contrast and clarity of X-ray images. It utilizes a digital filtering algorithm to improve visibility of subtle details.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an X-ray image...\",\n        \"The method of claim 1, wherein the digital filter is a Laplacian filter.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68445", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2023-11-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a miniaturized, fully implantable biosensor for continuous glucose monitoring in diabetic patients. The device utilizes a novel enzyme-based electrochemical detection method with enhanced sensitivity and specificity. A key feature is its biocompatible coating that minimizes tissue response and extends implant lifespan. The system wirelessly transmits data to an external receiver, enabling real-time glucose level monitoring. This addresses a critical unmet need for non-invasive, accurate, and long-term glucose monitoring, improving patient compliance and glycemic control. The sensor demonstrates high correlation with standard blood glucose measurements in pre-clinical trials. The device includes self-calibration capabilities and automated data logging. The compact design minimizes patient discomfort and facilitates seamless integration into daily life. The biocompatibility assessment showed minimal inflammatory response over a 90-day implantation period. Further studies are ongoing to evaluate long-term performance and safety. (210 words)\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art in glucose sensing\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable biosensor for continuous glucose monitoring comprising...\",\n        \"A method for wirelessly transmitting glucose data from an implantable biosensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68445", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Acme Surgical Instruments Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2018-01-10\",\n    \"filing_date\": \"2018-01-10\",\n    \"issue_date\": \"2022-05-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a surgical stapler with an improved ergonomic handle design, allowing for increased comfort and precision during surgical procedures. The handle incorporates a textured grip and a reduced trigger force. The stapler is compatible with standard staples and utilizes a safety mechanism to prevent accidental firing. (85 words)\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US4000000A\",\n            \"relevance\": \"Early surgical stapler design\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an ergonomic handle...\",\n        \"A handle assembly with a textured grip surface...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68446", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Cardiac Monitor with Extended Battery Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Boston University\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-11-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable cardiac monitor with extended battery life, providing real-time ECG data for early detection of arrhythmias. This device is life-saving for patients at risk of sudden cardiac arrest.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"year\": \"2018\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"year\": \"2014\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable cardiac monitor...\",\n        \"A system for real-time ECG data monitoring...\",\n        \"A method for detecting arrhythmias...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68446", "text": "{\n    \"patent_title\": \"Improved Surgical Stapler Design\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emily Chen\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-02-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler design offering greater precision and control during surgical procedures. Enhancements improve suture placement accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6123456B1\",\n            \"year\": \"2000\"\n        },\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"year\": \"2013\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"A method for using the surgical stapler...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68447", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging Technique for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel MRI technique utilizing advanced pulse sequences to enhance contrast and resolution, enabling earlier detection of cancerous tissues. The invention significantly improves diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Baseline MRI Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating a magnetic resonance image...\",\n        \"The method of claim 1, wherein the pulse sequence...\",\n        \"An apparatus for performing the method of claim 1...\",\n        \"The apparatus of claim 3, comprising a...\",\n        \"A system for detecting cancerous tissues...\",\n        \"The system of claim 5, wherein the image processing...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68447", "text": "{\n    \"patent_title\": \"Enhanced X-ray Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"State University\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-11-12\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"An X-ray imaging system with improved filters for reducing radiation exposure. While enhancing image quality, it does not fundamentally alter diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Improved Magnetic Resonance Imaging Technique\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"The system of claim 1, wherein the filters...\",\n        \"A method for operating the system...\",\n        \"A control unit for the system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68448", "text": "{\n    \"patent_title\": \"AI-Powered Diagnostic System for Early Detection of Retinal Diseases\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Health\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a machine learning system for the automated detection of diabetic retinopathy and macular degeneration from retinal fundus images. The system employs a convolutional neural network trained on a large dataset of annotated images, achieving high accuracy in identifying early-stage disease markers, leading to timely intervention and improved patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting retinal diseases using a machine learning model.\",\n        \"A system comprising a retinal imaging device and a machine learning model.\",\n        \"A computer-readable medium storing instructions for implementing the method.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68448", "text": "{\n    \"patent_title\": \"Automated Appointment Scheduling System for Healthcare Providers\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2022-05-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents an automated system for scheduling patient appointments, optimizing provider calendars, and reducing administrative overhead. The system utilizes a rule-based engine and integrates with existing electronic health record systems to improve appointment efficiency and patient flow.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for automated appointment scheduling.\",\n        \"A method for optimizing provider calendars.\",\n        \"A computer program for managing patient appointments.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68449", "text": "{\n    \"patent_title\": \"Real-Time Image Enhancement System for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"EP3854712B1\",\n    \"priority_date\": \"2019-10-26\",\n    \"filing_date\": \"2020-04-15\",\n    \"issue_date\": \"2021-08-04\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"A system and method for real-time image enhancement on mobile devices, utilizing a novel algorithm to improve image quality in low-light conditions.  The algorithm focuses on practical deployment on resource-constrained devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in image filtering\"\n        }\n    ],\n    \"claims\": [\n        \"A method for real-time image processing comprising...\",\n        \"An apparatus for enhancing images in real-time...\",\n        \"The method of claim 1, wherein the image processing is performed on a mobile device.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68449", "text": "{\n    \"patent_title\": \"Theoretical Framework for Image Decomposition\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-05-10\",\n    \"filing_date\": \"2019-03-01\",\n    \"issue_date\": \"2022-01-18\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A novel theoretical framework for decomposing images into a set of basis functions, offering insights into image representation and reconstruction. This work primarily aims to advance the understanding of image structure from a mathematical perspective.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"EP2987654B1\",\n            \"relevance\": \"Related work on wavelet transforms\"\n        }\n    ],\n    \"claims\": [\n        \"A method for decomposing an image into a set of basis functions...\",\n        \"A system for image decomposition based on a novel mathematical framework...\",\n        \"The method of claim 1, wherein the basis functions are orthogonal.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68450", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2023-12-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and apparatus for enhanced magnetic resonance imaging (MRI) to improve the early detection of cancerous tumors. The method utilizes novel pulse sequences and image processing techniques to increase image contrast and reduce noise, leading to more accurate diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on MRI pulse sequences\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI comprising...\",\n        \"An MRI apparatus configured to...\",\n        \"A system for diagnosing cancer using MRI...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68450", "text": "{\n    \"patent_title\": \"Enhanced Data Compression for Industrial CT Scanners\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"General Electric\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-01-15\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2023-05-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method and system for compressing data generated by computed tomography (CT) scanners used in industrial quality control. The compression algorithm reduces storage requirements and transmission times without significant loss of image detail.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art on data compression algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing CT scan data...\",\n        \"A system for reducing storage requirements...\",\n        \"A data compression algorithm...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68451", "text": "{\n    \"patent_title\": \"Surgical Robotic System with Enhanced Dexterity\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical robotic system comprising a multi-articulated surgical instrument and a control system for enhanced precision and dexterity in minimally invasive surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"High\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Medium\"\n        },\n        {\n            \"patent_number\": \"US11000001B2\",\n            \"relevance\": \"Medium\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic system comprising...\",\n        \"A control system for...\",\n        \"An instrument capable of...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68451", "text": "{\n    \"patent_title\": \"Improved MRI Scanning Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2022-05-10\",\n    \"filing_date\": \"2022-05-10\",\n    \"issue_date\": \"2024-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel magnetic resonance imaging (MRI) scanning technique that improves image resolution and reduces scan time for diagnostic purposes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"High\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Medium\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI scanning technique comprising...\",\n        \"A method for reducing scan time...\",\n        \"An improved image resolution...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68452", "text": "{\n    \"patent_title\": \"Deep Learning Based Image Enhancement for Autonomous Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Inc.\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"NVIDIA\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel deep learning architecture for enhancing image quality in autonomous vehicle systems. The system utilizes convolutional neural networks to reduce noise and improve object detection in challenging conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image quality using a deep learning model.\",\n        \"A system for autonomous vehicles incorporating the image enhancement method.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68452", "text": "{\n    \"patent_title\": \"Image Processing for Diagnostic Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Eve Green\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Frank White\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2023-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to image processing techniques used in medical imaging for the detection of anomalies. The invention utilizes advanced filtering and segmentation algorithms to improve diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing medical images to identify anomalies.\",\n        \"A system for diagnostic imaging incorporating the image processing method.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68453", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Cancer Cell Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for the rapid and sensitive detection of circulating tumor cells in blood samples. The device utilizes a novel antibody-based capture method and integrated fluorescence microscopy for real-time analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Similar microfluidic device design\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device for detecting cancer cells...\",\n        \"A method for isolating circulating tumor cells...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68453", "text": "{\n    \"patent_title\": \"Improved Pacemaker with Adaptive Rate Response\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-11-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved pacemaker device incorporating an adaptive rate response algorithm to optimize pacing based on patient activity levels. The device includes enhanced battery management and remote monitoring capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous pacemaker designs\"\n        }\n    ],\n    \"claims\": [\n        \"A pacemaker device with adaptive rate control...\",\n        \"A method for monitoring patient activity and adjusting pacing parameters...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68454", "text": "{\n    \"patent_title\": \"Deep Learning-Based Medical Image Segmentation\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-06-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention utilizes deep learning algorithms for accurate and efficient segmentation of medical images, enabling improved diagnosis and treatment planning. It addresses the challenges of noisy data and complex anatomical structures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for segmenting medical images using a convolutional neural network.\",\n        \"A system for automated diagnosis based on segmented medical images.\",\n        \"The use of deep learning for enhancing image quality in medical imaging.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68454", "text": "{\n    \"patent_title\": \"Image Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"ACME Corp\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2021-02-10\",\n    \"issue_date\": \"2022-05-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image compression algorithm based on wavelet transforms, achieving high compression ratios with minimal loss of image quality.  Suitable for general image storage and transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing images using wavelet transforms.\",\n        \"A system for storing compressed images.\",\n        \"An image format based on wavelet compression.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68455", "text": "{\n    \"patent_title\": \"Method and System for Noise Reduction in Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for reducing noise in magnetic resonance images using adaptive filtering techniques, resulting in improved image clarity and diagnostic accuracy. The method does not utilize contrast agents.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8766832B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing noise in MRI images comprising...\",\n        \"A system for implementing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68455", "text": "{\n    \"patent_title\": \"Contrast-Enhanced Computed Tomography Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2015-11-20\",\n    \"filing_date\": \"2015-11-20\",\n    \"issue_date\": \"2018-07-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved contrast-enhanced computed tomography imaging system utilizing novel contrast agents for enhanced visualization of vasculature and tissues. This system provides significantly improved image clarity in diagnostic applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7982541B2\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast-enhanced CT imaging system comprising...\",\n        \"A method for using the system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68456", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10456789B2\",\n    \"priority_date\": \"2018-05-10\",\n    \"filing_date\": \"2018-05-10\",\n    \"issue_date\": \"2019-12-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for increasing the resolution of digital images using a convolutional neural network. The system learns to map low-resolution images to high-resolution images, enhancing visual details and sharpness.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"count\": 150\n        },\n        {\n            \"patent_number\": \"US10234567B2\",\n            \"count\": 80\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising...\",\n        \"A system for processing images comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68456", "text": "{\n    \"patent_title\": \"MRI Image Reconstruction Using Compressed Sensing\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2021-01-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for reconstructing high-quality magnetic resonance images (MRI) from undersampled k-space data using compressed sensing techniques. This allows for faster scan times and reduced patient discomfort.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"count\": 100\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"An apparatus for performing MRI reconstruction comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68457", "text": "{\n    \"patent_title\": \"Micro-Robotic System for Targeted Tissue Ablation\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-05-15\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel micro-robotic system for precise and minimally invasive tissue ablation is disclosed. The system utilizes a magnetic resonance-guided approach to navigate to targeted areas within the body and deliver controlled thermal energy, offering a less traumatic alternative to traditional surgical methods. A unique tissue manipulation technique enhances ablation efficacy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A micro-robotic system for tissue ablation...\",\n        \"A method for guiding a robotic device using magnetic resonance...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68457", "text": "{\n    \"patent_title\": \"Improved Cardiac Stent Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Davis\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Dr. Charles Wilson\",\n            \"affiliation\": \"Johns Hopkins University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2020-07-10\",\n    \"filing_date\": \"2020-07-10\",\n    \"issue_date\": \"2022-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved design for a cardiac stent is disclosed, featuring enhanced biocompatibility and reduced risk of restenosis. The stent is designed for percutaneous coronary intervention and provides improved blood flow to the heart.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiac stent with enhanced biocompatibility...\",\n        \"A method for delivering a stent to a coronary artery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68458", "text": "{\n    \"patent_title\": \"Non-Invasive Glucose Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive glucose monitoring system utilizing optical sensors to determine blood glucose levels without skin puncture, providing improved patient comfort and convenience.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for non-invasive glucose monitoring using optical sensors.\",\n        \"A device comprising an optical sensor for determining glucose levels.\",\n        \"A system for providing real-time glucose data to a patient.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68458", "text": "{\n    \"patent_title\": \"Cardiovascular Stent with Drug Eluting Coating\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2021-11-01\",\n    \"filing_date\": \"2021-11-01\",\n    \"issue_date\": \"2024-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A cardiovascular stent with a drug-eluting coating to prevent restenosis. The stent is designed for implantation in coronary arteries to improve blood flow.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiovascular stent comprising a metallic structure.\",\n        \"A drug-eluting coating for a cardiovascular stent.\",\n        \"A method for implanting a cardiovascular stent.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68459", "text": "{\n    \"patent_title\": \"High-Resolution Spectral Imaging for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Chen\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-01-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel spectral imaging system and method for enhancing the detection of cancerous tissues at early stages. The system employs a unique combination of spectral analysis and advanced image processing algorithms to achieve significantly improved diagnostic accuracy compared to existing methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on spectral imaging basics\"\n        }\n    ],\n    \"claims\": [\n        \"A spectral imaging system comprising...\",\n        \"A method for detecting cancerous tissue...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68459", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Sarah Lee\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-07-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel contrast agent for magnetic resonance imaging (MRI) offering slightly improved image clarity. The agent is based on a modified gadolinium complex and provides enhanced visualization of blood vessels.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Existing gadolinium-based contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"A method for enhancing MRI images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68460", "text": "{\n    \"patent_title\": \"Minimally Invasive Cardiac Monitoring Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive cardiac monitoring device utilizing a biocompatible sensor implanted via catheter to continuously monitor heart rhythm and detect arrhythmias. Addresses the unmet need for long-term, remote cardiac monitoring.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on implantable sensors.\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiac monitoring device comprising...\",\n        \"A method for monitoring cardiac rhythm comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68460", "text": "{\n    \"patent_title\": \"Surgical Robot for Open-Heart Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"General Hospital\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"General Hospital\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-11-10\",\n    \"filing_date\": \"2020-11-10\",\n    \"issue_date\": \"2023-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical robot designed for assisting in complex open-heart surgeries.  Enhances precision and control during coronary artery bypass grafting.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related to robotic surgery systems.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robot system comprising...\",\n        \"A method for performing open-heart surgery comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68461", "text": "{\n    \"patent_title\": \"Implantable Cardiac Rhythm Management System with Adaptive Pacing\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Boston Scientific\"\n        }\n    ],\n    \"patent_number\": \"US10543219B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-01-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac rhythm management system comprising a leadless cardiac pacemaker with adaptive pacing algorithms for optimized heart function. The device features a novel energy harvesting mechanism to prolong battery life and a closed-loop feedback system for personalized treatment.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8876543B2\",\n            \"relevance\": \"Related prior art on cardiac pacing\"\n        }\n    ],\n    \"claims\": [\n        \"A leadless cardiac pacemaker comprising an energy harvesting module.\",\n        \"A method for adaptive pacing based on real-time hemodynamic data.\",\n        \"A system for delivering personalized cardiac rhythm therapy.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68461", "text": "{\n    \"patent_title\": \"Magnetic Resonance Imaging System for Cardiovascular Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2015-11-20\",\n    \"filing_date\": \"2015-11-20\",\n    \"issue_date\": \"2019-07-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A magnetic resonance imaging (MRI) system optimized for high-resolution cardiovascular imaging. The system incorporates advanced gradient coils and image reconstruction algorithms for improved visualization of cardiac structures and blood flow. The system enables precise diagnosis of cardiovascular diseases.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art in MRI technology\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI system comprising a high-field magnet and gradient coils.\",\n        \"A method for reconstructing images from MRI data.\",\n        \"A system for visualizing blood flow using MRI.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68462", "text": "{\n    \"patent_title\": \"Non-Invasive Glucose Monitoring System Utilizing Raman Spectroscopy\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-01\",\n    \"issue_date\": \"2021-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel non-invasive glucose monitoring system using Raman spectroscopy for accurate and real-time glucose level detection. The system utilizes a miniaturized Raman spectrometer and advanced signal processing algorithms to provide reliable glucose readings without requiring blood samples.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in optical glucose sensing.\"\n        }\n    ],\n    \"claims\": [\n        \"A non-invasive glucose monitoring system comprising a Raman spectrometer.\",\n        \"A method for determining glucose concentration using Raman spectroscopy.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68462", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Johnson & Johnson\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-06-15\",\n    \"issue_date\": \"2022-12-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler with enhanced ergonomic design for increased comfort and precision during surgical procedures. The stapler features a redesigned handle and firing mechanism for improved usability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art in surgical stapler design.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an ergonomic handle.\",\n        \"A method for performing surgical stapling using the improved stapler.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68463", "text": "{\n    \"patent_title\": \"AI-Enhanced Medical Image Analysis System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-03-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system for medical image analysis using artificial intelligence and machine learning algorithms to enhance the detection of anomalies in MRI and CT scans. The system improves diagnostic accuracy and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9234567B1\",\n            \"relevance\": \"Prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for analyzing medical images comprising...\",\n        \"A system for detecting anomalies in medical images...\",\n        \"A computer-readable medium storing instructions for...\",\n        \"The method of claim 1, wherein the image analysis utilizes machine learning.\",\n        \"The system of claim 2, wherein the anomalies are detected using a convolutional neural network.\",\n        \"The system of claim 2, further comprising a user interface.\",\n        \"The method of claim 1, wherein the medical images are MRI scans.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68463", "text": "{\n    \"patent_title\": \"Improved X-Ray Image Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2015-11-20\",\n    \"filing_date\": \"2015-11-20\",\n    \"issue_date\": \"2019-02-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method for enhancing the contrast and clarity of X-ray images using digital image processing techniques. It improves the visibility of subtle details in X-ray images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art in X-ray imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing X-ray images comprising...\",\n        \"A system for improving the clarity of X-ray images...\",\n        \"A computer program for processing X-ray images...\",\n        \"The method of claim 1, wherein the contrast is enhanced using a histogram equalization algorithm.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68464", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Analysis using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2022-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for enhancing the analysis of medical images, such as MRI and CT scans, using deep learning techniques. The system employs artificial intelligence algorithms to identify subtle anomalies and improve diagnostic accuracy. The system is designed to assist radiologists in making more informed and timely diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for analyzing medical images comprising...\",\n        \"A system for identifying anomalies in medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68464", "text": "{\n    \"patent_title\": \"Improved X-ray Imaging System with Enhanced Contrast\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-01-15\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2023-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents an improved X-ray imaging system utilizing novel contrast agents to enhance image clarity. The system provides sharper and more detailed X-ray images for improved diagnostic capabilities. No artificial intelligence components are employed.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A contrast agent for use in X-ray imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68465", "text": "{\n    \"patent_title\": \"Non-Invasive Glucose Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive glucose monitoring system using spectroscopic analysis of skin tissue. The system provides continuous and accurate glucose readings without requiring blood samples.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in optical sensing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for non-invasive glucose monitoring...\",\n        \"An apparatus for determining glucose levels...\",\n        \"A system comprising a light source and a detector...\",\n        \"A method for calibrating the glucose monitoring system...\",\n        \"A device for displaying glucose concentration...\",\n        \"A method for data analysis...\",\n        \"A system for transmitting glucose data...\",\n        \"A method for alerting the user...\",\n        \"An apparatus for signal processing...\",\n        \"A device incorporating a microfluidic channel...\",\n        \"A method for minimizing interference...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68465", "text": "{\n    \"patent_title\": \"Improved Scalpel Handle Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Surgical Instruments\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-08-01\",\n    \"filing_date\": \"2021-10-15\",\n    \"issue_date\": \"2022-06-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved handle design for scalpels, providing better grip and control during surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art in scalpel handle ergonomics\"\n        }\n    ],\n    \"claims\": [\n        \"A scalpel handle with an ergonomic grip...\",\n        \"A scalpel handle made of a durable material...\",\n        \"A scalpel handle with a textured surface...\",\n        \"A scalpel handle designed for comfortable use...\",\n        \"A scalpel handle with a non-slip coating...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68466", "text": "{\n    \"patent_title\": \"Method for Enhancing Contrast in Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for enhancing contrast in magnetic resonance imaging (MRI) by utilizing a specific pulse sequence and image reconstruction algorithm. The method improves the visibility of subtle anatomical details, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in MRI pulse sequences\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing contrast in MRI comprising...\",\n        \"An MRI apparatus configured to perform the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68466", "text": "{\n    \"patent_title\": \"Novel Drug Delivery System Using Nanoparticles\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Pfizer Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2023-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel drug delivery system utilizing biodegradable nanoparticles for targeted delivery of pharmaceutical compounds. The nanoparticles are designed to encapsulate and protect the drug, improving its efficacy and reducing side effects.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related nanoparticle technologies\"\n        }\n    ],\n    \"claims\": [\n        \"A drug delivery system comprising...\",\n        \"A nanoparticle formulation...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68467", "text": "{\n    \"patent_title\": \"Ultrasound Image Enhancement for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel method for enhancing ultrasound images to improve the detection of small tumors, utilizing signal processing techniques. The method avoids the use of contrast agents, reducing patient risk and cost.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art in ultrasound imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing ultrasound images comprising...\",\n        \"The method of claim 1, wherein no contrast agent is used.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68467", "text": "{\n    \"patent_title\": \"MRI Contrast Agent with Improved Biocompatibility\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a new MRI contrast agent with enhanced biocompatibility and targeted delivery to tumor cells. The agent utilizes nanoparticle technology for improved imaging sensitivity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"relevance\": \"Related art in MRI contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent for MRI comprising...\",\n        \"The contrast agent of claim 1, wherein the agent is biocompatible.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68468", "text": "{\n    \"patent_title\": \"Extended Battery Life Mobile Device Utilizing Advanced Power Management\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Qualcomm Technologies\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A mobile device incorporating a novel power management system utilizing adaptive voltage scaling and predictive battery usage algorithms. This significantly extends battery life by up to 40% compared to existing devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art on battery optimization\"\n        }\n    ],\n    \"claims\": [\n        \"A mobile device comprising a processor, a battery, and a power management system configured to dynamically adjust voltage scaling based on predicted usage patterns.\",\n        \"A method for extending battery life in a mobile device comprising monitoring usage patterns and adapting power consumption accordingly.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68468", "text": "{\n    \"patent_title\": \"Improved Charging Circuit for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Apple Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-12-01\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-09-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved charging circuit that allows for faster charging of mobile devices. The circuit incorporates a new cooling mechanism to prevent overheating during high-speed charging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art on charging circuits\"\n        }\n    ],\n    \"claims\": [\n        \"A charging circuit comprising a power converter and a cooling system.\",\n        \"A method for fast charging a mobile device comprising regulating current and dissipating heat.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68469", "text": "{\n    \"patent_title\": \"Wearable Sensor System for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"This invention discloses a wearable sensor system for continuous glucose monitoring in diabetic patients. The system utilizes a non-invasive optical sensor integrated into a flexible patch, allowing for real-time glucose level measurements without the need for frequent finger pricks.  Data is wirelessly transmitted to a smartphone application for analysis and display, enabling patients to proactively manage their condition.  The system incorporates advanced algorithms for accurate glucose detection and provides alerts for hypo- and hyperglycemia. The device also integrates with telehealth platforms for remote monitoring by healthcare professionals. The device aims to improve patient compliance and overall health outcomes. Detailed signal processing and calibration methods are also provided, minimizing the impact of environmental factors on measurement accuracy.  This system represents a significant advancement in diabetes management and offers a more comfortable and convenient alternative to traditional methods. The long-term monitoring capabilities are particularly beneficial for early diagnosis and personalized treatment plans.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Non-invasive Glucose Monitoring Device\"\n        }\n    ],\n    \"claims\": [\n        \"A wearable sensor system for continuous glucose monitoring comprising...\",\n        \"A method for non-invasive glucose measurement using optical sensors...\",\n        \"A smartphone application for displaying and analyzing glucose data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68469", "text": "{\n    \"patent_title\": \"Surgical Instrument for Minimally Invasive Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Medical Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"EP3456789A1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"A novel surgical instrument designed for minimally invasive procedures. The instrument features an articulated tip for improved maneuverability and a high-resolution camera for enhanced visualization.  It allows surgeons to perform complex operations with greater precision and reduced patient trauma.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Articulated Surgical Instrument\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising an articulated tip...\",\n        \"A method for performing minimally invasive surgery using the instrument...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68470", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction Method for MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-10-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image reconstruction method for magnetic resonance imaging (MRI) that enhances image quality and reduces scan time, leading to improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"type\": \"Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"The method of claim 1, wherein the image quality is enhanced by...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68470", "text": "{\n    \"patent_title\": \"Medical Image Display System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Independent Consultant\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2019-05-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for displaying medical images on a monitor, with adjustable brightness and contrast settings.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A medical image display system comprising...\",\n        \"The system of claim 1, wherein the brightness is adjustable...\",\n        \"The system of claim 2, wherein the contrast is adjustable...\",\n        \"The system of claim 3, further comprising a zoom function...\",\n        \"The system of claim 4, further comprising a pan function...\",\n        \"The system of claim 5, further comprising a rotation function...\",\n        \"The system of claim 6, further comprising a measurement tool...\",\n        \"The system of claim 7, further comprising a reporting function...\",\n        \"The system of claim 8, further comprising a data storage function...\",\n        \"The system of claim 9, further comprising a network connection...\",\n        \"The system of claim 10, further comprising a user interface...\",\n        \"The system of claim 11, wherein the user interface is graphical...\",\n        \"The system of claim 12, wherein the user interface is touch-sensitive...\",\n        \"The system of claim 13, further comprising a security feature...\",\n        \"The system of claim 14, wherein the security feature is password-protected...\",\n        \"The system of claim 15, further comprising an audit trail...\",\n        \"The system of claim 16, further comprising a backup system...\",\n        \"The system of claim 17, further comprising a disaster recovery plan...\",\n        \"The system of claim 18, further comprising a compliance feature...\",\n        \"The system of claim 19, wherein the compliance feature meets HIPAA standards...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68471", "text": "{\n    \"patent_title\": \"Enhanced Magnetic Resonance Imaging with Artificial Intelligence Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Jian Li\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method for enhancing the resolution and clarity of magnetic resonance images using artificial intelligence-based reconstruction algorithms. The system significantly reduces scan times and improves diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing magnetic resonance images using a deep learning model.\",\n        \"A system comprising a magnetic resonance imaging device and a processing unit configured to implement the method.\",\n        \"The method of claim 1, wherein the deep learning model is a convolutional neural network.\",\n        \"The system of claim 2, wherein the processing unit is a cloud-based server.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68471", "text": "{\n    \"patent_title\": \"Improved X-Ray Tube Design for Dental Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Miller\",\n            \"affiliation\": \"Acme Dental Technologies\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2022-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved design for X-ray tubes used in dental imaging applications. The design enhances the efficiency of X-ray production and reduces radiation exposure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube comprising a modified anode structure.\",\n        \"The X-ray tube of claim 1, wherein the anode structure is made of tungsten alloy.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68472", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Reconstruction for Reduced-Dose Computed Tomography\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention utilizes deep learning techniques to reconstruct high-quality images from low-dose computed tomography (CT) scans. The method significantly reduces radiation exposure while maintaining diagnostic image quality, offering potential benefits in medical imaging applications. The deep learning model is trained on a large dataset of CT images to learn the mapping between low-dose and high-dose images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an image from low-dose CT scan data using a deep learning model.\",\n        \"A system for reducing radiation exposure in CT imaging using deep learning.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68472", "text": "{\n    \"patent_title\": \"Efficient Video Compression Using Wavelet Transforms\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2017-08-10\",\n    \"filing_date\": \"2017-08-10\",\n    \"issue_date\": \"2023-05-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel wavelet transform-based algorithm for efficient video compression. The method achieves high compression ratios while preserving video quality, suitable for streaming and storage applications. It focuses on reducing the bitrate required for video transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for video compression using wavelet transforms.\",\n        \"A system for reducing bitrate in video streaming.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68473", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for reconstructing high-resolution medical images from low-dose data, leading to improved diagnostic accuracy, particularly in early cancer detection. The system employs advanced iterative reconstruction algorithms and noise reduction techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for medical image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68473", "text": "{\n    \"patent_title\": \"Medical Imaging Apparatus\",\n    \"inventors\": [\n        {\n            \"name\": \"Karl Schmidt\",\n            \"affiliation\": \"Siemens Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-11-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved medical imaging apparatus utilizing contrast agents to enhance image visibility. The apparatus focuses on reducing scan time and patient discomfort.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"An apparatus for medical imaging comprising...\",\n        \"A method of contrast enhancement...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68474", "text": "{\n    \"patent_title\": \"Non-Invasive Blood Glucose Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-05-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a non-invasive system for continuous blood glucose monitoring using near-infrared spectroscopy. The system incorporates advanced signal processing algorithms to minimize interference and provide accurate readings. It is intended for use by diabetic patients for self-monitoring and management of their condition. The device is compact, wearable, and requires minimal calibration. This approach avoids the pain and inconvenience associated with traditional blood glucose testing methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A non-invasive blood glucose monitoring system comprising...\",\n        \"A method for determining blood glucose concentration...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68474", "text": "{\n    \"patent_title\": \"Surgical Instrument for Minimally Invasive Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Acme Medical Devices Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-01-10\",\n    \"filing_date\": \"2017-01-10\",\n    \"issue_date\": \"2019-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical instrument designed for minimally invasive procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising...\",\n        \"A method for performing minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68475", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Cycle Life through Nanomaterial Coating\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery incorporating a novel nanomaterial coating on the electrodes to improve cycle life and reduce internal resistance, leading to extended battery life in portable electronic devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on lithium-ion battery electrode materials.\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising a cathode, an anode, and an electrolyte, wherein the cathode is coated with a nanomaterial layer.\",\n        \"The battery of claim 1, wherein the nanomaterial is a carbon nanotube.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68475", "text": "{\n    \"patent_title\": \"Improved Battery Management System for Mobile Phones\",\n    \"inventors\": [\n        {\n            \"name\": \"Ji-hoon Park\",\n            \"affiliation\": \"Samsung Electronics\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2022-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system designed to optimize power consumption and extend battery life in mobile phones. Focuses on software algorithms for charge control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10112233B2\",\n            \"relevance\": \"Prior art on battery management techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising a microcontroller and a software algorithm for controlling charge and discharge cycles.\",\n        \"The system of claim 1, wherein the software algorithm dynamically adjusts the charging rate based on battery temperature.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68476", "text": "{\n    \"patent_title\": \"Novel MRI Contrast Agent for Early Stage Breast Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-03-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel MRI contrast agent is disclosed, enhancing the detection of early-stage breast cancer through improved signal-to-noise ratio and targeted accumulation in tumor cells. The agent comprises a gadolinium complex conjugated to a peptide that binds specifically to receptors overexpressed in cancerous tissues.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"MRI Techniques for Tumor Imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting early-stage breast cancer comprising...\",\n        \"An MRI contrast agent comprising...\",\n        \"A pharmaceutical composition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68476", "text": "{\n    \"patent_title\": \"Improved CT Scan Reconstruction Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Klaus Schmidt\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"EP3456789A1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2018-11-07\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"A novel algorithm for reconstructing images from CT scan data, resulting in reduced artifacts and improved image quality. The algorithm utilizes iterative reconstruction techniques and advanced filtering methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"CT Image Reconstruction Methods\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing CT images comprising...\",\n        \"A computer program product for implementing the method...\",\n        \"A CT scanner utilizing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68477", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-06-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable biosensor for continuous glucose monitoring. The device utilizes a novel enzyme-based electrochemical detection system, providing highly accurate and reliable glucose readings. This improves patient outcomes by enabling real-time monitoring and personalized insulin delivery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable biosensor comprising...\",\n        \"A method for continuous glucose monitoring using said biosensor...\",\n        \"A system for delivering insulin based on glucose readings from said biosensor...\",\n        \"The biosensor of claim 1, wherein the enzyme is glucose oxidase.\",\n        \"The method of claim 2, wherein the glucose readings are transmitted wirelessly.\",\n        \"The system of claim 3, further comprising a user interface.\",\n        \"The biosensor of claim 1, having a lifetime of at least 6 months.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68477", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Small Biotech Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-08-10\",\n    \"filing_date\": \"2020-03-05\",\n    \"issue_date\": \"2021-01-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design for more efficient drug delivery. The catheter features a modified tip geometry for reduced resistance and improved flow rate.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a distal tip with a modified geometry...\",\n        \"A method for drug delivery using said catheter...\",\n        \"The catheter of claim 1, wherein the tip geometry is conical.\",\n        \"The method of claim 2, wherein the drug is delivered intravenously.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68478", "text": "{\n    \"patent_title\": \"MRI Enhancement Using Deep Learning for Improved Neurological Diagnosis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method for enhancing magnetic resonance images (MRI) of the brain using deep learning algorithms. The method improves the clarity of images, enabling more accurate diagnosis of neurological disorders such as Alzheimer's disease and multiple sclerosis. The algorithm reduces noise and artifacts, leading to better visualization of subtle pathological changes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on MRI image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI images using a convolutional neural network.\",\n        \"The method according to claim 1, wherein the neural network is trained on a dataset of MRI images of brains with Alzheimer's disease.\",\n        \"The method according to claim 1, wherein the enhancement reduces image noise by at least 20%.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68478", "text": "{\n    \"patent_title\": \"Improved CT Scanning for Cardiovascular Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Karl Schmidt\",\n            \"affiliation\": \"Siemens Healthineers\"\n        },\n        {\n            \"name\": \"Eva Muller\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved computed tomography (CT) scanning technique for visualizing cardiovascular structures. The method utilizes iterative reconstruction algorithms to reduce image artifacts and improve image quality, resulting in better diagnosis of heart disease. The system also incorporates dose reduction strategies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art on CT image reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A CT scanning method comprising iterative reconstruction.\",\n        \"The method according to claim 1, wherein the iterative reconstruction algorithm is based on a statistical model.\",\n        \"A CT scanner configured to implement the method of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68479", "text": "{\n    \"patent_title\": \"Non-Invasive Glucose Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive system for continuous glucose monitoring utilizing spectroscopic analysis. The device provides real-time glucose levels without requiring blood samples, improving patient comfort and management of diabetes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for non-invasive glucose monitoring.\",\n        \"A device comprising a spectroscopic sensor and a processing unit.\",\n        \"A system for continuous glucose data transmission.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68479", "text": "{\n    \"patent_title\": \"Surgical Retractor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Johnson & Johnson\"\n        }\n    ],\n    \"patent_number\": \"US11123456B2\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-01-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical retractor system designed to provide improved access and visualization during minimally invasive surgical procedures. The system utilizes a modular design and adjustable arms for optimal positioning.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical retractor comprising adjustable arms.\",\n        \"A method of using the retractor during surgery.\",\n        \"A modular retractor system.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68480", "text": "{\n    \"patent_title\": \"Method for Enhanced Cancer Detection Using Multi-Modal Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Dr. Jian Li\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2023-10-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method for improved cancer detection using a combination of MRI and PET imaging modalities. The method utilizes novel image processing techniques to enhance the visualization of cancerous tissues, leading to earlier and more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancer...\",\n        \"The method of claim 1, wherein the imaging modalities comprise MRI and PET.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68480", "text": "{\n    \"patent_title\": \"Improved Medical Image Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2017-12-20\",\n    \"filing_date\": \"2017-12-20\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new algorithm for compressing medical images, reducing storage requirements and transmission times. The algorithm utilizes wavelet transforms and entropy coding techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US4500000A\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a medical image...\",\n        \"The method of claim 1, wherein the wavelet transform is a Daubechies wavelet.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68481", "text": "{\n    \"patent_title\": \"Surgical Robotic System with Enhanced Precision and Dexterity\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2018-03-20\",\n    \"issue_date\": \"2023-11-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a surgical robotic system designed for minimally invasive procedures. The system incorporates advanced sensor feedback and micro-manipulation capabilities to enhance surgical precision and improve patient outcomes by reducing trauma and recovery time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic system comprising...\",\n        \"A method for performing a minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68481", "text": "{\n    \"patent_title\": \"Dental Implant with Bioactive Coating\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Sarah Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-08-10\",\n    \"filing_date\": \"2019-02-15\",\n    \"issue_date\": \"2024-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel dental implant featuring a bioactive coating that promotes osseointegration and enhances implant stability. The coating comprises a biocompatible material that facilitates bone growth around the implant.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A dental implant comprising a bioactive coating...\",\n        \"A method for improving osseointegration using the implant...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68482", "text": "{\n    \"patent_title\": \"High-Energy Density Lithium-Ion Battery with Novel Electrolyte Formulation\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-05-15\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery comprising a novel electrolyte formulation exhibiting enhanced ionic conductivity and electrochemical stability, resulting in improved energy density and cycle life. This invention demonstrates a practical solution for increasing the performance of electric vehicles and energy storage systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte formulation comprising...\",\n        \"A method for manufacturing a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68482", "text": "{\n    \"patent_title\": \"Theoretical Model for Enhanced Ion Transport in Solid-State Electrolytes\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2022-11-01\",\n    \"filing_date\": \"2022-11-01\",\n    \"issue_date\": \"2024-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel theoretical model for understanding ion transport mechanisms in solid-state electrolytes. The model predicts enhanced ion conductivity under specific conditions but does not include experimental validation or practical implementation details.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A theoretical model for ion transport...\",\n        \"A method for simulating ion conductivity...\",\n        \"A computer program implementing the model...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68483", "text": "{\n    \"patent_title\": \"Deep Learning-Based Reconstruction for Accelerated MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for accelerated magnetic resonance imaging (MRI) reconstruction using deep learning techniques. This approach significantly reduces scan time while maintaining high image quality, enabling faster and more efficient medical diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing accelerated MRI...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68483", "text": "{\n    \"patent_title\": \"Improved X-Ray Imaging with Contrast Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2013-11-20\",\n    \"filing_date\": \"2013-11-20\",\n    \"issue_date\": \"2017-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved X-ray imaging system utilizing novel contrast agents to enhance image visibility and improve diagnostic accuracy. The system includes a method for administering and monitoring the contrast agent, resulting in clearer and more detailed images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising a contrast agent...\",\n        \"A method for enhancing X-ray images using contrast...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68484", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-10-26\",\n    \"filing_date\": \"2020-05-15\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing high-resolution medical images from limited data, utilizing a deep learning approach to enhance image quality and reduce processing time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        },\n        {\n            \"patent_number\": \"US11234567B1\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\"\n        },\n        {\n            \"patent_number\": \"US12987654B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"The method of claim 1, wherein the image quality is improved by...\",\n        \"The method of claim 1, wherein the processing time is reduced by...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68484", "text": "{\n    \"patent_title\": \"Digital Image Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2021-03-10\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2021-08-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new technique for compressing digital images, reducing storage space and bandwidth requirements.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a digital image...\",\n        \"The method of claim 1, wherein the compression ratio is...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68485", "text": "{\n    \"patent_title\": \"Adaptive Median Filtering for Noise Reduction in Digital Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"EP3123456B1\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-06-15\",\n    \"issue_date\": \"2017-12-20\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"This invention discloses an adaptive median filtering algorithm for reducing noise in digital images. The algorithm adjusts the median filter size based on local image statistics, improving noise reduction while preserving image details.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6789012B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing noise in a digital image comprising...\",\n        \"An apparatus for implementing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68485", "text": "{\n    \"patent_title\": \"Color Image Enhancement using Histogram Equalization\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-03-01\",\n    \"filing_date\": \"2014-04-15\",\n    \"issue_date\": \"2018-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a technique for enhancing the contrast of color images using histogram equalization. The method operates on each color channel independently to improve image visibility.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"EP1234567B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing the contrast of a color image...\",\n        \"A system for implementing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68486", "text": "{\n    \"patent_title\": \"Micro-Robotic System for Targeted Tissue Ablation\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11254789B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-12-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a micro-robotic system for precise and minimally invasive tissue ablation. The system comprises a micro-robot, a control unit, and an imaging module. The micro-robot is designed to navigate through complex anatomical structures and deliver targeted energy pulses to ablate diseased tissue. The control unit provides real-time feedback and enables precise control of the micro-robot's movements. The imaging module provides visual guidance during the ablation process. The system is designed for a range of applications, including the treatment of tumors, neurological disorders, and other conditions requiring precise tissue removal. The system has a diameter of less than 1mm, allowing access to previously unreachable areas. The detailed system performance and biocompatibility tests are described. This system represents a significant advance in minimally invasive surgery, offering improved precision, reduced trauma, and faster recovery times. The system utilizes advanced materials and manufacturing techniques to achieve high performance and reliability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related art in micro-robotics\"\n        }\n    ],\n    \"claims\": [\n        \"A micro-robotic system for targeted tissue ablation comprising...\",\n        \"A control unit for controlling the movement of the micro-robot...\",\n        \"An imaging module for providing visual guidance...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68486", "text": "{\n    \"patent_title\": \"Implantable Cardiac Pacemaker with Advanced Sensing Capabilities\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Medtronic Inc.\"\n        },\n        {\n            \"name\": \"Emily Chen\",\n            \"affiliation\": \"Medtronic Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-07-20\",\n    \"filing_date\": \"2018-07-20\",\n    \"issue_date\": \"2021-04-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an implantable cardiac pacemaker with improved sensing capabilities. The pacemaker includes a lead system for delivering pacing pulses to the heart and a sensing module for detecting intrinsic cardiac activity. The sensing module is designed to minimize false positives and improve the accuracy of cardiac rhythm detection. The pacemaker also includes a telemetry module for communicating with an external programmer. The design optimizes battery life and reduces device size. The described pacemaker enhances the quality of life for patients with bradycardia and other cardiac rhythm disorders.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art in cardiac pacing\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable cardiac pacemaker comprising...\",\n        \"A lead system for delivering pacing pulses...\",\n        \"A sensing module for detecting cardiac activity...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68487", "text": "{\n    \"patent_title\": \"Biocompatible Scaffold for Nerve Regeneration\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US1234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel biocompatible scaffold designed to promote nerve regeneration following injury. The scaffold utilizes a biodegradable polymer matrix and incorporates growth factors to enhance neuronal growth. The device is designed for minimally invasive surgical implantation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art on biodegradable polymers\"\n        }\n    ],\n    \"claims\": [\n        \"A biocompatible scaffold comprising a biodegradable polymer matrix.\",\n        \"The scaffold of claim 1, further comprising growth factors.\",\n        \"A method for nerve regeneration comprising implanting the scaffold of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68487", "text": "{\n    \"patent_title\": \"Cardiovascular Stent with Drug Eluting Coating\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US7654321B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A cardiovascular stent with a drug-eluting coating to prevent restenosis. The stent is designed for minimally invasive placement within coronary arteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related prior art on drug-eluting stents\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiovascular stent comprising a metallic alloy.\",\n        \"The stent of claim 1, further comprising a drug-eluting coating.\",\n        \"A method for treating coronary artery disease comprising implanting the stent of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68488", "text": "{\n    \"patent_title\": \"Surgical System with Enhanced Visualization and Robotic Assistance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel surgical system designed for minimally invasive surgery. The system incorporates advanced imaging techniques and robotic assistance to enhance precision and improve patient outcomes by reducing recovery times and complications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art in robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising a robotic arm and an imaging module.\",\n        \"A method for performing minimally invasive surgery using the system.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68488", "text": "{\n    \"patent_title\": \"Diagnostic Apparatus for Cardiovascular Disease\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-15\",\n    \"issue_date\": \"2019-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A diagnostic device for the detection of cardiovascular abnormalities using advanced sensor technology. The invention facilitates early disease identification and improves patient management. No surgical aspects are included.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art relating to cardiovascular sensors\"\n        }\n    ],\n    \"claims\": [\n        \"A diagnostic apparatus including a sensor and a processing unit.\",\n        \"A method for detecting cardiovascular disease using the apparatus.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68489", "text": "{\n    \"patent_title\": \"Enhanced Image Recognition System Utilizing Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel image recognition system leveraging deep convolutional neural networks to achieve state-of-the-art accuracy in object detection and classification. The system utilizes a multi-scale feature extraction approach and a refined attention mechanism to improve performance on challenging datasets. The method is applicable to various fields including autonomous driving and robotics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"highly relevant\"\n        },\n        {\n            \"patent_number\": \"US1011121314B2\",\n            \"relevance\": \"relevant\"\n        },\n        {\n            \"patent_number\": \"US1122232425B1\",\n            \"relevance\": \"relevant\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"An image recognition system configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68489", "text": "{\n    \"patent_title\": \"Medical Image Analysis System for Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-05-10\",\n    \"filing_date\": \"2022-05-10\",\n    \"issue_date\": \"2024-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a system for analyzing medical images, specifically focusing on the detection of tumors in MRI scans. The system employs image segmentation and feature extraction techniques to identify potential cancerous regions. The method is designed to assist radiologists in improving diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"highly relevant\"\n        },\n        {\n            \"patent_number\": \"US85432109B1\",\n            \"relevance\": \"relevant\"\n        }\n    ],\n    \"claims\": [\n        \"A method for medical image analysis comprising...\",\n        \"A system for tumor detection configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68490", "text": "{\n    \"patent_title\": \"Method and System for Enhanced MRI Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2023-11-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for enhancing the resolution and clarity of MRI images through advanced reconstruction algorithms, leading to improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68490", "text": "{\n    \"patent_title\": \"Portable X-Ray Imaging Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2017-12-10\",\n    \"filing_date\": \"2017-12-10\",\n    \"issue_date\": \"2023-05-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A compact and portable X-ray imaging device for rapid and convenient medical diagnostics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging device comprising...\",\n        \"A portable system for generating X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68491", "text": "{\n    \"patent_title\": \"Non-Invasive Glucose Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive glucose monitoring system using optical sensors to determine blood glucose levels without puncturing the skin. This technology addresses the unmet clinical need for continuous and painless glucose monitoring for diabetic patients.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"title\": \"Continuous Glucose Monitoring System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for non-invasively measuring blood glucose levels.\",\n        \"A device comprising an optical sensor for detecting glucose concentration.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68491", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-07-01\",\n    \"filing_date\": \"2017-07-01\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler design with enhanced ergonomics for increased precision and reduced surgeon fatigue. The stapler features a lightweight body and improved grip.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Surgical Stapling Device\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an ergonomic handle.\",\n        \"A stapling cartridge for use in a surgical stapler.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68492", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Pressure Sensor for Intracranial Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2020-12-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized, wireless pressure sensor for continuous intracranial pressure monitoring. The device is fully implantable and transmits data wirelessly to an external receiver, enabling real-time assessment of intracranial pressure and potential for improved neurological patient care.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on wireless sensors\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor for intracranial monitoring.\",\n        \"A method for wirelessly transmitting intracranial pressure data.\",\n        \"A system for real-time monitoring of intracranial pressure.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68492", "text": "{\n    \"patent_title\": \"Drug-Eluting Stent with Improved Polymer Coating\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Emily Wilson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2018-11-01\",\n    \"issue_date\": \"2021-04-13\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A drug-eluting stent comprising a metallic scaffold and a novel polymer coating for controlled drug release, designed to reduce restenosis after percutaneous coronary intervention.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art on stent design\"\n        }\n    ],\n    \"claims\": [\n        \"A drug-eluting stent with a specified polymer coating.\",\n        \"A method for treating coronary artery disease using the stent.\",\n        \"A composition comprising the polymer coating.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68493", "text": "{\n    \"patent_title\": \"AI-Powered Medical Image Analysis System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system for automated detection of anomalies in medical images using deep learning. The system utilizes convolutional neural networks to analyze X-ray and MRI scans, assisting radiologists in diagnosis. It provides enhanced accuracy and efficiency in identifying potential health issues.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image processing.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting anomalies in medical images using deep learning.\",\n        \"A system comprising a convolutional neural network for image analysis.\",\n        \"A computer-readable medium storing instructions for performing the method.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68493", "text": "{\n    \"patent_title\": \"Advanced Image Recognition for Security Systems\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"TechCorp Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"TechCorp Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-03-15\",\n    \"filing_date\": \"2022-03-15\",\n    \"issue_date\": \"2024-02-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a highly sophisticated image recognition system designed for robust security applications. It leverages cutting-edge algorithms for facial recognition, object detection, and anomaly detection in video streams, providing unparalleled security features and capabilities. The system is capable of operating in diverse environmental conditions and handling large volumes of data efficiently. This detailed document explains the architecture and functionalities of the system extensively, providing a comprehensive understanding for potential implementation and further development. It includes detailed technical specifications, performance metrics, and future enhancement possibilities. It uses a complex algorithm for superior accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10112233B2\",\n            \"relevance\": \"Related to object detection algorithms.\"\n        }\n    ],\n    \"claims\": [\n        \"A security system utilizing facial recognition technology.\",\n        \"A method for detecting anomalies in video streams.\",\n        \"A system for object detection in real-time.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68494", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Enhancement for Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-11-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for enhancing the quality of medical images, improving diagnostic accuracy. The system utilizes generative adversarial networks (GANs) to generate high-resolution images from low-resolution inputs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art on image denoising.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing medical images using deep learning.\",\n        \"A system comprising a GAN architecture for image enhancement.\",\n        \"A method for improving diagnostic accuracy through image enhancement.\",\n        \"A computer-readable medium storing instructions for performing the method.\",\n        \"The method of claim 1, wherein the medical images are MRI scans.\",\n        \"The method of claim 1, wherein the medical images are CT scans.\",\n        \"The method of claim 1, wherein the medical images are X-ray images.\",\n        \"The system of claim 2, further comprising a user interface for displaying the enhanced images.\",\n        \"The system of claim 2, wherein the GAN architecture includes a generator network and a discriminator network.\",\n        \"The method of claim 1, wherein the deep learning architecture is trained on a dataset of medical images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68494", "text": "{\n    \"patent_title\": \"Method for Improving Contrast in Digital Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10543210B1\",\n    \"priority_date\": \"2018-12-01\",\n    \"filing_date\": \"2018-12-01\",\n    \"issue_date\": \"2020-07-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved method for enhancing the contrast of digital images using histogram equalization. This method provides a simple and effective way to improve image visibility.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art on histogram equalization techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing the contrast of a digital image.\",\n        \"The method of claim 1, wherein the image is a grayscale image.\",\n        \"The method of claim 1, wherein the image is a color image.\",\n        \"A system for performing the method of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68495", "text": "{\n    \"patent_title\": \"Low-Dose CT Image Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-03-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for reconstructing CT images from low-dose data using deep convolutional neural networks. This invention significantly reduces patient radiation exposure while maintaining image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8781045B2\",\n            \"kind\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a CT image comprising...\",\n        \"A system for reducing radiation dose in CT imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68495", "text": "{\n    \"patent_title\": \"Improved X-Ray Tube Design for General Radiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Karl Schmidt\",\n            \"affiliation\": \"Siemens Healthineers\"\n        },\n        {\n            \"name\": \"Lena Muller\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"EP3456789A1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2018-12-19\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"An improved X-ray tube design providing higher efficiency and improved image resolution for general radiography applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"kind\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube comprising...\",\n        \"A radiographic system incorporating the X-ray tube...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68496", "text": "{\n    \"patent_title\": \"Minimally Invasive Cardiac Valve Replacement System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel system for minimally invasive replacement of cardiac valves. The device is designed for transcatheter delivery, reducing patient recovery time and improving outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Similar valve design\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiac valve replacement system comprising...\",\n        \"A delivery catheter for transcatheter implantation...\",\n        \"A method for minimally invasive valve replacement...\",\n        \"Claim 4\",\n        \"Claim 5\",\n        \"Claim 6\",\n        \"Claim 7\",\n        \"Claim 8\",\n        \"Claim 9\",\n        \"Claim 10\",\n        \"Claim 11\"\n    ]\n}"}
{"_id": "Academic--patents--n--68496", "text": "{\n    \"patent_title\": \"Improved Stent Design for Peripheral Artery Disease\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-01-10\",\n    \"issue_date\": \"2023-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved stent design for treating peripheral artery disease. The stent provides enhanced flexibility and biocompatibility.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous stent design\"\n        }\n    ],\n    \"claims\": [\n        \"A stent comprising...\",\n        \"A method for deploying a stent...\",\n        \"Claim 3\",\n        \"Claim 4\",\n        \"Claim 5\"\n    ]\n}"}
{"_id": "Academic--patents--p--68497", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2020-10-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system comprising a small diameter endoscope with enhanced image processing capabilities and ergonomic instrument controls designed for improved patient comfort and reduced recovery time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising an endoscope with a diameter less than 5mm.\",\n        \"A method for performing minimally invasive surgery with reduced patient discomfort.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68497", "text": "{\n    \"patent_title\": \"MRI Guided Interventional System\",\n    \"inventors\": [\n        {\n            \"name\": \"Karl Schmidt\",\n            \"affiliation\": \"Siemens Healthineers\"\n        },\n        {\n            \"name\": \"Emily Davis\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2019-05-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An MRI-guided interventional system allowing for real-time visualization and precise control during minimally invasive procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI system integrated with robotic surgical tools.\",\n        \"A method for performing interventional procedures under MRI guidance.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68498", "text": "{\n    \"patent_title\": \"Non-Invasive Glucose Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology, Biomedical Engineering Department\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School, Bioelectronics Lab\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive glucose monitoring system using optical sensors and advanced signal processing algorithms for real-time glucose level determination without skin puncture.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Prior Art Glucose Sensor\"\n        }\n    ],\n    \"claims\": [\n        \"A non-invasive glucose monitoring device comprising...\",\n        \"A method for determining glucose levels using optical sensors...\",\n        \"A signal processing algorithm for filtering noise in glucose readings...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68498", "text": "{\n    \"patent_title\": \"Surgical Robotic System with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University, Mechanical Engineering Department\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2021-02-28\",\n    \"filing_date\": \"2021-04-15\",\n    \"issue_date\": \"2023-06-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A robotic surgical system providing enhanced precision and dexterity for minimally invasive surgical procedures. Includes advanced haptic feedback and image guidance capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Previous Surgical Robot\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic system comprising a plurality of articulated arms...\",\n        \"A method for performing minimally invasive surgery using robotic assistance...\",\n        \"A haptic feedback system for transmitting tactile sensations to the surgeon...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68499", "text": "{\n    \"patent_title\": \"Enhanced Magnetic Resonance Imaging for Early Detection of Neurodegenerative Diseases\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Jian Li\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2021-12-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel magnetic resonance imaging (MRI) technique that utilizes advanced pulse sequences and image reconstruction algorithms to enhance the detection of subtle pathological changes associated with rare neurodegenerative diseases, enabling earlier and more accurate diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art related to MRI pulse sequences.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating MRI images with enhanced sensitivity for detecting early-stage neurodegeneration.\",\n        \"An MRI apparatus configured to implement the method of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68499", "text": "{\n    \"patent_title\": \"Dermascanning Device for Personalized Cosmetic Treatment\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"L'Oreal Research\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2022-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A dermascanning device that utilizes optical imaging and AI algorithms to analyze skin conditions and recommend personalized cosmetic treatment regimens. The device measures skin tone, texture, and hydration levels to optimize product selection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related to skin analysis technologies.\"\n        }\n    ],\n    \"claims\": [\n        \"A dermascanning device comprising an optical sensor and a processing unit.\",\n        \"A method for analyzing skin conditions using the dermascanning device.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68500", "text": "{\n    \"patent_title\": \"Wearable Sensor System for Real-Time Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wearable sensor system is disclosed for continuous glucose monitoring. The device utilizes a non-invasive optical sensor and wireless communication to transmit data to a smartphone application for real-time patient monitoring and trend analysis. This improves patient management and reduces the need for frequent finger-prick tests.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A wearable sensor for non-invasive glucose monitoring.\",\n        \"A system for transmitting glucose data wirelessly.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68500", "text": "{\n    \"patent_title\": \"Implantable Cardiac Pacemaker with Enhanced Battery Life\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"University of California, San Francisco\"\n        },\n        {\n            \"name\": \"Emily Chen\",\n            \"affiliation\": \"Boston Scientific\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-11-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac pacemaker with an improved battery design is disclosed. The pacemaker utilizes a novel energy harvesting technique to extend battery life and reduce the frequency of battery replacements. This device provides reliable cardiac pacing for patients with bradycardia.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable cardiac pacemaker.\",\n        \"A battery design for extending pacemaker battery life.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68501", "text": "{\n    \"patent_title\": \"Enhanced Magnetic Resonance Imaging with Artificial Intelligence-Based Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2022-12-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel magnetic resonance imaging (MRI) technique utilizing deep learning algorithms for image reconstruction, leading to significantly improved image quality and diagnostic accuracy, particularly in detecting subtle anomalies. The system incorporates a multi-coil array and advanced noise reduction methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for MRI image reconstruction comprising...\",\n        \"A system for MRI image processing...\",\n        \"A computer-readable medium storing instructions for...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68501", "text": "{\n    \"patent_title\": \"Improved X-Ray Imaging System with Digital Detector\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2016-01-10\",\n    \"filing_date\": \"2016-01-10\",\n    \"issue_date\": \"2021-07-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An X-ray imaging system featuring a high-resolution digital detector for improved image clarity and reduced radiation dose. The system includes software for image enhancement and analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous X-ray detector designs\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A digital detector for X-ray imaging...\",\n        \"A method for processing X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68502", "text": "{\n    \"patent_title\": \"Enhanced MRI Reconstruction with Deep Learning for Improved Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning-based method for reconstructing MRI images, significantly enhancing image quality and improving the detection of cancerous tissues at early stages. The technique leverages a convolutional neural network trained on a large dataset of MRI scans.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"MRI Image Enhancement Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for diagnosing cancer using enhanced MRI images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68502", "text": "{\n    \"patent_title\": \"Improved X-ray Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2016-02-15\",\n    \"filing_date\": \"2016-08-01\",\n    \"issue_date\": \"2019-01-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved X-ray imaging system utilizing a novel detector array for higher resolution and reduced radiation exposure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"X-ray Detector Technology\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A detector array for X-ray imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68503", "text": "{\n    \"patent_title\": \"Improved X-ray Imaging System for Enhanced Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2023-10-26\",\n    \"patent_office\": \"US\",\n    \"abstract\": \"An X-ray imaging system incorporating a novel detector array and image processing techniques for improved cancer detection. The system enhances contrast and reduces radiation exposure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for improving cancer detection using X-ray imaging.\",\n        \"An X-ray imaging system comprising a detector array with enhanced sensitivity.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68503", "text": "{\n    \"patent_title\": \"Artificial Intelligence Algorithm for Cancer Diagnosis\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2024-01-15\",\n    \"patent_office\": \"US\",\n    \"abstract\": \"An artificial intelligence algorithm for diagnosing cancer from medical images. The algorithm utilizes deep learning techniques to identify cancerous cells with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for diagnosing cancer using an artificial intelligence algorithm.\",\n        \"A computer-readable medium storing a program for cancer diagnosis.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68504", "text": "{\n    \"patent_title\": \"MRI Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for reconstructing Magnetic Resonance Images (MRI) using deep learning algorithms. This improves image quality and reduces scan time, potentially leading to more accurate and faster diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"A system for performing MRI reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68504", "text": "{\n    \"patent_title\": \"Improved X-Ray Imaging System with Reduced Radiation Dose\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-08-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An X-ray imaging system designed to minimize patient exposure to radiation while maintaining image clarity. The system employs advanced filtering techniques to reduce noise and improve image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A method for reducing radiation dose in X-ray imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68505", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system incorporating advanced fiber optic technology for enhanced visualization and precision during surgical procedures. The system allows for smaller incisions and faster recovery times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising...\",\n        \"A visualization module for enhancing image clarity...\",\n        \"A method for performing minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68505", "text": "{\n    \"patent_title\": \"Dermal Filler Injection Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Allergan\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2021-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A device for precise injection of dermal fillers for cosmetic enhancement. The device utilizes a micro-needle array to minimize discomfort and improve delivery of the filler.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A dermal filler injection device...\",\n        \"A micro-needle array for reducing pain...\",\n        \"A method for injecting dermal fillers...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68506", "text": "{\n    \"patent_title\": \"Miniaturized Ultrasound Transducer for Real-Time Image-Guided Surgical Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-05-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A miniaturized ultrasound transducer integrated with a robotic surgical system enables real-time, high-resolution image guidance during minimally invasive procedures. The system enhances precision and reduces tissue damage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Robotic Surgical System with Enhanced Visualization\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized ultrasound transducer comprising...\",\n        \"A surgical robotic system integrating the transducer...\",\n        \"A method for real-time image-guided surgery...\",\n        \"A system for minimizing tissue damage...\",\n        \"A control system for adjusting transducer parameters...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68506", "text": "{\n    \"patent_title\": \"Improved Surgical Stapler Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Klaus Schmidt\",\n            \"affiliation\": \"RWTH Aachen University\"\n        }\n    ],\n    \"patent_number\": \"EP3876543B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2022-09-14\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"A surgical stapler with improved ergonomics and tissue compression, resulting in faster and more reliable staple deployment.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Advanced Surgical Stapling Device\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"A staple cartridge with improved retention...\",\n        \"A handle assembly for enhanced grip...\",\n        \"A mechanism for controlling staple depth...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68507", "text": "{\n    \"patent_title\": \"Miniaturized Imaging Catheter for Enhanced Vascular Navigation\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10456789B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-11-20\",\n    \"issue_date\": \"2021-02-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized imaging catheter for precise navigation within blood vessels during minimally invasive surgical procedures. The device incorporates fiber optic imaging and real-time image processing for enhanced visualization.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related prior art in catheter design\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Relevant imaging technology\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising an imaging module...\",\n        \"A method for navigating blood vessels...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68507", "text": "{\n    \"patent_title\": \"Surgical Robotic Arm with Force Feedback\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Evans\",\n            \"affiliation\": \"California Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2017-03-10\",\n    \"filing_date\": \"2017-09-15\",\n    \"issue_date\": \"2022-07-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical robotic arm providing enhanced precision and force feedback to surgeons during minimally invasive procedures. Improves surgical accuracy and reduces patient trauma.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art in robotic surgery\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related haptic feedback systems\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Relevant control algorithms\"\n        },\n        {\n            \"patent_number\": \"US9234567B2\",\n            \"relevance\": \"Related force sensors\"\n        },\n        {\n            \"patent_number\": \"US9345678B2\",\n            \"relevance\": \"Relevant image processing techniques\"\n        },\n        {\n            \"patent_number\": \"US9456789B2\",\n            \"relevance\": \"Related surgical tools\"\n        },\n        {\n            \"patent_number\": \"US9567890B2\",\n            \"relevance\": \"Relevant safety mechanisms\"\n        },\n        {\n            \"patent_number\": \"US9678901B2\",\n            \"relevance\": \"Related control interfaces\"\n        },\n        {\n            \"patent_number\": \"US9789012B2\",\n            \"relevance\": \"Relevant surgical planning systems\"\n        },\n        {\n            \"patent_number\": \"US9890123B2\",\n            \"relevance\": \"Related surgical navigation systems\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic arm comprising a force sensor...\",\n        \"A method for controlling a robotic arm...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68508", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Haptic Feedback\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Medical Robotics Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system incorporating advanced haptic feedback technology to enhance precision and control for surgeons. The system utilizes micro-actuators and a novel force sensor array to provide real-time tactile sensations, improving surgical outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on robotic surgical systems.\"\n        }\n    ],\n    \"claims\": [\n        \"A minimally invasive surgical system comprising...\",\n        \"A haptic feedback mechanism for providing tactile sensations...\",\n        \"A method for enhancing surgical precision...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68508", "text": "{\n    \"patent_title\": \"Improved MRI Image Reconstruction Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11890123B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-09-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel algorithm for reconstructing high-resolution images from MRI data, reducing noise and improving image clarity. The algorithm utilizes advanced signal processing techniques and machine learning models.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10234567B1\",\n            \"relevance\": \"Previous work on MRI signal processing.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"An algorithm for reducing noise in MRI data...\",\n        \"A system for generating high-resolution MRI images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68509", "text": "{\n    \"patent_title\": \"Deep Convolutional Neural Networks for High-Resolution Image Classification\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"TechCorp Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"TechCorp Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2019-06-04\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention introduces a novel deep convolutional neural network architecture for achieving state-of-the-art accuracy in high-resolution image classification. This is a groundbreaking approach utilizing attention mechanisms and residual connections for improved feature extraction and robustness. The model significantly outperforms existing methods in both accuracy and computational efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for classifying images using a deep convolutional neural network.\",\n        \"The method of claim 1, wherein the network comprises attention mechanisms.\",\n        \"The method of claim 1, wherein the network comprises residual connections.\",\n        \"A system for implementing the method of claim 1.\",\n        \"The system of claim 4, comprising a GPU for accelerated processing.\",\n        \"A non-transitory computer-readable medium storing instructions for implementing the method of claim 1.\",\n        \"A graphical user interface for interacting with the system of claim 4.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68509", "text": "{\n    \"patent_title\": \"Image Recognition using Support Vector Machines\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Miller\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11223344B2\",\n    \"priority_date\": \"2019-03-10\",\n    \"filing_date\": \"2020-01-25\",\n    \"issue_date\": \"2021-08-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved support vector machine algorithm for image recognition tasks. While achieving reasonable accuracy, the method relies on handcrafted feature extraction techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for classifying images using a support vector machine.\",\n        \"The method of claim 1, wherein the feature extraction is performed using SIFT.\",\n        \"A system for implementing the method of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68510", "text": "{\n    \"patent_title\": \"Miniaturized Robotic System for Percutaneous Interventions with Real-time Image Guidance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Chen\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized robotic system for performing percutaneous interventions with integrated real-time image guidance. The system allows for precise and controlled access to target tissues, minimizing invasiveness and improving patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic system for percutaneous intervention comprising an image guidance module.\",\n        \"The robotic system of claim 1, wherein the image guidance module utilizes fluoroscopy.\",\n        \"The robotic system of claim 1, wherein the robotic system is miniaturized for access through small incisions.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68510", "text": "{\n    \"patent_title\": \"Surgical Stapler with Enhanced Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Johnson & Johnson\"\n        },\n        {\n            \"name\": \"Sarah Miller\",\n            \"affiliation\": \"Johnson & Johnson\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-11-15\",\n    \"filing_date\": \"2020-11-15\",\n    \"issue_date\": \"2022-06-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler with enhanced ergonomic features for improved user comfort and control during surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art in surgical staplers\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an ergonomic handle.\",\n        \"The surgical stapler of claim 1, wherein the handle is configured for one-handed operation.\",\n        \"The surgical stapler of claim 1, wherein the stapler is reusable.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68511", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Robotic Assistance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A robotic surgical system enabling minimally invasive procedures with enhanced precision and control. The system utilizes advanced imaging and tactile feedback for improved surgical outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system comprising a robotic arm...\",\n        \"A method for performing a minimally invasive surgical procedure...\",\n        \"A control system for the robotic arm...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68511", "text": "{\n    \"patent_title\": \"Improved Stent Design for Coronary Artery Disease\",\n    \"inventors\": [\n        {\n            \"name\": \"Charles Davis\",\n            \"affiliation\": \"University of Oxford\"\n        }\n    ],\n    \"patent_number\": \"EP3456789B1\",\n    \"priority_date\": \"2020-11-15\",\n    \"filing_date\": \"2020-11-15\",\n    \"issue_date\": \"2022-08-20\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"An improved stent design with enhanced biocompatibility and reduced risk of restenosis. The stent is coated with a drug-eluting polymer for sustained release of therapeutic agents.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A stent comprising a metallic framework...\",\n        \"A coating for a stent comprising a drug-eluting polymer...\",\n        \"A method for treating coronary artery disease using the stent...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68512", "text": "{\n    \"patent_title\": \"Method and System for Accelerated Image Denoising using Optimized Filters\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for accelerating image denoising using a combination of optimized filtering techniques and parallel processing. This invention significantly improves the speed and quality of image denoising, making it suitable for real-time applications. It addresses a key bottleneck in image processing workflows, leading to increased efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on image filtering\"\n        }\n    ],\n    \"claims\": [\n        \"A method for denoising an image comprising...\",\n        \"A system for implementing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68512", "text": "{\n    \"patent_title\": \"Novel Software-Based Image Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corp\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a new software-based image compression algorithm that achieves high compression ratios while maintaining acceptable image quality. The algorithm utilizes complex mathematical transformations and is implemented entirely in software. The focus is on reducing file size for storage and transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related compression techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A software method for compressing an image comprising...\",\n        \"A computer-readable medium storing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68513", "text": "{\n    \"patent_title\": \"Minimally Invasive Cardiac Valve Replacement System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Medtronic\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel system for minimally invasive replacement of cardiac valves, utilizing a transcatheter approach.  The system allows for precise placement and secure anchoring of the valve, reducing complications and recovery time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"count\": 15\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"count\": 22\n        }\n    ],\n    \"claims\": [\n        \"A method for transcatheter cardiac valve replacement.\",\n        \"An apparatus for delivering a cardiac valve.\",\n        \"A cardiac valve with anchoring features.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68513", "text": "{\n    \"patent_title\": \"Surgical Instrument for Open-Heart Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2016-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2018-02-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical instrument for performing open-heart surgery, designed to enhance precision and reduce surgeon fatigue. The instrument incorporates ergonomic features and advanced materials.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"count\": 8\n        },\n        {\n            \"patent_number\": \"US8543210B1\",\n            \"count\": 5\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument with an ergonomic handle.\",\n        \"A blade designed for precise tissue dissection.\",\n        \"A locking mechanism for secure instrument operation.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68514", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Research\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-07-20\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A novel method and system for improving the quality of medical images reconstructed from raw data using deep learning techniques. This invention enhances image clarity and reduces noise, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"count\": 1\n        },\n        {\n            \"patent_number\": \"US1012345678B2\",\n            \"count\": 1\n        },\n        {\n            \"patent_number\": \"US1122334455B2\",\n            \"count\": 1\n        },\n        {\n            \"patent_number\": \"US1211223344B2\",\n            \"count\": 1\n        },\n        {\n            \"patent_number\": \"US1311334455B2\",\n            \"count\": 1\n        },\n        {\n            \"patent_number\": \"US1411445566B2\",\n            \"count\": 1\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"A system comprising a processor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68514", "text": "{\n    \"patent_title\": \"Image Processing for Satellite Imagery\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"NASA\"\n        }\n    ],\n    \"patent_number\": \"EP12345678B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"This invention relates to a method for processing satellite images to enhance features and improve analysis for environmental monitoring.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"count\": 2\n        },\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"count\": 1\n        }\n    ],\n    \"claims\": [\n        \"A method for processing satellite imagery...\",\n        \"A system for analyzing remote sensing data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68515", "text": "{\n    \"patent_title\": \"Non-Invasive Glucose Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive system for continuous glucose monitoring using optical sensors. This device utilizes near-infrared spectroscopy to determine glucose levels through the skin, eliminating the need for blood samples. It's designed for home healthcare and diabetes management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A non-invasive glucose monitoring device comprising an optical sensor.\",\n        \"A method for continuous glucose monitoring without blood sampling.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68515", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical Robot with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-01-15\",\n    \"filing_date\": \"2022-01-15\",\n    \"issue_date\": \"2024-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A robotic system designed for performing minimally invasive surgical procedures with increased accuracy and dexterity. The robot incorporates advanced imaging and control algorithms to enhance surgical outcomes. Utilizes small incisions and camera guidance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic system comprising a minimally invasive surgical instrument.\",\n        \"A method for performing surgical procedures using robotic assistance.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68516", "text": "{\n    \"patent_title\": \"Enhanced Image Recognition Using Attention-Based Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-09-20\",\n    \"issue_date\": \"2021-12-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel image recognition system leveraging attention mechanisms within a convolutional neural network architecture. The proposed system significantly improves accuracy in image classification tasks, particularly in scenarios with noisy or occluded images. Experimental results demonstrate a 15% improvement in top-1 accuracy compared to state-of-the-art methods. The system is applicable to various fields including autonomous driving, medical imaging, and security systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Convolutional Neural Networks for Image Recognition\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"An image recognition system configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68516", "text": "{\n    \"patent_title\": \"Method for Data Compression in Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-11-15\",\n    \"issue_date\": \"2022-03-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel data compression technique for wireless communication networks. The method utilizes a combination of Huffman coding and run-length encoding to achieve high compression ratios while maintaining acceptable data integrity. It is particularly suitable for use in mobile devices and IoT applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Data Compression Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising...\",\n        \"A data compression system configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68517", "text": "{\n    \"patent_title\": \"AI-Enhanced MRI Reconstruction for Improved Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel method for reconstructing MRI images using artificial intelligence techniques to enhance tumor detection accuracy. The method utilizes a deep learning model trained on a large dataset of MRI scans to reduce noise and improve image resolution. This results in clearer visualization of tumors and facilitates earlier and more accurate diagnoses. The invention is implemented within a standard MRI machine using dedicated processing hardware.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"An MRI machine configured to implement the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68517", "text": "{\n    \"patent_title\": \"AI-Powered Medical Data Analysis Platform\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a software platform for analyzing medical data using artificial intelligence. The platform utilizes machine learning algorithms to identify patterns and predict patient outcomes. It provides a user interface for healthcare professionals to access and interpret the data. The system is designed for integration with existing electronic health record systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A software platform for analyzing medical data comprising...\",\n        \"A method for predicting patient outcomes using machine learning...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68518", "text": "{\n    \"patent_title\": \"Enhanced Magnetic Resonance Imaging System with Artificial Intelligence-Powered Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A magnetic resonance imaging (MRI) system incorporating artificial intelligence (AI) algorithms for enhanced image reconstruction. The system improves image clarity and reduces scan time, leading to more accurate diagnoses. The AI component utilizes deep learning to remove noise and artifacts, resulting in higher-resolution images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in MRI image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A magnetic resonance imaging system comprising: an MRI scanner; a processor configured to execute an AI algorithm; and a display for visualizing reconstructed images.\",\n        \"The system of claim 1, wherein the AI algorithm is a deep learning model.\",\n        \"The system of claim 2, wherein the deep learning model is trained to reduce noise and artifacts in MRI images.\",\n        \"A method for improving diagnostic accuracy using the system of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68518", "text": "{\n    \"patent_title\": \"Implantable Cardiac Monitoring Device with Enhanced Signal Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-05-10\",\n    \"filing_date\": \"2022-05-10\",\n    \"issue_date\": \"2024-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable device for continuous cardiac monitoring, utilizing advanced signal processing techniques to detect arrhythmias and other cardiovascular abnormalities. The device transmits data wirelessly to a remote monitoring station.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art in implantable cardiac monitors\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable cardiac monitoring device comprising: a sensor for detecting electrical signals from the heart; a processor for analyzing the signals; and a transmitter for sending data wirelessly.\",\n        \"The device of claim 1, wherein the processor is configured to detect arrhythmias.\",\n        \"The device of claim 2, wherein the arrhythmias include atrial fibrillation and ventricular tachycardia.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68519", "text": "{\n    \"patent_title\": \"Non-Invasive Neuromodulation System for Chronic Pain Relief\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Chen\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2020-06-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive neuromodulation system utilizes targeted electrical stimulation to alleviate chronic pain symptoms. The system includes a wearable device and a personalized treatment algorithm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"High\"\n        },\n        {\n            \"patent_number\": \"US10234567B2\",\n            \"relevance\": \"Medium\"\n        },\n        {\n            \"patent_number\": \"US11111111B1\",\n            \"relevance\": \"High\"\n        },\n        {\n            \"patent_number\": \"US12121212B2\",\n            \"relevance\": \"Medium\"\n        },\n        {\n            \"patent_number\": \"US13131313B1\",\n            \"relevance\": \"High\"\n        },\n        {\n            \"patent_number\": \"US14141414B2\",\n            \"relevance\": \"Medium\"\n        },\n        {\n            \"patent_number\": \"US15151515B1\",\n            \"relevance\": \"High\"\n        },\n        {\n            \"patent_number\": \"US16161616B2\",\n            \"relevance\": \"Medium\"\n        },\n        {\n            \"patent_number\": \"US17171717B1\",\n            \"relevance\": \"High\"\n        },\n        {\n            \"patent_number\": \"US18181818B2\",\n            \"relevance\": \"Medium\"\n        }\n    ],\n    \"claims\": [\n        \"A system for non-invasive neuromodulation...\",\n        \"A method for treating chronic pain...\",\n        \"A wearable device for neuromodulation...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68519", "text": "{\n    \"patent_title\": \"Surgical Robotic Arm with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Miller\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11223344B2\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2021-07-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical robotic arm designed to enhance precision and dexterity during surgical procedures. The arm incorporates advanced sensors and control algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US91234567B1\",\n            \"relevance\": \"High\"\n        },\n        {\n            \"patent_number\": \"US10456789B2\",\n            \"relevance\": \"Medium\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic arm...\",\n        \"A control system for robotic surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68520", "text": "{\n    \"patent_title\": \"Method and System for Low-Dose CT Image Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology, Department of Electrical Engineering and Computer Science\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School, Department of Radiology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for reconstructing high-quality CT images from low-dose CT data using a deep learning-based image reconstruction algorithm. This significantly reduces patient radiation exposure while maintaining diagnostic image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8786789B1\",\n            \"relevance\": \"Prior art in iterative reconstruction algorithms\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related work on noise reduction in medical images\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a CT image comprising...\",\n        \"A system for performing CT image reconstruction...\",\n        \"The method of claim 1, wherein the deep learning model is a convolutional neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68520", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for MRI Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Acme Pharmaceuticals Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11112222B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel contrast agent for use in magnetic resonance imaging (MRI) that enhances image clarity and reduces scan time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art related to gadolinium-based contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent composition comprising...\",\n        \"A method for enhancing MRI images using the contrast agent of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68521", "text": "{\n    \"patent_title\": \"Ultrasound Image Enhancement Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-10-26\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A system and method for enhancing ultrasound images using deep learning algorithms to improve diagnostic accuracy. The method addresses the challenges of low contrast and noise in ultrasound imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing ultrasound images comprising...\",\n        \"A system for processing ultrasound data...\",\n        \"A non-transitory computer-readable medium...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68521", "text": "{\n    \"patent_title\": \"Improved X-ray Image Reconstruction Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"GE Healthcare\"\n        },\n        {\n            \"name\": \"Emily Wilson\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"EP11223344B1\",\n    \"priority_date\": \"2020-05-20\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-01-12\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"This invention provides a novel technique for reconstructing X-ray images with improved resolution and reduced artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing X-ray images...\",\n        \"An apparatus for processing X-ray data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68522", "text": "{\n    \"patent_title\": \"Enhanced Battery Management System for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"TechCorp Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"TechCorp Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2022-12-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system that dynamically adjusts power consumption based on user activity and device context, significantly extending battery life in mobile devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on battery monitoring techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for dynamically adjusting power consumption in a mobile device...\",\n        \"A battery management system comprising a processor and memory...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68522", "text": "{\n    \"patent_title\": \"Novel Electrolyte Material for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-05-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new electrolyte material that improves the energy density and cycle life of lithium-ion batteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art on electrolyte compositions\"\n        }\n    ],\n    \"claims\": [\n        \"An electrolyte composition comprising...\",\n        \"A lithium-ion battery utilizing the electrolyte composition...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68523", "text": "{\n    \"patent_title\": \"AI-Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention utilizes artificial intelligence techniques, specifically deep learning, to improve the quality and speed of medical image reconstruction from limited data. This leads to lower radiation doses for patients and faster diagnostic times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in image reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"The method of claim 1, wherein the reconstruction utilizes a convolutional neural network...\",\n        \"...\",\n        \"A system for performing the method of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68523", "text": "{\n    \"patent_title\": \"Improved X-ray Tube Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2018-11-01\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a new design for X-ray tubes, improving their efficiency and lifespan. It focuses on materials science and engineering aspects of the tube construction.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related X-ray tube technology\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube comprising a...\",\n        \"...\",\n        \"A method for manufacturing an X-ray tube...\",\n        \"...\",\n        \"A system incorporating the X-ray tube of claim 1.\",\n        \"...\",\n        \"Another claim\",\n        \"...\",\n        \"Another claim\",\n        \"...\",\n        \"Another claim\",\n        \"...\",\n        \"Another claim\",\n        \"...\",\n        \"Another claim\",\n        \"...\",\n        \"Another claim\",\n        \"...\",\n        \"Another claim\",\n        \"...\",\n        \"Another claim\",\n        \"...\",\n        \"Another claim\"\n    ]\n}"}
{"_id": "Academic--patents--p--68524", "text": "{\n    \"patent_title\": \"Low-Dose Computed Tomography with Advanced Iterative Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for reducing radiation dose in computed tomography (CT) imaging using advanced iterative reconstruction algorithms. The system optimizes image quality while minimizing patient exposure to ionizing radiation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8786623B2\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for performing computed tomography...\",\n        \"2. The method of claim 1, wherein the radiation dose is reduced by at least 30%...\",\n        \"3. A system for performing computed tomography...\",\n        \"4. The system of claim 3, comprising...\",\n        \"5. ...\",\n        \"6. ...\",\n        \"7. ...\",\n        \"8. ...\",\n        \"9. ...\",\n        \"10. ...\",\n        \"11. ...\",\n        \"12. ...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68524", "text": "{\n    \"patent_title\": \"Pediatric X-Ray Imaging System with Automated Dose Adjustment\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of Michigan\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"University of Michigan\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An X-ray imaging system specifically designed for pediatric patients, featuring automated dose adjustment algorithms to minimize radiation exposure while maintaining diagnostic image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"1. An X-ray imaging system for pediatric patients...\",\n        \"2. The system of claim 1, comprising...\",\n        \"3. A method for adjusting the radiation dose...\",\n        \"4. ...\",\n        \"5. ...\",\n        \"6. ...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68525", "text": "{\n    \"patent_title\": \"Method and System for Enhanced MRI Image Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for enhancing the resolution of MRI images using a deep learning-based reconstruction algorithm. The method significantly reduces noise and artifacts while minimizing radiation exposure to the patient.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for processing MRI data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68525", "text": "{\n    \"patent_title\": \"Improved X-ray Imaging System with Enhanced Contrast\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of Michigan\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-01-20\",\n    \"filing_date\": \"2020-01-20\",\n    \"issue_date\": \"2023-05-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved X-ray imaging system that provides enhanced contrast and image clarity. The system utilizes a novel filtration technique to reduce scatter radiation and improve image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A method for filtering X-ray radiation...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68526", "text": "{\n    \"patent_title\": \"Remote Patient Monitoring System with Miniaturized Sensor\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-08-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel remote patient monitoring system incorporating a miniaturized, implantable sensor for continuous physiological data collection. The system enables minimally invasive diagnostics and allows for proactive intervention based on real-time data analysis, ultimately improving patient outcomes and reducing hospital readmissions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A remote patient monitoring system comprising an implantable sensor...\",\n        \"A method for real-time physiological data analysis...\",\n        \"A system for proactive intervention based on sensor data...\",\n        \"An implantable sensor with a diameter less than 5mm...\",\n        \"A communication module for transmitting data wirelessly...\",\n        \"A data processing unit for analyzing physiological signals...\",\n        \"A user interface for displaying patient data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68526", "text": "{\n    \"patent_title\": \"Diagnostic Imaging Apparatus\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Johnson\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new diagnostic imaging apparatus utilizing advanced X-ray technology for enhanced image clarity.  The system allows for precise visualization of internal structures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A diagnostic imaging apparatus comprising an X-ray source...\",\n        \"An image processing unit for enhancing image clarity...\",\n        \"A detector for capturing X-ray images...\",\n        \"A control system for adjusting imaging parameters...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68527", "text": "{\n    \"patent_title\": \"AI-Powered Medical Image Analysis System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel AI-powered system for analyzing medical images, specifically X-rays and MRIs, to detect anomalies indicative of various diseases. The system utilizes deep learning algorithms to identify subtle patterns often missed by human radiologists, thereby improving diagnostic accuracy and reducing false positives. The system is designed for use in a wide range of clinical settings and has demonstrated promising results in early cancer detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for analyzing medical images using deep learning.\",\n        \"A system for detecting anomalies in medical images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68527", "text": "{\n    \"patent_title\": \"Image Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-12-01\",\n    \"filing_date\": \"2017-12-01\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new algorithm for compressing digital images. The algorithm achieves high compression ratios with minimal loss of image quality. It is suitable for various applications, including digital photography and video streaming.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US4000000\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing digital images.\",\n        \"An image compression algorithm.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68528", "text": "{\n    \"patent_title\": \"Novel Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable biosensor for continuous glucose monitoring utilizing a novel enzymatic reaction and a miniaturized wireless communication module. The device demonstrates improved accuracy and reduced invasiveness compared to existing glucose monitoring systems, leading to better patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art glucose monitoring device\"\n        }\n    ],\n    \"claims\": [\n        \"A biosensor for continuous glucose monitoring comprising...\",\n        \"A wireless communication module for transmitting glucose data...\",\n        \"A method for monitoring glucose levels using the biosensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68528", "text": "{\n    \"patent_title\": \"Improved Surgical Scalpel with Vibration Damping\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-06-01\",\n    \"filing_date\": \"2021-08-15\",\n    \"issue_date\": \"2024-02-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical scalpel incorporating vibration damping technology to enhance precision and reduce surgeon fatigue during complex procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10112233B1\",\n            \"relevance\": \"Existing surgical scalpel design\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical scalpel comprising a blade and a vibration damping mechanism...\",\n        \"A method of surgical incision using the scalpel...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68529", "text": "{\n    \"patent_title\": \"Enhanced Image Reconstruction for Improved Cancer Detection in MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel image reconstruction algorithm for Magnetic Resonance Imaging (MRI) that significantly improves the detection of cancerous tissues by reducing noise and enhancing contrast. The method utilizes deep learning techniques to optimize image quality and reduce scan time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for processing MRI data...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68529", "text": "{\n    \"patent_title\": \"MRI System with Advanced Gradient Coils\",\n    \"inventors\": [\n        {\n            \"name\": \"Karl Schmidt\",\n            \"affiliation\": \"Siemens Healthineers\"\n        },\n        {\n            \"name\": \"Anna Weber\",\n            \"affiliation\": \"Siemens AG\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-08-22\",\n    \"filing_date\": \"2017-08-22\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An MRI system incorporating improved gradient coils for faster scanning and higher resolution imaging. The system includes advanced shielding techniques to minimize artifacts and enhance image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI system comprising a gradient coil...\",\n        \"A method for operating an MRI system...\",\n        \"A control system for adjusting gradient parameters...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68530", "text": "{\n    \"patent_title\": \"Adaptive Histogram Equalization for Medical Image Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2014-02-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel adaptive histogram equalization technique for enhancing the contrast and visibility of medical images, leading to improved diagnostic accuracy. The method dynamically adjusts the histogram based on local image characteristics, preserving important details.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing a medical image comprising...\",\n        \"A system for processing medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68530", "text": "{\n    \"patent_title\": \"Camera Image Stabilization for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"TechCorp Inc.\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2012-08-10\",\n    \"filing_date\": \"2012-08-10\",\n    \"issue_date\": \"2015-11-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method for stabilizing images captured by mobile phone cameras, reducing blur due to hand movement. The system utilizes a gyroscope and accelerometer to detect and compensate for motion.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US81234567B2\"\n        }\n    ],\n    \"claims\": [\n        \"A mobile device comprising...\",\n        \"A method for stabilizing an image captured by a mobile device...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68531", "text": "{\n    \"patent_title\": \"Enhanced MRI Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel deep learning approach to significantly accelerate MRI image reconstruction while maintaining high image quality.  The method dramatically reduces scan times and improves diagnostic accuracy, representing a groundbreaking advance in medical imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Previous MRI Reconstruction Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images using a deep convolutional neural network.\",\n        \"A system for performing rapid MRI scans.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68531", "text": "{\n    \"patent_title\": \"Improved X-Ray Tube Design for Enhanced Image Clarity\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Philips Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2018-11-01\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved X-ray tube design that increases image clarity and reduces radiation exposure. The design involves a novel filament arrangement and cooling system, leading to a more efficient X-ray source.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Conventional X-ray Tube\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube with a modified filament geometry.\",\n        \"A cooling system for an X-ray tube.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68532", "text": "{\n    \"patent_title\": \"Enhanced X-ray Image Reconstruction Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel algorithm for reconstructing X-ray images, significantly reducing noise and improving overall image clarity. The algorithm uses advanced filtering techniques and iterative reconstruction methods to produce high-quality images from low-dose radiation exposure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image filtering\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an X-ray image comprising...\",\n        \"An apparatus for implementing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68532", "text": "{\n    \"patent_title\": \"Method for Early Cancer Detection Using MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-07-20\",\n    \"filing_date\": \"2017-07-20\",\n    \"issue_date\": \"2020-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel MRI technique for the early detection of cancerous tumors. The method utilizes contrast agents and advanced image processing to identify subtle changes indicative of malignancy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art in MRI contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancer using MRI comprising...\",\n        \"An MRI apparatus configured for cancer detection...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68533", "text": "{\n    \"patent_title\": \"Deep Learning Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A novel method for medical image reconstruction utilizing deep learning techniques to improve image quality and diagnostic accuracy. The system incorporates convolutional neural networks to reduce noise and enhance resolution, leading to better detection of subtle anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image denoising\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for enhancing medical image quality...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68533", "text": "{\n    \"patent_title\": \"Improved X-Ray Tube Design for Mammography\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"EP2345678B1\",\n    \"priority_date\": \"2014-12-10\",\n    \"filing_date\": \"2014-12-10\",\n    \"issue_date\": \"2017-05-10\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"An improved X-ray tube design for mammography that reduces radiation exposure while maintaining image quality.  The invention focuses on optimizing the anode material and cooling system to increase efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous work on X-ray tube materials\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube for mammography comprising...\",\n        \"A cooling system for an X-ray tube...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68534", "text": "{\n    \"patent_title\": \"Novel MRI Contrast Agent for Early Stage Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel MRI contrast agent that enhances the visualization of early-stage tumors, improving diagnostic accuracy and enabling earlier treatment intervention. The agent utilizes a targeted nanoparticle delivery system to specifically accumulate within cancerous tissues. Clinical trials demonstrate significantly improved detection rates compared to conventional contrast agents.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in nanoparticle delivery systems.\"\n        }\n    ],\n    \"claims\": [\n        \"A composition comprising a nanoparticle, a targeting ligand, and a MRI contrast agent.\",\n        \"A method of detecting cancer using the composition of claim 1.\",\n        \"The method of claim 2, wherein the cancer is early-stage breast cancer.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68534", "text": "{\n    \"patent_title\": \"Improved X-Ray Image Processing Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2023-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new image processing algorithm for X-ray images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related to image enhancement techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing X-ray images comprising applying a filtering algorithm.\",\n        \"An X-ray imaging system utilizing the method of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68535", "text": "{\n    \"patent_title\": \"Adaptive Beamforming for Millimeter Wave 5G Systems\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Qualcomm\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for adaptive beamforming in millimeter wave 5G systems to improve signal quality and network capacity. The system dynamically adjusts beam patterns based on real-time channel conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for adaptive beamforming comprising...\",\n        \"A system for wireless communication...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68535", "text": "{\n    \"patent_title\": \"Cell Tower Antenna Optimization Techniques\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Ericsson\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2022-07-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"Techniques for optimizing antenna placement and configuration in cellular base stations to enhance coverage and reduce interference. This invention focuses on improving the performance of cellular infrastructure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for cellular antenna optimization comprising...\",\n        \"A cellular base station...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68536", "text": "{\n    \"patent_title\": \"Ultrasound Image Enhancement for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method for enhancing ultrasound images to improve the detection of early-stage cancerous tumors. The method utilizes a novel signal processing algorithm to reduce noise and increase contrast.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Improved Ultrasound Transducer Design\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing ultrasound images comprising...\",\n        \"A system for detecting cancerous tumors using enhanced ultrasound images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68536", "text": "{\n    \"patent_title\": \"Improved X-ray Imaging System with Reduced Radiation Dose\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Wilson\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-01-10\",\n    \"filing_date\": \"2017-01-10\",\n    \"issue_date\": \"2020-09-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved X-ray imaging system that reduces radiation exposure while maintaining image quality. The system incorporates a novel filter design and image processing techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Digital X-ray Image Processing\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A method for reducing radiation dose in X-ray imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68537", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable pressure sensor system for continuous monitoring of intracranial pressure. The system utilizes a novel MEMS fabrication process and wireless communication protocol, offering improved accuracy and reduced invasiveness compared to existing methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"relevance\": \"Prior art in implantable pressure sensors.\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable pressure sensor system...\",\n        \"A method for continuous intracranial pressure monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68537", "text": "{\n    \"patent_title\": \"Novel Chemical Compound for Agricultural Use\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"AgriCorp Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new chemical compound exhibiting enhanced pesticidal properties. The compound demonstrates broad-spectrum activity against common agricultural pests with reduced environmental impact.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Previous generation pesticide compounds.\"\n        }\n    ],\n    \"claims\": [\n        \"A chemical compound with the formula...\",\n        \"A pesticidal composition comprising the compound...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68538", "text": "{\n    \"patent_title\": \"Improved Image Classification Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-06-15\",\n    \"issue_date\": \"2021-11-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel architecture for deep convolutional neural networks that improves image classification accuracy by incorporating attention mechanisms and residual connections. The proposed method achieves state-of-the-art results on benchmark datasets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image classification comprising...\",\n        \"A system for image classification...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68538", "text": "{\n    \"patent_title\": \"Medical Image Analysis using Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"University of California, San Francisco\"\n        },\n        {\n            \"name\": \"Eve Wilson\",\n            \"affiliation\": \"Johns Hopkins University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2018-12-01\",\n    \"filing_date\": \"2019-01-15\",\n    \"issue_date\": \"2020-07-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a system for analyzing medical images, such as X-rays and MRIs, using convolutional neural networks to detect anomalies and assist in diagnosis. The system is designed to improve the accuracy and efficiency of medical image interpretation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for medical image analysis comprising...\",\n        \"A system for medical image analysis...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68539", "text": "{\n    \"patent_title\": \"Low-Dose Computed Tomography Imaging System and Method\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel computed tomography (CT) imaging system and method capable of significantly reducing patient radiation dose while maintaining diagnostic image quality. The system employs iterative reconstruction algorithms and advanced detector technology to achieve low-dose imaging. The key lies in intelligent image processing to minimize artifacts while preserving details.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"relevance\": \"Prior art in CT image reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A computed tomography system comprising...\",\n        \"A method for reducing radiation dose in CT imaging...\",\n        \"A non-transitory computer-readable medium storing instructions for...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68539", "text": "{\n    \"patent_title\": \"Magnetic Resonance Imaging Coil Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-15\",\n    \"issue_date\": \"2020-03-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved magnetic resonance imaging (MRI) coil design is presented, enhancing signal-to-noise ratio and image resolution. The design incorporates a novel arrangement of coil elements and optimized radiofrequency shielding.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Previous MRI coil designs\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil comprising...\",\n        \"A method for enhancing MRI signal...\",\n        \"A system for improved MRI imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68540", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Sensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2022-05-15\",\n    \"filing_date\": \"2022-06-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable sensor for continuous glucose monitoring, providing real-time data transmission to a mobile device for improved diabetes management and patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized glucose sensor...\",\n        \"A system for continuous glucose monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68540", "text": "{\n    \"patent_title\": \"Large-Scale Automated Drug Delivery System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charles Davis\",\n            \"affiliation\": \"Global Pharma Inc.\"\n        },\n        {\n            \"name\": \"Emily Garcia\",\n            \"affiliation\": \"Global Pharma Inc.\"\n        },\n        {\n            \"name\": \"Frank Rodriguez\",\n            \"affiliation\": \"Global Pharma Inc.\"\n        },\n        {\n            \"name\": \"Grace Wilson\",\n            \"affiliation\": \"Global Pharma Inc.\"\n        },\n        {\n            \"name\": \"Henry Martinez\",\n            \"affiliation\": \"Global Pharma Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2021-11-01\",\n    \"filing_date\": \"2022-01-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated drug delivery system designed for large-scale hospital applications, improving efficiency and reducing human error in medication administration.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\"\n        },\n        {\n            \"patent_number\": \"US65432109B1\"\n        }\n    ],\n    \"claims\": [\n        \"An automated drug delivery system...\",\n        \"A method for administering medication...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68541", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Detection of Biomarkers in Sepsis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device is disclosed for the rapid and sensitive detection of biomarkers associated with sepsis. The device integrates sample preparation, amplification, and detection into a single platform, enabling point-of-care diagnostics and improved patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related technology in microfluidics\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for detecting sepsis biomarkers...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68541", "text": "{\n    \"patent_title\": \"Novel Chemical Compound for Treating Inflammation\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"PharmaCorp Inc.\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2021-01-25\",\n    \"filing_date\": \"2021-03-01\",\n    \"issue_date\": \"2023-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel chemical compound is disclosed that exhibits potent anti-inflammatory properties. The compound is suitable for treating a variety of inflammatory conditions. The molecule is a small molecule inhibitor.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous work on anti-inflammatory drugs\"\n        }\n    ],\n    \"claims\": [\n        \"A chemical compound having the formula...\",\n        \"A pharmaceutical composition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68542", "text": "{\n    \"patent_title\": \"Deep Learning Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for medical image reconstruction utilizing deep learning algorithms to significantly enhance image quality and diagnostic accuracy. The system employs convolutional neural networks trained on a large dataset of medical images to reduce noise and improve resolution, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"kind\": \"Cited by Applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for enhancing diagnostic accuracy...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68542", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-12-01\",\n    \"filing_date\": \"2020-04-10\",\n    \"issue_date\": \"2021-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new contrast agent for magnetic resonance imaging (MRI) that improves image contrast and visibility of anatomical structures. The contrast agent comprises a gadolinium complex with modified ligands for enhanced tissue specificity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US4560234\",\n            \"kind\": \"Cited by Examiner\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"Cited by Applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent for MRI comprising...\",\n        \"A method for enhancing MRI image contrast...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68543", "text": "{\n    \"patent_title\": \"Microfluidic Device for Single-Cell Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-01-20\",\n    \"issue_date\": \"2021-07-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for isolating and analyzing individual cells, enabling high-throughput single-cell genomics and proteomics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for isolating single cells...\",\n        \"A system for analyzing cellular components...\",\n        \"A device for performing real-time PCR...\",\n        \"A method for detecting biomarkers...\",\n        \"A microfluidic channel for cell separation...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68543", "text": "{\n    \"patent_title\": \"Implantable Cardiac Pacemaker with Improved Battery Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2020-12-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac pacemaker with a novel battery management system that extends battery life by 20%.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable pacemaker comprising...\",\n        \"A battery management system...\",\n        \"A method for regulating power consumption...\",\n        \"A circuit for optimizing battery performance...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68544", "text": "{\n    \"patent_title\": \"Method and System for Enhanced MRI Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel method and system for reconstructing Magnetic Resonance Images (MRI) with significantly improved resolution and reduced noise. The technique employs a deep learning algorithm trained on a large dataset of MRI scans to enhance image clarity and diagnostic accuracy. The improved resolution allows for the detection of subtle anomalies that were previously invisible, leading to earlier and more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"A system for performing MRI reconstruction...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68544", "text": "{\n    \"patent_title\": \"Improved X-ray Imaging System with Digital Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2020-06-01\",\n    \"filing_date\": \"2020-06-01\",\n    \"issue_date\": \"2022-12-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved X-ray imaging system with digital image processing techniques to enhance contrast and reduce radiation exposure. The system utilizes a novel detector array and image enhancement algorithms to provide clearer X-ray images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related X-ray technology\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A detector array for capturing X-ray images...\",\n        \"A method for enhancing contrast in X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68545", "text": "{\n    \"patent_title\": \"Method and System for Enhanced MRI Image Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-09-20\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for reconstructing high-quality MRI images using deep learning algorithms. The invention significantly reduces scan time and improves image clarity, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"A system for performing MRI image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68545", "text": "{\n    \"patent_title\": \"Digital Radiography System with Enhanced Contrast\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Philips Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2021-02-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved digital radiography system providing enhanced image contrast through optimized X-ray emission and detection techniques. This system facilitates more accurate detection of subtle fractures and anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous work in digital radiography\"\n        }\n    ],\n    \"claims\": [\n        \"A digital radiography system comprising...\",\n        \"A method for enhancing contrast in a radiographic image...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68546", "text": "{\n    \"patent_title\": \"Method for Noise Reduction in Low-Dose CT Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reducing noise in computed tomography (CT) images acquired with low radiation dose. The method utilizes a deep learning algorithm to enhance image quality while minimizing patient exposure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"cited_by\": \"This patent is cited in 15 subsequent publications.\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"cited_by\": \"This patent is cited in 22 subsequent publications.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing noise in a CT image...\",\n        \"A system for implementing the noise reduction method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68546", "text": "{\n    \"patent_title\": \"Improved Dental X-Ray Film\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"3M Corporation\"\n        }\n    ],\n    \"patent_number\": \"US7654321B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2018-11-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new type of dental X-ray film with enhanced resolution and sensitivity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B2\",\n            \"cited_by\": \"This patent is cited in 2 subsequent publications.\"\n        }\n    ],\n    \"claims\": [\n        \"A dental X-ray film comprising...\",\n        \"A method for manufacturing the dental X-ray film...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68547", "text": "{\n    \"patent_title\": \"AI-Powered Diagnostic System for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-06-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a machine learning system for analyzing medical images to detect early signs of cancer, improving diagnostic accuracy and patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A method for diagnosing cancer using machine learning.\",\n        \"A system comprising a machine learning model and a medical imaging device.\",\n        \"The method of claim 1, wherein the machine learning model is a convolutional neural network.\",\n        \"The system of claim 2, wherein the medical imaging device is an MRI scanner.\",\n        \"The method of claim 1, further comprising generating a diagnostic report.\",\n        \"The system of claim 2, further comprising a user interface for displaying diagnostic results.\",\n        \"The method of claim 1, wherein the cancer is lung cancer.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68547", "text": "{\n    \"patent_title\": \"Method for Automated Patient Scheduling\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Healthcare Solutions Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2022-01-10\",\n    \"filing_date\": \"2022-01-10\",\n    \"issue_date\": \"2023-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system for automating patient appointment scheduling, reducing administrative overhead and improving patient satisfaction.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A system for scheduling patient appointments.\",\n        \"The system of claim 1, comprising a user interface.\",\n        \"A method for optimizing appointment schedules.\",\n        \"The method of claim 3, comprising a machine learning algorithm.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68548", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical system designed for minimally invasive procedures, utilizing advanced imaging and robotic assistance to improve precision and reduce patient recovery time. This system offers a significant advancement over existing laparoscopic techniques, potentially reducing complications and enhancing patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in laparoscopic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising a robotic arm...\",\n        \"A method for performing a minimally invasive procedure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68548", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Cardiovascular Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MedTech Innovations Inc.\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"MedTech Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-06-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new catheter design featuring improved flexibility and reduced friction for navigating complex cardiovascular anatomy. The design allows for more efficient delivery of therapeutic agents and diagnostic tools. It's a refinement of existing catheter technology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Previous catheter designs\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter with a reduced friction coating...\",\n        \"A method for navigating cardiovascular vessels...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68549", "text": "{\n    \"patent_title\": \"Implantable Bioelectronic System for Chronic Pain Management\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US16283745B2\",\n    \"priority_date\": \"2014-07-15\",\n    \"filing_date\": \"2015-03-20\",\n    \"issue_date\": \"2017-09-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a fully implantable, wirelessly powered bioelectronic system for the long-term management of chronic pain. The system utilizes a novel neural interface and advanced signal processing algorithms to selectively modulate pain signals, offering a non-opioid alternative for patients suffering from intractable pain conditions. The device incorporates biofeedback mechanisms to adapt to individual patient needs and maximize therapeutic efficacy. Extensive preclinical studies have demonstrated significant pain reduction and improved quality of life in animal models.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8520867B2\",\n            \"relevance\": \"Similar neural stimulation approach\"\n        }\n    ],\n    \"claims\": [\n        \"A fully implantable bioelectronic system for modulating neural signals.\",\n        \"A wireless power transfer system for powering the implantable device.\",\n        \"A method for treating chronic pain using targeted neural stimulation.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68549", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Medical Devices\"\n        }\n    ],\n    \"patent_number\": \"US15987654B1\",\n    \"priority_date\": \"2014-11-01\",\n    \"filing_date\": \"2015-05-10\",\n    \"issue_date\": \"2016-12-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler designed for enhanced user comfort and precision during laparoscopic procedures. The stapler features a redesigned handle and a more robust stapling mechanism.  Minor improvements in the staple cartridge design have been implemented to reduce tissue damage. The device is suitable for a variety of surgical applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"relevance\": \"Prior art stapler designs\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler with an ergonomic handle.\",\n        \"A staple cartridge with reduced tissue compression.\",\n        \"A laparoscopic surgical instrument.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68550", "text": "{\n    \"patent_title\": \"High-Performance Solid-State Lithium-Ion Battery with Enhanced Energy Density\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11254321B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-12-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel solid-state lithium-ion battery with a three-dimensional architecture designed to significantly enhance energy density and charging speed. The use of a ceramic electrolyte enables improved safety and stability while maintaining high performance. The battery demonstrates a 50% increase in energy density compared to conventional lithium-ion batteries and a charging time reduced by 40%.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A solid-state lithium-ion battery comprising a three-dimensional ceramic electrolyte structure.\",\n        \"The battery of claim 1, wherein the energy density is at least 500 Wh/kg.\",\n        \"The battery of claim 1, wherein the charging time is less than 30 minutes.\",\n        \"A method for manufacturing the solid-state lithium-ion battery of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68550", "text": "{\n    \"patent_title\": \"Improved Polymer Electrolyte for Lithium Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"General Motors Research\"\n        }\n    ],\n    \"patent_number\": \"US11567890B2\",\n    \"priority_date\": \"2020-08-22\",\n    \"filing_date\": \"2020-08-22\",\n    \"issue_date\": \"2022-05-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention focuses on a novel polymer electrolyte composition for lithium batteries. The electrolyte improves ionic conductivity at room temperature, leading to enhanced performance in low-temperature environments. The material is cost-effective and readily scalable for mass production.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A polymer electrolyte composition comprising a lithium salt and a novel polymer matrix.\",\n        \"The composition of claim 1, wherein the ionic conductivity is greater than 1 mS/cm at 25°C.\",\n        \"A lithium battery utilizing the polymer electrolyte composition of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68551", "text": "{\n    \"patent_title\": \"Contrast-Enhanced Photoacoustic Imaging for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel photoacoustic imaging system utilizing targeted nanoparticles for enhanced contrast in tumor detection. The system offers improved sensitivity and resolution compared to conventional imaging techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in photoacoustic imaging.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing contrast in photoacoustic imaging using targeted nanoparticles.\",\n        \"An imaging system comprising a photoacoustic transducer and a nanoparticle delivery mechanism.\",\n        \"A method for early cancer detection using the imaging system.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68551", "text": "{\n    \"patent_title\": \"MRI Pulse Sequence for Brain Tumor Localization\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. John Smith\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2015-11-20\",\n    \"filing_date\": \"2015-11-20\",\n    \"issue_date\": \"2018-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new MRI pulse sequence designed to improve the localization of brain tumors. This method provides clearer images for diagnostic purposes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Existing MRI pulse sequence techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI pulse sequence for brain tumor localization.\",\n        \"A method for obtaining high-resolution images of brain tumors.\",\n        \"A diagnostic system utilizing the MRI pulse sequence.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68552", "text": "{\n    \"patent_title\": \"Novel Microfluidic Device for Rapid Pathogen Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel microfluidic device for rapid and accurate detection of infectious pathogens in biological samples. The device utilizes a unique surface chemistry for enhanced binding and detection sensitivity, leading to faster diagnostic results.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Microfluidic Device for Nucleic Acid Amplification\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising a substrate with microchannels...\",\n        \"A method for detecting a pathogen using the microfluidic device...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68552", "text": "{\n    \"patent_title\": \"Improved Cardiac Pacemaker with Adaptive Stimulation\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-01-10\",\n    \"filing_date\": \"2022-01-10\",\n    \"issue_date\": \"2024-02-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved cardiac pacemaker system with adaptive stimulation parameters based on real-time physiological feedback. The system improves energy efficiency and patient comfort.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Cardiac Pacemaker with Rate-Responsive Function\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiac pacemaker comprising a pulse generator...\",\n        \"A method for adaptively stimulating the heart using the pacemaker...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68553", "text": "{\n    \"patent_title\": \"Magnetic Resonance Imaging System with Enhanced Signal Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A magnetic resonance imaging (MRI) system incorporating novel signal processing techniques to improve image clarity and reduce scan time, particularly useful for diagnosing neurological conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"relevance\": \"Related prior art on MRI signal acquisition.\"\n        }\n    ],\n    \"claims\": [\n        \"A magnetic resonance imaging system comprising...\",\n        \"A method for processing MRI signals...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68553", "text": "{\n    \"patent_title\": \"Software for Automated Brain Tumor Segmentation\",\n    \"inventors\": [\n        {\n            \"name\": \"Karl Schmidt\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A software application designed for automated segmentation of brain tumors in medical images. The software utilizes deep learning algorithms for accurate and efficient tumor delineation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art on MRI image analysis.\"\n        }\n    ],\n    \"claims\": [\n        \"A computer-implemented method for segmenting brain tumors...\",\n        \"A software application comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68554", "text": "{\n    \"patent_title\": \"Extended Battery Life System and Method for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Apple Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Apple Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-12-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for extending battery life in mobile devices by dynamically adjusting power consumption based on user activity and predicted usage patterns. The invention incorporates advanced power management algorithms and hardware optimizations to reduce energy waste and improve overall battery performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Lithium-Ion Battery Management System\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Power Saving Techniques for Mobile Devices\"\n        }\n    ],\n    \"claims\": [\n        \"A mobile device comprising a processor, a battery, and a power management module configured to dynamically adjust power consumption.\",\n        \"A method for extending battery life in a mobile device comprising monitoring user activity and adjusting power consumption accordingly.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68554", "text": "{\n    \"patent_title\": \"Improved Charging Circuit for Portable Electronic Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"SmallTech Solutions\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-05-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved charging circuit for portable electronic devices, featuring faster charging speeds and reduced heat dissipation. This circuit is applicable to a wide range of devices, including smartphones, tablets, and laptops.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"High-Efficiency Charging Circuit\"\n        }\n    ],\n    \"claims\": [\n        \"A charging circuit comprising a voltage regulator and a current limiter.\",\n        \"A method for charging a portable electronic device at a faster rate.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68555", "text": "{\n    \"patent_title\": \"AI-Powered Medical Image Diagnosis System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2022-05-15\",\n    \"filing_date\": \"2020-06-20\",\n    \"issue_date\": \"2023-01-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for diagnosing medical conditions using artificial intelligence, specifically focusing on the analysis of medical images such as X-rays, MRIs, and CT scans.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"count\": 12\n        },\n        {\n            \"patent_number\": \"US1012345678B2\",\n            \"count\": 8\n        }\n    ],\n    \"claims\": [\n        \"A method for diagnosing a medical condition using a convolutional neural network.\",\n        \"A system for analyzing medical images to identify anomalies.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68555", "text": "{\n    \"patent_title\": \"Improved Image Compression for Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Li Wei\",\n            \"affiliation\": \"Huawei Technologies\"\n        },\n        {\n            \"name\": \"Zhang Ming\",\n            \"affiliation\": \"Tsinghua University\"\n        }\n    ],\n    \"patent_number\": \"CN101234567B\",\n    \"priority_date\": \"2021-11-01\",\n    \"filing_date\": \"2022-01-10\",\n    \"issue_date\": \"2023-03-10\",\n    \"patent_office\": \"SIPO\",\n    \"abstract\": \"This invention discloses a novel image compression algorithm tailored for medical imaging data, improving storage efficiency and transmission speeds.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B1\",\n            \"count\": 5\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing medical images using wavelet transform.\",\n        \"A system for reducing the file size of medical images.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68556", "text": "{\n    \"patent_title\": \"AI-Enhanced MRI Reconstruction for Improved Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"EP3854921B1\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2021-08-04\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"This invention utilizes artificial intelligence and machine learning algorithms to enhance the reconstruction of MRI images, leading to improved detection accuracy of cancerous tissues. The AI model is trained on a large dataset of MRI scans and optimizes image quality while reducing scan time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"MRI Image Enhancement Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images using an AI-based algorithm.\",\n        \"A system for improving cancer detection utilizing enhanced MRI imagery.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68556", "text": "{\n    \"patent_title\": \"Improved X-Ray Image Processing System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-11-20\",\n    \"filing_date\": \"2019-11-20\",\n    \"issue_date\": \"2022-01-18\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"This invention provides an improved system for processing X-ray images, resulting in higher resolution and better contrast. The system utilizes advanced filtering techniques to reduce noise and enhance image clarity, assisting in the diagnosis of various medical conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Digital X-Ray Image Enhancement\"\n        }\n    ],\n    \"claims\": [\n        \"A system for processing X-ray images with enhanced resolution.\",\n        \"A method for reducing noise in X-ray images.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68557", "text": "{\n    \"patent_title\": \"Solid-State Electrolyte for Enhanced Battery Performance and Safety\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2023-11-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel solid-state electrolyte material with high ionic conductivity and improved thermal stability, leading to safer and more efficient batteries. The material utilizes abundant and earth-friendly elements, promoting sustainable energy storage solutions. This technology enhances energy density and cycle life, contributing to a reduction in the environmental impact of battery production and disposal.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"High\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Medium\"\n        },\n        {\n            \"patent_number\": \"US11000000B2\",\n            \"relevance\": \"High\"\n        }\n    ],\n    \"claims\": [\n        \"A solid-state electrolyte composition comprising...\",\n        \"A battery cell incorporating the solid-state electrolyte...\",\n        \"A method for manufacturing a battery cell using the solid-state electrolyte...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68557", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Improved Charging Rate\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11345678B2\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2024-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a modified lithium-ion battery architecture that allows for significantly faster charging rates. The improvements are achieved through a novel electrolyte additive and electrode material combination utilizing lithium salts. This improves the power density for electric vehicles and other applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9765432B2\",\n            \"relevance\": \"Medium\"\n        },\n        {\n            \"patent_number\": \"US10234567B2\",\n            \"relevance\": \"Low\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery cell comprising...\",\n        \"An electrolyte additive for improving charging rate...\",\n        \"A method for manufacturing a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68558", "text": "{\n    \"patent_title\": \"Miniature Surgical Robot with Enhanced Dexterity\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2022-03-15\",\n    \"filing_date\": \"2022-09-10\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a miniature surgical robot designed for minimally invasive procedures. The robot features enhanced dexterity and precision, allowing for complex surgeries to be performed through small incisions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\",\n            \"relevance\": \"Prior art in robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robot comprising...\",\n        \"The robot of claim 1, wherein...\",\n        \"A method for performing surgery...\",\n        \"The method of claim 3, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68558", "text": "{\n    \"patent_title\": \"Advanced Cardiac Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2020-12-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel cardiac monitoring system for continuous patient data analysis. The system provides real-time alerts and detailed reports to medical professionals.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related to ECG monitoring\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiac monitoring system comprising...\",\n        \"The system of claim 1, wherein...\",\n        \"A method for monitoring cardiac function...\",\n        \"The method of claim 3, wherein...\",\n        \"...\",\n        \"...\",\n        \"...\",\n        \"...\",\n        \"...\",\n        \"...\",\n        \"...\",\n        \"...\",\n        \"...\",\n        \"...\",\n        \"...\",\n        \"...\",\n        \"...\",\n        \"...\",\n        \"...\",\n        \"...\",\n        \"...\",\n        \"...\",\n        \"...\",\n        \"...\",\n        \"...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68559", "text": "{\n    \"patent_title\": \"Minimally Invasive Neural Stimulation Device for Chronic Pain\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel minimally invasive neural stimulation device for the treatment of chronic neuropathic pain. The device utilizes targeted electrical impulses to modulate nerve activity, providing long-term pain relief without the side effects of traditional opioid therapies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"cited_by\": \"Related prior art in neural stimulation\"\n        },\n        {\n            \"patent_number\": \"US9000123B2\",\n            \"cited_by\": \"Foundation for advanced pain management techniques\"\n        },\n        {\n            \"patent_number\": \"US9555678B1\",\n            \"cited_by\": \"Improved methods for signal delivery\"\n        }\n    ],\n    \"claims\": [\n        \"A neural stimulation device comprising...\",\n        \"A method for treating chronic pain using the device...\",\n        \"The device is configured for minimally invasive implantation...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68559", "text": "{\n    \"patent_title\": \"Automated Surgical Tool for Joint Replacement\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Medical Robotics Inc.\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Medical Robotics Inc.\"\n        }\n    ],\n    \"patent_number\": \"EP3456789A1\",\n    \"priority_date\": \"2017-08-10\",\n    \"filing_date\": \"2017-08-10\",\n    \"issue_date\": \"2018-11-07\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"An automated surgical tool designed to improve the precision and efficiency of joint replacement procedures. The tool utilizes robotic assistance and advanced imaging techniques to ensure accurate implant placement.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"cited_by\": \"Related prior art in robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical tool comprising a robotic arm...\",\n        \"A method for performing joint replacement using the tool...\",\n        \"The tool is configured for image-guided surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68560", "text": "{\n    \"patent_title\": \"Ultrasound Image Enhancement System Utilizing Adaptive Filtering\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system and method for enhancing the resolution of ultrasound images. An adaptive filtering algorithm is employed to reduce noise and improve image clarity, leading to more accurate diagnostic capabilities. The system utilizes real-time processing and can be integrated into existing ultrasound devices. The method dynamically adjusts filter parameters based on the local characteristics of the image, providing optimal enhancement without introducing artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"title\": \"Method for Noise Reduction in Medical Images\"\n        }\n    ],\n    \"claims\": [\n        \"A system for enhancing ultrasound images comprising an adaptive filter.\",\n        \"A method for reducing noise in ultrasound images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68560", "text": "{\n    \"patent_title\": \"Magnetic Resonance Imaging Pulse Sequence for Rapid Cardiac Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-09-01\",\n    \"filing_date\": \"2017-09-01\",\n    \"issue_date\": \"2020-05-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel pulse sequence for magnetic resonance imaging (MRI) of the heart, designed to reduce scan time without compromising image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Cardiac MRI Imaging Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A MRI pulse sequence for cardiac imaging.\",\n        \"A method for reducing scan time in MRI.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68561", "text": "{\n    \"patent_title\": \"Enhanced Resolution Medical Imaging Using Deep Learning Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel deep learning architecture for reconstructing medical images from limited data, leading to significantly enhanced resolution and reduced radiation exposure. The method is applicable to various imaging modalities, including CT and MRI.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing medical images using a deep convolutional neural network.\",\n        \"A system for reducing radiation exposure in CT scans.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68561", "text": "{\n    \"patent_title\": \"Automated Bone Density Measurement in X-Ray Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Hospital\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-01-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an automated system for measuring bone density from X-ray images, facilitating early detection of osteoporosis. The system utilizes image processing techniques to identify and quantify bone mineral content.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for automated bone density measurement.\",\n        \"A method for identifying regions of interest in X-ray images.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68562", "text": "{\n    \"patent_title\": \"Miniaturized Optical Coherence Tomography Device for In-Vivo Tissue Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10456789B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2020-02-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel miniaturized optical coherence tomography (OCT) device for high-resolution, in-vivo tissue imaging. The device enables minimally invasive diagnostics of various medical conditions, including cancer and cardiovascular diseases. This innovation allows for real-time visualization of tissue microstructure with improved accessibility and patient comfort.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9234567B2\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized OCT device comprising...\",\n        \"A method for in-vivo tissue imaging...\",\n        \"An imaging system for minimally invasive diagnostics...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68562", "text": "{\n    \"patent_title\": \"Automated System for Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US7654321B2\",\n    \"priority_date\": \"2015-11-01\",\n    \"filing_date\": \"2015-11-01\",\n    \"issue_date\": \"2017-05-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for precise and controlled drug delivery. The system utilizes microfluidic technology to administer medication based on patient-specific needs. This improves treatment efficacy and reduces side effects.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\"\n        },\n        {\n            \"patent_number\": \"US7432109B2\"\n        },\n        {\n            \"patent_number\": \"US8543210B2\"\n        },\n        {\n            \"patent_number\": \"US9432109B2\"\n        },\n        {\n            \"patent_number\": \"US10321098B2\"\n        }\n    ],\n    \"claims\": [\n        \"An automated drug delivery system comprising...\",\n        \"A method for controlling drug release...\",\n        \"A microfluidic device for precise medication...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68563", "text": "{\n    \"patent_title\": \"AI-Enhanced Medical Image Analysis for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2021-12-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention utilizes deep learning algorithms to analyze medical images (MRI, CT scans) for early detection of cancerous tumors. The system improves diagnostic accuracy by identifying subtle patterns undetectable by the human eye, enhancing the effectiveness of cancer screening programs. Artificial intelligence is central to the novel image processing techniques employed.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art on image segmentation\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancerous tumors in medical images using deep learning.\",\n        \"A system for improving diagnostic accuracy in medical imaging.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68563", "text": "{\n    \"patent_title\": \"Improved X-Ray Image Processing Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-03-10\",\n    \"filing_date\": \"2018-03-10\",\n    \"issue_date\": \"2020-08-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved method for processing X-ray images to enhance contrast and reduce noise. The technique utilizes a novel filtering algorithm to improve image clarity, leading to better visualization of anatomical structures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on X-ray image filtering\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing X-ray images using a filtering algorithm.\",\n        \"A system for improving image contrast in X-ray imaging.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68564", "text": "{\n    \"patent_title\": \"Micro-Robotic System for Targeted Drug Delivery during Minimally Invasive Surgery\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A micro-robotic system designed for precise drug delivery to targeted tissues during minimally invasive surgical procedures. The system utilizes shape memory alloys for actuation and is guided by haptic feedback, minimizing the need for extensive imaging. It provides a novel method for tissue manipulation and localized therapy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Minimally Invasive Surgical Instruments\"\n        }\n    ],\n    \"claims\": [\n        \"A micro-robotic system comprising a shape memory alloy actuator...\",\n        \"A method for targeted drug delivery during minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68564", "text": "{\n    \"patent_title\": \"Enhanced MRI-Guided Surgical Navigation System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-07-01\",\n    \"filing_date\": \"2017-07-01\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a surgical navigation system that integrates real-time MRI data with robotic surgical tools. The system provides precise visualization and guidance for surgeons during complex procedures. It significantly improves accuracy and reduces invasiveness through enhanced imaging capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Medical Imaging System\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical navigation system comprising an MRI scanner and a robotic surgical tool...\",\n        \"A method for guiding a surgical tool using real-time MRI data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68565", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction Method for Positron Emission Tomography\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10500000B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-11-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel image reconstruction method for positron emission tomography (PET) that significantly improves image quality and reduces scan time. The method utilizes advanced iterative algorithms and incorporates anatomical information from computed tomography (CT) scans to achieve higher resolution and accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8888888B1\",\n            \"relevance\": \"Prior art in PET reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a PET image comprising...\",\n        \"A system for performing PET image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68565", "text": "{\n    \"patent_title\": \"Method for Enhancing Contrast in Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-12-01\",\n    \"filing_date\": \"2014-12-01\",\n    \"issue_date\": \"2019-05-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method for enhancing contrast in magnetic resonance imaging (MRI) by utilizing a novel pulse sequence. The method improves the visualization of subtle anatomical structures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related MRI pulse sequence techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A pulse sequence for MRI comprising...\",\n        \"An MRI system utilizing the described pulse sequence...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68566", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a minimally invasive surgical system incorporating advanced fiber optic technology and real-time image processing to provide surgeons with enhanced visualization during complex procedures. The system addresses the need for improved precision and reduced trauma in delicate surgeries, particularly in neurosurgery and cardiology. It offers a significant improvement over existing laparoscopic techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8545234B1\",\n            \"relevance\": \"Related art in endoscopic imaging.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising...\",\n        \"A method for performing minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68566", "text": "{\n    \"patent_title\": \"Improved Bicycle Handlebar Design\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Independent Inventor\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2018-08-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new bicycle handlebar design offering increased comfort and control. The handlebar utilizes a novel ergonomic shape.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A bicycle handlebar characterized by...\",\n        \"A bicycle comprising the handlebar...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68567", "text": "{\n    \"patent_title\": \"Surgical Robotic System with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A robotic surgical system designed for minimally invasive procedures, offering enhanced precision and dexterity to surgeons. The system incorporates advanced image guidance and force feedback mechanisms to improve surgical outcomes and reduce patient recovery times. The system significantly reduces trauma and blood loss during complex operations, leading to faster patient recovery and reduced risk of complications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system comprising...\",\n        \"The system of claim 1, further comprising...\",\n        \"A method for performing a surgical procedure...\",\n        \"The method of claim 3, wherein the procedure is minimally invasive...\",\n        \"A control system for adjusting the surgical instrument...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68567", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Vascular Access\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"Boston Scientific\"\n        }\n    ],\n    \"patent_number\": \"EP3876543B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2022-07-20\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"A novel catheter design aimed at improving vascular access during interventional procedures. The catheter features a flexible tip and enhanced biocompatible coating to minimize the risk of thrombosis. The improved design allows for faster and more efficient access to target vessels.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter for vascular access, comprising...\",\n        \"The catheter of claim 1, wherein the tip is flexible...\",\n        \"A method for accessing a vessel...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68568", "text": "{\n    \"patent_title\": \"Enhanced MRI Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-08-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for reconstructing MRI images using deep learning algorithms, resulting in significantly improved image clarity and reduced noise. The technique utilizes a convolutional neural network trained on a large dataset of MRI scans.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68568", "text": "{\n    \"patent_title\": \"Improved X-ray Image Processing System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-01-10\",\n    \"filing_date\": \"2022-01-10\",\n    \"issue_date\": \"2023-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for enhancing the quality of X-ray images through digital processing techniques. The system improves contrast and reduces artifacts, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related X-ray image processing techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A system for processing X-ray images comprising...\",\n        \"A method for enhancing X-ray image quality...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68569", "text": "{\n    \"patent_title\": \"High-Resolution Magnetic Resonance Imaging with Artificial Intelligence Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a groundbreaking method for enhancing the resolution of magnetic resonance images (MRI) through the integration of deep learning algorithms. The system significantly improves diagnostic accuracy in detecting subtle anomalies, offering a novel approach to early disease detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in MRI image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI image resolution comprising...\",\n        \"A system for automated anomaly detection in MRI images...\",\n        \"A computer-readable medium storing instructions for...\",\n        \"The method of claim 1, wherein the deep learning algorithm is a convolutional neural network.\",\n        \"The system of claim 2, further comprising a user interface...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68569", "text": "{\n    \"patent_title\": \"Improved X-Ray Image Processing Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new technique for processing X-ray images to reduce noise and improve contrast. While the system is effective, it doesn't represent a fundamental shift in diagnostic capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous work in X-ray image filtering\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing X-ray images comprising...\",\n        \"A system for reducing noise in X-ray images...\",\n        \"A filter for enhancing contrast in X-ray images.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68570", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Super-Resolution Using Generative Adversarial Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2020-11-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for improving the resolution of images using deep learning techniques, specifically generative adversarial networks (GANs). This invention allows for the creation of high-resolution images from low-resolution inputs, enhancing image quality for various applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"count\": 1\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"count\": 1\n        },\n        {\n            \"patent_number\": \"US10678901B2\",\n            \"count\": 1\n        },\n        {\n            \"patent_number\": \"US11234567B2\",\n            \"count\": 1\n        },\n        {\n            \"patent_number\": \"US11345678B2\",\n            \"count\": 1\n        }\n    ],\n    \"claims\": [\n        \"A method for super-resolution of an image comprising...\",\n        \"A system for super-resolution of an image comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68570", "text": "{\n    \"patent_title\": \"Method for Enhancing Contrast in Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2017-12-01\",\n    \"filing_date\": \"2017-12-01\",\n    \"issue_date\": \"2019-05-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A technique for improving the visibility of details in medical images by adjusting contrast levels. This invention is applicable to various medical imaging modalities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"count\": 1\n        },\n        {\n            \"patent_number\": \"US8543210B1\",\n            \"count\": 1\n        },\n        {\n            \"patent_number\": \"US9654321B2\",\n            \"count\": 1\n        }\n    ],\n    \"claims\": [\n        \"A method for contrast enhancement in a medical image comprising...\",\n        \"An apparatus for contrast enhancement in a medical image comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68571", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Pressure Sensor System for Glaucoma Management\",\n    \"inventors\": [\n        {\n            \"name\": \"David J. Beebe\",\n            \"affiliation\": \"University of Pennsylvania\"\n        },\n        {\n            \"name\": \"Hyun-Ki Kim\",\n            \"affiliation\": \"University of Pennsylvania\"\n        }\n    ],\n    \"patent_number\": \"US9876321B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized, wirelessly powered pressure sensor system for continuous intraocular pressure (IOP) monitoring in glaucoma patients. The system comprises a microfabricated pressure sensor, a power harvesting circuit, and a communication module. This allows for real-time IOP data transmission and personalized glaucoma management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8500720B2\",\n            \"relevance\": \"Related art in pressure sensing\"\n        }\n    ],\n    \"claims\": [\n        \"A microfabricated pressure sensor for intraocular pressure measurement.\",\n        \"A wirelessly powered system for continuous IOP monitoring.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68571", "text": "{\n    \"patent_title\": \"Surgical Instrument Handle with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"James R. Baker\",\n            \"affiliation\": \"Intuitive Surgical, Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10232145B2\",\n    \"priority_date\": \"2014-12-10\",\n    \"filing_date\": \"2014-12-10\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical instrument handle designed to enhance comfort and precision for surgeons during minimally invasive procedures. The handle features a contoured grip and optimized button placement.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7896453B2\",\n            \"relevance\": \"Prior art in surgical instrument handles\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument handle with a contoured grip.\",\n        \"A surgical instrument handle with optimized button placement.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68572", "text": "{\n    \"patent_title\": \"Adaptive Modulation and Coding for Wireless Communication Systems\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2019-11-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for adaptively modulating and coding signals in a wireless communication system to optimize data throughput and reliability. The system dynamically adjusts modulation schemes and coding rates based on channel conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for adaptively modulating a signal...\",\n        \"A system for encoding data...\",\n        \"A wireless communication device...\",\n        \"A method comprising...\",\n        \"An apparatus for...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68572", "text": "{\n    \"patent_title\": \"Implantable Wireless Medical Sensor\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2016-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-04-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wirelessly powered and communicated implantable medical sensor for monitoring physiological parameters within the body. The sensor transmits data to an external receiver for analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable sensor comprising...\",\n        \"A wireless communication module...\",\n        \"A power harvesting circuit...\",\n        \"A method for monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68573", "text": "{\n    \"patent_title\": \"Enhanced Magnetic Resonance Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2022-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning approach for reconstructing high-resolution magnetic resonance images, leading to improved diagnostic accuracy in detecting subtle anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MR image...\",\n        \"A system comprising a deep learning model...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68573", "text": "{\n    \"patent_title\": \"Improved X-Ray Image Acquisition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"EP11223344B1\",\n    \"priority_date\": \"2020-03-01\",\n    \"filing_date\": \"2020-03-01\",\n    \"issue_date\": \"2023-07-20\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"An improved X-ray image acquisition system with reduced radiation exposure. Focuses on minimizing patient dosage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10111222B2\",\n            \"relevance\": \"Related work in radiation shielding.\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system...\",\n        \"A method for reducing radiation dose...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68574", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-01\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable biosensor for continuous glucose monitoring. The device utilizes a novel enzymatic reaction and microfabrication techniques to provide accurate and reliable glucose readings. This technology offers a significant improvement over existing methods for diabetes management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"type\": \"forward\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"type\": \"forward\"\n        },\n        {\n            \"patent_number\": \"US11345678B2\",\n            \"type\": \"forward\"\n        },\n        {\n            \"patent_number\": \"US12456789B2\",\n            \"type\": \"forward\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable biosensor comprising...\",\n        \"A method for continuous glucose monitoring using said biosensor...\",\n        \"A system for data transmission and analysis from said biosensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68574", "text": "{\n    \"patent_title\": \"Improved Surgical Stapler Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Acme Medical Devices Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-07-20\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2020-05-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler design featuring enhanced ergonomics and a more reliable staple deployment mechanism. This invention reduces surgical complications and improves patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"type\": \"forward\"\n        },\n        {\n            \"patent_number\": \"US9654321B2\",\n            \"type\": \"forward\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"A staple cartridge for use in said stapler...\",\n        \"A method for using said stapler to close a surgical wound...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68575", "text": "{\n    \"patent_title\": \"Implantable Cardiac Pacemaker with Adaptive Stimulation\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Boston University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac pacemaker capable of dynamically adjusting stimulation parameters based on real-time physiological feedback to optimize cardiac function and improve patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\",\n            \"relevance\": \"Prior art relating to pacemaker technology\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiac pacemaker comprising...\",\n        \"A method for dynamically adjusting stimulation parameters...\",\n        \"A system for monitoring physiological feedback...\",\n        \"The pacemaker of claim 1, wherein...\",\n        \"The method of claim 2, wherein...\",\n        \"The system of claim 3, wherein...\",\n        \"The pacemaker of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68575", "text": "{\n    \"patent_title\": \"Novel X-Ray Imaging System with Enhanced Resolution\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2022-03-15\",\n    \"filing_date\": \"2022-03-15\",\n    \"issue_date\": \"2023-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new x-ray imaging system that utilizes advanced detector technology to produce high-resolution images for diagnostic purposes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"relevance\": \"Related art in x-ray imaging\"\n        }\n    ],\n    \"claims\": [\n        \"An x-ray imaging system comprising...\",\n        \"A detector for converting x-ray photons...\",\n        \"A method for producing a high-resolution image...\",\n        \"The system of claim 1, wherein...\",\n        \"The detector of claim 2, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68576", "text": "{\n    \"patent_title\": \"Surgical Robotic System with Haptic Feedback\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Boston Dynamics\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical robotic system providing enhanced haptic feedback to the surgeon, enabling more precise and less invasive surgical procedures. The system incorporates force sensors and advanced control algorithms to translate tactile sensations to the surgeon's hands.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic system comprising a robotic arm, a force sensor, and a haptic feedback module.\",\n        \"A method for performing a surgical procedure using the surgical robotic system, wherein the surgeon receives haptic feedback during the procedure.\",\n        \"The system improves patient outcomes by reducing surgical trauma.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68576", "text": "{\n    \"patent_title\": \"MRI Coil for Improved Image Resolution\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-07-01\",\n    \"filing_date\": \"2020-07-01\",\n    \"issue_date\": \"2023-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved MRI coil design resulting in higher resolution images for diagnostic purposes. This coil utilizes a novel arrangement of conductive elements to enhance signal-to-noise ratio.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous MRI coil designs\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil comprising a plurality of conductive elements arranged in a specific configuration.\",\n        \"A method for acquiring MRI images using the MRI coil.\",\n        \"The coil provides images with increased diagnostic clarity.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68577", "text": "{\n    \"patent_title\": \"Enhanced Resolution Medical Imaging System with Reduced Radiation Dose\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel medical imaging system employing advanced reconstruction algorithms to achieve significantly improved image resolution while simultaneously reducing patient radiation exposure. The system utilizes a modified iterative reconstruction technique combined with a low-dose imaging protocol.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8542379B2\",\n            \"title\": \"Low-Dose CT Imaging with Iterative Reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A medical imaging system comprising: an X-ray source...\",\n        \"A method for reconstructing an image from projection data...\",\n        \"The system of claim 1, wherein the radiation dose is reduced by at least 30%...\",\n        \"The method of claim 2, wherein the iterative reconstruction algorithm...\",\n        \"The system of claim 1, further comprising a display for visualizing the reconstructed image.\",\n        \"The method of claim 2, wherein the projection data is acquired using a low-dose imaging protocol.\",\n        \"The system of claim 1, adapted for use in Computed Tomography (CT) imaging.\",\n        \"The method of claim 2, wherein the iterative reconstruction algorithm is a total variation minimization algorithm.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68577", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for MRI Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Generic Pharma Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new contrast agent for Magnetic Resonance Imaging (MRI) that enhances image contrast in vascular tissues. The agent is based on a gadolinium complex with improved biocompatibility.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Gadolinium-Based Contrast Agents for MRI\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent for MRI comprising a gadolinium complex...\",\n        \"The contrast agent of claim 1, wherein the gadolinium complex...\",\n        \"The contrast agent of claim 1, exhibiting improved biocompatibility...\",\n        \"A method for enhancing MRI image contrast using the contrast agent of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68578", "text": "{\n    \"patent_title\": \"Novel MRI Contrast Agent for Early-Stage Breast Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-07-20\",\n    \"issue_date\": \"2023-02-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel gadolinium-based contrast agent for magnetic resonance imaging (MRI) designed to specifically target and enhance the visibility of early-stage breast cancer tumors. The contrast agent exhibits superior sensitivity and specificity compared to existing agents, enabling earlier and more accurate cancer detection. Detailed pharmacokinetic and biodistribution studies have been conducted in preclinical models demonstrating its safety and efficacy.\",\n    \"citations\": [\n        {\n            \"document_id\": \"WO2018001234A1\",\n            \"relevance\": \"Similar MRI contrast agent\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent for MRI comprising a gadolinium complex.\",\n        \"A method for detecting breast cancer using the contrast agent.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68578", "text": "{\n    \"patent_title\": \"Improved Ultrasound Imaging for Thyroid Nodule Assessment\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2021-02-15\",\n    \"issue_date\": \"2022-08-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to improvements in ultrasound imaging techniques for the assessment of thyroid nodules. The system includes a novel beamforming algorithm and image processing method to enhance resolution and reduce artifacts.\",\n    \"citations\": [\n        {\n            \"document_id\": \"US87654321B2\",\n            \"relevance\": \"Prior art ultrasound imaging system\"\n        },\n        {\n            \"document_id\": \"US20190001234A1\",\n            \"relevance\": \"Ultrasound beamforming techniques\"\n        }\n    ],\n    \"claims\": [\n        \"An ultrasound imaging system comprising a beamforming algorithm.\",\n        \"A method for enhancing ultrasound image resolution.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68579", "text": "{\n    \"patent_title\": \"Method and System for Low-Dose Positron Emission Tomography Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for reducing radiation dose in Positron Emission Tomography (PET) imaging utilizing advanced reconstruction algorithms and iterative processing to improve image quality with lower radiation levels. This results in a significant reduction of patient exposure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Improved PET Reconstruction Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for PET imaging comprising...\",\n        \"A system for PET imaging comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68579", "text": "{\n    \"patent_title\": \"Improved X-ray Imaging System with Enhanced Contrast\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved X-ray imaging system incorporating novel contrast agents and enhanced image processing techniques. This results in clearer images and improved diagnostic capabilities. While the dose is optimized, it is still an X-ray based system.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"X-ray Image Enhancement Technique\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A method for X-ray image enhancement...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68580", "text": "{\n    \"patent_title\": \"Method and System for Enhanced MRI Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for improving the quality and speed of MRI image reconstruction using deep learning algorithms. The invention reduces artifacts and enhances diagnostic clarity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"A system for performing MRI image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68580", "text": "{\n    \"patent_title\": \"Improved CT Scanner Calibration Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Siemens Healthineers\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-04-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for calibrating CT scanners to improve image quality and reduce radiation dose. This technique utilizes advanced algorithms for precise alignment.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for calibrating a CT scanner comprising...\",\n        \"A system for performing CT scanner calibration...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68581", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Magnetic Resonance Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10456789B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-09-20\",\n    \"issue_date\": \"2021-02-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing magnetic resonance images with improved resolution and reduced noise, enabling more accurate diagnosis of soft tissue abnormalities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image reconstruction algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a magnetic resonance image comprising...\",\n        \"A system for performing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68581", "text": "{\n    \"patent_title\": \"Apparatus for X-Ray Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Hans Schmidt\",\n            \"affiliation\": \"Siemens AG\"\n        }\n    ],\n    \"patent_number\": \"DE102017000456A1\",\n    \"priority_date\": \"2017-01-10\",\n    \"filing_date\": \"2017-06-01\",\n    \"issue_date\": \"2018-12-20\",\n    \"patent_office\": \"DPMA\",\n    \"abstract\": \"An improved X-ray imaging apparatus with enhanced radiation shielding.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related to radiation safety standards\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging apparatus comprising...\",\n        \"A radiation shielding mechanism for the apparatus of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68582", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Nucleic Acid Amplification and Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-09-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for rapid and sensitive detection of nucleic acids, enabling point-of-care diagnostics. The device integrates sample preparation, amplification, and detection in a single chip, reducing processing time and cost.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for detecting nucleic acids...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68582", "text": "{\n    \"patent_title\": \"Surgical Stapler with Enhanced Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2022-05-01\",\n    \"filing_date\": \"2022-11-15\",\n    \"issue_date\": \"2024-02-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler design with enhanced ergonomics and precision for minimally invasive surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"A method for performing surgical stapling...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68583", "text": "{\n    \"patent_title\": \"Adaptive Beamforming for 5G Millimeter Wave Systems\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-09-20\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel adaptive beamforming technique for 5G millimeter wave systems. It utilizes machine learning algorithms to dynamically adjust beam patterns, improving signal quality and reducing interference. The method addresses challenges in maintaining reliable communication in dense urban environments and offers significant improvements in data throughput.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"High\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Medium\"\n        },\n        {\n            \"patent_number\": \"US11789012B2\",\n            \"relevance\": \"High\"\n        },\n        {\n            \"patent_number\": \"US12345678B2\",\n            \"relevance\": \"Medium\"\n        },\n        {\n            \"patent_number\": \"US13456789B2\",\n            \"relevance\": \"High\"\n        },\n        {\n            \"patent_number\": \"US14567890B2\",\n            \"relevance\": \"Low\"\n        }\n    ],\n    \"claims\": [\n        \"A method for adaptive beamforming in a wireless communication system...\",\n        \"A device comprising a processor and memory configured to implement the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68583", "text": "{\n    \"patent_title\": \"Improved Battery Life for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corp\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-11-15\",\n    \"issue_date\": \"2023-04-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a power management system for mobile devices, designed to extend battery life. The system dynamically adjusts power consumption based on usage patterns.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"High\"\n        },\n        {\n            \"patent_number\": \"US9654321B2\",\n            \"relevance\": \"Medium\"\n        }\n    ],\n    \"claims\": [\n        \"A power management system for a mobile device...\",\n        \"A method for dynamically adjusting power consumption...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68584", "text": "{\n    \"patent_title\": \"Non-Invasive Glucose Monitoring System Utilizing Near-Infrared Spectroscopy\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel non-invasive glucose monitoring system utilizing near-infrared spectroscopy to provide real-time glucose levels. This system aims to improve patient outcomes by enabling continuous monitoring and reducing the need for painful finger pricks. The device incorporates advanced signal processing algorithms for accurate and reliable measurements.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in non-invasive glucose sensing.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for non-invasively measuring glucose levels in a subject.\",\n        \"A device for implementing the method.\",\n        \"The device comprising a near-infrared spectroscopy module.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68584", "text": "{\n    \"patent_title\": \"Surgical Stapler with Enhanced Tissue Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2022-03-15\",\n    \"filing_date\": \"2022-03-15\",\n    \"issue_date\": \"2023-05-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler designed for enhanced tissue compression during surgical procedures. The stapler features a novel mechanism for applying precise and consistent pressure, leading to reduced tissue damage and improved healing. This invention provides surgeons with greater control and precision during surgery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous designs of surgical staplers.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an improved tissue compression mechanism.\",\n        \"The mechanism applying precise and consistent pressure.\",\n        \"A method for using the stapler in surgical procedures.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68585", "text": "{\n    \"patent_title\": \"Magnetic Resonance Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-09-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing magnetic resonance images using a deep learning framework. This improves image quality and reduces scan time, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images using a convolutional neural network.\",\n        \"A system for improving the resolution of MRI images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68585", "text": "{\n    \"patent_title\": \"Improved Ultrasound Transducer for Enhanced Cardiac Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-11-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved ultrasound transducer design that enhances cardiac imaging capabilities. Features include higher frequency and better beamforming for improved resolution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"An ultrasound transducer with a frequency range of 2-5 MHz.\",\n        \"A method for beamforming in ultrasound imaging.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68586", "text": "{\n    \"patent_title\": \"Enhanced Magnetic Resonance Imaging with Novel Contrast Agent\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Chen\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2021-12-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel contrast agent for magnetic resonance imaging (MRI) is disclosed, enhancing image clarity and enabling more accurate diagnosis of cardiovascular disease. The agent incorporates nanoparticles with a unique surface coating, improving biocompatibility and signal amplification.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on MRI contrast agents.\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent for MRI comprising nanoparticles with a biocompatible coating.\",\n        \"A method for enhancing MRI image clarity using said contrast agent.\",\n        \"A method for diagnosing cardiovascular disease using said contrast agent.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68586", "text": "{\n    \"patent_title\": \"Image Processing Algorithm for CT Scan Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Sarah Miller\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2022-01-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A software algorithm designed to improve the visual quality of computed tomography (CT) scans through image filtering and enhancement techniques. This algorithm reduces noise and improves the detection of subtle anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related image processing algorithms.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing CT scan images using a digital filtering algorithm.\",\n        \"A computer program implementing said filtering algorithm.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68587", "text": "{\n    \"patent_title\": \"Noise Reduction Method for Medical Images using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-05-15\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning method for reducing noise in medical images, improving diagnostic accuracy. The method utilizes a convolutional neural network trained on a large dataset of noisy and clean images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image denoising\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing noise in an image comprising:...\",\n        \"A system for implementing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68587", "text": "{\n    \"patent_title\": \"Image Compression Technique for High-Resolution Photographs\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Adobe Systems\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2020-10-01\",\n    \"filing_date\": \"2020-10-01\",\n    \"issue_date\": \"2022-06-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new image compression algorithm that reduces file size without significant loss of quality, suitable for high-resolution photographs and online sharing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in image compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image comprising:...\",\n        \"A system for implementing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68588", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized, implantable biosensor is disclosed for continuous glucose monitoring. The device utilizes a novel enzymatic reaction coupled with an electrochemical transducer to provide highly accurate and reliable glucose readings. This technology offers improved patient compliance and enhanced diabetes management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"kind\": \"Cited by Examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A biosensor comprising...\",\n        \"A method for continuously monitoring glucose levels...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68588", "text": "{\n    \"patent_title\": \"Surgical Stapler with Enhanced Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler is described, featuring enhanced ergonomics and a novel cartridge design. The stapler is designed for use in laparoscopic surgical procedures, providing surgeons with greater precision and control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"kind\": \"Cited by Applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"A cartridge for use in a surgical stapler...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68589", "text": "{\n    \"patent_title\": \"AI-Assisted MRI Anomaly Detection System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-12-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for detecting anomalies in Magnetic Resonance Imaging (MRI) scans using deep learning techniques. The system automatically identifies potential areas of concern, assisting radiologists in faster and more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Machine Learning for Image Classification\"\n        }\n    ],\n    \"claims\": [\n        \"A system for detecting anomalies in MRI scans using a convolutional neural network.\",\n        \"A method for automatically identifying regions of interest in MRI images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68589", "text": "{\n    \"patent_title\": \"Portable Ultrasound Device with Enhanced Resolution\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-08-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A portable ultrasound device featuring improved image resolution and signal processing capabilities. The device is designed for point-of-care diagnostics and remote medical applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Improved Ultrasound Transducer Design\"\n        }\n    ],\n    \"claims\": [\n        \"A portable ultrasound device with a frequency range of 2-18 MHz.\",\n        \"A method for enhancing ultrasound image quality using adaptive filtering.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68590", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Resolution Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-09-20\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for enhancing the resolution of medical images using a deep learning-based reconstruction algorithm. This improves the clarity and diagnostic accuracy of images obtained from various imaging modalities such as MRI and CT scans.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\",\n            \"relevance\": \"Similar reconstruction algorithm\"\n        },\n        {\n            \"patent_number\": \"US98765432B2\",\n            \"relevance\": \"Related deep learning application in medical imaging\"\n        },\n        {\n            \"patent_number\": \"US87654321B1\",\n            \"relevance\": \"Prior art in image enhancement techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing the resolution of a medical image...\",\n        \"A system comprising a processor...\",\n        \"The method of claim 1, wherein the image is an MRI scan...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68590", "text": "{\n    \"patent_title\": \"Portable X-Ray Device for Veterinary Use\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Veterinary Equipment\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2020-05-01\",\n    \"filing_date\": \"2020-11-15\",\n    \"issue_date\": \"2023-04-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A compact and portable X-ray device designed for use in veterinary clinics and field applications. It provides a convenient and cost-effective solution for radiographic imaging of animals.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related X-ray technology\"\n        }\n    ],\n    \"claims\": [\n        \"A portable X-ray device comprising...\",\n        \"The device of claim 1, wherein the device is battery powered...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68591", "text": "{\n    \"patent_title\": \"Miniature Wireless Implantable Sensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2023-02-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature, wireless, implantable sensor for continuous glucose monitoring. The sensor utilizes a novel enzymatic reaction and a microfabricated electrode to provide accurate and reliable glucose readings. It addresses a critical need for improved diabetes management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on glucose sensors\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless implantable glucose sensor comprising...\",\n        \"A method for continuous glucose monitoring using the sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68591", "text": "{\n    \"patent_title\": \"Cardiac Pacemaker with Advanced Rhythm Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2024-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved cardiac pacemaker with advanced algorithms for detecting and responding to abnormal heart rhythms. The device provides more accurate and reliable pacing therapy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Previous generation pacemaker technology\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiac pacemaker comprising...\",\n        \"A method for pacing the heart using the device...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68592", "text": "{\n    \"patent_title\": \"Enhanced Image Recognition System Using Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved image recognition system utilizing deep learning techniques, specifically convolutional neural networks, to achieve higher accuracy in object detection and classification. The system is applicable to various domains, including autonomous vehicles and security systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a neural network...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The system of claim 1, wherein the neural network is a convolutional neural network.\",\n        \"The method of claim 2, wherein the training data comprises labeled images.\",\n        \"The system of claim 1, further comprising a user interface.\",\n        \"The method of claim 2, wherein the training is performed using backpropagation.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68592", "text": "{\n    \"patent_title\": \"Medical Image Analysis System with Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-11-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel medical image analysis system leveraging deep learning algorithms for detecting anomalies in MRI and CT scans. It specifically targets the identification of cancerous tissues in medical images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for analyzing medical images...\",\n        \"A system for detecting anomalies...\",\n        \"A computer program for processing medical data...\",\n        \"The method of claim 1, wherein the images are MRI scans.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68593", "text": "{\n    \"patent_title\": \"Novel MRI Reconstruction Algorithm for Enhanced Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2022-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel magnetic resonance imaging (MRI) reconstruction algorithm utilizing deep learning techniques to enhance tumor detection accuracy. The algorithm reduces noise and artifacts, leading to improved visualization of subtle abnormalities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images...\",\n        \"A computer-readable medium comprising instructions for...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68593", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for Enhanced X-ray Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"PharmaCorp Inc.\"\n        },\n        {\n            \"name\": \"Sarah Chen\",\n            \"affiliation\": \"PharmaCorp Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-08-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention concerns a novel contrast agent for X-ray imaging, offering improved image clarity and reduced radiation exposure. The agent is specifically designed for use in cardiovascular imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Existing contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising a metal complex...\",\n        \"A method for imaging cardiovascular structures...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68594", "text": "{\n    \"patent_title\": \"Enhanced Magnetic Resonance Imaging with Novel Contrast Agent\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-04-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel contrast agent for magnetic resonance imaging (MRI) is disclosed, significantly enhancing image clarity and enabling improved detection of subtle anomalies. This invention provides a substantial improvement in diagnostic accuracy for early-stage cancer detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent composition comprising...\",\n        \"A method for enhancing MRI image clarity comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68594", "text": "{\n    \"patent_title\": \"Digital X-Ray Enhancement Techniques\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"State University\"\n        }\n    ],\n    \"patent_number\": \"US9123456B2\",\n    \"priority_date\": \"2014-12-10\",\n    \"filing_date\": \"2014-12-10\",\n    \"issue_date\": \"2019-02-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to digital image processing techniques for enhancing the quality of X-ray images. The method involves filtering algorithms to reduce noise and improve contrast.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US4225123\",\n            \"type\": \"cited\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing X-ray images comprising...\",\n        \"A digital image processing system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68595", "text": "{\n    \"patent_title\": \"Implantable Cardiac Monitoring System with Real-time Data Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11245678B2\",\n    \"priority_date\": \"2022-05-15\",\n    \"filing_date\": \"2022-06-20\",\n    \"issue_date\": \"2023-12-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac monitoring system capable of real-time data analysis to detect and predict arrhythmias, providing early warning signals and improving patient outcomes. Addresses the need for proactive cardiac health management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"year\": \"2018\"\n        }\n    ],\n    \"claims\": [\n        \"A method for real-time arrhythmia detection using implantable sensors.\",\n        \"A system for wirelessly transmitting cardiac data to a remote monitoring center.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68595", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Angioplasty\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Wilson\",\n            \"affiliation\": \"Medtronic Inc.\"\n        },\n        {\n            \"name\": \"Sarah Chen\",\n            \"affiliation\": \"Medtronic Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2021-11-01\",\n    \"filing_date\": \"2021-12-10\",\n    \"issue_date\": \"2023-07-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design for performing angioplasty procedures, featuring enhanced maneuverability and reduced risk of vessel damage. The design improves access to difficult-to-reach areas within the cardiovascular system.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US5432109A\",\n            \"year\": \"1995\"\n        },\n        {\n            \"patent_number\": \"US6789012B2\",\n            \"year\": \"2004\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter with a flexible tip for navigating tortuous vessels.\",\n        \"A method for performing angioplasty with reduced vessel trauma.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68596", "text": "{\n    \"patent_title\": \"Enhanced MRI Contrast Agent and Imaging Method\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-09-20\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel MRI contrast agent that exhibits significantly enhanced signal intensity and improved tissue specificity, leading to clearer and more accurate medical imaging. The agent comprises a gadolinium complex encapsulated within a biocompatible nanoparticle.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Gadolinium-Based Contrast Agents\"\n        },\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Targeted Contrast Agents for Tumor Imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising a gadolinium complex encapsulated within a nanoparticle.\",\n        \"A method for enhancing MRI imaging comprising administering the contrast agent.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68596", "text": "{\n    \"patent_title\": \"Improved X-Ray Shielding Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2020-01-05\",\n    \"filing_date\": \"2020-07-15\",\n    \"issue_date\": \"2023-02-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new composite material for X-ray shielding, providing improved protection against radiation exposure. The material consists of a polymer matrix with embedded tungsten particles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Radiation Shielding Polymers\"\n        }\n    ],\n    \"claims\": [\n        \"A radiation shielding material comprising a polymer matrix and tungsten particles.\",\n        \"A method of manufacturing the radiation shielding material.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68597", "text": "{\n    \"patent_title\": \"Minimally Invasive Robotic Surgical System with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel robotic surgical system utilizing advanced haptic feedback and artificial intelligence for enhanced precision during minimally invasive procedures. This system significantly improves surgical outcomes and reduces patient recovery time compared to traditional laparoscopic techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system comprising...\",\n        \"A method for performing a surgical procedure using...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68597", "text": "{\n    \"patent_title\": \"Implantable Cardiac Pacemaker with Leadless Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Medtronic\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Boston Scientific\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-01\",\n    \"issue_date\": \"2023-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac pacemaker utilizing leadless technology to provide pacing and rhythm control for patients with bradycardia and other cardiac arrhythmias. The device offers improved reliability and reduced complication rates.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art in cardiac pacing\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable cardiac pacemaker comprising...\",\n        \"A method for pacing a heart using...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68598", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Electrolyte for Extended Cycle Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Kenji Tanaka\",\n            \"affiliation\": \"Toyota Research Institute\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery utilizing a novel electrolyte composition comprising a lithium bis(fluorosulfonyl)imide salt and a fluorinated ether solvent, significantly enhancing cycle life and reducing capacity fade in portable electronic devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8216623B2\",\n            \"relevance\": \"Prior art related to electrolyte additives.\"\n        },\n        {\n            \"patent_number\": \"US9123678B2\",\n            \"relevance\": \"Related technology in solid-state batteries.\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrolyte composition...\",\n        \"The battery of claim 1, wherein the electrolyte composition exhibits...\",\n        \"A portable electronic device incorporating the battery of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68598", "text": "{\n    \"patent_title\": \"Wireless Charging System with Adaptive Power Control\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Samsung Electronics\"\n        }\n    ],\n    \"patent_number\": \"US10458672B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-02-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless charging system utilizing adaptive power control algorithms to optimize charging efficiency and reduce heat dissipation during wireless charging of portable electronic devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9564321B2\",\n            \"relevance\": \"Related to wireless power transfer techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless charging system comprising a transmitter and a receiver...\",\n        \"The system of claim 1, wherein the transmitter adaptively adjusts...\",\n        \"A method for wirelessly charging a portable electronic device...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68599", "text": "{\n    \"patent_title\": \"Improved Iterative Reconstruction Method for Low-Dose CT Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel iterative reconstruction algorithm for computed tomography (CT) imaging. The method significantly reduces radiation dose while maintaining high image quality. The algorithm incorporates advanced regularization techniques and is particularly useful for diagnostic imaging applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a CT image...\",\n        \"The method of claim 1, wherein the radiation dose is reduced by at least 30%...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68599", "text": "{\n    \"patent_title\": \"Enhanced MRI Contrast Agents for Cardiovascular Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2015-01-20\",\n    \"filing_date\": \"2015-01-20\",\n    \"issue_date\": \"2017-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to novel contrast agents for magnetic resonance imaging (MRI) used in cardiovascular disease diagnosis. The contrast agents improve the visibility of blood vessels and cardiac tissue, enhancing diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent for MRI...\",\n        \"The contrast agent of claim 1, comprising a gadolinium complex...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68600", "text": "{\n    \"patent_title\": \"Miniaturized Neural Stimulator with Closed-Loop Feedback\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized neural stimulator utilizing closed-loop feedback to optimize therapeutic effects and minimize side effects. The device dynamically adjusts stimulation parameters based on real-time neural activity, leading to improved patient outcomes in neurological disorders.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art on neural stimulation techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized neural stimulator comprising...\",\n        \"A closed-loop feedback system for...\",\n        \"A method for dynamically adjusting stimulation parameters...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68600", "text": "{\n    \"patent_title\": \"Improved Stent Design for Coronary Artery Disease\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Emily Chen\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2012-07-01\",\n    \"filing_date\": \"2012-07-01\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved stent design featuring a novel biocompatible coating and optimized structural geometry to reduce restenosis rates in patients with coronary artery disease. The stent provides enhanced mechanical support and promotes endothelialization.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8987654B2\",\n            \"relevance\": \"Previous stent designs and their limitations.\"\n        }\n    ],\n    \"claims\": [\n        \"A stent comprising a biocompatible coating...\",\n        \"A method for deploying a stent in a coronary artery...\",\n        \"A stent with optimized structural geometry...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68601", "text": "{\n    \"patent_title\": \"Enhanced Image Reconstruction Method for MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image reconstruction method for Magnetic Resonance Imaging (MRI) that significantly improves image clarity and reduces noise, leading to enhanced diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8213021B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image...\",\n        \"The method of claim 1, wherein the noise is reduced by at least 20%...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68601", "text": "{\n    \"patent_title\": \"Improved Drug Delivery System Using Nanoparticles\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Williams\",\n            \"affiliation\": \"Pfizer Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10456789B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-10-13\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for targeted drug delivery using biocompatible nanoparticles, improving the efficacy of pharmaceutical treatments.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A drug delivery system comprising nanoparticles...\",\n        \"The system of claim 1, wherein the nanoparticles are targeted to cancer cells...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68602", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-05-20\",\n    \"issue_date\": \"2013-08-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable biosensor is disclosed for continuous glucose monitoring in diabetic patients. The device utilizes a novel enzyme-based electrochemical sensor and a biocompatible encapsulation material to achieve high accuracy and long-term stability, significantly improving diagnostic accuracy and enabling proactive diabetes management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"Prior art on glucose sensors\"\n        }\n    ],\n    \"claims\": [\n        \"A biosensor for continuous glucose monitoring comprising...\",\n        \"A method for monitoring glucose levels using said biosensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68602", "text": "{\n    \"patent_title\": \"Software System for Analyzing Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2011-11-01\",\n    \"filing_date\": \"2012-02-15\",\n    \"issue_date\": \"2015-06-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A software system for analyzing medical images, specifically X-rays and CT scans, to assist radiologists in detecting anomalies. The system employs advanced image processing algorithms and machine learning techniques to identify potential tumors. Improves radiologist workflow.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"relevance\": \"Prior art on image analysis algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"A software system for analyzing medical images comprising...\",\n        \"A method for detecting anomalies in medical images using said software...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68603", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Marcus Chen\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-03-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system designed with improved ergonomics for surgeons, leading to reduced fatigue and increased precision. The system also incorporates features to minimize patient trauma and accelerate recovery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising an ergonomic handle...\",\n        \"A method for performing minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68603", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Ingrid Bergman\",\n            \"affiliation\": \"BioTech Solutions Inc.\"\n        }\n    ],\n    \"patent_number\": \"EP2876543B1\",\n    \"priority_date\": \"2014-12-01\",\n    \"filing_date\": \"2014-12-01\",\n    \"issue_date\": \"2017-05-10\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"A novel catheter design for targeted drug delivery, improving efficiency and reducing side effects.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible tip...\",\n        \"A method for delivering a drug using the catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68604", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Enhancement for Low-Light Photography\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel deep learning architecture for enhancing images captured in low-light conditions. The system utilizes a convolutional neural network to improve image clarity and reduce noise. Applications include mobile photography and surveillance systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image using a deep neural network.\",\n        \"A system comprising a convolutional neural network configured to reduce noise in an image.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68604", "text": "{\n    \"patent_title\": \"Medical Image Reconstruction Using Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2022-07-01\",\n    \"filing_date\": \"2022-09-15\",\n    \"issue_date\": \"2024-02-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a new method for reconstructing medical images from raw data using a deep neural network. The system improves the resolution and quality of MRI and CT scans, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image using a neural network.\",\n        \"A system for processing MRI data using deep learning techniques.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68605", "text": "{\n    \"patent_title\": \"Ultrasound-based Cancer Detection System with Enhanced Resolution\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel ultrasound system that utilizes advanced signal processing techniques to enhance the resolution and clarity of ultrasound images, leading to improved cancer detection. The system incorporates a machine learning algorithm to identify subtle anomalies indicative of cancerous tissues.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Improved Ultrasound Transducer Design\"\n        }\n    ],\n    \"claims\": [\n        \"A method for improving cancer detection using ultrasound imaging.\",\n        \"An ultrasound system comprising a transducer and a signal processing unit.\",\n        \"A machine learning algorithm for identifying cancerous tissues in ultrasound images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68605", "text": "{\n    \"patent_title\": \"High-Field MRI System with Gradient Coil Optimization\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a high-field magnetic resonance imaging (MRI) system featuring a novel gradient coil design to improve image quality and reduce scan time. It is suitable for a wide range of medical applications requiring detailed anatomical imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Gradient Coil Design for MRI\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI system comprising a high-field magnet and a gradient coil.\",\n        \"A gradient coil design for minimizing image distortion in MRI.\",\n        \"A method for reducing scan time in MRI using optimized gradient coils.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68606", "text": "{\n    \"patent_title\": \"AI-Powered Diagnostic System for Early Cancer Detection using Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel artificial intelligence system for early detection of cancerous tumors in medical images. The system utilizes deep learning algorithms to analyze radiographic images with high accuracy, improving diagnostic efficiency and patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancerous tumors in medical images using a deep learning algorithm.\",\n        \"A system for assisting radiologists in the diagnosis of cancer.\",\n        \"A computer-readable medium storing instructions for performing the method.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68606", "text": "{\n    \"patent_title\": \"Novel Drug Compound for Treating Alzheimer's Disease\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Pfizer Inc.\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-01-15\",\n    \"filing_date\": \"2022-01-15\",\n    \"issue_date\": \"2024-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new chemical compound demonstrating promising results in treating Alzheimer's disease. The compound targets amyloid plaque formation in the brain, potentially slowing disease progression.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A novel chemical compound for treating Alzheimer's disease.\",\n        \"A pharmaceutical composition comprising the compound.\",\n        \"A method of treating Alzheimer's disease using the compound.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68607", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing medical images from sparse projection data, resulting in significantly improved image clarity and reduced radiation dose to the patient. The method incorporates a deep learning approach to enhance image resolution and suppress noise.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"The method of claim 1, wherein the reconstruction utilizes a deep learning algorithm...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68607", "text": "{\n    \"patent_title\": \"Improved X-Ray Tube Design for Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-02-15\",\n    \"filing_date\": \"2017-02-15\",\n    \"issue_date\": \"2020-01-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved X-ray tube design focusing on enhanced heat dissipation and increased output power, leading to shorter scan times. The tube utilizes a novel anode material and cooling system.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube comprising...\",\n        \"The X-ray tube of claim 1, wherein the anode material is tungsten alloy...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68608", "text": "{\n    \"patent_title\": \"Enhanced Magnetic Resonance Imaging with Artificial Intelligence for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Jian Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method for enhancing magnetic resonance imaging (MRI) through the integration of deep learning algorithms. The system improves image resolution and contrast, enabling earlier and more accurate detection of cancerous tumors. This addresses a critical need for improved diagnostic tools in oncology. The system's AI-driven analysis can distinguish subtle indicators of cancer that may be missed by human observers.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on basic MRI techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI images using a convolutional neural network.\",\n        \"A system comprising an MRI scanner and a deep learning algorithm for tumor detection.\",\n        \"A method for reducing image noise in MRI scans using AI.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68608", "text": "{\n    \"patent_title\": \"System for Targeted Radiation Delivery in Cancer Treatment\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Marcus Bell\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2023-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system for precisely delivering radiation therapy to cancerous tumors. The system utilizes advanced imaging techniques to map the tumor's location and shape, allowing for targeted radiation treatment while minimizing damage to surrounding healthy tissue. The method utilizes a feedback loop to adjust radiation dosage in real-time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on radiation shielding methods.\"\n        }\n    ],\n    \"claims\": [\n        \"A system for targeted radiation delivery comprising an imaging module and a radiation source.\",\n        \"A method for mapping tumor location using CT scans.\",\n        \"A method for adjusting radiation dosage based on real-time feedback.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68609", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Object Recognition in Complex Scenes\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-11-15\",\n    \"issue_date\": \"2023-03-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for object recognition in cluttered environments using deep convolutional neural networks. The system improves accuracy and robustness in challenging visual scenarios.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\"\n        },\n        {\n            \"patent_number\": \"US98765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for object recognition comprising...\",\n        \"A system for processing visual data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68609", "text": "{\n    \"patent_title\": \"Improved Technique for Medical Image Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"UC Berkeley Medical Center\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2022-01-15\",\n    \"filing_date\": \"2022-07-20\",\n    \"issue_date\": \"2024-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for enhancing the clarity and accuracy of medical images using advanced filtering techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing medical images...\",\n        \"A system for analyzing diagnostic scans...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68610", "text": "{\n    \"patent_title\": \"Implantable Cardiovascular Monitor with Wireless Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Chen\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11245678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-04-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an implantable cardiovascular monitor capable of wirelessly transmitting data regarding heart function. The device is designed for minimally invasive implantation and continuous monitoring of key cardiovascular parameters, improving early detection of cardiac events.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art in implantable devices\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiovascular monitoring device comprising a sensor...\",\n        \"A wireless communication module for transmitting data...\",\n        \"A power source for operation of the device...\",\n        \"A method for remotely monitoring cardiovascular health...\",\n        \"A system for alerting medical personnel to abnormal readings...\",\n        \"A method for minimizing invasive implantation procedures...\",\n        \"A data analysis module for identifying cardiac events...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68610", "text": "{\n    \"patent_title\": \"Surgical Instrument for Bone Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Lee\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Sarah Kim\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2022-01-10\",\n    \"filing_date\": \"2022-01-10\",\n    \"issue_date\": \"2023-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel surgical instrument designed for precise bone reconstruction following traumatic injuries. The instrument utilizes advanced materials and ergonomic design for improved surgical outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related prior art in surgical tools\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising a handle...\",\n        \"A cutting mechanism for precise bone removal...\",\n        \"A reconstruction component for filling bone defects...\",\n        \"A method for performing bone reconstruction surgery...\",\n        \"A sterilization procedure for the instrument...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68611", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Reconstruction for Accelerated MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning framework for reconstructing high-quality MRI images from undersampled k-space data, significantly reducing scan time while maintaining diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on compressed sensing MRI\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"A system for performing MRI reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68611", "text": "{\n    \"patent_title\": \"Improved Filter for Noise Reduction in Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2022-07-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved median filter for reducing noise in medical images, offering a slight enhancement over existing filtering techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Standard median filtering techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for filtering a medical image comprising...\",\n        \"A device for applying a median filter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68612", "text": "{\n    \"patent_title\": \"Magnetic Resonance Imaging System with Enhanced Contrast\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A magnetic resonance imaging (MRI) system incorporating a novel contrast agent delivery method, significantly enhancing image clarity for improved diagnostic accuracy. This invention addresses the need for clearer visualization of subtle tissue abnormalities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8652001B2\",\n            \"relevance\": \"Prior art related to contrast agent injection techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"A magnetic resonance imaging system comprising...\",\n        \"A contrast agent delivery method for use with said system...\",\n        \"A method for enhancing image clarity...\",\n        \"A method for diagnosing tissue abnormalities...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68612", "text": "{\n    \"patent_title\": \"Complex Algorithm for Automated Image Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"TechCorp Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An advanced algorithm for automated image analysis utilizing deep learning techniques. This system is capable of detecting and classifying a wide range of image features with high precision.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related to early deep learning implementations in image processing.\"\n        },\n        {\n            \"patent_number\": \"US8987654B2\",\n            \"relevance\": \"Prior art concerning image segmentation algorithms.\"\n        }\n    ],\n    \"claims\": [\n        \"A system for automated image analysis comprising...\",\n        \"A deep learning algorithm for feature extraction...\",\n        \"A method for classifying image features...\",\n        \"A method for generating reports based on image analysis...\",\n        \"A method for improving the accuracy of image analysis...\",\n        \"A method for optimizing the performance of the algorithm...\",\n        \"A method for handling large datasets of images...\",\n        \"A method for integrating with existing imaging systems...\",\n        \"A method for visualizing the results of image analysis...\",\n        \"A method for managing user access to the system...\",\n        \"A method for securing the system against unauthorized access...\",\n        \"A method for updating the algorithm with new data...\",\n        \"A method for monitoring the performance of the algorithm...\",\n        \"A method for diagnosing errors in the algorithm...\",\n        \"A method for recovering from errors in the algorithm...\",\n        \"A method for providing support to users...\",\n        \"A method for training users on the system...\",\n        \"A method for documenting the system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68613", "text": "{\n    \"patent_title\": \"High-Resolution Magnetic Resonance Imaging with Enhanced Contrast Agents\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Chen\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel magnetic resonance imaging (MRI) technique utilizing targeted contrast agents to significantly improve resolution and contrast in human tissues. This technology enables earlier and more accurate diagnosis of various diseases.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"relevance\": \"Prior art in contrast agent delivery\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related MRI sequence optimization\"\n        },\n        {\n            \"patent_number\": \"US9012345B1\",\n            \"relevance\": \"Early research on targeted imaging\"\n        },\n        {\n            \"patent_number\": \"US9234567B2\",\n            \"relevance\": \"Advanced pulse sequence design\"\n        },\n        {\n            \"patent_number\": \"US9345678B1\",\n            \"relevance\": \"Methods for image reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI with enhanced resolution.\",\n        \"A contrast agent specifically targeted to tumor cells.\",\n        \"An MRI system capable of generating high-resolution images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68613", "text": "{\n    \"patent_title\": \"Ultrasound Imaging for Canine Cardiac Health\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Miller\",\n            \"affiliation\": \"University of California, Davis\"\n        },\n        {\n            \"name\": \"Dr. Sarah Johnson\",\n            \"affiliation\": \"Veterinary Cardiology Specialists\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2017-08-10\",\n    \"filing_date\": \"2017-08-10\",\n    \"issue_date\": \"2020-11-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved ultrasound imaging technique for assessing cardiac function in dogs. The system provides clear visualization of heart structures and aids in the diagnosis of canine heart disease.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art in veterinary ultrasound\"\n        },\n        {\n            \"patent_number\": \"US8432198B1\",\n            \"relevance\": \"Related cardiac imaging techniques\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"relevance\": \"Early veterinary cardiac diagnostics\"\n        }\n    ],\n    \"claims\": [\n        \"An ultrasound system configured for canine cardiac imaging.\",\n        \"A method for measuring cardiac output in dogs.\",\n        \"A veterinary diagnostic tool using ultrasound technology.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68614", "text": "{\n    \"patent_title\": \"Enhanced Resolution Magnetic Resonance Imaging Using Deep Learning Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2021-12-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for improving the resolution of magnetic resonance images (MRI) using a deep learning-based reconstruction algorithm. The system significantly enhances image clarity, enabling more accurate diagnosis of neurological conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"MRI Reconstruction Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for improving MRI resolution utilizing...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68614", "text": "{\n    \"patent_title\": \"Cardiovascular Imaging with Improved Contrast Agents\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-03-10\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-07-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"Novel contrast agents for enhanced visualization of cardiac structures during echocardiography. Improved contrast leads to better detection of cardiovascular abnormalities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Contrast Agents for Medical Imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent composition for cardiovascular imaging...\",\n        \"A method of enhancing cardiac visualization using...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68615", "text": "{\n    \"patent_title\": \"Improved MRI Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning algorithm for improving the reconstruction quality of MRI images, leading to enhanced diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images using a deep neural network.\",\n        \"A system for performing MRI reconstruction with improved image quality.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68615", "text": "{\n    \"patent_title\": \"Contrast Agent for Improved CT Scans\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"EP11223344B1\",\n    \"priority_date\": \"2020-03-10\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2023-08-18\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"A new contrast agent for CT scans that enhances the visibility of tumors.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related contrast agent technology\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent composition for CT imaging.\",\n        \"A method for enhancing CT image contrast using the composition.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68616", "text": "{\n    \"patent_title\": \"AI-Enhanced Medical Image Analysis System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for medical image analysis utilizing artificial intelligence and machine learning algorithms to detect anomalies in MRI and CT scans. The system provides improved accuracy and efficiency in diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        },\n        {\n            \"patent_number\": \"US8643210B2\"\n        },\n        {\n            \"patent_number\": \"US7534891B2\"\n        },\n        {\n            \"patent_number\": \"US6543217B1\"\n        },\n        {\n            \"patent_number\": \"US5432109B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for medical image analysis comprising...\",\n        \"A method for detecting anomalies in medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68616", "text": "{\n    \"patent_title\": \"Improved X-Ray Detection Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2018-05-20\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2020-05-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved X-ray detection device with enhanced image clarity and reduced radiation exposure. This invention utilizes novel detector materials and signal processing techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray detection device comprising...\",\n        \"A method for reducing radiation exposure...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68617", "text": "{\n    \"patent_title\": \"High-Density Lithium-Ion Battery with Enhanced Cycle Life for Electric Vehicle Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Tesla, Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-06-15\",\n    \"issue_date\": \"2021-12-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery design featuring a silicon-carbon composite anode and a solid-state electrolyte, resulting in increased energy density and improved cycle life. Specifically designed for electric vehicle power systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art on solid-state electrolytes\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising a silicon-carbon composite anode.\",\n        \"The battery of claim 1, further comprising a solid-state electrolyte.\",\n        \"The battery of claim 2, wherein the solid-state electrolyte is a lithium-ion conducting ceramic.\",\n        \"The battery of claim 1, exhibiting an energy density of at least 300 Wh/kg.\",\n        \"The battery of claim 1, adapted for use in an electric vehicle.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68617", "text": "{\n    \"patent_title\": \"Improved Fuel Cell Design for Stationary Power Generation\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-01-10\",\n    \"filing_date\": \"2018-02-10\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel fuel cell architecture designed for efficient stationary power generation. Focuses on maximizing power output and minimizing emissions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related prior art on fuel cell membranes\"\n        }\n    ],\n    \"claims\": [\n        \"A fuel cell comprising a proton exchange membrane.\",\n        \"The fuel cell of claim 1, utilizing hydrogen as a fuel source.\",\n        \"The fuel cell of claim 1, configured for stationary power generation.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68618", "text": "{\n    \"patent_title\": \"Low-Dose Pediatric Computed Tomography with Iterative Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2020-06-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method for reducing radiation dose in pediatric computed tomography (CT) scans while maintaining image quality. Utilizing advanced iterative reconstruction algorithms, the method effectively minimizes noise and artifacts, enabling diagnostic images to be obtained with significantly lower radiation exposure. The method is particularly suited for pediatric patients who are more sensitive to radiation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on iterative reconstruction.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing radiation dose in CT imaging.\",\n        \"The method of claim 1, wherein the subject is a pediatric patient.\",\n        \"A CT system configured to implement the method of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68618", "text": "{\n    \"patent_title\": \"Magnetic Resonance Imaging Coil Design for Improved Signal-to-Noise Ratio\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-05-20\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-11-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel coil design for magnetic resonance imaging (MRI) that improves signal-to-noise ratio and image resolution. The coil geometry is optimized for enhanced detection of subtle anatomical features. Applications include neurological and musculoskeletal imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Previous work on MRI coil design.\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil with a specific geometrical configuration.\",\n        \"A method for fabricating the MRI coil.\",\n        \"An MRI system incorporating the MRI coil.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68619", "text": "{\n    \"patent_title\": \"Miniaturized Surgical Robot with Force Feedback\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2021-12-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized surgical robot capable of performing minimally invasive procedures with enhanced force feedback. The device utilizes micro-sensors and actuators to provide precise control and tactile sensing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robot comprising a miniaturized robotic arm...\",\n        \"A force feedback system for use with a surgical robot...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68619", "text": "{\n    \"patent_title\": \"External Fixation Device for Fracture Healing\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Acme Medical Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-11-10\",\n    \"filing_date\": \"2017-11-10\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An external fixation device for stabilizing bone fractures during the healing process. The device is designed for ease of use and patient comfort.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"An external fixation device comprising a frame...\",\n        \"A method of stabilizing a bone fracture using an external fixation device...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68620", "text": "{\n    \"patent_title\": \"AI-Powered Image Analysis for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for early cancer detection using artificial intelligence to analyze medical images, improving diagnostic accuracy and reducing false positives.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancer using AI-enhanced image analysis.\",\n        \"A system comprising an image acquisition device and an AI processing unit.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68620", "text": "{\n    \"patent_title\": \"Cosmetic Skin Analysis Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2019-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A handheld device and associated software for analyzing skin conditions and recommending cosmetic treatments. Utilizes image analysis to assess wrinkles, blemishes, and skin tone.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A handheld device for cosmetic skin analysis.\",\n        \"A method for recommending cosmetic treatments based on image analysis.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68621", "text": "{\n    \"patent_title\": \"Controlled Release Formulation for Enhanced Bioavailability of Poorly Soluble Drugs\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel controlled-release formulation comprising a biocompatible polymer matrix for enhancing the bioavailability of poorly soluble drugs. The formulation provides sustained drug release and improved therapeutic efficacy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"assignee\": \"Pfizer Inc.\"\n        }\n    ],\n    \"claims\": [\n        \"A pharmaceutical composition comprising a poorly soluble drug and a biocompatible polymer matrix.\",\n        \"A method of treating a disease comprising administering the pharmaceutical composition to a subject.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68621", "text": "{\n    \"patent_title\": \"Topical Cream Formulation for Dermatological Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A topical cream formulation for the treatment of skin conditions, providing localized drug delivery and reducing systemic side effects.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"assignee\": \"Johnson & Johnson\"\n        }\n    ],\n    \"claims\": [\n        \"A topical cream formulation comprising a therapeutic agent and a suitable carrier.\",\n        \"A method of treating a skin condition comprising applying the topical cream formulation to the affected area.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68622", "text": "{\n    \"patent_title\": \"Multi-Modal Medical Imaging System for Enhanced Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel medical imaging system combining MRI and PET scans for highly accurate tumor detection and staging. The system utilizes advanced image processing algorithms to enhance contrast and reduce noise, leading to improved diagnostic capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"cited_by\": \"Analysis of medical image contrast\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"cited_by\": \"MRI image reconstruction techniques\"\n        },\n        {\n            \"patent_number\": \"US11000001B2\",\n            \"cited_by\": \"PET scan technology enhancements\"\n        }\n    ],\n    \"claims\": [\n        \"A medical imaging system comprising an MRI module and a PET module.\",\n        \"The system of claim 1, further comprising an image processing module.\",\n        \"The image processing module of claim 2, configured to enhance image contrast.\",\n        \"A method for detecting tumors using the system of claim 1.\",\n        \"The method of claim 4, wherein the tumor detection is performed in real-time.\",\n        \"A computer-readable medium storing instructions for performing the method of claim 4.\",\n        \"The system of claim 1, wherein the MRI module is a 3T MRI scanner.\",\n        \"The system of claim 1, wherein the PET module uses F-18 fluorodeoxyglucose.\",\n        \"A system for displaying the combined MRI and PET images.\",\n        \"The system of claim 9, wherein the display provides a 3D visualization.\",\n        \"A method of quantifying tumor metabolic activity using the system of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68622", "text": "{\n    \"patent_title\": \"Improved X-ray Imaging Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"State University\"\n        }\n    ],\n    \"patent_number\": \"US11555555B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved X-ray imaging device with enhanced image clarity and reduced radiation exposure. The device utilizes a novel filter to improve image contrast.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8888888B2\",\n            \"cited_by\": \"Conventional X-ray techniques\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging device comprising an X-ray source and a detector.\",\n        \"The device of claim 1, further comprising a filter.\",\n        \"The filter of claim 2, configured to reduce radiation exposure.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68623", "text": "{\n    \"patent_title\": \"Early Cancer Detection Using Low-Dose Computed Tomography with AI-Powered Image Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2018-11-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for early cancer detection using low-dose computed tomography (CT) images enhanced by artificial intelligence (AI). The system minimizes radiation exposure and avoids the need for contrast agents, improving patient safety and reducing costs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in CT image reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancer in a subject comprising: acquiring a low-dose CT image of the subject; processing the CT image using an AI algorithm to enhance image quality; and identifying potential cancerous tissues based on the enhanced CT image.\",\n        \"The method of claim 1, wherein the AI algorithm is a deep convolutional neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68623", "text": "{\n    \"patent_title\": \"Contrast-Enhanced MRI for Improved Vascular Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2015-03-15\",\n    \"filing_date\": \"2015-03-15\",\n    \"issue_date\": \"2017-09-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved MRI technique utilizing a novel contrast agent to enhance visualization of blood vessels and detect vascular abnormalities. The contrast agent provides significantly increased signal-to-noise ratio.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art in MRI pulse sequences\"\n        }\n    ],\n    \"claims\": [\n        \"A method for imaging blood vessels in a subject comprising: administering a contrast agent to the subject; acquiring an MRI image of the subject; and visualizing the blood vessels based on the MRI image.\",\n        \"The contrast agent of claim 1 comprises gadolinium-based nanoparticles.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68624", "text": "{\n    \"patent_title\": \"Comfortable Implantable Cardiac Monitor\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Medtronic\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"An implantable cardiac monitor designed with a flexible lead and biocompatible materials for enhanced patient comfort and reduced irritation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Prior Art Cardiac Monitor\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Biocompatible Material Application\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Lead Design for Implants\"\n        },\n        {\n            \"patent_number\": \"US6543210B2\",\n            \"title\": \"Wireless Cardiac Monitoring\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiac monitor comprising a flexible lead...\",\n        \"The cardiac monitor of claim 1, wherein the lead is coated with a biocompatible material...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68624", "text": "{\n    \"patent_title\": \"Advanced Surgical Instrument\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"University of Barcelona\"\n        }\n    ],\n    \"patent_number\": \"EP3210987A1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2018-11-14\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"A novel surgical instrument designed for precise tissue dissection during minimally invasive procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Surgical Instrument Design\"\n        },\n        {\n            \"patent_number\": \"WO2015123456A1\",\n            \"title\": \"Minimally Invasive Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising a handle and a blade...\",\n        \"The surgical instrument of claim 1, wherein the blade is rotatable...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68625", "text": "{\n    \"patent_title\": \"AI-Powered Diagnostic System for Early Cancer Detection in Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-08-20\",\n    \"issue_date\": \"2023-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system utilizing deep learning algorithms to analyze medical images (X-rays, CT scans, MRIs) for early detection of cancerous tumors, improving diagnostic accuracy and patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting tumors in medical images using a convolutional neural network.\",\n        \"A system comprising a medical image input module, a deep learning processor, and a display module.\",\n        \"The system of claim 1, wherein the deep learning processor is trained on a dataset of labeled medical images.\",\n        \"The method of claim 1, further comprising a step of providing a probability score indicating the likelihood of tumor presence.\",\n        \"The method of claim 4, wherein the probability score is displayed to a medical professional.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68625", "text": "{\n    \"patent_title\": \"Method for Automated Bone Fracture Detection in X-ray Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2021-02-10\",\n    \"issue_date\": \"2022-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for automatically detecting bone fractures in X-ray images using image processing techniques. Designed specifically for radius and ulna fractures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting radius fractures in X-ray images.\",\n        \"A system comprising an X-ray image input, an image processing module, and a display module.\",\n        \"The method of claim 1, wherein the image processing module uses edge detection algorithms.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68626", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Point-of-Care Biomarker Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Chen\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for rapid and sensitive detection of biomarkers in biological samples. The device utilizes novel surface chemistry to enhance binding affinity and reduce non-specific adsorption, enabling accurate diagnosis of various diseases.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for detecting a biomarker comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68626", "text": "{\n    \"patent_title\": \"Improved MRI Coil Design for Enhanced Image Resolution\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved MRI coil design that provides enhanced signal-to-noise ratio and image resolution. The coil incorporates a novel shielding technique to minimize interference and improve image clarity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil comprising...\",\n        \"A method for generating an MRI image using the coil comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68627", "text": "{\n    \"patent_title\": \"Ultrasound Image Enhancement Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-09-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing ultrasound images using deep learning algorithms to improve image clarity and diagnostic accuracy. The invention utilizes a convolutional neural network trained on a large dataset of ultrasound images to remove noise and enhance features.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related art in image denoising.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an ultrasound image comprising...\",\n        \"A system for processing ultrasound data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68627", "text": "{\n    \"patent_title\": \"Improved MRI Coil Design for Enhanced Signal Reception\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2016-05-20\",\n    \"filing_date\": \"2016-05-20\",\n    \"issue_date\": \"2019-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved MRI coil design that enhances signal reception and improves image quality. The invention utilizes a novel coil geometry and shielding technique to reduce noise and artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"relevance\": \"Prior art in MRI coil technology.\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil comprising...\",\n        \"A method for receiving MRI signals...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68628", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Sensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-11-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable sensor for continuous glucose monitoring, providing real-time data for improved diabetes management and patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A sensor comprising a glucose-sensitive material.\",\n        \"A method for continuous glucose monitoring.\",\n        \"A system for data transmission.\",\n        \"A device for alerting patients to abnormal glucose levels.\",\n        \"A method for improving patient compliance through personalized feedback.\",\n        \"A biocompatible coating for the sensor.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68628", "text": "{\n    \"patent_title\": \"Stent Design for Coronary Artery Disease\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-05-20\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-09-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel stent design for treating coronary artery disease, aiming to reduce restenosis and improve blood flow.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A stent comprising a metallic alloy.\",\n        \"A method for deploying the stent.\",\n        \"A coating to prevent thrombosis.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68629", "text": "{\n    \"patent_title\": \"Controlled Release Microparticles for Enhanced Chemotherapy\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"MIT Lincoln Laboratory\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-06-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to novel microparticles for the controlled release of chemotherapeutic agents, enabling targeted drug delivery to tumor sites and minimizing systemic toxicity. The particles are biodegradable and biocompatible, exhibiting sustained release profiles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9546321B2\"\n        },\n        {\n            \"patent_number\": \"US8784892B2\"\n        }\n    ],\n    \"claims\": [\n        \"A microparticle comprising...\",\n        \"A method for treating cancer comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68629", "text": "{\n    \"patent_title\": \"Biocompatible Scaffold for Tissue Regeneration\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Evans\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2017-07-01\",\n    \"filing_date\": \"2017-07-01\",\n    \"issue_date\": \"2021-11-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel biocompatible scaffold designed to promote tissue regeneration in bone defects. The scaffold exhibits excellent mechanical properties and supports cell adhesion and proliferation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A scaffold comprising...\",\n        \"A method for promoting tissue regeneration...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68630", "text": "{\n    \"patent_title\": \"AI-Powered Diagnostic System for Early Cancer Detection in Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel system for automated cancer detection in medical images using deep learning algorithms. The system analyzes images to identify subtle patterns indicative of early-stage cancer, improving diagnostic accuracy and speed.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10987654B1\",\n            \"relevance\": \"Highly Relevant\"\n        },\n        {\n            \"patent_number\": \"US11012345B2\",\n            \"relevance\": \"Relevant\"\n        },\n        {\n            \"patent_number\": \"US11111111B2\",\n            \"relevance\": \"Moderately Relevant\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancer in medical images using a deep learning model.\",\n        \"A system comprising a medical imaging device and a deep learning processor.\",\n        \"A computer-readable medium storing instructions for performing cancer detection.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68630", "text": "{\n    \"patent_title\": \"Enhanced Display Technology for Medical Image Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11555555B2\",\n    \"priority_date\": \"2022-01-15\",\n    \"filing_date\": \"2022-01-15\",\n    \"issue_date\": \"2023-11-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved display system for visualizing medical images with enhanced contrast and clarity. The system utilizes a novel pixel arrangement and color calibration algorithm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Highly Relevant\"\n        }\n    ],\n    \"claims\": [\n        \"A display device for visualizing medical images.\",\n        \"A pixel arrangement for enhancing image contrast.\",\n        \"A color calibration algorithm for improving image accuracy.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68631", "text": "{\n    \"patent_title\": \"Magnetic Resonance Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-12-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing magnetic resonance images using deep learning techniques, resulting in improved image quality and reduced scan time. This method shows significant potential for earlier and more accurate disease diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"cited_by\": \"Self\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"cited_by\": \"Other\"\n        },\n        {\n            \"patent_number\": \"EP3123456A1\",\n            \"cited_by\": \"Other\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a magnetic resonance image...\",\n        \"A system comprising a magnetic resonance imaging device and a processor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68631", "text": "{\n    \"patent_title\": \"Enhanced X-ray Imaging with Iodine Contrast Agents\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-09-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to improvements in X-ray imaging utilizing iodine-based contrast agents to enhance the visibility of blood vessels and organs. The method allows for more detailed and accurate diagnosis of cardiovascular diseases.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"cited_by\": \"Other\"\n        }\n    ],\n    \"claims\": [\n        \"A method for X-ray imaging comprising administering an iodine-based contrast agent...\",\n        \"An X-ray imaging system configured to utilize iodine contrast agents...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68632", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A novel minimally invasive surgical system incorporating advanced fiber optic imaging and robotic control for precise tissue manipulation. This system represents a significant advancement over existing laparoscopic techniques, offering improved visualization and reduced patient trauma.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8540001B2\",\n            \"relevance\": \"Related prior art in laparoscopic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising a fiber optic imaging module...\",\n        \"A robotic arm configured for precise tissue manipulation...\",\n        \"A method for performing minimally invasive surgery...\",\n        \"A control system for coordinating the imaging module and robotic arm...\",\n        \"A display system for visualizing the surgical field...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68632", "text": "{\n    \"patent_title\": \"Improved Scalpel Handle Design\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Small Medical Device Company\"\n        }\n    ],\n    \"patent_number\": \"US9234567B1\",\n    \"priority_date\": \"2014-12-15\",\n    \"filing_date\": \"2014-12-12\",\n    \"issue_date\": \"2016-01-19\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"An improved scalpel handle design featuring an ergonomic grip and textured surface for enhanced control and comfort during surgical procedures. This is a modification of existing scalpel handle technology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"relevance\": \"Existing scalpel handle designs\"\n        }\n    ],\n    \"claims\": [\n        \"A scalpel handle comprising an ergonomic grip...\",\n        \"A textured surface on the scalpel handle...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68633", "text": "{\n    \"patent_title\": \"AI-Enhanced MRI Image Reconstruction for Improved Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention utilizes artificial intelligence algorithms to enhance the resolution and clarity of MRI images, leading to more accurate cancer detection and earlier diagnosis. The method significantly reduces noise and artifacts, improving the visibility of subtle lesions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"MRI Image Enhancement Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images using a deep learning model.\",\n        \"The method of claim 1, wherein the deep learning model is a convolutional neural network.\",\n        \"A system for performing MRI image reconstruction comprising a processor and a memory storing the deep learning model.\",\n        \"The system of claim 3, further comprising an MRI scanner.\",\n        \"A method for detecting cancer in MRI images using the reconstructed images.\",\n        \"The method of claim 5, wherein the cancer is breast cancer.\",\n        \"A computer-readable medium storing instructions for performing the method of claim 1.\",\n        \"A system for training a deep learning model for MRI image reconstruction.\",\n        \"The system of claim 8, wherein the training data includes MRI images of cancerous tissue.\",\n        \"The system of claim 8, wherein the training data includes MRI images of non-cancerous tissue.\",\n        \"The system of claim 8, wherein the training data includes paired images, with and without artifacts.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68633", "text": "{\n    \"patent_title\": \"Novel Contrast Agent for X-Ray Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2020-07-10\",\n    \"filing_date\": \"2020-07-10\",\n    \"issue_date\": \"2023-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new contrast agent for use in X-ray imaging, providing enhanced visibility of blood vessels and soft tissues. The agent is biocompatible and exhibits improved pharmacokinetic properties.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\",\n            \"title\": \"Contrast Agents for Medical Imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising a metal complex.\",\n        \"The contrast agent of claim 1, wherein the metal is iodine.\",\n        \"A method for enhancing X-ray images using the contrast agent.\",\n        \"The method of claim 3, wherein the images are of the cardiovascular system.\",\n        \"A pharmaceutical composition comprising the contrast agent.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68634", "text": "{\n    \"patent_title\": \"Enhanced Resolution MRI Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2020-12-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel deep learning approach for reconstructing high-resolution MRI images, overcoming limitations in traditional methods and significantly improving diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        },\n        {\n            \"patent_number\": \"US10123456B1\"\n        },\n        {\n            \"patent_number\": \"US11345678B2\"\n        },\n        {\n            \"patent_number\": \"US10456789B1\"\n        },\n        {\n            \"patent_number\": \"US11567890B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images...\",\n        \"A system comprising a deep learning model...\",\n        \"The method of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68634", "text": "{\n    \"patent_title\": \"Portable Ultrasound Device for Home Use\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": null\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2017-08-22\",\n    \"filing_date\": \"2017-08-22\",\n    \"issue_date\": \"2019-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A compact and affordable ultrasound device designed for personal medical monitoring at home.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        },\n        {\n            \"patent_number\": \"US9012345B1\"\n        }\n    ],\n    \"claims\": [\n        \"A portable ultrasound device comprising...\",\n        \"The device of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68635", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction Algorithm for MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel image reconstruction algorithm for magnetic resonance imaging (MRI) that significantly improves image quality and reduces scan time. The algorithm utilizes a deep learning approach to enhance image resolution and reduce artifacts, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"A system for performing MRI reconstruction...\",\n        \"A computer-readable medium storing instructions for...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68635", "text": "{\n    \"patent_title\": \"Novel Contrast Agent for Enhanced CT Scans\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Private Research Lab\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2023-08-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel contrast agent for use in computed tomography (CT) scans. The contrast agent improves the visibility of blood vessels and tissues, leading to enhanced diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent for CT scans comprising...\",\n        \"A method for enhancing CT images...\",\n        \"A composition for improving image contrast...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68636", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method for improving the clarity and analysis of medical images, specifically CT scans. It uses a novel filtering technique to reduce noise and enhance key features, aiding in more accurate diagnoses. The approach is relatively straightforward to implement and shows promising results in preliminary clinical trials.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing medical images comprising...\",\n        \"A system for enhancing image clarity...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68636", "text": "{\n    \"patent_title\": \"Advanced Signal Processing for Radar Systems\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a highly complex algorithm for advanced signal processing in radar systems, employing Fourier transforms, wavelet analysis, and adaptive filtering techniques. The system is designed for high-precision target detection and tracking in challenging electromagnetic environments. Its implementation requires significant computational resources and specialized expertise in signal processing theory. Specifically, this improves phase coherence for millimeter wave signals.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A radar signal processing system comprising...\",\n        \"A method for enhancing target detection accuracy...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68637", "text": "{\n    \"patent_title\": \"Minimally Invasive Cardiac Valve Replacement System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2020-12-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel minimally invasive system for the transcatheter replacement of cardiac valves. The system utilizes a self-expanding valve prosthesis delivered via a low-profile delivery catheter, reducing trauma to surrounding tissue and accelerating patient recovery.  The design incorporates advanced imaging integration for precise valve placement and minimizes the risk of paravalvular leak. Extensive testing demonstrates superior hemodynamic performance compared to existing technologies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\"\n        },\n        {\n            \"patent_number\": \"EP2876543A1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for transcatheter valve replacement comprising...\",\n        \"A delivery catheter for use with the system...\",\n        \"A valve prosthesis having self-expanding properties...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68637", "text": "{\n    \"patent_title\": \"Method for Monitoring Cardiac Rhythm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US7654321B2\",\n    \"priority_date\": \"2008-01-10\",\n    \"filing_date\": \"2009-01-10\",\n    \"issue_date\": \"2011-04-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method and apparatus for continuously monitoring a patient's cardiac rhythm using surface electrocardiography. The system provides real-time feedback to healthcare professionals. It does not involve any invasive procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US4556058\"\n        },\n        {\n            \"patent_number\": \"US6543210B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for monitoring cardiac rhythm comprising...\",\n        \"An apparatus for displaying cardiac waveforms...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68638", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical Instrument with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-06-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical instrument designed for minimally invasive procedures, featuring a high-resolution imaging system and ergonomic design.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising...\",\n        \"The surgical instrument of claim 1, further comprising...\",\n        \"A method for performing a surgical procedure...\",\n        \"The method of claim 3, wherein...\",\n        \"The instrument of claim 1, including...\",\n        \"The method of claim 3, using...\",\n        \"An imaging system for use with...\",\n        \"The imaging system of claim 7, capable of...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68638", "text": "{\n    \"patent_title\": \"Advanced Cardiac Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Davis\",\n            \"affiliation\": \"MedTech Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2022-01-10\",\n    \"filing_date\": \"2021-12-01\",\n    \"issue_date\": \"2022-07-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for continuously monitoring cardiac activity with real-time alerts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiac monitoring system comprising...\",\n        \"The system of claim 1, further comprising...\",\n        \"A method for monitoring cardiac activity...\",\n        \"The method of claim 3, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68639", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"This invention provides a novel method and system for reconstructing medical images with enhanced resolution and reduced noise, particularly in MRI and CT scans. The technique utilizes a deep learning algorithm to improve image quality and reduce artifacts, leading to more accurate diagnoses. This system addresses issues of low signal-to-noise ratio often encountered in pediatric imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in image denoising techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for enhancing the resolution of a medical image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68639", "text": "{\n    \"patent_title\": \"Theoretical Framework for Wavelet-Based Image Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"EP3456789B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2023-02-17\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"This invention presents a theoretical framework for efficient image compression using wavelet transforms. It explores the mathematical properties of wavelets and their application to lossless and lossy compression algorithms. It primarily focuses on the theoretical advantages of this method.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related work on wavelet transforms.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image using wavelet transforms...\",\n        \"A system for implementing a wavelet-based compression algorithm...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68640", "text": "{\n    \"patent_title\": \"Enhanced Magnetic Resonance Imaging for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-10-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel magnetic resonance imaging (MRI) technique utilizing advanced pulse sequences and image reconstruction algorithms to significantly improve the detection of early-stage cancerous tumors. The invention provides enhanced contrast and resolution, enabling more accurate diagnosis and treatment planning.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in MRI pulse sequences\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI...\",\n        \"An MRI system comprising...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68640", "text": "{\n    \"patent_title\": \"Improved Calibration Method for CT Scanners\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for improving the calibration of computed tomography (CT) scanners, resulting in more accurate image reconstruction and reduced radiation dose. The invention focuses on a new algorithm for correcting geometric distortions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous CT calibration techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for calibrating a CT scanner...\",\n        \"A CT scanner system including...\",\n        \"A computer program for...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68641", "text": "{\n    \"patent_title\": \"Magnetic Resonance Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for reconstructing magnetic resonance images using a deep learning algorithm to enhance image quality and diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for enhancing MRI image quality...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68641", "text": "{\n    \"patent_title\": \"Improved X-ray Imaging System with Reduced Radiation Dose\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved X-ray imaging system designed to reduce radiation exposure while maintaining image clarity. Utilizes advanced filtering techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A method for reducing radiation dose...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68642", "text": "{\n    \"patent_title\": \"High-Resolution Magnetic Resonance Imaging with Enhanced Contrast Agents\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-01-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for enhancing the resolution of magnetic resonance images using improved contrast agents and pulse sequences, leading to more accurate diagnostic capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8789012B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating high-resolution MRI images...\",\n        \"A contrast agent for use in MRI...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68642", "text": "{\n    \"patent_title\": \"Improved X-Ray Shielding for Dental Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-08-22\",\n    \"filing_date\": \"2017-08-22\",\n    \"issue_date\": \"2021-05-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel shielding system for dental X-ray machines, reducing radiation exposure to patients and operators.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray shielding system comprising...\",\n        \"A method for reducing radiation exposure...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68643", "text": "{\n    \"patent_title\": \"AI-Powered Diagnostic System for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A machine learning system utilizing deep convolutional neural networks for the early detection of cancerous tumors from medical imaging data. The system demonstrates improved accuracy and reduced false positive rates compared to existing methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Medical Image Analysis using CNNs\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancerous tumors in medical images using a deep learning model.\",\n        \"A system comprising a deep learning model trained on a dataset of medical images.\",\n        \"A computer-readable medium storing instructions for implementing the method.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68643", "text": "{\n    \"patent_title\": \"Cognitive Computing Framework for Personalized Medicine\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"IBM Research\"\n        },\n        {\n            \"name\": \"Sarah Chen\",\n            \"affiliation\": \"IBM Watson Health\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A cognitive computing framework designed to provide personalized medicine recommendations based on patient data and medical literature. Utilizes natural language processing and machine learning algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Natural Language Processing for Healthcare\"\n        }\n    ],\n    \"claims\": [\n        \"A system for generating personalized medicine recommendations.\",\n        \"A method for analyzing patient data using cognitive computing techniques.\",\n        \"A computer-readable medium storing a cognitive computing framework.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68644", "text": "{\n    \"patent_title\": \"AI-Enhanced Medical Image Reconstruction System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2022-11-15\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"This invention discloses a novel medical image reconstruction system utilizing artificial intelligence and deep learning algorithms to enhance image quality and reduce radiation exposure. The system leverages convolutional neural networks for improved image denoising and artifact reduction.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"The method of claim 1, wherein the artificial intelligence algorithm is a convolutional neural network.\",\n        \"The method of claim 1, further comprising reducing radiation exposure.\",\n        \"A system for reconstructing a medical image...\",\n        \"The system of claim 4, comprising a processor configured to execute the method of claim 1.\",\n        \"The system of claim 4, wherein the medical image is a CT scan.\",\n        \"The system of claim 4, wherein the medical image is an MRI scan.\",\n        \"The system of claim 4, wherein the medical image is an X-ray image.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68644", "text": "{\n    \"patent_title\": \"Improved X-Ray Imaging Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Klaus Schmidt\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"EP12345678B1\",\n    \"priority_date\": \"2020-01-15\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2023-03-20\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"This invention relates to an improved X-ray imaging device with enhanced contrast and resolution. The device utilizes a novel detector array and signal processing techniques for clearer image acquisition.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging device comprising...\",\n        \"The device of claim 1, wherein the detector array comprises...\",\n        \"The device of claim 1, further comprising a signal processing unit.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68645", "text": "{\n    \"patent_title\": \"Enhanced MRI Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A novel deep learning architecture for reconstructing MRI images, resulting in improved clarity and reduced scan time. The invention uses a generative adversarial network (GAN) to enhance image resolution and reduce artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in MRI reconstruction\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related work on GANs for image enhancement\"\n        },\n        {\n            \"patent_number\": \"US11000000B2\",\n            \"relevance\": \"Comparative study of image reconstruction algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for enhancing MRI image clarity using a GAN...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68645", "text": "{\n    \"patent_title\": \"Improved X-Ray Detection System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"EP3456789B1\",\n    \"priority_date\": \"2020-11-15\",\n    \"filing_date\": \"2020-11-15\",\n    \"issue_date\": \"2022-08-20\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"An X-ray detection system with improved sensitivity for detecting subtle anomalies in bone structures. The system uses a novel detector material and signal processing algorithm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Previous X-ray detection methods\"\n        },\n        {\n            \"patent_number\": \"EP2345678B1\",\n            \"relevance\": \"Related work on detector materials\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray detection system comprising...\",\n        \"A method for enhancing X-ray image contrast...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68646", "text": "{\n    \"patent_title\": \"Ultrasound Beamforming with Deep Learning for Enhanced Resolution\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2023-11-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel ultrasound beamforming technique utilizing deep learning algorithms to significantly improve image resolution and reduce noise. This system enhances the diagnostic capabilities of ultrasound imaging, offering a cost-effective alternative to other medical imaging modalities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in ultrasound signal processing.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for ultrasound beamforming comprising...\",\n        \"An ultrasound imaging system configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68646", "text": "{\n    \"patent_title\": \"Improved Gradient Echo MRI Sequence for Cardiac Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Chen\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Emily Wilson\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-03-10\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-07-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved gradient echo Magnetic Resonance Imaging (MRI) sequence specifically designed for high-resolution cardiac imaging. The sequence optimizes parameters to reduce artifacts and improve contrast, leading to more accurate diagnosis of cardiovascular diseases.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous work on gradient echo sequences.\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI sequence comprising...\",\n        \"A method for cardiac imaging using...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68647", "text": "{\n    \"patent_title\": \"Improved MRI Contrast Agents for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel MRI contrast agents that enhance the detection of small tumors at an early stage. The agents exhibit improved biocompatibility and targeted delivery, leading to higher sensitivity and specificity in cancer imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art on MRI contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancer comprising administering an MRI contrast agent...\",\n        \"An MRI contrast agent comprising a biocompatible core and a targeting ligand...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68647", "text": "{\n    \"patent_title\": \"Enhanced X-Ray Image Processing Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"Siemens Healthcare\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Siemens AG\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2023-04-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents an algorithm for improving the quality of X-ray images by reducing noise and enhancing contrast. It is particularly useful in detecting subtle fractures in bone imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related prior art on X-ray image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing X-ray images comprising applying a noise reduction filter...\",\n        \"An X-ray image processing system comprising a processor and memory...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68648", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system incorporating advanced imaging and robotic control for precise tissue manipulation. The system allows surgeons to perform complex procedures with reduced trauma and faster patient recovery times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8567890B2\",\n            \"citation_type\": \"Cited by applicant\"\n        },\n        {\n            \"patent_number\": \"US9123456B1\",\n            \"citation_type\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising a robotic arm...\",\n        \"An imaging module for real-time visualization...\",\n        \"A control system for precise tissue manipulation...\",\n        \"A method for performing minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68648", "text": "{\n    \"patent_title\": \"Surgical Instrument with Multiple Functions\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-09-20\",\n    \"filing_date\": \"2017-09-20\",\n    \"issue_date\": \"2020-12-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A multi-functional surgical instrument designed for a variety of surgical applications. It includes features for cutting, grasping, and cauterizing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"citation_type\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising a cutting blade...\",\n        \"A grasping mechanism...\",\n        \"A cauterization feature...\",\n        \"A handle for manipulating the instrument...\",\n        \"A locking mechanism...\",\n        \"A safety feature...\",\n        \"An ergonomic design...\",\n        \"A sterilization port...\",\n        \"A power supply interface...\",\n        \"A communication interface...\",\n        \"A diagnostic module...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68649", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system incorporating advanced imaging and robotic control for precise and less traumatic surgical procedures. The system improves patient recovery times and reduces post-operative complications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising a robotic arm...\",\n        \"An imaging module for enhanced visualization...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68649", "text": "{\n    \"patent_title\": \"Drug Delivery System for Cardiovascular Disease\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Williams\",\n            \"affiliation\": \"Johnson & Johnson\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-11-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel drug delivery system designed to target cardiovascular disease, improving the efficacy of medication and reducing side effects.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related to controlled release mechanisms\"\n        }\n    ],\n    \"claims\": [\n        \"A drug delivery system comprising a biocompatible polymer...\",\n        \"A method for targeted drug delivery to cardiovascular tissue...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68650", "text": "{\n    \"patent_title\": \"Method and Apparatus for Enhanced Energy Harvesting in Wearable Electronics\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2022-12-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for maximizing energy harvesting from ambient sources in wearable electronic devices, extending battery life through efficient power management and novel energy conversion techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art in energy harvesting\"\n        },\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"Cites similar power management strategies\"\n        },\n        {\n            \"patent_number\": \"US11543210B2\",\n            \"relevance\": \"References advanced material usage\"\n        }\n    ],\n    \"claims\": [\n        \"A method for harvesting energy from ambient vibrations in a wearable device.\",\n        \"An apparatus for converting ambient energy into electrical power.\",\n        \"A power management system for optimizing energy usage in a portable electronic device.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68650", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Cathode Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-03-10\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel cathode material for lithium-ion batteries exhibiting enhanced energy density and cycle life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art on lithium-ion cathode materials\"\n        }\n    ],\n    \"claims\": [\n        \"A cathode material comprising a novel metal oxide composition.\",\n        \"A lithium-ion battery utilizing the aforementioned cathode material.\",\n        \"A method for manufacturing the cathode material.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68651", "text": "{\n    \"patent_title\": \"High-Density Solid-State Battery for Portable Electronics\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-08-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel solid-state battery design utilizing a high-density electrolyte material, resulting in increased energy storage capacity and improved safety for portable electronic devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A solid-state battery comprising...\",\n        \"An electrolyte material characterized by...\",\n        \"A portable electronic device powered by...\",\n        \"A method for manufacturing the solid-state battery...\",\n        \"A system for monitoring the battery's performance...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68651", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery Recycling Process\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Carlos Rodriguez\",\n            \"affiliation\": \"National Renewable Energy Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2018-11-01\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A process for efficiently recycling lithium-ion batteries, recovering valuable materials such as cobalt and nickel. The process minimizes environmental impact and improves resource utilization.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for recycling lithium-ion batteries comprising...\",\n        \"A system for separating battery components...\",\n        \"A process for recovering cobalt...\",\n        \"A method for neutralizing hazardous materials...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68652", "text": "{\n    \"patent_title\": \"High-Capacity Lithium-Sulfur Battery with Novel Electrolyte Additive\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2022-12-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a lithium-sulfur battery with a novel electrolyte additive that significantly improves cycle life and capacity retention. The additive forms a stable solid electrolyte interphase (SEI) layer, mitigating polysulfide shuttle effects. The resulting battery demonstrates a capacity of 1500 mAh/g and maintains 80% capacity after 500 cycles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-sulfur battery comprising...\",\n        \"An electrolyte additive...\",\n        \"A method for improving the cycle life of a lithium-sulfur battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68652", "text": "{\n    \"patent_title\": \"Decorative Battery Casing with Enhanced Grip\",\n    \"inventors\": [\n        {\n            \"name\": \"Chris Miller\",\n            \"affiliation\": \"Energetic Designs Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2023-04-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a decorative casing for cylindrical batteries, featuring an improved textured grip surface. The casing is constructed from a thermoplastic material with a molded pattern to enhance user handling and aesthetics. It provides no changes to the internal battery chemistry or functionality.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A battery casing comprising...\",\n        \"A textured grip surface...\",\n        \"A thermoplastic material...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68653", "text": "{\n    \"patent_title\": \"Deep Convolutional Neural Networks for Enhanced Image Classification\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel deep convolutional neural network architecture for significantly improving image classification accuracy. The network incorporates attention mechanisms and residual connections to overcome the vanishing gradient problem. Applications include autonomous vehicles, medical image analysis, and security systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on convolutional neural networks\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image classification comprising...\",\n        \"An apparatus for image classification comprising...\",\n        \"A computer-readable medium storing instructions...\",\n        \"A neural network architecture characterized by...\",\n        \"The method of claim 1, wherein...\",\n        \"The apparatus of claim 2, wherein...\",\n        \"The computer-readable medium of claim 3, wherein...\",\n        \"The neural network architecture of claim 4, wherein...\",\n        \"A system for detecting objects in an image...\",\n        \"A method for training a convolutional neural network...\",\n        \"A method for improving image recognition performance...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68653", "text": "{\n    \"patent_title\": \"Image Processing Technique Using Fourier Transforms\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Generic Tech Corp\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method for image processing using Fourier transforms to enhance image clarity and reduce noise. It is suitable for various image types and applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art on Fourier transforms\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image processing comprising...\",\n        \"An apparatus for image processing comprising...\",\n        \"A system for enhancing image quality...\",\n        \"A technique for reducing noise in images...\",\n        \"The method of claim 1, wherein...\",\n        \"The apparatus of claim 2, wherein...\",\n        \"The system of claim 3, wherein...\",\n        \"The technique of claim 4, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68654", "text": "{\n    \"patent_title\": \"Novel Microfluidic Device for Rapid Point-of-Care Diagnostic Testing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-12-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for rapid and accurate detection of biomarkers for various diseases. The device utilizes a novel fluidic design to minimize reagent consumption and improve sensitivity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in microfluidic device design\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for detecting a biomarker...\",\n        \"The device of claim 1, wherein...\",\n        \"The method of claim 2, wherein...\",\n        \"A system for performing diagnostic testing...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68654", "text": "{\n    \"patent_title\": \"Improved Surgical Instrument Handle\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MedTech Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-15\",\n    \"issue_date\": \"2020-08-04\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved handle design for surgical instruments, providing enhanced grip and control for surgeons.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A surgical instrument handle comprising...\",\n        \"The handle of claim 1, wherein...\",\n        \"A method for using the handle...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68655", "text": "{\n    \"patent_title\": \"Micro-robotic System for Targeted Drug Delivery in Minimally Invasive Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2022-05-15\",\n    \"filing_date\": \"2022-08-20\",\n    \"issue_date\": \"2023-02-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A micro-robotic system designed for precise drug delivery to targeted tissues during minimally invasive surgeries. The system utilizes a magnetically guided catheter and real-time feedback control for enhanced accuracy and reduced patient trauma.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on micro-catheter design.\"\n        }\n    ],\n    \"claims\": [\n        \"A micro-robotic system comprising a magnetically guided catheter.\",\n        \"A method for targeted drug delivery using said system.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68655", "text": "{\n    \"patent_title\": \"Advanced Ultrasound Imaging System for Real-time Surgical Guidance\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-11-01\",\n    \"filing_date\": \"2022-03-15\",\n    \"issue_date\": \"2023-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An ultrasound imaging system providing high-resolution, real-time visualization of internal structures during surgical procedures, enabling enhanced precision and reduced risk.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art in ultrasound transducer technology.\"\n        }\n    ],\n    \"claims\": [\n        \"An ultrasound imaging system with enhanced resolution.\",\n        \"A method for surgical guidance using said system.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68656", "text": "{\n    \"patent_title\": \"Miniature Robotic Surgical System with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-05-15\",\n    \"issue_date\": \"2023-10-26\",\n    \"patent_office\": \"United States Patent and Trademark Office (USPTO)\",\n    \"abstract\": \"This invention discloses a miniaturized robotic surgical system designed for minimally invasive procedures. Utilizing advanced micro-robotics and real-time image guidance, the system enables surgeons to perform complex operations with unprecedented precision and reduced patient trauma. Pre-clinical trials demonstrate a significant reduction in recovery time and improved surgical outcomes compared to traditional laparoscopic methods. This system has the potential to revolutionize several surgical specialties including cardiology and urology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized robotic surgical system comprising...\",\n        \"A method for performing a minimally invasive surgical procedure using...\",\n        \"A control system for precise robotic manipulation...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68656", "text": "{\n    \"patent_title\": \"Improved Surgical Stapler Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Lars Schmidt\",\n            \"affiliation\": \"University of Berlin\"\n        }\n    ],\n    \"patent_number\": \"EP3876543B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2022-07-13\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"This invention relates to an improved surgical stapler design featuring a novel cartridge loading mechanism. The stapler aims to improve surgical efficiency and reduce the risk of staple malfunction.  Clinical trials show incremental improvements in stapling speed.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"relevance\": \"Prior art in surgical staplers\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising a novel cartridge loading mechanism...\",\n        \"A method for loading a staple cartridge into a stapler...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68657", "text": "{\n    \"patent_title\": \"Novel Contrast Agents for Improved Cardiovascular Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to novel contrast agents for use in cardiovascular magnetic resonance imaging (MRI). The agents exhibit enhanced relaxivity and biocompatibility, leading to improved image contrast and diagnostic accuracy. These agents demonstrate potential for early detection of myocardial infarction and improved patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Improved MRI Techniques\"\n        },\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"title\": \"Targeted Contrast Agents\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"A method for imaging cardiovascular tissue...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68657", "text": "{\n    \"patent_title\": \"Theoretical Modeling of Contrast Agent Interactions\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2022-03-15\",\n    \"filing_date\": \"2022-03-15\",\n    \"issue_date\": \"2024-02-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a computational model for understanding the interaction between contrast agents and biological tissues. The model utilizes advanced Monte Carlo simulations to predict agent distribution and signal enhancement. This work provides a theoretical framework for optimizing contrast agent design.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US5123456A\",\n            \"title\": \"Early Contrast Agent Research\"\n        },\n        {\n            \"patent_number\": \"US5678901B1\",\n            \"title\": \"Theoretical MRI Physics\"\n        }\n    ],\n    \"claims\": [\n        \"A computational model for simulating contrast agent behavior...\",\n        \"A method for predicting signal enhancement...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68658", "text": "{\n    \"patent_title\": \"Bioactive Scaffold for Bone Regeneration\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11253987B2\",\n    \"priority_date\": \"2021-07-15\",\n    \"filing_date\": \"2021-07-15\",\n    \"issue_date\": \"2023-12-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A three-dimensional bioactive scaffold composed of a novel polymer blend designed to promote bone cell adhesion, proliferation, and differentiation, leading to enhanced bone regeneration. The scaffold's mechanical properties and degradation rate are tailored for optimal healing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10876321B2\",\n            \"title\": \"Biodegradable Polymer Composition\"\n        }\n    ],\n    \"claims\": [\n        \"A scaffold comprising a polymer blend of PLA and PCL...\",\n        \"The scaffold of claim 1, further comprising a bioactive molecule...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68658", "text": "{\n    \"patent_title\": \"Drug Delivery System for Targeted Cancer Therapy\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"Pharmaceutical Inc.\"\n        },\n        {\n            \"name\": \"Dr. Ethan Foster\",\n            \"affiliation\": \"Pharmaceutical Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11123456B2\",\n    \"priority_date\": \"2020-03-10\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A nanoparticle-based drug delivery system designed to selectively target cancer cells and release a chemotherapeutic agent, minimizing systemic toxicity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US4585734\",\n            \"title\": \"Controlled Release Drug Delivery Device\"\n        },\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Nanoparticle Formulation\"\n        }\n    ],\n    \"claims\": [\n        \"A nanoparticle comprising a core of a chemotherapeutic agent...\",\n        \"The nanoparticle of claim 1, further comprising a targeting ligand...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68659", "text": "{\n    \"patent_title\": \"Miniature Robotic System for Laparoscopic Surgery\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-05-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature robotic system designed for performing minimally invasive laparoscopic surgeries. The system features high-precision actuators and a flexible endoscope for enhanced maneuverability within the body.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art related to robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system comprising a miniature end-effector.\",\n        \"A method for performing laparoscopic surgery using a robotic system.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68659", "text": "{\n    \"patent_title\": \"Surgical Method and Apparatus for Coronary Artery Bypass Grafting\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Wilson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2022-05-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical method and apparatus for performing coronary artery bypass grafting. The device improves blood flow during surgery and minimizes patient recovery time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Relevant prior art in cardiac surgery.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical apparatus for performing coronary artery bypass grafting.\",\n        \"A method for improving blood flow during cardiac surgery.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68660", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing high-resolution medical images from limited data, utilizing deep learning techniques to improve image quality and reduce artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in image denoising\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"A system comprising a processor...\",\n        \"The method of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68660", "text": "{\n    \"patent_title\": \"Image Compression Technique Utilizing Wavelet Transforms\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An efficient image compression algorithm based on wavelet transforms for reducing storage space and transmission bandwidth.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related art in image compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image...\",\n        \"A system comprising a wavelet transform module...\",\n        \"The method of claim 1, wherein...\",\n        \"The method of claim 2, wherein...\",\n        \"The method of claim 3, wherein...\",\n        \"The method of claim 4, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68661", "text": "{\n    \"patent_title\": \"Miniaturized Robotic Catheter System for Targeted Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized robotic catheter system for precise drug delivery to targeted tissues. The system utilizes a flexible catheter with integrated sensors and actuators, enabling minimally invasive procedures with enhanced accuracy and reduced patient trauma. The system is designed to minimize recovery time and improve patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art in catheter design\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic catheter system comprising a flexible catheter body...\",\n        \"A method for targeted drug delivery using the robotic catheter system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68661", "text": "{\n    \"patent_title\": \"Improved Stent Design for Coronary Artery Disease\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-11-15\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2022-04-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved stent design for treating coronary artery disease. The stent features a modified surface coating to reduce the risk of thrombosis and improve biocompatibility. This is an incremental improvement to existing stent technologies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous generation stent design\"\n        },\n        {\n            \"patent_number\": \"US9654321B2\",\n            \"relevance\": \"Related surface coating technology\"\n        },\n        {\n            \"patent_number\": \"US9543210B2\",\n            \"relevance\": \"Similar stent material\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Prior art in stent deployment methods\"\n        },\n        {\n            \"patent_number\": \"US10234567B2\",\n            \"relevance\": \"Relevant patent related to biocompatibility\"\n        },\n        {\n            \"patent_number\": \"US11345678B2\",\n            \"relevance\": \"Further improvement on stent design\"\n        },\n        {\n            \"patent_number\": \"US12456789B2\",\n            \"relevance\": \"Relevant technology for stent manufacture\"\n        },\n        {\n            \"patent_number\": \"US13567890B2\",\n            \"relevance\": \"Related to the use of the stent.\"\n        },\n        {\n            \"patent_number\": \"US14678901B2\",\n            \"relevance\": \"Further refinement of stent material.\"\n        },\n        {\n            \"patent_number\": \"US15789012B2\",\n            \"relevance\": \"Related to the delivery system for stent\"\n        },\n        {\n            \"patent_number\": \"US16890123B2\",\n            \"relevance\": \"Refinement of surface coatings.\"\n        },\n        {\n            \"patent_number\": \"US17901234B2\",\n            \"relevance\": \"Stent manufacture process.\"\n        }\n    ],\n    \"claims\": [\n        \"A stent comprising a metallic framework...\",\n        \"A surface coating for a stent...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68662", "text": "{\n    \"patent_title\": \"Deep Learning Enhanced MRI Reconstruction for Improved Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2023-08-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention utilizes deep learning algorithms to significantly improve the resolution and accuracy of MRI images, leading to earlier and more reliable cancer detection. The method addresses limitations in traditional reconstruction techniques and offers substantial diagnostic improvements. The deep learning model is trained on a large dataset of MRI scans, enabling robust and accurate image reconstruction even with noisy data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"MRI Image Reconstruction Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for enhancing MRI image quality using deep learning...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68662", "text": "{\n    \"patent_title\": \"Improved X-ray Tube Design for Lower Radiation Dose\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2022-01-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel X-ray tube design that reduces radiation exposure to patients during medical imaging procedures. The design incorporates a modified anode and improved cooling system to enhance efficiency and minimize heat buildup. The improvements are incremental and aim to optimize existing X-ray technology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"X-ray Tube with Enhanced Cooling\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube comprising...\",\n        \"A cooling system for an X-ray tube...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68663", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Pathogen Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-06-15\",\n    \"issue_date\": \"2023-02-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for rapid and sensitive detection of pathogens using novel materials and integrated sensors.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"Prior art in microfluidics\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for detecting pathogens...\",\n        \"The device of claim 1, wherein the material is a biocompatible polymer.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68663", "text": "{\n    \"patent_title\": \"Implantable Cardiac Pacemaker with Advanced Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2021-01-15\",\n    \"issue_date\": \"2022-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac pacemaker with advanced monitoring capabilities and adaptive pacing algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"relevance\": \"Previous pacemaker technology\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable cardiac pacemaker...\",\n        \"A method for pacing the heart...\",\n        \"The pacemaker of claim 1, comprising a biocompatible housing.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68664", "text": "{\n    \"patent_title\": \"Enhanced Image Reconstruction for Low-Dose CT Scanning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2020-11-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides methods and systems for reconstructing high-quality CT images from low-dose radiation data, reducing patient exposure while maintaining diagnostic accuracy.  Utilizes a novel deep learning approach for noise reduction and artifact removal.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\",\n            \"count\": 1\n        },\n        {\n            \"patent_number\": \"US12345678B2\",\n            \"count\": 1\n        },\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"count\": 1\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a CT image...\",\n        \"A system for performing low-dose CT scanning...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68664", "text": "{\n    \"patent_title\": \"Improved MRI Coil Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11889900B1\",\n    \"priority_date\": \"2021-02-15\",\n    \"filing_date\": \"2021-02-15\",\n    \"issue_date\": \"2022-08-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel design for MRI coils, improving signal-to-noise ratio and reducing scan time. The coil incorporates a new material with enhanced magnetic properties.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10990011B2\",\n            \"count\": 1\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil comprising...\",\n        \"A method of using the MRI coil...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68665", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Recognition System for Autonomous Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2020-05-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel image recognition system utilizing deep learning techniques, specifically convolutional neural networks, for object detection and classification in autonomous vehicles. The system enhances safety and efficiency by accurately identifying pedestrians, vehicles, and traffic signs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a deep neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68665", "text": "{\n    \"patent_title\": \"MRI Image Analysis Using Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2021-11-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for analyzing medical images, specifically MRI scans, using a neural network architecture. The system accurately identifies tumors and other anomalies, aiding in early diagnosis and treatment planning.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for analyzing MRI images...\",\n        \"A system for detecting anomalies in MRI scans...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68666", "text": "{\n    \"patent_title\": \"Novel Contrast Agent for Enhanced Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel contrast agent is disclosed for enhancing magnetic resonance imaging (MRI). The agent significantly improves visualization of microvasculature and tumor detection, resulting in increased diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"MRI Contrast Agents based on Iron Oxide Nanoparticles\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising a biocompatible core and a targeting ligand.\",\n        \"A method for enhancing MRI images using the contrast agent.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68666", "text": "{\n    \"patent_title\": \"Improved X-ray Imaging System with Reduced Radiation Dose\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        },\n        {\n            \"name\": \"Dr. Emily Wilson\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2015-11-20\",\n    \"filing_date\": \"2015-11-20\",\n    \"issue_date\": \"2018-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved X-ray imaging system that reduces radiation exposure to patients while maintaining image quality. The system utilizes advanced filtering techniques and detector technology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Digital X-ray Imaging System\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising a radiation source and a detector.\",\n        \"A method for reducing radiation dose in X-ray imaging.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68667", "text": "{\n    \"patent_title\": \"Robotic Surgical System for Laparoscopic Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2019-03-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A robotic surgical system for performing minimally invasive laparoscopic procedures. The system utilizes advanced robotics and automation to enhance precision and dexterity during surgery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system comprising...\",\n        \"A method for performing laparoscopic surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68667", "text": "{\n    \"patent_title\": \"Implantable Cardiovascular Stent with Drug Delivery System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. John Smith\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Dr. Jane Doe\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiovascular stent with a controlled drug delivery system for the treatment of coronary artery disease. The stent is designed for minimally invasive placement.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiovascular stent comprising...\",\n        \"A method for treating coronary artery disease...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68668", "text": "{\n    \"patent_title\": \"Wearable Sensor System for Continuous Glucose Monitoring and Automated Insulin Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-11-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wearable sensor system for continuous glucose monitoring and automated insulin delivery, providing real-time data transmission to a remote monitoring center. The system incorporates features to enhance patient adherence to treatment plans.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A wearable sensor for continuous glucose monitoring.\",\n        \"A system for automated insulin delivery based on sensor data.\",\n        \"A method for improving patient compliance with diabetes treatment.\",\n        \"A remote monitoring system for real-time data analysis.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68668", "text": "{\n    \"patent_title\": \"Implantable Cardiac Pacemaker with Remote Monitoring Capabilities\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-09-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac pacemaker with remote monitoring capabilities, allowing physicians to remotely adjust device settings and monitor patient heart rhythm. The system facilitates proactive intervention in case of arrhythmias.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable cardiac pacemaker.\",\n        \"A remote monitoring system for cardiac devices.\",\n        \"A method for remotely adjusting pacemaker settings.\",\n        \"A system for detecting and responding to arrhythmias.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68669", "text": "{\n    \"patent_title\": \"Efficient Image Segmentation Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-10-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel approach to image segmentation utilizing deep convolutional neural networks. The key innovation lies in a streamlined architecture that reduces computational complexity without significant loss of accuracy, resulting in faster processing times for real-time applications. The method employs a modified U-Net architecture with optimized convolutional layers and a novel loss function to improve segmentation performance, particularly in low-light conditions. Extensive experimental results demonstrate superior performance compared to state-of-the-art methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image segmentation comprising...\",\n        \"A system for real-time image analysis...\",\n        \"A convolutional neural network architecture...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68669", "text": "{\n    \"patent_title\": \"Image Filtering Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corp\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2019-05-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A basic image filter.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for filtering an image.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68670", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Chen\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2021-11-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system utilizing advanced imaging and robotic assistance to improve precision and reduce patient recovery time. The system enhances visualization during complex procedures and reduces the risk of complications. It represents a significant advancement in surgical technology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A minimally invasive surgical system comprising...\",\n        \"A method for performing a surgical procedure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68670", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Vascular Access\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MedTech Solutions Inc.\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MedTech Solutions Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-04-10\",\n    \"issue_date\": \"2021-09-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel catheter design featuring a modified tip for improved vascular access. This design reduces the risk of vessel damage during insertion. It is an improvement over existing catheter designs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Existing catheter designs\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a modified tip...\",\n        \"A method for accessing a blood vessel...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68671", "text": "{\n    \"patent_title\": \"Microfluidic Device for Continuous Monitoring of Biomarkers in Chronic Kidney Disease\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2021-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for continuous, real-time monitoring of biomarkers in bodily fluids, specifically targeting patients with chronic kidney disease. The device enables early detection of disease progression and personalized treatment strategies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Similar microfluidic design\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for monitoring biomarkers...\",\n        \"A system for analyzing bodily fluids...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68671", "text": "{\n    \"patent_title\": \"Novel Chemotherapy Drug for Treatment of Leukemia\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Pharmaceutical Corp\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2018-11-20\",\n    \"filing_date\": \"2019-12-25\",\n    \"issue_date\": \"2021-06-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel chemotherapy drug targeting specific cancer cells in patients with leukemia. The drug exhibits improved efficacy and reduced side effects compared to existing treatments.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related chemotherapy compounds\"\n        }\n    ],\n    \"claims\": [\n        \"A pharmaceutical composition comprising...\",\n        \"A method for treating leukemia...\",\n        \"A dosage regimen for administering the drug...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68672", "text": "{\n    \"patent_title\": \"Improved MRI Contrast Agent Detection System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel MRI contrast agent detection system utilizing advanced signal processing techniques to improve image clarity and diagnostic accuracy. This system allows for earlier and more reliable detection of subtle anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on MRI signal processing\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related contrast agent technologies\"\n        },\n        {\n            \"patent_number\": \"US9543210B2\",\n            \"relevance\": \"Signal Enhancement Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting MRI contrast agents comprising...\",\n        \"An apparatus for use in MRI imaging...\",\n        \"A system for enhancing MRI image clarity...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68672", "text": "{\n    \"patent_title\": \"Novel X-Ray Diffraction Analysis Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2021-05-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a new method for analyzing crystal structures using X-ray diffraction. It features highly accurate data processing and visualization capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Baseline X-ray diffraction method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for analyzing crystal structures comprising...\",\n        \"An apparatus for performing X-ray diffraction...\",\n        \"A system for data processing...\",\n        \"A method for peak identification...\",\n        \"A method for lattice parameter determination...\",\n        \"A method for space group assignment...\",\n        \"A method for refinement of structural models...\",\n        \"A method for visualizing crystal structures...\",\n        \"A method for calculating diffraction patterns...\",\n        \"A method for analyzing powder diffraction data...\",\n        \"A method for determining the phase composition of a material...\",\n        \"A method for characterizing the crystallographic orientation of a material...\",\n        \"A method for identifying defects in crystal structures...\",\n        \"A method for studying phase transitions...\",\n        \"A method for analyzing the effects of temperature and pressure on crystal structures...\",\n        \"A method for analyzing the effects of stress on crystal structures...\",\n        \"A method for analyzing the effects of radiation on crystal structures...\",\n        \"A method for analyzing the effects of chemical reactions on crystal structures...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68673", "text": "{\n    \"patent_title\": \"High-Resolution Magnetic Resonance Imaging with Compressed Sensing\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for high-resolution magnetic resonance imaging (MRI) utilizing compressed sensing techniques to reduce scan time and improve image quality. This invention utilizes novel reconstruction algorithms to enhance image resolution and contrast.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8000000B1\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI comprising acquiring undersampled k-space data.\",\n        \"The method of claim 1, wherein the undersampled k-space data is acquired using a compressed sensing technique.\",\n        \"A system for performing MRI comprising a magnetic resonance apparatus and a processor configured to reconstruct an image from undersampled k-space data.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68673", "text": "{\n    \"patent_title\": \"Medical Image Display System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US7654321B1\",\n    \"priority_date\": \"2010-12-01\",\n    \"filing_date\": \"2010-12-01\",\n    \"issue_date\": \"2014-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for displaying medical images on a computer monitor. The system includes a graphical user interface for viewing and manipulating the images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US5000000A\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A system for displaying medical images comprising a computer monitor and a software application.\",\n        \"The system of claim 1, wherein the software application includes a zoom function.\",\n        \"The system of claim 1, wherein the software application includes a pan function.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68674", "text": "{\n    \"patent_title\": \"Ultrasound-Based System for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive ultrasound system for detecting cancerous tumors at early stages by analyzing tissue elasticity and microvascular changes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8785234B2\",\n            \"relevance\": \"Prior art on ultrasound imaging techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancer using ultrasound imaging.\",\n        \"An ultrasound device configured for early cancer detection.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68674", "text": "{\n    \"patent_title\": \"MRI-Based Diagnostic Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Hans Schmidt\",\n            \"affiliation\": \"Siemens Healthineers\"\n        },\n        {\n            \"name\": \"Maria Gruber\",\n            \"affiliation\": \"Siemens AG\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-09-20\",\n    \"filing_date\": \"2017-09-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An MRI system with enhanced image resolution and processing capabilities for detailed anatomical imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related to high-resolution MRI techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI apparatus with improved signal-to-noise ratio.\",\n        \"A method for reconstructing MRI images with enhanced clarity.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68675", "text": "{\n    \"patent_title\": \"Enhanced MRI Image Reconstruction Method for Early Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing MRI images utilizing a deep learning algorithm to enhance clarity and improve the detection of small tumors. This technology allows for earlier and more accurate cancer diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for identifying tumors in MRI images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68675", "text": "{\n    \"patent_title\": \"Improved CT Scanning Technique with Reduced Radiation Dose\",\n    \"inventors\": [\n        {\n            \"name\": \"Carl Schmidt\",\n            \"affiliation\": \"Siemens Healthineers\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new CT scanning technique that significantly reduces the radiation dose to patients while maintaining image quality. This invention is designed for routine diagnostic imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\",\n            \"relevance\": \"Prior art on CT scanning\"\n        }\n    ],\n    \"claims\": [\n        \"A CT scanning method comprising...\",\n        \"A system for reducing radiation exposure...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68676", "text": "{\n    \"patent_title\": \"Novel MRI Contrast Agent for Enhanced Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel MRI contrast agent utilizing nanoparticle technology to significantly enhance tumor detection sensitivity and specificity. The agent exhibits improved biocompatibility and reduced toxicity compared to existing contrast agents.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"MRI Contrast Agents\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing tumor detection using the novel MRI contrast agent.\",\n        \"The MRI contrast agent comprising nanoparticles with a specific surface coating.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68676", "text": "{\n    \"patent_title\": \"Improved X-Ray Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Ramirez\",\n            \"affiliation\": \"University of Buenos Aires\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved X-ray imaging system with enhanced resolution and reduced radiation exposure. This system uses a novel detector array and image processing algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"X-Ray Imaging Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising a novel detector array.\",\n        \"A method for reducing radiation exposure in X-ray imaging.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68677", "text": "{\n    \"patent_title\": \"Method for Noise Reduction in Low-Dose CT Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reducing noise in computed tomography (CT) images acquired with low radiation doses, utilizing a deep learning-based denoising algorithm. This results in improved image clarity while minimizing patient exposure to ionizing radiation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"title\": \"Prior Art CT Image Reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a CT image comprising...\",\n        \"The method of claim 1, wherein the denoising algorithm is based on a convolutional neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68677", "text": "{\n    \"patent_title\": \"Improved X-Ray Tube Cooling System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-08-01\",\n    \"filing_date\": \"2017-08-01\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved cooling system for X-ray tubes, enhancing heat dissipation and allowing for higher power operation. The system includes a novel fluid dynamic design and advanced materials.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Conventional X-Ray Tube Cooling\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube cooling system comprising...\",\n        \"The system of claim 1, wherein the cooling fluid is a water-glycol mixture.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68678", "text": "{\n    \"patent_title\": \"Improved MRI Image Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing MRI images using a deep learning network, resulting in improved image quality and reduced scan time. This enhances diagnostic capabilities for various medical conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Prior Art MRI Reconstruction\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Deep Learning in Medical Imaging\"\n        },\n        {\n            \"patent_number\": \"US11000001B2\",\n            \"title\": \"Advanced Image Processing Techniques\"\n        },\n        {\n            \"patent_number\": \"US11111111B2\",\n            \"title\": \"Contrast Enhancement in MRI\"\n        },\n        {\n            \"patent_number\": \"US11222222B2\",\n            \"title\": \"Noise Reduction Algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images using a deep learning network.\",\n        \"A system comprising a MRI scanner and a deep learning module for image reconstruction.\",\n        \"The method of claim 1, wherein the deep learning network is a convolutional neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68678", "text": "{\n    \"patent_title\": \"Medical Device for Bone Fracture Stabilization\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-12-01\",\n    \"filing_date\": \"2018-12-01\",\n    \"issue_date\": \"2021-09-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel medical device for stabilizing bone fractures utilizing a biocompatible alloy and a unique locking mechanism.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Prior Art Fracture Device\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Biocompatible Materials\"\n        },\n        {\n            \"patent_number\": \"EP1234567B1\",\n            \"title\": \"Surgical Implant Design\"\n        }\n    ],\n    \"claims\": [\n        \"A medical device for stabilizing bone fractures comprising a biocompatible alloy.\",\n        \"The medical device of claim 1, wherein the alloy comprises titanium.\",\n        \"A method for stabilizing a bone fracture using the medical device of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68679", "text": "{\n    \"patent_title\": \"Magnetic Resonance Elastography with Compressed Sensing Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10548923B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel approach to magnetic resonance elastography (MRE) utilizing compressed sensing reconstruction. By acquiring fewer data points and employing advanced algorithms, the invention significantly reduces scan time while maintaining image quality. The method enables enhanced detection of subtle tissue abnormalities and improved diagnostic accuracy in various medical applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related technique\"\n        },\n        {\n            \"patent_number\": \"US10234567B2\",\n            \"relevance\": \"Prior art in signal processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing magnetic resonance elastography comprising...\",\n        \"The method of claim 1, wherein the compressed sensing reconstruction algorithm...\",\n        \"A system for performing magnetic resonance elastography...\",\n        \"The system of claim 3, further comprising...\",\n        \"A computer-readable medium storing instructions for...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68679", "text": "{\n    \"patent_title\": \"Digital Radiography System with Improved Scatter Reduction\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US8995876B2\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2019-03-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a digital radiography system with an improved scatter reduction grid. The system provides enhanced image clarity and reduced radiation dose to the patient.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art scatter grid design\"\n        }\n    ],\n    \"claims\": [\n        \"A digital radiography system comprising...\",\n        \"The system of claim 1, wherein the scatter reduction grid...\",\n        \"A method for acquiring a radiographic image...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68680", "text": "{\n    \"patent_title\": \"Enhanced MRI Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"National Institutes of Health\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-12-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing MRI images using deep learning techniques, resulting in improved image quality and reduced scan time. Particularly effective in imaging brain tissue.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68680", "text": "{\n    \"patent_title\": \"Improved X-Ray Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US4500000\",\n    \"priority_date\": \"1985-01-01\",\n    \"filing_date\": \"1985-01-01\",\n    \"issue_date\": \"1985-05-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved X-ray imaging system with enhanced resolution and reduced radiation exposure.\",\n    \"citations\": [],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A method for obtaining X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68681", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2021-11-23\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A method and system for enhancing the quality of medical images reconstructed from limited data, resulting in improved image clarity and reduced patient radiation exposure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in image reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"A system comprising a detector...\",\n        \"The method of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68681", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"Max Planck Institute\"\n        }\n    ],\n    \"patent_number\": \"EP3456789B1\",\n    \"priority_date\": \"2020-02-01\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2022-09-12\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"A novel contrast agent for magnetic resonance imaging, providing enhanced image contrast and improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"relevance\": \"Prior art related to MRI contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"A method for enhancing MRI images...\",\n        \"The contrast agent of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68682", "text": "{\n    \"patent_title\": \"Improved MRI Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning approach for improving the reconstruction quality of MRI images, leading to enhanced diagnostic capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        },\n        {\n            \"patent_number\": \"US11111111B2\"\n        },\n        {\n            \"patent_number\": \"US12222222B2\"\n        },\n        {\n            \"patent_number\": \"US13333333B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images using a deep neural network.\",\n        \"A system for performing MRI reconstruction with improved image quality.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68682", "text": "{\n    \"patent_title\": \"Digital X-ray Image Enhancement System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-01-15\",\n    \"filing_date\": \"2022-01-15\",\n    \"issue_date\": \"2023-11-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing the clarity and contrast of digital X-ray images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        },\n        {\n            \"patent_number\": \"US85432109B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for enhancing X-ray image contrast.\",\n        \"A method for filtering noise in X-ray images.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68683", "text": "{\n    \"patent_title\": \"Deep Learning-Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-11-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention utilizes deep learning algorithms to reconstruct high-resolution medical images from low-dose data, improving diagnostic accuracy while reducing patient radiation exposure. The method employs a novel convolutional neural network architecture for enhanced feature extraction and image restoration.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in image denoising\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing medical images using deep learning.\",\n        \"A system for reducing radiation dose in medical imaging.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68683", "text": "{\n    \"patent_title\": \"Improved X-Ray Tube Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2017-12-01\",\n    \"filing_date\": \"2017-12-01\",\n    \"issue_date\": \"2019-05-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved design for X-ray tubes, increasing their efficiency and lifespan. The design incorporates a novel cooling system and a modified filament structure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Previous X-ray tube designs\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube with an improved cooling system.\",\n        \"An X-ray tube with a modified filament structure.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68684", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical Device with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a minimally invasive surgical device incorporating a novel fiber optic system for enhanced visualization during complex procedures. The device allows surgeons to perform operations with greater precision and reduced patient trauma. It has features for remote control and real-time imaging analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in minimally invasive surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical device comprising a fiber optic system for enhanced visualization.\",\n        \"The surgical device of claim 1, further comprising a remote control mechanism.\",\n        \"The surgical device of claim 2, wherein the remote control mechanism allows for precise manipulation of surgical instruments.\",\n        \"The surgical device of claim 1, wherein the fiber optic system provides real-time imaging analysis.\",\n        \"The surgical device of claim 1, suitable for laparoscopic procedures.\",\n        \"The surgical device of claim 1, having an ergonomic handle design.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68684", "text": "{\n    \"patent_title\": \"Diagnostic Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9123456B2\",\n    \"priority_date\": \"2016-08-01\",\n    \"filing_date\": \"2017-02-10\",\n    \"issue_date\": \"2018-01-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved diagnostic imaging system utilizing magnetic resonance imaging technology for detailed anatomical visualization. The system offers enhanced image clarity and faster scan times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Previous MRI technology\"\n        }\n    ],\n    \"claims\": [\n        \"A diagnostic imaging system utilizing magnetic resonance imaging.\",\n        \"The diagnostic imaging system of claim 1, comprising an enhanced gradient coil.\",\n        \"The diagnostic imaging system of claim 1, having a user interface for image analysis.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68685", "text": "{\n    \"patent_title\": \"Surgical Robotic System with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Jian Li\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-05-15\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical robotic system designed for minimally invasive procedures, incorporating advanced sensors and robotic assistance for enhanced precision and dexterity. The system allows surgeons to perform complex operations with greater control and reduced patient trauma.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Minimally Invasive Surgical Instrument\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic system comprising a robotic arm...\",\n        \"The system of claim 1, further comprising a sensor...\",\n        \"The sensor of claim 2, configured to provide haptic feedback...\",\n        \"A method for performing a minimally invasive surgery...\",\n        \"The method of claim 4, using robotic assistance...\",\n        \"The method of claim 5, comprising real-time image guidance...\",\n        \"A control system for a surgical robot...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68685", "text": "{\n    \"patent_title\": \"Improved Scalpel Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"State University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-20\",\n    \"filing_date\": \"2019-11-20\",\n    \"issue_date\": \"2021-03-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved scalpel design for surgical procedures, featuring a more ergonomic handle and a sharper blade for cleaner incisions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Surgical Scalpel\"\n        }\n    ],\n    \"claims\": [\n        \"A scalpel comprising a blade...\",\n        \"The scalpel of claim 1, further comprising a handle...\",\n        \"The handle of claim 2, having an ergonomic design...\",\n        \"A method of making a surgical incision...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68686", "text": "{\n    \"patent_title\": \"Method for Noise Reduction in Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2017-05-15\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reducing noise in magnetic resonance images, improving image clarity and diagnostic accuracy. The method utilizes a wavelet transform based filtering algorithm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"relevance\": \"Similar noise reduction technique\"\n        },\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"relevance\": \"Related wavelet transform application\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art in MRI image processing\"\n        },\n        {\n            \"patent_number\": \"US10234567B1\",\n            \"relevance\": \"Alternative MRI imaging protocol\"\n        },\n        {\n            \"patent_number\": \"US11345678B2\",\n            \"relevance\": \"Improved contrast agent for MRI\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"relevance\": \"Application of deep learning to MRI reconstruction\"\n        },\n        {\n            \"patent_number\": \"US9456789B2\",\n            \"relevance\": \"Advanced motion correction in MRI\"\n        },\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"relevance\": \"Faster MRI acquisition techniques\"\n        },\n        {\n            \"patent_number\": \"US10567890B2\",\n            \"relevance\": \"Quantitative MRI analysis methods\"\n        },\n        {\n            \"patent_number\": \"US11678901B2\",\n            \"relevance\": \"Optimization of MRI pulse sequences\"\n        },\n        {\n            \"patent_number\": \"US9789012B2\",\n            \"relevance\": \"Artifact reduction in MRI\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing noise in a magnetic resonance image comprising...\",\n        \"The method of claim 1, wherein the wavelet transform is a Daubechies wavelet.\",\n        \"A system for performing magnetic resonance imaging comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68686", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Angiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Charles Davis\",\n            \"affiliation\": \"Medtronic Inc.\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2018-01-10\",\n    \"filing_date\": \"2018-01-10\",\n    \"issue_date\": \"2020-11-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel catheter design for use in angiography, providing improved maneuverability and reduced patient discomfort.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art in catheter design\"\n        },\n        {\n            \"patent_number\": \"US8543210B2\",\n            \"relevance\": \"Related catheter material\"\n        },\n        {\n            \"patent_number\": \"US9432109B2\",\n            \"relevance\": \"Alternative angiography techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter for angiography comprising...\",\n        \"The catheter of claim 1, wherein the catheter tip is steerable.\",\n        \"A method of performing angiography using the catheter of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68687", "text": "{\n    \"patent_title\": \"Miniature Robotic Catheter for Targeted Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"This invention relates to a miniature robotic catheter system for targeted drug delivery to specific locations within the human body. The system enables minimally invasive procedures with improved precision and reduced patient trauma. It utilizes micro-robotics and advanced imaging techniques for accurate navigation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Micro-Robotic Systems for Medical Applications\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic catheter comprising a micro-robotically controlled tip.\",\n        \"A system for targeted drug delivery using the robotic catheter.\",\n        \"A method for minimally invasive surgery utilizing the robotic catheter.\",\n        \"The system according to claim 1, further comprising an imaging module.\",\n        \"The method according to claim 3, wherein the surgery is performed through a natural orifice.\",\n        \"The catheter comprising a flexible shaft.\",\n        \"A control system for the robotic catheter.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68687", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"Johnson & Johnson\"\n        }\n    ],\n    \"patent_number\": \"EP2876543A1\",\n    \"priority_date\": \"2014-11-01\",\n    \"filing_date\": \"2015-05-01\",\n    \"issue_date\": \"2017-04-26\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"This invention discloses an improved surgical stapler with enhanced ergonomics for increased surgeon comfort and precision during surgical procedures. The stapler features a redesigned handle and firing mechanism for smoother operation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Surgical Stapling Device\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an improved handle.\",\n        \"A firing mechanism for the surgical stapler.\",\n        \"The surgical stapler according to claim 1, wherein the handle is ergonomically designed.\",\n        \"The firing mechanism according to claim 2, comprising a two-stage activation system.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68688", "text": "{\n    \"patent_title\": \"Efficient Image Denoising Algorithm Based on Wavelet Transform\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-01\",\n    \"issue_date\": \"2021-06-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel image denoising algorithm based on wavelet transform. The algorithm significantly reduces computational complexity compared to existing methods, making it suitable for real-time applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on wavelet denoising.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for denoising an image comprising...\",\n        \"An apparatus for implementing the denoising method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68688", "text": "{\n    \"patent_title\": \"Medical Image Analysis System Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2019-08-20\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-01-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for analyzing medical images, utilizing deep learning techniques to detect anomalies and assist in diagnosis. The system provides high accuracy in identifying cancerous tissues.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"Previous work on medical image segmentation.\"\n        }\n    ],\n    \"claims\": [\n        \"A medical image analysis system comprising...\",\n        \"A method for detecting anomalies in medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68689", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Cardiac Monitor\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-10-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized, fully implantable cardiac monitor for continuous heart rhythm monitoring and early detection of arrhythmias. This device aims to improve patient outcomes by providing timely alerts to physicians.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"year\": \"2018\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"year\": \"2019\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiac monitor comprising: a sensor for detecting heart rhythm; a transmitter for wirelessly transmitting data; and a power source.\",\n        \"The cardiac monitor of claim 1, wherein the sensor is miniaturized.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68689", "text": "{\n    \"patent_title\": \"Surgical Instrument Sterilization System\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Smith\",\n            \"affiliation\": \"General Hospital\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-08-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for sterilizing surgical instruments using a novel plasma technology. It aims to reduce infection rates in hospital settings.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US5432109B1\",\n            \"year\": \"1995\"\n        },\n        {\n            \"patent_number\": \"US6123456B1\",\n            \"year\": \"2000\"\n        }\n    ],\n    \"claims\": [\n        \"A sterilization system comprising: a chamber for receiving surgical instruments; a plasma generator; and a control system.\",\n        \"The sterilization system of claim 1, wherein the plasma generator generates non-thermal plasma.\",\n        \"The sterilization system of claim 2, further comprising a monitoring system for measuring plasma parameters.\",\n        \"The sterilization system of claim 3, wherein the monitoring system provides feedback to the control system.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68690", "text": "{\n    \"patent_title\": \"Wearable Sensor System for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wearable sensor system for continuous and non-invasive glucose monitoring. The device utilizes optical sensors and advanced algorithms to provide real-time glucose readings, improving diabetes management and patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A wearable sensor system for continuous glucose monitoring comprising...\",\n        \"A method for non-invasive glucose measurement using optical sensors...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68690", "text": "{\n    \"patent_title\": \"Implantable Cardiac Pacemaker with Remote Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Frank Wilson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac pacemaker with remote monitoring capabilities. The device provides pacing therapy and continuously monitors cardiac function, transmitting data wirelessly to a physician.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable cardiac pacemaker comprising...\",\n        \"A method for remote monitoring of cardiac function...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68691", "text": "{\n    \"patent_title\": \"Dynamic Voltage and Frequency Scaling for Extended Mobile Device Battery Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Qualcomm\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2021-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for dynamically adjusting the voltage and frequency of a mobile device's processor to optimize power consumption and extend battery life. The system utilizes machine learning to predict application workload and proactively adjust operating parameters.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for dynamically adjusting processor voltage based on predicted workload.\",\n        \"A mobile device comprising a processor and a voltage regulator configured to adjust voltage based on workload prediction.\",\n        \"A system for optimizing power consumption in a mobile device using machine learning.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68691", "text": "{\n    \"patent_title\": \"Fast Wireless Battery Charging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Samsung\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-08-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel wireless charging system for mobile devices utilizing resonant inductive coupling to achieve high power transfer efficiency and fast charging speeds. The system includes a transmitter and a receiver coil optimized for mobile applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless charging system comprising a transmitter coil and a receiver coil.\",\n        \"A method for wirelessly charging a mobile device using resonant inductive coupling.\",\n        \"A mobile device comprising a receiver coil for wireless charging.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68692", "text": "{\n    \"patent_title\": \"Method for Enhanced Tumor Detection Using Dynamic Contrast-Enhanced MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-08-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for enhancing tumor detection using dynamic contrast-enhanced magnetic resonance imaging (DCE-MRI). The method involves a novel contrast agent and image processing techniques to improve the visualization of small tumors.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting tumors comprising...\",\n        \"The method of claim 1, wherein the contrast agent is...\",\n        \"An image processing system configured to...\",\n        \"The system of claim 3, wherein the processing algorithm...\",\n        \"A pharmaceutical composition comprising the contrast agent...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68692", "text": "{\n    \"patent_title\": \"Improved Stent Design for Coronary Artery Disease\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved stent design for treating coronary artery disease. The stent features a novel biocompatible coating and a unique geometric configuration to minimize restenosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art on stent materials\"\n        }\n    ],\n    \"claims\": [\n        \"A stent comprising...\",\n        \"The stent of claim 1, wherein the coating is...\",\n        \"A method for treating coronary artery disease...\",\n        \"The method of claim 3, wherein the stent is deployed...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68693", "text": "{\n    \"patent_title\": \"Improved MRI Technique for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2017-01-20\",\n    \"issue_date\": \"2019-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel magnetic resonance imaging (MRI) technique utilizing advanced pulse sequences and image reconstruction algorithms to enhance the detection of early-stage cancerous tumors. The technique improves image contrast and resolution, allowing for earlier and more accurate diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in MRI pulse sequences\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI comprising...\",\n        \"An MRI system configured to...\",\n        \"A computer-readable medium storing instructions for...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68693", "text": "{\n    \"patent_title\": \"Skin Rejuvenation System Using Focused Ultrasound\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Carol Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2015-11-01\",\n    \"filing_date\": \"2017-02-15\",\n    \"issue_date\": \"2018-12-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A focused ultrasound system for non-invasive skin tightening and wrinkle reduction. The system delivers controlled ultrasound energy to the dermis, stimulating collagen production and improving skin elasticity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous work on focused ultrasound energy delivery\"\n        }\n    ],\n    \"claims\": [\n        \"An ultrasound device for skin treatment comprising...\",\n        \"A method for improving skin appearance using ultrasound...\",\n        \"A system for non-invasive skin rejuvenation...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68694", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery Management System for Extended Device Operation\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10456789B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2021-10-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery management system (BMS) is disclosed, designed to significantly improve the energy efficiency and lifespan of lithium-ion batteries in portable electronic devices. The system utilizes adaptive charging algorithms and predictive modeling to optimize battery usage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68694", "text": "{\n    \"patent_title\": \"Electric Vehicle Battery Cooling System\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emily Chen\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2020-03-10\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-05-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved cooling system for high-capacity batteries used in electric vehicles. The system employs a liquid coolant and a sophisticated heat exchanger to maintain optimal battery temperature during operation, enhancing performance and extending battery life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A cooling system for electric vehicle batteries comprising...\",\n        \"A method for maintaining battery temperature...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68695", "text": "{\n    \"patent_title\": \"Surgical Stapler with Integrated Tissue Approximation\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Boston Medical Center\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-05-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical stapler designed to provide precise tissue approximation during minimally invasive surgery. The device incorporates a novel staple deployment mechanism to minimize tissue damage and improve surgical outcomes. Addresses the need for better closure in laparoscopic procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related tissue stapling mechanism\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"A method for approximating tissue using said stapler...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68695", "text": "{\n    \"patent_title\": \"Improved MRI Image Reconstruction Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a new algorithm for reconstructing images from MRI data, resulting in higher resolution and reduced scan times. It builds upon existing fast Fourier transform methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art in MRI image processing\"\n        },\n        {\n            \"patent_number\": \"US9654321B1\",\n            \"relevance\": \"Related work in image reconstruction\"\n        },\n        {\n            \"patent_number\": \"US10543210B2\",\n            \"relevance\": \"Existing Fourier transform techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images...\",\n        \"An apparatus for performing MRI image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68696", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging Contrast Agents for Enhanced Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-05-20\",\n    \"issue_date\": \"2022-07-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel contrast agents for magnetic resonance imaging (MRI) that significantly enhance the visibility of tumors, leading to improved diagnostic accuracy. The contrast agents are biocompatible and exhibit high relaxivity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on MRI contrast agents.\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent for magnetic resonance imaging comprising...\",\n        \"A method for detecting tumors using the contrast agent...\",\n        \"The contrast agent according to claim 1, wherein...\",\n        \"The method according to claim 2, wherein...\",\n        \"The contrast agent according to claim 3, having a relaxivity of...\",\n        \"A pharmaceutical composition comprising the contrast agent...\",\n        \"A diagnostic kit comprising the contrast agent...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68696", "text": "{\n    \"patent_title\": \"Method for Non-Invasive Skin Rejuvenation Using Focused Ultrasound\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-03-05\",\n    \"issue_date\": \"2023-05-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method for non-invasive skin rejuvenation using focused ultrasound energy to stimulate collagen production. The treatment reduces wrinkles and improves skin elasticity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art on ultrasound skin treatments.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for skin rejuvenation comprising...\",\n        \"The method according to claim 1, wherein...\",\n        \"An ultrasound device for performing the method...\",\n        \"A cosmetic composition for use with the ultrasound device...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68697", "text": "{\n    \"patent_title\": \"Minimally Invasive Cardiac Valve Replacement System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2017-05-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel minimally invasive system for replacing damaged cardiac valves. This system utilizes a flexible delivery catheter and a self-expanding valve prosthesis, reducing the need for open-heart surgery and leading to faster patient recovery.  Significant improvement over traditional surgical methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8545902B2\"\n        }\n    ],\n    \"claims\": [\n        \"A minimally invasive cardiac valve replacement system comprising...\",\n        \"A delivery catheter for inserting a valve prosthesis...\",\n        \"A self-expanding valve prosthesis...\",\n        \"The system of claim 1, wherein the valve prosthesis is made of...\",\n        \"A method for replacing a cardiac valve using the system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68697", "text": "{\n    \"patent_title\": \"Automated Blood Pressure Monitoring Device\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2018-03-10\",\n    \"filing_date\": \"2018-03-10\",\n    \"issue_date\": \"2020-04-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated device for continuously monitoring blood pressure. The device uses a standard cuff and sensors to provide regular readings, and stores data for analysis. Provides a convenient way for patients to track their health.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\"\n        }\n    ],\n    \"claims\": [\n        \"An automated blood pressure monitoring device comprising...\",\n        \"A pressure sensor for measuring blood pressure...\",\n        \"A cuff for applying pressure to an arm...\",\n        \"A data storage module...\",\n        \"A display for showing blood pressure readings...\",\n        \"A communication interface for transmitting data...\",\n        \"A power supply...\",\n        \"A user interface...\",\n        \"A processing unit...\",\n        \"A memory...\",\n        \"Software for controlling the device...\",\n        \"A calibration module...\",\n        \"An alarm...\",\n        \"A housing...\",\n        \"A battery...\",\n        \"A connection port...\",\n        \"A filter...\",\n        \"A signal amplifier...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68698", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical Stapler with Enhanced Tissue Approximation\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical stapler designed to improve tissue approximation during laparoscopic procedures. The device utilizes a novel firing mechanism to reduce tissue trauma and promote faster patient recovery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Similar stapler design\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Laparoscopic instrument control\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"A method for using the surgical stapler...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68698", "text": "{\n    \"patent_title\": \"Cardiac Pacemaker with Remote Monitoring Capabilities\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Medtronic\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Boston Scientific\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-08-22\",\n    \"filing_date\": \"2017-08-22\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A cardiac pacemaker with enhanced remote monitoring capabilities for patients with heart rhythm disorders. The device transmits real-time data to a physician's console, allowing for proactive adjustments to therapy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Pacemaker technology\"\n        },\n        {\n            \"patent_number\": \"US8543210B2\",\n            \"relevance\": \"Remote patient monitoring\"\n        },\n        {\n            \"patent_number\": \"US9432109B2\",\n            \"relevance\": \"Data transmission protocols\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Algorithms for arrhythmia detection\"\n        },\n        {\n            \"patent_number\": \"US11234567B2\",\n            \"relevance\": \"Battery life optimization\"\n        },\n        {\n            \"patent_number\": \"US12345678B2\",\n            \"relevance\": \"Biocompatible materials\"\n        },\n        {\n            \"patent_number\": \"US13456789B2\",\n            \"relevance\": \"Wireless communication standards\"\n        },\n        {\n            \"patent_number\": \"US14567890B2\",\n            \"relevance\": \"Security protocols for medical devices\"\n        },\n        {\n            \"patent_number\": \"US15678901B2\",\n            \"relevance\": \"Miniaturization techniques\"\n        },\n        {\n            \"patent_number\": \"US16789012B2\",\n            \"relevance\": \"Patient interface design\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiac pacemaker comprising...\",\n        \"A method for remote monitoring of heart rhythm...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68699", "text": "{\n    \"patent_title\": \"High-Density Solid-State Electrolyte for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2023-10-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel solid-state electrolyte material with enhanced ionic conductivity and electrochemical stability, enabling high-density lithium-ion batteries with improved safety and performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Lithium Ion Battery with Improved Cycle Life\"\n        }\n    ],\n    \"claims\": [\n        \"A solid-state electrolyte comprising...\",\n        \"A lithium-ion battery cell comprising the solid-state electrolyte...\",\n        \"A method for manufacturing a lithium-ion battery cell...\",\n        \"The electrolyte according to claim 1, wherein...\",\n        \"The battery cell according to claim 2, wherein...\",\n        \"The method according to claim 3, wherein...\",\n        \"A system comprising the battery cell...\",\n        \"The system according to claim 7, wherein...\",\n        \"An electronic device powered by the battery cell...\",\n        \"The electronic device according to claim 9, wherein...\",\n        \"A method for increasing the energy density of a battery...\",\n        \"A composition comprising the solid state electrolyte...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68699", "text": "{\n    \"patent_title\": \"Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"Tesla, Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2023-02-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) optimized for electric vehicle applications, providing enhanced thermal control and state-of-charge estimation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Electric Vehicle Battery Pack\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling the temperature of a battery pack...\",\n        \"A system for estimating the state-of-charge of a battery...\",\n        \"The BMS according to claim 1, wherein...\",\n        \"The method according to claim 2, wherein...\",\n        \"The system according to claim 3, wherein...\",\n        \"An electric vehicle comprising the BMS...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68700", "text": "{\n    \"patent_title\": \"Method and System for Enhanced MRI Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Robert Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for reconstructing magnetic resonance images with improved resolution and reduced artifacts. The invention utilizes advanced algorithms to enhance image quality, enabling more accurate diagnosis of complex medical conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"A system for performing MRI image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68700", "text": "{\n    \"patent_title\": \"Improved X-ray Imaging System with Digital Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An X-ray imaging system incorporating digital image enhancement techniques to improve contrast and clarity. The system provides improved diagnostic capabilities for various medical applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related to X-ray image processing\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A method for digitally enhancing an X-ray image...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68701", "text": "{\n    \"patent_title\": \"Ultrasound-guided Focused Light Therapy for Targeted Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for non-invasive, focused drug delivery utilizing ultrasound guidance and focused light activation. The system improves targeted drug delivery, minimizing side effects and enhancing therapeutic efficacy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art in ultrasound imaging.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for non-invasive drug delivery comprising...\",\n        \"An apparatus for focusing light energy...\",\n        \"A system for guiding ultrasound waves...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68701", "text": "{\n    \"patent_title\": \"Improved Radiation Therapy Planning System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-20\",\n    \"filing_date\": \"2018-11-20\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel system for planning and delivering radiation therapy to cancerous tumors. The system improves targeting and dose distribution, reducing damage to healthy tissue.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art relating to radiation dosimetry.\"\n        }\n    ],\n    \"claims\": [\n        \"A system for planning radiation therapy comprising...\",\n        \"A method for calculating radiation dose...\",\n        \"A user interface for visualizing treatment plans...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68702", "text": "{\n    \"patent_title\": \"Enhanced MRI Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing MRI images using deep learning algorithms, resulting in significantly improved image clarity and reduced noise. The technique enhances diagnostic accuracy in various medical applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI image reconstruction...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68702", "text": "{\n    \"patent_title\": \"Improved X-ray Imaging System with Reduced Radiation Dose\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-20\",\n    \"filing_date\": \"2018-11-20\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An X-ray imaging system designed to minimize radiation exposure while maintaining image quality. The invention incorporates advanced filtration techniques and optimized sensor technology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A method for reducing radiation dose in X-ray imaging...\",\n        \"A radiation filter for use in an X-ray system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68703", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical Device with Integrated Optical Coherence Tomography\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10456789B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-02-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical device incorporating real-time optical coherence tomography (OCT) imaging for enhanced precision during minimally invasive procedures. The device allows surgeons to visualize subsurface tissue structures, minimizing damage to surrounding healthy tissue.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art related to OCT imaging\"\n        },\n        {\n            \"patent_number\": \"US9120876B2\",\n            \"relevance\": \"Related art for minimally invasive tools\"\n        },\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Cited as impactful innovation in surgical imaging.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical device comprising an OCT imaging module integrated within a minimally invasive surgical tool.\",\n        \"The surgical device of claim 1, wherein the OCT imaging module provides real-time visualization of subsurface tissue structures.\",\n        \"A method of performing a minimally invasive surgical procedure using the device of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68703", "text": "{\n    \"patent_title\": \"Surgical Instrument Handle Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Jean Dupont\",\n            \"affiliation\": \"MedTech Innovations Ltd.\"\n        }\n    ],\n    \"patent_number\": \"EP3123456B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-11-18\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"An improved ergonomic design for a surgical instrument handle, enhancing comfort and control for surgeons during prolonged procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"relevance\": \"Prior art relating to instrument handle design.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument handle with an improved ergonomic grip.\",\n        \"The surgical instrument handle of claim 1, comprising a non-slip surface.\",\n        \"A surgical instrument incorporating the handle of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68704", "text": "{\n    \"patent_title\": \"Energy-Efficient Wireless Communication System Utilizing Dynamic Power Allocation\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel wireless communication system that dynamically allocates power to minimize energy consumption while maintaining data throughput. The system incorporates advanced algorithms for power control and resource allocation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\"\n        },\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication system comprising: a transmitter configured to dynamically allocate power based on channel conditions.\",\n        \"The system of claim 1, wherein the power allocation algorithm minimizes energy consumption.\",\n        \"The system of claim 2, wherein the channel conditions are estimated using a feedback mechanism.\",\n        \"A method for dynamically allocating power in a wireless communication system.\",\n        \"The method of claim 4, further comprising optimizing the data rate.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68704", "text": "{\n    \"patent_title\": \"Advanced Modulation Techniques for Wireless Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to advanced modulation techniques for improving the reliability and throughput of wireless data transmission. It introduces a new modulation scheme that is robust to noise and interference.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication system employing a novel modulation scheme.\",\n        \"The system of claim 1, wherein the modulation scheme is based on orthogonal frequency-division multiplexing.\",\n        \"A method for transmitting data wirelessly using the modulation scheme of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68705", "text": "{\n    \"patent_title\": \"Targeted Nanoparticle Drug Delivery System for Cancer Therapy\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel nanoparticle drug delivery system designed to specifically target cancerous tissues, enhancing drug bioavailability and minimizing systemic toxicity. The nanoparticles are coated with targeting ligands that bind to receptors overexpressed on cancer cells. This system demonstrates a significant improvement in therapeutic efficacy compared to conventional chemotherapy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\"\n        }\n    ],\n    \"claims\": [\n        \"A nanoparticle composition comprising...\",\n        \"A method of treating cancer...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68705", "text": "{\n    \"patent_title\": \"Improved Pill Coating Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Generic Pharma Inc.\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2022-07-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new coating process for pharmaceutical pills that improves their swallowing ease.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A coated pill...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68706", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Patient Feedback\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel minimally invasive surgical system incorporating haptic feedback and real-time imaging to improve surgical precision and patient comfort. The system utilizes a smaller incision size compared to traditional laparoscopic surgery, leading to faster recovery times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in laparoscopic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A minimally invasive surgical system comprising...\",\n        \"A method for performing surgery using the system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68706", "text": "{\n    \"patent_title\": \"Automated Diagnostic System for Cardiovascular Disease\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2017-12-01\",\n    \"filing_date\": \"2017-12-01\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated diagnostic system for detecting cardiovascular disease using advanced image processing techniques. The system provides rapid and accurate analysis of medical images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related diagnostic imaging techniques\"\n        }\n    ],\n    \"claims\": [\n        \"An automated diagnostic system comprising...\",\n        \"A method for diagnosing cardiovascular disease...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68707", "text": "{\n    \"patent_title\": \"Efficient Image Segmentation Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for efficient image segmentation, significantly reducing processing time while maintaining high accuracy. Applicable to medical image analysis and other computer vision tasks.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image segmentation...\",\n        \"A deep learning model...\",\n        \"A system comprising...\",\n        \"The method of claim 1, wherein...\",\n        \"The model of claim 2, wherein...\",\n        \"The system of claim 3, wherein...\",\n        \"A computer-readable medium...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68707", "text": "{\n    \"patent_title\": \"Image Enhancement for Satellite Imagery\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for enhancing the visual quality of satellite imagery, improving detail and clarity for remote sensing applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image enhancement...\",\n        \"A system for processing satellite images...\",\n        \"The method of claim 1, wherein...\",\n        \"The system of claim 2, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68708", "text": "{\n    \"patent_title\": \"AI-Powered Diagnostic System for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-10-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an AI-powered diagnostic system utilizing deep learning algorithms to detect early-stage cancer from medical imaging data. The system analyzes X-ray, MRI, and CT scans to identify subtle anomalies indicative of cancerous growth, often missed by human radiologists.  The deep neural network is trained on a massive dataset of labeled medical images and incorporates attention mechanisms to focus on relevant regions of interest.  The system achieves high accuracy and sensitivity in detecting various types of cancer, enabling earlier diagnosis and improved patient outcomes. The system outputs a risk score along with highlighted regions of concern, aiding clinicians in making informed decisions. Further, the system can be continuously updated with new data to improve its performance over time. It integrates seamlessly with existing hospital information systems and offers a user-friendly interface for easy operation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"title\": \"Medical Image Analysis using Convolutional Neural Networks\"\n        }\n    ],\n    \"claims\": [\n        \"A method for diagnosing cancer comprising: obtaining a medical image; applying a deep learning algorithm to the medical image; and generating a risk score indicative of the presence of cancer.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68708", "text": "{\n    \"patent_title\": \"Machine Learning Enhanced Patient Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"IBM Research\"\n        },\n        {\n            \"name\": \"Sarah Chen\",\n            \"affiliation\": \"IBM Watson Health\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2022-05-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a system for continuous patient monitoring utilizing machine learning algorithms to predict potential health deterioration. The system analyzes vital signs and sensor data to identify patterns indicative of impending adverse events. It sends alerts to medical personnel when a patient is at risk. The system utilizes a simple recurrent neural network to analyze the data.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A system for monitoring a patient's vital signs comprising: a sensor for measuring vital signs; a machine learning algorithm for analyzing the vital signs; and an alert system for notifying medical personnel.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68709", "text": "{\n    \"patent_title\": \"Enhanced Energy Harvesting System for Prolonged Mobile Device Operation\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-08-20\",\n    \"issue_date\": \"2022-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel energy harvesting system utilizing piezoelectric materials and optimized power management algorithms to significantly extend battery life in mobile devices. This system is compatible with a range of battery technologies, including solid-state batteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art on energy harvesting.\"\n        }\n    ],\n    \"claims\": [\n        \"A system for harvesting energy from ambient vibrations comprising...\",\n        \"A power management circuit configured to...\",\n        \"A mobile device incorporating the energy harvesting system...\",\n        \"A method for extending battery life in a mobile device...\",\n        \"The system of claim 1, wherein the piezoelectric material is...\",\n        \"The power management circuit of claim 2, further comprising...\",\n        \"The mobile device of claim 3, further comprising...\",\n        \"The method of claim 4, wherein the ambient vibrations...\",\n        \"The system of claim 1, wherein the energy harvesting efficiency...\",\n        \"The power management circuit of claim 2, designed for...\",\n        \"A mobile device featuring adaptive power allocation.\",\n        \"A method of dynamically adjusting energy consumption based on usage patterns.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68709", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Cathode Material\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"California Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2021-02-15\",\n    \"issue_date\": \"2023-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new lithium-ion battery cathode material with enhanced energy density and cycle life. The material utilizes a novel doping strategy to improve lithium-ion conductivity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art on lithium-ion battery materials.\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery cathode material comprising...\",\n        \"The cathode material of claim 1, wherein the doping agent...\",\n        \"A lithium-ion battery cell incorporating the cathode material...\",\n        \"A method for manufacturing the cathode material...\",\n        \"The cathode material of claim 1, with an energy density...\",\n        \"The lithium-ion battery cell of claim 3, with a cycle life...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68710", "text": "{\n    \"patent_title\": \"Non-Invasive Glucose Monitoring System Using Near-Infrared Spectroscopy\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-01-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive glucose monitoring system utilizing near-infrared spectroscopy to determine glucose levels in real-time without requiring blood samples. The device offers improved accuracy and convenience for diabetic patients.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A non-invasive glucose monitoring device comprising...\",\n        \"A method for determining glucose levels using near-infrared spectroscopy...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68710", "text": "{\n    \"patent_title\": \"Surgical Instrument for Minimally Invasive Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2021-06-01\",\n    \"issue_date\": \"2023-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical instrument designed for minimally invasive procedures, providing enhanced precision and dexterity for surgeons.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising...\",\n        \"A method for performing minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68711", "text": "{\n    \"patent_title\": \"Ultrasound Image Enhancement for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of California, San Diego\"\n        },\n        {\n            \"name\": \"David Chen\",\n            \"affiliation\": \"University of California, San Diego\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for enhancing ultrasound images to improve the detection of small cancerous tumors, particularly in breast tissue. The technique utilizes adaptive filtering and speckle reduction algorithms to increase image clarity and contrast, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on speckle reduction\"\n        },\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"relevance\": \"Related ultrasound imaging technique\"\n        },\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"Adaptive filtering methods\"\n        },\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"relevance\": \"Early cancer detection algorithms\"\n        },\n        {\n            \"patent_number\": \"US5432109B1\",\n            \"relevance\": \"Image processing for medical applications\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing ultrasound images comprising...\",\n        \"An apparatus for performing ultrasound image enhancement...\",\n        \"A system for diagnosing cancer using enhanced ultrasound images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68711", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Image Reconstruction Techniques\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"Michael Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11123456B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2021-11-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing magnetic resonance images, reducing scan time and improving image resolution. The technique employs advanced algorithms to minimize artifacts and enhance image clarity in MRI scans.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on MRI reconstruction\"\n        },\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"relevance\": \"Related MRI techniques\"\n        },\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"Artifact reduction methods\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing magnetic resonance images...\",\n        \"An apparatus for performing MRI reconstruction...\",\n        \"A system for generating MRI images using the improved reconstruction method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68712", "text": "{\n    \"patent_title\": \"Artificial Intelligence-Assisted MRI for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel method for enhancing the accuracy and speed of cancer detection using MRI images, leveraging artificial intelligence algorithms to identify subtle anomalies indicative of early-stage tumors.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"MRI Image Enhancement Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for analyzing MRI images using a deep learning model...\",\n        \"A system for early cancer detection comprising an MRI scanner and a computer...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68712", "text": "{\n    \"patent_title\": \"Improved X-Ray Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2022-01-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details an improved X-ray imaging system offering enhanced resolution and reduced radiation exposure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Digital X-Ray Imaging Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system with improved resolution...\",\n        \"A method for reducing radiation exposure during X-ray imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68713", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable biosensor utilizing advanced nanomaterials for continuous glucose monitoring in diabetic patients. The device provides real-time data transmission and enhanced biocompatibility, leading to improved patient management and reduced complications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in glucose monitoring technology\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable biosensor comprising...\",\n        \"A method for continuous glucose monitoring using the biosensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68713", "text": "{\n    \"patent_title\": \"Novel Surgical Instrument for Laparoscopic Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Jean Dubois\",\n            \"affiliation\": \"Université de Paris\"\n        }\n    ],\n    \"patent_number\": \"EP3456789B1\",\n    \"priority_date\": \"2019-12-01\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-09-22\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"A novel surgical instrument designed for enhanced precision and maneuverability during laparoscopic procedures. The instrument features a unique articulation mechanism and ergonomic design.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related surgical instrument design\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising...\",\n        \"A method for performing laparoscopic surgery using the instrument...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68714", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Sensor for Continuous Non-Invasive Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized wireless sensor is disclosed for continuous, non-invasive glucose monitoring. The sensor utilizes optical spectroscopy to measure glucose levels through the skin, providing real-time data to a mobile device. This improves patient monitoring by eliminating the need for frequent blood draws. The system includes a data processing unit to filter noise and provide accurate glucose readings.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Non-invasive Glucose Monitoring System\"\n        }\n    ],\n    \"claims\": [\n        \"A non-invasive glucose monitoring system comprising: a sensor configured to emit optical signals through a skin layer of a patient...\",\n        \"The system of claim 1, wherein the sensor is wirelessly connected to a mobile device.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68714", "text": "{\n    \"patent_title\": \"Surgical Robot with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2017-12-01\",\n    \"filing_date\": \"2017-12-01\",\n    \"issue_date\": \"2022-04-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a surgical robot equipped with advanced haptic feedback and a high-resolution imaging system, allowing surgeons to perform complex procedures with increased precision. The robot incorporates force sensors and a control algorithm to minimize tissue damage and improve surgical outcomes. This invention is applicable to a wide range of surgical specialties. Detailed descriptions of the mechanical components, control algorithms, and software interfaces are provided. This document also covers safety measures and validation data gathered during clinical trials.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Surgical Robotic System\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robot comprising: a robotic arm with a plurality of degrees of freedom...\",\n        \"The robot of claim 1, further comprising a haptic feedback system.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68715", "text": "{\n    \"patent_title\": \"High-Resolution Magnetic Resonance Imaging Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Jian Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel magnetic resonance imaging (MRI) technique is disclosed, providing significantly improved image resolution and contrast compared to existing methods. This allows for more accurate diagnosis of subtle tissue abnormalities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8543210B2\",\n            \"title\": \"MRI Pulse Sequence Optimization\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating high-resolution MRI images...\",\n        \"An MRI apparatus configured to implement the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68715", "text": "{\n    \"patent_title\": \"Improved X-Ray Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Wei Chen\",\n            \"affiliation\": \"Huazhong University of Science and Technology\"\n        },\n        {\n            \"name\": \"Li Mei\",\n            \"affiliation\": \"Huazhong University of Science and Technology\"\n        }\n    ],\n    \"patent_number\": \"CN108765432B\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-15\",\n    \"issue_date\": \"2019-09-05\",\n    \"patent_office\": \"SIPO\",\n    \"abstract\": \"An improved X-ray imaging system with enhanced image clarity for bone fracture detection. The system utilizes a novel filter to reduce noise and improve image contrast.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"X-Ray Image Enhancement Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising a filter...\",\n        \"A method for enhancing X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68716", "text": "{\n    \"patent_title\": \"AI-Assisted Medical Image Analysis for Enhanced Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Alistair Finch\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-09-20\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for analyzing medical images using artificial intelligence to improve the accuracy and speed of tumor detection. The system utilizes machine learning algorithms to identify subtle anomalies in radiographic images, leading to earlier and more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Automated Image Segmentation for Medical Diagnosis\"\n        }\n    ],\n    \"claims\": [\n        \"A method for analyzing a medical image comprising...\",\n        \"A system for detecting tumors in a medical image comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68716", "text": "{\n    \"patent_title\": \"Improved X-ray Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Davies\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"Ms. Helen Richards\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2021-08-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved X-ray imaging system featuring enhanced resolution and reduced radiation exposure. The system employs novel collimation techniques and image processing algorithms for clearer visualization of anatomical structures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Advanced X-ray Detector Technology\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A method for reducing radiation exposure during X-ray imaging comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68717", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable biosensor for continuous glucose monitoring using a novel enzymatic fuel cell. The device provides real-time glucose levels and improves diabetes management, leading to enhanced patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8455210B2\"\n        },\n        {\n            \"patent_number\": \"US9216123B2\"\n        },\n        {\n            \"patent_number\": \"US10345678B2\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable biosensor comprising...\",\n        \"A method for continuous glucose monitoring using the biosensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68717", "text": "{\n    \"patent_title\": \"Surgical Stapler with Enhanced Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Sarah Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US8901234B2\",\n    \"priority_date\": \"2014-11-01\",\n    \"filing_date\": \"2014-11-01\",\n    \"issue_date\": \"2017-04-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical stapler with an improved ergonomic design to reduce surgeon fatigue and enhance precision during surgical procedures. This enhances the speed and efficiency of surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        },\n        {\n            \"patent_number\": \"US8236987B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an ergonomic handle...\",\n        \"A method for performing surgical anastomosis using the stapler...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68718", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Cardiac Monitor with Extended Battery Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-06-20\",\n    \"issue_date\": \"2022-12-05\",\n    \"patent_office\": \"United States Patent and Trademark Office (USPTO)\",\n    \"abstract\": \"A miniaturized implantable cardiac monitor with an extended battery life and wireless data transmission capabilities. Designed to provide continuous ECG monitoring for up to 5 years, improving early detection of arrhythmias and reducing the need for frequent device replacements. Addresses unmet clinical needs for long-term cardiac monitoring in remote patient populations.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on implantable cardiac devices.\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable cardiac monitor comprising...\",\n        \"A method for continuous ECG monitoring using the device...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68718", "text": "{\n    \"patent_title\": \"Improved Surgical Stapler Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Klaus Schmidt\",\n            \"affiliation\": \"Technical University of Munich\"\n        }\n    ],\n    \"patent_number\": \"EP3987654B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-11-15\",\n    \"issue_date\": \"2023-01-18\",\n    \"patent_office\": \"European Patent Office (EPO)\",\n    \"abstract\": \"An improved surgical stapler design featuring enhanced ergonomics and a faster stapling rate. Reduces surgical time and improves precision during tissue closure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art on surgical stapler mechanisms.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"A method of using the surgical stapler...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68719", "text": "{\n    \"patent_title\": \"Improved MRI Contrast Agent for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel MRI contrast agent is disclosed, improving early detection rates of cancerous tumors through enhanced image clarity and targeted delivery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancer using the novel contrast agent.\",\n        \"A contrast agent comprising...\",\n        \"The contrast agent provides at least a 20% improvement in image clarity compared to existing agents.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68719", "text": "{\n    \"patent_title\": \"Medical Image Analysis Software Platform\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-01-20\",\n    \"filing_date\": \"2017-01-20\",\n    \"issue_date\": \"2020-11-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A software platform for automated analysis of medical images, utilizing machine learning algorithms for disease classification.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\"\n        }\n    ],\n    \"claims\": [\n        \"A computer-implemented method for analyzing medical images.\",\n        \"The method comprises applying a machine learning algorithm.\",\n        \"The system is capable of identifying anomalies in medical images.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68720", "text": "{\n    \"patent_title\": \"AI-Enhanced MRI for Early-Stage Lung Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-08-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for detecting early-stage lung cancer using Magnetic Resonance Imaging (MRI) enhanced with artificial intelligence algorithms. The system utilizes machine learning to analyze MRI data, identifying subtle anomalies indicative of cancerous growth with improved accuracy compared to traditional methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Prior art in MRI techniques\"\n        },\n        {\n            \"patent_number\": \"US1012345678B2\",\n            \"relevance\": \"Related work on cancer detection\"\n        },\n        {\n            \"patent_number\": \"US1111111111B2\",\n            \"relevance\": \"Machine learning applications in medical imaging\"\n        },\n        {\n            \"patent_number\": \"US1212121212B2\",\n            \"relevance\": \"Advanced image processing techniques\"\n        },\n        {\n            \"patent_number\": \"US1313131313B2\",\n            \"relevance\": \"Computer aided detection systems\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting early-stage lung cancer using MRI and AI.\",\n        \"A system comprising an MRI scanner and a machine learning algorithm.\",\n        \"The use of the machine learning algorithm to analyze MRI data for cancer detection.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68720", "text": "{\n    \"patent_title\": \"Improved X-Ray Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anna Schmidt\",\n            \"affiliation\": \"Technical University of Munich\"\n        }\n    ],\n    \"patent_number\": \"EP12345678B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2021-11-10\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"This invention presents an improved X-ray imaging system with enhanced resolution and reduced radiation exposure. The system utilizes advanced filtering techniques to create clearer images, improving diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"relevance\": \"Prior art in X-ray technology\"\n        },\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Related work on radiation reduction\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system with improved resolution.\",\n        \"A method for reducing radiation exposure during X-ray imaging.\",\n        \"The use of filtering techniques to enhance image clarity.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68721", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Glucose Sensor with Enhanced Biocompatibility\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-07-20\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A miniaturized implantable glucose sensor with improved biocompatibility features to minimize patient discomfort and enhance long-term performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on glucose sensing technology\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized glucose sensor comprising...\",\n        \"A biocompatible coating for reducing inflammation...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68721", "text": "{\n    \"patent_title\": \"Advanced Cardiac Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"Philips Healthcare\"\n        }\n    ],\n    \"patent_number\": \"EP23456789B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"An advanced cardiac monitoring system for real-time analysis of heart activity and early detection of arrhythmias.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related art on cardiac rhythm analysis\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiac monitoring system comprising...\",\n        \"A method for detecting atrial fibrillation...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68722", "text": "{\n    \"patent_title\": \"Patient-Comfortable Wearable Sensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"MIT Lincoln Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2021-12-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wearable sensor system for continuous glucose monitoring designed with flexible and biocompatible materials for enhanced patient comfort. The sensor utilizes a minimally invasive approach and provides real-time data transmission to a mobile device.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Wearable Physiological Monitoring System\"\n        }\n    ],\n    \"claims\": [\n        \"A wearable sensor comprising a flexible substrate...\",\n        \"A method for continuous glucose monitoring using the wearable sensor...\",\n        \"A system for transmitting data from the wearable sensor to a mobile device...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68722", "text": "{\n    \"patent_title\": \"Nanoparticle-Enhanced Drug Delivery System for Cancer Treatment\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alistair Chen\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Sophia Rodriguez\",\n            \"affiliation\": \"Stanford Bioengineering\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-07-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel drug delivery system utilizing biocompatible nanoparticles to selectively target and destroy cancer cells. The system enhances drug efficacy and minimizes side effects.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Targeted Drug Delivery Using Nanoparticles\"\n        }\n    ],\n    \"claims\": [\n        \"A nanoparticle comprising a drug payload...\",\n        \"A method for treating cancer using the nanoparticle...\",\n        \"A composition for enhancing drug delivery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68723", "text": "{\n    \"patent_title\": \"AI-Enhanced Mammographic Image Analysis for Early Breast Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-06-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for early breast cancer detection using deep learning algorithms applied to mammographic images. The system analyzes image features to identify subtle indicators of malignancy, improving diagnostic accuracy and reducing false positives. Artificial intelligence is used for automated lesion detection and classification.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B1\",\n            \"title\": \"Digital Mammography System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting breast cancer comprising...\",\n        \"A system for analyzing mammographic images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68723", "text": "{\n    \"patent_title\": \"Improved CT Scan Reconstruction Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Klaus Schmidt\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        },\n        {\n            \"name\": \"Ingrid Bauer\",\n            \"affiliation\": \"Siemens AG\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2021-04-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents an improved algorithm for reconstructing images from computed tomography (CT) scans. The algorithm reduces noise and artifacts, leading to clearer and more detailed images, enhancing diagnostic capabilities for a range of medical conditions. This algorithm is suitable for various CT scan modalities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"CT Image Reconstruction Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing CT images comprising...\",\n        \"A system for reducing noise in CT scans...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68724", "text": "{\n    \"patent_title\": \"Method and System for Accelerated MRI Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for reconstructing MRI images significantly faster than conventional techniques, enabling reduced scan times and improved patient comfort. The technique utilizes advanced compressed sensing algorithms and does not require the use of contrast agents.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on compressed sensing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"A system for performing MRI image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68724", "text": "{\n    \"patent_title\": \"Contrast-Enhanced X-Ray Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An X-ray imaging system utilizing a novel contrast agent to enhance visualization of soft tissues. The system allows for improved detection of small lesions and tumors, resulting in more accurate diagnoses.  The device employs standard X-ray generation and detection techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Prior art on X-ray imaging\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A contrast agent for use in X-ray imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68725", "text": "{\n    \"patent_title\": \"Implantable Cardiac Rhythm Management System with Enhanced Lead Fixation\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac rhythm management system incorporating a novel lead fixation mechanism to improve long-term stability and reduce complications. The system includes advanced algorithms for arrhythmia detection and personalized therapy delivery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art related to leadless pacemakers\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiac rhythm management system comprising...\",\n        \"A lead fixation mechanism characterized by...\",\n        \"A method for implanting said system...\",\n        \"A system configured for personalized therapy...\",\n        \"A system including arrhythmia detection algorithms...\",\n        \"A system with enhanced biocompatibility...\",\n        \"A method of manufacturing the system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68725", "text": "{\n    \"patent_title\": \"Surgical Instrument for Laparoscopic Cholecystectomy\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Johnson\",\n            \"affiliation\": \"Acme Surgical Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2022-01-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical instrument designed for minimally invasive cholecystectomy procedures, offering improved dexterity and precision for surgeons.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art regarding laparoscopic graspers\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising...\",\n        \"A handle configured for ergonomic grip...\",\n        \"A shaft with a distal end...\",\n        \"A cutting or grasping mechanism...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68726", "text": "{\n    \"patent_title\": \"Method for Enhanced Magnetic Resonance Image Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel method for reconstructing magnetic resonance images (MRI) utilizing deep learning techniques. The method significantly reduces scan time while maintaining high image quality, enabling faster and more efficient diagnoses.  The deep learning model is trained on a large dataset of MRI images, resulting in improved noise reduction and artifact removal.  The invention offers substantial advancements in clinical imaging workflows and improved patient outcomes through enhanced image clarity and reduced exposure to magnetic fields. Detailed analysis of the impact on specific anatomical structures is provided within.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\",\n            \"relevance\": \"Prior art in MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"A system for performing MRI reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68726", "text": "{\n    \"patent_title\": \"Improved X-ray Imaging System with Reduced Radiation Dose\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2022-01-10\",\n    \"filing_date\": \"2022-01-10\",\n    \"issue_date\": \"2023-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved X-ray imaging system designed to reduce radiation exposure for patients.  The system utilizes advanced filtering techniques and image processing algorithms to achieve higher quality images with lower radiation doses. Improvements in detector sensitivity contribute to the overall reduction in required radiation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"relevance\": \"Prior art in X-ray imaging\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A method for reducing radiation dose in X-ray imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68727", "text": "{\n    \"patent_title\": \"Non-Invasive Glucose Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive glucose monitoring system utilizing optical sensors to measure glucose levels through the skin. This technology aims to improve the quality of life for diabetic patients by reducing the need for frequent blood draws.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on non-invasive sensors\"\n        }\n    ],\n    \"claims\": [\n        \"A non-invasive glucose monitoring system comprising an optical sensor...\",\n        \"A method for determining glucose levels using the system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68727", "text": "{\n    \"patent_title\": \"Advanced Surgical Stapler with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-01-15\",\n    \"filing_date\": \"2022-01-15\",\n    \"issue_date\": \"2023-10-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler with a self-adjusting anvil and enhanced precision for minimally invasive surgical procedures. This invention significantly reduces surgical complications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous generation surgical stapler designs\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising a self-adjusting anvil...\",\n        \"A method for performing surgical anastomosis using the stapler...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68728", "text": "{\n    \"patent_title\": \"Low-Latency Communication Protocol for 5G Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-07-15\",\n    \"filing_date\": \"2019-07-15\",\n    \"issue_date\": \"2021-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel communication protocol designed to reduce latency in 5G networks by optimizing data packet scheduling and transmission. The protocol incorporates a predictive queuing mechanism to anticipate network congestion and prioritize critical data flows.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing latency in a wireless communication network...\",\n        \"A system comprising a transmitter and a receiver...\",\n        \"The method of claim 1, wherein the network is a 5G network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68728", "text": "{\n    \"patent_title\": \"Advanced Encryption Method for Secure Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2018-11-20\",\n    \"filing_date\": \"2018-11-20\",\n    \"issue_date\": \"2022-05-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A highly complex encryption algorithm designed to provide robust security for data transmission in various applications. The algorithm utilizes a multi-layered approach with dynamic key generation and adaptive encryption parameters.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for encrypting data comprising the steps of...\",\n        \"A system for securely transmitting data...\",\n        \"The method of claim 1, wherein the encryption algorithm is...\",\n        \"The system of claim 2, further comprising a key management module...\",\n        \"The method of claim 1, wherein the key generation process...\",\n        \"The system of claim 2, wherein the transmission protocol...\",\n        \"The method of claim 1, wherein the adaptive encryption parameters...\",\n        \"The system of claim 2, wherein the security level...\",\n        \"The method of claim 1, wherein the multi-layered approach...\",\n        \"The system of claim 2, wherein the data compression technique...\",\n        \"The method of claim 1, wherein the error correction code...\",\n        \"The system of claim 2, wherein the authentication mechanism...\",\n        \"The method of claim 1, wherein the data integrity check...\",\n        \"The system of claim 2, wherein the access control policy...\",\n        \"The method of claim 1, wherein the tamper detection system...\",\n        \"The system of claim 2, wherein the intrusion prevention system...\",\n        \"The method of claim 1, wherein the vulnerability assessment tool...\",\n        \"The system of claim 2, wherein the threat intelligence feed...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68729", "text": "{\n    \"patent_title\": \"Surgical System with Enhanced Visualization and Robotic Assistance\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"EP3845912B1\",\n    \"priority_date\": \"2019-07-15\",\n    \"filing_date\": \"2020-01-20\",\n    \"issue_date\": \"2021-11-10\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"This invention discloses a robotic surgical system enabling minimally invasive procedures with improved precision. The system integrates real-time imaging with robotic manipulation for enhanced surgical outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system comprising...\",\n        \"A method for performing minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68729", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Vascular Access\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Clara Davis\",\n            \"affiliation\": \"BioTech Solutions Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-03-01\",\n    \"filing_date\": \"2018-09-10\",\n    \"issue_date\": \"2020-05-26\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A novel catheter design for improving vascular access during medical procedures. The catheter features a flexible tip and improved biocompatibility.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising...\",\n        \"A method for accessing a blood vessel...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68730", "text": "{\n    \"patent_title\": \"Enhanced Magnetic Resonance Imaging with Artificial Intelligence Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-10-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for enhancing the resolution and clarity of magnetic resonance images using deep learning algorithms. The invention improves diagnostic accuracy by reducing noise and artifacts in the images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing magnetic resonance images...\",\n        \"A system comprising a magnetic resonance imaging device...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The method of claim 1, wherein the deep learning algorithm...\",\n        \"The system of claim 2, further comprising a display...\",\n        \"The method of claim 1, where the diagnostic accuracy is increased by at least 10%.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68730", "text": "{\n    \"patent_title\": \"Automated X-Ray Analysis System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for analyzing X-ray images to detect fractures. The system utilizes image processing techniques to identify potential fractures and highlight them for radiologists.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for analyzing X-ray images...\",\n        \"A method for detecting fractures...\",\n        \"A computer program for processing X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68731", "text": "{\n    \"patent_title\": \"Non-Invasive Glucose Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive glucose monitoring system using near-infrared spectroscopy to determine blood glucose levels without requiring a blood sample. This improves patient comfort and reduces infection risk.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8545789B2\",\n            \"relevance\": \"Prior art in non-invasive sensing\"\n        }\n    ],\n    \"claims\": [\n        \"A non-invasive glucose monitoring device comprising a near-infrared spectrometer.\",\n        \"A method for determining blood glucose levels using near-infrared spectroscopy.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68731", "text": "{\n    \"patent_title\": \"Surgical Robotic Arm with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Intuitive Surgical\"\n        },\n        {\n            \"name\": \"Emily Chen\",\n            \"affiliation\": \"Intuitive Surgical\"\n        },\n        {\n            \"name\": \"Frank Garcia\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical robotic arm with improved precision and dexterity for minimally invasive surgical procedures. The arm incorporates advanced sensors and control algorithms to enhance surgical accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"relevance\": \"Prior art in surgical robotics\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic arm comprising a plurality of sensors.\",\n        \"A control system for a surgical robotic arm.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68732", "text": "{\n    \"patent_title\": \"Improved Nasal Cannula for Enhanced Patient Comfort\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-15\",\n    \"issue_date\": \"2019-06-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel nasal cannula design incorporating flexible materials and ergonomic contours to significantly improve patient comfort during prolonged oxygen therapy. The design minimizes pressure points and reduces skin irritation, leading to better patient compliance and outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art on nasal cannula design\"\n        }\n    ],\n    \"claims\": [\n        \"A nasal cannula comprising a flexible tube...\",\n        \"The nasal cannula of claim 1, wherein the flexible tube is made of silicone...\",\n        \"A method for improving patient comfort...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68732", "text": "{\n    \"patent_title\": \"Surgical Instrument for Precise Tissue Dissection\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"University of Valencia\"\n        }\n    ],\n    \"patent_number\": \"EP3456789B1\",\n    \"priority_date\": \"2012-05-20\",\n    \"filing_date\": \"2012-05-20\",\n    \"issue_date\": \"2018-11-14\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"A highly precise surgical instrument designed for delicate tissue dissection. The instrument features a micro-robotic arm and advanced sensor technology for enhanced control and accuracy during surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related to robotic surgery systems\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising a robotic arm...\",\n        \"The surgical instrument of claim 1, wherein the robotic arm is controlled by a surgeon...\",\n        \"A method for precise tissue dissection...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68733", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Cardiac Monitor with Wireless Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable cardiac monitor for long-term continuous ECG monitoring. The device utilizes low-power wireless communication for real-time data transmission to a remote monitoring station, enabling early detection of cardiac arrhythmias and improving patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art relating to implantable cardiac devices.\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable cardiac monitor comprising...\",\n        \"A wireless communication module for transmitting ECG data...\",\n        \"A low-power circuit design for extended battery life...\",\n        \"A method for detecting cardiac arrhythmias using the transmitted ECG data...\",\n        \"A remote monitoring system for receiving and analyzing the ECG data...\",\n        \"A system for alerting healthcare professionals in case of critical events...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68733", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Angioplasty\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2022-07-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design for use in percutaneous coronary intervention (PCI) procedures, featuring enhanced flexibility and reduced trauma to blood vessels. This catheter improves delivery of stents to narrowed coronary arteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Previous catheter designs used in PCI.\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible distal tip...\",\n        \"A lumen for delivering a stent...\",\n        \"A method for navigating a catheter through a coronary artery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68734", "text": "{\n    \"patent_title\": \"AI-Enhanced Medical Image Analysis for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-06-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method for early cancer detection using medical images analyzed with artificial intelligence algorithms. The system improves diagnostic accuracy and reduces false positives.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Medical Image Segmentation\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancer using AI.\",\n        \"A system for analyzing medical images.\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68734", "text": "{\n    \"patent_title\": \"Improved X-Ray Tube Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2017-01-10\",\n    \"filing_date\": \"2017-01-10\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved design for X-ray tubes, enhancing image clarity and reducing radiation exposure. The design incorporates a novel filament material and cooling system.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"X-Ray Tube Cooling Methods\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube with a novel filament.\",\n        \"A cooling system for an X-ray tube.\",\n        \"A method for manufacturing an X-ray tube...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68735", "text": "{\n    \"patent_title\": \"Enhanced MRI Image Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-12-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel deep learning-based method for reconstructing MRI images with significantly improved resolution and contrast, addressing challenges in early disease diagnosis. The method utilizes a generative adversarial network (GAN) to enhance image quality and reduce noise, leading to more accurate diagnostic results.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"related prior art\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"relevant background\"\n        },\n        {\n            \"patent_number\": \"US11000001B2\",\n            \"relevance\": \"related concept\"\n        },\n        {\n            \"patent_number\": \"US11111111B2\",\n            \"relevance\": \"building upon\"\n        },\n        {\n            \"patent_number\": \"US11222222B2\",\n            \"relevance\": \"cited for comparison\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68735", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Angiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Medical Device Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11999999B2\",\n    \"priority_date\": \"2021-05-20\",\n    \"filing_date\": \"2021-05-20\",\n    \"issue_date\": \"2023-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel catheter design that improves maneuverability during angiography procedures, minimizing patient discomfort and reducing procedure time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"prior art\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"related concept\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter for angiography comprising...\",\n        \"A method for using the catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68736", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical Robot with Haptic Feedback System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2023-11-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical robotic system providing enhanced haptic feedback to the surgeon, enabling greater precision and control during minimally invasive procedures. The system incorporates force sensors and a control algorithm to translate sensed forces into tactile sensations for the surgeon.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic system comprising: a robotic arm with at least one degree of freedom; a force sensor coupled to the robotic arm; a haptic feedback module configured to generate tactile sensations; and a control system configured to translate force readings from the force sensor into tactile sensations provided to a surgeon.\",\n        \"The surgical robotic system of claim 1, wherein the force sensor measures forces in at least three dimensions.\",\n        \"The surgical robotic system of claim 1, wherein the haptic feedback module comprises a vibrotactile actuator.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68736", "text": "{\n    \"patent_title\": \"Novel Pharmaceutical Composition for Treating Hypertension\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2022-09-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel pharmaceutical composition comprising a selective angiotensin II receptor blocker for the treatment of hypertension. The composition exhibits improved bioavailability and reduced side effects.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A pharmaceutical composition comprising: a selective angiotensin II receptor blocker; and a pharmaceutically acceptable excipient.\",\n        \"The pharmaceutical composition of claim 1, wherein the selective angiotensin II receptor blocker is valsartan.\",\n        \"The pharmaceutical composition of claim 1, wherein the composition is formulated for oral administration.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68737", "text": "{\n    \"patent_title\": \"Magnetic Resonance Imaging with Enhanced Contrast Agents for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-09-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for enhancing contrast in magnetic resonance images using novel nanoparticle contrast agents, improving early cancer detection rates.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Nanoparticle Synthesis for Medical Applications\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI contrast...\",\n        \"A composition comprising nanoparticles...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68737", "text": "{\n    \"patent_title\": \"Improved X-ray Tube Design for Reduced Radiation Exposure\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2015-05-10\",\n    \"filing_date\": \"2015-05-10\",\n    \"issue_date\": \"2018-02-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved x-ray tube design incorporating a novel anode material to reduce radiation exposure during imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"X-ray Imaging System with Enhanced Filtering\"\n        }\n    ],\n    \"claims\": [\n        \"An x-ray tube comprising a tungsten alloy anode...\",\n        \"A method for reducing radiation exposure...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68738", "text": "{\n    \"patent_title\": \"Contrast-Enhanced Ultrasound Imaging System with Adaptive Signal Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-07-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel contrast-enhanced ultrasound imaging system incorporating adaptive signal processing techniques to significantly improve image quality and diagnostic accuracy. The system utilizes microbubble contrast agents and dynamically adjusts signal parameters based on tissue characteristics, enhancing visualization of microvasculature and improving the detection of subtle lesions. It has shown improved results in preclinical trials for breast cancer detection. The collaboration between MIT and GE Healthcare enabled the development of both the hardware and software components.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast-enhanced ultrasound imaging system comprising...\",\n        \"A method for adaptive signal processing in ultrasound imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68738", "text": "{\n    \"patent_title\": \"Digital Radiography Enhancement Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2018-11-01\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new algorithm to enhance digital radiography images. Increases contrast in low-dose images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing digital radiographic images...\",\n        \"A system comprising a digital radiography detector and a processing unit...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68739", "text": "{\n    \"patent_title\": \"Method and System for Enhanced MRI Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for enhancing the resolution of MRI images using deep learning techniques. The invention provides significant improvements in image clarity and diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for enhancing MRI image resolution...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68739", "text": "{\n    \"patent_title\": \"Improved X-ray Imaging System with Enhanced Contrast\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-01-15\",\n    \"filing_date\": \"2022-01-15\",\n    \"issue_date\": \"2024-02-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved X-ray imaging system that utilizes a novel contrast agent to enhance image quality. This invention provides increased visibility of internal structures and improved diagnostic capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A method for enhancing contrast in X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68740", "text": "{\n    \"patent_title\": \"Enhanced MRI Image Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"11,234,567\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2021-12-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for reconstructing high-resolution MRI images using deep learning techniques. The method significantly improves diagnostic accuracy in identifying subtle anomalies, leading to earlier and more effective treatment.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"10,123,456\",\n            \"kind\": \"US\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images...\",\n        \"A system for processing MRI data...\",\n        \"A computer program for implementing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68740", "text": "{\n    \"patent_title\": \"Portable X-Ray Device for Veterinary Use\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Veterinary Imaging Solutions Inc.\"\n        }\n    ],\n    \"patent_number\": \"10,987,654\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-07-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A compact and portable X-ray device designed for veterinary diagnostic applications. It provides clear images for rapid on-site assessments.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"9,876,543\",\n            \"kind\": \"US\"\n        }\n    ],\n    \"claims\": [\n        \"A portable X-ray device comprising...\",\n        \"A radiation shielding mechanism...\",\n        \"An image display unit...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68741", "text": "{\n    \"patent_title\": \"Medical Image Enhancement Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-08-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for enhancing the quality of medical images using deep convolutional neural networks. The method significantly improves image clarity, enabling more accurate diagnoses. The approach is applicable to a wide range of medical imaging modalities, including X-ray, MRI, and CT scans. The system includes preprocessing, network training, and post-processing modules to provide optimized image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing medical images comprising...\",\n        \"A system for processing medical images...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68741", "text": "{\n    \"patent_title\": \"Simple Image Resizing Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Independent Inventor\"\n        }\n    ],\n    \"patent_number\": \"US7654321B2\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A basic image resizing algorithm.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for resizing images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68742", "text": "{\n    \"patent_title\": \"Advanced Modulation Techniques for 5G Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-04-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention introduces novel modulation schemes for 5G wireless communication systems, enhancing spectral efficiency and reducing latency. The techniques utilize advanced signal processing algorithms to overcome channel impairments and improve data throughput.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9546987B2\",\n            \"relevance\": \"high\"\n        },\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"medium\"\n        },\n        {\n            \"patent_number\": \"US10234567B2\",\n            \"relevance\": \"high\"\n        },\n        {\n            \"patent_number\": \"US10543210B2\",\n            \"relevance\": \"medium\"\n        },\n        {\n            \"patent_number\": \"US10678901B2\",\n            \"relevance\": \"high\"\n        },\n        {\n            \"patent_number\": \"US10789012B2\",\n            \"relevance\": \"medium\"\n        }\n    ],\n    \"claims\": [\n        \"A method for modulating a signal...\",\n        \"A wireless communication system comprising...\",\n        \"A device for implementing the modulation method...\",\n        \"The method according to claim 1, wherein...\",\n        \"The system according to claim 2, wherein...\",\n        \"The device according to claim 3, wherein...\",\n        \"The modulation method according to claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68742", "text": "{\n    \"patent_title\": \"Improved Antenna Design for Bluetooth Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"SmallTech Inc.\"\n        }\n    ],\n    \"patent_number\": \"US8901234B2\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2016-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a compact antenna design suitable for Bluetooth devices, offering improved signal strength and reduced interference. The design incorporates a novel matching network to enhance efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"medium\"\n        },\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"relevance\": \"low\"\n        }\n    ],\n    \"claims\": [\n        \"An antenna for a Bluetooth device...\",\n        \"The antenna according to claim 1, wherein...\",\n        \"A Bluetooth device comprising the antenna...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68743", "text": "{\n    \"patent_title\": \"Novel Electrolyte Composition for Enhanced Lithium-Ion Battery Performance\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2022-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel electrolyte composition for lithium-ion batteries that enhances ionic conductivity and improves battery lifespan, utilizing environmentally friendly materials.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on electrolyte additives\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrolyte comprising...\",\n        \"A method for improving the performance of a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68743", "text": "{\n    \"patent_title\": \"Integrated Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-11-20\",\n    \"filing_date\": \"2020-11-20\",\n    \"issue_date\": \"2023-07-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an integrated battery management system specifically designed for electric vehicles, optimizing charging and discharging cycles to maximize range and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"relevance\": \"Related BMS technologies\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for an electric vehicle comprising...\",\n        \"A method for controlling the charging of an electric vehicle battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68744", "text": "{\n    \"patent_title\": \"High-Resolution Optical Coherence Tomography System for Enhanced Retinal Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11245678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A high-resolution optical coherence tomography (OCT) system with improved image quality and penetration depth for detailed retinal analysis. This system utilizes advanced signal processing techniques to enhance image clarity and enable early detection of retinal diseases.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in OCT imaging.\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related technology in image processing.\"\n        },\n        {\n            \"patent_number\": \"US11000111B2\",\n            \"relevance\": \"Similar approach to retinal imaging.\"\n        },\n        {\n            \"patent_number\": \"US11111222B2\",\n            \"relevance\": \"Comparison study on OCT technologies.\"\n        },\n        {\n            \"patent_number\": \"US11222333B2\",\n            \"relevance\": \"Relevant citation for image clarity\"\n        },\n        {\n            \"patent_number\": \"US11333444B2\",\n            \"relevance\": \"Related citation for deep learning\"\n        },\n        {\n            \"patent_number\": \"US11444555B2\",\n            \"relevance\": \"Related citation for retinal diseases\"\n        },\n        {\n            \"patent_number\": \"US11555666B2\",\n            \"relevance\": \"Comparison of imaging systems\"\n        },\n        {\n            \"patent_number\": \"US11666777B2\",\n            \"relevance\": \"Related to the prior art\"\n        },\n        {\n            \"patent_number\": \"US11777888B2\",\n            \"relevance\": \"Relevant to image quality\"\n        },\n        {\n            \"patent_number\": \"US11888999B2\",\n            \"relevance\": \"Related citation for signal processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for high-resolution retinal imaging using OCT.\",\n        \"An OCT system comprising an interferometer and a signal processing unit.\",\n        \"A method for detecting retinal diseases using the OCT system.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68744", "text": "{\n    \"patent_title\": \"Portable Ultrasound Device for Basic Medical Screening\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. John Smith\",\n            \"affiliation\": \"Small Medical Device Co.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-08-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A portable ultrasound device designed for quick and basic medical screening in remote areas. This device provides real-time imaging for basic diagnostic purposes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art in ultrasound technology.\"\n        },\n        {\n            \"patent_number\": \"US9654321B2\",\n            \"relevance\": \"Related technology in portable devices.\"\n        }\n    ],\n    \"claims\": [\n        \"A portable ultrasound device for medical screening.\",\n        \"A method for obtaining real-time ultrasound images.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68745", "text": "{\n    \"patent_title\": \"Non-Invasive Cardiac Monitoring System Using Wearable Sensors\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Chen\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel wearable sensor system for continuous, non-invasive monitoring of cardiac function. The system utilizes advanced signal processing algorithms to detect arrhythmias and other cardiac anomalies with high accuracy. Applications include remote patient monitoring, early diagnosis of heart disease, and personalized treatment planning.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art in wearable sensor technology.\"\n        }\n    ],\n    \"claims\": [\n        \"A system for non-invasive cardiac monitoring comprising...\",\n        \"A method for detecting cardiac arrhythmias using...\",\n        \"A wearable sensor device for continuous ECG recording...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68745", "text": "{\n    \"patent_title\": \"Surgical Tool for Minimally Invasive Valve Replacement\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Miller\",\n            \"affiliation\": \"Boston Scientific\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical instrument designed for minimally invasive replacement of cardiac valves. The tool incorporates a robotic control system for precise manipulation and improved surgical outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Prior art relating to robotic surgical systems.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical tool for valve replacement comprising...\",\n        \"A robotic control system for precise manipulation...\",\n        \"A method for minimally invasive valve replacement...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68746", "text": "{\n    \"patent_title\": \"Novel Solid-State Electrolyte for Lithium-Ion Batteries with Enhanced Sustainability\",\n    \"inventors\": [\n        {\n            \"name\": \"Maria Hernandez\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-08-20\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel solid-state electrolyte composition is disclosed, offering improved ionic conductivity and reduced reliance on scarce materials, contributing to more sustainable battery production. The manufacturing process utilizes cost-effective methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on solid-state electrolytes\"\n        }\n    ],\n    \"claims\": [\n        \"A solid-state electrolyte composition comprising...\",\n        \"A method for manufacturing a lithium-ion battery using said electrolyte composition...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68746", "text": "{\n    \"patent_title\": \"Battery Management System for Electric Vehicles with Optimized Charging Algorithms\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2021-02-15\",\n    \"issue_date\": \"2023-04-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An advanced battery management system (BMS) designed for electric vehicles. The system features optimized charging algorithms to extend battery life and improve vehicle performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Prior art on BMS systems\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for an electric vehicle, comprising...\",\n        \"A method for controlling battery charging using said BMS...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68747", "text": "{\n    \"patent_title\": \"Low-Dose Computed Tomography Imaging System and Method\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-06-20\",\n    \"issue_date\": \"2021-12-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a computed tomography (CT) imaging system and method for reducing patient radiation exposure while maintaining image quality.  The system utilizes advanced iterative reconstruction algorithms and optimized scan protocols to achieve significant dose reduction.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A CT imaging system comprising...\",\n        \"A method for reducing radiation dose...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68747", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging Coil Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-04-15\",\n    \"issue_date\": \"2022-08-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an improved coil design for magnetic resonance imaging (MRI) systems, enhancing signal-to-noise ratio and image resolution. The coil utilizes a novel geometric configuration and advanced materials.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil comprising...\",\n        \"A method for improving signal...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68748", "text": "{\n    \"patent_title\": \"AI-Powered Image Enhancement for Retinal Disease Diagnosis\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11256789B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-12-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel system for enhancing retinal images using deep learning algorithms to improve the diagnosis of diabetic retinopathy and macular degeneration. The system utilizes a generative adversarial network (GAN) to generate high-resolution images from low-resolution inputs, providing clinicians with clearer visualizations for more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in image denoising\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing retinal images comprising...\",\n        \"A system for diagnosing retinal diseases...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The system of claim 2, wherein the deep learning algorithm is a GAN.\",\n        \"The method of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68748", "text": "{\n    \"patent_title\": \"Method for Improving Color Correction in Digital Photography\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method for automatically adjusting the color balance in digital photographs to improve visual quality. The method utilizes a histogram equalization technique and a color temperature adjustment algorithm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art in histogram equalization\"\n        }\n    ],\n    \"claims\": [\n        \"A method for adjusting color balance in a digital image...\",\n        \"A digital camera comprising...\",\n        \"A computer program for...\",\n        \"The method of claim 1, wherein the color temperature adjustment...\",\n        \"The method of claim 2, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68749", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Feedback\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2022-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system incorporating haptic feedback and real-time imaging to enhance surgical precision and patient comfort. The system reduces tissue trauma and shortens recovery times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in minimally invasive surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A minimally invasive surgical system comprising a haptic feedback module.\",\n        \"A method for performing surgery using the system, reducing tissue trauma.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68749", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Generic Pharma Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-02-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel catheter design for targeted drug delivery with enhanced flow rates. Improves drug efficacy and reduces systemic side effects.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous catheter designs\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter with a modified lumen for improved flow.\",\n        \"A method for targeted drug delivery using the catheter.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68750", "text": "{\n    \"patent_title\": \"AI-Powered Diagnostic System for Early Detection of Cardiovascular Disease\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"University of Oxford\"\n        }\n    ],\n    \"patent_number\": \"EP3854721B1\",\n    \"priority_date\": \"2020-11-15\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2022-08-03\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"This invention discloses an AI-driven system for the early detection of cardiovascular disease by analyzing patient data, including blood test results and medical history. It uses machine learning algorithms to identify patterns indicative of potential heart conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US20190376222A1\",\n            \"title\": \"Machine Learning for Medical Diagnosis\"\n        },\n        {\n            \"patent_number\": \"WO2018197793A1\",\n            \"title\": \"Artificial Intelligence in Healthcare\"\n        }\n    ],\n    \"claims\": [\n        \"A system for diagnosing cardiovascular disease comprising: a data input module...\",\n        \"A method for identifying patients at risk of cardiovascular disease...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68750", "text": "{\n    \"patent_title\": \"Automated Image Analysis for Lung Nodule Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Michael Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Sarah Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2021-03-01\",\n    \"filing_date\": \"2021-09-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"This invention relates to a method and system for automatically detecting lung nodules in CT scans using image processing and computer vision techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US20170289487A1\",\n            \"title\": \"Computer-Aided Detection of Lung Nodules\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting lung nodules in an image...\",\n        \"A computer system configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68751", "text": "{\n    \"patent_title\": \"Implantable Cardiac Monitor with Enhanced Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Boston University\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-06-20\",\n    \"issue_date\": \"2020-01-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac monitor with improved signal processing and data transmission capabilities, enabling remote monitoring of heart conditions and providing timely alerts for potential emergencies, leading to improved patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for remotely monitoring cardiac activity...\",\n        \"An implantable device comprising a sensor and a transmitter...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68751", "text": "{\n    \"patent_title\": \"Novel Biosensor for Rapid Viral Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Li Wei\",\n            \"affiliation\": \"Tsinghua University\"\n        },\n        {\n            \"name\": \"Zhang Hua\",\n            \"affiliation\": \"Peking University\"\n        }\n    ],\n    \"patent_number\": \"CN112345678B\",\n    \"priority_date\": \"2019-03-10\",\n    \"filing_date\": \"2019-04-05\",\n    \"issue_date\": \"2020-09-18\",\n    \"patent_office\": \"SIPO\",\n    \"abstract\": \"A biosensor utilizing nanotechnology for the rapid and accurate detection of viral pathogens. This device enables faster diagnosis and timely treatment, improving public health outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A biosensor comprising a nanomaterial-based sensing element...\",\n        \"A method for detecting a viral pathogen using the biosensor...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68752", "text": "{\n    \"patent_title\": \"Portable Ultrasound Device for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A portable ultrasound device with advanced image processing algorithms for early cancer detection in remote areas. This invention aims to improve patient survival rates through faster diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on ultrasound imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A portable ultrasound device comprising...\",\n        \"A method for early cancer detection using the device...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68752", "text": "{\n    \"patent_title\": \"Implantable Cardiovascular Defibrillator with Enhanced Battery Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Carlos Ramirez\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Diana Lee\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-06-10\",\n    \"filing_date\": \"2020-06-10\",\n    \"issue_date\": \"2022-12-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiovascular defibrillator featuring a novel battery technology that significantly extends device lifespan, reducing the need for frequent replacements. Aims to improve quality of life for patients with heart conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related prior art on implantable defibrillators\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable cardiovascular defibrillator...\",\n        \"A battery technology for extended device life...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68753", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Sensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2019-03-20\",\n    \"issue_date\": \"2021-11-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable sensor for continuous glucose monitoring using a novel enzymatic reaction and wireless communication. The device is designed for long-term implantation and provides real-time glucose data to a mobile application.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on glucose sensors.\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable glucose sensor.\",\n        \"A wireless communication system for transmitting glucose data.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68753", "text": "{\n    \"patent_title\": \"Advanced Robotic Surgical System with Haptic Feedback\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-01-10\",\n    \"filing_date\": \"2018-07-12\",\n    \"issue_date\": \"2022-04-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An advanced robotic surgical system incorporating high-precision robotic arms and sophisticated haptic feedback mechanisms to enhance surgical accuracy and control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Prior art on robotic surgery.\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system with haptic feedback.\",\n        \"A method for controlling a robotic surgical arm.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68754", "text": "{\n    \"patent_title\": \"Enhanced MRI Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method for reconstructing MRI images using deep learning techniques, resulting in improved image quality and reduced scan time. This allows for faster and more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68754", "text": "{\n    \"patent_title\": \"Improved X-Ray Tube Design for General Radiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2017-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved X-ray tube design incorporating a novel anode material and focusing system. The new design significantly increases the X-ray flux and reduces heat loading, leading to improved image quality and increased patient throughput. The invention also covers methods for manufacturing the tube and systems incorporating the tube. The detailed description includes material compositions, geometric parameters, and operational characteristics. Further advancements are made by implementing a pulsed power supply to enhance the efficiency and safety of the X-ray generation process. A comprehensive analysis of the benefits of this design, including reduced radiation dose and improved image resolution, is also presented. The application details various embodiments and configurations, tailored to different clinical requirements and imaging modalities. The design aims to facilitate more accurate and rapid diagnosis in a variety of medical settings.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube comprising...\",\n        \"A method for manufacturing an X-ray tube...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68755", "text": "{\n    \"patent_title\": \"Implantable Cardiac Monitor with Enhanced Data Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10554236B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac monitor is disclosed. The monitor continuously records electrocardiogram (ECG) data and utilizes advanced algorithms to detect and diagnose various heart conditions, including atrial fibrillation and bradycardia. The device transmits data wirelessly to a remote monitoring station for analysis by a physician. The system provides real-time alerts and facilitates proactive patient care. The device's functionalities are detailed in its clinical applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8950516B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for monitoring cardiac activity comprising...\",\n        \"An implantable device for detecting arrhythmia...\",\n        \"A system for wireless transmission of ECG data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68755", "text": "{\n    \"patent_title\": \"Automated Heart Sound Analysis System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-09-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for analyzing heart sounds to identify potential cardiovascular abnormalities. The system utilizes a digital stethoscope and signal processing algorithms to detect murmurs and other abnormal sounds.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for analyzing heart sounds...\",\n        \"A digital stethoscope apparatus...\",\n        \"A system for detecting cardiac murmurs...\",\n        \"A method for classifying heart sounds...\",\n        \"A system for providing a diagnostic report...\",\n        \"A computer-readable medium storing instructions for...\",\n        \"A method for filtering noise from heart sounds...\",\n        \"A system for visualizing heart sound waveforms...\",\n        \"A method for quantifying heart sound parameters...\",\n        \"A system for integrating heart sound analysis with other diagnostic tools...\",\n        \"A method for remote monitoring of heart sounds...\",\n        \"A system for providing alerts based on heart sound analysis...\",\n        \"A method for personalizing heart sound analysis based on patient data...\",\n        \"A system for automatically generating reports based on heart sound analysis...\",\n        \"A method for detecting congenital heart defects using heart sounds...\",\n        \"A system for predicting cardiovascular risk based on heart sound analysis...\",\n        \"A method for training machine learning models for heart sound analysis...\",\n        \"A system for providing feedback to clinicians on heart sound analysis...\",\n        \"A method for improving the accuracy of heart sound analysis...\",\n        \"A system for assessing the effectiveness of cardiac interventions using heart sounds...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68756", "text": "{\n    \"patent_title\": \"Deep Learning for Personalized Medicine Prediction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-15\",\n    \"issue_date\": \"2023-02-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for predicting patient response to treatment based on genomic and clinical data. The system identifies biomarkers for personalized medicine and improves treatment outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11111111B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for predicting patient response to treatment using deep learning.\",\n        \"A system for identifying biomarkers for personalized medicine.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68756", "text": "{\n    \"patent_title\": \"Convolutional Neural Network for Medical Image Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2020-11-15\",\n    \"filing_date\": \"2020-11-20\",\n    \"issue_date\": \"2022-09-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A convolutional neural network (CNN) for automatic detection of anomalies in medical images such as X-rays and MRIs. The system utilizes image processing techniques to enhance diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting anomalies in medical images using a CNN.\",\n        \"A system for enhancing diagnostic accuracy with image processing.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68757", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Pressure Sensor for Intracranial Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-06-22\",\n    \"issue_date\": \"2023-10-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized wireless pressure sensor is disclosed for real-time monitoring of intracranial pressure. The device utilizes a novel MEMS fabrication technique and a biocompatible coating, enabling long-term implantation and improved patient outcomes by providing early detection of intracranial pressure changes. The wireless transmission allows for continuous monitoring without the constraints of wired connections.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on intracranial pressure monitoring\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising...\",\n        \"A method for monitoring intracranial pressure using the wireless sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68757", "text": "{\n    \"patent_title\": \"Surgical Stapler with Enhanced Jaw Alignment\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Johnson & Johnson\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Johnson & Johnson\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2022-08-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler is described, featuring a mechanism for precise jaw alignment during staple deployment. This design reduces staple misfires and improves surgical precision. The stapler is designed for use in a variety of surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art on surgical staplers\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"A jaw alignment mechanism for a surgical stapler...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68758", "text": "{\n    \"patent_title\": \"Ergonomic Design for Disposable Endoscopic Instruments\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Boston Medical Center\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A disposable endoscopic instrument with an improved ergonomic handle design, enhancing user control and reducing hand fatigue during prolonged procedures. The design incorporates textured grips and a lightweight construction to optimize patient and physician comfort.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A disposable endoscopic instrument comprising an ergonomic handle...\",\n        \"The instrument of claim 1, wherein the handle includes textured grips...\",\n        \"The instrument of claim 1, wherein the instrument is constructed from a lightweight material...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68758", "text": "{\n    \"patent_title\": \"Cardiovascular Stent with Drug-Eluting Coating\",\n    \"inventors\": [\n        {\n            \"name\": \"Charles Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Garcia\",\n            \"affiliation\": \"Medtronic\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2024-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A cardiovascular stent comprising a metallic scaffold and a drug-eluting coating to prevent restenosis after angioplasty. The stent is designed for long-term implantation in coronary arteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiovascular stent comprising a metallic scaffold...\",\n        \"The stent of claim 1, further comprising a drug-eluting coating...\",\n        \"The stent of claim 1, wherein the stent is designed for implantation in a coronary artery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68759", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Electrolyte and Stable Interface\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2023-11-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel lithium-ion battery incorporating a fluorinated electrolyte and a surface modification layer on the anode to enhance energy density and cycle life. The improved electrolyte reduces dendrite formation, while the surface layer stabilizes the solid electrolyte interphase (SEI). Experimental results demonstrate a 20% increase in energy density and a 30% improvement in cycle life compared to conventional lithium-ion batteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Lithium-Ion Battery Electrolyte Composition\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising: an anode; a cathode; and an electrolyte containing a fluorinated solvent.\",\n        \"The lithium-ion battery of claim 1, wherein the fluorinated solvent comprises at least 5% by weight of a fluorinated carbonate.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68759", "text": "{\n    \"patent_title\": \"Improved Lead-Acid Battery with Enhanced Plate Design\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Exide Technologies\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2021-03-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details an improved lead-acid battery featuring a novel plate design and electrolyte formulation to enhance its performance and lifespan. The new plate structure increases the surface area available for reaction, while the optimized electrolyte reduces sulfation. This results in a 10% increase in capacity and a 15% longer cycle life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Lead-Acid Battery with Anti-Sulfation Additive\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Improved Lead Alloy for Lead-Acid Batteries\"\n        }\n    ],\n    \"claims\": [\n        \"A lead-acid battery comprising: a positive plate; a negative plate; and an electrolyte solution containing sulfuric acid and an anti-sulfation additive.\",\n        \"The lead-acid battery of claim 1, wherein the positive plate has a tubular structure.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68760", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Enhancement for Satellite Imagery\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for enhancing the resolution and clarity of satellite imagery using deep learning techniques. The system employs a convolutional neural network to remove noise and improve image details, leading to better analysis and interpretation of geospatial data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Restoration using Generative Adversarial Networks\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing satellite imagery comprising:...\",\n        \"A system for processing images using a deep learning model...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68760", "text": "{\n    \"patent_title\": \"MRI Image Reconstruction with Compressed Sensing\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-11-15\",\n    \"filing_date\": \"2020-11-15\",\n    \"issue_date\": \"2022-08-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a method for reconstructing high-quality Magnetic Resonance Imaging (MRI) images from undersampled data using compressed sensing techniques. It addresses the challenges of reducing scan time while maintaining image fidelity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Compressed Sensing for Medical Imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for processing medical imaging data using compressed sensing...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68761", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging Technique for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Chen\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel magnetic resonance imaging (MRI) technique employing advanced pulse sequences and image reconstruction algorithms. The technique enhances image contrast and resolution, enabling earlier detection of cancerous tissues with improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in MRI pulse sequences\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Image reconstruction algorithm comparison\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing magnetic resonance imaging comprising...\",\n        \"An MRI system configured to implement the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68761", "text": "{\n    \"patent_title\": \"Digital X-Ray Enhancement System\",\n    \"inventors\": [\n        {\n            \"name\": \"Mr. Robert Miller\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2023-03-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing the quality of digital X-ray images by applying image processing filters. The system improves the visibility of subtle anatomical details.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous X-ray enhancement techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A digital X-ray image enhancement system comprising...\",\n        \"A method for processing digital X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68762", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Pressure Sensor for Intracranial Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A miniaturized wireless pressure sensor for continuous intracranial pressure monitoring. The sensor utilizes novel nanomaterials for enhanced sensitivity and biocompatibility, enabling minimally invasive long-term monitoring of patients with traumatic brain injury. The device transmits data wirelessly to an external receiver for real-time analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on wireless sensor technology\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising a nanomaterial-based pressure transducer.\",\n        \"A system for intracranial pressure monitoring using the wireless pressure sensor.\",\n        \"A method for minimally invasive intracranial pressure monitoring.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68762", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Vascular Access\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"University of Barcelona\"\n        }\n    ],\n    \"patent_number\": \"EP3876543B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-02-15\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"An improved catheter design featuring a modified tip geometry for enhanced navigation through blood vessels. The catheter is intended for routine vascular access procedures and reduces the risk of vessel damage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related art on catheter tip designs\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter with a modified tip geometry.\",\n        \"A method for accessing blood vessels using the improved catheter.\",\n        \"The catheter being suitable for routine vascular access.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68763", "text": "{\n    \"patent_title\": \"High-Performance Solid-State Battery with Enhanced Cycle Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel solid-state battery design utilizing a polymer electrolyte with improved ionic conductivity and a lithium metal anode, resulting in enhanced energy density and cycle life. The battery's materials are sourced with sustainability in mind.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A solid-state battery comprising...\",\n        \"A method for manufacturing a solid-state battery...\",\n        \"A battery cell with enhanced cycle life...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68763", "text": "{\n    \"patent_title\": \"Improved Lead-Acid Battery Design\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Exide Technologies\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-12-01\",\n    \"filing_date\": \"2019-12-01\",\n    \"issue_date\": \"2022-06-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved lead-acid battery design featuring a novel grid structure for enhanced performance and reduced corrosion. The design focuses on increasing battery lifespan in automotive applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A lead-acid battery comprising...\",\n        \"A grid structure for a lead-acid battery...\",\n        \"A method for reducing corrosion in a lead-acid battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68764", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for analyzing medical images to identify anomalies with improved accuracy. The system utilizes advanced image processing techniques to enhance image quality and facilitate more precise diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Medical Image Processing System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing a medical image, comprising...\",\n        \"A system for analyzing a medical image, comprising...\",\n        \"The method of claim 1, wherein the image processing technique comprises...\",\n        \"The system of claim 2, wherein the image analysis is performed using...\",\n        \"The method of claim 1, further comprising...\",\n        \"The system of claim 2, further comprising...\",\n        \"Claim 7, wherein the enhanced image...\",\n        \"Claim 8, where the analysis includes...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68764", "text": "{\n    \"patent_title\": \"New Chemical Compound for Agricultural Use\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"AgriCorp Inc.\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2012-03-10\",\n    \"filing_date\": \"2012-03-10\",\n    \"issue_date\": \"2016-07-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel chemical compound designed to enhance crop yields and protect against pests. The compound is environmentally friendly and highly effective.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A chemical compound comprising...\",\n        \"A method for increasing crop yield, comprising applying...\",\n        \"The compound of claim 1, wherein the crop is...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68765", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Sensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-15\",\n    \"issue_date\": \"2023-02-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable sensor for continuous glucose monitoring, providing real-time data transmission to improve diabetes management and patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on implantable sensors\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized glucose sensor...\",\n        \"A system for continuous glucose monitoring...\",\n        \"A method for improving diabetes management...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68765", "text": "{\n    \"patent_title\": \"Novel Dental Implant System with Enhanced Osseointegration\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of California, San Francisco\"\n        },\n        {\n            \"name\": \"Dr. Ben Miller\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-01-15\",\n    \"filing_date\": \"2022-02-20\",\n    \"issue_date\": \"2023-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel dental implant system designed for enhanced osseointegration and improved long-term stability in dental restorations. Focuses on improved patient comfort and aesthetic results.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art in dental implant materials\"\n        }\n    ],\n    \"claims\": [\n        \"A dental implant with a modified surface...\",\n        \"A dental restoration system...\",\n        \"A method for improving osseointegration in dental implants...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68766", "text": "{\n    \"patent_title\": \"Improved Dose Reduction Technique for Computed Tomography Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        },\n        {\n            \"name\": \"Robert Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel method for reducing radiation dose in computed tomography imaging while maintaining diagnostic image quality. The method employs adaptive statistical iterative reconstruction (ASIR) with optimized parameters based on patient body composition.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8781023B2\",\n            \"relevance\": \"Prior art on ASIR techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing radiation dose in CT imaging...\",\n        \"A system for implementing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68766", "text": "{\n    \"patent_title\": \"Novel Algorithm for Magnetic Resonance Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        },\n        {\n            \"name\": \"Sarah Chen\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11123456B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a highly complex algorithm for accelerating magnetic resonance image reconstruction using advanced mathematical transformations. The algorithm requires significant computational resources and specialized hardware.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related work on fast MRI reconstruction.\"\n        }\n    ],\n    \"claims\": [\n        \"An algorithm for MRI reconstruction...\",\n        \"A system for performing the algorithm...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68767", "text": "{\n    \"patent_title\": \"Improved Method for Artifact Reduction in Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for reducing artifacts in magnetic resonance images, leading to improved diagnostic accuracy. The method utilizes a deep learning algorithm to identify and suppress noise and distortions in the images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on noise reduction techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing artifacts in magnetic resonance images comprising...\",\n        \"A system for processing magnetic resonance images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68767", "text": "{\n    \"patent_title\": \"Novel Contrast Agent for Enhanced Vascular Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-03-10\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-09-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new contrast agent for improving the visibility of blood vessels in X-ray imaging. The agent contains nanoparticles that enhance X-ray absorption.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous work on nanoparticle contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"A method for enhancing vascular imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68768", "text": "{\n    \"patent_title\": \"Method and System for Enhanced MRI Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for enhancing the quality of Magnetic Resonance Imaging (MRI) images through advanced reconstruction algorithms. The system utilizes machine learning to reduce noise and improve image resolution, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for processing MRI data...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The method of claim 1, wherein the noise reduction...\",\n        \"The system of claim 2, further comprising a display...\",\n        \"The method of claim 1, wherein the machine learning...\",\n        \"The system of claim 2, wherein the MRI data...\",\n        \"A method for enhancing resolution of MRI images...\",\n        \"The method of claim 8, wherein the enhancement...\",\n        \"A system for processing MRI data, comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68768", "text": "{\n    \"patent_title\": \"Improved X-ray Image Enhancement Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-03-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved technique for enhancing the contrast and clarity of X-ray images, allowing for better visualization of anatomical structures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing X-ray images...\",\n        \"A system for processing X-ray data...\",\n        \"The method of claim 1, wherein the contrast is...\",\n        \"The system of claim 2, comprising a filter...\",\n        \"The method of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68769", "text": "{\n    \"patent_title\": \"Enhanced Magnetic Resonance Imaging for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for enhancing magnetic resonance imaging (MRI) to improve the early detection of cancerous tumors. The method utilizes a unique pulse sequence and image reconstruction algorithm resulting in faster scan times and improved image clarity. This allows for earlier and more accurate diagnoses, potentially improving patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art relating to MRI pulse sequences.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI comprising...\",\n        \"An image reconstruction algorithm for use in MRI...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68769", "text": "{\n    \"patent_title\": \"Improved X-ray Imaging System with Reduced Radiation Dose\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-02-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents an enhanced X-ray imaging system that significantly reduces the radiation dose delivered to patients while maintaining image quality. The system employs a novel detector and image processing techniques to achieve this improvement.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related art in X-ray detector technology.\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A method for reducing radiation dose in X-ray imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68770", "text": "{\n    \"patent_title\": \"AI-Powered MRI Reconstruction for Accelerated Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-08-20\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing MRI images using deep learning techniques, resulting in significantly faster scan times and improved image quality. This innovation has potential for widespread clinical adoption and enhanced diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI reconstruction...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68770", "text": "{\n    \"patent_title\": \"Improved X-ray Detector with Enhanced Sensitivity\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Emily Wilson\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-04-15\",\n    \"issue_date\": \"2023-03-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved X-ray detector design utilizing novel materials to enhance sensitivity and reduce radiation dose. This invention aims to provide clearer and more detailed X-ray images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art in X-ray detection\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray detector comprising...\",\n        \"A method for detecting X-rays...\",\n        \"A system for generating X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68771", "text": "{\n    \"patent_title\": \"Wireless Physiological Monitoring System for Remote Patient Care\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"BioTech Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless physiological monitoring system is disclosed, enabling remote patient care and continuous health data collection. The system utilizes telemetry for secure data transmission and analysis, enhancing healthcare accessibility for patients in remote locations.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in remote monitoring\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless physiological monitoring system comprising...\",\n        \"A method for remotely monitoring a patient's vital signs...\",\n        \"A telemetry system for secure data transmission...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68771", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Surgical Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"General Hospital Research\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Medical Device Corp\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved catheter design for minimally invasive surgical procedures, enhancing precision and reducing patient trauma. The catheter utilizes a novel tip geometry for improved maneuverability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Previous catheter designs\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a novel tip geometry...\",\n        \"A surgical method utilizing the improved catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68772", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction Method for Cardiac MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2022-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an improved method for image reconstruction in cardiac magnetic resonance imaging (MRI). The technique utilizes a novel algorithm to reduce noise and artifacts, leading to clearer and more accurate images of the heart, aiding in the diagnosis and monitoring of cardiovascular diseases.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art related to MRI image processing.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image reconstruction in cardiac MRI...\",\n        \"An apparatus for performing image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68772", "text": "{\n    \"patent_title\": \"Novel Drug Delivery System Using Nanoparticles\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-03-01\",\n    \"filing_date\": \"2020-03-01\",\n    \"issue_date\": \"2023-06-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a novel drug delivery system utilizing biocompatible nanoparticles for targeted delivery of therapeutic agents. The system is designed to improve drug efficacy and reduce side effects in the treatment of various diseases.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related to nanoparticle synthesis.\"\n        }\n    ],\n    \"claims\": [\n        \"A nanoparticle composition for drug delivery...\",\n        \"A method of treating a disease using the nanoparticle composition...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68773", "text": "{\n    \"patent_title\": \"Non-Invasive Cardiovascular Diagnostic Device Utilizing Bioimpedance Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel non-invasive device for diagnosing cardiovascular diseases by analyzing bioimpedance variations. The device provides accurate assessment of cardiac function without the need for catheters or radiation. Significant improvement in accuracy compared to existing non-invasive methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in bioimpedance measurement.\"\n        }\n    ],\n    \"claims\": [\n        \"A non-invasive cardiovascular diagnostic device comprising...\",\n        \"A method for diagnosing cardiovascular disease using bioimpedance analysis...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68773", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Angiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Boston Medical Devices Inc.\"\n        },\n        {\n            \"name\": \"Emily Wilson\",\n            \"affiliation\": \"Boston Medical Devices Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design for angiography, featuring a more flexible tip and reduced friction. This design allows for easier navigation of blood vessels during cardiac procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Previous catheter designs.\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter for angiography with a flexible distal tip...\",\n        \"A method for performing angiography using the improved catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68774", "text": "{\n    \"patent_title\": \"Micro-Robotic System for Targeted Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-12-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A micro-robotic system for targeted drug delivery utilizing biocompatible materials and advanced imaging techniques. This invention enables precise drug administration to affected tissues with minimal invasiveness, revolutionizing cancer treatment and other localized therapies. The system incorporates real-time feedback and adaptive control for optimal therapeutic efficacy and reduced side effects.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in micro-robotics\"\n        }\n    ],\n    \"claims\": [\n        \"A micro-robotic system comprising a biocompatible body...\",\n        \"A method for targeted drug delivery...\",\n        \"An imaging system for real-time monitoring...\",\n        \"A control algorithm for adaptive drug release...\",\n        \"A biocompatible coating for enhanced drug efficacy...\",\n        \"A sensor for detecting tissue properties...\",\n        \"A navigation system for precise positioning...\",\n        \"A communication module for remote control...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68774", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Vascular Access\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Williams\",\n            \"affiliation\": \"Regional Medical Center\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-01-20\",\n    \"issue_date\": \"2021-05-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design featuring enhanced flexibility and reduced friction for easier vascular access. The catheter utilizes a novel polymer blend and a tapered tip to minimize patient discomfort and reduce the risk of complications during insertion.  Suitable for a wide range of diagnostic and therapeutic procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art in catheter design\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible shaft...\",\n        \"A tapered tip for reduced insertion trauma...\",\n        \"A polymer blend with low friction properties...\",\n        \"A lumen for fluid delivery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68775", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Electrolyte for Improved Cycle Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a lithium-ion battery utilizing a novel electrolyte composition comprising a blend of lithium bis(fluorosulfonyl)imide (LiFSI) and a cyclic carbonate solvent. The improved electrolyte exhibits enhanced ionic conductivity and stability, resulting in significantly improved cycle life and reduced capacity fade. The battery demonstrates superior performance at both high and low temperatures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68775", "text": "{\n    \"patent_title\": \"Improved Lead-Acid Battery Design for Automotive Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Exide Technologies\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Exide Technologies\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2021-02-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved lead-acid battery design featuring optimized plate geometry and a novel separator material. The battery exhibits enhanced cranking power and improved lifespan in automotive applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        },\n        {\n            \"patent_number\": \"US8543210B2\"\n        },\n        {\n            \"patent_number\": \"US9432109B2\"\n        },\n        {\n            \"patent_number\": \"US10210987B2\"\n        },\n        {\n            \"patent_number\": \"US11098765B2\"\n        }\n    ],\n    \"claims\": [\n        \"A lead-acid battery comprising...\",\n        \"A separator material for a lead-acid battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68776", "text": "{\n    \"patent_title\": \"Miniaturized Robotic Catheter System for Precise Cardiac Ablation\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized robotic catheter system for performing precise cardiac ablation procedures. The system utilizes advanced sensors and control algorithms to navigate within the heart and deliver targeted energy to eliminate arrhythmias. The design enables minimally invasive access and reduced patient trauma compared to traditional ablation techniques, addressing a significant need for safer and more effective treatments for atrial fibrillation and ventricular tachycardia.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in catheter design\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic catheter system comprising...\",\n        \"A method for cardiac ablation...\",\n        \"A control system for precise catheter navigation...\",\n        \"A sensor for real-time tissue characterization...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68776", "text": "{\n    \"patent_title\": \"Improved Stent Design for Peripheral Artery Disease\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Medtronic Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2022-01-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved stent design for treating peripheral artery disease. The stent features a novel coating to enhance biocompatibility and reduce the risk of restenosis. This invention offers an incremental improvement over existing stent technologies, and addresses the challenges of long-term patency in peripheral arteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art in stent coating technology\"\n        }\n    ],\n    \"claims\": [\n        \"A stent comprising a biocompatible coating...\",\n        \"A method for deploying a stent in a peripheral artery...\",\n        \"A coating composition for reducing restenosis...\",\n        \"A stent with improved mechanical properties...\",\n        \"A stent with a drug-eluting coating...\",\n        \"A stent with a specific geometric configuration...\",\n        \"A method for manufacturing the stent...\",\n        \"A system for delivering the stent...\",\n        \"A device for monitoring stent performance...\",\n        \"A composition comprising a polymer and a drug...\",\n        \"A method for treating vascular disease...\",\n        \"A stent for use in human patients...\",\n        \"A device for diagnosing vascular conditions...\",\n        \"A method for preventing thrombosis...\",\n        \"A coating that promotes endothelialization...\",\n        \"A stent with enhanced radiopacity...\",\n        \"A method for assessing stent deployment...\",\n        \"A device for measuring arterial pressure...\",\n        \"A stent for treating bifurcation lesions...\",\n        \"A method for treating calcified lesions...\",\n        \"A stent with a biodegradable component...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68777", "text": "{\n    \"patent_title\": \"Method for Enhanced Image Reconstruction in MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2021-11-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing MRI images with improved clarity and reduced noise, utilizing a deep learning approach.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"The method of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68777", "text": "{\n    \"patent_title\": \"Improved CT Scanner Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-12-01\",\n    \"filing_date\": \"2017-12-01\",\n    \"issue_date\": \"2019-08-13\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved CT scanner design incorporating a faster rotation speed and enhanced detectors.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        },\n        {\n            \"patent_number\": \"US91234567B1\"\n        },\n        {\n            \"patent_number\": \"US82345678B1\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        },\n        {\n            \"patent_number\": \"US11123456B2\"\n        },\n        {\n            \"patent_number\": \"US12123456B2\"\n        },\n        {\n            \"patent_number\": \"US13123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A CT scanner comprising...\",\n        \"The CT scanner of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68778", "text": "{\n    \"patent_title\": \"Method and System for Dynamic Spectrum Allocation in 5G Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for dynamic spectrum allocation in 5G networks to improve spectral efficiency and reduce interference. The system utilizes machine learning algorithms to predict spectrum demand and allocate resources accordingly.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Spectrum Sensing Techniques for Cognitive Radio\"\n        }\n    ],\n    \"claims\": [\n        \"A method for dynamic spectrum allocation comprising...\",\n        \"A system for dynamic spectrum allocation comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68778", "text": "{\n    \"patent_title\": \"Novel Antenna Design for 5G Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Qualcomm\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Samsung\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel antenna design for 5G mobile devices, enhancing signal strength and reducing power consumption. The antenna utilizes a new material and geometry to achieve improved performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Miniaturized Antenna Structures\"\n        }\n    ],\n    \"claims\": [\n        \"An antenna design comprising...\",\n        \"A mobile device incorporating the antenna design...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68779", "text": "{\n    \"patent_title\": \"High-Resolution Optical Coherence Tomography System for Non-Invasive Vascular Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Chen\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A high-resolution optical coherence tomography (OCT) system is disclosed for non-invasive in vivo imaging of vascular structures. The system utilizes a swept-source laser and advanced signal processing techniques to achieve improved image quality and penetration depth, enabling early detection of vascular diseases.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in OCT imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A method for non-invasive vascular imaging using OCT.\",\n        \"An OCT system comprising a swept-source laser and a signal processing unit.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68779", "text": "{\n    \"patent_title\": \"MRI Coil Design for Improved Signal-to-Noise Ratio\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Miller\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-09-20\",\n    \"filing_date\": \"2017-09-20\",\n    \"issue_date\": \"2021-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved magnetic resonance imaging (MRI) coil design is presented, enhancing signal-to-noise ratio and image quality. The coil incorporates a novel gradient configuration for optimized performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related to MRI coil technology\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil with a novel gradient configuration.\",\n        \"A method for improving signal-to-noise ratio in MRI using the described coil.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68780", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system providing enhanced visualization and precision for improved patient outcomes in complex surgical procedures. The system utilizes advanced imaging techniques and robotic assistance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Robotic Surgical System\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising a robotic arm...\",\n        \"An imaging module for providing real-time visualization...\",\n        \"A control system for precise manipulation of surgical instruments...\",\n        \"A method for performing minimally invasive surgery...\",\n        \"A system for enhancing surgical precision...\",\n        \"A user interface for controlling the surgical system...\",\n        \"A safety mechanism to prevent unintended movements...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68780", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Independent Inventor\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-01-10\",\n    \"filing_date\": \"2022-01-10\",\n    \"issue_date\": \"2023-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved bicycle braking system utilizing a novel cable design for enhanced stopping power and reliability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Bicycle Brake System\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle braking system comprising a cable...\",\n        \"A braking lever for actuating the cable...\",\n        \"A braking caliper for applying force to the wheel...\",\n        \"A cable housing for guiding the cable...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68781", "text": "{\n    \"patent_title\": \"Lithium-Sulfur Battery with Enhanced Cycle Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Princeton University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Argonne National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US10876234B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-06-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-sulfur battery with a novel electrolyte and cathode structure to improve cycle life and energy density. The invention demonstrates significantly enhanced sulfur utilization and reduced polysulfide shuttling.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9236398B2\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-sulfur battery comprising...\",\n        \"An electrolyte composition for a lithium-sulfur battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68781", "text": "{\n    \"patent_title\": \"Improved Lead-Acid Battery Grid Design\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Exide Technologies\"\n        }\n    ],\n    \"patent_number\": \"US8546012B2\",\n    \"priority_date\": \"2013-12-20\",\n    \"filing_date\": \"2013-12-20\",\n    \"issue_date\": \"2014-07-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved grid design for lead-acid batteries, enhancing current distribution and reducing corrosion. This invention focuses on optimizing the performance of traditional lead-acid technology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\"\n        }\n    ],\n    \"claims\": [\n        \"A lead-acid battery grid characterized by...\",\n        \"A manufacturing process for a lead-acid battery grid...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68782", "text": "{\n    \"patent_title\": \"Non-Invasive Glucose Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2021-11-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive glucose monitoring system utilizing optical sensors to determine blood glucose levels through the skin. This system provides real-time data for improved diabetes management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art in non-invasive sensing.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for non-invasively monitoring glucose levels.\",\n        \"A device for non-invasive glucose monitoring.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68782", "text": "{\n    \"patent_title\": \"Surgical Robotic Arm with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-08-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical robotic arm designed to provide enhanced precision and dexterity during surgical procedures. The system incorporates advanced feedback mechanisms and motion control algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related art in surgical robotics.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic arm with improved precision.\",\n        \"A method for performing surgery using a robotic arm.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68783", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2020-03-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel minimally invasive surgical system incorporating advanced optical imaging and robotic control for precise tissue manipulation. This system allows for complex surgical procedures to be performed with reduced trauma and faster recovery times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Similar surgical system design\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Robotic arm control technology\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Optical imaging enhancement techniques\"\n        },\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"relevance\": \"Precursor work in minimally invasive surgery\"\n        },\n        {\n            \"patent_number\": \"US5432109B2\",\n            \"relevance\": \"Related surgical instrumentation\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising a robotic arm...\",\n        \"An optical imaging module for enhanced visualization...\",\n        \"A method for performing minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68783", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Acme Medical Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2021-07-13\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler design with enhanced ergonomics and a more reliable firing mechanism.  The stapler is intended for use in traditional open surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10112233B2\",\n            \"relevance\": \"Similar stapler designs\"\n        },\n        {\n            \"patent_number\": \"US9223344B1\",\n            \"relevance\": \"Firing mechanism advancements\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising a handle...\",\n        \"A cartridge for holding staples...\",\n        \"A firing mechanism for deploying staples...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68784", "text": "{\n    \"patent_title\": \"AI-Powered Diagnostic System for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2022-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel artificial intelligence system utilizing deep learning algorithms for early detection of cancerous tumors in medical imaging data. The system demonstrates significantly improved diagnostic accuracy compared to traditional methods, reducing false positives and enabling earlier intervention.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for diagnosing cancer comprising: a data input module...\",\n        \"A method for improving diagnostic accuracy using machine learning...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68784", "text": "{\n    \"patent_title\": \"Method for Improving X-ray Image Quality\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-08-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method for enhancing the clarity of X-ray images through signal processing techniques. The method improves image resolution and reduces noise, leading to better visualization of anatomical structures. This improves diagnosis but does not use machine learning.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing X-ray images...\",\n        \"An apparatus for improving image contrast...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68785", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Enhanced Biocompatibility\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor with a novel biocompatible coating designed to minimize foreign body response and improve long-term accuracy in glucose monitoring, thereby improving diabetes management and patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art related to glucose sensor technology.\"\n        }\n    ],\n    \"claims\": [\n        \"A glucose sensor comprising a biocompatible coating.\",\n        \"The glucose sensor of claim 1, wherein the coating comprises...\",\n        \"A method of monitoring glucose levels using the glucose sensor...\",\n        \"The method of claim 3, wherein the patient is diagnosed with diabetes.\",\n        \"The method of claim 3, wherein the sensor provides real-time glucose data.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68785", "text": "{\n    \"patent_title\": \"Automated Image Analysis System for Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Sarah Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11890123B1\",\n    \"priority_date\": \"2021-05-20\",\n    \"filing_date\": \"2021-05-20\",\n    \"issue_date\": \"2023-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for analyzing medical images to detect cancerous tumors using machine learning algorithms. The system provides rapid and accurate diagnostic results.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10456789B2\",\n            \"relevance\": \"Prior art related to image processing techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"A system for analyzing medical images...\",\n        \"The system of claim 1, comprising a machine learning algorithm...\",\n        \"A method for detecting cancerous tumors...\",\n        \"The method of claim 3, wherein the image is a CT scan.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68786", "text": "{\n    \"patent_title\": \"Improved MRI Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing MRI images using deep learning techniques, resulting in improved image quality and reduced scan time. This technique is particularly effective for non-invasive diagnostic imaging of soft tissues.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"MRI Image Reconstruction\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Deep Learning for Image Processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI image reconstruction...\",\n        \"The method of claim 1, wherein the deep learning model...\",\n        \"The system of claim 2, wherein the MRI data is...\",\n        \"The method of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68786", "text": "{\n    \"patent_title\": \"Contrast Agent for CT Scans\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2017-09-20\",\n    \"filing_date\": \"2017-09-20\",\n    \"issue_date\": \"2021-11-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new contrast agent for use in computed tomography (CT) scans, improving visibility of blood vessels. This agent is designed for invasive procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"CT Scan Contrast Agents\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent for CT scans comprising...\",\n        \"A method for enhancing CT images using the contrast agent...\",\n        \"The contrast agent of claim 1, wherein the agent is...\",\n        \"The method of claim 2, wherein the CT scan is...\",\n        \"The contrast agent of claim 1, further comprising...\",\n        \"The contrast agent of claim 1, wherein the agent provides improved visibility...\",\n        \"The method of claim 2, wherein the scan is performed on a patient...\",\n        \"The contrast agent of claim 1, wherein the agent is administered intravenously...\",\n        \"The method of claim 2, wherein the CT scan is performed with reduced radiation...\",\n        \"The contrast agent of claim 1, wherein the agent is biocompatible...\",\n        \"The method of claim 2, wherein the CT scan is used for diagnostic purposes...\",\n        \"The contrast agent of claim 1, wherein the agent is stable in vivo...\",\n        \"The method of claim 2, wherein the CT scan is performed on a specific organ...\",\n        \"The contrast agent of claim 1, wherein the agent is formulated for optimal absorption...\",\n        \"The method of claim 2, wherein the CT scan is performed under controlled conditions...\",\n        \"The contrast agent of claim 1, wherein the agent is manufactured using a specific process...\",\n        \"The method of claim 2, wherein the CT scan results are analyzed by a radiologist...\",\n        \"The contrast agent of claim 1, wherein the agent is designed for targeted delivery...\",\n        \"The method of claim 2, wherein the CT scan is used for monitoring disease progression...\",\n        \"The contrast agent of claim 1, wherein the agent is stored under specific conditions...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68787", "text": "{\n    \"patent_title\": \"System and Method for Robust Object Recognition in Cluttered Environments\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-09-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for identifying objects within complex visual scenes, utilizing a deep convolutional neural network architecture trained on a large dataset of images. The system is robust to occlusion, varying lighting conditions, and changes in viewpoint.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Recognition Using Feature Matching\"\n        }\n    ],\n    \"claims\": [\n        \"A method for recognizing objects in an image comprising:...\",\n        \"A system for object recognition comprising:...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68787", "text": "{\n    \"patent_title\": \"Method for Automated Diagnosis of Retinal Diseases using Image Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University Hospital\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for automatically diagnosing retinal diseases from fundus images using image processing and machine learning techniques. The system identifies indicators of diabetic retinopathy, glaucoma, and macular degeneration.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"title\": \"Image Processing for Medical Imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A method for diagnosing retinal disease comprising:...\",\n        \"A system for medical image analysis comprising:...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68788", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Real-Time Image Guidance\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system utilizing real-time image guidance to improve precision and reduce patient trauma. The system comprises a robotic arm, an endoscope with integrated imaging, and a software platform for 3D visualization and navigation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art in robotic surgery\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Prior art in image-guided surgery\"\n        },\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"relevance\": \"Related art in endoscopic visualization\"\n        }\n    ],\n    \"claims\": [\n        \"A minimally invasive surgical system comprising a robotic arm and an endoscope.\",\n        \"A method for image-guided surgery utilizing a 3D visualization platform.\",\n        \"The system of claim 1, wherein the endoscope is equipped with fluorescence imaging.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68788", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Cardiovascular Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Boston Medical Corp\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-05-10\",\n    \"filing_date\": \"2022-05-10\",\n    \"issue_date\": \"2024-01-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design for accessing and navigating blood vessels during cardiovascular procedures. The catheter features a flexible tip and enhanced maneuverability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art in catheter design\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible tip and a control handle.\",\n        \"The catheter of claim 1, wherein the tip is made of a biocompatible polymer.\",\n        \"A method for navigating blood vessels using the catheter.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68789", "text": "{\n    \"patent_title\": \"AI-Powered Early Cancer Detection Using Novel MRI Techniques\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-09-20\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel magnetic resonance imaging (MRI) technique enhanced by artificial intelligence (AI) algorithms for early detection of cancerous tumors. The system provides improved image resolution and automated analysis, leading to faster and more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in MRI image processing.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancerous tumors using MRI and AI.\",\n        \"A system for automated image analysis.\",\n        \"An MRI apparatus with enhanced resolution.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68789", "text": "{\n    \"patent_title\": \"Improved X-Ray Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Wilson\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-05-01\",\n    \"filing_date\": \"2018-11-15\",\n    \"issue_date\": \"2021-06-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved X-ray imaging system providing clearer images with reduced radiation exposure. It utilizes a novel detector array and image reconstruction algorithm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in X-ray technology.\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system with reduced radiation exposure.\",\n        \"A detector array for improved image clarity.\",\n        \"An image reconstruction algorithm.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68790", "text": "{\n    \"patent_title\": \"Implantable Cardiac Monitor with Wireless Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Chen\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-11-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac monitor capable of continuously monitoring cardiac activity and wirelessly transmitting data to a remote monitoring station. The device utilizes low-power communication protocols for extended battery life and includes advanced algorithms for arrhythmia detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art related to implantable pacemakers.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for continuously monitoring cardiac activity...\",\n        \"An implantable device comprising a sensor...\",\n        \"A wireless communication system for transmitting cardiac data...\",\n        \"A system for detecting arrhythmias...\",\n        \"A remote monitoring station for receiving and analyzing cardiac data...\",\n        \"The device of claim 1, wherein the sensor measures ECG signals.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68790", "text": "{\n    \"patent_title\": \"Surgical Instrument for Orthopedic Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. James Miller\",\n            \"affiliation\": \"Hospital General\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2022-01-15\",\n    \"filing_date\": \"2022-01-15\",\n    \"issue_date\": \"2023-09-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical instrument designed for precise bone cutting and shaping during orthopedic procedures. The instrument incorporates a motorized blade and adjustable depth control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art related to surgical saws.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising a motorized blade...\",\n        \"A depth control mechanism for adjusting the cutting depth...\",\n        \"A handle for gripping and manipulating the instrument...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68791", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Reconstruction for Accelerated MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-11-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for reconstructing Magnetic Resonance Images (MRI) using a deep convolutional neural network. This allows for significant reduction in scan time without compromising image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"MRI Reconstruction using Compressed Sensing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising: training a deep convolutional neural network...\",\n        \"A system for performing MRI reconstruction according to claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68791", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for X-Ray Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-12-01\",\n    \"filing_date\": \"2019-10-10\",\n    \"issue_date\": \"2021-05-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel contrast agent for X-ray imaging, providing enhanced visibility of soft tissues. This agent is based on a modified iodine compound.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Iodine-Based Contrast Agents\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising a modified iodine compound...\",\n        \"A method of enhancing X-ray imaging using the contrast agent of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68792", "text": "{\n    \"patent_title\": \"Ultrasound-based Shear Wave Elastography for Early Breast Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10543216B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-01-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for non-invasive breast cancer detection utilizing shear wave elastography with focused ultrasound. The method provides improved sensitivity and specificity compared to conventional ultrasound imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8781634B2\",\n            \"title\": \"Ultrasound Imaging System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancerous tissue...\",\n        \"An ultrasound system comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68792", "text": "{\n    \"patent_title\": \"Improved MRI Sequence for Enhanced Tumor Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-06-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel magnetic resonance imaging (MRI) sequence designed to improve the contrast and resolution of tumor visualization.  The sequence utilizes advanced pulse sequences and signal processing techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"MRI Pulse Sequence Optimization\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI pulse sequence...\",\n        \"A method for imaging a tumor...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68793", "text": "{\n    \"patent_title\": \"Non-Invasive Glucose Monitoring System Using Raman Spectroscopy\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive glucose monitoring system utilizing Raman spectroscopy to determine glucose levels in interstitial fluid. The system comprises a handheld device with a laser source, a Raman spectrometer, and a data processing unit. The data processing unit employs a novel algorithm to accurately quantify glucose concentrations without requiring blood samples.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in Raman spectroscopy for biomedical applications.\"\n        },\n        {\n            \"patent_number\": \"US10234567B2\",\n            \"relevance\": \"Related technology in non-invasive sensing.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for non-invasively monitoring glucose levels...\",\n        \"A device comprising a laser source and a Raman spectrometer...\",\n        \"A system for determining glucose concentration...\",\n        \"The method of claim 1, wherein the interstitial fluid is accessed through the skin...\",\n        \"The device of claim 2, further comprising a data processing unit...\",\n        \"The system of claim 3, wherein the data processing unit employs an algorithm...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68793", "text": "{\n    \"patent_title\": \"Surgical Instrument with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2018-12-01\",\n    \"filing_date\": \"2019-12-01\",\n    \"issue_date\": \"2021-08-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical instrument designed to enhance surgical precision and reduce surgeon fatigue. The instrument features an ergonomic handle and a novel blade design for improved maneuverability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related surgical instrument designs.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising an ergonomic handle...\",\n        \"The surgical instrument of claim 1, further comprising a blade...\",\n        \"The blade of claim 2, having a specific curvature...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68794", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Sepsis Diagnosis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2022-05-15\",\n    \"filing_date\": \"2021-06-01\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for rapid and accurate diagnosis of sepsis by detecting biomarkers in a small blood sample. The device offers a significant improvement over current diagnostic methods in terms of speed, sensitivity, and cost.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in microfluidic blood analysis\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for diagnosing sepsis...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68794", "text": "{\n    \"patent_title\": \"Improved Syringe Design with Enhanced Grip\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Becton, Dickinson and Company\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2022-11-20\",\n    \"filing_date\": \"2023-01-15\",\n    \"issue_date\": \"2023-07-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved syringe design featuring an ergonomically enhanced grip for more comfortable and secure handling by healthcare professionals. The design incorporates textured surfaces and a modified barrel shape.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous syringe grip designs\"\n        }\n    ],\n    \"claims\": [\n        \"A syringe comprising an improved grip...\",\n        \"A method of using the syringe...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68795", "text": "{\n    \"patent_title\": \"Ultrasound Beamforming with Deep Learning for Enhanced Resolution\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US1054321B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2020-11-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel ultrasound beamforming technique utilizing deep learning to achieve significantly improved image resolution. This allows for earlier and more accurate diagnosis of various medical conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"type\": \"relevant\"\n        }\n    ],\n    \"claims\": [\n        \"A method for ultrasound image formation comprising...\",\n        \"An apparatus for performing ultrasound imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68795", "text": "{\n    \"patent_title\": \"Improved MRI Pulse Sequence for Cardiac Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9234567B1\",\n    \"priority_date\": \"2014-12-15\",\n    \"filing_date\": \"2015-01-12\",\n    \"issue_date\": \"2016-07-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new MRI pulse sequence that improves the quality of cardiac images, leading to better visualization of heart tissue and function.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"type\": \"prior art\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"type\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI pulse sequence comprising...\",\n        \"A system for performing cardiac MRI...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68796", "text": "{\n    \"patent_title\": \"Novel Biosensor for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel biosensor for detecting cancer biomarkers at very low concentrations, enabling early diagnosis and improved patient outcomes. The sensor utilizes nanotechnology and advanced signal processing techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art related to biomarker detection.\"\n        }\n    ],\n    \"claims\": [\n        \"A biosensor comprising a nanomaterial for detecting cancer biomarkers.\",\n        \"A method for early cancer detection using the biosensor.\",\n        \"A system for analyzing biomarker data from the biosensor.\",\n        \"A device for point-of-care cancer diagnosis.\",\n        \"A method for improving patient outcomes through early detection.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68796", "text": "{\n    \"patent_title\": \"Improved Syringe Design for Insulin Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2021-02-10\",\n    \"issue_date\": \"2022-07-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved syringe design for more accurate and comfortable insulin delivery. The syringe features ergonomic improvements and a refined needle design.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art related to syringe design.\"\n        }\n    ],\n    \"claims\": [\n        \"A syringe comprising an ergonomic handle.\",\n        \"A syringe with a refined needle design.\",\n        \"A method for injecting insulin using the syringe.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68797", "text": "{\n    \"patent_title\": \"Implantable Cardiac Monitor with Wireless Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2020-03-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac monitor with enhanced wireless data transmission capabilities, enabling remote patient monitoring and early detection of cardiovascular events. The device offers improved accuracy and reduced interference compared to existing technologies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8542123B2\",\n            \"relevance\": \"Prior art in implantable cardiac monitoring.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for remotely monitoring cardiac activity using an implantable device.\",\n        \"An implantable cardiac monitor comprising a wireless communication module.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68797", "text": "{\n    \"patent_title\": \"Catheter Design for Peripheral Vascular Access\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Boston Scientific\"\n        }\n    ],\n    \"patent_number\": \"EP3456789B1\",\n    \"priority_date\": \"2017-02-15\",\n    \"filing_date\": \"2017-02-14\",\n    \"issue_date\": \"2019-11-06\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"A novel catheter design for improved access to peripheral blood vessels. The catheter features a flexible tip and enhanced lubricity for reduced patient discomfort.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"relevance\": \"Related to existing catheter designs.\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter with a flexible distal tip.\",\n        \"A method for inserting a catheter into a peripheral blood vessel.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68798", "text": "{\n    \"patent_title\": \"Improved MRI Contrast Agent for Cardiovascular Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"University of Oxford\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"University of Oxford\"\n        }\n    ],\n    \"patent_number\": \"EP3845921B1\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2021-11-10\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"This invention relates to a novel MRI contrast agent for enhanced visualization of cardiovascular structures, improving diagnostic accuracy. The agent exhibits increased biocompatibility and longer circulation times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US20180290542A1\",\n            \"cited_by\": \"Anya Sharma\"\n        },\n        {\n            \"patent_number\": \"WO2020123456A1\",\n            \"cited_by\": \"Ben Carter\"\n        },\n        {\n            \"patent_number\": \"EP3548712B1\",\n            \"cited_by\": \"Anya Sharma\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising a gadolinium complex and a biocompatible polymer.\",\n        \"A method for imaging cardiovascular structures using the contrast agent.\",\n        \"The method wherein the imaging modality is magnetic resonance imaging (MRI).\"\n    ]\n}"}
{"_id": "Academic--patents--n--68798", "text": "{\n    \"patent_title\": \"Surgical Instrument with Enhanced Grip\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Emily Wilson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-07-20\",\n    \"filing_date\": \"2019-07-20\",\n    \"issue_date\": \"2022-01-18\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A surgical instrument designed for improved grip and precision during minimally invasive procedures. The handle incorporates ergonomic features for reduced surgeon fatigue.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"cited_by\": \"Charles Davis\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising a handle with textured surface.\",\n        \"The instrument adapted for use in laparoscopic surgery.\",\n        \"The handle constructed from a biocompatible material.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68799", "text": "{\n    \"patent_title\": \"Method and System for Efficient Image Enhancement using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for enhancing the quality of digital images using a deep learning model. The system provides improved clarity and detail in various image types.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image comprising...\",\n        \"A system for enhancing an image comprising...\",\n        \"The method of claim 1, wherein the image is a photograph.\",\n        \"The system of claim 2, wherein the deep learning model is a convolutional neural network.\",\n        \"The method of claim 1, further comprising a pre-processing step.\",\n        \"The system of claim 2, further comprising a post-processing step.\",\n        \"The method of claim 1, applicable to various imaging modalities.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68799", "text": "{\n    \"patent_title\": \"MRI Image Reconstruction Using Compressed Sensing\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-05-01\",\n    \"filing_date\": \"2019-11-20\",\n    \"issue_date\": \"2021-09-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for reconstructing high-quality magnetic resonance images (MRI) using compressed sensing techniques. Specifically designed for medical imaging applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10111213B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image...\",\n        \"An apparatus for reconstructing an MRI image...\",\n        \"The method of claim 1, wherein the MRI image is a brain scan.\",\n        \"The apparatus of claim 2, including a reconstruction algorithm.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68800", "text": "{\n    \"patent_title\": \"Improved Iterative Reconstruction Algorithm for Low-Dose CT Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2020-04-21\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"This invention provides an improved iterative reconstruction algorithm for low-dose computed tomography (CT) imaging, enhancing image quality and reducing radiation exposure. The algorithm incorporates a novel regularization term to suppress noise and artifacts, leading to improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"type\": \"cited_by\"\n        },\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"type\": \"cited_by\"\n        },\n        {\n            \"patent_number\": \"US12345678B2\",\n            \"type\": \"cited_by\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"type\": \"cited_by\"\n        },\n        {\n            \"patent_number\": \"US91234567B2\",\n            \"type\": \"cited_by\"\n        },\n        {\n            \"patent_number\": \"US10345678B2\",\n            \"type\": \"cited_by\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an image from CT projection data...\",\n        \"The method of claim 1, wherein the regularization term comprises...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68800", "text": "{\n    \"patent_title\": \"Magnetic Resonance Imaging System with Enhanced Gradient Coils\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11887766B2\",\n    \"priority_date\": \"2020-09-10\",\n    \"filing_date\": \"2020-09-10\",\n    \"issue_date\": \"2022-05-17\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"This invention relates to a magnetic resonance imaging (MRI) system incorporating advanced gradient coils to improve spatial resolution and imaging speed.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US99887766B1\",\n            \"type\": \"cited_by\"\n        },\n        {\n            \"patent_number\": \"US11998877B2\",\n            \"type\": \"cited_by\"\n        },\n        {\n            \"patent_number\": \"US12998877B2\",\n            \"type\": \"cited_by\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI system comprising a gradient coil assembly...\",\n        \"The MRI system of claim 1, wherein the gradient coils...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68801", "text": "{\n    \"patent_title\": \"Adaptive Image Enhancement for Low-Light Photography\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A method and system for enhancing images captured in low-light conditions. The system adaptively adjusts image parameters to improve visibility and clarity without introducing excessive noise.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Noise Reduction Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image captured in low-light conditions, comprising...\",\n        \"A system for adaptively adjusting image parameters...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68801", "text": "{\n    \"patent_title\": \"Method for Improving Image Resolution\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"University of Madrid\"\n        }\n    ],\n    \"patent_number\": \"EP3456789B1\",\n    \"priority_date\": \"2020-04-10\",\n    \"filing_date\": \"2020-06-12\",\n    \"issue_date\": \"2023-02-15\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"A novel approach to increasing the resolution of digital images using super-resolution techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Super-Resolution Imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A method for increasing the resolution of an image, comprising...\",\n        \"A system for implementing super-resolution algorithms...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68802", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system incorporating enhanced visualization techniques to improve surgical precision and patient outcomes. The system features a small diameter endoscope and robotic manipulators.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art related to endoscopic surgical tools\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising...\",\n        \"An endoscope with enhanced imaging capabilities...\",\n        \"A robotic manipulator for precise instrument control...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68802", "text": "{\n    \"patent_title\": \"Advanced Cardiac Monitoring Device with AI Integration\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"EP3456789B1\",\n    \"priority_date\": \"2021-02-28\",\n    \"filing_date\": \"2021-04-15\",\n    \"issue_date\": \"2023-09-05\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"An advanced cardiac monitoring device utilizing artificial intelligence to predict and prevent cardiac events. The device provides real-time data analysis and alerts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related to wearable cardiac sensors\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiac monitoring device comprising...\",\n        \"An AI module for real-time data analysis...\",\n        \"A communication module for transmitting alerts...\",\n        \"A power management system...\",\n        \"A sensor array...\",\n        \"A data storage component...\",\n        \"A user interface...\",\n        \"A calibration algorithm...\",\n        \"A machine learning model...\",\n        \"A security protocol...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68803", "text": "{\n    \"patent_title\": \"MRI Enhancement Using Artificial Intelligence for Faster Scanning\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-06-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a method for accelerating Magnetic Resonance Imaging (MRI) scans using deep learning algorithms. The technology reconstructs high-quality images from reduced data, leading to shorter scan times and lower patient discomfort. This reduces the required energy input and potential radiation-related side effects.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9546212B2\",\n            \"relevance\": \"prior art in MRI reconstruction\"\n        },\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"related AI applications in medical imaging\"\n        },\n        {\n            \"patent_number\": \"US10234567B2\",\n            \"relevance\": \"image processing algorithms\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"noise reduction techniques\"\n        },\n        {\n            \"patent_number\": \"US11234567B2\",\n            \"relevance\": \"advanced MRI sequences\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images using a deep learning model.\",\n        \"A system for reducing MRI scan time.\",\n        \"A method for improving the signal-to-noise ratio in MRI images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68803", "text": "{\n    \"patent_title\": \"Improved X-Ray Imaging System with Enhanced Contrast\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2016-11-01\",\n    \"issue_date\": \"2019-04-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved X-ray imaging system that utilizes a novel contrast agent to enhance the visibility of internal structures. The system provides higher resolution images with reduced radiation dosage compared to conventional X-ray systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"prior art in X-ray detectors\"\n        },\n        {\n            \"patent_number\": \"US9546212B2\",\n            \"relevance\": \"contrast agent development\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising a novel contrast agent.\",\n        \"A method for enhancing the contrast of X-ray images.\",\n        \"A system for reducing radiation dosage in X-ray imaging.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68804", "text": "{\n    \"patent_title\": \"Method and System for Enhanced MRI Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method and system for enhancing the resolution and clarity of Magnetic Resonance Images (MRI) using advanced reconstruction algorithms. The technique reduces noise and artifacts, enabling more accurate diagnosis, particularly in early-stage cancer detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"MRI Pulse Sequence Optimization\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"A system for performing MRI image reconstruction...\",\n        \"The method of claim 1, wherein the reconstruction algorithm is based on...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68804", "text": "{\n    \"patent_title\": \"Improved X-Ray Imaging System with Reduced Radiation Dose\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an X-ray imaging system that minimizes radiation exposure while maintaining image quality. The system employs a novel detector and image processing techniques to achieve improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"X-Ray Detector Technology\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A detector for use in an X-ray imaging system...\",\n        \"The system of claim 1, wherein the radiation dose is reduced by...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68805", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Electrolyte for High Energy Density\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"MIT Lincoln Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2023-10-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel lithium-ion battery utilizing a modified electrolyte composition to enhance energy density and cycle life. The electrolyte incorporates a unique additive that improves ion conductivity and stability, resulting in a significant performance boost.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Advanced Lithium Battery Materials\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising a cathode, an anode, and an electrolyte.\",\n        \"The electrolyte of claim 1, further comprising a specific additive to enhance ion conductivity.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68805", "text": "{\n    \"patent_title\": \"Improved Lead-Acid Battery with Enhanced Charging Capabilities\",\n    \"inventors\": [\n        {\n            \"name\": \"John Davis\",\n            \"affiliation\": \"Exide Technologies\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-02-20\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to improvements in lead-acid battery technology, specifically focusing on a novel charging algorithm and plate design to increase battery life and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Lead-Acid Battery Optimization\"\n        }\n    ],\n    \"claims\": [\n        \"A lead-acid battery comprising a plurality of cells.\",\n        \"A charging algorithm for a lead-acid battery, optimized for long-term performance.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68806", "text": "{\n    \"patent_title\": \"AI-Enhanced Medical Image Reconstruction for Improved Diagnostic Accuracy\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Chen\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for reconstructing medical images using deep learning techniques. The method improves diagnostic accuracy in identifying subtle anomalies often missed by traditional imaging techniques, addressing a critical unmet need in early disease detection. The system utilizes a convolutional neural network trained on a large dataset of medical images to enhance image resolution and reduce noise. Applications include MRI, CT scans, and X-ray imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in image reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for enhancing diagnostic accuracy using...\",\n        \"A computer-readable medium storing instructions for...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68806", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for MRI Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Carol Davis\",\n            \"affiliation\": \"Pharmaceutical Corp\"\n        },\n        {\n            \"name\": \"Dr. David Miller\",\n            \"affiliation\": \"Pharmaceutical Corp\"\n        }\n    ],\n    \"patent_number\": \"EP3456789B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-15\",\n    \"issue_date\": \"2021-05-20\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"This invention relates to a new contrast agent for Magnetic Resonance Imaging (MRI) that provides improved image clarity and enhanced tissue differentiation. The contrast agent is based on a novel nanoparticle formulation designed for targeted delivery to specific tissues. It enhances image resolution, allowing for clearer visualization of anatomical structures and pathological conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art in contrast agent development\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"A method for enhancing MRI image clarity...\",\n        \"A pharmaceutical composition including...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68807", "text": "{\n    \"patent_title\": \"Enhanced Image Reconstruction for Reduced-Dose CT Scans\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides novel methods for image reconstruction in Computed Tomography (CT) scanning, allowing for significantly reduced radiation dose while maintaining diagnostic image quality. The approach utilizes advanced iterative algorithms and regularization techniques to minimize noise and artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"relevance\": \"Prior art in iterative reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an image from CT scan data comprising...\",\n        \"A system for performing CT scans with reduced radiation dosage...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68807", "text": "{\n    \"patent_title\": \"Improved MRI Coil Design for Brain Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2018-07-10\",\n    \"filing_date\": \"2020-01-20\",\n    \"issue_date\": \"2021-02-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a novel design for MRI coils, resulting in improved signal-to-noise ratio and enhanced image clarity for brain imaging applications. The coil geometry is optimized for targeting specific brain regions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Existing MRI coil technology\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil apparatus comprising...\",\n        \"A method for generating a magnetic field using the described coil...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68808", "text": "{\n    \"patent_title\": \"Surgical Robotic System with Enhanced Precision and Tactile Feedback\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-11-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A robotic surgical system is disclosed comprising a console, a patient cart, and robotic arms with enhanced tactile feedback capabilities. The system allows surgeons to perform complex minimally invasive procedures with greater precision and control, leading to reduced trauma and faster patient recovery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system comprising…\",\n        \"…a console for remote operation…\",\n        \"…robotic arms with tactile feedback…\"\n    ]\n}"}
{"_id": "Academic--patents--n--68808", "text": "{\n    \"patent_title\": \"Implantable Cardiac Pacemaker with Advanced Battery Management\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Medtronic\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-10\",\n    \"issue_date\": \"2021-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac pacemaker is disclosed with an advanced battery management system that extends battery life and improves device reliability. The pacemaker monitors cardiac activity and delivers pacing pulses as needed.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in cardiac pacing\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable cardiac pacemaker comprising…\",\n        \"…a battery management system…\",\n        \"…circuitry for monitoring cardiac activity…\"\n    ]\n}"}
{"_id": "Academic--patents--p--68809", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable biosensor for continuous glucose monitoring is disclosed. The device utilizes a novel enzyme-based electrochemical sensing system to provide real-time glucose readings, improving diabetes management and patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"relevance\": \"Prior art in glucose sensing\"\n        },\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"relevance\": \"Implantable medical devices\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Electrochemical sensors\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable biosensor for continuous glucose monitoring comprising...\",\n        \"A method for real-time glucose monitoring using the biosensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68809", "text": "{\n    \"patent_title\": \"Cosmetic Device for Skin Rejuvenation Using Microcurrents\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"BeautyTech Innovations\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A handheld cosmetic device for skin rejuvenation using microcurrents is disclosed. The device aims to reduce wrinkles and improve skin tone for aesthetic purposes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"relevance\": \"Microcurrent stimulation\"\n        }\n    ],\n    \"claims\": [\n        \"A handheld cosmetic device comprising a microcurrent generator...\",\n        \"A method for skin rejuvenation using the device...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68810", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction for Low-Dose Computed Tomography\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9782543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image reconstruction algorithm for computed tomography that reduces radiation dose while maintaining diagnostic image quality. The method utilizes a deep learning approach to enhance image resolution and reduce noise.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8560052B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a CT image...\",\n        \"A system for reducing radiation dose in CT scanning...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68810", "text": "{\n    \"patent_title\": \"Skin Rejuvenation System Using Targeted Light Therapy\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Los Angeles\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-08-10\",\n    \"filing_date\": \"2017-08-10\",\n    \"issue_date\": \"2021-03-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for non-invasive skin rejuvenation using targeted light therapy. The system aims to reduce wrinkles and improve skin tone through stimulating collagen production.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A system for delivering targeted light therapy...\",\n        \"A method for rejuvenating skin using light...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68811", "text": "{\n    \"patent_title\": \"AI-Enhanced Image Reconstruction for MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention utilizes artificial intelligence techniques, specifically deep learning, to improve the resolution and reduce noise in MRI images. It enhances image reconstruction algorithms beyond traditional methods, enabling faster scans and more accurate visualization of anatomical structures. Applications include therapeutic monitoring and longitudinal studies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on basic MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images using a deep neural network.\",\n        \"An MRI system comprising a deep learning module for image enhancement.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68811", "text": "{\n    \"patent_title\": \"Automated Diagnosis System for Skin Cancer\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2023-05-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for automatically detecting skin cancer from dermoscopic images using machine learning. The system analyzes image features and classifies lesions as benign or malignant. Designed for use by dermatologists to improve diagnostic accuracy and speed.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Existing skin cancer diagnostic methods\"\n        }\n    ],\n    \"claims\": [\n        \"A computer-implemented method for diagnosing skin cancer.\",\n        \"A system for analyzing dermoscopic images to identify cancerous lesions.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68812", "text": "{\n    \"patent_title\": \"High-Performance Solid-State Battery with Enhanced Cycling Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-06-20\",\n    \"issue_date\": \"2021-12-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel solid-state battery design incorporating a high-conductivity electrolyte and a stable electrode-electrolyte interface, resulting in improved performance and longevity. The battery utilizes earth-abundant materials and is intended for use in electric vehicles and grid-scale energy storage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on solid-state electrolytes\"\n        }\n    ],\n    \"claims\": [\n        \"A solid-state battery comprising...\",\n        \"An electrolyte composition...\",\n        \"A method of manufacturing...\",\n        \"An electrochemical cell...\",\n        \"A system for energy storage...\",\n        \"A battery with enhanced cycle life...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68812", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery Manufacturing Process Optimization\",\n    \"inventors\": [\n        {\n            \"name\": \"Li Wei\",\n            \"affiliation\": \"BYD Company Ltd.\"\n        }\n    ],\n    \"patent_number\": \"CN109876543A\",\n    \"priority_date\": \"2018-10-26\",\n    \"filing_date\": \"2018-11-15\",\n    \"issue_date\": \"2020-06-05\",\n    \"patent_office\": \"SIPO\",\n    \"abstract\": \"An improved manufacturing process for lithium-ion batteries, reducing production costs and increasing throughput. The process optimizes electrode coating and cell assembly techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related to lithium-ion battery production\"\n        }\n    ],\n    \"claims\": [\n        \"A method for manufacturing a lithium-ion battery...\",\n        \"An apparatus for electrode coating...\",\n        \"A cell assembly process...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68813", "text": "{\n    \"patent_title\": \"AI-Powered MRI Reconstruction for Enhanced Neurological Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for reconstructing MRI images using deep learning techniques. The method significantly reduces scan time and improves image quality, particularly for neurological imaging applications, enabling earlier and more accurate diagnosis of conditions like Alzheimer's disease. Artificial intelligence algorithms are employed to fill in missing data and enhance image resolution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images using a deep neural network.\",\n        \"A system for performing MRI reconstruction with reduced scan time.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68813", "text": "{\n    \"patent_title\": \"Improved X-Ray Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9123456B2\",\n    \"priority_date\": \"2014-12-01\",\n    \"filing_date\": \"2014-12-01\",\n    \"issue_date\": \"2017-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved X-ray imaging system with enhanced contrast and reduced radiation dose. The system utilizes a new detector material and image processing techniques to provide clearer images of bones and tissues. Suitable for a broad range of medical applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising a novel detector material.\",\n        \"A method for reducing radiation dose in X-ray imaging.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68814", "text": "{\n    \"patent_title\": \"Miniaturized MRI Device for Real-Time Tissue Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2022-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a miniaturized magnetic resonance imaging (MRI) device capable of real-time, high-resolution tissue monitoring. The device utilizes a novel gradient coil design and advanced image reconstruction algorithms to provide detailed anatomical and functional information.  This technology promises to significantly improve patient care by enabling earlier and more accurate diagnosis and treatment of various medical conditions. The portable nature of the device allows for bedside monitoring, reducing the need for costly and time-consuming hospital visits.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in MRI technology\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized MRI device comprising...\",\n        \"A method for real-time tissue monitoring using said device...\",\n        \"An image reconstruction algorithm...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68814", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Angiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Jean Dubois\",\n            \"affiliation\": \"Université de Paris\"\n        },\n        {\n            \"name\": \"Sophie Martin\",\n            \"affiliation\": \"Sorbonne University\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2020-03-10\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2023-07-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved catheter design for angiography procedures, enhancing maneuverability and reducing patient discomfort.  The catheter features a flexible tip and a novel coating to minimize friction within blood vessels.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Previous catheter designs\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible tip...\",\n        \"A coating for reducing friction...\",\n        \"A method for performing angiography...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68815", "text": "{\n    \"patent_title\": \"Method and System for Enhanced MRI Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Marcus Bell\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for reconstructing Magnetic Resonance Images (MRI) utilizing deep learning algorithms, resulting in improved image clarity and reduced scan times. This enhanced image quality has the potential to significantly improve the accuracy of diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"MRI Data Compression Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI reconstruction...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68815", "text": "{\n    \"patent_title\": \"Improved X-ray Imaging System with Reduced Radiation Dose\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Green\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2022-11-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"The present invention provides an improved X-ray imaging system that minimizes radiation exposure while maintaining high image quality. This is achieved through a novel filtering technique and optimized detector design.  The system utilizes X-ray technology for enhanced visualization.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Radiation Shielding for X-ray Machines\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A method for reducing radiation dose...\",\n        \"A detector for capturing X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68816", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Pathogen Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2021-11-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a microfluidic device for the rapid and sensitive detection of pathogens in biological samples. The device integrates sample preparation, amplification, and detection into a single platform, enabling point-of-care diagnostics.  It utilizes a novel polymer material and a unique channel design to minimize reagent consumption and improve detection limits. The device can be adapted for various pathogens including viruses, bacteria, and fungi.  Extensive testing demonstrates high accuracy and reliability. The invention represents a significant advancement in diagnostic technology, enabling faster and more accessible healthcare. The system incorporates machine learning algorithms for real-time data analysis and improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for detecting a pathogen...\",\n        \"A system for point-of-care diagnostics...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68816", "text": "{\n    \"patent_title\": \"Implantable Cardiac Monitor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2020-09-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an implantable cardiac monitor for long-term monitoring of heart rhythm. The device incorporates wireless communication capabilities for remote data transmission to a physician.  It utilizes advanced signal processing techniques to detect and classify arrhythmias.  The monitor is designed for minimal invasiveness and extended battery life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable cardiac monitor...\",\n        \"A method for monitoring heart rhythm...\",\n        \"A system for wireless data transmission...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68817", "text": "{\n    \"patent_title\": \"High-Energy Density Lithium-Sulfur Battery with Novel Electrolyte Additive\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"MIT Lincoln Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2023-11-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-sulfur battery with a novel electrolyte additive is disclosed, significantly improving energy density and cycle life. The additive stabilizes the sulfur cathode, preventing polysulfide dissolution and enhancing battery performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related background on lithium-sulfur chemistry\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-sulfur battery comprising...\",\n        \"An electrolyte additive for a lithium-sulfur battery...\",\n        \"A method for improving the energy density of a lithium-sulfur battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68817", "text": "{\n    \"patent_title\": \"Improved Lead-Acid Battery with Enhanced Charging Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Exide Technologies\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2023-07-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an improved charging algorithm for lead-acid batteries, resulting in faster charging times and increased battery life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous work on lead-acid battery charging\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related charging control systems\"\n        }\n    ],\n    \"claims\": [\n        \"A charging algorithm for a lead-acid battery...\",\n        \"A system for controlling the charging of a lead-acid battery...\",\n        \"A method for optimizing the charging process of a lead-acid battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68818", "text": "{\n    \"patent_title\": \"Micro-Robotic System for Precise Tissue Dissection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A micro-robotic system for precise tissue dissection during minimally invasive surgery. The system utilizes advanced micro-actuators and image guidance to achieve sub-millimeter accuracy, minimizing tissue damage and improving surgical outcomes. This represents a novel approach to tissue manipulation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in micro-robotics\"\n        }\n    ],\n    \"claims\": [\n        \"A micro-robotic system comprising...\",\n        \"A method for precise tissue dissection...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68818", "text": "{\n    \"patent_title\": \"Stent Delivery System with Enhanced Tracking\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Wilson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2022-07-01\",\n    \"filing_date\": \"2022-07-01\",\n    \"issue_date\": \"2024-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved stent delivery system for percutaneous coronary intervention. The system features a novel distal tip design for enhanced tracking and accurate stent placement within coronary arteries. The delivery system incorporates a balloon catheter and a self-expanding stent.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Previous stent delivery systems\"\n        }\n    ],\n    \"claims\": [\n        \"A stent delivery system comprising...\",\n        \"A method for delivering a stent to a coronary artery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68819", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Tumor Detection in MRI Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology, Department of Electrical Engineering and Computer Science\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School, Department of Radiology\"\n        }\n    ],\n    \"patent_number\": \"US10456789B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-02-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for enhancing tumor detection in Magnetic Resonance Imaging (MRI) through advanced signal processing techniques. The method utilizes wavelet transforms and machine learning algorithms to identify subtle anomalies indicative of cancerous tissue, significantly improving diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"MRI Image Reconstruction Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting tumors in MRI images comprising...\",\n        \"A system for processing MRI data to enhance tumor visibility...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68819", "text": "{\n    \"patent_title\": \"Improved MRI Coil Design for Enhanced Signal Reception\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"Stanford University, Department of Physics\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved design for MRI receiver coils to enhance signal reception and image quality. The coil utilizes a novel geometric configuration and advanced materials to maximize signal-to-noise ratio.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"MRI Coil with Integrated Shielding\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI receiver coil comprising a novel geometric configuration...\",\n        \"A method for manufacturing an MRI coil with enhanced signal reception...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68820", "text": "{\n    \"patent_title\": \"Endovascular Stent Delivery System with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"MedTech Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"EP3845921B1\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2021-11-10\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"A novel stent delivery system designed for precise endovascular placement, minimizing trauma to surrounding tissue. The system incorporates real-time imaging feedback and a steerable catheter for improved control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8562606B2\",\n            \"relevance\": \"Prior art in stent design\"\n        }\n    ],\n    \"claims\": [\n        \"A stent delivery system comprising a steerable catheter...\",\n        \"A method for endovascular stent placement...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68820", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Smith\",\n            \"affiliation\": \"Acme Surgical\"\n        }\n    ],\n    \"patent_number\": \"US9126005B2\",\n    \"priority_date\": \"2013-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2015-10-27\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"An improved surgical stapler designed for open surgical procedures, offering enhanced ergonomics and faster firing mechanisms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7895998B2\",\n            \"relevance\": \"Relevant prior art in surgical staplers\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an ergonomic handle...\",\n        \"A stapling cartridge with improved tissue penetration...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68821", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Pressure Sensor for Cardiovascular Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-05-15\",\n    \"issue_date\": \"2021-11-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized, wireless pressure sensor for real-time cardiovascular monitoring. The sensor utilizes MEMS technology and transmits data remotely via Bluetooth to a mobile device.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on wireless sensors\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising...\",\n        \"A system for remote cardiovascular monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68821", "text": "{\n    \"patent_title\": \"Automated Surgical Stapler with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-12-01\",\n    \"filing_date\": \"2019-12-01\",\n    \"issue_date\": \"2022-04-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated surgical stapler designed for increased precision and control during minimally invasive surgeries. Features include real-time feedback and adjustable staple depth.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous surgical stapler designs\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"A method for performing minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68822", "text": "{\n    \"patent_title\": \"AI-Enhanced Medical Image Analysis for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-06-20\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention utilizes artificial intelligence algorithms to analyze medical images, enabling early and accurate cancer detection. The system improves diagnostic accuracy and reduces false positives.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in medical image processing.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting cancer using AI-enhanced image analysis.\",\n        \"A system for processing medical images comprising an AI module.\",\n        \"A computer-readable medium storing instructions for the AI-enhanced method.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68822", "text": "{\n    \"patent_title\": \"Novel Contrast Agent for Improved MRI Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-08-01\",\n    \"filing_date\": \"2020-11-15\",\n    \"issue_date\": \"2023-05-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a new contrast agent for use in magnetic resonance imaging (MRI). The contrast agent provides enhanced image clarity and improved visualization of blood vessels and tissues.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related to existing contrast agents.\"\n        }\n    ],\n    \"claims\": [\n        \"A novel contrast agent composition.\",\n        \"A method for using the contrast agent in MRI.\",\n        \"A pharmaceutical formulation containing the contrast agent.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68823", "text": "{\n    \"patent_title\": \"Magnetic Resonance Imaging Enhancement for Early Tumor Identification\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel method for enhancing magnetic resonance imaging (MRI) contrast, allowing for earlier and more accurate detection of cancerous tumors. The technique utilizes a targeted contrast agent and advanced image processing algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in contrast agent development\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI contrast...\",\n        \"A contrast agent for use in MRI...\",\n        \"A system for detecting tumors using enhanced MRI...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68823", "text": "{\n    \"patent_title\": \"Improved X-ray Imaging System with Enhanced Resolution\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2016-11-20\",\n    \"filing_date\": \"2016-11-20\",\n    \"issue_date\": \"2019-07-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved X-ray imaging system that utilizes a novel detector array to achieve higher resolution images. This allows for more detailed visualization of bone structures and foreign objects.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Existing X-ray detector technology\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A detector array for use in an X-ray system...\",\n        \"A method for improving X-ray image resolution...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68824", "text": "{\n    \"patent_title\": \"Novel Magnetic Resonance Imaging Technique for Enhanced Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2023-12-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel magnetic resonance imaging (MRI) technique utilizing a unique pulse sequence and contrast agent to significantly enhance the detection of small tumors in breast tissue. The technique employs a dynamic contrast-enhanced MRI approach coupled with advanced image reconstruction algorithms to improve signal-to-noise ratio and reduce false-positive rates. Preliminary clinical trials demonstrate a 20% improvement in tumor detection sensitivity compared to conventional MRI techniques. The core innovation lies in the optimized pulse sequence that minimizes motion artifacts and maximizes contrast between cancerous and healthy tissues. This technology promises to revolutionize early cancer diagnosis and improve patient outcomes by enabling earlier intervention. The contrast agent is targeted to specific biomarkers present on tumor cells, enhancing specificity. Further research will focus on expanding the application of this technique to other cancer types.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"MRI Contrast Agent for Tumor Imaging\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Pulse Sequence Optimization for MRI\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Reconstruction Algorithm for MRI\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Dynamic Contrast Enhanced MRI\"\n        }\n    ],\n    \"claims\": [\n        \"A method for imaging tumors...\",\n        \"A contrast agent for use in MRI...\",\n        \"An MRI system configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68824", "text": "{\n    \"patent_title\": \"Improved X-Ray Detector\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2020-01-15\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2024-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details an improved X-ray detector utilizing a novel scintillator material. The detector exhibits increased sensitivity and reduced noise, leading to clearer images with lower radiation doses. \",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B1\",\n            \"title\": \"X-Ray Detector with Scintillator\"\n        },\n        {\n            \"patent_number\": \"US10234567B2\",\n            \"title\": \"Noise Reduction in X-Ray Imaging\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray detector comprising...\",\n        \"A scintillator material...\",\n        \"A method for reducing noise...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68825", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11254321B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable biosensor for continuous glucose monitoring utilizing a novel enzymatic reaction and wireless communication protocol. The device improves patient outcomes by providing real-time glucose data, enabling proactive diabetes management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Implantable Glucose Sensor\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable biosensor...\",\n        \"A method for continuous glucose monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68825", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Evans\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11300876B2\",\n    \"priority_date\": \"2019-11-20\",\n    \"filing_date\": \"2021-05-05\",\n    \"issue_date\": \"2022-02-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler with enhanced ergonomic design for increased surgical precision and reduced surgeon fatigue.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Surgical Stapler\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler with an ergonomic handle...\",\n        \"A method for performing surgical stapling...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68826", "text": "{\n    \"patent_title\": \"High-Throughput Wireless Communication System Using Adaptive Beamforming\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless communication system employing adaptive beamforming techniques to enhance data transmission rates and reduce interference. The system dynamically adjusts beam patterns based on channel conditions and user demand.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related art in beamforming\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication system comprising: an antenna array, a beamforming module, and a control unit.\",\n        \"The system of claim 1, wherein the beamforming module adaptively adjusts beam patterns based on channel state information.\",\n        \"The system of claim 2, wherein the channel state information is obtained through feedback from a receiving device.\",\n        \"A method for beamforming in a wireless communication system, comprising: measuring channel state information, determining an optimal beam pattern based on the channel state information, and transmitting a signal using the optimal beam pattern.\",\n        \"The method of claim 4, further comprising: adjusting the beam pattern dynamically based on changes in channel state information.\",\n        \"The method of claim 4, wherein the optimal beam pattern maximizes signal-to-interference-plus-noise ratio (SINR).\"\n    ]\n}"}
{"_id": "Academic--patents--n--68826", "text": "{\n    \"patent_title\": \"Low-Power Wireless Sensor Network for Environmental Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A low-power wireless sensor network designed for long-term environmental monitoring. The network utilizes energy-efficient communication protocols and sensor nodes to minimize power consumption and maximize battery life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related art in sensor networks\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor network comprising: a plurality of sensor nodes, and a gateway node.\",\n        \"The sensor network of claim 1, wherein the sensor nodes are powered by batteries.\",\n        \"The sensor network of claim 2, wherein the batteries are rechargeable.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68827", "text": "{\n    \"patent_title\": \"AI-Powered ECG Analysis System for Early Detection of Arrhythmias\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-06-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel system for analyzing electrocardiogram (ECG) data using artificial intelligence and machine learning algorithms to detect early signs of arrhythmias, enabling timely diagnosis and treatment of cardiovascular diseases. The system is designed for non-invasive monitoring.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9232345B1\",\n            \"relevance\": \"Prior art in ECG analysis\"\n        }\n    ],\n    \"claims\": [\n        \"A system for analyzing ECG data comprising...\",\n        \"A method for detecting arrhythmias...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The system of claim 1, wherein the algorithms are based on deep learning.\",\n        \"The method of claim 2, wherein the detection is performed in real-time.\",\n        \"The system of claim 1, further comprising a user interface for displaying the analysis results.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68827", "text": "{\n    \"patent_title\": \"Surgical Instrument for Minimally Invasive Cardiac Valve Repair\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Wilson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-04-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a surgical instrument designed for minimally invasive repair of cardiac valves. The instrument allows surgeons to access and manipulate valves with greater precision, reducing patient trauma and recovery time. It is designed for use in open-heart surgeries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Previous surgical instrument designs\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising...\",\n        \"A handle assembly...\",\n        \"A shaft extending from the handle...\",\n        \"A grasping mechanism at the distal end...\",\n        \"The instrument of claim 1, wherein the grasping mechanism is rotatable.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68828", "text": "{\n    \"patent_title\": \"Implantable Cardiac Monitor with Enhanced Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2012-05-15\",\n    \"filing_date\": \"2012-05-15\",\n    \"issue_date\": \"2015-08-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac monitor capable of transmitting data wirelessly with improved range and reduced power consumption, leading to better patient monitoring and faster response times to cardiac events.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for remotely monitoring cardiac activity.\",\n        \"An implantable device with enhanced wireless transmission.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68828", "text": "{\n    \"patent_title\": \"Portable Blood Glucose Meter with Wireless Connectivity\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2011-11-01\",\n    \"filing_date\": \"2011-11-01\",\n    \"issue_date\": \"2014-04-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A portable blood glucose meter with wireless connectivity for transmitting data to a smartphone application. Enables convenient and efficient blood glucose monitoring for diabetic patients.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8234567B2\"\n        }\n    ],\n    \"claims\": [\n        \"A portable blood glucose meter with wireless data transmission.\",\n        \"A smartphone application for receiving blood glucose data.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68829", "text": "{\n    \"patent_title\": \"Magnetic Resonance Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2021-12-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning approach for reconstructing high-resolution magnetic resonance images from undersampled k-space data.  This improves image quality and reduces scan time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art on image reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MR image...\",\n        \"A system comprising a processor and memory...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68829", "text": "{\n    \"patent_title\": \"Improved X-Ray Detector with Enhanced Sensitivity\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Philips Healthcare\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"University of Michigan\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-01-15\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2022-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new design for X-ray detectors utilizing a novel scintillator material to achieve higher sensitivity and lower noise.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous work on scintillator materials\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray detector comprising a scintillator...\",\n        \"A system for producing X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68830", "text": "{\n    \"patent_title\": \"High-Performance Solid-State Lithium-Ion Battery with Novel Electrolyte\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11254321B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-12-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A solid-state lithium-ion battery utilizing a novel ceramic electrolyte exhibiting high ionic conductivity and electrochemical stability. This design offers enhanced safety and energy density compared to conventional lithium-ion batteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on liquid electrolytes\"\n        }\n    ],\n    \"claims\": [\n        \"A solid-state lithium-ion battery comprising:...\",\n        \"A ceramic electrolyte with a lithium ion conductivity of at least 10^-3 S/cm...\",\n        \"A battery cell with an energy density greater than 500 Wh/kg...\",\n        \"A method for fabricating the solid-state battery...\",\n        \"A battery management system optimized for the solid-state battery...\",\n        \"The use of said battery in electric vehicles...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68830", "text": "{\n    \"patent_title\": \"Improved Connector for Battery Terminals\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US11123456B1\",\n    \"priority_date\": \"2022-07-20\",\n    \"filing_date\": \"2022-07-20\",\n    \"issue_date\": \"2024-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved electrical connector for battery terminals designed to minimize resistance and ensure a secure connection. The connector features a novel spring-loaded contact design.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Existing battery connector designs\"\n        }\n    ],\n    \"claims\": [\n        \"A battery connector comprising:...\",\n        \"A spring-loaded contact element...\",\n        \"A housing for the connector...\",\n        \"A method for assembling the connector...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68831", "text": "{\n    \"patent_title\": \"Miniature Robotic Surgical System with Enhanced Visual Feedback\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature robotic surgical system utilizing micro-actuators and integrated high-resolution endoscopic imaging for minimally invasive procedures. The system enhances precision and reduces patient trauma through remote control and advanced visual feedback.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system comprising...\",\n        \"A method for performing minimally invasive surgery using the system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68831", "text": "{\n    \"patent_title\": \"Novel Drug Delivery System for Cancer Treatment\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Sarah Johnson\",\n            \"affiliation\": \"PharmaCorp Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-01-10\",\n    \"filing_date\": \"2022-01-10\",\n    \"issue_date\": \"2023-10-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new system for delivering drugs to cancer patients. It utilizes a novel formulation to enhance drug efficacy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10111213B2\",\n            \"relevance\": \"Related to drug delivery technologies\"\n        }\n    ],\n    \"claims\": [\n        \"A drug delivery system comprising...\",\n        \"A method for treating cancer using the system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68832", "text": "{\n    \"patent_title\": \"Implantable Cardiovascular Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"CardioTech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"CardioTech Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-05-15\",\n    \"filing_date\": \"2020-06-01\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable device for continuous monitoring of cardiovascular function, providing real-time data transmission to a remote monitoring station.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in implantable sensors\"\n        }\n    ],\n    \"claims\": [\n        \"A method for continuously monitoring cardiac activity.\",\n        \"An implantable device comprising a sensor and a transmitter.\",\n        \"A system for remote monitoring of cardiovascular data.\",\n        \"The implantable device is powered by inductive coupling.\",\n        \"The transmitted data is encrypted for security.\",\n        \"The sensor measures blood pressure and heart rate.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68832", "text": "{\n    \"patent_title\": \"Improved Stent Design for Coronary Artery Disease\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-03-10\",\n    \"filing_date\": \"2021-04-05\",\n    \"issue_date\": \"2023-09-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel stent design with enhanced biocompatibility and reduced risk of restenosis for treating coronary artery disease.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related to previous stent designs\"\n        }\n    ],\n    \"claims\": [\n        \"A stent comprising a bioabsorbable polymer.\",\n        \"The stent is coated with a drug-eluting compound.\",\n        \"A method for deploying the stent in a coronary artery.\",\n        \"The stent has a specific mesh structure.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68833", "text": "{\n    \"patent_title\": \"Pediatric MRI with Reduced Scan Time Using Compressed Sensing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lucile Packard Children's Hospital\"\n        }\n    ],\n    \"patent_number\": \"US10456789B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-02-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for reducing MRI scan time in pediatric patients using compressed sensing techniques, improving patient comfort and reducing motion artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI on a pediatric patient comprising...\",\n        \"The method of claim 1, wherein the scan time is reduced by at least 30%.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68833", "text": "{\n    \"patent_title\": \"Novel Contrast Agent for Enhanced Cardiac MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-04-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel contrast agent formulation for use in cardiac MRI, providing improved image resolution and diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"The contrast agent of claim 1, wherein the concentration is optimized for cardiac imaging.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68834", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2021-03-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel contrast agent for magnetic resonance imaging (MRI) that enhances image clarity and diagnostic accuracy, particularly in detecting early-stage tumors.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising a gadolinium complex.\",\n        \"A method for enhancing MRI images using the contrast agent.\",\n        \"A method for diagnosing tumors using the enhanced MRI images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68834", "text": "{\n    \"patent_title\": \"Theoretical Framework for Quantum-Enhanced Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Davis\",\n            \"affiliation\": \"California Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2023-07-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A theoretical exploration of utilizing quantum entanglement to achieve unparalleled resolution in medical imaging, although practical implementation remains a significant challenge.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A theoretical model of quantum-enhanced medical imaging.\",\n        \"A method for utilizing entangled photons in imaging systems.\",\n        \"A mathematical framework for analyzing quantum image reconstruction.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68835", "text": "{\n    \"patent_title\": \"High-Efficiency Modulation Techniques for 5G Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Qualcomm Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents novel modulation schemes for 5G wireless communication, significantly improving data transmission rates and spectral efficiency. It utilizes advanced coding techniques and adaptive signal processing to overcome channel impairments.  The design enables seamless integration with new network architectures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art in modulation schemes.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for modulating a signal comprising...\",\n        \"An apparatus for demodulating a signal...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68835", "text": "{\n    \"patent_title\": \"Improved Handover Procedures for 3G Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Nokia\"\n        }\n    ],\n    \"patent_number\": \"EP2345678A1\",\n    \"priority_date\": \"2014-12-01\",\n    \"filing_date\": \"2015-01-05\",\n    \"issue_date\": \"2016-04-13\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"This invention introduces enhanced handover procedures for 3G networks, ensuring seamless connectivity during user mobility. The solution addresses compatibility with legacy systems and optimizes call drop rates. It extends existing protocols to provide a more robust user experience.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related prior art in handover management.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing a handover in a 3G network...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68836", "text": "{\n    \"patent_title\": \"Portable Ultrasound Device with Enhanced Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2020-04-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A portable ultrasound device designed for home healthcare applications. The device features an ergonomic design and wireless connectivity for remote monitoring.  It improves patient comfort and allows for convenient use in various settings.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"date\": \"2018-12-10\"\n        }\n    ],\n    \"claims\": [\n        \"A portable ultrasound device comprising...\",\n        \"A wireless communication module for data transmission...\",\n        \"An ergonomic housing designed for patient comfort...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68836", "text": "{\n    \"patent_title\": \"Surgical Robotic System with High Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Intuitive Surgical\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11123456B2\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-01-10\",\n    \"issue_date\": \"2022-07-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical robotic system designed to enhance precision and control during complex surgical procedures. The system utilizes advanced sensors and algorithms for real-time feedback and improved surgical outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"date\": \"2005-05-01\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic system comprising...\",\n        \"A high-resolution imaging module...\",\n        \"A precision control system for robotic arms...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68837", "text": "{\n    \"patent_title\": \"Non-Invasive Glucose Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MIT Lincoln Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive system for continuous glucose monitoring using near-infrared spectroscopy. The device provides real-time glucose readings without requiring blood samples.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art related to optical glucose sensors.\"\n        }\n    ],\n    \"claims\": [\n        \"A non-invasive glucose monitoring system comprising...\",\n        \"A method for determining glucose concentration...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68837", "text": "{\n    \"patent_title\": \"Surgical Instrument for Minimally Invasive Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Jones\",\n            \"affiliation\": \"Acme Medical Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-08-22\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2021-05-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical instrument designed for minimally invasive procedures, featuring enhanced precision and maneuverability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related art on surgical tools.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising...\",\n        \"A method for performing minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68838", "text": "{\n    \"patent_title\": \"Enhanced Power Management Techniques for Extended Battery Operation in Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Jian Li\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11254321B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-09-20\",\n    \"issue_date\": \"2021-12-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel power management algorithms and hardware implementations to significantly extend battery life in mobile devices. The system dynamically adjusts clock speeds and voltage levels based on workload, minimizing energy consumption without compromising performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Adaptive Voltage Scaling for Processors\"\n        }\n    ],\n    \"claims\": [\n        \"A method for dynamically adjusting clock speed in a portable electronic device.\",\n        \"A power management system comprising a voltage regulator and a processor.\",\n        \"A mobile device with extended battery life using the claimed method and system.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68838", "text": "{\n    \"patent_title\": \"Solid-State Electrolyte for High-Density Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11387654B2\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-07-15\",\n    \"issue_date\": \"2022-05-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel solid-state electrolyte material for lithium-ion batteries, enabling increased energy density and improved safety characteristics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10543219B2\",\n            \"title\": \"Lithium-Ion Battery with Enhanced Stability\"\n        }\n    ],\n    \"claims\": [\n        \"A solid-state electrolyte composition comprising lithium, lanthanum, zirconium, and oxygen.\",\n        \"A lithium-ion battery incorporating the claimed electrolyte composition.\",\n        \"A method for fabricating a solid-state lithium-ion battery.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68839", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical system designed for minimally invasive procedures. The system incorporates ergonomic improvements for the surgeon and utilizes advanced imaging techniques to enhance precision and reduce trauma to the patient. The device aims to improve patient comfort post-operatively.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"count\": 1\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"count\": 2\n        },\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"count\": 1\n        },\n        {\n            \"patent_number\": \"US12334455B1\",\n            \"count\": 1\n        },\n        {\n            \"patent_number\": \"US13445566B2\",\n            \"count\": 1\n        },\n        {\n            \"patent_number\": \"US14556677B1\",\n            \"count\": 1\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising...\",\n        \"A method for performing a minimally invasive procedure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68839", "text": "{\n    \"patent_title\": \"Advanced Endoscope with High-Resolution Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Li Wei\",\n            \"affiliation\": \"Huazhong University of Science and Technology\"\n        },\n        {\n            \"name\": \"Zhang Hua\",\n            \"affiliation\": \"Mindray\"\n        }\n    ],\n    \"patent_number\": \"CN101234567B\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"SIPO\",\n    \"abstract\": \"An endoscope featuring high-resolution imaging capabilities for improved visualization during medical examinations. The device enhances diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"CN11112222B\",\n            \"count\": 3\n        },\n        {\n            \"patent_number\": \"CN12345678B\",\n            \"count\": 1\n        }\n    ],\n    \"claims\": [\n        \"An endoscope comprising...\",\n        \"A method for using the endoscope...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68840", "text": "{\n    \"patent_title\": \"Improved MRI Reconstruction for Enhanced Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2023-11-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel MRI reconstruction algorithm that significantly improves image clarity, enabling more accurate detection of cancerous tissues. The method utilizes deep learning techniques to reduce noise and enhance contrast, resulting in superior diagnostic capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"An MRI system configured to utilize the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68840", "text": "{\n    \"patent_title\": \"New X-ray Shielding Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2016-02-29\",\n    \"filing_date\": \"2016-02-29\",\n    \"issue_date\": \"2022-04-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a new composite material for X-ray shielding. The material offers improved protection against radiation exposure during medical imaging procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in radiation shielding\"\n        }\n    ],\n    \"claims\": [\n        \"A composite material for X-ray shielding comprising...\",\n        \"An X-ray apparatus utilizing the composite material...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68841", "text": "{\n    \"patent_title\": \"Enhanced Lithium-Ion Battery with Improved Cycle Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10523456B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-09-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery design incorporating a modified electrolyte and electrode material, resulting in significantly improved cycle life and energy storage capacity. This invention addresses the limitations of current battery technology by enhancing ion conductivity and reducing degradation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Lithium-Ion Battery Electrode Materials\"\n        },\n        {\n            \"patent_number\": \"US8652987B2\",\n            \"title\": \"Electrolyte Composition for Lithium Batteries\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition for use in a lithium-ion battery...\",\n        \"A method for manufacturing a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68841", "text": "{\n    \"patent_title\": \"Method for Manufacturing Standard Automotive Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"ACME Battery Corp\"\n        }\n    ],\n    \"patent_number\": \"US9234567B1\",\n    \"priority_date\": \"2016-05-22\",\n    \"filing_date\": \"2017-01-18\",\n    \"issue_date\": \"2018-07-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This patent describes a streamlined process for manufacturing conventional lead-acid batteries commonly used in automobiles.  Improvements focus on automation and cost reduction in the existing manufacturing workflow.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Lead-Acid Battery Manufacturing Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for assembling lead-acid battery plates...\",\n        \"An automated system for electrolyte filling...\",\n        \"A quality control process for lead-acid batteries...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68842", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction for Low-Dose CT Scans\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10456789B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2020-10-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing CT images from low-dose scans, utilizing deep learning to enhance resolution and reduce noise. This leads to improved diagnostic accuracy with reduced radiation exposure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Prior Art CT Reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a CT image...\",\n        \"A system for reducing radiation dose in CT scanning...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68842", "text": "{\n    \"patent_title\": \"Wireless Communication System for Medical Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"TechCorp Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2022-04-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless communication protocol for transmitting data from medical devices to a central monitoring station. This system enhances the reliability and security of patient data transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Previous Wireless Medical Device Protocol\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication system comprising...\",\n        \"A method for securely transmitting medical data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68843", "text": "{\n    \"patent_title\": \"Deep Learning Enhanced MRI Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-10-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention utilizes deep learning algorithms to reconstruct high-resolution MRI images from undersampled data, significantly reducing scan time and improving image quality. It leverages convolutional neural networks to enhance detail and minimize artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images using deep learning.\",\n        \"An MRI system configured to implement the method of claim 1.\",\n        \"A computer-readable medium storing instructions for performing the method of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68843", "text": "{\n    \"patent_title\": \"Improved X-Ray Image Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-01-05\",\n    \"filing_date\": \"2019-01-05\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel technique for enhancing the contrast and clarity of X-ray images. The method employs a filtering algorithm to reduce noise and improve visualization of anatomical structures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing X-ray images to enhance contrast.\",\n        \"An X-ray system configured to implement the method of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68844", "text": "{\n    \"patent_title\": \"Targeted Nanoparticle Drug Delivery System for Cancer Therapy\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-05-15\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel nanoparticle drug delivery system designed for targeted cancer therapy. The nanoparticles encapsulate a chemotherapeutic agent and are functionalized with targeting ligands to selectively bind to cancer cells, improving bioavailability and reducing side effects.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art related to nanoparticle synthesis\"\n        }\n    ],\n    \"claims\": [\n        \"A nanoparticle composition comprising a chemotherapeutic agent and a targeting ligand.\",\n        \"A method for treating cancer comprising administering the nanoparticle composition to a subject.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68844", "text": "{\n    \"patent_title\": \"Modified Release Tablet Formulation for Oral Pain Relief\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Pfizer Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2022-11-01\",\n    \"filing_date\": \"2022-11-01\",\n    \"issue_date\": \"2024-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A modified release tablet formulation for oral administration of a pain reliever. The tablet is designed to provide sustained drug release over a 12-hour period, improving patient compliance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Prior art relating to tablet coating techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A tablet formulation comprising a pain reliever and a sustained release polymer.\",\n        \"A method for relieving pain comprising administering the tablet formulation to a subject.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68845", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2015-03-15\",\n    \"filing_date\": \"2015-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system incorporating advanced imaging and robotic control for precise tissue manipulation, leading to improved patient recovery times and reduced complications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising a robotic arm...\",\n        \"An imaging module configured to provide...\",\n        \"A control system for precise tissue manipulation...\",\n        \"A method for performing a minimally invasive surgery...\",\n        \"The surgical system of claim 1, wherein the robotic arm includes...\",\n        \"The imaging module of claim 2, wherein the imaging module is configured...\",\n        \"The control system of claim 3, wherein the control system is adapted...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68845", "text": "{\n    \"patent_title\": \"Improved Catheter Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2016-07-01\",\n    \"filing_date\": \"2016-07-01\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new catheter design improving fluid delivery and minimizing patient discomfort. It mainly focuses on material optimization.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A catheter comprising a flexible tube...\",\n        \"The catheter of claim 1, wherein the tube is made of...\",\n        \"A method for delivering fluid using the catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68846", "text": "{\n    \"patent_title\": \"Enhanced MRI Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-04-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing MRI images using deep convolutional neural networks, significantly improving image quality and reducing scan time. This is an innovative approach to medical imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for performing MRI image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68846", "text": "{\n    \"patent_title\": \"Improved X-Ray Tube Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"EP2789012B1\",\n    \"priority_date\": \"2014-12-20\",\n    \"filing_date\": \"2015-01-10\",\n    \"issue_date\": \"2016-10-26\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"An improvement to the design of X-ray tubes, increasing their efficiency and lifespan.  A practical enhancement for existing X-ray systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube comprising...\",\n        \"A method for manufacturing an X-ray tube...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68847", "text": "{\n    \"patent_title\": \"Method and System for Extended Battery Life in Mobile Devices Using Dynamic Power Allocation\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-06-20\",\n    \"issue_date\": \"2021-12-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel method for dynamically allocating power to different components of a mobile device, significantly extending battery life. The system utilizes energy harvesting techniques from ambient RF signals and optimizes power consumption through advanced power management algorithms. Extensive testing demonstrates a 30% improvement in battery longevity compared to existing solutions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art related to power saving modes\"\n        }\n    ],\n    \"claims\": [\n        \"A method for dynamically allocating power to a plurality of components in a mobile device.\",\n        \"A system for harvesting energy from ambient radio frequency signals.\",\n        \"A power management algorithm for optimizing battery life.\",\n        \"The method of claim 1, wherein the power allocation is based on real-time usage patterns.\",\n        \"The system of claim 2, wherein the harvested energy is stored in a rechargeable battery.\",\n        \"The algorithm of claim 3, further comprising a predictive model for anticipating power demands.\",\n        \"A mobile device comprising the system of claim 2.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68847", "text": "{\n    \"patent_title\": \"Improved Battery Connector for Smartphones\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"TechCorp Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2022-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new battery connector design for smartphones that provides a more secure and reliable connection. The connector features a modified locking mechanism and improved material composition to reduce signal interference and enhance durability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Previous connector designs.\"\n        }\n    ],\n    \"claims\": [\n        \"A battery connector for a smartphone.\",\n        \"The battery connector of claim 1, comprising a locking mechanism.\",\n        \"The locking mechanism of claim 2, comprising a spring-loaded clip.\",\n        \"The battery connector of claim 1, made of a conductive polymer.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68848", "text": "{\n    \"patent_title\": \"Method and System for Low-Dose Computed Tomography\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for reducing radiation dose in computed tomography (CT) imaging while maintaining image quality. The method utilizes advanced iterative reconstruction algorithms and noise reduction techniques to achieve clinically acceptable images with significantly lower radiation exposure to the patient.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8766821B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing computed tomography comprising...\",\n        \"A system for performing computed tomography comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68848", "text": "{\n    \"patent_title\": \"Improved X-Ray Tube Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"Siemens Healthcare\"\n        }\n    ],\n    \"patent_number\": \"EP3876543A1\",\n    \"priority_date\": \"2018-09-20\",\n    \"filing_date\": \"2018-09-20\",\n    \"issue_date\": \"2020-01-15\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"This invention relates to an improved X-ray tube design incorporating novel filament materials and cooling mechanisms for enhanced efficiency and longevity. The design results in clearer images and higher throughput.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9235678B1\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube comprising...\",\n        \"A filament for an X-ray tube comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68849", "text": "{\n    \"patent_title\": \"AI-Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-09-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method for reconstructing medical images using artificial intelligence techniques, specifically deep learning, to improve image quality and reduce radiation exposure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Prior art in image reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"The method of claim 1, wherein the artificial intelligence model is a convolutional neural network.\",\n        \"The method of claim 1, further comprising a step of...\",\n        \"A system for performing the method of claim 1...\",\n        \"The system of claim 4, wherein the system includes...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68849", "text": "{\n    \"patent_title\": \"Improved X-ray Detection System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"EP11223344B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"This invention discloses an improved X-ray detection system offering enhanced sensitivity and clarity. It utilizes novel sensor technology and signal processing techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10112233B2\",\n            \"relevance\": \"Related prior art in X-ray technology\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray detection system comprising...\",\n        \"The system of claim 1, wherein the sensor is a flat-panel detector.\",\n        \"The system of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68850", "text": "{\n    \"patent_title\": \"Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"EP3845217B1\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-05-15\",\n    \"issue_date\": \"2021-11-10\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"An implantable biosensor for continuous glucose monitoring. The device utilizes a novel enzymatic reaction and wireless communication to provide real-time glucose readings.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8562832B2\"\n        }\n    ],\n    \"claims\": [\n        \"A biosensor for continuous glucose monitoring comprising...\",\n        \"A method for determining glucose levels in a patient using said biosensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68850", "text": "{\n    \"patent_title\": \"Surgical Instrument Handle\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2017-12-20\",\n    \"filing_date\": \"2018-12-20\",\n    \"issue_date\": \"2022-03-01\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"An improved handle for surgical instruments, providing enhanced grip and control.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A surgical instrument handle comprising...\",\n        \"A method for using said handle...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68851", "text": "{\n    \"patent_title\": \"Novel MRI Contrast Agent for Enhanced Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel MRI contrast agent utilizing nanoparticles for improved visualization of tumor microenvironments, leading to more accurate and earlier cancer detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Prior Art MRI Contrast Agent\"\n        }\n    ],\n    \"claims\": [\n        \"A method for imaging tumors comprising administering the contrast agent...\",\n        \"A contrast agent comprising nanoparticles functionalized with targeting ligands...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68851", "text": "{\n    \"patent_title\": \"Improved X-Ray Tube Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Carol Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"EP11223344B1\",\n    \"priority_date\": \"2015-11-10\",\n    \"filing_date\": \"2015-11-10\",\n    \"issue_date\": \"2017-05-12\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"An improved design for X-ray tubes that enhances image clarity and reduces radiation dose.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Conventional X-Ray Tube\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube comprising a modified filament design...\",\n        \"A method for producing X-rays using the improved tube...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68852", "text": "{\n    \"patent_title\": \"Non-Invasive Glucose Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-15\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive glucose monitoring system utilizing optical sensors and machine learning algorithms for accurate and real-time blood glucose level detection. This system aims to improve diabetes management by providing continuous and painless monitoring.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A non-invasive glucose monitoring system comprising an optical sensor...\",\n        \"A method for real-time blood glucose level detection...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68852", "text": "{\n    \"patent_title\": \"Surgical Robotic Arm with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2020-11-15\",\n    \"filing_date\": \"2020-11-20\",\n    \"issue_date\": \"2022-07-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical robotic arm designed for minimally invasive procedures. The system incorporates advanced sensors and control algorithms to provide surgeons with enhanced precision and dexterity during complex operations.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic arm comprising a plurality of joint actuators...\",\n        \"A control system for regulating the movement of the robotic arm...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68853", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Bio-Resonator for Targeted Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"MIT Bioengineering Lab\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable device utilizing bio-resonance to precisely deliver therapeutic agents to targeted tissues. The device is constructed from biocompatible polymers and demonstrates enhanced drug efficacy with minimal side effects.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on implantable resonators\"\n        }\n    ],\n    \"claims\": [\n        \"A biocompatible implantable resonator for drug delivery.\",\n        \"A method for targeted drug delivery using bio-resonance.\",\n        \"An implantable device comprising a bio-resonant module and a drug reservoir.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68853", "text": "{\n    \"patent_title\": \"Surgical Stapler with Enhanced Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Johnson & Johnson Medical Devices\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-12-01\",\n    \"filing_date\": \"2019-12-01\",\n    \"issue_date\": \"2022-08-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler design incorporating ergonomic features for enhanced surgical precision and reduced surgeon fatigue. Utilizes standard surgical staples and materials.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art on surgical staplers\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler with an ergonomic handle.\",\n        \"A stapler cartridge designed for easy loading.\",\n        \"A method for using the ergonomic surgical stapler.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68854", "text": "{\n    \"patent_title\": \"Method and System for Dynamic Power Management in Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Qualcomm Technologies\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2022-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for dynamically adjusting power consumption in mobile devices based on user activity and application demand, thereby extending battery life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art in power management\"\n        }\n    ],\n    \"claims\": [\n        \"A method for dynamically adjusting CPU frequency...\",\n        \"A system comprising a power management unit...\",\n        \"A mobile device configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68854", "text": "{\n    \"patent_title\": \"Lithium-Sulfur Battery with Enhanced Cycle Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Samsung SDI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2020-03-01\",\n    \"filing_date\": \"2020-03-01\",\n    \"issue_date\": \"2023-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-sulfur battery design incorporating novel electrolyte additives to improve cycle life and reduce polysulfide shuttling.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art in lithium-sulfur battery research\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-sulfur battery comprising...\",\n        \"An electrolyte additive...\",\n        \"A method for fabricating a lithium-sulfur battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68855", "text": "{\n    \"patent_title\": \"Improved Contrast Enhancement Technique for MRI Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A novel method for enhancing contrast in Magnetic Resonance Images (MRI) is presented, leading to improved visualization of subtle anatomical features and increased diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8234567B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing contrast in MRI images comprising...\",\n        \"An MRI system configured to utilize the contrast enhancement method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68855", "text": "{\n    \"patent_title\": \"Method for Improved X-Ray Image Acquisition\",\n    \"inventors\": [\n        {\n            \"name\": \"Charles Davis\",\n            \"affiliation\": \"Imperial College London\"\n        }\n    ],\n    \"patent_number\": \"EP3456789A1\",\n    \"priority_date\": \"2017-01-10\",\n    \"filing_date\": \"2017-01-10\",\n    \"issue_date\": \"2018-05-16\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"This invention discloses a new technique for acquiring X-ray images with reduced radiation exposure while maintaining image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for acquiring X-ray images comprising...\",\n        \"An X-ray system configured to implement the improved acquisition technique...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68856", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-15\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for enhancing the resolution of digital images using deep convolutional neural networks. The system learns to map low-resolution images to high-resolution counterparts, providing a significant improvement in image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising...\",\n        \"A system for processing images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68856", "text": "{\n    \"patent_title\": \"Medical Image Analysis System for Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"EP3876543A1\",\n    \"priority_date\": \"2020-11-15\",\n    \"filing_date\": \"2021-02-01\",\n    \"issue_date\": \"2022-07-15\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"A system and method for analyzing medical images, specifically designed for the automated detection of tumors in MRI scans. Utilizes advanced image processing techniques to improve diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting tumors in medical images...\",\n        \"A system for analyzing MRI scans...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68857", "text": "{\n    \"patent_title\": \"AI-Powered Medical Image Analysis System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-06-20\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an AI-powered system for analyzing medical images to detect anomalies with high accuracy. It uses a novel deep learning architecture for improved performance in identifying subtle indicators of disease.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for analyzing medical images comprising...\",\n        \"A method for detecting anomalies in medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68857", "text": "{\n    \"patent_title\": \"Enhanced Image Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"TechCorp Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-12-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved image compression algorithm that reduces file size while maintaining high image quality. It is applicable to a wide range of image formats.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image comprising...\",\n        \"A system for encoding image data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68858", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Cardiac Monitor with Wireless Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Medtronic Inc.\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable cardiac monitor capable of continuously monitoring cardiac activity and wirelessly transmitting data to a remote receiver. This allows for early detection of arrhythmias and other cardiac events, improving patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art on implantable devices.\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable cardiac monitor comprising...\",\n        \"A wireless data transmission system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68858", "text": "{\n    \"patent_title\": \"Surgical Retractor with Improved Ergonomic Design\",\n    \"inventors\": [\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"Johnson & Johnson\"\n        },\n        {\n            \"name\": \"Emily Davis\",\n            \"affiliation\": \"Stryker Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2022-03-15\",\n    \"filing_date\": \"2022-03-15\",\n    \"issue_date\": \"2023-10-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical retractor featuring an ergonomic handle and adjustable blade configuration for enhanced surgical access and control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art relating to surgical retractors.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical retractor comprising...\",\n        \"An ergonomic handle design...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68859", "text": "{\n    \"patent_title\": \"Enhanced MRI Contrast Agent for Early-Stage Breast Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel MRI contrast agent exhibiting increased sensitivity for detecting early-stage breast cancer lesions. The agent utilizes targeted nanoparticles to enhance signal amplification and improve diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on nanoparticle contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting early-stage breast cancer...\",\n        \"An MRI contrast agent comprising...\",\n        \"A nanoparticle formulation for targeted imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68859", "text": "{\n    \"patent_title\": \"Digital X-Ray Image Processing Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Mr. Robert Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"Ms. Alice Johnson\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2015-12-01\",\n    \"filing_date\": \"2015-12-01\",\n    \"issue_date\": \"2018-09-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved digital x-ray image processing technique for enhancing image clarity and reducing noise. The technique employs advanced filtering algorithms to optimize image quality for various anatomical regions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art on x-ray image filtering\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing digital x-ray images...\",\n        \"An image filtering algorithm comprising...\",\n        \"A system for enhancing x-ray image quality...\",\n        \"A digital x-ray image processing apparatus...\",\n        \"A noise reduction technique for medical imaging...\",\n        \"An artifact removal process...\",\n        \"A contrast enhancement methodology...\",\n        \"A digital image reconstruction system...\",\n        \"A method for optimizing image resolution...\",\n        \"A system for displaying medical x-ray images...\",\n        \"An image compression algorithm...\",\n        \"A method for calibrating x-ray equipment...\",\n        \"A radiation dose reduction technique...\",\n        \"A system for automating x-ray image analysis...\",\n        \"An image segmentation algorithm...\",\n        \"A method for detecting anomalies in x-ray images...\",\n        \"A system for supporting remote diagnosis...\",\n        \"An image archiving and retrieval system...\",\n        \"A method for ensuring image security...\",\n        \"A quality control process for x-ray images...\",\n        \"A system for integrating x-ray images with electronic health records...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68860", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for improving the analysis of medical images using advanced image processing algorithms. The system enhances image clarity and identifies potential anomalies for improved diagnostics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related prior art\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related prior art\"\n        },\n        {\n            \"patent_number\": \"US9234567B1\",\n            \"relevance\": \"Related prior art\"\n        },\n        {\n            \"patent_number\": \"US9345678B2\",\n            \"relevance\": \"Related prior art\"\n        },\n        {\n            \"patent_number\": \"US9456789B1\",\n            \"relevance\": \"Related prior art\"\n        },\n        {\n            \"patent_number\": \"US9567890B2\",\n            \"relevance\": \"Related prior art\"\n        },\n        {\n            \"patent_number\": \"US9678901B1\",\n            \"relevance\": \"Related prior art\"\n        },\n        {\n            \"patent_number\": \"US9789012B2\",\n            \"relevance\": \"Related prior art\"\n        },\n        {\n            \"patent_number\": \"US9890123B1\",\n            \"relevance\": \"Related prior art\"\n        },\n        {\n            \"patent_number\": \"US9901234B2\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing medical images comprising...\",\n        \"A system for analyzing medical images...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68860", "text": "{\n    \"patent_title\": \"Digital Image Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2017-01-10\",\n    \"filing_date\": \"2017-01-10\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel digital image compression technique utilizing wavelet transforms and entropy coding for efficient storage and transmission of image data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related prior art\"\n        },\n        {\n            \"patent_number\": \"US8543210B1\",\n            \"relevance\": \"Related prior art\"\n        },\n        {\n            \"patent_number\": \"US8643219B2\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing digital images...\",\n        \"A system for encoding image data...\",\n        \"A computer program for image compression...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68861", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"MIT Lincoln Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized, fully implantable biosensor for continuous glucose monitoring. The device utilizes a novel enzymatic reaction and wireless communication to provide real-time glucose data to a smartphone app. The small size and wireless functionality address the need for less invasive and more comfortable glucose monitoring solutions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on glucose biosensors\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized biosensor comprising...\",\n        \"A method for continuously monitoring glucose levels...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68861", "text": "{\n    \"patent_title\": \"Advanced Robotic Surgical System with Haptic Feedback\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Boston Dynamics\"\n        },\n        {\n            \"name\": \"Emily Chen\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An advanced robotic surgical system providing surgeons with enhanced precision and haptic feedback. The system incorporates complex algorithms for image processing and robotic control, enabling minimally invasive surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art on robotic surgical systems\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system comprising...\",\n        \"A method for performing surgery using a robotic system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68862", "text": "{\n    \"patent_title\": \"High-Resolution Medical Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning algorithm for reconstructing high-resolution medical images from low-dose CT scans. The method significantly improves image quality and reduces radiation exposure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Previous Image Reconstruction Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for performing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68862", "text": "{\n    \"patent_title\": \"Novel Contrast Agent for Enhanced MRI Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2024-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new contrast agent for magnetic resonance imaging (MRI) that enhances image contrast and improves the detection of tumors.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Prior Art Contrast Agent\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"A method for using the contrast agent of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68863", "text": "{\n    \"patent_title\": \"Improved Method for Automated Detection of Pulmonary Nodules in CT Scans\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method for automated detection of pulmonary nodules in computed tomography (CT) scans. The method utilizes a deep learning algorithm trained on a large dataset of CT images to improve diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"System for Computer-Aided Diagnosis of Lung Cancer\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting pulmonary nodules in a CT scan...\",\n        \"A computer-implemented system comprising...\",\n        \"The method of claim 1, wherein the deep learning algorithm...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68863", "text": "{\n    \"patent_title\": \"Novel Contrast Agent for Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2018-09-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel contrast agent for enhancing image clarity in magnetic resonance imaging (MRI). The contrast agent comprises a gadolinium complex with a modified ligand structure for improved biocompatibility and signal intensity.  The agent is broadly applicable across various MRI protocols and anatomical regions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Gadolinium-Based Contrast Agents for MRI\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent for MRI comprising a gadolinium complex...\",\n        \"The contrast agent of claim 1, wherein the ligand structure...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68864", "text": "{\n    \"patent_title\": \"Method for Enhanced MRI Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-07-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing MRI images using deep convolutional neural networks is presented. The method significantly improves image clarity and reduces noise, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Prior Art MRI Reconstruction Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"The method of claim 1, wherein the neural network...\",\n        \"A system for performing the method of claim 1...\",\n        \"The system of claim 3, further comprising...\",\n        \"A non-transitory computer-readable medium...\",\n        \"The medium of claim 5, wherein the instructions...\",\n        \"The method of claim 1, wherein the image clarity is improved by at least 20%...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68864", "text": "{\n    \"patent_title\": \"Medical Image Processing System\",\n    \"inventors\": [\n        {\n            \"name\": \"Li Wei\",\n            \"affiliation\": \"Huazhong University of Science and Technology\"\n        }\n    ],\n    \"patent_number\": \"CN108765432B\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2019-06-14\",\n    \"patent_office\": \"SIPO\",\n    \"abstract\": \"A medical image processing system for enhancing contrast in X-ray images. The system employs a basic filtering technique to improve image visualization.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A medical image processing system comprising a filtering unit...\",\n        \"The system of claim 1, wherein the filtering unit...\",\n        \"A method for processing medical images using the system of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68865", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Magnetic Resonance Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-09-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method and system for reconstructing magnetic resonance images with improved resolution and reduced noise. The method utilizes a deep learning algorithm to enhance image quality and accelerate reconstruction time, enabling faster and more accurate diagnoses. It includes a novel regularization technique to stabilize the reconstruction process and reduce artifacts. The system comprises a MRI scanner, a processing unit with GPU acceleration, and a display interface.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Prior Art MRI Reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a magnetic resonance image...\",\n        \"A system comprising an MRI scanner and a processing unit...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68865", "text": "{\n    \"patent_title\": \"Improved X-ray Image Enhancement Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2021-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An enhanced X-ray image processing technique is presented, improving contrast and reducing noise in radiographic images. The method employs a wavelet transform and adaptive histogram equalization.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Conventional X-ray Imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing the contrast of an X-ray image...\",\n        \"A system for processing X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68866", "text": "{\n    \"patent_title\": \"Improved Iterative Reconstruction Method for Low-Dose CT Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel iterative reconstruction algorithm for computed tomography (CT) imaging that significantly reduces radiation dose while maintaining high image quality. The method incorporates a learned regularizer to enhance image clarity and suppress noise.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"count\": 150\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"count\": 120\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a CT image...\",\n        \"A system comprising a CT scanner...\",\n        \"The method of claim 1, wherein the radiation dose is reduced by at least 30%...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68866", "text": "{\n    \"patent_title\": \"Novel Contrast Agent for Enhanced MRI Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2021-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new class of gadolinium-based contrast agents for magnetic resonance imaging (MRI) that provides improved signal enhancement and tissue specificity. The agent exhibits high relaxivity and biocompatibility.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B1\",\n            \"count\": 80\n        },\n        {\n            \"patent_number\": \"US9234567B2\",\n            \"count\": 60\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising a gadolinium complex...\",\n        \"A method for enhancing MRI images...\",\n        \"The contrast agent of claim 1, wherein the relaxivity is greater than...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68867", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Enhanced Biocompatibility\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2022-05-15\",\n    \"filing_date\": \"2022-07-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor utilizing a novel biocompatible coating to minimize tissue rejection and provide continuous glucose monitoring for diabetic patients. This improves patient quality of life by reducing the need for frequent finger pricks.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A glucose sensor comprising a biocompatible coating...\",\n        \"A method for continuous glucose monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68867", "text": "{\n    \"patent_title\": \"Automated Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Acme Robotics Corp.\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Acme Robotics Corp.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2023-03-10\",\n    \"filing_date\": \"2023-05-25\",\n    \"issue_date\": \"2024-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated surgical stapler designed to improve surgical precision and reduce surgeon fatigue. The device features an ergonomic handle and adjustable stapling depth.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an ergonomic handle...\",\n        \"A method for automated tissue stapling...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68868", "text": "{\n    \"patent_title\": \"Enhanced Low-Light Medical Imaging System Using Adaptive Filtering\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A medical imaging system designed to enhance image clarity in low-light conditions using adaptive filtering techniques, improving diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Prior Art Imaging System\"\n        }\n    ],\n    \"claims\": [\n        \"A medical imaging system comprising an image sensor, an adaptive filter, and a display.\",\n        \"The system of claim 1, wherein the adaptive filter is configured to reduce noise in low-light conditions.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68868", "text": "{\n    \"patent_title\": \"Improved CT Scanning Resolution\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Clara Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-07-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for increasing the resolution of CT scans through advanced reconstruction algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B2\",\n            \"title\": \"Basic CT Scan Technology\"\n        },\n        {\n            \"patent_number\": \"DE12345678A\",\n            \"title\": \"Siemens CT Enhancement\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing CT images comprising an algorithm for enhancing resolution.\",\n        \"The method of claim 1, wherein the algorithm utilizes iterative reconstruction.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68869", "text": "{\n    \"patent_title\": \"Method and Apparatus for Enhanced Signal Transmission in Millimeter Wave 5G Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-01\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and apparatus for improving signal reliability in millimeter wave 5G networks by utilizing adaptive beamforming and interference cancellation techniques.  The invention addresses the challenges of signal blockage in dense urban environments.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for transmitting a wireless signal comprising:...\",\n        \"An apparatus for enhancing signal reliability in a 5G network comprising:...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68869", "text": "{\n    \"patent_title\": \"Improved Data Compression Techniques for 4G LTE Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Verizon Wireless\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Verizon Wireless\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-05-20\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2021-07-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This patent discloses novel data compression techniques for enhancing the efficiency of data transmission in 4G LTE networks. The method reduces bandwidth consumption and improves overall network performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data in a 4G LTE network comprising:...\",\n        \"A system for improving data transmission efficiency comprising:...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68870", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction Algorithm for PET Scanners\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-09-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an improved image reconstruction algorithm for Positron Emission Tomography (PET) scanners, enhancing image quality and reducing scan time, leading to improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B1\",\n            \"title\": \"Prior Art PET Reconstruction Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing PET images comprising...\",\n        \"The method of claim 1, wherein the reconstruction algorithm...\",\n        \"A PET scanner configured to implement the method of claim 1...\",\n        \"The PET scanner of claim 3, further comprising...\",\n        \"The method of claim 1, wherein diagnostic accuracy is increased by at least 10%...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68870", "text": "{\n    \"patent_title\": \"Novel Contrast Agent for MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Pharmaceutical Corp.\"\n        }\n    ],\n    \"patent_number\": \"US98765432B2\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel contrast agent for Magnetic Resonance Imaging (MRI), enhancing image contrast and improving visualization of specific tissues.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\",\n            \"title\": \"Existing MRI Contrast Agent\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"The contrast agent of claim 1, wherein...\",\n        \"A method for enhancing MRI images comprising...\",\n        \"The method of claim 3, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68871", "text": "{\n    \"patent_title\": \"Implantable Cardiac Monitor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2015-03-10\",\n    \"filing_date\": \"2015-03-09\",\n    \"issue_date\": \"2019-06-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac monitor capable of wirelessly transmitting electrocardiogram data to a remote server for real-time analysis and alerts. The device utilizes low-power circuitry and advanced signal processing to improve battery life and data accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8656000B2\",\n            \"relevance\": \"Similar cardiac monitoring technology\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiac monitoring device comprising...\",\n        \"A wireless communication module...\",\n        \"A method for transmitting ECG data...\",\n        \"A system for real-time analysis...\",\n        \"An alert generation mechanism...\",\n        \"A low-power circuit...\",\n        \"A signal processing unit...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68871", "text": "{\n    \"patent_title\": \"Surgical Instrument for Orthopedic Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US8435123B1\",\n    \"priority_date\": \"2013-11-22\",\n    \"filing_date\": \"2013-11-21\",\n    \"issue_date\": \"2017-05-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical instrument designed to enhance precision during orthopedic bone cutting and shaping. The instrument incorporates a motorized blade and a guidance system.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7988679B2\",\n            \"relevance\": \"Related orthopedic surgical tools\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising...\",\n        \"A motorized blade...\",\n        \"A guidance system...\",\n        \"A handle for manipulation...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68872", "text": "{\n    \"patent_title\": \"Method for Enhanced MRI Image Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing Magnetic Resonance Images (MRI) using deep learning techniques, resulting in faster scan times and improved image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8785792B2\",\n            \"title\": \"MRI Reconstruction Techniques\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Deep Learning for Image Processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"A system for performing MRI reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68872", "text": "{\n    \"patent_title\": \"Improved X-Ray Detection System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved X-ray detection system utilizing a novel sensor array to enhance image clarity and reduce radiation exposure.\",\n    \"citations\": [],\n    \"claims\": [\n        \"An X-ray detection system comprising...\",\n        \"A sensor array for X-ray imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68873", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Haptic Feedback\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US1054321B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-01-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system incorporating haptic feedback to provide surgeons with enhanced tactile sensation during procedures, improving precision and reducing patient trauma. The system utilizes a novel sensor array and control algorithm for real-time feedback.\",\n    \"citations\": [\n        {\n            \"document_id\": \"US8765432B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising: a surgical instrument; a sensor array configured to detect forces applied by the surgical instrument; a control system configured to generate haptic feedback based on the detected forces; and a display for transmitting the haptic feedback to a surgeon.\",\n        \"The system of claim 1, wherein the haptic feedback is real-time.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68873", "text": "{\n    \"patent_title\": \"Method and Apparatus for Neural Tissue Stimulation\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2014-11-10\",\n    \"filing_date\": \"2014-11-10\",\n    \"issue_date\": \"2019-05-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for targeted neural stimulation using focused ultrasound. The system delivers precise energy pulses to specific brain regions for therapeutic purposes.\",\n    \"citations\": [\n        {\n            \"document_id\": \"US7654321B2\",\n            \"relevance\": \"cited\"\n        },\n        {\n            \"document_id\": \"US8901234B1\",\n            \"relevance\": \"cited\"\n        }\n    ],\n    \"claims\": [\n        \"A neural stimulation apparatus comprising: an ultrasound transducer; a focusing mechanism; and a control system for delivering pulsed ultrasound energy.\",\n        \"The apparatus of claim 1, wherein the ultrasound energy is focused on a specific brain region.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68874", "text": "{\n    \"patent_title\": \"Neural Network-Based Image Enhancement for Satellite Imagery\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image enhancement algorithm utilizing deep convolutional neural networks for improving the quality of satellite imagery. The algorithm focuses on enhancing details and reducing noise in low-resolution images, leading to improved visual clarity and analytical capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related image processing technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing satellite imagery using a deep convolutional neural network.\",\n        \"A system comprising a deep convolutional neural network configured to enhance satellite imagery.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68874", "text": "{\n    \"patent_title\": \"MRI Image Reconstruction using Compressed Sensing\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2022-03-15\",\n    \"filing_date\": \"2022-03-15\",\n    \"issue_date\": \"2024-02-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing Magnetic Resonance Images (MRI) from incomplete data using compressed sensing techniques. This leads to faster scan times and reduced patient discomfort.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related MRI reconstruction algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images using compressed sensing.\",\n        \"A system comprising a processor configured to reconstruct MRI images using compressed sensing.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68875", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-09-20\",\n    \"issue_date\": \"2023-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized, implantable biosensor for continuous glucose monitoring, utilizing a novel enzymatic reaction and microfluidic design to provide highly accurate and reliable glucose readings. The device is designed for long-term implantation and wireless data transmission to a patient's mobile device.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A biosensor comprising a miniaturized enzymatic reaction chamber.\",\n        \"A method for continuous glucose monitoring using said biosensor.\",\n        \"A system for wirelessly transmitting glucose data.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68875", "text": "{\n    \"patent_title\": \"Surgical Stapler with Enhanced Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Acme Medical Devices Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-11-01\",\n    \"filing_date\": \"2023-02-15\",\n    \"issue_date\": \"2024-01-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler featuring an ergonomic handle design and enhanced staple deployment mechanism for greater precision and reduced surgeon fatigue.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an ergonomic handle.\",\n        \"A staple cartridge for use with said stapler.\",\n        \"A method of performing surgical anastomosis using said stapler.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68876", "text": "{\n    \"patent_title\": \"Novel Convolutional Neural Network Architecture for Enhanced Image Classification\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel convolutional neural network architecture utilizing attention mechanisms and dynamic filter sizes to improve image classification accuracy, particularly in challenging conditions. The approach significantly outperforms existing state-of-the-art methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\",\n            \"relevance\": \"Related prior art on convolutional neural networks\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image classification comprising...\",\n        \"A convolutional neural network architecture...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68876", "text": "{\n    \"patent_title\": \"Image Recognition Using Pre-trained ResNet-50\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Generic Tech Solutions Inc.\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention utilizes a pre-trained ResNet-50 model for image recognition tasks. Fine-tuning is performed on a specific dataset to improve accuracy for a particular application. The system leverages transfer learning to reduce training time and data requirements.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\",\n            \"relevance\": \"ResNet-50 architecture\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition using a pre-trained model...\",\n        \"A method for fine-tuning a ResNet-50 model...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68877", "text": "{\n    \"patent_title\": \"AI-Enhanced MRI Reconstruction for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for reconstructing MRI images using deep learning techniques. The system significantly reduces scan time and improves image quality, enabling earlier and more accurate detection of cancerous tumors. The artificial intelligence algorithms are trained on a large dataset of MRI scans.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"MRI Image Reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for early cancer detection using AI-enhanced MRI.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68877", "text": "{\n    \"patent_title\": \"Improved X-ray Image Filtering Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Hospital\"\n        }\n    ],\n    \"patent_number\": \"EP3456789A1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2019-05-10\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"This invention provides a new filtering technique for X-ray images to reduce noise and enhance contrast. It utilizes a wavelet transform based approach. The method improves the visibility of subtle details in X-ray images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Wavelet Transform for Image Enhancement\"\n        }\n    ],\n    \"claims\": [\n        \"A method for filtering X-ray images comprising...\",\n        \"A system for enhancing X-ray image contrast.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68878", "text": "{\n    \"patent_title\": \"Method for Noise Reduction in Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10456789B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel method for reducing noise in magnetic resonance images (MRI). The technique utilizes a wavelet-based filtering algorithm combined with a deep learning model trained to identify and suppress noise artifacts. This leads to significantly improved image clarity, enhancing the ability to detect subtle anomalies and improve diagnostic accuracy. The method is particularly effective for low-signal-to-noise ratio images and can be applied to a variety of MRI sequences. Clinical trials have demonstrated a substantial increase in the detection rate of early-stage tumors using this technology. The algorithm's efficiency allows for real-time image processing, making it suitable for clinical applications. The invention also includes a method for automatically adjusting filter parameters based on image characteristics. Further, the system is capable of integrating with existing MRI scanners and image processing software.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Image Enhancement Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing noise in MRI images...\",\n        \"A system for real-time noise reduction...\",\n        \"An MRI scanner incorporating the noise reduction method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68878", "text": "{\n    \"patent_title\": \"Improved CT Scan Reconstruction Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of Michigan\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2017-07-20\",\n    \"filing_date\": \"2017-07-20\",\n    \"issue_date\": \"2021-11-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new algorithm for reconstructing images from CT scan data, reducing artifacts and improving resolution. The method utilizes iterative reconstruction techniques with advanced regularization methods. This improves image quality for diagnostic purposes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US88889999B2\",\n            \"title\": \"CT Scan Imaging System\"\n        },\n        {\n            \"patent_number\": \"DE12345678B3\",\n            \"title\": \"Siemens CT Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing CT scan images...\",\n        \"A system utilizing the reconstruction algorithm...\",\n        \"A CT scanner incorporating the reconstruction method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68879", "text": "{\n    \"patent_title\": \"Enhanced Lithium-Ion Battery with Silicon Anode and Novel Electrolyte\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11245678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-04-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery incorporating a silicon anode with a unique electrolyte composition, leading to increased energy density and cycle life. This invention addresses the limitations of conventional graphite anodes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        },\n        {\n            \"patent_number\": \"CN109876543A\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising a silicon anode.\",\n        \"An electrolyte composition for a lithium-ion battery.\",\n        \"A method for manufacturing a lithium-ion battery with improved energy density.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68879", "text": "{\n    \"patent_title\": \"Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Elon Musk\",\n            \"affiliation\": \"Tesla\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Tesla\"\n        }\n    ],\n    \"patent_number\": \"US10876543B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2022-07-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) designed for electric vehicles, optimizing battery performance and safety. The system includes advanced algorithms for cell balancing and thermal management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for an electric vehicle.\",\n        \"A method for cell balancing in a battery pack.\",\n        \"A thermal management system for a battery pack.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68880", "text": "{\n    \"patent_title\": \"High-Capacity Lithium-Ion Battery with Enhanced Cycle Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery design incorporating a silicon-carbon composite anode and a solid-state electrolyte, resulting in significantly increased energy density and cycle life. Suitable for electric vehicle applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Lithium-Ion Battery with Improved Thermal Stability\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising a silicon-carbon composite anode.\",\n        \"The battery of claim 1, further comprising a solid-state electrolyte.\",\n        \"The battery of claim 2, wherein the solid-state electrolyte is a lithium superionic conductor.\",\n        \"The battery of claim 1, having an energy density of at least 300 Wh/kg.\",\n        \"The battery of claim 1, suitable for use in an electric vehicle.\",\n        \"The battery of claim 1, exhibiting a cycle life of at least 1000 cycles.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68880", "text": "{\n    \"patent_title\": \"Battery Management System for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Texas Instruments\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A sophisticated battery management system (BMS) designed to optimize the performance and safety of lithium-ion battery packs. The BMS includes advanced cell balancing and thermal management features.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"title\": \"Method for Detecting Faults in Battery Management Systems\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising a cell voltage monitor.\",\n        \"The system of claim 1, further comprising a cell temperature sensor.\",\n        \"The system of claim 1, comprising a cell balancing circuit.\",\n        \"The system of claim 1, adapted to prevent overcharging and over-discharging of the battery.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68881", "text": "{\n    \"patent_title\": \"AI-Enhanced Medical Image Analysis for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Health\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel system for medical image analysis utilizing artificial intelligence to improve the accuracy of early cancer detection. The system employs deep learning algorithms to identify subtle anomalies in medical images that may be missed by human radiologists.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in image segmentation\"\n        }\n    ],\n    \"claims\": [\n        \"A method for analyzing medical images comprising...\",\n        \"A system for detecting anomalies in medical images...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The method of claim 1, wherein the artificial intelligence algorithm is a deep neural network.\",\n        \"The system of claim 2, further comprising a user interface for displaying the analysis results.\",\n        \"The method of claim 1, wherein the medical images are X-ray images.\",\n        \"The system of claim 2, further comprising a database storing medical image data.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68881", "text": "{\n    \"patent_title\": \"Improved MRI Coil Design for Enhanced Resolution\",\n    \"inventors\": [\n        {\n            \"name\": \"Eva Schmidt\",\n            \"affiliation\": \"Siemens Healthineers\"\n        },\n        {\n            \"name\": \"David Müller\",\n            \"affiliation\": \"University of Tübingen\"\n        }\n    ],\n    \"patent_number\": \"EP3456789A1\",\n    \"priority_date\": \"2022-01-15\",\n    \"filing_date\": \"2022-01-15\",\n    \"issue_date\": \"2023-07-20\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"This invention relates to a novel design for MRI coils that improves spatial resolution and signal-to-noise ratio in magnetic resonance imaging. The new coil geometry enables faster scanning times and clearer images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"relevance\": \"Related to MRI coil technology\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil comprising...\",\n        \"A method for generating an MRI signal...\",\n        \"The MRI coil of claim 1, wherein the coil is arranged in a phased array configuration.\",\n        \"The method of claim 2, further comprising filtering the MRI signal.\",\n        \"The MRI coil of claim 1, made of copper.\",\n        \"The method of claim 2, wherein the MRI signal is used to create a 3D image.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68882", "text": "{\n    \"patent_title\": \"Method and System for Efficient Image Denoising Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10458923B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-10-29\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for denoising digital images using a deep convolutional neural network. The network is trained to remove noise while preserving important image details, achieving superior performance compared to traditional denoising techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876789B1\"\n        },\n        {\n            \"patent_number\": \"US10234567B2\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        },\n        {\n            \"patent_number\": \"US9546789B2\"\n        },\n        {\n            \"patent_number\": \"US10345678B2\"\n        },\n        {\n            \"patent_number\": \"US10678901B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for denoising a digital image...\",\n        \"A system comprising a deep convolutional neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68882", "text": "{\n    \"patent_title\": \"Complex Adaptive Filtering for High-Resolution Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"David Donoho\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Ingrid Daubechies\",\n            \"affiliation\": \"Duke University\"\n        }\n    ],\n    \"patent_number\": \"US8987654B2\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2015-03-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An adaptive filtering technique utilizing advanced mathematical transforms and optimization algorithms for reconstructing high-resolution images from low-resolution inputs. The method employs complex wavelet analysis and iterative refinement procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        },\n        {\n            \"patent_number\": \"US8213456B2\"\n        },\n        {\n            \"patent_number\": \"US8567890B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a high-resolution image...\",\n        \"An adaptive filter comprising a complex wavelet transform module...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68883", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging Technique for Enhanced Tissue Contrast\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Chen\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel magnetic resonance imaging (MRI) technique utilizing pulsed gradients and optimized radiofrequency pulse sequences to enhance tissue contrast and improve the detection of subtle pathological changes. The method provides clearer images without the need for contrast agents.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"MRI Pulse Sequence Optimization\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing magnetic resonance imaging...\",\n        \"The method of claim 1, wherein the tissue contrast is enhanced...\",\n        \"A system for performing magnetic resonance imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68883", "text": "{\n    \"patent_title\": \"AI-Powered Diagnostic System for Early Cancer Detection in Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2022-11-10\",\n    \"filing_date\": \"2022-11-10\",\n    \"issue_date\": \"2024-05-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a diagnostic system that employs deep learning algorithms to analyze medical images (X-rays, CT scans, MRIs) for the early detection of cancerous tumors. The system achieves high accuracy through automated feature extraction and classification.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"title\": \"Deep Learning in Medical Image Analysis\"\n        }\n    ],\n    \"claims\": [\n        \"A computer-implemented method for diagnosing cancer...\",\n        \"The method of claim 1, wherein the deep learning model is trained...\",\n        \"A system comprising a processor and memory...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68884", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method for enhancing the clarity and contrast of medical images, enabling more accurate diagnosis of various diseases. It utilizes advanced filtering techniques without relying on complex machine learning algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing medical images comprising...\",\n        \"A system for implementing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68884", "text": "{\n    \"patent_title\": \"Deep Learning Based Image Segmentation for Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of Cambridge\"\n        }\n    ],\n    \"patent_number\": \"EP3210987B1\",\n    \"priority_date\": \"2020-08-22\",\n    \"filing_date\": \"2020-08-22\",\n    \"issue_date\": \"2022-04-01\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"A deep learning algorithm for precise segmentation of tumors in medical images, significantly improving diagnostic accuracy.  Utilizes convolutional neural networks for automated analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10987654B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for tumor segmentation using deep learning...\",\n        \"A system implementing the deep learning algorithm...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68885", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable biosensor for continuous glucose monitoring. The device utilizes a novel enzymatic reaction and a microfluidic channel to accurately measure glucose levels in real-time.  The sensor is designed for long-term implantation and wireless data transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable biosensor comprising...\",\n        \"A method for continuous glucose monitoring using...\",\n        \"A system for wireless data transmission...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68885", "text": "{\n    \"patent_title\": \"Improved Scalpel Handle Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Medical Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2022-07-01\",\n    \"filing_date\": \"2022-09-10\",\n    \"issue_date\": \"2024-02-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved scalpel handle design providing enhanced grip and control for surgical procedures. The handle incorporates a textured surface and ergonomic shape.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"similar_art\"\n        }\n    ],\n    \"claims\": [\n        \"A scalpel handle comprising a textured surface...\",\n        \"An ergonomic scalpel handle design...\",\n        \"A surgical instrument incorporating the scalpel handle...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68886", "text": "{\n    \"patent_title\": \"Method and System for Accelerated Magnetic Resonance Imaging using Compressed Sensing\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method and system for significantly accelerating magnetic resonance imaging (MRI) acquisition times using compressed sensing techniques. The approach incorporates advanced reconstruction algorithms to produce high-quality images from undersampled data, reducing scan times without compromising image resolution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8236221B2\",\n            \"kind\": \"Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing magnetic resonance imaging comprising...\",\n        \"A system for performing magnetic resonance imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68886", "text": "{\n    \"patent_title\": \"Improved MRI Image Quality Using Gadolinium-Based Contrast Agents\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Miller\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10450123B1\",\n    \"priority_date\": \"2017-02-15\",\n    \"filing_date\": \"2017-02-15\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to improvements in magnetic resonance imaging (MRI) image quality achieved through the utilization of novel gadolinium-based contrast agents. These agents enhance image contrast, improving the detection of subtle anomalies. The invention also describes methods for optimizing the dosage of these agents for patient safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"kind\": \"Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent for use in magnetic resonance imaging...\",\n        \"A method for enhancing MRI image quality using said contrast agent...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68887", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable biosensor for continuous glucose monitoring using novel nanomaterial-based electrochemical sensing. Provides highly accurate and real-time glucose measurements with minimal invasiveness.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art related to glucose sensing technology\"\n        }\n    ],\n    \"claims\": [\n        \"A biosensor comprising a nanomaterial-based electrode...\",\n        \"A method for continuous glucose monitoring...\",\n        \"An implantable device for real-time glucose measurement...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68887", "text": "{\n    \"patent_title\": \"Improved Formulation for Existing Diabetes Medication\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Chen\",\n            \"affiliation\": \"Eli Lilly and Company\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved pharmaceutical formulation of metformin hydrochloride for enhanced bioavailability and patient compliance in treating type 2 diabetes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Original patent for metformin hydrochloride\"\n        }\n    ],\n    \"claims\": [\n        \"A pharmaceutical composition comprising metformin hydrochloride...\",\n        \"A method of treating type 2 diabetes...\",\n        \"A dosage form of metformin hydrochloride with increased bioavailability...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68888", "text": "{\n    \"patent_title\": \"Enhanced Resolution MRI Utilizing Artificial Intelligence\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2020-11-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for enhancing the resolution of Magnetic Resonance Images (MRI) using deep learning algorithms. The invention improves diagnostic accuracy by reducing noise and artifacts in the images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on MRI image reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI resolution comprising...\",\n        \"A system for diagnosing medical conditions using enhanced MRI images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68888", "text": "{\n    \"patent_title\": \"Improved X-Ray Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"Siemens Healthineers\"\n        },\n        {\n            \"name\": \"Diana Garcia\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"EP3210987A1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2018-08-08\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"An X-ray imaging system with improved radiation shielding and reduced patient exposure. It offers clearer images with lower doses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related X-ray technology\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system with a radiation shield...\",\n        \"A method for reducing patient radiation exposure...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68889", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Pathogen Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for rapid and sensitive detection of pathogens in biological samples. The device utilizes novel surface chemistry and integrated optical detection for point-of-care diagnostics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for detecting a pathogen...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68889", "text": "{\n    \"patent_title\": \"Improved Catheter Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Medtronic Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2014-12-20\",\n    \"filing_date\": \"2014-12-20\",\n    \"issue_date\": \"2020-05-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel catheter design with improved flexibility and biocompatibility for minimally invasive procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising...\",\n        \"A method for inserting a catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68890", "text": "{\n    \"patent_title\": \"Microfluidic Device for Circulating Tumor Cell Isolation and Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-05-20\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for efficient isolation and analysis of circulating tumor cells (CTCs) from blood samples, enabling early cancer detection and personalized treatment monitoring.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for isolating CTCs...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68890", "text": "{\n    \"patent_title\": \"Novel Targeted Drug Delivery System for Cancer Therapy\",\n    \"inventors\": [\n        {\n            \"name\": \"Li Wei\",\n            \"affiliation\": \"Shanghai Institute of Materia Medica\"\n        }\n    ],\n    \"patent_number\": \"CN109876543A\",\n    \"priority_date\": \"2018-12-01\",\n    \"filing_date\": \"2019-01-10\",\n    \"issue_date\": \"2020-08-15\",\n    \"patent_office\": \"SIPO\",\n    \"abstract\": \"A targeted drug delivery system utilizing nanoparticles for enhanced therapeutic efficacy in cancer treatment.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\"\n        }\n    ],\n    \"claims\": [\n        \"A nanoparticle composition comprising...\",\n        \"A method for treating cancer using the nanoparticle composition...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68891", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging with Artificial Intelligence Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10500000B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-12-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method for enhancing the quality and speed of magnetic resonance imaging (MRI) through the application of artificial intelligence algorithms. The technique reduces noise and artifacts, leading to clearer images and faster scan times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8888888B2\",\n            \"title\": \"Prior Art MRI Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI images using AI.\",\n        \"An MRI system incorporating the described AI algorithms.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68891", "text": "{\n    \"patent_title\": \"New X-Ray Shielding Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9777777B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel shielding material for X-ray machines, reducing radiation exposure to patients and technicians.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7777777B2\",\n            \"title\": \"Existing X-Ray Shielding\"\n        }\n    ],\n    \"claims\": [\n        \"A shielding material with improved radiation absorption.\",\n        \"An X-ray machine utilizing the described shielding material.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68892", "text": "{\n    \"patent_title\": \"Enhanced Resolution Medical Imaging Using Deep Learning Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-07-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel deep learning algorithm for reconstructing medical images from raw data, resulting in significantly improved resolution and clarity. The algorithm is applicable to various imaging modalities including MRI and CT scans.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Prior Art Imaging System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for enhancing image resolution...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68892", "text": "{\n    \"patent_title\": \"Surgical Navigation System with Real-Time Image Guidance\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2023-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical navigation system provides real-time image guidance to surgeons during minimally invasive procedures. The system utilizes pre-operative imaging data and intra-operative tracking to enhance surgical precision.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"title\": \"Previous Surgical Guidance System\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical navigation system comprising...\",\n        \"A method for guiding a surgical instrument...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68893", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method and system for reconstructing medical images with improved clarity and resolution. The method utilizes advanced algorithms to reduce noise and enhance image details, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8652001B2\",\n            \"title\": \"Medical Image Processing System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for reconstructing a medical image comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68893", "text": "{\n    \"patent_title\": \"Radiation Dose Reduction Technique in Computed Tomography\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-07-20\",\n    \"filing_date\": \"2017-07-20\",\n    \"issue_date\": \"2020-10-13\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"The present invention provides a technique for significantly reducing the radiation dose delivered to patients during computed tomography scans while maintaining acceptable image quality. This is achieved through iterative reconstruction algorithms and optimized scanning protocols.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Low Dose CT Imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing radiation dose in CT imaging comprising...\",\n        \"A system for performing low-dose CT scans comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68894", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Recognition Using Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2021-11-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method and system for enhanced image recognition utilizing convolutional neural networks. The system effectively analyzes visual data, identifying patterns and objects with high accuracy. Deep learning algorithms are employed to improve feature extraction and classification, leading to superior performance in various image processing tasks.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for processing visual data...\",\n        \"A convolutional neural network configured to...\",\n        \"The method of claim 1, wherein the neural network...\",\n        \"The system of claim 2, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68894", "text": "{\n    \"patent_title\": \"Automated Medical Image Analysis System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Mayo Clinic\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details an automated system for analyzing medical images, specifically designed for detecting anomalies in X-rays and MRIs.  The system leverages deep learning techniques to improve diagnostic accuracy. This is targeted towards applications in radiology and cardiology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for medical image analysis...\",\n        \"A system for detecting anomalies in medical images...\",\n        \"The method of claim 1, wherein the images are X-rays...\",\n        \"The system of claim 2, configured for cardiology applications...\",\n        \"The method of claim 1, employing deep learning...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68895", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-12-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical system designed for minimally invasive procedures, utilizing advanced imaging techniques to enhance visualization and improve patient outcomes. The system incorporates robotic assistance and real-time feedback to reduce surgical error and recovery time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related imaging technology\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising a robotic arm...\",\n        \"A method for performing a minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68895", "text": "{\n    \"patent_title\": \"Improved Gear Mechanism for Surgical Instruments\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Robotics\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2018-11-01\",\n    \"issue_date\": \"2020-09-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved gear mechanism for surgical instruments, enhancing the precision and durability of manual surgical tools. The design incorporates a novel tooth profile to reduce friction and wear.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art gear mechanism\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related mechanical design\"\n        },\n        {\n            \"patent_number\": \"US9765432B2\",\n            \"relevance\": \"Similar gear tooth profile\"\n        }\n    ],\n    \"claims\": [\n        \"A gear mechanism comprising a plurality of teeth...\",\n        \"A surgical instrument incorporating the gear mechanism...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68896", "text": "{\n    \"patent_title\": \"Enhanced Magnetic Resonance Imaging using Compressed Sensing\",\n    \"inventors\": [\n        {\n            \"name\": \"David A. Wilson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Maria Rodriguez\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2019-07-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for accelerating MRI scans using compressed sensing algorithms, improving image quality and reducing scan time. Builds upon established MRI principles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8456789B2\",\n            \"relevance\": \"Prior art on compressed sensing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images...\",\n        \"A system comprising a MRI scanner and a processing unit...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68896", "text": "{\n    \"patent_title\": \"Novel Cancer Therapy Using Genetically Modified Viruses\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10243216B1\",\n    \"priority_date\": \"2018-11-15\",\n    \"filing_date\": \"2018-11-15\",\n    \"issue_date\": \"2020-03-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A revolutionary cancer treatment utilizing genetically modified oncolytic viruses to selectively destroy tumor cells, triggering a robust immune response and leading to complete remission in preclinical models. This approach represents a paradigm shift in oncology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related viral therapy research\"\n        }\n    ],\n    \"claims\": [\n        \"A genetically modified oncolytic virus...\",\n        \"A method for treating cancer comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68897", "text": "{\n    \"patent_title\": \"MRI Enhancement Using Artificial Intelligence for Improved Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing Magnetic Resonance Imaging (MRI) scans using artificial intelligence algorithms to improve the detection of tumors and other anomalies. The system utilizes deep learning to reduce noise and enhance image clarity, leading to more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI images comprising...\",\n        \"A system for tumor detection using AI-enhanced MRI scans...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68897", "text": "{\n    \"patent_title\": \"Digital X-Ray Enhancement System with Reduced Radiation Dosage\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2017-09-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved digital X-ray system designed to minimize radiation exposure while maintaining high image quality. The system incorporates advanced filtering techniques and image processing algorithms to reduce noise and enhance contrast.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A digital X-ray system comprising...\",\n        \"A method for reducing radiation dosage in X-ray imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68898", "text": "{\n    \"patent_title\": \"Method and System for Automated Tumor Detection in MRI Images Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-04-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for automated tumor detection in Magnetic Resonance Imaging (MRI) images using deep learning techniques. The system employs a convolutional neural network (CNN) trained on a large dataset of MRI images to identify and classify tumors with high accuracy. This technology aims to assist radiologists in improving diagnostic efficiency and reducing errors.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in MRI image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for automated tumor detection in MRI images comprising...\",\n        \"A system for classifying tumors based on MRI data using a CNN...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68898", "text": "{\n    \"patent_title\": \"Improved Stent Design for Coronary Artery Disease\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2018-05-20\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved stent design for treating coronary artery disease. The stent features a novel expandable structure and biocompatible coating to minimize the risk of restenosis. The design optimizes blood flow and reduces the potential for complications associated with conventional stents.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous stent designs\"\n        }\n    ],\n    \"claims\": [\n        \"A stent comprising an expandable structure...\",\n        \"A biocompatible coating for use with a stent...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68899", "text": "{\n    \"patent_title\": \"Miniaturized Ultrasonic Sensor System for Continuous Blood Pressure Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-01-20\",\n    \"issue_date\": \"2021-12-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized ultrasonic sensor system is disclosed for continuous, non-invasive blood pressure monitoring. The system utilizes advanced signal processing techniques to accurately determine blood pressure without arterial puncture.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on blood pressure measurement\"\n        }\n    ],\n    \"claims\": [\n        \"A system for non-invasive blood pressure monitoring comprising: an ultrasonic transducer...\",\n        \"A method for continuously monitoring blood pressure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68899", "text": "{\n    \"patent_title\": \"Optical Pulse Oximeter with Enhanced Signal Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Eve Garcia\",\n            \"affiliation\": \"University of Michigan\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-03-10\",\n    \"filing_date\": \"2019-08-01\",\n    \"issue_date\": \"2020-05-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An optical pulse oximeter is disclosed with improved signal processing algorithms for accurate measurement of blood oxygen saturation. The device utilizes red and infrared light to determine oxygen levels.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Existing pulse oximetry technology\"\n        }\n    ],\n    \"claims\": [\n        \"A pulse oximeter comprising: a light source for emitting red and infrared light...\",\n        \"A method for measuring blood oxygen saturation using optical signals...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68900", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-03-15\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A novel method for reconstructing medical images from raw data, utilizing advanced iterative algorithms and noise reduction techniques to significantly improve image clarity and diagnostic accuracy. This system can be applied to various imaging modalities, including MRI and CT scans.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Improved Noise Filtering in Medical Imaging\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Adaptive Reconstruction Algorithms for CT Scans\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising:...\",\n        \"An apparatus for performing the method of claim 1...\",\n        \"The method of claim 1, wherein the iterative algorithm includes a regularization term...\",\n        \"The apparatus of claim 2, further comprising a display for visualizing the reconstructed image...\",\n        \"A system for enhancing image clarity in medical imaging\"\n    ]\n}"}
{"_id": "Academic--patents--n--68900", "text": "{\n    \"patent_title\": \"Method for Magnetic Resonance Signal Acquisition\",\n    \"inventors\": [\n        {\n            \"name\": \"Franz Schmidt\",\n            \"affiliation\": \"Max Planck Institute\"\n        }\n    ],\n    \"patent_number\": \"EP3456789B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-08-05\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"A method for acquiring magnetic resonance signals, focused on optimizing the pulse sequence for increased signal-to-noise ratio. Primarily based on fundamental principles of nuclear magnetic resonance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"title\": \"Fundamentals of Nuclear Magnetic Resonance\"\n        },\n        {\n            \"patent_number\": \"DE102005012345A1\",\n            \"title\": \"Basic Principles of MRI Signal Processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for acquiring a magnetic resonance signal comprising...\",\n        \"The method of claim 1, wherein the pulse sequence is optimized for signal-to-noise ratio...\",\n        \"A magnetic resonance imaging apparatus adapted to perform the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68901", "text": "{\n    \"patent_title\": \"Enhanced MRI Contrast Agent for Improved Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel MRI contrast agent utilizing nanoparticle technology to significantly enhance tumor detection capabilities. The agent exhibits increased signal intensity and improved biocompatibility, leading to more accurate diagnostic imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8545678B1\",\n            \"relevance\": \"Prior art relating to nanoparticle synthesis\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising nanoparticles...\",\n        \"A method for imaging tumors using the contrast agent...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68901", "text": "{\n    \"patent_title\": \"Improved CT Scanning Protocol for Lung Nodule Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Li Wei\",\n            \"affiliation\": \"Huazhong University of Science and Technology\"\n        }\n    ],\n    \"patent_number\": \"CN108765432B\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-02-10\",\n    \"patent_office\": \"SIPO\",\n    \"abstract\": \"This invention describes a new CT scanning protocol optimized for detecting small lung nodules. The protocol uses iterative reconstruction techniques to reduce noise and improve image clarity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art regarding iterative reconstruction algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"A CT scanning protocol comprising iterative reconstruction...\",\n        \"A method for detecting lung nodules using the protocol...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68902", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical Device with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2022-05-15\",\n    \"filing_date\": \"2021-11-20\",\n    \"issue_date\": \"2023-02-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel minimally invasive surgical device incorporating advanced fiber optic technology and image processing algorithms to provide surgeons with significantly enhanced visualization during complex procedures. The device offers improved precision, reduced patient trauma, and faster recovery times compared to conventional laparoscopic techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on laparoscopic instrumentation.\"\n        }\n    ],\n    \"claims\": [\n        \"A minimally invasive surgical device comprising...\",\n        \"A method for performing a surgical procedure using the device...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68902", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Portable Electronics\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"TechCorp Industries\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2021-08-10\",\n    \"filing_date\": \"2020-12-05\",\n    \"issue_date\": \"2022-07-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved lithium-ion battery technology offering increased energy density and cycle life for use in portable electronic devices. The battery incorporates a novel electrolyte formulation and electrode material composition.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on lithium-ion battery electrolytes.\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte formulation for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68903", "text": "{\n    \"patent_title\": \"Improved MRI Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2020-12-08\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"This invention provides a novel method for reconstructing Magnetic Resonance Images (MRI) using a deep learning approach. The method improves image quality and reduces scan time. Contrast agents are used to enhance visualization of specific tissues.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"MRI Reconstruction Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images...\",\n        \"A system comprising a deep learning module...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68903", "text": "{\n    \"patent_title\": \"Enhanced X-Ray Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"University of Madrid\"\n        }\n    ],\n    \"patent_number\": \"EP3456789A1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"An improved X-ray imaging system for detecting bone fractures. The system utilizes a new sensor technology to improve image resolution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"X-Ray Imaging Improvements\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising a sensor...\",\n        \"A method for detecting bone fractures...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68904", "text": "{\n    \"patent_title\": \"Novel Image Enhancement Technique for Low-Dose CT Scans\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-11-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-09-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image enhancement technique for reducing noise and artifacts in low-dose computed tomography (CT) scans, improving diagnostic accuracy while minimizing radiation exposure. The method employs a deep learning-based approach to reconstruct high-quality images from limited data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image denoising\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image...\",\n        \"A system for processing CT scan data...\",\n        \"A computer-readable medium...\",\n        \"A method comprising the steps of...\",\n        \"The method of claim 1, wherein...\",\n        \"The system of claim 2, further comprising...\",\n        \"The computer-readable medium of claim 3, storing...\",\n        \"The method of claim 4, wherein...\",\n        \"The method of claim 5, wherein...\",\n        \"The system of claim 6, wherein...\",\n        \"The method of claim 7, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68904", "text": "{\n    \"patent_title\": \"Method for Improving Color Contrast in Digital Photographs\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Independent Consultant\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-08-01\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-03-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for automatically adjusting color contrast in digital photographs to improve visual appeal. The method analyzes the histogram of the image and applies a non-linear transformation to enhance contrast.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related to color correction algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"A method for adjusting color contrast...\",\n        \"A system for processing digital images...\",\n        \"A computer program...\",\n        \"The method of claim 1, wherein...\",\n        \"The system of claim 2, further comprising...\",\n        \"The program of claim 3, executing...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68905", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Point-of-Care Diagnostics\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11254321B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-12-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel microfluidic device enabling rapid, point-of-care diagnostics. The device integrates a unique polymer-based microchannel design with advanced surface functionalization techniques to enhance biomarker detection sensitivity and specificity. The fabrication process utilizes a novel soft lithography approach, significantly reducing manufacturing costs. This device represents a fundamental shift in diagnostic capabilities, moving away from centralized laboratory testing towards decentralized, patient-side analysis. It incorporates a new type of biosensor material offering significantly improved stability and accuracy compared to existing methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in microfluidic device design\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising a polymer-based microchannel network.\",\n        \"The device of claim 1, wherein the polymer is PDMS.\",\n        \"A method for detecting biomarkers using the device of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68905", "text": "{\n    \"patent_title\": \"Improved Catheter Tip Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"MedTech Solutions Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2022-07-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved catheter tip design for enhanced fluid delivery. The tip features a modified geometry to reduce flow resistance and improve patient comfort. The design represents a minor improvement to existing catheter tip technology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Existing catheter tip designs\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter tip with a modified conical geometry.\",\n        \"The catheter tip of claim 1, made from polyurethane.\",\n        \"A method of using the catheter tip for fluid delivery.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68906", "text": "{\n    \"patent_title\": \"Method and System for Enhanced MRI Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for reconstructing Magnetic Resonance Images (MRI) with improved resolution and reduced artifacts. The method utilizes a deep learning algorithm to enhance image quality, leading to more accurate diagnostic capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8766890B2\",\n            \"relevance\": \"Background art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"A system for performing MRI image reconstruction...\",\n        \"The method of claim 1, wherein the deep learning algorithm is a convolutional neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68906", "text": "{\n    \"patent_title\": \"Improved CT Scanner Calibration Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Karl Schmidt\",\n            \"affiliation\": \"Siemens Healthineers\"\n        },\n        {\n            \"name\": \"Eva Müller\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details an improved calibration technique for Computed Tomography (CT) scanners, resulting in more precise image reconstruction and reduced radiation dose. It builds upon existing Siemens scanner technology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Parent Patent\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"relevance\": \"Related Technology\"\n        }\n    ],\n    \"claims\": [\n        \"A method for calibrating a CT scanner comprising...\",\n        \"A CT scanner configured to perform the calibration method...\",\n        \"The calibration method of claim 1, utilizing a phantom for measurement.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68907", "text": "{\n    \"patent_title\": \"Miniature Robotic Surgical System with Enhanced Dexterity\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2023-12-26\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A miniature robotic surgical system designed for minimally invasive procedures, offering enhanced dexterity and precision. The system addresses the clinical need for less traumatic surgical interventions and faster patient recovery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Remote Surgical Control System\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system comprising a miniaturized robotic arm...\",\n        \"A method for performing minimally invasive surgery using the robotic system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68907", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anna Schmidt\",\n            \"affiliation\": \"Technical University of Munich\"\n        }\n    ],\n    \"patent_number\": \"EP3456789B1\",\n    \"priority_date\": \"2018-03-10\",\n    \"filing_date\": \"2018-03-10\",\n    \"issue_date\": \"2021-09-01\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"An improved surgical stapler designed for enhanced ergonomics and ease of use during surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Automated Surgical Stapling Device\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an ergonomic handle...\",\n        \"A stapling cartridge for use with the surgical stapler...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68908", "text": "{\n    \"patent_title\": \"Deep Learning Based Image Enhancement for Low-Light Photography\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-12-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing low-light images using a deep convolutional neural network. The network is trained to map low-light images to high-quality, visually appealing images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing a low-light image comprising...\",\n        \"The method of claim 1, wherein the neural network is a convolutional neural network.\",\n        \"An apparatus for enhancing a low-light image...\",\n        \"The apparatus of claim 3, further comprising...\",\n        \"A non-transitory computer-readable medium...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68908", "text": "{\n    \"patent_title\": \"Method for Improving JPEG Compression Ratio\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-08-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved JPEG compression algorithm that reduces file size while maintaining acceptable image quality. This is achieved through optimization of the discrete cosine transform (DCT) coefficients.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image comprising...\",\n        \"The method of claim 1, wherein the DCT coefficients are quantized...\",\n        \"An apparatus for compressing an image...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68909", "text": "{\n    \"patent_title\": \"Improved MRI Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing MRI images using deep convolutional neural networks, resulting in higher resolution and reduced scan time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"year\": 2018\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for implementing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68909", "text": "{\n    \"patent_title\": \"X-Ray Imaging System with Enhanced Contrast\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2014-12-01\",\n    \"filing_date\": \"2014-12-01\",\n    \"issue_date\": \"2017-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An X-ray imaging system with improved contrast sensitivity using a novel filter.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US5432109B1\",\n            \"year\": 1995\n        },\n        {\n            \"patent_number\": \"US6789012B1\",\n            \"year\": 2002\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A filter for enhancing contrast...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68910", "text": "{\n    \"patent_title\": \"Magnetic Resonance Imaging with Compressed Sensing and Deep Learning Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-11-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel method for magnetic resonance imaging (MRI) reconstruction utilizing compressed sensing and deep learning techniques.  The method significantly reduces scan time while maintaining high image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Background on Compressed Sensing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for MRI reconstruction comprising...\",\n        \"A system for performing MRI utilizing...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68910", "text": "{\n    \"patent_title\": \"Improved X-Ray Imaging System with Digital Subtraction Angiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2017-12-20\",\n    \"filing_date\": \"2017-12-20\",\n    \"issue_date\": \"2020-07-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved X-ray imaging system that incorporates digital subtraction angiography for enhanced visualization of blood vessels.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art related to X-ray DSA\"\n        },\n        {\n            \"patent_number\": \"US9123456B1\",\n            \"relevance\": \"Related X-ray technology\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A method for performing digital subtraction angiography...\",\n        \"A digital image processing module...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68911", "text": "{\n    \"patent_title\": \"Improved Low-Dose Computed Tomography Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11256789B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2023-11-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel computed tomography (CT) imaging system utilizing advanced iterative reconstruction algorithms and a photon-counting detector to significantly reduce radiation dose while maintaining high image quality. It improves diagnostic accuracy in detecting subtle pulmonary nodules.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing radiation dose in CT imaging.\",\n        \"An imaging system comprising a photon-counting detector.\",\n        \"A method for improving detection of pulmonary nodules.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68911", "text": "{\n    \"patent_title\": \"Contrast Enhancement Technique for Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10876543B1\",\n    \"priority_date\": \"2020-01-20\",\n    \"filing_date\": \"2020-01-20\",\n    \"issue_date\": \"2023-05-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new contrast agent for magnetic resonance imaging (MRI) that enhances visualization of blood vessels and tumors. It improves diagnostic capability in cardiovascular disease.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9235789B2\"\n        },\n        {\n            \"patent_number\": \"US11000001B2\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent for MRI.\",\n        \"A method for enhancing blood vessel visualization.\",\n        \"A method for detecting tumors using MRI.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68912", "text": "{\n    \"patent_title\": \"Enhanced MRI Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10543217B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2020-01-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel deep learning approach for reconstructing Magnetic Resonance Images (MRIs) with improved clarity and reduced noise. The method leverages convolutional neural networks to enhance image quality and reduce scan time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"MRI Image Denoising Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for enhancing MRI image clarity using deep learning...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68912", "text": "{\n    \"patent_title\": \"Improved X-ray Imaging System with Digital Subtraction Angiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US9234567B1\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2018-08-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved X-ray imaging system incorporating digital subtraction angiography for enhanced visualization of blood vessels. The system provides high-resolution images and reduced radiation exposure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"title\": \"Digital Subtraction Angiography Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A method for performing digital subtraction angiography...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68913", "text": "{\n    \"patent_title\": \"Surgical Robotic System with Enhanced Precision Control\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Chen\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-11-20\",\n    \"issue_date\": \"2022-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical robotic system incorporating force feedback and advanced image guidance for enhanced precision in minimally invasive procedures. The system utilizes novel algorithms to improve surgical outcomes and reduce patient recovery time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Minimally Invasive Surgical Instrument\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Image-Guided Surgery System\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic system comprising...\",\n        \"A method for performing minimally invasive surgery...\",\n        \"A control system for precise robotic movements...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68913", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Vascular Access\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2020-01-05\",\n    \"filing_date\": \"2020-07-10\",\n    \"issue_date\": \"2023-04-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new catheter design optimized for vascular access, reducing insertion trauma and improving flow rates.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Vascular Access Device\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising...\",\n        \"A method for accessing a blood vessel...\",\n        \"A distal tip configuration for reduced trauma...\",\n        \"A method for measuring flow rate...\",\n        \"A method for controlling fluid delivery...\",\n        \"A method for visualizing the catheter tip...\",\n        \"A control system for regulating pressure...\",\n        \"A system for detecting obstructions...\",\n        \"A method for preventing clotting...\",\n        \"A sensor for detecting vessel diameter...\",\n        \"A method for guiding the catheter...\",\n        \"A coating for biocompatibility...\",\n        \"A connection for fluid infusion...\",\n        \"A mechanism for retracting the catheter...\",\n        \"A housing for the catheter components...\",\n        \"A sterilization method...\",\n        \"A method for reducing air bubbles...\",\n        \"A calibration method...\",\n        \"A method for preventing kinking...\",\n        \"A diagnostic system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68914", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Sensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Chen\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-07-20\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable sensor for continuous glucose monitoring, utilizing a novel biocompatible material and wireless communication protocol. This device provides highly accurate and real-time glucose readings with minimal invasiveness.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"prior art\"\n        },\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"related art\"\n        },\n        {\n            \"patent_number\": \"US11000001B2\",\n            \"relevance\": \"influential work\"\n        },\n        {\n            \"patent_number\": \"US11111111B2\",\n            \"relevance\": \"further development\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable sensor comprising...\",\n        \"A method for continuous glucose monitoring using the sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68914", "text": "{\n    \"patent_title\": \"Improved Syringe Design for Subcutaneous Injections\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Davis\",\n            \"affiliation\": \"Johnson & Johnson\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2021-09-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved syringe design for subcutaneous injections, featuring a needle retraction mechanism and ergonomic grip. The syringe aims to reduce injection pain and improve patient safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"prior art\"\n        },\n        {\n            \"patent_number\": \"US9654321B1\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A syringe comprising a retractable needle...\",\n        \"A method for administering a subcutaneous injection...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68915", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction Method for Positron Emission Tomography\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image reconstruction algorithm for positron emission tomography (PET) is presented, improving image quality and diagnostic accuracy by reducing noise and artifacts. The method utilizes a Bayesian framework and incorporates prior information to enhance the reconstruction process.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Prior Art PET Reconstruction Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an image from PET data comprising...\",\n        \"The method of claim 1, further comprising...\",\n        \"A system for performing the method of claim 1...\",\n        \"The system of claim 3, wherein...\",\n        \"The method of claim 2, wherein the prior information...\",\n        \"The method of claim 1, wherein the noise reduction...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68915", "text": "{\n    \"patent_title\": \"Coil Design for Enhanced MRI Signal\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"GE Healthcare\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"GE Global Research\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-09-20\",\n    \"filing_date\": \"2017-09-20\",\n    \"issue_date\": \"2020-07-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved radiofrequency (RF) coil design for magnetic resonance imaging (MRI) is disclosed. The coil provides increased signal-to-noise ratio, leading to faster scan times and improved image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Traditional MRI Coil Design\"\n        }\n    ],\n    \"claims\": [\n        \"An RF coil for MRI comprising...\",\n        \"The RF coil of claim 1, wherein...\",\n        \"A method for using the RF coil of claim 1...\",\n        \"The method of claim 3, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68916", "text": "{\n    \"patent_title\": \"Enhanced Clarity Medical Imaging System Utilizing Novel Reconstruction Algorithms\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-05-20\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel medical imaging system employing advanced reconstruction algorithms to significantly enhance image clarity and resolution, resulting in improved diagnostic capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A medical imaging system comprising...\",\n        \"A method for reconstructing medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68916", "text": "{\n    \"patent_title\": \"Automated Image Acquisition System for Veterinary Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Animal Health Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2018-01-15\",\n    \"issue_date\": \"2020-07-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for acquiring medical images in veterinary settings, focusing on efficiency and ease of use.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A veterinary imaging system comprising...\",\n        \"A method for automated image capture...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68917", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Medical Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Robert Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2017-05-15\",\n    \"issue_date\": \"2019-01-29\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing medical images from raw data, improving image quality and reducing radiation dose. This technique utilizes advanced algorithms to enhance image clarity and provides more accurate diagnostic information.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"relevance\": \"Prior art in image reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"A system for implementing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68917", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10456789B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2018-11-01\",\n    \"issue_date\": \"2020-04-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new contrast agent formulation for MRI that enhances image contrast and improves the detection of subtle abnormalities. The formulation is designed for improved biocompatibility and prolonged circulation time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art in contrast agent development\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent formulation comprising...\",\n        \"A method for using the contrast agent...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68918", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Electrolyte for Improved Cycle Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel lithium-ion battery featuring an enhanced electrolyte composition, resulting in significantly improved cycle life and energy density. The electrolyte includes a blend of organic carbonates and a lithium salt additive, enhancing ionic conductivity and reducing dendrite formation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        },\n        {\n            \"patent_number\": \"US11223344B2\"\n        },\n        {\n            \"patent_number\": \"CN109876543A\"\n        },\n        {\n            \"patent_number\": \"EP3456789A1\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrolyte composition...\",\n        \"The battery of claim 1, wherein the electrolyte composition...\",\n        \"A method for manufacturing the lithium-ion battery of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68918", "text": "{\n    \"patent_title\": \"Improved Lead-Acid Battery for Automotive Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"University of Detroit\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2023-02-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a modification to lead-acid battery construction, enhancing its cold-cranking performance and longevity in automotive environments. It involves a novel grid alloy and separator design.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        },\n        {\n            \"patent_number\": \"US8543210B1\"\n        },\n        {\n            \"patent_number\": \"US9432109B2\"\n        }\n    ],\n    \"claims\": [\n        \"A lead-acid battery comprising a grid alloy...\",\n        \"The battery of claim 1, wherein the grid alloy...\",\n        \"A method for manufacturing the lead-acid battery of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68919", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Drug Delivery System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11567890B2\",\n    \"priority_date\": \"2022-05-15\",\n    \"filing_date\": \"2022-05-16\",\n    \"issue_date\": \"2023-03-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable system for controlled drug delivery, utilizing microfluidic technology and biocompatible materials for targeted therapeutic intervention.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"Related background art\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable drug delivery system...\",\n        \"The system comprising a microfluidic pump...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68919", "text": "{\n    \"patent_title\": \"Improved Syringe Design\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Independent Inventor\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2021-11-01\",\n    \"filing_date\": \"2021-11-02\",\n    \"issue_date\": \"2022-08-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved syringe design with enhanced ergonomic features for easier and more accurate medication administration.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US4500000A\",\n            \"relevance\": \"Prior art reference\"\n        }\n    ],\n    \"claims\": [\n        \"A syringe comprising an ergonomic barrel...\",\n        \"The syringe further including a plunger...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68920", "text": "{\n    \"patent_title\": \"Novel Electrolyte Composition for Enhanced Lithium-Ion Battery Performance\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Jian Li\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2022-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel electrolyte composition for lithium-ion batteries comprising a unique blend of solvents and lithium salts, resulting in improved ionic conductivity, enhanced thermal stability, and increased cycle life. This invention represents a significant advancement in battery technology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on electrolyte formulations.\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrolyte comprising...\",\n        \"The electrolyte of claim 1, wherein the ionic conductivity is increased by at least 20%...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68920", "text": "{\n    \"patent_title\": \"Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Miller\",\n            \"affiliation\": \"Tesla, Inc.\"\n        },\n        {\n            \"name\": \"Sarah Chen\",\n            \"affiliation\": \"Tesla, Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-08-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) for electric vehicles, designed to optimize battery performance and safety. The BMS monitors cell voltages, temperatures, and currents to prevent overcharging, over-discharging, and thermal runaway.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art on BMS algorithms.\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"The BMS of claim 1, wherein the system includes a thermal management module...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68921", "text": "{\n    \"patent_title\": \"Method for Enhancing Contrast in Low-Dose CT Scans\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-08-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for enhancing image contrast in computed tomography (CT) scans while utilizing a significantly reduced radiation dose. The method employs advanced image processing algorithms to reconstruct high-quality images from limited data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in CT image reconstruction.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing contrast in CT scans.\",\n        \"A method for reducing radiation exposure in CT scans.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68921", "text": "{\n    \"patent_title\": \"Medical Imaging System for Real-time Diagnostics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A comprehensive medical imaging system designed for real-time diagnostic applications. The system integrates multiple imaging modalities to provide a holistic view of the patient's condition.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related to real-time image processing.\"\n        }\n    ],\n    \"claims\": [\n        \"A medical imaging system for real-time diagnostics.\",\n        \"A system integrating multiple imaging modalities.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68922", "text": "{\n    \"patent_title\": \"Enhanced Magnetic Resonance Imaging for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2023-10-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel magnetic resonance imaging (MRI) technique utilizing contrast agents with targeted molecular probes for the early detection of cancerous tumors. The improved signal-to-noise ratio and enhanced image resolution allow for the identification of smaller lesions than previously possible, enabling earlier diagnosis and improved patient outcomes. The technique also incorporates an AI-powered analysis module to assist in the interpretation of the MRI scans.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art in MRI contrast agents\"\n        }\n    ],\n    \"claims\": [\n        \"A method for early cancer detection comprising...\",\n        \"An MRI contrast agent capable of...\",\n        \"A system for analyzing MRI images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68922", "text": "{\n    \"patent_title\": \"Improved X-Ray Shielding Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2023-05-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new shielding material for X-ray devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art in X-ray shielding\"\n        }\n    ],\n    \"claims\": [\n        \"A shielding material comprising...\",\n        \"An X-ray device incorporating...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68923", "text": "{\n    \"patent_title\": \"MRI-Based Tumor Segmentation Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for automated tumor segmentation in MRI images using a convolutional neural network. The system provides accurate and efficient segmentation, aiding in early diagnosis and treatment planning.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for segmenting tumors in MRI images comprising...\",\n        \"A system for automated tumor detection...\",\n        \"A non-transitory computer-readable medium...\",\n        \"The method of claim 1, wherein the MRI images are three-dimensional.\",\n        \"The system of claim 2, further comprising a display module.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68923", "text": "{\n    \"patent_title\": \"Improved X-Ray Image Enhancement Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2017-03-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a new algorithm for enhancing the contrast and clarity of X-ray images. The technique reduces noise and improves visualization of subtle anatomical details.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related X-ray imaging technology\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing X-ray images comprising...\",\n        \"An apparatus for processing X-ray images...\",\n        \"A computer program for implementing the method of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68924", "text": "{\n    \"patent_title\": \"Deep Learning Enhanced MRI Reconstruction for Improved Diagnostic Accuracy\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel MRI reconstruction technique utilizing deep convolutional neural networks to enhance image clarity and reduce artifacts, leading to improved diagnostic accuracy. The system incorporates machine learning algorithms to optimize image parameters and minimize noise, resulting in significantly sharper and more informative images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"MRI Image Reconstruction using Compressed Sensing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising:...\",\n        \"A system for enhancing MRI image clarity using deep learning...\",\n        \"A computer-readable medium storing instructions for...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68924", "text": "{\n    \"patent_title\": \"Improved X-ray Imaging System with Enhanced Contrast\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2020-07-01\",\n    \"filing_date\": \"2020-07-01\",\n    \"issue_date\": \"2022-09-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an improved X-ray imaging system with enhanced contrast and reduced radiation exposure. The system utilizes a novel detector array and image processing algorithms to produce clearer X-ray images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\",\n            \"title\": \"Digital X-ray Imaging System\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising:...\",\n        \"A detector array for capturing X-ray images...\",\n        \"A method for enhancing contrast in X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68925", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical Robot with Haptic Feedback\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-06-15\",\n    \"issue_date\": \"2022-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A robotic surgical system providing enhanced precision and haptic feedback for minimally invasive procedures. The system utilizes micro-actuators and advanced control algorithms to improve surgical outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic system comprising...\",\n        \"A haptic feedback module...\",\n        \"A control system for precise movements...\",\n        \"A method for performing minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68925", "text": "{\n    \"patent_title\": \"Improved MRI Coil for Enhanced Image Resolution\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-03-10\",\n    \"filing_date\": \"2020-04-10\",\n    \"issue_date\": \"2023-05-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved magnetic resonance imaging (MRI) coil design to enhance image resolution and signal-to-noise ratio. This coil features a novel configuration for improved sensitivity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Existing MRI coil technology\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil comprising...\",\n        \"A coil configuration...\",\n        \"A method for improving image resolution...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68926", "text": "{\n    \"patent_title\": \"Novel MRI Contrast Agent for Enhanced Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-07-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel MRI contrast agent composed of biocompatible nanoparticles designed to specifically target and enhance the visibility of tumor cells. The nanoparticles exhibit improved relaxivity and targeted delivery, leading to significantly enhanced tumor detection in preclinical models. The invention represents a significant advancement in medical imaging, potentially improving diagnostic accuracy and patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Similar contrast agent technology\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing tumor detection using a biocompatible nanoparticle.\",\n        \"A composition comprising a biocompatible nanoparticle and a targeting ligand.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68926", "text": "{\n    \"patent_title\": \"Improved X-Ray Image Processing Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2023-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An algorithm for enhancing the clarity of X-ray images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related image processing techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for improving the contrast of X-ray images.\",\n        \"A system for processing X-ray images using the aforementioned method.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68927", "text": "{\n    \"patent_title\": \"Ultrasound-guided Focused Ultrasound for Non-invasive Tumor Ablation\",\n    \"inventors\": [\n        {\n            \"name\": \"Eleanor Vance\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Chen\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-11-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for non-invasive tumor ablation using focused ultrasound guided by real-time ultrasound imaging. This technology allows for precise targeting and destruction of tumor tissue without surgical intervention.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Focused Ultrasound Surgical System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for non-invasive tumor ablation comprising...\",\n        \"A system for focused ultrasound guidance comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68927", "text": "{\n    \"patent_title\": \"Improved Gradient Coil Design for MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Williams\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-12-10\",\n    \"filing_date\": \"2019-12-10\",\n    \"issue_date\": \"2023-04-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved gradient coil design for magnetic resonance imaging (MRI) scanners, offering enhanced performance and reduced distortion. This patent focuses on optimizing the coil geometry to achieve faster scan times and improved image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"MRI Gradient Coil with Improved Shielding\"\n        }\n    ],\n    \"claims\": [\n        \"A gradient coil for MRI comprising...\",\n        \"A method for reducing distortion in MRI images using the improved gradient coil...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68928", "text": "{\n    \"patent_title\": \"Microfluidic Device for Targeted Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for precise and targeted drug delivery to cancerous tumors, improving therapeutic efficacy and reducing side effects.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on microfluidic channels.\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for targeted drug delivery using the device...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68928", "text": "{\n    \"patent_title\": \"Improved Imaging System for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-11-20\",\n    \"filing_date\": \"2022-11-20\",\n    \"issue_date\": \"2024-01-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An imaging system utilizing advanced algorithms for enhanced detection of cancerous cells in early stages.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related to image processing techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"An imaging system comprising...\",\n        \"A method for detecting cancer cells using the system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68929", "text": "{\n    \"patent_title\": \"AI-Enhanced MRI Reconstruction for Improved Diagnostic Accuracy\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2022-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for reconstructing Magnetic Resonance Images (MRI) using deep learning algorithms. The system significantly reduces scan time and improves image quality, leading to more accurate diagnoses. Artificial intelligence techniques are employed to address the ill-posed inverse problem inherent in MRI reconstruction.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Highly Relevant\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Relevant\"\n        },\n        {\n            \"patent_number\": \"US11456789B2\",\n            \"relevance\": \"Moderately Relevant\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for enhancing MRI image quality...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68929", "text": "{\n    \"patent_title\": \"Digital Radiography System with Improved Contrast\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-20\",\n    \"filing_date\": \"2018-11-20\",\n    \"issue_date\": \"2021-07-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new digital radiography system that provides improved contrast and reduced radiation exposure. The system uses advanced detectors and image processing techniques to enhance the quality of X-ray images. Focus is on improving signal-to-noise ratio in X-ray imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Highly Relevant\"\n        }\n    ],\n    \"claims\": [\n        \"A digital radiography system comprising...\",\n        \"A method for enhancing X-ray image contrast...\",\n        \"A detector array for capturing X-ray radiation...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68930", "text": "{\n    \"patent_title\": \"Miniature Wireless Physiological Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2023-11-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized, wireless physiological monitoring system for continuous tracking of vital signs, designed for remote patient monitoring and early detection of health anomalies. Addresses a critical need in managing chronic diseases.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in wireless sensor technology.\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless physiological monitoring system comprising...\",\n        \"A method for remote patient monitoring using the system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68930", "text": "{\n    \"patent_title\": \"Improved Dental Implant Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"University of California, Los Angeles\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-02-10\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2023-08-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel dental implant design featuring a textured surface to enhance osseointegration and long-term stability. Improves the success rate of dental implant procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous work on implant surface modifications.\"\n        }\n    ],\n    \"claims\": [\n        \"A dental implant comprising a textured surface...\",\n        \"A method for improving osseointegration using the implant...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68931", "text": "{\n    \"patent_title\": \"Improved MRI Reconstruction Technique for Enhanced Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for reconstructing MRI images with improved contrast and resolution, leading to enhanced detection of cancerous tumors. The technique employs a deep learning algorithm to reduce noise and artifacts, providing clinicians with clearer diagnostic images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"The method of claim 1, wherein the deep learning algorithm...\",\n        \"An MRI system configured to perform the method of claim 1...\",\n        \"The MRI system of claim 3, further comprising...\",\n        \"A computer-readable medium storing instructions for...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68931", "text": "{\n    \"patent_title\": \"Surgical Robot with Enhanced Imaging Capabilities\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-08-20\",\n    \"filing_date\": \"2017-08-20\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a surgical robot equipped with integrated imaging technology to provide real-time visualization during minimally invasive procedures. The robot's precise movements are guided by the imaging data, enabling surgeons to perform complex operations with increased accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art in surgical robotics\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robot comprising an imaging module...\",\n        \"The surgical robot of claim 1, wherein the imaging module...\",\n        \"A control system for operating the surgical robot...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68932", "text": "{\n    \"patent_title\": \"Non-Invasive Glucose Monitoring System Using Optical Coherence Tomography\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A non-invasive glucose monitoring system utilizing optical coherence tomography (OCT) and advanced signal processing techniques to analyze subcutaneous glucose levels. The system employs a novel algorithm to minimize noise and enhance signal clarity, providing accurate and real-time glucose readings without the need for blood samples.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"kind\": \"cited_by\"\n        }\n    ],\n    \"claims\": [\n        \"A method for non-invasively monitoring glucose levels...\",\n        \"A system comprising an OCT device...\",\n        \"An algorithm for processing OCT signals...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68932", "text": "{\n    \"patent_title\": \"Surgical Instrument with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An ergonomic surgical instrument designed to reduce strain on surgeons during long procedures. The instrument features an optimized handle and improved grip.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US4567890\",\n            \"kind\": \"cited_by\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising an ergonomic handle...\",\n        \"A grip configured for enhanced control...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68933", "text": "{\n    \"patent_title\": \"Enhanced MRI Image Reconstruction Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-09-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel deep learning framework for reconstructing high-resolution Magnetic Resonance Images (MRI) from undersampled k-space data. The method significantly reduces scan time and improves image quality, offering a breakthrough in MRI imaging. The reconstruction network is trained using a novel loss function that combines L1-norm and perceptual loss to achieve state-of-the-art results.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images...\",\n        \"A deep learning network for MRI reconstruction...\",\n        \"A system comprising a MRI scanner and a deep learning reconstruction module...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68933", "text": "{\n    \"patent_title\": \"Improved X-ray Imaging System with Reduced Radiation Dose\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2016-11-01\",\n    \"issue_date\": \"2019-05-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved X-ray imaging system that reduces patient exposure to harmful radiation. The system incorporates advanced filtering techniques and optimized detector designs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system with reduced radiation...\",\n        \"A method for filtering X-ray beams...\",\n        \"A detector for X-ray imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68934", "text": "{\n    \"patent_title\": \"Miniaturized Neural Stimulator for Chronic Pain Management\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized neural stimulator designed for the long-term management of chronic pain. The device utilizes low-intensity electrical pulses to modulate nerve activity, leading to improved patient quality of life and reduced reliance on opioid medications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in neural stimulation techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized neural stimulator comprising...\",\n        \"A method for treating chronic pain using...\",\n        \"The stimulator of claim 1, wherein the electrical pulses are...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68934", "text": "{\n    \"patent_title\": \"Improved Cardiac Pacemaker with Remote Monitoring Capabilities\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Emily Wilson\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-08-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An advanced cardiac pacemaker with integrated remote monitoring capabilities. The device allows for real-time assessment of cardiac function and personalized therapy adjustments, improving patient outcomes in individuals with heart rhythm disorders.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Existing cardiac pacemaker technology.\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiac pacemaker comprising...\",\n        \"A remote monitoring system for...\",\n        \"The pacemaker of claim 1, wherein the monitoring system transmits data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68935", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-05-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for increasing the resolution of digital images using deep convolutional neural networks. The system learns to map low-resolution images to high-resolution images, providing a significant improvement in image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Super-Resolution using Sparse Representation\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing the resolution of a digital image, comprising...\",\n        \"A system for enhancing the resolution of a digital image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68935", "text": "{\n    \"patent_title\": \"Medical Image Analysis System for Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2022-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for automatically detecting tumors in medical images, such as MRI and CT scans. The system uses advanced image processing techniques to identify potential tumors and provide diagnostic support to clinicians.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"title\": \"Automated Cancer Detection in Mammograms\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting tumors in a medical image, comprising...\",\n        \"A system for detecting tumors in a medical image...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68936", "text": "{\n    \"patent_title\": \"Enhanced Resolution MRI using Deep Learning Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the resolution of Magnetic Resonance Images (MRI) using deep learning reconstruction algorithms. This invention significantly improves image clarity and diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8785792B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI image resolution comprising...\",\n        \"A system for processing MRI data...\",\n        \"A computer-readable medium storing instructions...\",\n        \"Claim 4, wherein the deep learning model is a convolutional neural network...\",\n        \"Claim 5, wherein the enhancement improves the signal-to-noise ratio...\",\n        \"Claim 6, wherein the improved clarity allows for earlier disease detection...\",\n        \"Claim 7, wherein the method is applied to cardiac MRI images...\",\n        \"Claim 8, wherein the method is applied to brain MRI images...\",\n        \"Claim 9, wherein the resolution enhancement is at least 20%.\",\n        \"Claim 10, further comprising a user interface for visualizing the enhanced images.\",\n        \"Claim 11, wherein the deep learning model is trained on a dataset of MRI images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68936", "text": "{\n    \"patent_title\": \"Improved X-Ray Detection System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"EP3456789B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-06-01\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"An X-ray detection system with improved sensitivity and reduced radiation exposure. The system incorporates a novel sensor array.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray detection system comprising...\",\n        \"A sensor array for detecting X-ray photons...\",\n        \"A processing unit for converting the photon signals...\",\n        \"Claim 2, wherein the sensor array is a flat-panel detector.\",\n        \"Claim 3, wherein the processing unit filters noise from the signals.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68937", "text": "{\n    \"patent_title\": \"Method and System for Enhanced MRI Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-01-20\",\n    \"issue_date\": \"2022-07-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for reconstructing Magnetic Resonance Images (MRI) using deep learning techniques. This invention significantly improves image quality and reduces scan time, leading to enhanced diagnostic capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"related work\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"A system for performing MRI reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68937", "text": "{\n    \"patent_title\": \"Improved X-ray Image Enhancement Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2021-02-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an improved algorithm for enhancing the quality of X-ray images, particularly in low-dose scenarios. The algorithm uses adaptive filtering techniques to reduce noise and improve contrast.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"An algorithm for enhancing X-ray images comprising...\",\n        \"A system for implementing the X-ray image enhancement algorithm...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68938", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction Method for Computed Tomography\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an improved image reconstruction method for computed tomography (CT) scans, enhancing resolution and reducing artifacts compared to existing techniques. It builds upon the filtered back-projection algorithm to provide clearer images for diagnostic purposes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Computed Tomography Image Reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an image from projection data...\",\n        \"The method of claim 1, wherein the image resolution is enhanced...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68938", "text": "{\n    \"patent_title\": \"Novel Method for Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2021-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a completely new approach to magnetic resonance imaging (MRI) utilizing a novel pulse sequence and contrast agent. This provides unprecedented capabilities in soft tissue visualization.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A magnetic resonance imaging apparatus comprising...\",\n        \"A method for generating an MRI image using the apparatus of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68939", "text": "{\n    \"patent_title\": \"High-Resolution Magnetic Resonance Imaging Using Compressed Sensing\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method for high-resolution magnetic resonance imaging (MRI) using compressed sensing techniques. The method significantly reduces scan time while maintaining or improving image quality. The algorithm allows for the reconstruction of detailed images from limited data, making it ideal for clinical applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a high-resolution image from undersampled MRI data.\",\n        \"The method of claim 1, wherein the reconstruction algorithm utilizes compressed sensing.\",\n        \"A system for performing MRI using the method of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68939", "text": "{\n    \"patent_title\": \"Enhanced Medical Imaging with Targeted Contrast Agents\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method for enhancing medical imaging using targeted contrast agents. The contrast agents selectively bind to specific tissues, improving image clarity and diagnostic accuracy. This enables early detection of diseases and precise monitoring of treatment response.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing medical imaging using targeted contrast agents.\",\n        \"The method of claim 1, wherein the contrast agent comprises a nanoparticle.\",\n        \"A composition comprising a targeted contrast agent.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68940", "text": "{\n    \"patent_title\": \"Biodegradable Polymer Scaffold for Tissue Engineering\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-08-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A biodegradable polymer scaffold designed for enhanced tissue regeneration. The scaffold is composed of poly(lactic-co-glycolic acid) (PLGA) and incorporates growth factors to promote cell adhesion and proliferation, ultimately leading to improved patient outcomes in wound healing applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8652543B2\"\n        },\n        {\n            \"patent_number\": \"US9234789B2\"\n        }\n    ],\n    \"claims\": [\n        \"A biodegradable scaffold comprising PLGA.\",\n        \"The scaffold further comprising growth factors.\",\n        \"A method for promoting tissue regeneration using the scaffold.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68940", "text": "{\n    \"patent_title\": \"Surgical Stapler with Enhanced Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-15\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler designed for enhanced precision and user comfort during surgical procedures. The stapler features a redesigned handle and improved staple cartridge loading mechanism.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an ergonomic handle.\",\n        \"A staple cartridge loading mechanism.\",\n        \"A method for performing surgical stapling.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68941", "text": "{\n    \"patent_title\": \"Enhanced Contrast Medical Imaging Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method for enhancing contrast in medical images using a deep learning algorithm. The algorithm improves image clarity and allows for better detection of subtle anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing contrast in medical images...\",\n        \"A system for processing medical images...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The method of claim 1, wherein the medical image is a CT scan.\",\n        \"The method of claim 1, wherein the medical image is an MRI scan.\",\n        \"The method of claim 1, wherein the algorithm is a convolutional neural network.\",\n        \"The system of claim 2, further comprising a display device.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68941", "text": "{\n    \"patent_title\": \"Portable X-Ray Device with Digital Display\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2014-11-01\",\n    \"filing_date\": \"2014-11-01\",\n    \"issue_date\": \"2016-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A portable X-ray device with a digital display for immediate image viewing.  Suitable for field applications.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A portable X-ray device comprising...\",\n        \"A digital display connected to the X-ray device...\",\n        \"A power source for the device...\",\n        \"A housing for the device...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68942", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Minimally Invasive Angioplasty\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"11,234,567\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an improved catheter design for angioplasty procedures. It builds upon existing catheter technology by incorporating a flexible tip and enhanced visualization capabilities, leading to less invasive and more effective treatment of blocked arteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"10,123,456\",\n            \"kind\": \"Cited by Applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible distal tip...\",\n        \"A method for performing angioplasty...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68942", "text": "{\n    \"patent_title\": \"Novel Drug Delivery System for Cancer Treatment\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alan Turing\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"11,987,654\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2024-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a completely novel drug delivery system utilizing nanoparticles for targeted cancer therapy. The system overcomes limitations of existing chemotherapy methods by directly delivering medication to tumor cells, minimizing side effects.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"9,876,543\",\n            \"kind\": \"Cited by Examiner\"\n        },\n        {\n            \"patent_number\": \"10,456,789\",\n            \"kind\": \"Cited by Applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A nanoparticle composition comprising...\",\n        \"A method for treating cancer...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68943", "text": "{\n    \"patent_title\": \"Minimally Invasive Cardiac Valve Repair Device\",\n    \"inventors\": [\n        {\n            \"name\": \"David Alt\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel device for repairing cardiac valves using a minimally invasive catheter-based approach. The device allows for precise valve manipulation and repair without open-heart surgery, improving patient outcomes and reducing recovery time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on cardiac valve repair\"\n        }\n    ],\n    \"claims\": [\n        \"A method for repairing a cardiac valve comprising...\",\n        \"A device for minimally invasive cardiac valve repair...\",\n        \"The device comprising a catheter and a valve repair element...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68943", "text": "{\n    \"patent_title\": \"Drug-Eluting Stent with Biodegradable Polymer Coating\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Jones\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2020-11-15\",\n    \"filing_date\": \"2020-11-15\",\n    \"issue_date\": \"2022-08-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A drug-eluting stent comprising a biodegradable polymer coating for controlled drug release, preventing restenosis after percutaneous coronary intervention. Improves long-term patency rates.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art on drug-eluting stents\"\n        }\n    ],\n    \"claims\": [\n        \"A drug-eluting stent comprising...\",\n        \"A biodegradable polymer coating for controlled drug release...\",\n        \"A method for treating coronary artery disease using the stent...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68944", "text": "{\n    \"patent_title\": \"Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-15\",\n    \"filing_date\": \"2021-06-10\",\n    \"issue_date\": \"2023-03-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable biosensor for continuous glucose monitoring, providing real-time data transmission to a patient's mobile device. This improves diabetes management and patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Non-invasive Glucose Monitoring System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for continuously monitoring glucose levels in a patient.\",\n        \"An implantable biosensor with a wireless communication module.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68944", "text": "{\n    \"patent_title\": \"Cosmetic Skin Rejuvenation Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-12-15\",\n    \"issue_date\": \"2022-08-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A device for non-invasive skin rejuvenation, utilizing low-level laser therapy to reduce wrinkles and improve skin tone.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Laser Treatment for Skin Conditions\"\n        }\n    ],\n    \"claims\": [\n        \"A cosmetic device for reducing wrinkles.\",\n        \"A method for improving skin tone using laser therapy.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68945", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction Algorithm for MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel image reconstruction algorithm for magnetic resonance imaging (MRI) that significantly reduces scan time while maintaining high image quality. The algorithm leverages deep learning techniques to enhance image resolution and reduce noise, leading to improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"MRI Image Reconstruction using Compressed Sensing\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Deep Learning for Medical Image Analysis\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"The method of claim 1, wherein the deep learning model is trained on a dataset of...\",\n        \"A system for performing MRI image reconstruction comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68945", "text": "{\n    \"patent_title\": \"New Contrast Agent for X-Ray Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11123456B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-08-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel contrast agent for X-ray imaging that enhances the visibility of blood vessels. The contrast agent is composed of nanoparticles coated with a biocompatible polymer.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Contrast Agents for X-Ray Imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent for X-ray imaging comprising...\",\n        \"The contrast agent of claim 1, wherein the nanoparticles are composed of...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68946", "text": "{\n    \"patent_title\": \"Magnetic Resonance Image Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"US\",\n    \"abstract\": \"A novel deep learning approach for reconstructing magnetic resonance images with improved resolution and reduced scan time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing magnetic resonance images comprising...\",\n        \"A system for performing magnetic resonance imaging...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68946", "text": "{\n    \"patent_title\": \"Improved X-ray Imaging System with Digital Subtraction Angiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2016-05-20\",\n    \"filing_date\": \"2016-05-20\",\n    \"issue_date\": \"2018-11-13\",\n    \"patent_office\": \"US\",\n    \"abstract\": \"An X-ray imaging system that utilizes digital subtraction angiography for enhanced visualization of blood vessels.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A method for performing digital subtraction angiography...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68947", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Cancer Cell Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-08-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device is disclosed for rapid and accurate detection of cancer cells in a biological sample. The device utilizes a novel antibody-based capture method to enhance sensitivity and specificity, leading to improved patient diagnostics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\",\n            \"relevance\": \"Similar microfluidic technology\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for detecting cancer cells...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68947", "text": "{\n    \"patent_title\": \"Improved Stent Design for Coronary Artery Disease\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"UC San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2018-11-20\",\n    \"filing_date\": \"2020-07-15\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved stent design for treating coronary artery disease is disclosed. The stent features a novel coating material that reduces the risk of thrombosis and restenosis, improving patient outcomes related to cardiovascular health.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"relevance\": \"Previous stent designs\"\n        }\n    ],\n    \"claims\": [\n        \"A stent comprising...\",\n        \"A method for treating coronary artery disease...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68948", "text": "{\n    \"patent_title\": \"Enhanced MRI Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"This invention presents a novel deep learning approach to reconstruct Magnetic Resonance Images (MRIs) from undersampled k-space data. Compared to conventional iterative reconstruction methods, our approach significantly reduces scan time while maintaining or improving image quality. The deep neural network is trained to learn the complex mapping between undersampled k-space and high-resolution images.  Experimental results demonstrate a 30% reduction in scan time with minimal loss in diagnostic accuracy. The method proves particularly effective in enhancing image clarity for detecting subtle abnormalities. Further, the architecture can be generalized across different MRI sequences and body regions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8785123B2\",\n            \"relevance\": \"Prior art on compressed sensing MRI\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image...\",\n        \"A deep neural network configured to perform MRI reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68948", "text": "{\n    \"patent_title\": \"Improved X-Ray Image Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"EP2876543A1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2015-11-20\",\n    \"issue_date\": \"2016-04-06\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"A system for enhancing the contrast of X-ray images using a simple filtering algorithm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related to image sharpening techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A system for processing X-ray images...\",\n        \"A method for enhancing contrast in X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68949", "text": "{\n    \"patent_title\": \"Novel Deep Learning Architecture for Accelerated MRI Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-08-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for significantly accelerating MRI reconstruction, enabling faster scan times and improved image quality. This technology utilizes a generative adversarial network (GAN) to reconstruct high-resolution images from undersampled data, addressing a key limitation in clinical MRI.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising:...\",\n        \"A deep learning model configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68949", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for X-Ray Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Generic Pharma Corp.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2023-01-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved contrast agent for X-ray imaging offering enhanced visibility of blood vessels. The agent utilizes a modified iodine compound to increase X-ray attenuation, resulting in clearer images for diagnostic purposes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent composition comprising:...\",\n        \"A method for enhancing X-ray images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68950", "text": "{\n    \"patent_title\": \"AI-Powered Medical Image Analysis for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"11,234,567\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2021-12-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention utilizes deep learning algorithms to analyze medical images, such as CT scans and MRIs, for the early diagnosis of cancerous tumors. The system provides a prognosis based on image features and patient data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"10,123,456\",\n            \"kind\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting tumors in medical images using a convolutional neural network.\",\n        \"A system for providing a prognosis based on image analysis and patient data.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68950", "text": "{\n    \"patent_title\": \"Method for Enhancing Image Contrast in X-ray Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Emily Chen\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"10,987,654\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2020-09-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel method for improving the contrast of X-ray images, leading to better visualization of anatomical structures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"9,881,234\",\n            \"kind\": \"cited_by\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image contrast using a filtering algorithm.\",\n        \"An X-ray imaging system incorporating the contrast enhancement method.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68951", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Boston Medical Center\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-03-01\",\n    \"issue_date\": \"2023-10-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system incorporating real-time image enhancement and robotic assistance for improved surgical precision and patient outcomes. The system utilizes advanced algorithms to reduce surgical trauma and accelerate recovery times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Similar surgical robotics\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising a robotic arm...\",\n        \"A method for performing minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68951", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Fluid Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, San Diego\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-11-20\",\n    \"filing_date\": \"2019-12-10\",\n    \"issue_date\": \"2022-08-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design for efficient and precise fluid delivery during medical procedures. This design minimizes blockage and enhances flow rate.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US4567890\",\n            \"relevance\": \"Prior art catheter designs\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a lumen...\",\n        \"A method for delivering fluids using the catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68952", "text": "{\n    \"patent_title\": \"Miniature Robotic Surgical System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature robotic surgical system for performing minimally invasive procedures with increased precision and dexterity. The system includes a micro-robot, a control interface, and imaging capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system comprising...\",\n        \"A control interface for manipulating...\",\n        \"An imaging module integrated with...\",\n        \"A method for performing minimally invasive surgery...\",\n        \"The system of claim 1, wherein the micro-robot...\",\n        \"The control interface of claim 2, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68952", "text": "{\n    \"patent_title\": \"Drug Delivery System for Targeted Cancer Therapy\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Sarah Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Michael Brown\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2023-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel drug delivery system for targeted cancer therapy utilizing nanoparticles and biocompatible polymers. The system enhances drug efficacy and minimizes side effects.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        },\n        {\n            \"patent_number\": \"US8901234B1\"\n        }\n    ],\n    \"claims\": [\n        \"A drug delivery system comprising...\",\n        \"Nanoparticles functionalized with...\",\n        \"A biocompatible polymer matrix...\",\n        \"A method for treating cancer...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68953", "text": "{\n    \"patent_title\": \"Biocompatible Scaffold for Accelerated Bone Regeneration\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel biocompatible scaffold composed of a modified collagen matrix is disclosed. The scaffold promotes rapid bone regeneration and significantly reduces post-operative discomfort by facilitating vascularization and minimizing inflammatory response. In vivo studies demonstrate a 30% reduction in healing time compared to conventional methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on collagen scaffolds\"\n        }\n    ],\n    \"claims\": [\n        \"A biocompatible scaffold comprising a modified collagen matrix.\",\n        \"The scaffold of claim 1, further comprising a growth factor.\",\n        \"A method of promoting bone regeneration using the scaffold of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68953", "text": "{\n    \"patent_title\": \"Surgical Instrument with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Acme Corporation\"\n        },\n        {\n            \"name\": \"Eve Edwards\",\n            \"affiliation\": \"Acme Corporation\"\n        },\n        {\n            \"name\": \"Frank Foster\",\n            \"affiliation\": \"Acme Corporation\"\n        },\n        {\n            \"name\": \"Grace Green\",\n            \"affiliation\": \"Acme Corporation\"\n        },\n        {\n            \"name\": \"Henry Hughes\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2022-01-10\",\n    \"filing_date\": \"2022-01-10\",\n    \"issue_date\": \"2023-11-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical instrument is disclosed, featuring an ergonomic handle and enhanced precision. The instrument is designed to reduce surgeon fatigue during long procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on surgical instruments\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising an ergonomic handle.\",\n        \"The instrument of claim 1, further comprising a locking mechanism.\",\n        \"A method of performing surgery using the instrument of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68954", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Jian Li\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-06-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system incorporating advanced fiber optic technology for enhanced visualization and precision during complex surgical procedures. The system includes a robotic arm for increased dexterity and a real-time image processing module for improved diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9546521B2\",\n            \"relevance\": \"Prior art related to robotic surgery.\"\n        }\n    ],\n    \"claims\": [\n        \"A minimally invasive surgical system comprising...\",\n        \"A method for performing a surgical procedure using said system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68954", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Peripheral Vascular Access\",\n    \"inventors\": [\n        {\n            \"name\": \"Mark Olsen\",\n            \"affiliation\": \"BioTech Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2017-09-20\",\n    \"filing_date\": \"2017-09-20\",\n    \"issue_date\": \"2021-11-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design incorporating a novel tip geometry to minimize vessel trauma during peripheral vascular access. The catheter features a low-friction coating for smooth insertion and reduced risk of thrombosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8980245B2\",\n            \"relevance\": \"Related to catheter materials.\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter for peripheral vascular access comprising...\",\n        \"A method for inserting said catheter into a vessel...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68955", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Detection of Circulating Tumor Cells\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-08-20\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a microfluidic device for the rapid and efficient isolation and detection of circulating tumor cells (CTCs) from blood samples. The device utilizes a novel surface modification to enhance CTC capture, enabling early cancer diagnosis and personalized therapeutic monitoring. This technology addresses the need for non-invasive cancer diagnostics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"similar\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for isolating CTCs using...\",\n        \"A system for diagnosing cancer based on...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68955", "text": "{\n    \"patent_title\": \"Improved Algorithm for Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11123456B2\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-04-15\",\n    \"issue_date\": \"2021-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel algorithm for improving the accuracy and speed of image recognition tasks. It leverages deep learning techniques to achieve state-of-the-art performance on benchmark datasets. The algorithm has potential applications in various fields including computer vision and robotics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"similar\"\n        },\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"similar\"\n        },\n        {\n            \"patent_number\": \"US9234567B1\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US10345678B2\",\n            \"relevance\": \"similar\"\n        },\n        {\n            \"patent_number\": \"US11334455B2\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US8901234B1\",\n            \"relevance\": \"similar\"\n        },\n        {\n            \"patent_number\": \"US10456789B2\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US11445566B2\",\n            \"relevance\": \"similar\"\n        },\n        {\n            \"patent_number\": \"US9345678B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"An image recognition algorithm comprising...\",\n        \"A method for processing images using...\",\n        \"A system for identifying objects in images based on...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68956", "text": "{\n    \"patent_title\": \"Ultrasound Image Enhancement Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10543216B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing ultrasound images using a deep learning model to improve diagnostic accuracy. The model is trained on a large dataset of ultrasound images and can identify and enhance subtle features that are difficult to see with traditional ultrasound techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing ultrasound images comprising: training a deep learning model on a dataset of ultrasound images; applying the trained model to a new ultrasound image; and outputting an enhanced ultrasound image.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68956", "text": "{\n    \"patent_title\": \"Improved MRI Coil Design for Enhanced Signal Reception\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9987654B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2019-06-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel MRI coil design that improves signal reception, leading to higher quality images and reduced scan times. The coil incorporates a new material and geometry for optimal performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8876543B2\",\n            \"relevance\": \"Previous MRI coil designs\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil comprising: a novel material with high magnetic permeability; and a unique geometry optimized for signal reception.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68957", "text": "{\n    \"patent_title\": \"Energy-Efficient Beamforming for Millimeter Wave Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2022-05-10\",\n    \"filing_date\": \"2022-06-15\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention introduces a novel beamforming technique for millimeter wave wireless communication systems, significantly reducing energy consumption while maintaining high data rates. The method utilizes adaptive power allocation based on channel conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Beamforming Techniques for 5G\"\n        }\n    ],\n    \"claims\": [\n        \"A method for beamforming in a wireless communication system comprising...\",\n        \"A system for beamforming comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68957", "text": "{\n    \"patent_title\": \"Improved Antenna Design for Satellite Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"California Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2023-07-15\",\n    \"filing_date\": \"2023-08-22\",\n    \"issue_date\": \"2024-02-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents an improved antenna design for satellite communication systems, enhancing signal strength and reducing interference. The antenna utilizes a novel material composition and geometric configuration.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"title\": \"Antenna Designs for Space Applications\"\n        }\n    ],\n    \"claims\": [\n        \"An antenna for satellite communication comprising...\",\n        \"A method of manufacturing an antenna comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68958", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Minimally Invasive Cardiac Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Boston Children's Hospital\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-08-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel catheter design incorporating micro-sensors and a flexible tip for improved navigation and reduced trauma during minimally invasive cardiac procedures. Clinical trials demonstrate significantly improved patient outcomes and reduced recovery times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible distal tip...\",\n        \"A system for minimally invasive cardiac procedures...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68958", "text": "{\n    \"patent_title\": \"Novel Polymer for Drug Delivery Systems\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emily Chen\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2022-01-10\",\n    \"filing_date\": \"2022-01-10\",\n    \"issue_date\": \"2023-11-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new biodegradable polymer designed for controlled drug release. This material exhibits enhanced biocompatibility and tunable degradation rates, suitable for various biomedical applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A polymer comprising repeating units of...\",\n        \"A drug delivery system utilizing the polymer...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68959", "text": "{\n    \"patent_title\": \"Improved Catheter Tip Design for Reduced Patient Discomfort\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MedTech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University Hospital\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2022-05-15\",\n    \"filing_date\": \"2022-08-20\",\n    \"issue_date\": \"2023-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel catheter tip design incorporating a flexible polymer coating to minimize friction and discomfort during insertion and use. The design is an improvement upon existing catheter tip technologies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art related to catheter materials.\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter tip comprising a flexible polymer coating...\",\n        \"The catheter tip according to claim 1, wherein the polymer coating reduces friction by at least 20%...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68959", "text": "{\n    \"patent_title\": \"Novel Bio-Integrated Micro-Robotic System for Targeted Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-11-01\",\n    \"filing_date\": \"2022-02-15\",\n    \"issue_date\": \"2023-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A revolutionary bio-integrated micro-robotic system for precise and targeted drug delivery within the human body. This invention represents a fundamentally new approach to drug administration.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"General principles of micro-robotics.\"\n        },\n        {\n            \"patent_number\": \"US65432109B1\",\n            \"relevance\": \"Drug encapsulation techniques.\"\n        },\n        {\n            \"patent_number\": \"US54321098B1\",\n            \"relevance\": \"Biocompatible materials.\"\n        },\n        {\n            \"patent_number\": \"US43210987B1\",\n            \"relevance\": \"Remote control systems.\"\n        },\n        {\n            \"patent_number\": \"US32109876B1\",\n            \"relevance\": \"Targeted therapy.\"\n        }\n    ],\n    \"claims\": [\n        \"A bio-integrated micro-robotic system comprising...\",\n        \"The system according to claim 1, capable of navigating the bloodstream...\",\n        \"The system according to claim 2, achieving targeted drug delivery to cancer cells...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68960", "text": "{\n    \"patent_title\": \"Ultrasound-guided microbubble-enhanced targeted drug delivery system for cancer therapy\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2022-03-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel ultrasound-guided microbubble-enhanced targeted drug delivery system capable of increasing drug concentration in tumor tissue. This significantly improves therapeutic efficacy compared to conventional methods by overcoming biological barriers, representing a substantial advancement in cancer treatment and diagnostics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on microbubble technology\"\n        }\n    ],\n    \"claims\": [\n        \"A method for targeted drug delivery using ultrasound and microbubbles.\",\n        \"A composition comprising microbubbles loaded with a therapeutic agent.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68960", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging Coil Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-01-15\",\n    \"filing_date\": \"2020-01-20\",\n    \"issue_date\": \"2021-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel design for magnetic resonance imaging coils, increasing signal-to-noise ratio and improving image quality in MRI scans. The coil design incorporates a new material composition and geometric arrangement.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art on MRI coil design\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil with a specific geometric configuration.\",\n        \"A method for manufacturing an MRI coil.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68961", "text": "{\n    \"patent_title\": \"Improved MRI Contrast Agents for Enhanced Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2020-04-15\",\n    \"issue_date\": \"2021-12-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides novel MRI contrast agents that significantly enhance tumor detection sensitivity compared to existing agents. The agents utilize a targeted delivery system to maximize accumulation within tumor tissues.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art contrast agent\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing tumor detection using MRI comprising...\",\n        \"A contrast agent formulation comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68961", "text": "{\n    \"patent_title\": \"Novel X-ray System with Rotating Anode\",\n    \"inventors\": [\n        {\n            \"name\": \"Mr. John Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-20\",\n    \"filing_date\": \"2019-09-01\",\n    \"issue_date\": \"2020-07-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A completely new x-ray system design incorporating a rotating anode for improved image quality and reduced radiation exposure. The system is a fundamental departure from existing x-ray technology.\",\n    \"citations\": [],\n    \"claims\": [\n        \"An X-ray system comprising a rotating anode...\",\n        \"A method for generating X-rays using the system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68962", "text": "{\n    \"patent_title\": \"Lithium-Sulfur Battery with Modified Separator for Enhanced Cycle Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2022-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-sulfur battery utilizing a novel polymer separator with improved lithium polysulfide trapping capabilities, resulting in enhanced cycle life and reduced capacity fade. This technology offers a sustainable alternative to traditional lithium-ion batteries by reducing reliance on cobalt and nickel.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        },\n        {\n            \"patent_number\": \"CN108765432A\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-sulfur battery comprising:...\",\n        \"The battery of claim 1, wherein the separator comprises...\",\n        \"The battery of claim 2, wherein the polymer is...\",\n        \"A method of manufacturing a lithium-sulfur battery...\",\n        \"The method of claim 4, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68962", "text": "{\n    \"patent_title\": \"Improved Lead-Acid Battery Design for Automotive Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Exide Technologies\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"Johnson Controls\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2020-07-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved design for lead-acid batteries aimed at increasing lifespan and reducing weight in automotive applications. The invention focuses on optimizing electrode plate geometry and electrolyte composition.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A lead-acid battery comprising:...\",\n        \"The battery of claim 1, wherein the electrode plate geometry is...\",\n        \"The battery of claim 2, wherein the electrolyte comprises...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68963", "text": "{\n    \"patent_title\": \"Implantable Cardiovascular Monitoring Device with Biocompatible Coating\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-01-20\",\n    \"issue_date\": \"2021-12-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable device for continuous monitoring of cardiovascular function, utilizing a novel biocompatible polymer coating to minimize tissue rejection and improve long-term efficacy. The device incorporates advanced sensor technology and wireless communication capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US11000001B2\"\n        },\n        {\n            \"patent_number\": \"US10500500B2\"\n        }\n    ],\n    \"claims\": [\n        \"A biocompatible coating for implantable cardiovascular devices.\",\n        \"A method for continuous monitoring of cardiac function.\",\n        \"A wireless communication system for transmitting sensor data.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68963", "text": "{\n    \"patent_title\": \"Surgical Instrument for Minimally Invasive Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-03-01\",\n    \"filing_date\": \"2019-09-10\",\n    \"issue_date\": \"2020-07-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical instrument designed for precise and minimally invasive procedures. The instrument features an ergonomic handle and advanced articulation capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        },\n        {\n            \"patent_number\": \"US8234567B1\"\n        }\n    ],\n    \"claims\": [\n        \"An ergonomic handle for surgical instruments.\",\n        \"An articulation mechanism for precise manipulation.\",\n        \"A minimally invasive surgical instrument design.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68964", "text": "{\n    \"patent_title\": \"Improved Magnetic Resonance Imaging Technique for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel pulse sequence for magnetic resonance imaging (MRI) that enhances the contrast between cancerous and non-cancerous tissues, enabling earlier and more accurate cancer detection. The method utilizes advanced signal processing algorithms to improve image quality and reduce noise.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8785923B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating MRI images comprising...\",\n        \"An MRI apparatus configured to perform the method of claim 1...\",\n        \"The method of claim 1, wherein the pulse sequence includes...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68964", "text": "{\n    \"patent_title\": \"Novel X-Ray Shielding Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-02-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new composite material for effectively shielding against X-ray radiation. The material is lightweight and offers superior protection compared to traditional lead-based shields. It is intended for use in dental and industrial radiography.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A shielding material comprising...\",\n        \"The shielding material of claim 1, wherein the composite material includes...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68965", "text": "{\n    \"patent_title\": \"Improved MRI Techniques for Early-Stage Breast Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel magnetic resonance imaging (MRI) sequences and image processing techniques for the enhanced detection of early-stage breast cancer. The methods improve sensitivity and specificity, reducing false positives and enabling earlier diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8567890B1\",\n            \"relevance\": \"High\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Medium\"\n        },\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"Low\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"relevance\": \"Medium\"\n        },\n        {\n            \"patent_number\": \"US9543210B1\",\n            \"relevance\": \"High\"\n        },\n        {\n            \"patent_number\": \"US9210123B2\",\n            \"relevance\": \"Medium\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Low\"\n        },\n        {\n            \"patent_number\": \"US9754321B2\",\n            \"relevance\": \"High\"\n        },\n        {\n            \"patent_number\": \"US8321098B1\",\n            \"relevance\": \"Medium\"\n        },\n        {\n            \"patent_number\": \"US9654321B2\",\n            \"relevance\": \"High\"\n        },\n        {\n            \"patent_number\": \"US8432109B1\",\n            \"relevance\": \"Low\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting breast cancer...\",\n        \"An MRI sequence comprising...\",\n        \"A system for processing MRI images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68965", "text": "{\n    \"patent_title\": \"Digital Radiography System with Improved Image Resolution\",\n    \"inventors\": [\n        {\n            \"name\": \"Wang Li\",\n            \"affiliation\": \"Huazhong University of Science and Technology\"\n        },\n        {\n            \"name\": \"Zhang Wei\",\n            \"affiliation\": \"Tsinghua University\"\n        }\n    ],\n    \"patent_number\": \"CN108765432B\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-11-15\",\n    \"patent_office\": \"SIPO\",\n    \"abstract\": \"This invention relates to a digital radiography system that provides enhanced image resolution compared to existing systems. The system utilizes a novel detector array and image reconstruction algorithm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"Low\"\n        },\n        {\n            \"patent_number\": \"EP2123456A1\",\n            \"relevance\": \"Medium\"\n        },\n        {\n            \"patent_number\": \"JP2015123456A\",\n            \"relevance\": \"Low\"\n        }\n    ],\n    \"claims\": [\n        \"A digital radiography system comprising...\",\n        \"A detector array with...\",\n        \"An image reconstruction algorithm...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68966", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-15\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable biosensor for continuous glucose monitoring using a novel enzymatic reaction and wireless communication. The device is designed for long-term implantation and provides real-time glucose data to a smartphone application.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art on glucose monitoring systems.\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable biosensor comprising...\",\n        \"A method for continuous glucose monitoring using the biosensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68966", "text": "{\n    \"patent_title\": \"Surgical Stapler with Enhanced Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Johnson & Johnson\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-03-15\",\n    \"filing_date\": \"2022-03-20\",\n    \"issue_date\": \"2024-02-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical stapler with enhanced ergonomics and a faster firing mechanism. The stapler is designed to reduce surgeon fatigue and improve surgical efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous stapler designs.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"A firing mechanism for the stapler...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68967", "text": "{\n    \"patent_title\": \"Implantable Cardioverter-Defibrillator with Adaptive Therapy\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-01-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardioverter-defibrillator (ICD) capable of adapting therapy based on patient-specific physiological data to optimize efficacy and minimize discomfort. This invention represents a significant advancement in ICD technology by incorporating advanced algorithms for arrhythmia detection and individualized pacing strategies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8761723B2\",\n            \"relevance\": \"Prior art relating to basic ICD functionality\"\n        }\n    ],\n    \"claims\": [\n        \"A method for adaptively pacing a patient's heart...\",\n        \"An implantable device comprising...\",\n        \"A system for detecting and classifying arrhythmias...\",\n        \"A method for minimizing discomfort during ICD therapy...\",\n        \"An algorithm for personalized therapy adjustment...\",\n        \"A system for remote monitoring of device performance...\",\n        \"A device that communicates with a central server...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68967", "text": "{\n    \"patent_title\": \"Modified Catheter Tip for Angiography\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. James Wilson\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2019-05-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A modified catheter tip designed to improve visualization during angiography procedures. The tip incorporates a smaller diameter and more flexible material for easier navigation through blood vessels. This is a incremental improvement on existing angiography catheters.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7988642B2\",\n            \"relevance\": \"Basic catheter tip design\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter tip having a reduced diameter...\",\n        \"A catheter tip comprising a flexible polymer material...\",\n        \"A method for performing angiography using the catheter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68968", "text": "{\n    \"patent_title\": \"Wearable Biosensor for Continuous Glucose Monitoring and Personalized Insulin Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wearable biosensor system for continuous glucose monitoring and personalized insulin delivery. The device utilizes microfluidic technology and electrochemical sensors to provide real-time glucose readings and automatically adjust insulin dosage via a micro-pump. This allows for improved glycemic control and reduced risk of diabetic complications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on glucose sensors\"\n        }\n    ],\n    \"claims\": [\n        \"A wearable biosensor for continuous glucose monitoring.\",\n        \"A system for personalized insulin delivery based on real-time glucose readings.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68968", "text": "{\n    \"patent_title\": \"Cloud-Based Platform for Remote Patient Data Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-01-10\",\n    \"issue_date\": \"2023-10-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A cloud-based platform for collecting, analyzing, and visualizing patient data remotely. The platform allows healthcare providers to monitor patient health metrics and provide virtual care. The system utilizes machine learning algorithms to detect anomalies and predict potential health issues.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\",\n            \"relevance\": \"Related to telehealth platforms.\"\n        }\n    ],\n    \"claims\": [\n        \"A cloud-based platform for remote patient data analysis.\",\n        \"A method for detecting anomalies in patient health data using machine learning.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68969", "text": "{\n    \"patent_title\": \"Adaptive Noise Reduction in High-Resolution Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Independent Researcher\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2022-03-15\",\n    \"filing_date\": \"2022-03-15\",\n    \"issue_date\": \"2023-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel algorithm for adaptive noise reduction in high-resolution images is presented. The method utilizes a wavelet-based decomposition combined with a machine learning classifier to identify and suppress noise while preserving image details. The technique yields superior results compared to established methods, particularly in low-light conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Background art on wavelet transforms\"\n        }\n    ],\n    \"claims\": [\n        \"A method for noise reduction comprising...\",\n        \"A system for implementing the noise reduction method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68969", "text": "{\n    \"patent_title\": \"Automated Detection of Tumors in Mammograms\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2021-11-01\",\n    \"filing_date\": \"2021-11-01\",\n    \"issue_date\": \"2023-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention improves existing methods for the automated detection of tumors in mammograms. Conventional techniques often struggle with low-contrast images; this system utilizes deep learning to enhance image quality and improve diagnostic accuracy. The system builds upon established algorithms and refines them for clinical applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art on mammogram image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A system for tumor detection comprising...\",\n        \"A method for preprocessing mammogram images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68970", "text": "{\n    \"patent_title\": \"Method for Noise Reduction in Low-Dose CT Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reducing noise in computed tomography (CT) images acquired with low radiation doses. The method utilizes a deep learning algorithm to reconstruct images with improved clarity and reduced artifacts, potentially enabling safer and more effective medical diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on CT image reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a CT image...\",\n        \"The method of claim 1, wherein the deep learning algorithm...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68970", "text": "{\n    \"patent_title\": \"Improved X-Ray Tube Cooling System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Siemens AG\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2023-01-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved cooling system for X-ray tubes, designed to enhance heat dissipation and prolong tube lifespan. This results in more reliable X-ray imaging equipment.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art on X-ray tube design\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube cooling system comprising...\",\n        \"The cooling system of claim 1, wherein the coolant...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68971", "text": "{\n    \"patent_title\": \"Enhanced Lithium-Ion Battery with Silicon Anode and Electrolyte Additive\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-06-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery with a silicon anode and a novel electrolyte additive to improve cycle life and energy density. This invention enhances battery performance for electric vehicles and grid-scale energy storage, promoting sustainable energy solutions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Lithium-Ion Battery with Improved Electrolyte\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising a silicon anode.\",\n        \"An electrolyte additive for improving cycle life.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68971", "text": "{\n    \"patent_title\": \"Advanced Solid Oxide Fuel Cell System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Bloom Energy\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2022-01-10\",\n    \"filing_date\": \"2022-01-10\",\n    \"issue_date\": \"2023-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A solid oxide fuel cell system with improved efficiency and durability. The system utilizes a novel catalyst and membrane structure to generate electricity from hydrogen and oxygen. This technology offers a clean and efficient energy solution using fuel cells.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"High-Temperature Fuel Cell Design\"\n        }\n    ],\n    \"claims\": [\n        \"A solid oxide fuel cell system with a novel catalyst.\",\n        \"A membrane structure for enhanced efficiency.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68972", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical Stapler with Enhanced Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2022-12-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical stapler designed for minimally invasive procedures, featuring a lightweight, ergonomic handle and improved cartridge alignment for enhanced precision and reduced patient trauma.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art relating to surgical staplers.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an ergonomic handle.\",\n        \"The surgical stapler of claim 1, wherein the handle is lightweight.\",\n        \"A surgical stapler cartridge alignment mechanism for improved precision.\",\n        \"The alignment mechanism of claim 3, reducing patient trauma.\",\n        \"A method of performing minimally invasive surgery using the stapler.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68972", "text": "{\n    \"patent_title\": \"Novel MRI Contrast Agent for Improved Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2020-03-10\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2023-07-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel contrast agent for magnetic resonance imaging (MRI) designed to improve the detection of small tumors. The agent exhibits enhanced signal intensity and specificity for cancerous tissues.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art relating to MRI contrast agents.\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising a gadolinium complex.\",\n        \"The contrast agent of claim 1, exhibiting enhanced signal intensity.\",\n        \"A method of detecting tumors using the contrast agent.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68973", "text": "{\n    \"patent_title\": \"Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel implantable biosensor for continuous glucose monitoring in diabetic patients. The sensor utilizes a biocompatible nanomaterial for enhanced sensitivity and accuracy, leading to improved glycemic control and reduced risk of complications. Clinical trials demonstrate significantly better patient outcomes compared to existing methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Glucose Sensor Device\"\n        },\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"title\": \"Biocompatible Nanomaterials\"\n        }\n    ],\n    \"claims\": [\n        \"A method for continuously monitoring glucose levels in a patient comprising...\",\n        \"An implantable biosensor comprising a nanomaterial-based sensing element...\",\n        \"The biosensor of claim 1, wherein the nanomaterial enhances sensitivity by at least 20%.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68973", "text": "{\n    \"patent_title\": \"Cosmetic Skin Smoothing Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2021-05-20\",\n    \"filing_date\": \"2021-05-20\",\n    \"issue_date\": \"2023-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a handheld device for smoothing skin wrinkles and improving skin texture through microdermabrasion.  The device utilizes a disposable abrasive tip and adjustable intensity settings. User trials show a visible improvement in skin smoothness.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Microdermabrasion Device\"\n        }\n    ],\n    \"claims\": [\n        \"A handheld device for skin smoothing comprising...\",\n        \"A disposable abrasive tip for use with the device of claim 1...\",\n        \"The device of claim 1, wherein the intensity is adjustable.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68974", "text": "{\n    \"patent_title\": \"Enhanced MRI Contrast Agents for Improved Cardiovascular Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"11,456,789\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2023-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel MRI contrast agent formulation that significantly enhances image clarity in cardiovascular imaging, allowing for improved detection of subtle anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"10,123,456\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI image clarity...\",\n        \"A contrast agent comprising...\",\n        \"An MRI system configured to utilize...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68974", "text": "{\n    \"patent_title\": \"Ultrasound Imaging Device with Signal Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"10,987,654\",\n    \"priority_date\": \"2020-02-15\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2022-08-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An ultrasound imaging device with improved signal processing capabilities for clearer images, primarily focused on abdominal diagnostics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"9,232,345\",\n            \"type\": \"cited_by\"\n        }\n    ],\n    \"claims\": [\n        \"An ultrasound imaging device comprising...\",\n        \"A signal processing method for...\",\n        \"A system for displaying ultrasound images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68975", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Robotic Assistance\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University Medical Center\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"BioRobotics Inc.\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A robotic surgical system enabling highly precise minimally invasive procedures, reducing patient recovery time and improving surgical outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic surgical system comprising...\",\n        \"A method for performing minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68975", "text": "{\n    \"patent_title\": \"Drug Delivery System for Targeted Cancer Therapy\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Chen\",\n            \"affiliation\": \"Pfizer Inc.\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Pfizer Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-11-01\",\n    \"filing_date\": \"2022-11-01\",\n    \"issue_date\": \"2024-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel drug delivery system designed to target cancer cells, improving efficacy and reducing side effects.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related to nanoparticle drug delivery\"\n        }\n    ],\n    \"claims\": [\n        \"A drug delivery system comprising...\",\n        \"A method for treating cancer...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68976", "text": "{\n    \"patent_title\": \"Implantable Cardiac Monitor with Enhanced Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"EP3123456B1\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-05-23\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"An implantable cardiac monitor capable of transmitting high-resolution ECG data wirelessly to an external receiver. The device incorporates a novel compression algorithm to maximize data throughput and minimize power consumption.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8986001B2\",\n            \"title\": \"Wireless physiological data transmission system\"\n        }\n    ],\n    \"claims\": [\n        \"A method for transmitting ECG data from an implantable cardiac monitor.\",\n        \"An implantable cardiac monitor comprising a data compression module.\",\n        \"A system for remotely monitoring a patient's cardiac health.\",\n        \"The device of claim 1, wherein the data compression module employs a wavelet transform.\",\n        \"The system of claim 3, further comprising a cloud-based data storage and analysis platform.\",\n        \"The method of claim 1, wherein the data transmission is encrypted.\",\n        \"The implantable cardiac monitor of claim 2, wherein the data compression module is configurable.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68976", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2019-02-12\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A surgical stapler with an improved handle design for enhanced grip and maneuverability. The stapler also incorporates a safety mechanism to prevent accidental discharge.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Surgical stapler with safety lock\"\n        },\n        {\n            \"patent_number\": \"US8236012B2\",\n            \"title\": \"Ergonomic handle for surgical instruments\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Automated surgical stapler\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising an improved handle.\",\n        \"The surgical stapler of claim 1, wherein the handle is molded from a non-slip material.\",\n        \"A safety mechanism for a surgical stapler.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68977", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Eleanor Vance\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Jian Li\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable biosensor for continuous glucose monitoring with improved accuracy and biocompatibility. The sensor utilizes a novel nanomaterial to enhance sensitivity and reduce biofouling.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on glucose sensors\"\n        }\n    ],\n    \"claims\": [\n        \"A biosensor comprising a nanomaterial-based sensing element.\",\n        \"A method for continuous glucose monitoring using the biosensor.\",\n        \"A system for data transmission and analysis.\",\n        \"The biosensor according to claim 1, wherein the nanomaterial is graphene.\",\n        \"The method according to claim 2, wherein the glucose monitoring is performed in vivo.\",\n        \"The system according to claim 3, wherein the data is transmitted wirelessly.\",\n        \"The biosensor of claim 1, further comprising a biocompatible coating.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68977", "text": "{\n    \"patent_title\": \"Surgical Instrument with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Davis\",\n            \"affiliation\": \"Acme Medical Devices Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical instrument designed for enhanced ergonomics and precision during minimally invasive procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous surgical instrument designs\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising a handle and a working end.\",\n        \"The handle according to claim 1, being ergonomically designed for comfortable grip.\",\n        \"The working end according to claim 1, having a precise cutting edge.\",\n        \"The surgical instrument of claim 1, including a locking mechanism.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68978", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2018-03-10\",\n    \"issue_date\": \"2020-11-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical system enabling minimally invasive procedures with increased precision and dexterity, addressing a critical need for improved patient outcomes in complex surgeries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising...\",\n        \"A method for performing minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68978", "text": "{\n    \"patent_title\": \"Improved MRI Coil for Enhanced Image Resolution\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2019-02-15\",\n    \"issue_date\": \"2021-08-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved magnetic resonance imaging (MRI) coil design that enhances image resolution and signal-to-noise ratio for improved diagnostic capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"An MRI coil comprising...\",\n        \"A method for acquiring MRI images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68979", "text": "{\n    \"patent_title\": \"Enhanced Magnetic Resonance Imaging with Artificial Intelligence for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2017-05-22\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for enhancing magnetic resonance imaging (MRI) utilizing deep learning algorithms to improve the detection of early-stage cancerous tumors. The system analyzes MRI scans with significantly improved accuracy compared to traditional methods, leading to earlier and more effective treatment.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related prior art in MRI image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing MRI images using deep learning.\",\n        \"A system for detecting early-stage cancerous tumors in MRI scans.\",\n        \"A computer-readable medium storing instructions for performing the method.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68979", "text": "{\n    \"patent_title\": \"Improved X-Ray Tube Design for Reduced Radiation Exposure\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-11-01\",\n    \"filing_date\": \"2015-03-12\",\n    \"issue_date\": \"2019-01-29\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved X-ray tube design that reduces radiation exposure to patients during X-ray imaging. The design incorporates a novel filtering system and optimized tube geometry.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art related to X-ray tube design\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray tube with a novel filtering system.\",\n        \"An X-ray imaging system with reduced radiation exposure.\",\n        \"A method for manufacturing an X-ray tube.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68980", "text": "{\n    \"patent_title\": \"Comfortable Wearable Sensor for Continuous Physiological Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-04-15\",\n    \"issue_date\": \"2023-02-28\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A wearable sensor designed for continuous physiological monitoring, featuring a flexible and breathable material to maximize patient comfort. The sensor utilizes advanced algorithms to provide accurate and reliable data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"title\": \"Wearable Health Tracker\"\n        },\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"title\": \"Flexible Sensor Technology\"\n        },\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"title\": \"Physiological Monitoring System\"\n        },\n        {\n            \"patent_number\": \"US11998877B2\",\n            \"title\": \"Biocompatible Materials for Sensors\"\n        },\n        {\n            \"patent_number\": \"US12001122B1\",\n            \"title\": \"Low-Power Wireless Communication for Sensors\"\n        }\n    ],\n    \"claims\": [\n        \"A wearable sensor comprising a flexible substrate...\",\n        \"A method for continuously monitoring physiological data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68980", "text": "{\n    \"patent_title\": \"Advanced Surgical Instrument for Minimally Invasive Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"EP3456789A1\",\n    \"priority_date\": \"2022-05-10\",\n    \"filing_date\": \"2022-06-10\",\n    \"issue_date\": \"2024-01-15\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"A novel surgical instrument designed for performing minimally invasive procedures with enhanced precision and control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10987654B2\",\n            \"title\": \"Robotic Surgical System\"\n        },\n        {\n            \"patent_number\": \"US11887766B1\",\n            \"title\": \"Minimally Invasive Surgical Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising a robotic arm...\",\n        \"A method for performing minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68981", "text": "{\n    \"patent_title\": \"Enhanced Magnetic Resonance Imaging for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for improving the resolution and contrast of MRI images using advanced signal processing techniques, enabling earlier and more accurate cancer detection. The system employs a novel algorithm to reduce noise and enhance subtle features within the images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8546789B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing MRI data...\",\n        \"A system for enhancing image contrast...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68981", "text": "{\n    \"patent_title\": \"Method for Targeted Radiation Therapy Using Image Guidance\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Dr. Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-01-10\",\n    \"filing_date\": \"2017-01-10\",\n    \"issue_date\": \"2020-11-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for delivering highly focused radiation therapy to cancerous tumors using real-time image guidance. This allows for precise targeting and minimizes damage to surrounding healthy tissues.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for delivering radiation therapy...\",\n        \"An image-guided radiation therapy system...\",\n        \"A control system for adjusting radiation dosage...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68982", "text": "{\n    \"patent_title\": \"Improved X-ray Detection System with Enhanced Contrast\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2022-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an X-ray detection system utilizing a novel scintillator material and detector array to produce images with significantly improved contrast and reduced radiation dose. This allows for earlier and more accurate diagnosis of lung nodules.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on scintillator materials\"\n        }\n    ],\n    \"claims\": [\n        \"A system for detecting X-rays comprising a scintillator material...\",\n        \"A method for generating a medical image using the system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68982", "text": "{\n    \"patent_title\": \"Method for Automated Analysis of MRI Scans\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2020-11-01\",\n    \"issue_date\": \"2023-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A software method for automatically analyzing MRI scans to detect abnormalities in the brain. The system utilizes machine learning algorithms to identify potential areas of concern.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A computer-implemented method for analyzing MRI data...\",\n        \"A system comprising a processor configured to execute the method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68983", "text": "{\n    \"patent_title\": \"Biocompatible Scaffold for Accelerated Tissue Regeneration\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel biocompatible scaffold designed to promote rapid tissue regeneration with a focus on minimizing patient discomfort and reducing overall recovery time following surgical procedures. The scaffold is fabricated from a biodegradable polymer and incorporates growth factors to accelerate healing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8541123B2\",\n            \"title\": \"Biocompatible Polymer Compositions\"\n        },\n        {\n            \"patent_number\": \"US7981567B2\",\n            \"title\": \"Methods for Tissue Engineering\"\n        }\n    ],\n    \"claims\": [\n        \"A biocompatible scaffold comprising a biodegradable polymer matrix.\",\n        \"The scaffold of claim 1, further comprising growth factors.\",\n        \"A method for promoting tissue regeneration comprising implanting the scaffold.\",\n        \"The method of claim 3, wherein the tissue regeneration is accelerated.\",\n        \"The scaffold of claim 1, wherein the polymer is polylactic acid.\",\n        \"The scaffold of claim 1, wherein the scaffold is designed for minimally invasive implantation.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68983", "text": "{\n    \"patent_title\": \"Surgical Instrument with Enhanced Grip\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-11-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical instrument featuring an ergonomic handle and textured grip surface for enhanced control and precision during surgical procedures. The instrument is made from stainless steel and is autoclavable.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"title\": \"Ergonomic Handle Designs\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising an elongated shaft and a handle.\",\n        \"The instrument of claim 1, wherein the handle has a textured surface.\",\n        \"The instrument of claim 1, made of stainless steel.\",\n        \"The instrument of claim 1, that is autoclavable.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68984", "text": "{\n    \"patent_title\": \"Enhanced Solid-State Electrolyte for Improved Battery Performance in Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-06-20\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel solid-state electrolyte composition is disclosed, enhancing ion conductivity and improving the energy density of batteries used in portable electronic devices. The electrolyte utilizes a ceramic matrix with optimized doping for superior performance and safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art on solid-state electrolytes\"\n        }\n    ],\n    \"claims\": [\n        \"A battery comprising a solid-state electrolyte...\",\n        \"The battery of claim 1, wherein the electrolyte comprises a ceramic matrix...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68984", "text": "{\n    \"patent_title\": \"Lithium-Sulfur Battery with Enhanced Cycle Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-02-15\",\n    \"issue_date\": \"2020-09-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-sulfur battery architecture is presented with improved cycle life and energy density. The battery incorporates a novel cathode material and electrolyte additives to mitigate polysulfide shuttling.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art on lithium-sulfur batteries\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-sulfur battery comprising a cathode...\",\n        \"The battery of claim 1, wherein the cathode comprises a sulfur-based material...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68985", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction for Low-Dose CT Scans\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"General Electric Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-06-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel image reconstruction algorithm for computed tomography (CT) scans. The algorithm reduces image noise and artifacts, enabling the use of lower radiation doses while maintaining diagnostic image quality. The method incorporates deep learning techniques to enhance image resolution and clarity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Prior Art CT Reconstruction Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a CT image...\",\n        \"The method of claim 1, wherein the radiation dose is reduced by at least 20%...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68985", "text": "{\n    \"patent_title\": \"Method for Targeted Radiotherapy using Nanoparticles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2021-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method for delivering targeted radiotherapy to cancerous tumors using functionalized nanoparticles. The nanoparticles selectively accumulate in tumor cells, enhancing the efficacy of radiation treatment and minimizing damage to surrounding healthy tissues.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Prior Art Radiotherapy Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for delivering radiation to a tumor...\",\n        \"The method of claim 1, wherein nanoparticles are functionalized with targeting ligands...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68986", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction Method for Low-Dose CT Scans\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image reconstruction algorithm for computed tomography (CT) scans that significantly reduces radiation dose while maintaining high image quality. The method utilizes advanced statistical modeling and iterative reconstruction techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Prior Art CT Reconstruction Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a CT image from low-dose projection data comprising...\",\n        \"An apparatus for performing CT image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68986", "text": "{\n    \"patent_title\": \"Contrast Agent for Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"EP3456789A1\",\n    \"priority_date\": \"2017-09-20\",\n    \"filing_date\": \"2017-09-20\",\n    \"issue_date\": \"2018-12-12\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"A novel contrast agent for enhancing the visibility of tissues in magnetic resonance imaging (MRI). The agent is based on a biocompatible nanoparticle with high relaxivity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Improved Image Reconstruction Method for Low-Dose CT Scans\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent comprising...\",\n        \"A method for enhancing MRI images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68987", "text": "{\n    \"patent_title\": \"Deep Learning-Based System for Retinal Disease Diagnosis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2020-06-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for automated diagnosis of retinal diseases using deep convolutional neural networks with attention mechanisms. The system achieves high accuracy in identifying diabetic retinopathy and macular degeneration.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related method for image segmentation\"\n        },\n        {\n            \"patent_number\": \"US9543210B1\",\n            \"relevance\": \"Background on convolutional neural networks\"\n        }\n    ],\n    \"claims\": [\n        \"A method for diagnosing retinal diseases...\",\n        \"A system comprising a deep learning model...\",\n        \"A computer-readable medium...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68987", "text": "{\n    \"patent_title\": \"Image Recognition Using Standard Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Google Inc.\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11123456B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2021-03-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for image recognition using standard convolutional neural networks. The system can be applied to various image classification tasks.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related method for image segmentation\"\n        },\n        {\n            \"patent_number\": \"US9543210B1\",\n            \"relevance\": \"Background on convolutional neural networks\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Early work in image classification\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Foundation for CNNs\"\n        },\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"relevance\": \"Image processing techniques\"\n        },\n        {\n            \"patent_number\": \"US5432109B2\",\n            \"relevance\": \"Early image recognition algorithms\"\n        },\n        {\n            \"patent_number\": \"US4321098B1\",\n            \"relevance\": \"Feature extraction methods\"\n        },\n        {\n            \"patent_number\": \"US3210987B2\",\n            \"relevance\": \"Image analysis tools\"\n        },\n        {\n            \"patent_number\": \"US2109876B1\",\n            \"relevance\": \"Pattern recognition techniques\"\n        },\n        {\n            \"patent_number\": \"US1098765B2\",\n            \"relevance\": \"Previous attempts at image classification\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition...\",\n        \"A system comprising a convolutional neural network...\",\n        \"A computer-readable medium...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68988", "text": "{\n    \"patent_title\": \"Ultrasound Image Enhancement Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-09-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for enhancing the resolution and clarity of ultrasound images using a convolutional neural network. The system improves diagnostic accuracy by reducing noise and highlighting subtle features in the image.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"count\": 7\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"count\": 2\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing ultrasound images comprising...\",\n        \"A system for real-time ultrasound image processing...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68988", "text": "{\n    \"patent_title\": \"Improved X-ray Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2018-11-01\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved X-ray imaging system with enhanced image clarity and reduced radiation exposure. The system utilizes a novel detector array and image processing algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"count\": 3\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising...\",\n        \"A detector array for capturing X-ray images...\",\n        \"A method for reducing radiation exposure...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68989", "text": "{\n    \"patent_title\": \"Automated Lung Nodule Detection using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for automated detection of lung nodules in computed tomography (CT) scans using deep convolutional neural networks. The system leverages artificial intelligence to improve the accuracy and efficiency of lung cancer screening, addressing a significant unmet need for early diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8789012B1\",\n            \"relevance\": \"Prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting lung nodules in CT scans using a deep convolutional neural network.\",\n        \"A system comprising a CT scanner, a processing unit, and a display for visualizing detected nodules.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68989", "text": "{\n    \"patent_title\": \"Cardiac Arrhythmia Prediction Using Real-Time ECG Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-01-10\",\n    \"filing_date\": \"2017-01-10\",\n    \"issue_date\": \"2018-11-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for predicting cardiac arrhythmias in real-time using electrocardiogram (ECG) data. The system employs advanced signal processing techniques to identify patterns indicative of potential arrhythmias, enabling timely intervention.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Previous work on ECG analysis\"\n        }\n    ],\n    \"claims\": [\n        \"A method for predicting cardiac arrhythmias based on ECG signals.\",\n        \"A device for continuous ECG monitoring and arrhythmia detection.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68990", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Boston Medical Center\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-11-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system that provides enhanced visualization and precision for complex procedures. The system incorporates advanced imaging techniques and robotic assistance to improve surgical outcomes and reduce patient recovery time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in robotic surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising...\",\n        \"A visualization module...\",\n        \"A robotic arm...\",\n        \"A control system...\",\n        \"A method for performing a surgical procedure...\",\n        \"A system for enhanced precision...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68990", "text": "{\n    \"patent_title\": \"Improved Catheter Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2019-12-10\",\n    \"filing_date\": \"2019-12-10\",\n    \"issue_date\": \"2022-08-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design for delivering fluids to patients. The catheter features a new tip geometry and material composition for enhanced flexibility and reduced patient discomfort.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A catheter comprising...\",\n        \"A tip geometry...\",\n        \"A material composition...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68991", "text": "{\n    \"patent_title\": \"Advanced Modulation Techniques for 5G Wireless Systems\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Qualcomm\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents novel modulation schemes for 5G wireless communication, achieving significantly improved data rates and low latency. The techniques employed minimize interference and enhance spectral efficiency, representing a substantial advancement in the field.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"kind\": \"A\"\n        }\n    ],\n    \"claims\": [\n        \"A method for modulating a signal...\",\n        \"An apparatus for wireless communication...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68991", "text": "{\n    \"patent_title\": \"Improved Antenna Design for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-07-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel antenna design for mobile devices, enhancing signal strength and reducing interference. It utilizes a compact structure suitable for integration into smartphones and tablets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US91234567B2\",\n            \"kind\": \"A\"\n        },\n        {\n            \"patent_number\": \"US12345678B2\",\n            \"kind\": \"A\"\n        }\n    ],\n    \"claims\": [\n        \"An antenna comprising...\",\n        \"A mobile device including the antenna...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68992", "text": "{\n    \"patent_title\": \"Adaptive Modulation and Coding Scheme for Wireless Communication Systems\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Qualcomm Inc.\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-12-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for adaptively adjusting modulation and coding schemes in a wireless communication system to optimize throughput and reduce error rates. This improves network efficiency by dynamically responding to channel conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related art on channel estimation\"\n        }\n    ],\n    \"claims\": [\n        \"A method for adaptively modulating a signal...\",\n        \"A wireless communication system comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68992", "text": "{\n    \"patent_title\": \"Secure Authentication Protocol for Wireless Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"IBM Research\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-09-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel authentication protocol designed to enhance the security of wireless network access. This protocol utilizes cryptographic techniques to prevent unauthorized access and protect sensitive data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art on encryption algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"A method for authenticating a user...\",\n        \"A wireless network security system comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68993", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Glucose Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized, fully implantable glucose monitoring system utilizing wireless power transfer and data communication. Addresses the need for continuous, real-time glucose monitoring without the inconvenience of external devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8236123B2\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless glucose monitoring system comprising...\",\n        \"A method for continuously monitoring glucose levels...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68993", "text": "{\n    \"patent_title\": \"Improved Cardiovascular Stent Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jessica Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10456789B1\",\n    \"priority_date\": \"2017-08-22\",\n    \"filing_date\": \"2017-08-22\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved design for cardiovascular stents with enhanced biocompatibility and reduced risk of restenosis.  Utilizes a novel material coating and a modified expansion mechanism.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiovascular stent comprising...\",\n        \"A method for deploying a cardiovascular stent...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68994", "text": "{\n    \"patent_title\": \"High-Resolution Pediatric MRI with Reduced Scan Time\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel MRI technique for pediatric patients that utilizes advanced reconstruction algorithms to achieve high-resolution images with significantly reduced scan times, minimizing the need for sedation. Demonstrates improved diagnostic accuracy in identifying subtle anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating high-resolution MRI images of pediatric patients.\",\n        \"A system for reducing scan time in pediatric MRI.\",\n        \"A method for improving diagnostic accuracy in pediatric MRI.\"\n    ]\n}"}
{"_id": "Academic--patents--n--68994", "text": "{\n    \"patent_title\": \"Improved CT Image Reconstruction Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Karl Schmidt\",\n            \"affiliation\": \"Siemens Healthineers\"\n        },\n        {\n            \"name\": \"Eva Mueller\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-12-10\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2021-09-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved algorithm for reconstructing CT images, leading to reduced artifacts and enhanced image quality. The algorithm is particularly effective for adult cardiac imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in CT image reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing CT images with reduced artifacts.\",\n        \"A system for enhancing image quality in CT imaging.\",\n        \"A method for improving cardiac CT imaging.\"\n    ]\n}"}
{"_id": "Academic--patents--p--68995", "text": "{\n    \"patent_title\": \"Miniaturized Wearable Sensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-11-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel miniaturized wearable sensor for continuous glucose monitoring using non-invasive optical techniques. The device provides real-time glucose readings without the need for blood samples.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"count\": 15\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"count\": 8\n        }\n    ],\n    \"claims\": [\n        \"A wearable sensor for continuous glucose monitoring comprising...\",\n        \"A non-invasive optical detection system...\",\n        \"A method for real-time glucose monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68995", "text": "{\n    \"patent_title\": \"Surgical Instrument for Minimally Invasive Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"Siemens Healthineers\"\n        }\n    ],\n    \"patent_number\": \"EP3876543B1\",\n    \"priority_date\": \"2020-08-01\",\n    \"filing_date\": \"2021-02-15\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"A novel surgical instrument designed for minimally invasive procedures, offering enhanced precision and control during operations.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"count\": 3\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising...\",\n        \"A handle for precise manipulation...\",\n        \"A cutting mechanism for tissue dissection...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68996", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Drug Delivery System with Feedback Control\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-10-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized, implantable drug delivery system that utilizes real-time feedback control to optimize drug dosage based on patient physiological parameters. The system aims to significantly improve the efficacy and reduce side effects of chronic disease treatments.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on implantable sensors\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable drug delivery system comprising...\",\n        \"A method for controlling drug dosage based on real-time feedback...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68996", "text": "{\n    \"patent_title\": \"Advanced MRI Reconstruction Algorithm for Improved Image Resolution\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. David Evans\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-05-10\",\n    \"filing_date\": \"2022-05-10\",\n    \"issue_date\": \"2024-01-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An advanced algorithm for reconstructing magnetic resonance images (MRI) that significantly improves image resolution and reduces scan time. This allows for more detailed and accurate diagnosis of various medical conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"relevance\": \"Prior art in image processing techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images comprising...\",\n        \"A system for processing MRI data to enhance resolution...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68997", "text": "{\n    \"patent_title\": \"Enhanced Comfort Nasal Cannula\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a nasal cannula designed for improved patient comfort during extended oxygen therapy. The cannula incorporates a novel flexible material and ergonomic design to minimize pressure points and maximize airflow. Detailed studies have demonstrated a significant reduction in patient discomfort and skin breakdown compared to traditional nasal cannulas. The device also incorporates a humidity control system to improve oxygen delivery efficiency and reduce nasal dryness.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"Cited by Applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A nasal cannula comprising a flexible tube...\",\n        \"The nasal cannula of claim 1, wherein the flexible tube is constructed of a silicone-based polymer...\",\n        \"The nasal cannula of claim 1, further comprising a humidity control system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68997", "text": "{\n    \"patent_title\": \"Surgical Stapler with Improved Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Robert Smith\",\n            \"affiliation\": \"Acme Medical Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-11-20\",\n    \"filing_date\": \"2019-11-20\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention is a surgical stapler with a redesigned handle for improved grip and control. The stapler reduces hand fatigue during long procedures. \",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9000000B1\",\n            \"kind\": \"Cited by Examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising a handle...\",\n        \"The surgical stapler of claim 1, wherein the handle is ergonomically designed...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68998", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-15\",\n    \"filing_date\": \"2015-03-20\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery management system that improves energy efficiency and extends battery life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Prior Art Battery System\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Another Relevant Battery Technology\"\n        },\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Early Battery Control Systems\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"title\": \"Advanced Charging Algorithms\"\n        },\n        {\n            \"patent_number\": \"US9234567B1\",\n            \"title\": \"Battery Monitoring Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery performance...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68998", "text": "{\n    \"patent_title\": \"Wireless Communication Protocol\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Robert Brown\",\n            \"affiliation\": \"Intel Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new wireless communication protocol for improved data transmission rates.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Existing Wireless Standard\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Prior Wireless Communication\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Alternative Wireless Protocol\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication protocol comprising...\",\n        \"A method for data transmission using the protocol...\"\n    ]\n}"}
{"_id": "Academic--patents--p--68999", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Wireless Communication Efficiency\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for enhancing wireless communication efficiency by utilizing advanced signal processing techniques. The system dynamically adjusts transmission parameters to optimize data throughput and minimize interference, enabling a more reliable and faster wireless connection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"Related Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for wireless communication comprising...\",\n        \"2. The system of claim 1, wherein...\",\n        \"3. A method for enhancing wireless communication...\",\n        \"4. The method of claim 3, further comprising...\",\n        \"5. The system of claim 1, wherein the signal processing...\",\n        \"6. The method of claim 3, wherein the transmission parameters...\"\n    ]\n}"}
{"_id": "Academic--patents--n--68999", "text": "{\n    \"patent_title\": \"Improved Battery Life for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Beta Industries\"\n        }\n    ],\n    \"patent_number\": \"US1234567B2\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-05-20\",\n    \"issue_date\": \"2019-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention focuses on improving battery life in mobile devices through efficient power management techniques. It addresses the need for extended usage time without compromising performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Relevant Art\"\n        }\n    ],\n    \"claims\": [\n        \"1. A mobile device comprising...\",\n        \"2. The mobile device of claim 1, wherein...\",\n        \"3. A method for managing power in a mobile device...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69000", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US1234567B2\",\n    \"priority_date\": \"2017-06-15\",\n    \"filing_date\": \"2018-03-10\",\n    \"issue_date\": \"2020-09-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to novel electrode materials for lithium-ion batteries, enhancing energy density and cycle life. The materials exhibit improved performance characteristics under various operating conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrode material characterized by...\",\n        \"A method for manufacturing the electrode material...\",\n        \"The lithium-ion battery of claim 1, wherein...\",\n        \"The electrode material of claim 2, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69000", "text": "{\n    \"patent_title\": \"Advanced Solar Cell Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2019-01-20\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2021-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel design for solar cells, utilizing perovskite materials to increase efficiency and reduce manufacturing costs. It focuses on light trapping techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A solar cell comprising...\",\n        \"A perovskite material characterized by...\",\n        \"A method for fabricating the solar cell...\",\n        \"The solar cell of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69001", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system is disclosed. The system comprises a pressure sensor, a wireless transceiver, and a power source. The sensor is designed for remote monitoring applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"The system of claim 1, wherein the sensor is...\",\n        \"A method for remotely monitoring pressure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69001", "text": "{\n    \"patent_title\": \"Improved Battery Life for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-14\",\n    \"issue_date\": \"2019-01-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to extending the battery life of mobile electronic devices through improved power management techniques.  The invention focuses on optimizing CPU usage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"relevance\": \"Related Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A mobile electronic device comprising...\",\n        \"A method for extending battery life...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69002", "text": "{\n    \"patent_title\": \"System and Method for Image Recognition Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition utilizing deep convolutional neural networks. The system processes images to identify objects with high accuracy. The method involves training a network on a large dataset of labeled images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9012345B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising a convolutional neural network.\",\n        \"A method for training an image recognition system.\",\n        \"A non-transitory computer-readable medium storing instructions for image recognition.\",\n        \"The system of claim 1, wherein the convolutional neural network comprises multiple layers.\",\n        \"The method of claim 2, further comprising pre-processing the image data.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69002", "text": "{\n    \"patent_title\": \"Method for Enhancing Audio Quality in Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Apple Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-09-01\",\n    \"filing_date\": \"2017-09-01\",\n    \"issue_date\": \"2019-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for improving the quality of audio signals received by mobile devices. This includes noise reduction and signal amplification techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for audio signal processing.\",\n        \"A mobile device configured to implement the method.\",\n        \"A system for improving audio clarity.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69003", "text": "{\n    \"patent_title\": \"Wireless Sensor Network for Environmental Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless sensor network is disclosed for monitoring environmental conditions such as temperature, humidity, and air quality. The network utilizes low-power sensors and a centralized data processing system.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor network comprising a plurality of sensor nodes.\",\n        \"A method for monitoring environmental conditions using a wireless sensor network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69003", "text": "{\n    \"patent_title\": \"Implantable Medical Sensor for Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-01-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable sensor for continuous glucose monitoring in diabetic patients. The sensor transmits data wirelessly to an external receiver.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US8234567B1\",\n            \"relevance\": \"medical device\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable glucose sensor.\",\n        \"A method for continuous glucose monitoring.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69004", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor for Biomedical Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"David Chen\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor is disclosed. The sensor is designed for implantable biomedical applications and uses low-power communication protocols.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in pressure sensing\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising...\",\n        \"A system for measuring pressure using the sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69004", "text": "{\n    \"patent_title\": \"Novel Temperature Sensor Design\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-10\",\n    \"filing_date\": \"2017-03-10\",\n    \"issue_date\": \"2018-07-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new temperature sensor design utilizing advanced materials is disclosed. The sensor exhibits high sensitivity and fast response time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related temperature sensing techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A temperature sensor comprising...\",\n        \"A method for measuring temperature using the sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69005", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Processing Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2017-05-15\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method and system for enhanced image processing utilizing deep learning techniques. It improves image clarity and reduces noise, enabling more accurate object detection in various applications. The core of the invention lies in a new convolutional neural network architecture.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US9345678B1\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US9567890B2\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US9789012B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image...\",\n        \"A system comprising...\",\n        \"The method of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69005", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2018-11-01\",\n    \"issue_date\": \"2020-09-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved battery management system for electric vehicles. The system enhances battery life and improves safety by dynamically adjusting charging and discharging parameters. It also incorporates advanced thermal management techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US9987654B2\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US10012345B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"The system of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69006", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Recognition Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-06-20\",\n    \"issue_date\": \"2021-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for enhancing image recognition accuracy using deep convolutional neural networks. The system incorporates a new loss function to improve performance on challenging datasets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"title\": \"Convolutional Neural Networks for Image Classification\"\n        },\n        {\n            \"patent_number\": \"US1012345678B2\",\n            \"title\": \"Image Segmentation Using Deep Learning\"\n        },\n        {\n            \"patent_number\": \"US1122334455B2\",\n            \"title\": \"Object Detection in Images\"\n        },\n        {\n            \"patent_number\": \"US1211223344B2\",\n            \"title\": \"Image Enhancement Techniques\"\n        },\n        {\n            \"patent_number\": \"US1313131313B2\",\n            \"title\": \"Generative Adversarial Networks for Image Synthesis\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image recognition...\",\n        \"A system comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69006", "text": "{\n    \"patent_title\": \"Digital Image Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2022-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new digital image compression technique that reduces file size while maintaining acceptable image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"JPEG Image Compression Standard\"\n        },\n        {\n            \"patent_number\": \"US9123456789B2\",\n            \"title\": \"Wavelet-Based Image Compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing digital images...\",\n        \"An apparatus for performing image compression...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69007", "text": "{\n    \"patent_title\": \"Method and System for Neural Network-Based Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-14\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for image recognition utilizing a deep convolutional neural network architecture. The system achieves high accuracy in classifying images with complex patterns.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Image Processing System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69007", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Tesla\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2010-12-01\",\n    \"filing_date\": \"2010-12-01\",\n    \"issue_date\": \"2018-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system optimized for electric vehicles, providing increased efficiency and longevity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B2\",\n            \"title\": \"Battery Charging Circuit\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for managing battery charge comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69008", "text": "{\n    \"patent_title\": \"Neural Network Based Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-11-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-05-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel neural network architecture for robust image recognition. It utilizes a convolutional neural network combined with a recurrent neural network for improved accuracy and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10245678B1\",\n            \"title\": \"Convolutional Neural Network for Object Detection\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A neural network architecture...\",\n        \"A method for training a neural network...\",\n        \"A computer-readable medium storing...\",\n        \"The system of claim 1, wherein the neural network...\",\n        \"The method of claim 3, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69008", "text": "{\n    \"patent_title\": \"Improved Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2019-08-20\",\n    \"filing_date\": \"2020-12-01\",\n    \"issue_date\": \"2021-08-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents an improved data compression algorithm that reduces file sizes while maintaining data integrity. It employs a combination of Huffman coding and run-length encoding.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"title\": \"Adaptive Huffman Coding\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising...\",\n        \"A data compression system...\",\n        \"A computer-readable medium storing...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69009", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel electrode materials for lithium-ion batteries, exhibiting improved energy density and cycle life. The materials comprise a composite structure of nickel-rich layered oxides with a protective coating.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an anode, a cathode, and an electrolyte.\",\n        \"The lithium-ion battery of claim 1, wherein the cathode comprises a nickel-rich layered oxide.\",\n        \"The lithium-ion battery of claim 2, wherein the nickel-rich layered oxide is coated with a protective layer.\",\n        \"The lithium-ion battery of claim 3, wherein the protective layer comprises a metal oxide.\",\n        \"The lithium-ion battery of claim 4, wherein the metal oxide is aluminum oxide.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69009", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Min Soo Kim\",\n            \"affiliation\": \"Samsung Electronics\"\n        },\n        {\n            \"name\": \"Ji Hoon Park\",\n            \"affiliation\": \"Samsung SDI\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system for lithium-ion batteries is disclosed. The system includes circuitry for monitoring voltage, current, and temperature, and for controlling charging and discharging processes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising a voltage monitoring circuit.\",\n        \"The battery management system of claim 1, further comprising a current monitoring circuit.\",\n        \"The battery management system of claim 2, further comprising a temperature monitoring circuit.\",\n        \"The battery management system of claim 3, further comprising a control circuit.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69010", "text": "{\n    \"patent_title\": \"System and Method for Deep Learning-Based Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition utilizing a deep neural network architecture. The system processes image data and identifies objects within the image with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising a deep neural network...\",\n        \"A method for processing image data using a neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69010", "text": "{\n    \"patent_title\": \"Method for Enhanced Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for data compression utilizing a series of mathematical transformations to reduce file size.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising a transformation step...\",\n        \"A system for compressing data using a specified algorithm...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69011", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-10\",\n    \"filing_date\": \"2015-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery management system that improves efficiency and lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Battery Charging Circuit\"\n        },\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"title\": \"Energy Storage Device\"\n        },\n        {\n            \"patent_number\": \"US9234567B1\",\n            \"title\": \"Power Regulation System\"\n        },\n        {\n            \"patent_number\": \"US9345678B2\",\n            \"title\": \"Thermal Management for Batteries\"\n        },\n        {\n            \"patent_number\": \"US9456789B1\",\n            \"title\": \"Battery Optimization Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"The system of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69011", "text": "{\n    \"patent_title\": \"Wireless Communication Protocol\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Emily Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2016-01-05\",\n    \"filing_date\": \"2016-08-20\",\n    \"issue_date\": \"2019-04-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved wireless communication protocol for enhanced data transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B1\",\n            \"title\": \"Wireless Data Transmission\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Communication Network Protocol\"\n        },\n        {\n            \"patent_number\": \"US9234567B1\",\n            \"title\": \"Data Encryption Method\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication protocol comprising...\",\n        \"The protocol of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69012", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved electrode material for lithium-ion batteries, exhibiting enhanced energy density and cycle life. The material comprises a novel composite structure incorporating nano-sized particles within a conductive matrix.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode material...\",\n        \"The electrode material according to claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69012", "text": "{\n    \"patent_title\": \"Novel Polymer Electrolyte for Solid-State Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel polymer electrolyte for solid-state batteries, offering improved safety and stability compared to conventional liquid electrolytes. The electrolyte exhibits high ionic conductivity and excellent mechanical properties.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A solid-state battery comprising a polymer electrolyte...\",\n        \"The polymer electrolyte according to claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69013", "text": "{\n    \"patent_title\": \"System and Method for Image Recognition Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2018-01-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition using deep convolutional neural networks are disclosed. The system comprises a plurality of convolutional layers, pooling layers, and fully connected layers configured to extract features from input images and classify the images based on the extracted features. The method utilizes backpropagation to train the neural network.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69013", "text": "{\n    \"patent_title\": \"Advanced Image Processing Techniques\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"IBM Research\"\n        },\n        {\n            \"name\": \"Eve Wilson\",\n            \"affiliation\": \"Microsoft Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-03-10\",\n    \"filing_date\": \"2016-03-10\",\n    \"issue_date\": \"2019-04-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes advanced image processing techniques for enhancing image quality and reducing noise. It includes various filtering algorithms and image compression methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image quality comprising...\",\n        \"An image processing system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69014", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Processing in Surveillance Systems\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"TechCorp Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2018-11-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method and system for enhanced image processing in surveillance applications. The system utilizes advanced algorithms to improve image clarity and object recognition in real-time, providing improved security and monitoring capabilities. The processing is specifically designed for outdoor environments and addresses issues related to lighting and weather conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related art in image enhancement\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image clarity in surveillance systems.\",\n        \"A system for real-time object recognition in video streams.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69014", "text": "{\n    \"patent_title\": \"Medical Image Analysis System Using Advanced Processing Techniques\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Medical Imaging Solutions\"\n        },\n        {\n            \"name\": \"David Rodriguez\",\n            \"affiliation\": \"Johns Hopkins University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-04-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel medical image analysis system utilizing advanced image processing techniques for the detection of anomalies in X-ray and MRI scans. The system provides enhanced diagnostic accuracy and improved workflow for radiologists.  Specifically focused on identifying tumors and lesions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Prior art in medical image segmentation\"\n        }\n    ],\n    \"claims\": [\n        \"A system for detecting anomalies in medical images.\",\n        \"A method for improving the accuracy of medical diagnoses using image processing.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69015", "text": "{\n    \"patent_title\": \"Novel Polymer Composite for High-Strength Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-06-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel polymer composite material exhibiting exceptional strength and durability. The composite utilizes a unique blend of polymers and reinforcing fibers, resulting in a material suitable for use in aerospace and automotive applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A polymer composite material comprising...\",\n        \"A method for manufacturing the polymer composite...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69015", "text": "{\n    \"patent_title\": \"Advanced Sensor Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-12-10\",\n    \"filing_date\": \"2017-12-10\",\n    \"issue_date\": \"2020-01-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel sensor capable of detecting minute changes in temperature and pressure. The sensor utilizes microfabrication techniques to achieve high sensitivity and accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10112233B2\"\n        }\n    ],\n    \"claims\": [\n        \"A sensor comprising...\",\n        \"A method for detecting changes in temperature...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69016", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Intel Corporation\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications. The sensor utilizes MEMS technology and transmits data wirelessly to a base station. The system is designed for high accuracy and low power consumption.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Wireless Sensor Network\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for transmitting pressure data wirelessly...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69016", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-09\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system designed to optimize the performance and lifespan of lithium-ion batteries. The system includes advanced algorithms for charging and discharging control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Lithium-Ion Battery Charging Circuit\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling the charging of a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69017", "text": "{\n    \"patent_title\": \"Method and System for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method and system for image recognition utilizing artificial intelligence techniques, specifically deep convolutional neural networks. The system achieves state-of-the-art accuracy in identifying objects within images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Prior Art Image Recognition System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69017", "text": "{\n    \"patent_title\": \"Improved Battery Life for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Williams\",\n            \"affiliation\": \"Apple Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-12-10\",\n    \"filing_date\": \"2019-12-10\",\n    \"issue_date\": \"2021-05-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved battery management system for mobile devices, enhancing battery life and performance. The system utilizes advanced charging algorithms and power optimization techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Prior Art Battery Management System\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A mobile device comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69018", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2015-03-15\",\n    \"filing_date\": \"2015-05-20\",\n    \"issue_date\": \"2018-07-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system is disclosed. The system utilizes a novel MEMS sensor and low-power communication protocols for remote monitoring of pressure levels. The device is intended for use in medical applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for remotely monitoring pressure levels...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69018", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2017-02-15\",\n    \"issue_date\": \"2019-04-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles is presented. This system optimizes charging and discharging cycles to extend battery life and enhance performance. It features advanced thermal management techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"relevance\": \"Related Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69019", "text": "{\n    \"patent_title\": \"Method for Real-time Anomaly Detection using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method for real-time anomaly detection in time-series data using machine learning algorithms. The system is capable of identifying unusual patterns and alerting users to potential issues. It leverages artificial intelligence to improve accuracy and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting anomalies in time-series data comprising...\",\n        \"The method of claim 1, wherein the machine learning algorithm is a support vector machine.\",\n        \"The method of claim 1, wherein the anomaly detection is performed in real-time.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69019", "text": "{\n    \"patent_title\": \"Deep Learning Framework for Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Facebook AI Research\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a deep learning framework for improving the accuracy and efficiency of image recognition tasks. The framework utilizes convolutional neural networks and large datasets to achieve state-of-the-art performance. It leverages artificial intelligence and specifically deep learning techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A deep learning framework for image recognition comprising...\",\n        \"The framework of claim 1, wherein the deep learning model is a convolutional neural network.\",\n        \"The framework of claim 1, wherein the framework is trained using a dataset of labeled images with deep learning optimization techniques.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69020", "text": "{\n    \"patent_title\": \"Method and System for AI-Powered Personalized Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for personalized learning using artificial intelligence algorithms to adapt to individual student needs and learning styles. The system analyzes student performance data and adjusts the difficulty and content of learning materials accordingly.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for personalized learning comprising...\",\n        \"A system for adaptive content delivery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69020", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Emily Davis\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-01-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a battery management system for electric vehicles, improving energy efficiency and lifespan. The system employs advanced charging algorithms and thermal management techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69021", "text": "{\n    \"patent_title\": \"System and Method for Predictive Maintenance Using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2018-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for predictive maintenance utilizing machine learning algorithms to analyze sensor data and predict potential equipment failures. The system improves operational efficiency and reduces downtime.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related to data analysis techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predictive maintenance comprising...\",\n        \"A method for analyzing sensor data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69021", "text": "{\n    \"patent_title\": \"Improved Medical Diagnostic Device Using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"MedTech Solutions\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"MedTech Solutions\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-02-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved medical diagnostic device utilizing machine learning algorithms to analyze patient data for enhanced diagnostic accuracy. The device aids in the early detection of diseases.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Prior art in medical imaging\"\n        },\n        {\n            \"patent_number\": \"US8234567B1\",\n            \"relevance\": \"Related to medical sensor technology\"\n        }\n    ],\n    \"claims\": [\n        \"A medical diagnostic device comprising...\",\n        \"A method for analyzing patient data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69022", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved lithium-ion battery design with enhanced thermal stability and cycle life. The battery utilizes a novel electrolyte composition and electrode materials. A significant increase in energy density and power output is achieved.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Lithium-Ion Battery Electrode Material\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"The battery of claim 1, wherein...\",\n        \"An electrolyte composition for a lithium-ion battery...\",\n        \"A method of manufacturing a lithium-ion battery...\",\n        \"The method of claim 4, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69022", "text": "{\n    \"patent_title\": \"Novel Polymer Electrolyte for Solid-State Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-03-01\",\n    \"filing_date\": \"2021-04-15\",\n    \"issue_date\": \"2023-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel polymer electrolyte for use in solid-state batteries. The electrolyte exhibits high ionic conductivity and improved safety characteristics compared to conventional liquid electrolytes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"title\": \"Solid-State Battery Design\"\n        }\n    ],\n    \"claims\": [\n        \"A solid-state battery comprising...\",\n        \"The battery of claim 1, wherein...\",\n        \"A polymer electrolyte for a solid-state battery...\",\n        \"A method of assembling a solid-state battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69023", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2015-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery management system for electric vehicles, improving energy efficiency and lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"Cited by Examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"The system of claim 1, further comprising...\",\n        \"The system of claim 2, wherein...\",\n        \"A method for managing a battery...\",\n        \"The method of claim 4, further comprising...\",\n        \"The method of claim 5, wherein...\",\n        \"The method of claim 6, wherein...\"\n    ]\n}"}
