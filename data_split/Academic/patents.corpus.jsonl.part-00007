{"_id": "Academic--patents--p--66832", "text": "{\n    \"patent_title\": \"System and method for dynamic resource allocation in a cloud computing environment\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2021-11-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for dynamically allocating resources in a cloud computing environment based on real-time demand and resource availability. The system utilizes machine learning algorithms to predict future resource needs and optimize allocation accordingly.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Cloud resource management\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Dynamic scaling in cloud environments\"\n        },\n        {\n            \"patent_number\": \"US11000001B2\",\n            \"title\": \"Machine learning for resource prediction\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Efficient cloud resource provisioning\"\n        },\n        {\n            \"patent_number\": \"US10234567B2\",\n            \"title\": \"Adaptive resource allocation\"\n        }\n    ],\n    \"claims\": [\n        \"A method for dynamically allocating resources in a cloud computing environment...\",\n        \"A system comprising a resource prediction module...\",\n        \"The method of claim 1, wherein the resource prediction module utilizes a machine learning algorithm...\"\n    ]\n}"}
