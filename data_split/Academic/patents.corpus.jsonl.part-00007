{"_id": "Academic--patents--p--66159", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Data Security in Cloud Computing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-10\",\n    \"filing_date\": \"2015-02-15\",\n    \"issue_date\": \"2018-04-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for providing enhanced data security in cloud computing environments is disclosed. The system utilizes a combination of encryption and access control mechanisms to protect sensitive data stored in the cloud.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Method for Secure Data Storage\"\n        }\n    ],\n    \"claims\": [\n        \"A system for securing data in a cloud computing environment, comprising...\",\n        \"A method for encrypting data prior to storage in a cloud...\"\n    ]\n}"}
