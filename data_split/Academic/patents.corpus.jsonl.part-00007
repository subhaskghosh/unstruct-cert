{"_id": "Academic--patents--p--66097", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Improved Electrolyte\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a lithium-ion battery with an improved electrolyte formulation, resulting in increased energy density and cycle life. The electrolyte includes a novel additive that enhances ionic conductivity and reduces dendrite formation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte formulation...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66097", "text": "{\n    \"patent_title\": \"Solar Cell Enhancement Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel method for enhancing the efficiency of solar cells by incorporating a new layer of light-trapping material. The method utilizes nanoscale structures to improve light absorption.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A solar cell comprising...\",\n        \"A light-trapping layer...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66098", "text": "{\n    \"patent_title\": \"Method and System for Neural Network Based Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2008-05-15\",\n    \"filing_date\": \"2009-03-10\",\n    \"issue_date\": \"2019-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for image recognition using a deep neural network architecture. The system is capable of identifying objects within images with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Image Processing System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66098", "text": "{\n    \"patent_title\": \"Wireless Communication System with Enhanced Security\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2007-11-22\",\n    \"filing_date\": \"2008-05-01\",\n    \"issue_date\": \"2018-12-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless communication system designed to provide enhanced security through encryption and authentication protocols. It improves data transmission reliability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B2\",\n            \"title\": \"Data Encryption Method\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication system comprising...\",\n        \"A method for secure data transmission comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66099", "text": "{\n    \"patent_title\": \"System and Method for Predictive Maintenance Using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for predictive maintenance of industrial equipment utilizing machine learning algorithms to analyze sensor data and predict potential failures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on sensor data analysis\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for predictive maintenance comprising...\",\n        \"2. The system of claim 1, wherein the machine learning algorithm is a neural network.\",\n        \"3. A method for predicting equipment failure...\",\n        \"4. The method of claim 3, further comprising...\",\n        \"5. The system of claim 1, wherein the sensor data includes temperature readings.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66099", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Energy Solutions Corp.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-03-01\",\n    \"filing_date\": \"2020-04-15\",\n    \"issue_date\": \"2021-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved battery management system for electric vehicles, enhancing battery life and performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art on battery charging algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"1. A battery management system comprising...\",\n        \"2. The system of claim 1, further comprising a temperature sensor.\",\n        \"3. A method for controlling battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66100", "text": "{\n    \"patent_title\": \"System and method for dynamic resource allocation in cloud computing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for dynamically allocating resources in a cloud computing environment based on real-time demand and resource availability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        },\n        {\n            \"patent_number\": \"US7654321B1\"\n        },\n        {\n            \"patent_number\": \"US9876542B2\"\n        },\n        {\n            \"patent_number\": \"US8901234B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for dynamically allocating resources in a cloud computing environment.\",\n        \"A system for managing resource allocation in a cloud computing environment.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66100", "text": "{\n    \"patent_title\": \"Method for improved image compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for compressing images using a wavelet transform and entropy encoding.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9012345B1\"\n        },\n        {\n            \"patent_number\": \"US8765431B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing images.\",\n        \"A system for image compression.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66101", "text": "{\n    \"patent_title\": \"Improved Machine Learning Algorithm for Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-12-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel machine learning algorithm for enhancing image recognition accuracy, particularly in low-light conditions. The algorithm utilizes a convolutional neural network with a unique attention mechanism.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for image recognition comprising...\",\n        \"2. The method of claim 1, wherein...\",\n        \"3. A system for image recognition...\",\n        \"4. The system of claim 3, wherein...\",\n        \"5. A computer-readable medium...\",\n        \"6. The computer-readable medium of claim 5, wherein...\",\n        \"7. The method of claim 1, further comprising...\",\n        \"8. The system of claim 3, further comprising...\",\n        \"9. A neural network architecture...\",\n        \"10. The neural network architecture of claim 9, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66101", "text": "{\n    \"patent_title\": \"System for Data Storage\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"IBM\"\n        }\n    ],\n    \"patent_number\": \"US11890123B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2021-01-10\",\n    \"issue_date\": \"2023-04-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for efficiently storing and retrieving data utilizing a distributed network. The system is designed for high scalability and reliability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related technology in distributed systems\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for data storage comprising...\",\n        \"2. The system of claim 1, wherein...\",\n        \"3. A method for retrieving data...\",\n        \"4. The method of claim 3, wherein...\",\n        \"5. A network architecture...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66102", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Data Encryption\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-05-20\",\n    \"issue_date\": \"2018-07-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel system and method for encrypting data using a combination of symmetric and asymmetric cryptography, improving security and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for encrypting data comprising...\",\n        \"A system for encrypting data comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66102", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2011-01-25\",\n    \"filing_date\": \"2011-03-10\",\n    \"issue_date\": \"2019-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new battery technology offering increased energy density and lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising...\",\n        \"A battery system comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66103", "text": "{\n    \"patent_title\": \"System and Method for Image Recognition Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-14\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition employing deep convolutional neural networks. The system includes a training phase where the network learns to identify patterns and features in images, and a recognition phase where the trained network classifies new images. This improves accuracy and speed in image recognition tasks.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Image Processing System\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising a convolutional neural network...\",\n        \"A method for training a convolutional neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66103", "text": "{\n    \"patent_title\": \"Method for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-12-01\",\n    \"filing_date\": \"2009-12-01\",\n    \"issue_date\": \"2018-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for compressing data using Huffman coding and run-length encoding. This method significantly reduces the size of data files, enabling faster transmission and storage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"title\": \"Data Encoding Scheme\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising the steps of Huffman coding and run-length encoding...\",\n        \"A system for data compression implementing the aforementioned method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66104", "text": "{\n    \"patent_title\": \"System and Method for Predictive Maintenance using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2018-03-01\",\n    \"issue_date\": \"2019-04-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for predicting equipment failures using machine learning algorithms. The system analyzes sensor data and historical maintenance records to identify patterns indicative of impending failures, enabling proactive maintenance scheduling.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related art in predictive maintenance\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predicting equipment failure comprising: a sensor data acquisition module...\",\n        \"A method for predictive maintenance...\",\n        \"The system of claim 1, wherein the machine learning algorithm is a neural network.\",\n        \"The method of claim 2, further comprising...\",\n        \"The system of claim 1, wherein the sensor data includes temperature, pressure, and vibration data.\",\n        \"The method of claim 2, wherein the historical maintenance records include repair logs.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66104", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Cycling Solutions Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2018-05-10\",\n    \"filing_date\": \"2018-08-15\",\n    \"issue_date\": \"2020-01-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an improved bicycle brake system utilizing a novel cable tensioning mechanism for enhanced stopping power and reliability. It addresses issues with cable stretch and corrosion.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art related to bicycle braking systems\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle brake system comprising: a brake lever...\",\n        \"A cable tensioning mechanism for use in a bicycle brake system...\",\n        \"The brake lever of claim 1, wherein the lever is ergonomically designed.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66105", "text": "{\n    \"patent_title\": \"System and method for dynamic content delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-05-15\",\n    \"filing_date\": \"2010-03-20\",\n    \"issue_date\": \"2019-02-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for dynamically delivering content to users based on their preferences and network conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Method for personalized content recommendation\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"title\": \"System for adaptive bitrate streaming\"\n        }\n    ],\n    \"claims\": [\n        \"A system for dynamically delivering content...\",\n        \"A method comprising steps for determining user preferences...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66105", "text": "{\n    \"patent_title\": \"Improved battery technology for mobile devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Energy Solutions Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2008-11-01\",\n    \"filing_date\": \"2009-12-10\",\n    \"issue_date\": \"2012-05-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery technology offering increased energy density and lifespan for mobile devices.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A battery cell comprising...\",\n        \"A mobile device including the battery cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66106", "text": "{\n    \"patent_title\": \"System and method for dynamic resource allocation in cloud computing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2018-05-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for dynamically allocating resources in a cloud computing environment. The system monitors resource usage and adjusts allocations in real-time to optimize performance and cost.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"type\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for dynamically allocating resources in a cloud computing environment...\",\n        \"A system comprising a resource monitor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66106", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2009-12-10\",\n    \"filing_date\": \"2009-12-10\",\n    \"issue_date\": \"2012-07-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery technology utilizing new materials to increase energy density and lifespan in mobile devices.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A battery comprising a novel cathode material...\",\n        \"A mobile device incorporating the battery...\"\n    ]\n}"}
