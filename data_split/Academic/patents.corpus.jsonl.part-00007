{"_id": "Academic--patents--p--66677", "text": "{\n    \"patent_title\": \"System and Method for Predictive Maintenance using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2012-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for predicting equipment failures using machine learning algorithms. The system analyzes sensor data to identify patterns indicative of potential failures, enabling proactive maintenance and reducing downtime.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for predicting equipment failures comprising...\",\n        \"2. The system of claim 1, wherein the machine learning algorithm is a neural network.\",\n        \"3. A method for predicting equipment failures...\",\n        \"4. The method of claim 3, further comprising...\",\n        \"5. The system of claim 1, wherein the sensor data includes...\",\n        \"6. The method of claim 3, wherein the predictive model is updated periodically.\",\n        \"7. A computer-readable medium storing instructions for...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66677", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Independent Inventor\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2011-05-10\",\n    \"filing_date\": \"2011-05-10\",\n    \"issue_date\": \"2013-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved bicycle brake system offering enhanced stopping power and reliability. It features a novel cable tensioning mechanism and ergonomic lever design.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8234567B2\"\n        }\n    ],\n    \"claims\": [\n        \"1. A bicycle brake system comprising...\",\n        \"2. The brake system of claim 1, wherein the cable tensioning mechanism...\",\n        \"3. A lever for use with a bicycle brake system...\",\n        \"4. The lever of claim 3, wherein the lever is ergonomically designed.\"\n    ]\n}"}
