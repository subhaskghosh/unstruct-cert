{"_id": "Academic--patents--p--66469", "text": "{\n    \"patent_title\": \"Improved Electrolyte Composition for High-Performance Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel electrolyte composition for lithium-ion batteries, enhancing their energy density and cycle life. The composition comprises a unique blend of solvents and lithium salts, resulting in improved ionic conductivity and electrochemical stability. Applications include portable electronics and grid-scale energy storage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Lithium Iron Phosphate Cathode Material\"\n        },\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"title\": \"Electrolyte Additives for Lithium-Ion Batteries\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrolyte composition...\",\n        \"The electrolyte composition comprising a solvent blend...\",\n        \"A method for manufacturing a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66469", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tesla, Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Tesla, Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-05-20\",\n    \"issue_date\": \"2019-10-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a battery management system (BMS) for lithium-ion batteries used in electric vehicles. The BMS monitors and controls the battery's voltage, current, and temperature to ensure safe and efficient operation. The system includes algorithms for state-of-charge estimation and cell balancing, maximizing the battery's performance and lifespan in automotive applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Electric Vehicle Powertrain Control System\"\n        },\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"title\": \"Battery Thermal Management System for Electric Vehicles\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for an electric vehicle...\",\n        \"The battery management system comprising a voltage monitoring circuit...\",\n        \"A method for controlling a lithium-ion battery in an electric vehicle...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66470", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-03-15\",\n    \"filing_date\": \"2010-05-20\",\n    \"issue_date\": \"2018-11-13\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel data compression system utilizing advanced algorithms to achieve high compression ratios while maintaining data integrity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data comprising...\",\n        \"A system for decompressing data comprising...\"\n    ]\n}"}
