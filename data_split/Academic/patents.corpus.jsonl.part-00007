{"_id": "Academic--patents--p--66226", "text": "{\n    \"patent_title\": \"Miniature Implantable Cardiac Monitor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Medtronic Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature implantable cardiac monitor for long-term monitoring of heart activity, with wireless data transmission capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in implantable medical devices\"\n        }\n    ],\n    \"claims\": [\n        \"A miniature implantable cardiac monitor comprising...\",\n        \"A wireless communication module for transmitting heart activity data...\",\n        \"A power source for providing energy to the monitor...\",\n        \"A data processing unit for analyzing heart activity data...\",\n        \"A method for wirelessly monitoring heart activity...\",\n        \"The monitor as claimed in claim 1, wherein the wireless communication module utilizes Bluetooth technology.\",\n        \"The monitor as claimed in claim 2, wherein the power source is a rechargeable battery.\"\n    ]\n}"}
