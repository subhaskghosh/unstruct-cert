{"_id": "Academic--patents--n--66077", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Cycle Dynamics Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2018-08-22\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2020-12-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a bicycle brake system with enhanced stopping power and improved modulation. The design incorporates a new lever mechanism and pad material for optimal performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Existing brake technology.\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle brake system comprising...\",\n        \"A lever mechanism for improved modulation...\"\n    ]\n}"}
