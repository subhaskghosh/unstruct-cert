{"_id": "Academic--patents--p--66709", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery with Enhanced Cycle Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved lithium-ion battery design featuring a novel electrolyte composition and electrode structure, resulting in enhanced cycle life and energy density. The battery is suitable for electric vehicles and grid-scale energy storage applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66709", "text": "{\n    \"patent_title\": \"Sodium-Ion Battery with Organic Electrolyte\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-20\",\n    \"filing_date\": \"2019-05-20\",\n    \"issue_date\": \"2024-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a sodium-ion battery utilizing a novel organic electrolyte, offering a sustainable and cost-effective alternative to lithium-ion batteries. It exhibits promising performance in terms of energy density and safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A sodium-ion battery comprising...\",\n        \"An organic electrolyte composition for a sodium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66710", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing image recognition accuracy using deep convolutional neural networks. The system includes a pre-processing module, a feature extraction module, and a classification module.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Classification System\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Deep Learning Architecture for Image Analysis\"\n        },\n        {\n            \"patent_number\": \"US11234567B1\",\n            \"title\": \"Convolutional Neural Network Optimization\"\n        },\n        {\n            \"patent_number\": \"US12345678B1\",\n            \"title\": \"Real-time Image Processing\"\n        },\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Data Augmentation for Image Recognition\"\n        }\n    ],\n    \"claims\": [\n        \"A system for enhanced image recognition comprising...\",\n        \"A method for processing images using a deep neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66710", "text": "{\n    \"patent_title\": \"Improved Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Motors\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2018-12-01\",\n    \"filing_date\": \"2021-01-10\",\n    \"issue_date\": \"2023-06-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system designed to optimize the performance and lifespan of lithium-ion batteries in electric vehicles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\",\n            \"title\": \"Lithium-ion Battery Charging Control\"\n        },\n        {\n            \"patent_number\": \"US87654321B1\",\n            \"title\": \"Battery Monitoring System\"\n        },\n        {\n            \"patent_number\": \"US98765432B2\",\n            \"title\": \"Thermal Management of Batteries\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising a voltage sensor...\",\n        \"A method for controlling the charging of a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66711", "text": "{\n    \"patent_title\": \"System and Method for Anomaly Detection Using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-06-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for anomaly detection in time series data using machine learning algorithms, specifically recurrent neural networks, are disclosed. The system is capable of identifying unusual patterns and predicting potential failures in complex systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"type\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for anomaly detection comprising...\",\n        \"2. A system for anomaly detection comprising...\",\n        \"3. The method of claim 1, wherein...\",\n        \"4. The system of claim 2, wherein...\",\n        \"5. The method of claim 1, further comprising...\",\n        \"6. The system of claim 2, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66711", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2021-01-20\",\n    \"filing_date\": \"2021-05-15\",\n    \"issue_date\": \"2022-02-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) for electric vehicles, designed to optimize battery life and performance through advanced charging algorithms.\",\n    \"citations\": [],\n    \"claims\": [\n        \"1. A battery management system comprising...\",\n        \"2. The system of claim 1, wherein...\",\n        \"3. The system of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66712", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor for Intracranial Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor is disclosed for continuous intracranial pressure monitoring. The sensor comprises a MEMS pressure transducer, a wireless communication module, and a biocompatible housing. This device is designed for minimally invasive implantation and provides real-time data transmission for improved patient care in neurosurgical applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art in wireless sensors\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising: a MEMS pressure transducer; a wireless communication module; and a biocompatible housing.\",\n        \"The sensor of claim 1, wherein the wireless communication module is configured to transmit data via Bluetooth.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66712", "text": "{\n    \"patent_title\": \"Improved Automotive Fuel Injection System\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Brown\",\n            \"affiliation\": \"Ford Motor Company\"\n        }\n    ],\n    \"patent_number\": \"US8901234B1\",\n    \"priority_date\": \"2009-12-01\",\n    \"filing_date\": \"2009-12-01\",\n    \"issue_date\": \"2015-04-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved fuel injection system for internal combustion engines is described. The system utilizes a novel nozzle design and electronic control algorithm to optimize fuel atomization and combustion efficiency. It leads to reduced emissions and increased fuel economy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"relevance\": \"Previous fuel injection technologies\"\n        }\n    ],\n    \"claims\": [\n        \"A fuel injection system comprising: a fuel nozzle; an electronic control unit; and a fuel pump.\",\n        \"The fuel injection system of claim 1, wherein the fuel nozzle is configured to atomize fuel into droplets less than 10 microns in diameter.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66713", "text": "{\n    \"patent_title\": \"Method and System for Efficient Image Segmentation\",\n    \"inventors\": [\n        {\n            \"name\": \"Mark Horowitz\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Percy Liang\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for efficiently segmenting images using deep learning techniques. The system improves upon existing methods by reducing computational cost and increasing accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image segmentation comprising...\",\n        \"A system for image segmentation comprising...\"\n    ]\n}"}
