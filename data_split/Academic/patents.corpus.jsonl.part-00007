{"_id": "Academic--patents--p--66718", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for enhancing the resolution of digital images using deep convolutional neural networks. The system employs a novel loss function to improve perceptual quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image super-resolution.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising: training a deep convolutional neural network...\",\n        \"The method of claim 1, wherein the deep convolutional neural network...\",\n        \"A system for enhancing image resolution...\",\n        \"The system of claim 3, further comprising...\",\n        \"A non-transitory computer-readable medium...\",\n        \"The computer-readable medium of claim 5...\"\n    ]\n}"}
