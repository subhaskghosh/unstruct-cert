{"_id": "Academic--patents--p--69707", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2018-06-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for remote monitoring applications. The sensor utilizes MEMS technology and a low-power communication protocol.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art in pressure sensing\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising...\",\n        \"A method for remote pressure monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69707", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-05-20\",\n    \"issue_date\": \"2019-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery technology with increased energy density and lifespan. The battery utilizes a new electrolyte material.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"relevance\": \"Previous battery designs\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising...\",\n        \"A method for manufacturing a high-density battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69708", "text": "{\n    \"patent_title\": \"System and Method for Anomaly Detection Using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"IBM Research\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for detecting anomalies in data streams using machine learning algorithms. The system is capable of identifying unusual patterns and predicting potential failures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9785643B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for anomaly detection comprising...\",\n        \"A method for identifying anomalous data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69708", "text": "{\n    \"patent_title\": \"Machine Learning Framework for Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Charles Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Rodriguez\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2019-02-20\",\n    \"filing_date\": \"2019-02-20\",\n    \"issue_date\": \"2021-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A machine learning framework for image recognition, capable of accurately classifying images with high efficiency. Includes novel deep learning architectures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A machine learning framework for image recognition...\",\n        \"A method for classifying images using deep learning...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69709", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-15\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system is described. The system utilizes a MEMS pressure sensor, a low-power transmitter, and a receiver for remote data acquisition. This sensor is designed for biomedical applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising...\",\n        \"A method for remote pressure monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69709", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emily Chen\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2012-05-20\",\n    \"filing_date\": \"2012-05-20\",\n    \"issue_date\": \"2018-01-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system with enhanced charging algorithms and thermal protection features. This system optimizes battery life and safety in electric vehicles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69710", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications. The sensor utilizes a MEMS pressure transducer and transmits data wirelessly to a remote monitoring station. This invention improves upon existing sensor technologies by offering improved sensitivity and reduced power consumption.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Similar pressure sensor design\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"The system of claim 1, wherein the sensor is a MEMS device.\",\n        \"The system of claim 1, further comprising...\",\n        \"A method for measuring pressure using the system of claim 1.\",\n        \"The method of claim 4, wherein the pressure measurement is used for biomedical monitoring.\",\n        \"The method of claim 4, wherein the pressure measurement is used for industrial applications.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69710", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-14\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles. The system optimizes charging and discharging cycles to extend battery life and improve performance. It utilizes advanced algorithms to predict battery degradation and prevent overcharging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related battery technology\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"The system of claim 1, wherein the algorithm predicts battery degradation.\",\n        \"The system of claim 1, further comprising...\",\n        \"A method for managing battery charge using the system of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69711", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhanced image recognition utilizing deep convolutional neural networks is disclosed. The system processes image data to identify objects and patterns with high accuracy. The invention provides improvements in object detection, image classification, and scene understanding.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for image recognition comprising...\",\n        \"2. The system of claim 1, further comprising...\",\n        \"3. A method for image recognition...\",\n        \"4. The method of claim 3, wherein...\",\n        \"5. The system of claim 1, wherein...\",\n        \"6. The method of claim 3, wherein...\",\n        \"7. A computer-readable medium...\"\n    ]\n}"}
