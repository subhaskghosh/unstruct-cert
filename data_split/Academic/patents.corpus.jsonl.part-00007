{"_id": "Academic--patents--p--69795", "text": "{\n    \"patent_title\": \"Neural Network Architecture for Efficient Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel neural network architecture for efficient image recognition. It utilizes a sparse connectivity pattern and a unique activation function to reduce computational complexity while maintaining high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A neural network comprising...\",\n        \"A method for image recognition using the neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69795", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-01-10\",\n    \"filing_date\": \"2022-01-10\",\n    \"issue_date\": \"2024-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles, enhancing energy efficiency and extending battery lifespan. The system incorporates advanced charging algorithms and thermal regulation techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344AA\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69796", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved lithium-ion battery with enhanced stability and cycle life. A novel electrolyte composition is used to mitigate dendrite formation, improving battery safety and performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Lithium-Ion Battery Technology\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition for a lithium-ion battery...\",\n        \"A method for manufacturing a lithium-ion battery...\",\n        \"The lithium-ion battery according to claim 1, wherein...\",\n        \"The electrolyte composition according to claim 2, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69796", "text": "{\n    \"patent_title\": \"Novel Solar Cell Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-03-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a new design for high-efficiency solar cells, utilizing perovskite materials for improved light absorption.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Perovskite Solar Cell Innovations\"\n        }\n    ],\n    \"claims\": [\n        \"A solar cell comprising...\",\n        \"A perovskite material for use in a solar cell...\",\n        \"A method for fabricating a solar cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69797", "text": "{\n    \"patent_title\": \"Method and System for Image Recognition Using Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-14\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for image recognition using deep neural networks. The system utilizes convolutional neural networks to identify objects within images with high accuracy. The method involves training the network on a large dataset of labeled images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"kind\": \"Cited by Applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69797", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-12-01\",\n    \"filing_date\": \"2009-12-01\",\n    \"issue_date\": \"2018-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents an improved algorithm for data compression, significantly reducing file sizes without loss of information. It utilizes a novel encoding scheme based on Huffman coding and Lempel-Ziv variations.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B2\",\n            \"kind\": \"Cited by Examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising...\",\n        \"A system for data compression comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69798", "text": "{\n    \"patent_title\": \"Image Recognition System Using Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition using convolutional neural networks is disclosed. The system utilizes multiple layers of convolutional filters to extract features from input images, and a fully connected layer to classify the images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69798", "text": "{\n    \"patent_title\": \"Method for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-08-01\",\n    \"filing_date\": \"2017-08-01\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel data compression algorithm. It efficiently reduces the size of digital files without significant loss of information.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising...\",\n        \"A system for data compression comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69799", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2019-11-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable biosensor is disclosed for continuous glucose monitoring. The device utilizes a novel enzyme-based sensor and wireless communication for real-time data transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in glucose monitoring\"\n        }\n    ],\n    \"claims\": [\n        \"A biosensor comprising an enzyme-based glucose sensing element.\",\n        \"A wireless communication module for transmitting glucose data.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69799", "text": "{\n    \"patent_title\": \"Surgical Instrument for Minimally Invasive Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11123456B2\",\n    \"priority_date\": \"2019-03-10\",\n    \"filing_date\": \"2019-03-10\",\n    \"issue_date\": \"2021-02-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical instrument designed for minimally invasive procedures, offering improved dexterity and precision. The instrument incorporates a robotic arm and high-resolution imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related prior art in surgical robotics\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising a robotic arm.\",\n        \"A high-resolution imaging system integrated with the surgical instrument.\"\n    ]\n}"}
