{"_id": "Academic--patents--p--66575", "text": "{\n    \"patent_title\": \"System and Method for Machine Learning-Based Fraud Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2018-02-10\",\n    \"issue_date\": \"2020-05-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for detecting fraudulent transactions using machine learning algorithms. The system analyzes transaction data to identify patterns indicative of fraud, thereby enhancing security and reducing financial losses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Fraud Detection System\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for detecting fraudulent transactions comprising...\",\n        \"2. The system of claim 1, further comprising...\",\n        \"3. A method for detecting fraudulent transactions...\",\n        \"4. The method of claim 3, wherein...\",\n        \"5. The system of claim 1, wherein the machine learning algorithm is a neural network.\",\n        \"6. The method of claim 3, wherein the machine learning algorithm is a support vector machine.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66575", "text": "{\n    \"patent_title\": \"Improved Battery Life for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MobileTech Corp\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-03-01\",\n    \"filing_date\": \"2019-04-15\",\n    \"issue_date\": \"2021-11-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to improvements in battery technology for mobile devices, focusing on enhanced energy storage and reduced power consumption. A novel cell structure and charging algorithm are presented.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Lithium-Ion Battery Technology\"\n        }\n    ],\n    \"claims\": [\n        \"1. A battery cell for a mobile device comprising...\",\n        \"2. The battery cell of claim 1, wherein...\",\n        \"3. A charging algorithm for a mobile device battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66576", "text": "{\n    \"patent_title\": \"System and Method for Dynamic Resource Allocation in Cloud Computing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for dynamically allocating resources in a cloud computing environment based on real-time demand and predictive analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Resource Management in Data Centers\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Scalable Cloud Architecture\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Virtual Machine Migration\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Dynamic Load Balancing\"\n        },\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"title\": \"Cloud Storage Systems\"\n        }\n    ],\n    \"claims\": [\n        \"A method for dynamically allocating resources in a cloud computing environment.\",\n        \"A system comprising a resource allocation module and a demand prediction module.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66576", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Independent Inventor\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-02-15\",\n    \"issue_date\": \"2020-07-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved bicycle brake system providing enhanced stopping power and safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Bicycle Brake Caliper Design\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Hydraulic Brake Systems\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle brake system comprising an improved caliper design.\",\n        \"A method for enhancing braking performance in bicycles.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66577", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Wireless Communication Reliability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Qualcomm Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-05-20\",\n    \"issue_date\": \"2018-11-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for improving wireless communication reliability using adaptive modulation and coding is disclosed. The invention addresses signal degradation issues in challenging environments.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Wireless Communication System\"\n        },\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"title\": \"Adaptive Modulation Technique\"\n        },\n        {\n            \"patent_number\": \"US9000001B2\",\n            \"title\": \"Error Correction Coding for Wireless\"\n        },\n        {\n            \"patent_number\": \"US8567890B1\",\n            \"title\": \"Interference Mitigation in Wireless Networks\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Beamforming Techniques for Wireless\"\n        }\n    ],\n    \"claims\": [\n        \"A system for improving wireless communication reliability.\",\n        \"A method for adaptive modulation and coding.\",\n        \"A wireless communication device incorporating the system.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66577", "text": "{\n    \"patent_title\": \"Improved Battery Life for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Apple Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10246813B1\",\n    \"priority_date\": \"2011-06-01\",\n    \"filing_date\": \"2011-08-15\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An innovative approach to extending battery life in mobile devices through power management optimization is presented.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Power Management System\"\n        },\n        {\n            \"patent_number\": \"US8234567B1\",\n            \"title\": \"Battery Charging Circuit\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Low-Power Microprocessor\"\n        }\n    ],\n    \"claims\": [\n        \"A mobile device with extended battery life.\",\n        \"A power management system for mobile devices.\",\n        \"A method for optimizing power consumption.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66578", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10245789B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2019-06-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for increasing the resolution of digital images using deep learning techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising...\",\n        \"A system for processing images...\"\n    ]\n}"}
