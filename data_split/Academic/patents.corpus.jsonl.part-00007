{"_id": "Academic--patents--p--66277", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a miniature wireless pressure sensor system for use in biomedical applications. The system comprises a microfabricated pressure sensor, a wireless communication module, and a power management unit.  It enables remote monitoring of physiological parameters.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for monitoring pressure using a wireless sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66277", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10246813B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved battery management system for electric vehicles, optimizing charging and discharging cycles to extend battery life. The system utilizes advanced algorithms to predict battery degradation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9346789B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery life...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66278", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-12-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to novel electrode materials for lithium-ion batteries, improving energy density and cycle life.  The materials consist of a modified lithium metal oxide composition with enhanced structural stability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode material...\",\n        \"The electrode material of claim 1, wherein the material comprises...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66278", "text": "{\n    \"patent_title\": \"Advanced Solar Cell Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-09-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a new design for high-efficiency solar cells, utilizing perovskite materials and advanced light trapping techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A solar cell comprising a perovskite layer...\",\n        \"The solar cell of claim 1, wherein the perovskite layer has...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66279", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition Using Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2019-04-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for improving image recognition accuracy through the use of deep neural networks is disclosed. The system utilizes a novel architecture to enhance feature extraction and classification.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Similar image recognition techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66279", "text": "{\n    \"patent_title\": \"Improved Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of Texas at Austin\"\n        }\n    ],\n    \"patent_number\": \"US11334455B2\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2018-08-10\",\n    \"issue_date\": \"2020-01-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) for electric vehicles designed to optimize battery life and performance is presented. The BMS features advanced algorithms for state-of-charge estimation and thermal management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"Related battery technology\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66280", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition using artificial intelligence and deep learning algorithms. The system is capable of identifying objects in images with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for identifying objects in an image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66280", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2019-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles, optimizing charging and discharging cycles to extend battery life and improve performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66281", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition utilizing artificial intelligence techniques, specifically deep convolutional neural networks. The system efficiently identifies objects within images with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for image recognition comprising...\",\n        \"2. The system of claim 1, wherein the artificial intelligence...\",\n        \"3. A method for image recognition...\",\n        \"4. The method of claim 3, further comprising...\",\n        \"5. The system of claim 1, wherein the deep convolutional neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66281", "text": "{\n    \"patent_title\": \"Method for Enhanced Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"IBM Research\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-08-10\",\n    \"filing_date\": \"2017-08-09\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved method for data compression using a novel algorithm. This technique reduces file sizes without significant loss of information.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for data compression comprising...\",\n        \"2. The method of claim 1, wherein the compression ratio...\",\n        \"3. A computer-readable medium...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66282", "text": "{\n    \"patent_title\": \"System and method for dynamic spectrum access\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-15\",\n    \"filing_date\": \"2015-03-10\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for dynamic spectrum access are provided, enabling efficient utilization of radio frequency spectrum. The system intelligently allocates spectrum resources based on real-time demand and interference conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Spectrum sensing techniques\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Cognitive radio networks\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Interference management systems\"\n        },\n        {\n            \"patent_number\": \"US8901234B1\",\n            \"title\": \"Dynamic frequency selection\"\n        },\n        {\n            \"patent_number\": \"US9234567B2\",\n            \"title\": \"Adaptive modulation and coding\"\n        }\n    ],\n    \"claims\": [\n        \"A method for dynamic spectrum access...\",\n        \"A system for allocating spectrum resources...\"\n    ]\n}"}
