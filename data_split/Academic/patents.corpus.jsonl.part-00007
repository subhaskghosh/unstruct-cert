{"_id": "Academic--patents--p--69025", "text": "{\n    \"patent_title\": \"High-Performance Lithium-Ion Battery with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery design utilizing a solid-state electrolyte for improved safety and performance. This invention significantly enhances the energy density and cycle life of lithium-ion batteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on electrolyte materials\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"The battery of claim 1, wherein...\",\n        \"A method of manufacturing a lithium-ion battery...\",\n        \"The method of claim 2, further comprising...\",\n        \"A system utilizing the lithium-ion battery...\",\n        \"The system of claim 4, wherein...\",\n        \"A device incorporating the lithium-ion battery...\",\n        \"The device of claim 6, wherein...\",\n        \"An electrolyte composition for use in a lithium-ion battery...\",\n        \"The composition of claim 9, further comprising...\",\n        \"A separator for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69025", "text": "{\n    \"patent_title\": \"Improved Solar Cell Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-02-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new solar cell architecture based on perovskite materials, demonstrating increased efficiency in converting sunlight into electricity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Early work on perovskite solar cells\"\n        }\n    ],\n    \"claims\": [\n        \"A solar cell comprising...\",\n        \"The solar cell of claim 1, wherein...\",\n        \"A method of manufacturing a solar cell...\",\n        \"The method of claim 2, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69026", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system utilizing MEMS technology. The sensor is capable of transmitting data wirelessly over a short range and is intended for biomedical applications.  The system incorporates a low-power design and includes advanced signal processing algorithms to ensure accurate pressure measurements.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related Art\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising...\",\n        \"A method for measuring pressure using a wireless sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69026", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Texas A&M University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-15\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles. The system provides enhanced charge control and prevents overheating. It includes algorithms to optimize battery life and improve overall system performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related Art\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69027", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Restoration\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Adobe Systems\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for improving the quality of degraded images using a novel algorithm for noise reduction and artifact removal.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Denoising Technique\"\n        },\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"title\": \"Adaptive Image Filtering\"\n        },\n        {\n            \"patent_number\": \"US8898765B1\",\n            \"title\": \"Image Enhancement System\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Restoration of Blurred Images\"\n        },\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Digital Image Processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image quality...\",\n        \"A system comprising a processor...\",\n        \"The method of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69027", "text": "{\n    \"patent_title\": \"Digital Image Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-09-01\",\n    \"filing_date\": \"2017-09-01\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An efficient algorithm for compressing digital images using a wavelet transform and entropy coding.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"title\": \"Wavelet-Based Image Compression\"\n        },\n        {\n            \"patent_number\": \"US9234567B1\",\n            \"title\": \"Entropy Coding Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image...\",\n        \"A system for encoding image data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69028", "text": "{\n    \"patent_title\": \"High-Efficiency Perovskite Solar Cell with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Li Wei\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Maria Rodriguez\",\n            \"affiliation\": \"National Renewable Energy Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel perovskite solar cell structure is disclosed, demonstrating enhanced efficiency and long-term stability. The device incorporates a modified electron transport layer and a hydrophobic passivation layer to mitigate degradation caused by moisture and oxygen. This innovation leads to significant improvements in power conversion efficiency and operational lifetime compared to conventional perovskite solar cells.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on perovskite materials\"\n        }\n    ],\n    \"claims\": [\n        \"A solar cell comprising...\",\n        \"The solar cell of claim 1, wherein...\",\n        \"The solar cell of claim 2, further comprising...\",\n        \"A method for fabricating a solar cell...\",\n        \"The method of claim 4, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69028", "text": "{\n    \"patent_title\": \"Improved Wind Turbine Blade Design\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-10\",\n    \"filing_date\": \"2017-03-10\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new wind turbine blade design is presented, optimizing aerodynamic performance and reducing noise levels. The blade features a unique airfoil shape and a novel trailing edge flap system to enhance energy capture and improve efficiency in varying wind conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Prior art on wind turbine blade design\"\n        }\n    ],\n    \"claims\": [\n        \"A wind turbine blade comprising...\",\n        \"The wind turbine blade of claim 1, wherein...\",\n        \"A wind turbine system including the blade of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69029", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-05-20\",\n    \"issue_date\": \"2018-12-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications. The sensor utilizes MEMS technology and a low-power communication protocol. This system is suitable for continuous monitoring of physiological pressure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising...\",\n        \"The sensor of claim 1, wherein...\",\n        \"A system for monitoring pressure...\",\n        \"The system of claim 3, further comprising...\",\n        \"A method for measuring pressure...\",\n        \"The method of claim 5, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69029", "text": "{\n    \"patent_title\": \"Novel Data Encryption Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US8901234B1\",\n    \"priority_date\": \"2011-06-01\",\n    \"filing_date\": \"2011-08-15\",\n    \"issue_date\": \"2017-05-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new algorithm for encrypting digital data, providing enhanced security and speed. The algorithm is based on a complex mathematical function and is resistant to known attacks.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for encrypting data comprising...\",\n        \"The method of claim 1, wherein...\",\n        \"A system for secure communication...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69030", "text": "{\n    \"patent_title\": \"Neural Network Based Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2020-11-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a neural network architecture for high-accuracy image recognition. The system utilizes convolutional neural networks to analyze image data and identify objects with improved efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition using a neural network.\",\n        \"A neural network architecture comprising convolutional layers.\",\n        \"A system for classifying images based on neural network output.\",\n        \"The method of claim 1, wherein the neural network is trained on a large dataset.\",\n        \"The system of claim 3, wherein the system further comprises a user interface.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69030", "text": "{\n    \"patent_title\": \"Improved Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel data compression algorithm utilizing Huffman coding and run-length encoding to achieve high compression ratios.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data using Huffman coding.\",\n        \"A data compression system comprising a Huffman encoder.\",\n        \"The method of claim 1, wherein the data is pre-processed to improve compression ratio.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69031", "text": "{\n    \"patent_title\": \"System and method for AI-powered image recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system and method for image recognition utilizing artificial intelligence algorithms. The system can identify objects in images with high accuracy and speed.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for identifying objects in an image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69031", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Acme Corp\"\n        },\n        {\n            \"name\": \"Eve Green\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2014-12-10\",\n    \"filing_date\": \"2014-12-10\",\n    \"issue_date\": \"2017-05-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved bicycle brake system providing enhanced stopping power and reliability. The system utilizes a novel cable tensioning mechanism.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art in bicycle braking\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle brake system comprising...\",\n        \"A cable tensioning mechanism for a bicycle brake...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69032", "text": "{\n    \"patent_title\": \"System and Method for Predictive Maintenance Using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"TechCorp Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of Innovation\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system and method for predicting equipment failure using machine learning algorithms.  The system analyzes sensor data to identify patterns indicative of impending failures, allowing for proactive maintenance and reduced downtime.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predicting equipment failure, comprising...\",\n        \"A method for analyzing sensor data...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The system of claim 1, wherein the machine learning algorithm is a neural network.\",\n        \"The method of claim 2, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69032", "text": "{\n    \"patent_title\": \"Improved Control System for Industrial Robots\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Robotics Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US98765432B2\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2020-08-15\",\n    \"issue_date\": \"2022-06-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel control system for industrial robots, enhancing precision and efficiency.  It utilizes advanced feedback mechanisms and motion planning algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A control system for an industrial robot, comprising...\",\n        \"A method for controlling the motion of a robot...\",\n        \"The control system of claim 1, wherein the feedback mechanism is an encoder.\",\n        \"The method of claim 2, further comprising optimizing the trajectory...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69033", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Processing Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-03-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method and system for enhanced image processing utilizing deep learning techniques. The system improves image quality and object recognition in various applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B1\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image quality comprising...\",\n        \"A system for object recognition...\",\n        \"A computer-readable medium...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69033", "text": "{\n    \"patent_title\": \"Wireless Communication Protocol Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2021-09-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to improvements in wireless communication protocols, focusing on reducing latency and increasing bandwidth efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication system comprising...\",\n        \"A method for reducing latency...\",\n        \"A network protocol...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69034", "text": "{\n    \"patent_title\": \"System and Method for Intelligent Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-02-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for intelligent image recognition utilizing artificial intelligence techniques to identify objects within images with high accuracy and speed. The system employs convolutional neural networks and advanced machine learning algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for recognizing objects in an image...\",\n        \"A system comprising a neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69034", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-12-01\",\n    \"filing_date\": \"2009-12-01\",\n    \"issue_date\": \"2018-07-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved bicycle braking system providing enhanced stopping power and modulation. The system utilizes a novel cable actuation mechanism and high-friction brake pads.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle braking system comprising...\",\n        \"A cable actuation mechanism...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69035", "text": "{\n    \"patent_title\": \"High-Performance Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel electrode materials for lithium-ion batteries, offering increased energy density and cycle life. The materials exhibit enhanced ionic conductivity and improved stability during charge-discharge cycles.\",\n    \"citations\": [\n        {\n            \"title\": \"Advanced Cathode Materials\",\n            \"patent_number\": \"US9876543B1\"\n        },\n        {\n            \"title\": \"Electrolyte Optimization for Lithium-Ion Cells\",\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode material...\",\n        \"The lithium-ion battery of claim 1, wherein the electrode material comprises...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69035", "text": "{\n    \"patent_title\": \"Battery Management System with Enhanced Thermal Control\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) designed for high-power lithium-ion battery packs, featuring advanced thermal regulation and cell balancing algorithms.\",\n    \"citations\": [\n        {\n            \"title\": \"Battery Management System for Electric Vehicles\",\n            \"patent_number\": \"US9123456B2\"\n        },\n        {\n            \"title\": \"Thermal Management of Lithium-Ion Batteries\",\n            \"patent_number\": \"US8123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising a thermal control unit...\",\n        \"The battery management system of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69036", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2020-06-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications. The system utilizes a MEMS pressure sensor and a low-power transmitter to wirelessly transmit pressure data to a remote receiver.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Similar sensor technology\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for wirelessly measuring pressure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69036", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Tesla\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2019-01-20\",\n    \"filing_date\": \"2019-01-20\",\n    \"issue_date\": \"2021-03-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles, optimizing charging and discharging cycles to extend battery life and enhance performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Previous battery management techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery charge...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69037", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-03-15\",\n    \"filing_date\": \"2010-05-20\",\n    \"issue_date\": \"2019-02-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel lithium-ion battery design incorporating a solid-state electrolyte, resulting in enhanced stability and improved energy density. The battery demonstrates superior performance in extreme temperature conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art in solid-state electrolytes\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising a solid-state electrolyte.\",\n        \"The battery of claim 1, wherein the electrolyte is a ceramic material.\",\n        \"The battery of claim 2, wherein the ceramic material is lithium lanthanum titanium oxide.\",\n        \"A method of manufacturing the battery of claim 1.\",\n        \"A device utilizing the battery of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69037", "text": "{\n    \"patent_title\": \"Improved Lead-Acid Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2008-11-01\",\n    \"filing_date\": \"2011-04-05\",\n    \"issue_date\": \"2017-09-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved lead-acid battery with enhanced charge acceptance and cycle life. The improvements involve a novel electrode coating and electrolyte additive.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"relevance\": \"Previous lead-acid battery designs\"\n        }\n    ],\n    \"claims\": [\n        \"A lead-acid battery comprising a novel electrode coating.\",\n        \"The battery of claim 1, wherein the coating is composed of carbon nanotubes.\",\n        \"A method of manufacturing the battery of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69038", "text": "{\n    \"patent_title\": \"System and method for image recognition using deep convolutional neural networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition using deep convolutional neural networks. The system includes a convolutional neural network trained to identify objects in images. The method includes receiving an image, processing the image through the convolutional neural network, and outputting a recognition result.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The method of claim 1, wherein...\",\n        \"The system of claim 2, wherein...\",\n        \"The system of claim 3, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69038", "text": "{\n    \"patent_title\": \"Method for Efficient Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10293847B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-19\",\n    \"issue_date\": \"2020-03-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel method for compressing data, achieving high compression ratios with minimal computational overhead. The method utilizes a combination of Huffman coding and run-length encoding.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related to data compression techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising...\",\n        \"A system for data compression comprising...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69039", "text": "{\n    \"patent_title\": \"Improved Electrode Material for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel electrode material for lithium-ion batteries, exhibiting enhanced energy density and cycle life. The material comprises a modified lithium metal oxide structure with improved ion conductivity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8753789B2\",\n            \"title\": \"High-Performance Anode Material\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode material...\",\n        \"The electrode material according to claim 1, wherein the material comprises a lithium metal oxide...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69039", "text": "{\n    \"patent_title\": \"Battery Management System with Enhanced Thermal Control\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Texas Instruments\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-14\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) for lithium-ion batteries, providing improved thermal control and cell balancing. The system incorporates advanced algorithms for predicting battery state-of-health.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9124034B2\",\n            \"title\": \"Lithium-Ion Battery Thermal Management System\"\n        },\n        {\n            \"patent_number\": \"US8569441B2\",\n            \"title\": \"Cell Balancing Circuit for Battery Packs\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising a thermal control unit...\",\n        \"The battery management system according to claim 1, wherein the thermal control unit comprises a cooling fan...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69040", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2022-03-15\",\n    \"filing_date\": \"2022-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to novel materials for lithium-ion battery electrodes, improving energy density and cycle life. The materials utilize a unique nanoscale structure to enhance ion transport.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrode comprising...\",\n        \"A method for manufacturing a lithium-ion battery electrode...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69040", "text": "{\n    \"patent_title\": \"Novel Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Tesla\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2021-11-01\",\n    \"filing_date\": \"2021-11-01\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention concerns a battery management system designed to optimize performance and safety of battery packs. It incorporates advanced algorithms for cell balancing and thermal management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10101010B2\",\n            \"relevance\": \"Related Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling a battery pack...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69041", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to improved electrode materials for lithium-ion batteries, enhancing energy density and cycle life. The materials comprise a novel composite structure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode material...\",\n        \"The electrode material of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69041", "text": "{\n    \"patent_title\": \"Novel Fuel Cell Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"California Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Green\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2010-12-01\",\n    \"filing_date\": \"2010-12-01\",\n    \"issue_date\": \"2018-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new design for fuel cells, improving efficiency and reducing emissions. The design incorporates a novel membrane structure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\"\n        }\n    ],\n    \"claims\": [\n        \"A fuel cell comprising a novel membrane...\",\n        \"The fuel cell of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69042", "text": "{\n    \"patent_title\": \"System and Method for Image Recognition using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-01-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition using deep convolutional neural networks are disclosed. The system includes a convolutional neural network trained to identify objects within images. The method includes receiving an image, processing the image through the convolutional neural network, and outputting an identification of the objects within the image.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Recognition System\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for image recognition comprising...\",\n        \"2. The system of claim 1, wherein the convolutional neural network...\",\n        \"3. A method for image recognition comprising...\",\n        \"4. The method of claim 3, wherein the processing step...\",\n        \"5. The system of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69042", "text": "{\n    \"patent_title\": \"Method for Enhancing Audio Quality\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2019-02-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for enhancing audio quality by reducing noise and improving clarity is described. The method utilizes a novel filtering algorithm to isolate and amplify desired audio signals.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Audio Enhancement System\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for enhancing audio quality comprising...\",\n        \"2. The method of claim 1, wherein the filtering algorithm...\",\n        \"3. A system for audio enhancement comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69043", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Intel Corporation\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for use in medical devices. The sensor utilizes MEMS technology and Bluetooth communication. The system features low power consumption and high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art relating to wireless communication\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for measuring pressure using the system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69043", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-22\",\n    \"filing_date\": \"2017-03-22\",\n    \"issue_date\": \"2020-02-29\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery design with increased energy density and lifespan. This battery utilizes a new electrolyte composition and electrode materials.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Prior art relating to lithium-ion battery technology\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"A method for manufacturing the battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69044", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-03-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition utilizing artificial intelligence and deep learning algorithms. The system efficiently identifies objects within images with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for identifying objects in an image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69044", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US9234567B2\",\n    \"priority_date\": \"2014-12-20\",\n    \"filing_date\": \"2014-12-20\",\n    \"issue_date\": \"2019-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel bicycle braking system designed to provide improved stopping power and reliability in various weather conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle braking system including...\",\n        \"A method of applying brakes to a bicycle...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69045", "text": "{\n    \"patent_title\": \"Method and System for Image Recognition Using Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for image recognition using convolutional neural networks. The system trains a neural network to identify objects in images with high accuracy. Applications include autonomous vehicles and security systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9785621B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69045", "text": "{\n    \"patent_title\": \"Implantable Device with Neural Interface for Cardiac Stimulation\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Williams\",\n            \"affiliation\": \"Medtronic\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Boston Scientific\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2018-11-20\",\n    \"filing_date\": \"2018-11-20\",\n    \"issue_date\": \"2021-01-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable medical device that uses a neural interface to stimulate the heart. The device incorporates a neural network to optimize stimulation patterns for improved patient outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8543987B2\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"medical device\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable device comprising...\",\n        \"A neural interface for cardiac stimulation comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69046", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for real-time monitoring of various applications. The sensor utilizes MEMS technology and low-power communication protocols.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A pressure sensor system comprising...\",\n        \"A wireless communication module...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69046", "text": "{\n    \"patent_title\": \"Advanced Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2021-11-01\",\n    \"filing_date\": \"2020-12-20\",\n    \"issue_date\": \"2023-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An advanced battery management system for electric vehicles, optimizing charging and discharging cycles to extend battery life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A charging control module...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69047", "text": "{\n    \"patent_title\": \"Wireless Temperature Sensor Network for Industrial Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of Engineering\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless sensor network for monitoring temperature in industrial environments. The system utilizes low-power sensors and a mesh network for reliable data transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Mesh Networking Protocol\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor network comprising...\",\n        \"A method for monitoring temperature using...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69047", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Medical Innovations Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor providing real-time monitoring of blood glucose levels. The sensor communicates wirelessly to a patient's mobile device.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Miniature Medical Sensor Design\"\n        },\n        {\n            \"patent_number\": \"US99999999B1\",\n            \"title\": \"Wireless Communication for Medical Devices\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable glucose sensor...\",\n        \"A method for wirelessly transmitting glucose data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69048", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a miniaturized wireless pressure sensor system for real-time monitoring of physiological parameters. The system utilizes a novel MEMS sensor and a low-power communication protocol.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"The system of claim 1, wherein the sensor is a MEMS sensor.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69048", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emily Davis\",\n            \"affiliation\": \"California Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved battery management system for electric vehicles, optimizing charging and discharging cycles for extended battery life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"The system of claim 1, wherein the charging is optimized...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69049", "text": "{\n    \"patent_title\": \"Microfluidic Device for Single Cell Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-14\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for isolating and analyzing single cells. The device includes a plurality of microchambers for capturing individual cells and a system for delivering reagents to the cells.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"1. A microfluidic device comprising...\",\n        \"2. The device of claim 1, wherein...\",\n        \"3. A method for isolating...\",\n        \"4. The method of claim 3, wherein...\",\n        \"5. The device of claim 1, further comprising...\",\n        \"6. The method of claim 3, further comprising...\",\n        \"7. A system for analyzing...\",\n        \"8. The system of claim 7, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69049", "text": "{\n    \"patent_title\": \"Improved Battery Electrode Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-12-10\",\n    \"filing_date\": \"2009-12-09\",\n    \"issue_date\": \"2018-01-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel electrode material for lithium-ion batteries with improved energy density and cycle life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"1. An electrode material comprising...\",\n        \"2. The material of claim 1, wherein...\",\n        \"3. A battery cell comprising...\",\n        \"4. The battery cell of claim 3, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69050", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel lithium-ion battery electrode material with enhanced energy density and cycle life. The material utilizes a unique nanostructure to improve ion transport and reduce degradation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Lithium-Ion Battery Separator\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrode material comprising...\",\n        \"The electrode material of claim 1, further comprising...\",\n        \"A lithium-ion battery cell comprising the electrode material...\",\n        \"The lithium-ion battery cell of claim 3, having an energy density...\",\n        \"A method for manufacturing the electrode material...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69050", "text": "{\n    \"patent_title\": \"Novel Polymer Electrolyte for Solid-State Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2021-01-10\",\n    \"issue_date\": \"2023-04-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new polymer electrolyte for solid-state batteries, offering improved safety and performance compared to liquid electrolytes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Solid-State Battery with Enhanced Stability\"\n        }\n    ],\n    \"claims\": [\n        \"A polymer electrolyte comprising...\",\n        \"The polymer electrolyte of claim 1, having an ionic conductivity...\",\n        \"A solid-state battery cell comprising the polymer electrolyte...\",\n        \"The solid-state battery cell of claim 3, exhibiting enhanced safety...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69051", "text": "{\n    \"patent_title\": \"Method and System for Neural Network-Based Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for image recognition using a deep neural network architecture. The system employs convolutional neural networks to extract features from images and classifies them with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"Cited by Applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\",\n        \"The method of claim 1, wherein...\",\n        \"The system of claim 2, wherein...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69051", "text": "{\n    \"patent_title\": \"Improved Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel data compression algorithm that achieves higher compression ratios compared to existing methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"kind\": \"Cited by Examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising...\",\n        \"A system for data compression comprising...\",\n        \"The method of claim 1, wherein...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69052", "text": "{\n    \"patent_title\": \"Advanced Lithium-Ion Battery Electrode Materials and Methods\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-14\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to novel electrode materials for lithium-ion batteries, improving energy density and cycle life. The materials utilize a unique nano-structured composite design to enhance ion transport.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7651400B2\",\n            \"relevance\": \"Related prior art in lithium-ion battery technology\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an anode, a cathode, and an electrolyte.\",\n        \"The battery of claim 1, wherein the anode comprises a nano-structured composite material.\",\n        \"The battery of claim 2, wherein the cathode comprises a lithium metal oxide.\",\n        \"A method of manufacturing a lithium-ion battery according to claim 1.\",\n        \"A device powered by the lithium-ion battery of claim 1.\",\n        \"The battery of claim 1, having an energy density of at least 250 Wh/kg.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69052", "text": "{\n    \"patent_title\": \"Enhanced Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Park Ji-hoon\",\n            \"affiliation\": \"Samsung Electronics\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2012-05-20\",\n    \"filing_date\": \"2012-05-19\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system for improved performance and safety of battery packs. Includes advanced algorithms for charge/discharge control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"relevance\": \"Related prior art in battery management\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising a voltage sensor and a current sensor.\",\n        \"The system of claim 1, further comprising a temperature sensor.\",\n        \"A method of controlling a battery pack using the system of claim 1.\",\n        \"The system of claim 1, adapted for use with lithium-ion batteries.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69053", "text": "{\n    \"patent_title\": \"Implantable Micro-device for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Mark Horowitz\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jennifer Hamilton\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable micro-device for continuous glucose monitoring utilizing microfluidic channels and electrochemical sensors.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Glucose Sensor\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Implantable Device\"\n        },\n        {\n            \"patent_number\": \"US9543210B1\",\n            \"title\": \"Microfluidic System\"\n        },\n        {\n            \"patent_number\": \"US8987654B2\",\n            \"title\": \"Electrochemical Sensor\"\n        },\n        {\n            \"patent_number\": \"US9765432B1\",\n            \"title\": \"Biocompatible Material\"\n        }\n    ],\n    \"claims\": [\n        \"A micro-device for continuous glucose monitoring comprising...\",\n        \"The micro-device of claim 1, wherein the sensor is electrochemical.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69053", "text": "{\n    \"patent_title\": \"Surgical Instrument with Enhanced Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"David Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical instrument designed with ergonomic handles and improved precision.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Surgical Tool\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Ergonomic Handle\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument with an ergonomic handle comprising...\",\n        \"The surgical instrument of claim 1, wherein the handle is adjustable.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69054", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for image recognition utilizing artificial intelligence and deep learning algorithms. The system is capable of identifying objects with high accuracy and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training an artificial intelligence model...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69054", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Independent Inventor\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US9123456B2\",\n    \"priority_date\": \"2014-12-20\",\n    \"filing_date\": \"2014-12-20\",\n    \"issue_date\": \"2019-09-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved bicycle brake system, offering enhanced stopping power and reliability. The system uses a novel lever design and friction material.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8210123B1\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle brake system comprising...\",\n        \"A lever mechanism for applying braking force...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69055", "text": "{\n    \"patent_title\": \"System and Method for Automated Feature Engineering using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2020-06-20\",\n    \"issue_date\": \"2022-12-13\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for automated feature engineering using machine learning techniques. The system identifies and transforms features from raw data to improve the performance of predictive models.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Similar feature engineering approach\"\n        }\n    ],\n    \"claims\": [\n        \"A system for automated feature engineering...\",\n        \"A method for transforming raw data into optimized features...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69055", "text": "{\n    \"patent_title\": \"Improved Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Emily Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2022-01-10\",\n    \"filing_date\": \"2020-04-05\",\n    \"issue_date\": \"2023-08-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved battery management system for electric vehicles, enhancing energy efficiency and safety through advanced control algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Prior art in battery management\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling battery charge and discharge...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69056", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Recognition Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing image recognition accuracy using deep convolutional neural networks. The system includes a preprocessing module, a convolutional neural network, and a post-processing module.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Recognition System\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Deep Learning for Image Classification\"\n        },\n        {\n            \"patent_number\": \"US9543210B1\",\n            \"title\": \"Convolutional Neural Network Architecture\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Feature Extraction for Image Processing\"\n        },\n        {\n            \"patent_number\": \"US10234567B1\",\n            \"title\": \"Image Segmentation Using Deep Learning\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image recognition accuracy...\",\n        \"A system comprising a preprocessing module...\",\n        \"The method of claim 1, wherein the preprocessing module...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69056", "text": "{\n    \"patent_title\": \"Digital Image Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9987654B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel digital image compression technique that utilizes wavelet transforms to achieve high compression ratios.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Compression Algorithm\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Wavelet Transform Implementation\"\n        },\n        {\n            \"patent_number\": \"US9543210B1\",\n            \"title\": \"Lossless Image Compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a digital image...\",\n        \"The method of claim 1, wherein the wavelet transform...\",\n        \"A system for implementing the compression method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69057", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system is disclosed. The system comprises a pressure sensor, a wireless communication module, and a power source, enabling remote monitoring of pressure in various applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A pressure sensor system comprising a sensor, a transmitter, and a receiver.\",\n        \"The system of claim 1, wherein the sensor is a MEMS pressure sensor.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69057", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-12-10\",\n    \"filing_date\": \"2009-12-10\",\n    \"issue_date\": \"2018-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles is presented. The system optimizes charging and discharging cycles to extend battery life and enhance performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising a charging controller and a discharging controller.\",\n        \"The system of claim 1, wherein the charging controller utilizes a pulse charging algorithm.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69058", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel electrode materials for lithium-ion batteries, enhancing energy density and cycle life. The materials incorporate a unique coating to improve stability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"1. A lithium-ion battery comprising...\",\n        \"2. The battery of claim 1, wherein...\",\n        \"3. An electrode material for a lithium-ion battery...\",\n        \"4. The electrode material of claim 3, wherein...\",\n        \"5. A method for manufacturing a lithium-ion battery...\",\n        \"6. The method of claim 5, wherein...\",\n        \"7. A device powered by the lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69058", "text": "{\n    \"patent_title\": \"New Catalyst for Polymer Production\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"DuPont\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel catalyst is described for the production of high-density polyethylene. The catalyst offers improved selectivity and activity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"1. A catalyst comprising...\",\n        \"2. The catalyst of claim 1, wherein...\",\n        \"3. A method for producing polyethylene...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69059", "text": "{\n    \"patent_title\": \"High-Performance Lithium-Ion Battery with Enhanced Electrolyte\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-06-15\",\n    \"issue_date\": \"2018-01-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel lithium-ion battery with an improved electrolyte composition, leading to increased energy density and cycle life. The battery exhibits superior performance in portable electronic devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition for a lithium-ion battery...\",\n        \"A method for manufacturing a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69059", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2015-11-20\",\n    \"filing_date\": \"2016-01-10\",\n    \"issue_date\": \"2018-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) for lithium-ion batteries used in electric vehicles. The BMS optimizes battery performance and safety in automotive applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for an electric vehicle...\",\n        \"A method for controlling a lithium-ion battery in a vehicle...\",\n        \"A system for monitoring the state of charge of a battery in a vehicle...\"\n    ]\n}"}
