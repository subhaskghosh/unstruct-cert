{"_id": "Academic--patents--p--66116", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-12-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing image recognition accuracy using deep learning techniques. The system incorporates novel algorithms for feature extraction and classification.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Processing Techniques\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Deep Learning Architectures\"\n        },\n        {\n            \"patent_number\": \"US11345678B2\",\n            \"title\": \"Computer Vision Systems\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for enhancing image recognition accuracy...\"\n    ]\n}"}
