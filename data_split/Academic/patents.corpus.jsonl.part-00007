{"_id": "Academic--patents--p--66746", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Thermal Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a lithium-ion battery with an improved electrolyte composition and a novel cell structure, resulting in enhanced thermal stability and cycle life. The battery is suitable for use in electric vehicles and portable electronic devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Lithium-Ion Battery Electrode Material\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition for a lithium-ion battery...\",\n        \"A method for manufacturing a lithium-ion battery...\"\n    ]\n}"}
