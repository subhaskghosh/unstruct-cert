{"_id": "Academic--patents--p--66305", "text": "{\n    \"patent_title\": \"System and method for anomaly detection using machine learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2018-03-01\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for detecting anomalies in data streams using machine learning algorithms, specifically a recurrent neural network. This improves the accuracy and efficiency of anomaly detection compared to traditional methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Anomaly Detection System\"\n        }\n    ],\n    \"claims\": [\n        \"A system for detecting anomalies comprising a machine learning module...\",\n        \"A method for anomaly detection...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66305", "text": "{\n    \"patent_title\": \"Improved Braking System for Automobiles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Ford Motor Company\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2017-11-15\",\n    \"issue_date\": \"2018-12-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved braking system for automobiles, utilizing advanced materials and a novel hydraulic design to reduce stopping distance and enhance safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Automobile Braking System\"\n        }\n    ],\n    \"claims\": [\n        \"A braking system comprising a hydraulic pump...\",\n        \"A method for braking an automobile...\"\n    ]\n}"}
