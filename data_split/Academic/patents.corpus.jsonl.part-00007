{"_id": "Academic--patents--p--66263", "text": "{\n    \"patent_title\": \"Implantable Cardiac Monitor with Remote Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MedTech Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-15\",\n    \"filing_date\": \"2015-03-10\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac monitor capable of wirelessly transmitting patient data to a remote server for analysis and physician review. The device utilizes low-power Bluetooth communication and a novel energy harvesting system.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8657321B2\",\n            \"title\": \"Wireless Physiological Monitoring System\"\n        },\n        {\n            \"patent_number\": \"US7988075B2\",\n            \"title\": \"Implantable Defibrillator with Data Logging\"\n        },\n        {\n            \"patent_number\": \"US9120045B2\",\n            \"title\": \"Remote Patient Monitoring System\"\n        },\n        {\n            \"patent_number\": \"US8991447B2\",\n            \"title\": \"Energy Harvesting for Implantable Devices\"\n        },\n        {\n            \"patent_number\": \"US9346012B2\",\n            \"title\": \"Data Compression for Wireless Medical Devices\"\n        }\n    ],\n    \"claims\": [\n        \"A method for remotely monitoring a patient's cardiac activity...\",\n        \"An implantable device comprising a sensor...\",\n        \"A system for wirelessly transmitting data...\"\n    ]\n}"}
