{"_id": "Academic--patents--n--66107", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"California Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-04-01\",\n    \"issue_date\": \"2021-09-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A breakthrough in battery technology, increasing energy density and lifespan for electric vehicles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell with enhanced energy density...\",\n        \"A method for extending battery lifespan...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66108", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition Using Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-15\",\n    \"filing_date\": \"2015-03-10\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhanced image recognition using deep neural networks are disclosed. The system utilizes convolutional neural networks (CNNs) to extract features from images and classify them with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Recognition System\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Deep Learning Framework\"\n        },\n        {\n            \"patent_number\": \"US9234567B1\",\n            \"title\": \"Convolutional Neural Network Architecture\"\n        },\n        {\n            \"patent_number\": \"US9345678B2\",\n            \"title\": \"Image Classification Method\"\n        },\n        {\n            \"patent_number\": \"US9456789B1\",\n            \"title\": \"Artificial Intelligence System\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for classifying images using a deep neural network...\",\n        \"The system of claim 1, wherein the deep neural network is a convolutional neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66108", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery technology for electric vehicles is described, offering increased energy density and faster charging times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B1\",\n            \"title\": \"Lithium-ion Battery Design\"\n        },\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"title\": \"Battery Management System\"\n        },\n        {\n            \"patent_number\": \"US9123456B1\",\n            \"title\": \"Electric Vehicle Powertrain\"\n        }\n    ],\n    \"claims\": [\n        \"A battery comprising...\",\n        \"A method for charging an electric vehicle battery...\",\n        \"The battery of claim 1, wherein the battery is a lithium-ion battery.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66109", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Data Security in Cloud Computing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for providing enhanced data security in a cloud computing environment is disclosed. The system utilizes a multi-layered encryption approach and dynamic key management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for securing data in a cloud computing environment, comprising...\",\n        \"A method for encrypting data using a dynamic key management system...\"\n    ]\n}"}
