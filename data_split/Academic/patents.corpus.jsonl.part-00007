{"_id": "Academic--patents--p--66721", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Independent Researcher\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2019-12-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for enhancing the resolution of digital images using deep learning techniques. The system employs convolutional neural networks to upscale images while preserving detail, improving image quality for applications such as medical imaging and satellite imagery. The core algorithm focuses on robust image processing and minimizing artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing the resolution of a digital image...\",\n        \"A system comprising a processor and memory configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66721", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Beta Industries\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2019-03-10\",\n    \"filing_date\": \"2019-03-10\",\n    \"issue_date\": \"2020-09-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel data compression algorithm that significantly reduces file sizes without sacrificing data integrity. It utilizes a combination of entropy coding and transform coding techniques to achieve high compression ratios. The algorithm is applicable to various data types, including text, images, and audio.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10112233B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing digital data...\",\n        \"A system for implementing the compression algorithm...\"\n    ]\n}"}
