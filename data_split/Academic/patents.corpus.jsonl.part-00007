{"_id": "Academic--patents--p--66224", "text": "{\n    \"patent_title\": \"System and Method for Image Recognition Using Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition utilizing deep neural networks. The system employs convolutional neural networks to analyze images and identify objects with high accuracy. Applications include autonomous vehicles and security systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Convolutional Neural Network Architecture\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66224", "text": "{\n    \"patent_title\": \"Implantable Medical Device with Neural Network Control\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MedTech Innovations\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-06-01\",\n    \"filing_date\": \"2020-06-01\",\n    \"issue_date\": \"2022-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable medical device utilizing a neural network to control drug delivery. The device monitors patient physiological signals and adjusts dosage accordingly. This innovation improves treatment efficacy and patient compliance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Implantable Drug Delivery System\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable medical device comprising...\",\n        \"A method for controlling drug delivery using a neural network...\"\n    ]\n}"}
