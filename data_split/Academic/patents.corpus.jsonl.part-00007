{"_id": "Academic--patents--n--66306", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-07-01\",\n    \"filing_date\": \"2019-12-20\",\n    \"issue_date\": \"2021-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new battery technology utilizing solid-state electrolytes to enhance energy density and safety in electric vehicles.\",\n    \"citations\": [],\n    \"claims\": [\n        \"1. A battery cell comprising...\",\n        \"2. The battery cell of claim 1, wherein...\",\n        \"3. An electric vehicle incorporating the battery cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66307", "text": "{\n    \"patent_title\": \"Neural Network Based Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-05-10\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel neural network architecture for image recognition. The system utilizes a convolutional neural network to achieve state-of-the-art accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition using a neural network.\",\n        \"A method for training a neural network for image classification.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66307", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2020-01-05\",\n    \"issue_date\": \"2022-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved battery management system for electric vehicles, optimizing charge and discharge cycles to extend battery life. It includes advanced algorithms for thermal regulation and state of charge estimation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for electric vehicles.\",\n        \"A method for optimizing battery charge and discharge.\"\n    ]\n}"}
