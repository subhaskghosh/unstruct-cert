{"_id": "Academic--patents--p--69884", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for remote monitoring applications. The system comprises a MEMS pressure sensor, a low-power wireless transceiver, and a microcontroller. The sensor data is transmitted wirelessly to a base station for analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for remotely monitoring pressure using...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69884", "text": "{\n    \"patent_title\": \"Improved Battery Life for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method for extending battery life in mobile electronic devices by dynamically adjusting screen brightness and processor speed.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for extending battery life comprising...\",\n        \"A mobile device utilizing dynamic brightness adjustment...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69885", "text": "{\n    \"patent_title\": \"Method and System for Image Recognition Using Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2020-01-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for image recognition utilizing deep neural networks. The system includes a convolutional neural network trained to classify images with high accuracy. Applications include autonomous vehicles and medical image analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in convolutional neural networks\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69885", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Microsoft Research\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"IBM\"\n        },\n        {\n            \"name\": \"Eve Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2021-09-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved algorithm for lossless data compression utilizing Huffman coding and run-length encoding. This method achieves higher compression ratios than existing techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art in data compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising...\",\n        \"A system for data compression comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69886", "text": "{\n    \"patent_title\": \"System and method for personalized learning using artificial intelligence\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for providing personalized learning experiences using artificial intelligence techniques. The system analyzes student performance data to identify learning gaps and dynamically adjusts the learning content to address those gaps.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8766832B1\",\n            \"relevance\": \"Related art in personalized learning.\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for personalized learning...\",\n        \"2. A method for identifying learning gaps...\",\n        \"3. A method for dynamically adjusting learning content...\",\n        \"4. The system of claim 1, wherein...\",\n        \"5. The method of claim 2, further comprising...\",\n        \"6. The method of claim 3, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69886", "text": "{\n    \"patent_title\": \"Improved Image Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9123456B1\",\n    \"priority_date\": \"2015-11-01\",\n    \"filing_date\": \"2015-11-01\",\n    \"issue_date\": \"2016-09-13\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved image compression algorithm that utilizes a novel transform coding technique to achieve higher compression ratios with minimal loss of image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art in image compression.\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for compressing an image...\",\n        \"2. A system for implementing the method of claim 1...\",\n        \"3. The method of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69887", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Data Encryption\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-15\",\n    \"filing_date\": \"2015-03-20\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for encrypting data using a novel algorithm, enhancing security and performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Prior Art Encryption Method\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Related Data Security System\"\n        },\n        {\n            \"patent_number\": \"US9654321B1\",\n            \"title\": \"Alternative Encryption Technique\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"title\": \"Advanced Data Protection Protocol\"\n        },\n        {\n            \"patent_number\": \"US9765432B1\",\n            \"title\": \"Efficient Key Management System\"\n        },\n        {\n            \"patent_number\": \"US9543210B2\",\n            \"title\": \"Secure Communication Channel\"\n        }\n    ],\n    \"claims\": [\n        \"A method for encrypting data comprising...\",\n        \"A system for data encryption...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69887", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-02-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved bicycle brake system utilizing a novel lever mechanism for increased stopping power.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Existing Bicycle Brake Design\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"title\": \"Related Braking Mechanism\"\n        },\n        {\n            \"patent_number\": \"US9654321B1\",\n            \"title\": \"Alternative Brake Pad Material\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle brake system comprising...\",\n        \"A lever mechanism for enhancing braking force...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69888", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Improved Electrolyte\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9781452B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2017-11-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a lithium-ion battery with a novel electrolyte composition that improves stability and performance at high temperatures. The electrolyte utilizes a lithium salt dissolved in a mixture of cyclic and linear carbonates.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8546123B2\",\n            \"relevance\": \"Similar electrolyte composition\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69888", "text": "{\n    \"patent_title\": \"Novel Polymer for Solar Cells\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9781453B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-14\",\n    \"issue_date\": \"2018-04-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel polymer material designed for improved efficiency in organic solar cells. The polymer exhibits enhanced light absorption and charge transport properties.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8878221B2\",\n            \"relevance\": \"Related polymer chemistry\"\n        }\n    ],\n    \"claims\": [\n        \"A polymer material for solar cells...\",\n        \"A solar cell comprising the polymer...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69889", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2022-05-15\",\n    \"filing_date\": \"2022-06-15\",\n    \"issue_date\": \"2023-03-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable biosensor for continuous glucose monitoring, utilizing a novel enzymatic reaction and microfluidic design.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in glucose sensing technology\"\n        }\n    ],\n    \"claims\": [\n        \"A biosensor comprising a microfluidic channel...\",\n        \"A method for continuous glucose monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69889", "text": "{\n    \"patent_title\": \"Novel Surgical Instrument for Laparoscopic Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-11-01\",\n    \"filing_date\": \"2021-12-01\",\n    \"issue_date\": \"2023-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical instrument designed for improved precision and maneuverability during laparoscopic procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Existing laparoscopic instrument designs\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising a flexible shaft...\",\n        \"A method for performing laparoscopic surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69890", "text": "{\n    \"patent_title\": \"Method and System for Real-time Image Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the quality of images in real-time using adaptive filtering techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9012345B2\"\n        },\n        {\n            \"patent_number\": \"US7654321B1\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\"\n        },\n        {\n            \"patent_number\": \"US9123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing images comprising...\",\n        \"A system for real-time image enhancement comprising...\"\n    ]\n}"}
