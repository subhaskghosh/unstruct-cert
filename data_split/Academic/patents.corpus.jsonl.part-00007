{"_id": "Academic--patents--p--66651", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor for Cardiovascular Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor is disclosed, designed for continuous cardiovascular monitoring. The sensor utilizes MEMS technology and transmits data wirelessly to a remote monitoring station. This device is particularly useful in patients with heart failure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising...\",\n        \"A method for monitoring cardiovascular function using the sensor...\"\n    ]\n}"}
