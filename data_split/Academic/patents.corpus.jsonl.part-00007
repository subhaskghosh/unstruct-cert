{"_id": "Academic--patents--p--66228", "text": "{\n    \"patent_title\": \"System and Method for Dynamic Resource Allocation in Cloud Computing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-12-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for dynamically allocating resources in a cloud computing environment. The system utilizes machine learning algorithms to predict resource demand and optimize allocation to improve efficiency and reduce costs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Resource Management in Distributed Systems\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Adaptive Load Balancing Techniques\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Cloud Computing Architecture\"\n        },\n        {\n            \"patent_number\": \"US11345678B2\",\n            \"title\": \"Predictive Analytics for Resource Optimization\"\n        },\n        {\n            \"patent_number\": \"US10567890B1\",\n            \"title\": \"Scalable Resource Allocation Algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"A system for dynamically allocating resources in a cloud computing environment, comprising...\",\n        \"A method for optimizing resource allocation using machine learning, comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66228", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Samsung\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-06-15\",\n    \"issue_date\": \"2023-04-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery technology utilizing advanced materials to achieve higher energy density and faster charging times for mobile devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Lithium-Ion Battery Design\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Electrolyte Materials for Batteries\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Battery Management Systems\"\n        }\n    ],\n    \"claims\": [\n        \"A battery comprising a novel electrolyte material, characterized by...\",\n        \"A mobile device powered by the battery of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66229", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Electrolyte Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a lithium-ion battery with a novel electrolyte formulation that significantly enhances its stability and cycle life. The electrolyte includes a specific additive that prevents dendrite formation and improves safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Prior Art Lithium-Ion Battery\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte formulation for a lithium-ion battery...\",\n        \"A method for improving the cycle life of a lithium-ion battery...\"\n    ]\n}"}
