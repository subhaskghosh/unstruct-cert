{"_id": "Academic--patents--p--66756", "text": "{\n    \"patent_title\": \"Method and System for Efficient Data Stream Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for processing high-volume data streams with low latency. The system utilizes a novel data partitioning scheme and parallel processing architecture.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Similar data processing technique\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for processing a data stream, comprising...\",\n        \"2. The method of claim 1, wherein...\",\n        \"3. A system for processing a data stream...\",\n        \"4. The system of claim 3, wherein...\",\n        \"5. The method of claim 1, further comprising...\",\n        \"6. The system of claim 3, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66756", "text": "{\n    \"patent_title\": \"Improved Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Motors\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system for electric vehicles that optimizes battery life and performance. The system includes advanced charging algorithms and thermal management capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related battery technology\"\n        }\n    ],\n    \"claims\": [\n        \"1. A battery management system for an electric vehicle, comprising...\",\n        \"2. The system of claim 1, wherein...\",\n        \"3. A method for managing a battery...\",\n        \"4. The method of claim 3, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66757", "text": "{\n    \"patent_title\": \"Method and System for Enhancing Image Clarity Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2021-04-13\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel deep learning architecture for enhancing the clarity and resolution of digital images. The system utilizes a generative adversarial network (GAN) to learn a mapping from low-resolution to high-resolution images, resulting in significantly improved visual quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Super-Resolution Using Convolutional Neural Networks\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image clarity comprising...\",\n        \"A system for processing images to improve resolution...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66757", "text": "{\n    \"patent_title\": \"System for Real-time Video Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-15\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a novel algorithm for compressing video data in real-time, reducing bandwidth requirements while maintaining acceptable video quality. The system utilizes a wavelet transform and entropy encoding scheme.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Efficient Video Coding Using Wavelet Transforms\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing video data comprising...\",\n        \"A system for encoding video streams...\",\n        \"A device for real-time video processing...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66758", "text": "{\n    \"patent_title\": \"Enhanced Image Processing Techniques for Satellite Imagery\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides novel image processing techniques for enhancing the clarity and detail of satellite imagery. These techniques utilize advanced algorithms to reduce noise and improve contrast, resulting in higher quality images for various applications. The techniques do not rely on medical imaging principles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Improved Noise Reduction Algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image clarity...\",\n        \"An apparatus for processing satellite imagery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66758", "text": "{\n    \"patent_title\": \"Medical Image Analysis System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Healthcare Solutions Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-11-20\",\n    \"filing_date\": \"2019-11-20\",\n    \"issue_date\": \"2022-02-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for analyzing medical images, specifically MRI and CT scans, to detect anomalies. This uses complex image processing techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Advanced Medical Imaging Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A system for analyzing medical images...\",\n        \"A method for detecting anomalies in MRI scans...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66759", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-12-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing image recognition accuracy through the application of deep learning techniques. The system employs a convolutional neural network architecture trained on a large dataset of labeled images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Classification using Support Vector Machines\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Object Detection with Convolutional Neural Networks\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Feature Extraction for Image Analysis\"\n        },\n        {\n            \"patent_number\": \"US11345678B2\",\n            \"title\": \"Recurrent Neural Networks for Image Captioning\"\n        },\n        {\n            \"patent_number\": \"US10456789B2\",\n            \"title\": \"Attention Mechanisms in Deep Learning\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising a convolutional neural network...\",\n        \"A method for training an image recognition system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66759", "text": "{\n    \"patent_title\": \"Improved Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2021-01-15\",\n    \"issue_date\": \"2023-07-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles that optimizes charging and discharging cycles to extend battery life and enhance performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US91234567B1\",\n            \"title\": \"Battery Monitoring and Control Systems\"\n        },\n        {\n            \"patent_number\": \"US10765432B2\",\n            \"title\": \"Lithium-Ion Battery Charging Techniques\"\n        },\n        {\n            \"patent_number\": \"US8654321B1\",\n            \"title\": \"Thermal Management for Batteries\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising a microcontroller...\",\n        \"A method for controlling the charging of a battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66760", "text": "{\n    \"patent_title\": \"Neural Network Architecture for Efficient Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel neural network architecture designed for efficient image recognition tasks, utilizing optimized convolutional layers and attention mechanisms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in convolutional neural networks\"\n        }\n    ],\n    \"claims\": [\n        \"A neural network architecture comprising...\",\n        \"A method for image recognition using the architecture...\"\n    ]\n}"}
