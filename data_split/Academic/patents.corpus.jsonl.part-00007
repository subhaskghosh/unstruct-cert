{"_id": "Academic--patents--p--66849", "text": "{\n    \"patent_title\": \"Improved Gradient Descent Algorithm for Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel gradient descent algorithm is presented, significantly improving the training speed and accuracy of deep neural networks. The algorithm incorporates adaptive learning rates and momentum.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for training a deep neural network using a gradient descent algorithm.\",\n        \"The method of claim 1, wherein the gradient descent algorithm incorporates adaptive learning rates.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66849", "text": "{\n    \"patent_title\": \"System for Enhanced Data Storage\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Eve Davis\",\n            \"affiliation\": \"Amazon Web Services\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2019-08-01\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2021-07-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new system for high-capacity data storage is disclosed, utilizing a novel compression algorithm and error correction techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A system for storing data comprising a compression module and an error correction module.\",\n        \"The system of claim 1, wherein the compression module utilizes a lossless compression algorithm.\"\n    ]\n}"}
