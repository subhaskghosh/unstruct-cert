{"_id": "Academic--patents--p--66634", "text": "{\n    \"patent_title\": \"Method and System for Optimized Data Stream Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for optimizing data stream processing using adaptive algorithms. The invention enhances data throughput and reduces latency by dynamically adjusting processing parameters based on real-time data characteristics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in data streaming\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing a data stream comprising...\",\n        \"A system for optimizing data throughput...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66634", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved bicycle braking system utilizing a novel hydraulic mechanism to provide enhanced stopping power and responsiveness.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Previous braking designs\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle braking system comprising...\",\n        \"A hydraulic mechanism for enhanced braking...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66635", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2018-02-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable biosensor for continuous glucose monitoring. The device utilizes a novel enzyme-based electrochemical sensing technology and wireless communication capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Implantable Glucose Sensor\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Wireless Communication System for Medical Devices\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Miniaturized Electrochemical Sensors\"\n        },\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"title\": \"Biocompatible Materials for Implants\"\n        },\n        {\n            \"patent_number\": \"US5432109B2\",\n            \"title\": \"Methods for Continuous Glucose Monitoring\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable biosensor comprising...\",\n        \"A method for continuous glucose monitoring using said biosensor...\"\n    ]\n}"}
