{"_id": "Academic--patents--p--66369", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-05-20\",\n    \"issue_date\": \"2019-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the quality of reconstructed images, particularly in medical imaging applications. Utilizes advanced algorithms to reduce noise and improve resolution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Processing Technique\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Noise Reduction Algorithm\"\n        },\n        {\n            \"patent_number\": \"US9543210B1\",\n            \"title\": \"Image Enhancement System\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Medical Image Reconstruction\"\n        },\n        {\n            \"patent_number\": \"US8901234B1\",\n            \"title\": \"Digital Image Filtering\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an image...\",\n        \"A system comprising a processor...\"\n    ]\n}"}
