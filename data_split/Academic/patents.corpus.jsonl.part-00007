{"_id": "Academic--patents--p--69805", "text": "{\n    \"patent_title\": \"Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"California Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-06-10\",\n    \"issue_date\": \"2018-11-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless pressure sensor system for real-time monitoring of various industrial applications. The system utilizes a low-power sensor and a robust communication protocol.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for monitoring pressure using...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69805", "text": "{\n    \"patent_title\": \"Microfluidic Sensor for Biomedical Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-04-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic sensor for the detection of biomarkers in biological samples. The sensor utilizes a novel surface chemistry for enhanced sensitivity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic sensor comprising...\",\n        \"A method for detecting biomarkers using...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69806", "text": "{\n    \"patent_title\": \"Novel Polymer Composites for Enhanced Durability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel polymer composites with enhanced durability and resistance to degradation. The materials are suitable for use in aerospace and automotive applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A polymer composite comprising...\",\n        \"A method for manufacturing the polymer composite...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69806", "text": "{\n    \"patent_title\": \"Improved Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"Lawrence Livermore National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-11-01\",\n    \"filing_date\": \"2009-11-01\",\n    \"issue_date\": \"2017-05-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery electrode material exhibiting increased energy density and cycle life. This invention utilizes a unique nanostructure to improve ion transport.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7432109B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"An electrode material comprising...\",\n        \"A battery cell incorporating the electrode material...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69807", "text": "{\n    \"patent_title\": \"System and method for object recognition using deep convolutional neural networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2019-11-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for identifying objects in images using deep convolutional neural networks. The system includes a training module, an inference module, and a database of labeled images. The method involves training the network on the labeled images and then using the trained network to identify objects in new images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A system for object recognition comprising...\",\n        \"A method for identifying objects in an image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69807", "text": "{\n    \"patent_title\": \"Medical Image Analysis System Using Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        }\n    ],\n    \"patent_number\": \"US11123456B2\",\n    \"priority_date\": \"2019-03-10\",\n    \"filing_date\": \"2019-03-10\",\n    \"issue_date\": \"2021-02-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for analyzing medical images using deep convolutional neural networks to detect anomalies and assist in diagnosis. The system processes X-rays, MRIs, and CT scans to identify potential medical issues. This invention specifically targets applications in medical imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A medical image analysis system comprising...\",\n        \"A method for detecting anomalies in medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69808", "text": "{\n    \"patent_title\": \"Wireless Sensor Network for Structural Health Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless sensor network for real-time structural health monitoring of bridges and buildings. The system utilizes low-power sensors to detect strain, vibration, and temperature changes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"relevance\": \"similar\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor node comprising...\",\n        \"A system for structural health monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69808", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Biocompatible Coating\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2012-03-10\",\n    \"filing_date\": \"2012-03-10\",\n    \"issue_date\": \"2020-02-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor with a biocompatible coating for continuous glucose monitoring in diabetic patients. The sensor utilizes electrochemical detection methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US9123456B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable glucose sensor...\",\n        \"A method for continuous glucose monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69809", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition Using Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-05-15\",\n    \"filing_date\": \"2020-06-01\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition using deep neural networks, improving accuracy and efficiency in object detection. The system employs convolutional neural networks and transfer learning techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising a convolutional neural network.\",\n        \"A method for object detection using transfer learning.\",\n        \"The system of claim 1, wherein the convolutional neural network comprises multiple layers.\",\n        \"The method of claim 2, wherein the transfer learning utilizes a pre-trained model.\",\n        \"The system of claim 1, further comprising a processing unit.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69809", "text": "{\n    \"patent_title\": \"Neural Network Architecture for Financial Forecasting\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Stanford Research Institute\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2021-02-10\",\n    \"filing_date\": \"2021-03-01\",\n    \"issue_date\": \"2023-04-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel neural network architecture for accurate financial forecasting, utilizing recurrent neural networks and time series analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10111213B1\",\n            \"relevance\": \"Related Application\"\n        }\n    ],\n    \"claims\": [\n        \"A neural network for financial forecasting.\",\n        \"The neural network of claim 1, comprising recurrent layers.\",\n        \"A method for time series analysis using the neural network of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69810", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system is disclosed. The system includes a pressure sensor, a wireless communication module, and a power source. The sensor is designed for biomedical applications and provides accurate and reliable pressure measurements.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Similar sensor technology\"\n        }\n    ],\n    \"claims\": [\n        \"A pressure sensor system comprising...\",\n        \"A wireless communication module for transmitting data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69810", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Sarah Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-07-20\",\n    \"filing_date\": \"2017-07-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles is presented. The system optimizes battery performance and extends battery life through advanced control algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related battery technology\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A control algorithm for optimizing battery performance...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69811", "text": "{\n    \"patent_title\": \"Improved Electrolyte for High-Energy Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel electrolyte composition for lithium-ion batteries exhibiting improved ionic conductivity and thermal stability. This electrolyte utilizes a new lithium salt and a co-solvent system resulting in enhanced battery performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related art in lithium-ion battery chemistry.\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrolyte...\",\n        \"An electrolyte composition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69811", "text": "{\n    \"patent_title\": \"Battery Management System with Advanced Cell Balancing\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Tesla\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-02-15\",\n    \"filing_date\": \"2017-02-14\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) for lithium-ion battery packs. The BMS includes advanced cell balancing algorithms to improve battery life and performance. It also provides overcharge and over-discharge protection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Prior art in battery management systems.\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related art in battery management\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for cell balancing in a lithium-ion battery pack...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69812", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery Electrode with Enhanced Cycle Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery electrode material is disclosed, exhibiting significantly improved cycle life and rate capability. The material comprises a composite structure of nickel-rich NMC and a conductive polymer coating.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"High-Capacity Cathode Material\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrode comprising...\",\n        \"A method for manufacturing a lithium-ion battery electrode...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69812", "text": "{\n    \"patent_title\": \"Battery Management System for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Texas Instruments\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) for lithium-ion batteries is described. The BMS provides accurate state-of-charge estimation and cell balancing capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Advanced Battery Management Techniques\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"High-Capacity Cathode Material\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for managing a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69813", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system and method for image recognition using artificial intelligence techniques. The system employs deep learning algorithms to analyze image data and identify objects with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Prior Art Image Recognition System\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for analyzing image data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69813", "text": "{\n    \"patent_title\": \"Improved Battery Charging Circuit\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"ElectroTech Solutions\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-06-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved circuit for charging lithium-ion batteries, enhancing efficiency and lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Existing Battery Charger\"\n        }\n    ],\n    \"claims\": [\n        \"A battery charging circuit comprising...\",\n        \"A method for optimizing battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69814", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Processing Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-06-15\",\n    \"issue_date\": \"2020-04-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method and system for enhancing images using deep learning techniques. The system efficiently processes images to improve clarity and reduce noise, enabling superior image quality in various applications like medical imaging and autonomous driving.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image comprising...\",\n        \"A system for processing images...\",\n        \"A computer-readable medium...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69814", "text": "{\n    \"patent_title\": \"Novel Method for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11112222B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-02-10\",\n    \"issue_date\": \"2022-05-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new approach to data compression, utilizing a unique algorithm to reduce file sizes without significant loss of information. This is applicable to various data types, including text, images, and video.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10101010B2\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data...\",\n        \"A system for encoding data...\",\n        \"A computer program...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69815", "text": "{\n    \"patent_title\": \"Method and System for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for image recognition utilizing artificial intelligence techniques, specifically convolutional neural networks. The system is capable of identifying objects with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Previous Image Recognition System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69815", "text": "{\n    \"patent_title\": \"Novel Wireless Communication Protocol\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Nokia Bell Labs\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new wireless communication protocol designed for improved data transfer rates and reduced latency. It utilizes advanced modulation techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Existing Wireless Communication System\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication protocol comprising...\",\n        \"A method for data transmission comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69816", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Processing using Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method and system for enhanced image processing using deep convolutional neural networks. The system improves image quality and recognition accuracy. Applications include medical imaging and autonomous vehicles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Enhancement Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing an image using a neural network.\",\n        \"A system comprising a processor and memory configured to implement the method.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69816", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876544B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-02-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel battery design utilizing a new electrolyte material, resulting in increased energy density and longer lifespan for mobile devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Lithium-Ion Battery Improvements\"\n        }\n    ],\n    \"claims\": [\n        \"A battery comprising a novel electrolyte material.\",\n        \"A mobile device powered by the battery.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69817", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized wireless pressure sensor system for biomedical applications. The system utilizes a MEMS pressure sensor and a low-power wireless transceiver for real-time data transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for monitoring pressure using the sensor system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69817", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2019-01-20\",\n    \"filing_date\": \"2019-03-01\",\n    \"issue_date\": \"2021-08-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel battery architecture with increased energy density and cycle life. It utilizes new electrode materials and electrolyte formulations to achieve superior performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising...\",\n        \"A method for manufacturing the battery cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69818", "text": "{\n    \"patent_title\": \"High-Capacity Flow Battery System for Grid-Scale Energy Storage\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-07-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel flow battery system utilizing vanadium redox couples in a non-aqueous electrolyte for efficient and long-duration energy storage. The system provides enhanced capacity and stability compared to existing technologies, particularly suited for grid-scale applications. The design focuses on minimizing electrolyte crossover and maximizing energy density.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8546021B2\",\n            \"title\": \"Electrolyte compositions for flow batteries\"\n        },\n        {\n            \"patent_number\": \"US7884012B2\",\n            \"title\": \"Vanadium redox flow battery stack configuration\"\n        }\n    ],\n    \"claims\": [\n        \"A flow battery comprising a vanadium redox couple in a non-aqueous electrolyte.\",\n        \"The flow battery of claim 1, wherein the electrolyte minimizes vanadium crossover.\",\n        \"A system for grid-scale energy storage utilizing the flow battery of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69818", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery with Enhanced Cycling Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Argonne National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents an improved lithium-ion battery cathode material utilizing a novel doping strategy to enhance cycling stability and energy density. The material demonstrates superior performance in electric vehicle applications and provides a significant advancement in battery technology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Lithium iron phosphate cathode material for lithium-ion batteries\"\n        },\n        {\n            \"patent_number\": \"US8785214B2\",\n            \"title\": \"Electrolyte additives for improving lithium-ion battery performance\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery cathode material comprising a doped lithium metal oxide.\",\n        \"The lithium-ion battery of claim 1, exhibiting enhanced cycling stability.\",\n        \"A method for manufacturing the lithium-ion battery cathode material of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69819", "text": "{\n    \"patent_title\": \"Wireless Sensor Network for Structural Health Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless sensor network for monitoring the structural integrity of bridges and buildings. The system utilizes low-power sensors to detect strain, vibration, and temperature changes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Wireless Communication Protocols\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor network comprising a plurality of sensor nodes.\",\n        \"A method for monitoring structural health using a wireless sensor network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69819", "text": "{\n    \"patent_title\": \"Implantable Sensor for Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-09-20\",\n    \"filing_date\": \"2017-09-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable sensor for continuous glucose monitoring in diabetic patients. The sensor transmits data wirelessly to an external receiver.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Miniaturized Medical Sensors\"\n        },\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"title\": \"Implantable Drug Delivery Systems\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable glucose sensor comprising a biocompatible housing.\",\n        \"A method for continuous glucose monitoring using an implantable sensor.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69820", "text": "{\n    \"patent_title\": \"Method and System for Neural Network Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for compressing neural networks, reducing their size and computational complexity while maintaining accuracy. The method utilizes a novel pruning technique based on gradient information.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a neural network...\",\n        \"A system for implementing the compression method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69820", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Panasonic\"\n        },\n        {\n            \"name\": \"Eve Green\",\n            \"affiliation\": \"Samsung SDI\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2018-06-01\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2021-02-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) for electric vehicles, improving battery life and performance through advanced charging algorithms and thermal management techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69821", "text": "{\n    \"patent_title\": \"Neural Network Architecture for Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-02-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel neural network architecture is presented for improved image recognition accuracy. The network utilizes convolutional layers and pooling mechanisms to extract relevant features from input images. Applications include object detection and image classification.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A neural network architecture comprising convolutional layers and pooling layers.\",\n        \"A method for image recognition using the aforementioned neural network architecture.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69821", "text": "{\n    \"patent_title\": \"Method for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Beta Industries\"\n        }\n    ],\n    \"patent_number\": \"US7654321B2\",\n    \"priority_date\": \"2009-12-10\",\n    \"filing_date\": \"2009-12-10\",\n    \"issue_date\": \"2018-01-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new method for lossless data compression is described. The method utilizes Huffman coding and run-length encoding to reduce file sizes. Applications include archiving and data transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression utilizing Huffman coding.\",\n        \"A system for archiving data using the aforementioned method.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69822", "text": "{\n    \"patent_title\": \"Improved Contrast Agent for Magnetic Resonance Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-02-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel contrast agent for magnetic resonance imaging (MRI). The agent provides significantly improved image contrast and reduced toxicity compared to existing agents. It utilizes a targeted nanoparticle delivery system for enhanced specificity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"MRI Contrast Agents\"\n        }\n    ],\n    \"claims\": [\n        \"A contrast agent for MRI comprising a nanoparticle...\",\n        \"A method for enhancing MRI image contrast using the agent...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69822", "text": "{\n    \"patent_title\": \"Digital X-Ray Image Enhancement System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10246813B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-07-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a digital X-ray image enhancement system utilizing advanced filtering techniques to improve image clarity and reduce noise. The system provides real-time processing capabilities for enhanced diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Digital Radiography Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A digital X-ray image enhancement system comprising...\",\n        \"A method for enhancing X-ray images using filtering techniques...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69823", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Processing Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2013-02-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for enhancing image processing capabilities using deep learning algorithms. It improves image clarity, reduces noise, and enables advanced object recognition.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing an image comprising...\",\n        \"A system for enhancing image quality...\",\n        \"The method of claim 1, wherein...\",\n        \"The system of claim 2, further comprising...\",\n        \"A non-transitory computer-readable medium...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69823", "text": "{\n    \"patent_title\": \"Wireless Communication System with Improved Signal Strength\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Bell Labs\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2009-12-01\",\n    \"filing_date\": \"2009-12-01\",\n    \"issue_date\": \"2012-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless communication system designed to improve signal strength and reduce interference. This invention utilizes advanced antenna techniques and signal processing algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication system comprising...\",\n        \"An antenna configured to transmit...\",\n        \"A signal processing unit...\",\n        \"The system of claim 2, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69824", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2020-06-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the resolution of digital images using deep learning techniques. The system employs a convolutional neural network trained on a large dataset of high-resolution images to predict the missing details in low-resolution images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"high\"\n        },\n        {\n            \"patent_number\": \"US10234567B1\",\n            \"relevance\": \"medium\"\n        },\n        {\n            \"patent_number\": \"US11123456B2\",\n            \"relevance\": \"medium\"\n        },\n        {\n            \"patent_number\": \"US20170234567A1\",\n            \"relevance\": \"low\"\n        },\n        {\n            \"patent_number\": \"US20190345678A1\",\n            \"relevance\": \"low\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing the resolution of a digital image, comprising...\",\n        \"A system for enhancing the resolution of a digital image, comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69824", "text": "{\n    \"patent_title\": \"Novel Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2021-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new data compression algorithm that achieves higher compression ratios than existing methods. The algorithm uses a combination of Huffman coding and Lempel-Ziv compression.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"medium\"\n        },\n        {\n            \"patent_number\": \"US10234567B1\",\n            \"relevance\": \"low\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data, comprising...\",\n        \"A system for compressing data, comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69825", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system is disclosed. The system utilizes a MEMS pressure sensor and a low-power wireless transceiver for remote monitoring of pressure values. This system can be used in various applications, including medical diagnostics and industrial process control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Wireless Sensor Network\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for remotely monitoring pressure using...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69825", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-12-20\",\n    \"filing_date\": \"2009-12-20\",\n    \"issue_date\": \"2018-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved lithium-ion battery design featuring enhanced energy density and cycle life. The battery utilizes a novel electrolyte composition and electrode materials.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"title\": \"Lithium Ion Battery\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"A method for manufacturing a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69826", "text": "{\n    \"patent_title\": \"System and method for intelligent data analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2020-01-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for intelligent data analysis utilizing artificial intelligence techniques, including machine learning and deep learning, to identify patterns and anomalies in large datasets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Data mining system\"\n        }\n    ],\n    \"claims\": [\n        \"A system for analyzing data comprising...\",\n        \"A method for identifying patterns in data comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69826", "text": "{\n    \"patent_title\": \"Improved mechanical gear design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Motors\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Ford Motor Company\"\n        }\n    ],\n    \"patent_number\": \"US1234567B2\",\n    \"priority_date\": \"2015-03-10\",\n    \"filing_date\": \"2015-03-10\",\n    \"issue_date\": \"2017-09-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved mechanical gear design for enhanced efficiency and durability in automotive applications.  This design focuses on material selection and tooth profile optimization.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Automotive gear system\"\n        }\n    ],\n    \"claims\": [\n        \"A gear comprising...\",\n        \"A method for manufacturing a gear comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69827", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2018-03-01\",\n    \"issue_date\": \"2019-04-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system and method for image recognition utilizing artificial intelligence and deep learning techniques. The system is capable of identifying objects in images with high accuracy and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for identifying objects in an image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69827", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11876543B2\",\n    \"priority_date\": \"2018-02-10\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2020-11-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an improved battery management system for electric vehicles, optimizing energy efficiency and extending battery life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69828", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-05-15\",\n    \"filing_date\": \"2010-02-28\",\n    \"issue_date\": \"2018-07-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel data compression algorithm utilizing adaptive entropy encoding for improved compression ratios.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"kind\": \"Cited by examiner\"\n        },\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"kind\": \"Cited by applicant\"\n        },\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"kind\": \"Cited by examiner\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"kind\": \"Cited by applicant\"\n        },\n        {\n            \"patent_number\": \"US11123456B2\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data comprising...\",\n        \"A system for compressing data comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69828", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Robert Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2008-11-20\",\n    \"filing_date\": \"2009-12-15\",\n    \"issue_date\": \"2017-05-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new battery management system for electric vehicles with improved charge efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7543210B1\",\n            \"kind\": \"Cited by examiner\"\n        },\n        {\n            \"patent_number\": \"US8012345B1\",\n            \"kind\": \"Cited by applicant\"\n        },\n        {\n            \"patent_number\": \"US9123456B1\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for managing a battery comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69829", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition utilizing artificial intelligence techniques, specifically deep convolutional neural networks. The system is capable of identifying objects with high accuracy and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for identifying objects in an image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69829", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2014-12-10\",\n    \"filing_date\": \"2014-12-10\",\n    \"issue_date\": \"2022-05-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles. This system enhances battery life and performance through advanced charging algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69830", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-05-20\",\n    \"issue_date\": \"2018-07-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system is described. The system includes a MEMS pressure sensor, a low-power transceiver, and a battery. The sensor is used for medical and industrial applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"The system of claim 1, wherein the sensor is a MEMS sensor.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69830", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-11-01\",\n    \"filing_date\": \"2010-01-10\",\n    \"issue_date\": \"2017-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This patent details advancements in lithium-ion battery technology, focusing on increased energy density and cycle life. A novel electrode material is presented.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B2\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"The battery of claim 1, having an energy density of at least...\"\n    ]\n}"}
