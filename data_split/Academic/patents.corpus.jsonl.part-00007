{"_id": "Academic--patents--p--66983", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for improved image recognition using artificial intelligence and deep learning techniques. The system utilizes convolutional neural networks to analyze images and identify objects with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Processing System\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for identifying objects in an image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66983", "text": "{\n    \"patent_title\": \"Novel Mechanical Gear Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-11-10\",\n    \"filing_date\": \"2019-11-10\",\n    \"issue_date\": \"2022-05-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new mechanical gear design that improves efficiency and reduces wear and tear. The gear utilizes a unique tooth profile and material composition for optimal performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Traditional Gear Mechanism\"\n        }\n    ],\n    \"claims\": [\n        \"A gear comprising a novel tooth profile...\",\n        \"A mechanical system incorporating the gear...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66984", "text": "{\n    \"patent_title\": \"System and Method for Dynamic Spectrum Allocation\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-03-15\",\n    \"filing_date\": \"2015-05-20\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for dynamically allocating spectrum to wireless devices based on real-time demand and interference levels. The system utilizes machine learning algorithms to predict spectrum usage and optimize allocation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Spectrum Sensing Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A system for dynamic spectrum allocation...\",\n        \"A method for optimizing spectrum usage...\"\n    ]\n}"}
