{"_id": "Academic--patents--p--66654", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Enhanced Biocompatibility\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2018-02-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor utilizing a novel biocompatible coating to minimize inflammatory response and improve long-term stability. The sensor provides continuous glucose monitoring for diabetic patients.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A glucose sensor comprising a biocompatible coating.\",\n        \"The glucose sensor of claim 1, wherein the coating is based on polyethylene glycol.\",\n        \"A method of continuously monitoring glucose levels using the sensor.\",\n        \"The method of claim 3, wherein the data is transmitted wirelessly.\",\n        \"A system for calibrating the glucose sensor.\",\n        \"The system of claim 5, comprising a user interface for displaying glucose readings.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66654", "text": "{\n    \"patent_title\": \"Surgical Instrument for Bone Cutting\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2019-03-01\",\n    \"filing_date\": \"2019-04-15\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical instrument designed for precise bone cutting during orthopedic procedures. The instrument features a novel blade geometry for reduced tissue damage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising a bone cutting blade.\",\n        \"The instrument of claim 1, wherein the blade is made of titanium alloy.\",\n        \"A method of performing bone cutting using the instrument.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66655", "text": "{\n    \"patent_title\": \"Improved Machine Learning Model for Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel machine learning model for image recognition that achieves higher accuracy and efficiency than existing methods. The model utilizes a deep convolutional neural network with a unique attention mechanism.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Prior Art Image Recognition System\"\n        }\n    ],\n    \"claims\": [\n        \"A machine learning model comprising a convolutional neural network.\",\n        \"The model of claim 1, further comprising an attention mechanism.\",\n        \"A method for image recognition using the model of claim 1.\",\n        \"A system for implementing the method of claim 3.\",\n        \"The system of claim 4, wherein the image is a medical image.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66655", "text": "{\n    \"patent_title\": \"Enhanced Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2020-03-01\",\n    \"filing_date\": \"2020-04-15\",\n    \"issue_date\": \"2021-10-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a new data compression algorithm that provides superior compression ratios and faster processing speeds. It's optimized for large datasets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Existing Data Compression Method\"\n        }\n    ],\n    \"claims\": [\n        \"A data compression algorithm utilizing a wavelet transform.\",\n        \"The algorithm of claim 1, further comprising a quantization step.\",\n        \"A method for compressing data using the algorithm of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66656", "text": "{\n    \"patent_title\": \"Miniature Implantable Blood Glucose Sensor\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-05-20\",\n    \"issue_date\": \"2018-06-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable glucose sensor for continuous glucose monitoring. The sensor utilizes a novel enzymatic reaction and a microfabricated electrochemical cell.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art in glucose sensing technology\"\n        }\n    ],\n    \"claims\": [\n        \"A method for continuously monitoring glucose levels in a patient.\",\n        \"An implantable glucose sensor comprising an enzymatic reaction chamber.\",\n        \"A microfabricated electrochemical cell for glucose detection.\",\n        \"A system for wirelessly transmitting glucose data to a remote monitoring device.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66656", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"California Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2009-12-10\",\n    \"filing_date\": \"2010-01-15\",\n    \"issue_date\": \"2015-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved braking system for bicycles, utilizing a novel caliper design and advanced brake pad materials.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"relevance\": \"Previous bicycle braking designs\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle braking system comprising a caliper and brake pads.\",\n        \"A caliper designed to enhance braking force.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66657", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing image recognition accuracy using deep learning algorithms. The system includes a convolutional neural network trained on a large dataset of labeled images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66657", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2021-07-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery technology for electric vehicles, offering higher energy density and faster charging times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising...\",\n        \"An electric vehicle utilizing the battery cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66658", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-03-15\",\n    \"filing_date\": \"2010-05-20\",\n    \"issue_date\": \"2018-08-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for improving the reliability and efficiency of wireless communication signals.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for wireless communication comprising...\",\n        \"A method for improving signal reliability...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66658", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2008-11-01\",\n    \"filing_date\": \"2011-02-10\",\n    \"issue_date\": \"2017-09-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery technology with increased energy density and lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B2\",\n            \"relevance\": \"Prior art in battery materials\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising...\",\n        \"A method for manufacturing a high-density battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66659", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"XYZ Corp\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-05-15\",\n    \"filing_date\": \"2010-06-01\",\n    \"issue_date\": \"2018-08-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the resolution of digital images using deep learning techniques. The system includes a convolutional neural network trained to predict high-resolution details from low-resolution input images. This technology is applicable to various image processing applications, including medical imaging and satellite imagery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Image Enhancement Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising...\",\n        \"A system for processing images, comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66659", "text": "{\n    \"patent_title\": \"System for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Inc.\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2009-12-20\",\n    \"filing_date\": \"2010-01-10\",\n    \"issue_date\": \"2017-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for compressing data using a novel algorithm, achieving high compression ratios.  Suitable for use in digital storage and transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Data Compression Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data comprising...\",\n        \"A system for storing compressed data comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66660", "text": "{\n    \"patent_title\": \"System and Method for Image Recognition using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition using deep convolutional neural networks is disclosed. The system comprises a convolutional neural network trained on a large dataset of images. The method includes receiving an input image, processing the image through the convolutional neural network, and outputting a classification of the image.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Classification System\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for image recognition, comprising...\",\n        \"2. The system of claim 1, wherein the convolutional neural network...\",\n        \"3. A method for image recognition...\",\n        \"4. The method of claim 3, wherein the processing step...\",\n        \"5. The method of claim 3, further comprising...\",\n        \"6. A non-transitory computer-readable medium...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66660", "text": "{\n    \"patent_title\": \"Method for Enhancing Audio Signal Quality\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-10-31\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for enhancing the quality of audio signals is disclosed. The method involves filtering noise and amplifying desired frequencies to improve clarity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Audio Processing System\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for enhancing audio signal quality...\",\n        \"2. The method of claim 1, wherein the filtering step...\",\n        \"3. A system for implementing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66661", "text": "{\n    \"patent_title\": \"AI-Powered Predictive Maintenance System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of Innovation\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system for predictive maintenance utilizing artificial intelligence and machine learning algorithms to analyze sensor data and predict equipment failures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"title\": \"Sensor Data Analysis\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predicting equipment failure comprising...\",\n        \"A method for analyzing sensor data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66661", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Energy Corp\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-05-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new lithium-ion battery design with increased energy density and cycle life. It utilizes novel electrode materials and a refined electrolyte composition.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Lithium-Ion Battery Materials\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrode material...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66662", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-16\",\n    \"issue_date\": \"2019-04-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a lithium-ion battery with improved stability and cycle life through the use of a novel electrolyte additive. The battery exhibits enhanced performance in high-temperature applications and is particularly suitable for electric vehicle and energy storage systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Improved Lithium Battery Electrolyte\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte additive for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66662", "text": "{\n    \"patent_title\": \"Sodium-Ion Battery with High Power Density\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emily Chen\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2012-11-01\",\n    \"filing_date\": \"2012-11-02\",\n    \"issue_date\": \"2020-01-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a sodium-ion battery with a high power density achieved through a unique electrode material and cell design. The battery is intended for applications requiring rapid charge and discharge capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8987654B2\",\n            \"title\": \"Novel Sodium-Ion Electrode Materials\"\n        }\n    ],\n    \"claims\": [\n        \"A sodium-ion battery comprising...\",\n        \"An electrode material for a sodium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66663", "text": "{\n    \"patent_title\": \"Novel Electrolyte Composition for High-Performance Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel electrolyte composition for lithium-ion batteries is disclosed, exhibiting improved ionic conductivity and thermal stability. This composition enables higher energy density and longer cycle life in lithium-ion cells used in electric vehicles and grid-scale energy storage. This invention focuses on the core chemistry of the electrolyte and does not incorporate complex battery management systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Lithium-Ion Battery Separator\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrolyte comprising...\",\n        \"A method of manufacturing a lithium-ion battery using the electrolyte...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66663", "text": "{\n    \"patent_title\": \"Intelligent Battery Management System for Lithium-Ion Battery Packs\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Tesla, Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2022-05-10\",\n    \"filing_date\": \"2022-05-10\",\n    \"issue_date\": \"2024-02-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An intelligent battery management system (BMS) for lithium-ion battery packs is presented. The BMS monitors cell voltage, current, and temperature to optimize charging and discharging, ensuring safety and prolonging battery life. The system includes advanced algorithms for state-of-charge estimation and fault detection, enhancing the reliability of the battery pack.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Lithium-Ion Battery Cell with Enhanced Safety Features\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method of controlling a lithium-ion battery pack using the system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66664", "text": "{\n    \"patent_title\": \"Enhanced Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel electrode materials for lithium-ion batteries, exhibiting improved energy density and cycle life. The materials incorporate a unique nano-structured composite.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrode material for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66664", "text": "{\n    \"patent_title\": \"Improved Solar Cell Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2021-07-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel design for solar cells, increasing efficiency through the use of advanced light trapping techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A solar cell comprising...\",\n        \"A light trapping structure for a solar cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66665", "text": "{\n    \"patent_title\": \"AI-Powered Predictive Maintenance System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Advanced Analytics Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-08-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention utilizes artificial intelligence algorithms to predict equipment failures in industrial settings, minimizing downtime and maintenance costs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predicting equipment failure...\",\n        \"A method for utilizing artificial intelligence...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66665", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Energy Innovations Corp.\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"PowerTech Systems\"\n        },\n        {\n            \"name\": \"Eve Green\",\n            \"affiliation\": \"Eco Solutions Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel battery management system for electric vehicles, improving efficiency and lifespan.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery performance...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66666", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Processing Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method and system for enhanced image processing utilizing deep learning algorithms. The system achieves superior performance in image recognition and object detection tasks.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Prior Art Image Processing Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing an image comprising...\",\n        \"A system for image analysis comprising...\"\n    ]\n}"}
