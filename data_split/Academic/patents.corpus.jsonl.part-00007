{"_id": "Academic--patents--p--66580", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-11-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2021-05-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for remote monitoring applications. The sensor utilizes a MEMS pressure transducer and a low-power wireless communication module. This invention provides a robust and accurate solution for various industrial and medical sensing needs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising...\",\n        \"A system for remote pressure monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66580", "text": "{\n    \"patent_title\": \"Advanced Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2019-08-10\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2021-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles. The system optimizes charging and discharging cycles to extend battery life and improve performance. It includes sophisticated algorithms for state-of-charge estimation and thermal management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66581", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical system providing improved visualization and precision for minimally invasive procedures. The system incorporates advanced imaging and robotic control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        },\n        {\n            \"patent_number\": \"US11111111B2\"\n        },\n        {\n            \"patent_number\": \"US22222222B2\"\n        },\n        {\n            \"patent_number\": \"US33333333B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising...\",\n        \"A method for performing a minimally invasive procedure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66581", "text": "{\n    \"patent_title\": \"Novel Bandage for Wound Healing\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-08-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new type of bandage designed to accelerate wound healing through controlled drug delivery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        },\n        {\n            \"patent_number\": \"US90123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A bandage comprising...\",\n        \"A method for treating wounds...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66582", "text": "{\n    \"patent_title\": \"Method and System for Personalized Recommendations using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for providing personalized recommendations to users based on deep learning models. The system analyzes user behavior and preferences to predict items the user may be interested in.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"title\": \"Machine Learning Algorithm for Data Classification\"\n        },\n        {\n            \"patent_number\": \"US8987654B2\",\n            \"title\": \"Neural Network Architecture for Pattern Recognition\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating personalized recommendations comprising...\",\n        \"A system for analyzing user data comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66582", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US7654321B1\",\n    \"priority_date\": \"2008-11-20\",\n    \"filing_date\": \"2008-11-20\",\n    \"issue_date\": \"2011-07-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved braking system for bicycles, providing enhanced stopping power and control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"title\": \"Bicycle Brake Lever Design\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle braking system comprising...\",\n        \"A brake lever with improved ergonomics...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66583", "text": "{\n    \"patent_title\": \"Neural Network Based Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Li Wei\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2008-05-15\",\n    \"filing_date\": \"2009-03-20\",\n    \"issue_date\": \"2019-06-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A neural network based system for image recognition, improving accuracy and efficiency in identifying objects within images. The system utilizes convolutional neural networks and deep learning algorithms to achieve high performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Image Processing Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising a neural network.\",\n        \"A method for identifying objects in an image using deep learning.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66583", "text": "{\n    \"patent_title\": \"Advanced Robotics Control System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US8901234B1\",\n    \"priority_date\": \"2007-11-01\",\n    \"filing_date\": \"2008-09-15\",\n    \"issue_date\": \"2018-12-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A robotics control system employing advanced algorithms for precise and efficient robotic movement. The system allows for improved automation and control in a variety of industrial applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"title\": \"Robotics and Automation\"\n        }\n    ],\n    \"claims\": [\n        \"A control system for robotics comprising advanced algorithms.\",\n        \"A method for controlling robotic movement.\"\n    ]\n}"}
