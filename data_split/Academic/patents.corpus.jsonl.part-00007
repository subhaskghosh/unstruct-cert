{"_id": "Academic--patents--p--66037", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-11-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor capable of continuous glucose monitoring and wireless data transmission to a mobile device. The sensor utilizes a novel enzyme-based electrochemical detection method.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art related to glucose sensing technology\"\n        }\n    ],\n    \"claims\": [\n        \"1. A glucose sensor comprising...\",\n        \"2. The glucose sensor of claim 1, wherein...\",\n        \"3. A method for measuring glucose levels...\",\n        \"4. The method of claim 3, wherein...\",\n        \"5. A system for monitoring glucose levels...\",\n        \"6. The system of claim 5, wherein...\",\n        \"7. The system of claim 5, further comprising...\"\n    ]\n}"}
