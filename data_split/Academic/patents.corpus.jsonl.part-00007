{"_id": "Academic--patents--p--66031", "text": "{\n    \"patent_title\": \"Systems and Methods for Personalized Recommendations Using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Sergey Brin\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Larry Page\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2008-05-15\",\n    \"filing_date\": \"2009-03-01\",\n    \"issue_date\": \"2019-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for providing personalized recommendations to users based on machine learning algorithms. The system analyzes user behavior and preferences to identify relevant items for recommendation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"kind\": \"Cited by\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating personalized recommendations comprising...\",\n        \"A system for providing recommendations...\"\n    ]\n}"}
