{"_id": "Academic--patents--n--69762", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2022-01-15\",\n    \"filing_date\": \"2022-01-15\",\n    \"issue_date\": \"2024-01-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery management system enhancing battery life and safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US55555555B1\",\n            \"title\": \"Early Battery Technology\"\n        },\n        {\n            \"patent_number\": \"US66666666A1\",\n            \"title\": \"Battery Charging Circuits\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69763", "text": "{\n    \"patent_title\": \"Miniature Wireless Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless sensor system for remote monitoring of environmental conditions. The system incorporates a low-power microcontroller and a highly sensitive sensor for accurate data acquisition.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor system comprising...\",\n        \"A method for remote monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69763", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Jones\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-01-10\",\n    \"filing_date\": \"2017-01-10\",\n    \"issue_date\": \"2020-11-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"Novel battery technology offering increased energy density and improved cycle life. Utilizes a new electrolyte composition and electrode materials.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising...\",\n        \"An electrolyte composition...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69764", "text": "{\n    \"patent_title\": \"Electrode Material for High-Capacity Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel electrode material for lithium-ion batteries is disclosed, exhibiting enhanced capacity and cycle life. The material comprises a composite of silicon nanoparticles and a carbon matrix.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"title\": \"Silicon Nanowire Arrays for Lithium-Ion Batteries\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode material...\",\n        \"The electrode material according to claim 1, wherein the material is a composite...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69764", "text": "{\n    \"patent_title\": \"Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) for electric vehicles is described, providing improved safety and performance through advanced cell balancing and thermal management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Lithium-Ion Battery Cell Balancing Techniques\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Thermal Management System for Batteries\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for an electric vehicle...\",\n        \"The battery management system according to claim 1, comprising a cell balancing circuit...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69765", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Tesla, Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-06-10\",\n    \"issue_date\": \"2020-03-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel lithium-ion battery with an improved electrolyte composition resulting in enhanced thermal stability and cycle life. The battery architecture minimizes dendrite formation, increasing safety and performance.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69765", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2018-02-28\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2019-05-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system for lithium-ion batteries designed to optimize charging and discharging cycles and prevent overvoltage conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"inventor\": \"John Smith\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system...\",\n        \"A method for managing a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69766", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for remote monitoring applications. The sensor utilizes MEMS technology and low-power communication protocols to transmit data. This system can be used for biomedical monitoring, industrial process control, and environmental sensing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Wireless Sensor Network\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising...\",\n        \"A system for remote pressure monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69766", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An advanced battery management system for electric vehicles, optimizing charging and discharging cycles to extend battery life. This system incorporates machine learning algorithms for predictive maintenance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Battery Monitoring Device\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69767", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Intel Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2018-03-20\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized wireless pressure sensor system is disclosed, utilizing MEMS technology for high sensitivity. The sensor system is applicable in biomedical and industrial applications and features a novel energy harvesting circuit.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising...\",\n        \"A method for measuring pressure using...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69767", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Tesla\"\n        }\n    ],\n    \"patent_number\": \"US11112222B1\",\n    \"priority_date\": \"2018-05-10\",\n    \"filing_date\": \"2018-11-15\",\n    \"issue_date\": \"2020-01-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles is presented, optimizing charge and discharge cycles for extended battery life. It includes advanced thermal regulation and cell balancing algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10101010B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system configured to...\",\n        \"A method for controlling charge and discharge...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69768", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery Electrode Material and Method of Manufacture\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-07-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery electrode material comprising a composite of lithium metal oxide and carbon nanotubes is disclosed. This material exhibits improved cycling stability and rate capability compared to conventional lithium-ion battery electrodes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"1. A lithium-ion battery electrode comprising...\",\n        \"2. The electrode of claim 1, wherein...\",\n        \"3. A method of manufacturing the electrode of claim 1...\",\n        \"4. The method of claim 3, wherein...\",\n        \"5. A lithium-ion battery comprising the electrode of claim 1...\",\n        \"6. The lithium-ion battery of claim 5, wherein...\",\n        \"7. The lithium-ion battery of claim 5, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69768", "text": "{\n    \"patent_title\": \"Improved Lead-Acid Battery Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"Exide Technologies\"\n        }\n    ],\n    \"patent_number\": \"US8543210B1\",\n    \"priority_date\": \"2009-11-01\",\n    \"filing_date\": \"2010-05-10\",\n    \"issue_date\": \"2013-09-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved lead-acid battery design with enhanced electrolyte circulation is disclosed. The design aims to improve the battery's lifespan and performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"1. A lead-acid battery comprising...\",\n        \"2. The battery of claim 1, wherein...\",\n        \"3. A method of assembling the battery of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69769", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Sensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-05-15\",\n    \"filing_date\": \"2020-05-15\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized wireless sensor system for continuous glucose monitoring. The device utilizes a novel electrochemical sensor to provide real-time data to a mobile application, enabling improved diabetes management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A sensor for glucose detection.\",\n        \"A wireless communication module.\",\n        \"A system for continuous glucose monitoring.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69769", "text": "{\n    \"patent_title\": \"Surgical Instrument for Bone Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-01-10\",\n    \"issue_date\": \"2023-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical instrument designed for precise bone reconstruction during orthopedic procedures. Features enhanced ergonomics and a novel locking mechanism.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"similar device\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument with an ergonomic handle.\",\n        \"A locking mechanism for secure bone fixation.\",\n        \"A blade designed for precise bone cutting.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69770", "text": "{\n    \"patent_title\": \"Miniature Pressure Sensor with Integrated Signal Conditioning\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-14\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature pressure sensor is disclosed, integrating signal conditioning circuitry for enhanced accuracy and reliability. The sensor utilizes a MEMS-based diaphragm and provides a digital output signal. Applications include medical devices and industrial monitoring.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"High-Sensitivity Pressure Sensor\"\n        }\n    ],\n    \"claims\": [\n        \"A pressure sensor comprising a MEMS diaphragm...\",\n        \"The pressure sensor according to claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69770", "text": "{\n    \"patent_title\": \"Wireless Communication System for Remote Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Emily Chen\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2012-05-10\",\n    \"filing_date\": \"2012-05-09\",\n    \"issue_date\": \"2018-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless communication system for remote monitoring of environmental parameters is described. The system utilizes low-power radio communication and a distributed sensor network. Applications include smart homes and environmental monitoring.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Low-Power Wireless Communication Protocol\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication system comprising a plurality of sensor nodes...\",\n        \"The wireless communication system according to claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69771", "text": "{\n    \"patent_title\": \"System and Method for Image Recognition Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for image recognition using deep convolutional neural networks. The system is capable of identifying objects and features within images with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69771", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876544B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-02-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents an improved algorithm for data compression, achieving higher compression ratios and faster processing speeds.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765433B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising...\",\n        \"A system for data compression comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69772", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system is disclosed. The system comprises a pressure sensor, a wireless communication module, and a power management unit. This sensor is designed for biomedical applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in wireless communication\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for measuring pressure using the system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69772", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel battery technology with improved energy density and cycle life. The battery utilizes a new electrolyte formulation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related to energy storage\"\n        }\n    ],\n    \"claims\": [\n        \"A battery comprising...\",\n        \"A method for charging the battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69773", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Processing using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method and system for enhanced image processing using deep learning techniques. The system utilizes convolutional neural networks to improve image clarity and reduce noise.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image denoising\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing an image comprising...\",\n        \"A system for enhancing image quality...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69773", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"IBM Research\"\n        },\n        {\n            \"name\": \"Eve Wilson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-01\",\n    \"issue_date\": \"2023-06-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details an improved algorithm for data compression, focusing on reducing file sizes without significant loss of information.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"relevance\": \"Related work in lossless compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data comprising...\",\n        \"A system for efficient data storage...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69774", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Fraud Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Data Solutions Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2020-11-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for detecting fraudulent transactions using artificial intelligence techniques, specifically machine learning algorithms. The system analyzes transactional data to identify patterns indicative of fraud and provides real-time alerts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Data Mining for Anomaly Detection\"\n        }\n    ],\n    \"claims\": [\n        \"A system for detecting fraudulent transactions comprising...\",\n        \"A method for analyzing transactional data using machine learning...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69774", "text": "{\n    \"patent_title\": \"AI-Assisted Medical Image Analysis System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"HealthTech Corp.\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Medical Imaging Solutions\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2021-02-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for improving medical image analysis using artificial intelligence. The system assists radiologists in identifying anomalies and making more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10111213B2\",\n            \"title\": \"Automated Cancer Detection\"\n        },\n        {\n            \"patent_number\": \"US11223344B1\",\n            \"title\": \"Medical Imaging Processing Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A system for assisting medical image analysis comprising...\",\n        \"A method for identifying anomalies in medical images using AI...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69775", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-14\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system and method for enhanced image recognition using deep learning algorithms. The system processes images to identify objects and patterns with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for identifying objects in an image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69775", "text": "{\n    \"patent_title\": \"Advanced Facial Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"Microsoft Research\"\n        },\n        {\n            \"name\": \"Eve Davis\",\n            \"affiliation\": \"IBM\"\n        }\n    ],\n    \"patent_number\": \"US10293847B1\",\n    \"priority_date\": \"2012-05-20\",\n    \"filing_date\": \"2012-05-18\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a novel facial recognition system utilizing convolutional neural networks.  It improves accuracy and speed in identifying individuals from images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"relevance\": \"Relevant prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A facial recognition system...\",\n        \"A method for authenticating users based on facial features...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69776", "text": "{\n    \"patent_title\": \"Method and System for Personalized Learning Using Artificial Intelligence\",\n    \"inventors\": [\n        {\n            \"name\": \"James Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for personalized learning using artificial intelligence algorithms to adapt educational content to individual student needs. The system analyzes student performance and provides customized learning paths.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Adaptive Learning System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for personalized learning comprising...\",\n        \"A system for adapting educational content...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69776", "text": "{\n    \"patent_title\": \"Advanced Robotics Control System\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Emily Brown\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-08-22\",\n    \"filing_date\": \"2017-08-22\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a novel control system for robotic manipulators, enabling precise and efficient operation in complex environments. It focuses on improved kinematic algorithms and feedback mechanisms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Method and System for Personalized Learning\"\n        }\n    ],\n    \"claims\": [\n        \"A control system for a robotic manipulator...\",\n        \"A method for kinematic control of a robot...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69777", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-02-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications. The system includes a MEMS pressure sensor, a low-power transmitter, and a receiver for real-time data monitoring.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Wireless Sensor Network\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising a MEMS pressure sensor.\",\n        \"The system of claim 1, further comprising a low-power transmitter.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69777", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2012-03-10\",\n    \"filing_date\": \"2012-03-10\",\n    \"issue_date\": \"2018-09-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery with enhanced energy density and cycle life. The battery utilizes a new electrolyte composition and electrode materials.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Lithium Ion Battery with Improved Stability\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising a novel electrolyte composition.\",\n        \"The battery of claim 1, further comprising an improved electrode material.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69778", "text": "{\n    \"patent_title\": \"Method and System for Real-Time Image Enhancement Using Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for real-time image enhancement using convolutional neural networks. The system employs a novel architecture to efficiently process images and improve their visual quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Filtering Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image comprising...\",\n        \"A system for real-time image processing...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69778", "text": "{\n    \"patent_title\": \"Advanced Image Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Eve Evans\",\n            \"affiliation\": \"Caltech\"\n        },\n        {\n            \"name\": \"Frank Franklin\",\n            \"affiliation\": \"UCLA\"\n        },\n        {\n            \"name\": \"Grace Green\",\n            \"affiliation\": \"UC Berkeley\"\n        },\n        {\n            \"name\": \"Henry Hill\",\n            \"affiliation\": \"CMU\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel image compression algorithm based on wavelet transforms and entropy coding.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Method and System for Real-Time Image Enhancement\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image comprising...\",\n        \"A system for lossy image compression...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69779", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition Utilizing Feature Vector Clustering\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for enhanced image recognition by clustering feature vectors extracted from images. The system utilizes a novel clustering algorithm to improve the accuracy and efficiency of image recognition tasks. Applications include autonomous vehicles and medical diagnostics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69779", "text": "{\n    \"patent_title\": \"Image Recognition System Based on Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2012-05-20\",\n    \"filing_date\": \"2012-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an image recognition system based on deep neural networks. The system utilizes convolutional neural networks to achieve high accuracy in image classification and object detection. Applications include facial recognition and image search.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition using a neural network comprising...\",\n        \"A deep learning architecture for image recognition...\",\n        \"A system for image classification utilizing a neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69780", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-05-20\",\n    \"issue_date\": \"2012-11-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to improved lithium-ion battery technology with enhanced energy density and lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"similar\"\n        },\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"prior art\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US11234567B2\",\n            \"relevance\": \"similar\"\n        }\n    ],\n    \"claims\": [\n        \"A battery comprising...\",\n        \"A method for manufacturing a battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69780", "text": "{\n    \"patent_title\": \"Novel Chemical Compound\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2011-06-22\",\n    \"filing_date\": \"2011-08-10\",\n    \"issue_date\": \"2013-04-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new chemical compound with unique properties.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US78901234B2\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US89012345B1\",\n            \"relevance\": \"similar\"\n        },\n        {\n            \"patent_number\": \"US90123456B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A chemical compound having the formula...\",\n        \"A method for synthesizing the compound...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69781", "text": "{\n    \"patent_title\": \"Deep Learning Accelerator with On-Chip Memory\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning accelerator architecture with on-chip memory is disclosed. The architecture utilizes a systolic array to efficiently implement matrix multiplications crucial for neural network computations.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A deep learning accelerator comprising a systolic array.\",\n        \"A memory system integrated on the same chip as the systolic array.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69781", "text": "{\n    \"patent_title\": \"Improved Image Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11345678B2\",\n    \"priority_date\": \"2019-01-10\",\n    \"filing_date\": \"2019-01-10\",\n    \"issue_date\": \"2020-07-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved image compression algorithm based on wavelet transforms is described. The algorithm achieves higher compression ratios with minimal loss of image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"An image compression method utilizing wavelet transforms.\",\n        \"A system for compressing and decompressing images.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69782", "text": "{\n    \"patent_title\": \"System and method for machine learning-based fraud detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for detecting fraudulent transactions using machine learning algorithms. The system analyzes transaction data to identify patterns indicative of fraud and provide alerts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Fraud detection system\"\n        }\n    ],\n    \"claims\": [\n        \"A system for detecting fraudulent transactions comprising...\",\n        \"A method for analyzing transaction data using a machine learning model...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69782", "text": "{\n    \"patent_title\": \"Improved Internal Combustion Engine Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Ford Motor Company\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"General Motors\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2017-03-10\",\n    \"filing_date\": \"2017-03-10\",\n    \"issue_date\": \"2018-09-04\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved design for internal combustion engines, enhancing fuel efficiency and reducing emissions through optimized combustion chamber geometry and valve timing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Internal Combustion Engine with Variable Valve Timing\"\n        }\n    ],\n    \"claims\": [\n        \"An internal combustion engine comprising...\",\n        \"A combustion chamber with a specific geometrical configuration...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69783", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-02-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for image recognition utilizing artificial intelligence algorithms, specifically convolutional neural networks. The system is capable of identifying objects with high accuracy and speed.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for processing image data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69783", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Local Bike Shop\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2017-03-10\",\n    \"filing_date\": \"2017-03-10\",\n    \"issue_date\": \"2018-09-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new braking system for bicycles that offers improved stopping power and modulation. It features a novel caliper design and pad material.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle braking system comprising...\",\n        \"A caliper designed for improved braking...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69784", "text": "{\n    \"patent_title\": \"Advanced Lithium-Ion Battery with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2018-02-20\",\n    \"issue_date\": \"2020-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved lithium-ion battery with enhanced thermal stability and cycle life. The battery utilizes a novel electrolyte composition and a modified electrode structure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related art in lithium-ion battery technology\"\n        }\n    ],\n    \"claims\": [\n        \"1. A lithium-ion battery comprising...\",\n        \"2. The lithium-ion battery of claim 1, wherein...\",\n        \"3. The lithium-ion battery of claim 1, further comprising...\",\n        \"4. An electrolyte composition for use in a lithium-ion battery...\",\n        \"5. A method of manufacturing a lithium-ion battery...\",\n        \"6. The method of claim 5, wherein...\",\n        \"7. The method of claim 5, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69784", "text": "{\n    \"patent_title\": \"Improved Solar Cell Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-03-10\",\n    \"filing_date\": \"2019-04-15\",\n    \"issue_date\": \"2021-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel design for a solar cell with increased efficiency and reduced manufacturing costs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art in solar cell technology\"\n        }\n    ],\n    \"claims\": [\n        \"1. A solar cell comprising...\",\n        \"2. The solar cell of claim 1, wherein...\",\n        \"3. A method for manufacturing a solar cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69785", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition Using Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing image recognition accuracy utilizing convolutional neural networks. The system preprocesses images to improve feature extraction and employs a novel training algorithm to optimize network performance. Applications include object detection, facial recognition, and medical image analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Classification System\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for enhancing image recognition accuracy...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69785", "text": "{\n    \"patent_title\": \"Improved Facial Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Robert Williams\",\n            \"affiliation\": \"IBM Research\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-10\",\n    \"filing_date\": \"2017-03-10\",\n    \"issue_date\": \"2020-04-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved facial recognition system utilizing deep learning techniques. The system achieves higher accuracy and speed compared to existing systems, with applications in security, surveillance, and access control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Facial Recognition Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A facial recognition system comprising...\",\n        \"A method for identifying faces in images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69786", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-06-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method and system for enhancing image processing capabilities, particularly in low-light conditions. It utilizes a unique algorithm to reduce noise and improve clarity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"type\": \"Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image processing...\",\n        \"A system for implementing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69786", "text": "{\n    \"patent_title\": \"Apparatus for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876544B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2018-07-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved apparatus for data compression and decompression. It offers a higher compression ratio with minimal data loss.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765433B1\",\n            \"type\": \"Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"An apparatus for data compression...\",\n        \"A method for decompressing the data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69787", "text": "{\n    \"patent_title\": \"Method and system for automated machine learning model selection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method and system for automatically selecting the best machine learning model for a given dataset. The system utilizes artificial intelligence techniques to evaluate various models and identify the optimal configuration. This significantly reduces the time and effort required for machine learning model development.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"System for automated data preprocessing\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for automated machine learning model selection, comprising...\",\n        \"2. The method of claim 1, wherein the selection is based on...\",\n        \"3. A system for automated machine learning model selection, comprising...\",\n        \"4. The system of claim 3, wherein the system includes...\",\n        \"5. The system of claim 3, further comprising...\",\n        \"6. The method of claim 1, wherein the dataset is preprocessed...\",\n        \"7. The system of claim 3, wherein the selection process is optimized...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69787", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-12-01\",\n    \"filing_date\": \"2009-12-01\",\n    \"issue_date\": \"2013-05-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved braking system for bicycles, utilizing a novel cable tensioning mechanism. This results in more responsive and reliable braking performance, enhancing safety for cyclists.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Bicycle handlebar design\"\n        }\n    ],\n    \"claims\": [\n        \"1. A bicycle braking system comprising...\",\n        \"2. The braking system of claim 1, wherein the cable tension...\",\n        \"3. A bicycle comprising the braking system of claim 1...\",\n        \"4. The bicycle of claim 3, wherein the bicycle is a mountain bike...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69788", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for image recognition using artificial intelligence techniques, specifically convolutional neural networks. The system improves accuracy and efficiency in identifying objects within images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training an artificial intelligence model...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69788", "text": "{\n    \"patent_title\": \"Enhanced Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Data Solutions Ltd.\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Global Tech Corp.\"\n        },\n        {\n            \"name\": \"Eve Green\",\n            \"affiliation\": \"Independent Consultant\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-02-01\",\n    \"filing_date\": \"2021-04-15\",\n    \"issue_date\": \"2023-05-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved data compression algorithm that significantly reduces file sizes without sacrificing data integrity. It is applicable to various data types.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data comprising...\",\n        \"A system for decompressing data using...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69789", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for remote monitoring applications. The sensor utilizes a MEMS pressure transducer and a low-power communication protocol. The system offers high sensitivity and accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A MEMS pressure transducer configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69789", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles, optimizing charge and discharge cycles to extend battery life and improve efficiency. Includes thermal regulation and fault detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A thermal regulation module configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69790", "text": "{\n    \"patent_title\": \"High-Performance Lithium-Ion Battery with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel lithium-ion battery design featuring a modified electrolyte composition and electrode materials, resulting in enhanced stability, higher energy density, and improved cycle life. The battery is particularly suitable for electric vehicle applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in electrolyte composition\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69790", "text": "{\n    \"patent_title\": \"Improved Lead-Acid Battery for Automotive Use\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Exide Technologies\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Johnson Controls\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved lead-acid battery with enhanced charge acceptance and reduced self-discharge. The battery utilizes a novel grid alloy and separator material for increased performance and longevity in automotive applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Comparison to lithium-ion technologies\"\n        }\n    ],\n    \"claims\": [\n        \"A lead-acid battery comprising...\",\n        \"A grid alloy for a lead-acid battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69791", "text": "{\n    \"patent_title\": \"Method and Apparatus for Enhanced Data Transmission in Wireless Communication Systems\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9786423B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and apparatus for enhancing data transmission in wireless communication systems by utilizing adaptive modulation and coding schemes based on channel quality feedback. The invention improves data throughput and reliability in challenging wireless environments.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8569872B1\",\n            \"relevance\": \"Prior art related to channel estimation.\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for transmitting data in a wireless communication system, comprising: receiving channel quality information...\",\n        \"2. The method of claim 1, wherein the adaptive modulation scheme is...\",\n        \"3. An apparatus for transmitting data...\",\n        \"4. The apparatus of claim 3, further comprising...\",\n        \"5. A wireless communication system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69791", "text": "{\n    \"patent_title\": \"A Novel Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-14\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) for electric vehicles, designed to improve battery life and safety through advanced charging and discharging algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Prior art in battery cell balancing.\"\n        }\n    ],\n    \"claims\": [\n        \"1. A battery management system for an electric vehicle...\",\n        \"2. The system of claim 1, wherein the charging algorithm is...\",\n        \"3. A method for managing a battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69792", "text": "{\n    \"patent_title\": \"System and Method for Image Recognition Using Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition using deep neural networks are disclosed. The system comprises a convolutional neural network for feature extraction, a recurrent neural network for sequence modeling, and a classifier for image identification. The method involves training the network on a large dataset of labeled images and using the trained network to recognize new images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Classification Using Support Vector Machines\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for image recognition comprising...\",\n        \"2. The system of claim 1, wherein the neural network is a convolutional neural network.\",\n        \"3. The system of claim 2, further comprising...\",\n        \"4. A method for image recognition comprising...\",\n        \"5. The method of claim 4, wherein the neural network is trained...\",\n        \"6. The method of claim 5, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69792", "text": "{\n    \"patent_title\": \"Method for Efficient Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-04-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for data compression is presented, utilizing a combination of Huffman coding and Lempel-Ziv algorithms. This method achieves high compression ratios while maintaining fast decompression speeds.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Data Compression Using Dictionary Encoding\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for data compression comprising...\",\n        \"2. The method of claim 1, wherein the Huffman coding is adaptive.\",\n        \"3. The method of claim 2, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69793", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for real-time monitoring of physiological parameters. The system utilizes a novel MEMS pressure sensor and a low-power wireless communication protocol.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Wireless Monitoring System\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for monitoring pressure using a wireless sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69793", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876544B2\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery with improved energy density and cycle life.  The battery utilizes a new electrolyte formulation and electrode materials.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Lithium-Ion Battery Improvements\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"A method for improving battery performance...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69794", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-08-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery management system that improves efficiency and lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"high\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"medium\"\n        },\n        {\n            \"patent_number\": \"US11223344B1\",\n            \"relevance\": \"low\"\n        },\n        {\n            \"patent_number\": \"US12112233B2\",\n            \"relevance\": \"medium\"\n        },\n        {\n            \"patent_number\": \"US13131313B1\",\n            \"relevance\": \"high\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"The system of claim 1, further comprising...\"\n    ]\n}"}
