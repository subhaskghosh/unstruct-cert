{"_id": "Academic--patents--p--66748", "text": "{\n    \"patent_title\": \"System and method for improved machine learning model training\",\n    \"inventors\": [\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Sergey Levine\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-01-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for improving the training efficiency of machine learning models, particularly deep neural networks, using a novel optimization algorithm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Neural network training using stochastic gradient descent\"\n        }\n    ],\n    \"claims\": [\n        \"A system for training a machine learning model comprising...\",\n        \"A method for optimizing the training process...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66748", "text": "{\n    \"patent_title\": \"Advanced Control System for Robotics\",\n    \"inventors\": [\n        {\n            \"name\": \"Rodney Brooks\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Helen Greiner\",\n            \"affiliation\": \"iRobot Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-06-01\",\n    \"filing_date\": \"2019-12-05\",\n    \"issue_date\": \"2021-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details an advanced control system for robotic manipulators, allowing for precise and coordinated movements. It utilizes feedback loops and adaptive algorithms to improve performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Robotic arm with force feedback\"\n        }\n    ],\n    \"claims\": [\n        \"A control system for a robotic manipulator comprising...\",\n        \"A method for controlling the movement of a robotic arm...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66749", "text": "{\n    \"patent_title\": \"Neural Network Based Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel neural network architecture for improved image recognition accuracy. The system utilizes convolutional neural networks and a unique training algorithm to achieve state-of-the-art results in object detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising a convolutional neural network...\",\n        \"A method for training a neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66749", "text": "{\n    \"patent_title\": \"Improved Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-01\",\n    \"filing_date\": \"2021-01-10\",\n    \"issue_date\": \"2023-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel data compression algorithm that significantly reduces file size without compromising data integrity. The algorithm utilizes a combination of Huffman coding and run-length encoding.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10111213B1\",\n            \"relevance\": \"Existing data compression techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data comprising the steps of...\",\n        \"A system for decompressing data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66750", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Segmentation\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2019-03-10\",\n    \"issue_date\": \"2021-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for segmenting images using deep learning techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image segmentation comprising...\",\n        \"A system for image segmentation...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66750", "text": "{\n    \"patent_title\": \"Digital Image Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2018-08-01\",\n    \"issue_date\": \"2022-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An efficient method for compressing digital images using wavelet transforms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for digital image compression comprising...\",\n        \"A system for digital image compression...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66751", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-14\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhanced image recognition using deep learning techniques. The system comprises a convolutional neural network trained on a large dataset of labeled images. The system can identify objects, scenes, and activities in images with high accuracy. This invention utilizes a novel loss function to improve recognition accuracy and is applicable to a wide variety of applications including autonomous vehicles and medical image analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Method for Image Feature Extraction\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising a convolutional neural network.\",\n        \"A method for identifying objects in an image.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66751", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2010-12-01\",\n    \"filing_date\": \"2010-12-01\",\n    \"issue_date\": \"2018-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved algorithm for lossless data compression. The algorithm utilizes a combination of Huffman coding and Lempel-Ziv techniques to achieve high compression ratios. The algorithm is particularly well-suited for compressing text and image data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"title\": \"Data Compression Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data using Huffman coding.\",\n        \"A system for lossless data compression.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66752", "text": "{\n    \"patent_title\": \"System and Method for Deep Learning-Based Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition utilizing deep convolutional neural networks. The system includes a training phase and an inference phase, enabling accurate identification of objects within images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760727B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising a deep convolutional neural network...\",\n        \"A method for training a deep convolutional neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66752", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-14\",\n    \"issue_date\": \"2019-02-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved data compression algorithm that utilizes a novel entropy encoding technique, resulting in higher compression ratios and faster processing speeds.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A data compression method comprising an entropy encoding step...\",\n        \"A system for data compression utilizing the aforementioned method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66753", "text": "{\n    \"patent_title\": \"Miniature Implantable Cardiac Monitor\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"CardioTech Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University Hospital\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-06-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature implantable cardiac monitor for long-term heart rhythm monitoring. The device is designed for minimal invasiveness and extended battery life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in implantable devices\"\n        }\n    ],\n    \"claims\": [\n        \"A miniature implantable cardiac monitor comprising...\",\n        \"A method for monitoring heart rhythm using said monitor...\",\n        \"The monitor having a battery life of at least 5 years...\",\n        \"The monitor being less than 10 cubic centimeters in volume...\",\n        \"The monitor transmitting data wirelessly...\",\n        \"The monitor being capable of detecting atrial fibrillation...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66753", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Cycle Dynamics Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved bicycle brake system utilizing a novel hydraulic mechanism for enhanced stopping power and control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art in bicycle braking\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle brake system comprising...\",\n        \"A hydraulic mechanism for applying braking force...\",\n        \"A lever for activating the braking system...\",\n        \"The braking system providing increased stopping power...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66754", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery with Enhanced Thermal Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved lithium-ion battery with enhanced thermal stability and cycle life. The battery incorporates a novel electrolyte additive that mitigates dendrite formation and improves safety. The invention is applicable to electric vehicles and portable electronic devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Lithium-Ion Battery Electrolyte Composition\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte additive for a lithium-ion battery...\",\n        \"A method for manufacturing a lithium-ion battery...\",\n        \"The battery of claim 1, wherein the electrolyte additive...\",\n        \"The method of claim 3, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66754", "text": "{\n    \"patent_title\": \"Novel Solar Cell Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Caltech\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-08-01\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2021-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel design for a high-efficiency solar cell utilizing perovskite materials. The design optimizes light absorption and charge carrier transport.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Perovskite Solar Cell with Improved Stability\"\n        }\n    ],\n    \"claims\": [\n        \"A solar cell comprising...\",\n        \"A perovskite material for use in a solar cell...\",\n        \"A method for fabricating a solar cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66755", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2018-12-04\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel system and method for enhancing image recognition accuracy using deep learning techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition...\",\n        \"A system comprising a processor...\"\n    ]\n}"}
