{"_id": "Academic--patents--p--66364", "text": "{\n    \"patent_title\": \"System and Method for Predictive Maintenance Using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for predicting equipment failure using machine learning algorithms. The system analyzes sensor data to identify patterns indicative of impending failure, allowing for proactive maintenance and reduced downtime.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predictive maintenance comprising...\",\n        \"A method for analyzing sensor data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66364", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-07-20\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2020-12-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel battery management system designed to improve energy efficiency and extend battery lifespan. It features advanced charging algorithms and thermal regulation techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for regulating battery temperature...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66365", "text": "{\n    \"patent_title\": \"Miniature Implantable Medical Device for Targeted Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2021-11-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable medical device for targeted drug delivery to specific tissues within the body. The device incorporates microfluidic channels and biocompatible materials for controlled release of therapeutic agents.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Drug Delivery System\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Implantable Microdevice\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Controlled Release Formulation\"\n        },\n        {\n            \"patent_number\": \"US11000001B2\",\n            \"title\": \"Biocompatible Polymers\"\n        },\n        {\n            \"patent_number\": \"US10500500B2\",\n            \"title\": \"Microfluidic Device Fabrication\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable medical device...\",\n        \"The device comprising microfluidic channels...\",\n        \"A method for targeted drug delivery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66365", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Independent Inventor\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2020-03-10\",\n    \"filing_date\": \"2020-04-15\",\n    \"issue_date\": \"2021-12-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved braking system for bicycles utilizing a novel caliper design for increased stopping power and modulation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Bicycle Brake Caliper\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Hydraulic Brake System\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle braking system comprising...\",\n        \"A caliper with improved leverage...\",\n        \"A method for braking a bicycle...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66366", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Processing Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method and system for enhancing image processing capabilities using deep learning algorithms. The system improves image resolution, reduces noise, and provides real-time processing for various applications including medical imaging and autonomous vehicles. The process involves a convolutional neural network architecture optimized for efficient feature extraction and image reconstruction.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Enhancement Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising...\",\n        \"A system for real-time image processing comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66366", "text": "{\n    \"patent_title\": \"Improved Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-05\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel data compression algorithm that significantly reduces file sizes without compromising data integrity. The algorithm utilizes a combination of Huffman coding and Lempel-Ziv variations to achieve high compression ratios. It is suitable for various applications including data storage and network transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\",\n            \"title\": \"Data Compression Methods\"\n        }\n    ],\n    \"claims\": [\n        \"A data compression method comprising...\",\n        \"A system for data storage utilizing the compression method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66367", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2022-08-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing image recognition accuracy using a novel deep learning architecture. The system comprises a convolutional neural network with optimized layers for feature extraction and classification.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Processing Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for enhancing image recognition accuracy...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66367", "text": "{\n    \"patent_title\": \"Improved Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"California Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-20\",\n    \"filing_date\": \"2020-03-01\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles, designed to enhance battery life and performance. The system includes advanced algorithms for monitoring and controlling battery charging and discharging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Battery Charging Systems\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for electric vehicles comprising...\",\n        \"A method for optimizing battery performance...\"\n    ]\n}"}
