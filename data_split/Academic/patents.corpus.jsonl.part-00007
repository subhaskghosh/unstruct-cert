{"_id": "Academic--patents--p--66681", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-11-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the resolution of images using deep learning techniques. The system employs a generative adversarial network (GAN) to generate high-resolution images from low-resolution inputs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Super-Resolution Using Convolutional Neural Networks\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for enhancing the resolution of an image, comprising:\",\n        \"2. The method of claim 1, wherein the deep learning model is a generative adversarial network (GAN).\",\n        \"3. The method of claim 2, wherein the GAN comprises a generator and a discriminator.\",\n        \"4. A system for enhancing the resolution of an image, comprising:\",\n        \"5. The system of claim 4, wherein the processor is configured to execute a deep learning model.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66681", "text": "{\n    \"patent_title\": \"Digital Image Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-08-01\",\n    \"filing_date\": \"2019-12-10\",\n    \"issue_date\": \"2021-03-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel digital image compression technique based on wavelet transforms and entropy encoding.\",\n    \"citations\": [],\n    \"claims\": [\n        \"1. A method for compressing a digital image comprising:\",\n        \"2. The method of claim 1, wherein the wavelet transform is a Daubechies wavelet.\",\n        \"3. A system for compressing a digital image comprising:\"\n    ]\n}"}
{"_id": "Academic--patents--p--66682", "text": "{\n    \"patent_title\": \"Method for Enhanced Image Recognition using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Li Wei\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Anna Schmidt\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2021-11-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for improving the accuracy of image recognition systems using a deep learning approach. The method incorporates a new activation function and a modified training algorithm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition...\",\n        \"A system comprising...\"\n    ]\n}"}
