{"_id": "Academic--patents--p--66738", "text": "{\n    \"patent_title\": \"Medical Imaging System with Enhanced Contrast Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a medical imaging system that utilizes novel techniques for contrast enhancement in X-ray and CT scans, resulting in improved image clarity and diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A medical imaging system comprising a contrast agent delivery mechanism.\",\n        \"A method for enhancing contrast in medical images using pulsed radiation.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66738", "text": "{\n    \"patent_title\": \"Improved Surgical Tool for Minimally Invasive Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2014-11-01\",\n    \"filing_date\": \"2014-11-01\",\n    \"issue_date\": \"2018-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel surgical tool designed for precise and minimally invasive procedures. The tool incorporates advanced robotics and ergonomic design features for improved surgeon control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"relevance\": \"Related Art\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical tool comprising a robotic arm.\",\n        \"A method for performing minimally invasive surgery.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66739", "text": "{\n    \"patent_title\": \"Method and System for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-11-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method and system for image recognition using artificial intelligence techniques. The system utilizes a deep convolutional neural network to achieve high accuracy in identifying objects within images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66739", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-08-01\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2021-11-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an improved braking system for bicycles, offering enhanced stopping power and reliability. The system includes a novel caliper design and improved brake pad material.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle braking system comprising...\",\n        \"A caliper design for a bicycle braking system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66740", "text": "{\n    \"patent_title\": \"System and Method for Personalized Machine Learning Model Selection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-12-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for automatically selecting the optimal machine learning model for a given task and dataset. The system utilizes a meta-learning approach to identify promising models based on historical performance data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for selecting a machine learning model...\",\n        \"2. A method comprising: receiving a dataset...\",\n        \"3. The system of claim 1, further comprising...\",\n        \"4. The method of claim 2, wherein the model is...\",\n        \"5. A non-transitory computer-readable medium...\",\n        \"6. The system of claim 1, wherein the meta-learning...\",\n        \"7. The method of claim 2, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66740", "text": "{\n    \"patent_title\": \"Improved Battery Charging Circuit\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Electronics Corp\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-08-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery charging circuit with enhanced efficiency and safety features. The circuit utilizes a unique control algorithm to optimize charging performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"1. A battery charging circuit comprising...\",\n        \"2. The circuit of claim 1, wherein the control algorithm...\",\n        \"3. A method for charging a battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66741", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2018-03-01\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel image recognition system utilizing deep neural networks for improved accuracy and efficiency. The system is applicable to various fields including autonomous vehicles and medical image analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Convolutional Neural Network Architecture\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising a deep neural network.\",\n        \"A method for training a deep neural network for image classification.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66741", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11111111B2\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2018-02-15\",\n    \"issue_date\": \"2020-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a new data compression algorithm that significantly reduces file size while maintaining data integrity. It employs a combination of Huffman coding and Lempel-Ziv techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8888888B1\",\n            \"title\": \"Adaptive Huffman Coding Scheme\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data using Huffman coding and Lempel-Ziv techniques.\",\n        \"A system for decompressing data compressed according to the invention.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66742", "text": "{\n    \"patent_title\": \"AI-Powered Predictive Maintenance System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for predicting equipment failures using artificial intelligence and machine learning algorithms. The system analyzes sensor data to identify patterns indicative of potential failures, enabling proactive maintenance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in predictive maintenance\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for predicting equipment failures comprising...\",\n        \"2. The system of claim 1, wherein the artificial intelligence algorithm is a neural network.\",\n        \"3. A method for predicting equipment failures...\",\n        \"4. The method of claim 3, further comprising...\",\n        \"5. The system of claim 1, further comprising a user interface...\",\n        \"6. The system of claim 5, wherein the user interface displays...\",\n        \"7. The method of claim 3, wherein the sensor data is collected...\"\n    ]\n}"}
