{"_id": "Academic--patents--p--66808", "text": "{\n    \"patent_title\": \"System and method for personalized content delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-05-15\",\n    \"filing_date\": \"2010-03-22\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for delivering personalized content to a user based on their preferences and behavior.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Similar content delivery techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for delivering content comprising...\",\n        \"A system for personalized content delivery...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The method of claim 1, wherein...\",\n        \"The system of claim 2, further comprising...\",\n        \"A way to measure engagement...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66808", "text": "{\n    \"patent_title\": \"Improved battery charging circuit\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Electrical Solutions Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2011-11-01\",\n    \"filing_date\": \"2012-05-10\",\n    \"issue_date\": \"2018-09-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved charging circuit for lithium-ion batteries, enhancing charging speed and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"relevance\": \"Prior art charging circuit designs\"\n        }\n    ],\n    \"claims\": [\n        \"A charging circuit comprising...\",\n        \"The charging circuit of claim 1, wherein...\",\n        \"A method for charging a battery...\",\n        \"The method of claim 3, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66809", "text": "{\n    \"patent_title\": \"Microfluidic Device with Integrated Sensor for Biomarker Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-15\",\n    \"issue_date\": \"2019-06-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device comprising an integrated sensor for detecting biomarkers in biological samples. The sensor utilizes electrochemical impedance spectroscopy for high-sensitivity detection. This invention enables rapid and accurate point-of-care diagnostics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A sensor for detecting biomarkers...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66809", "text": "{\n    \"patent_title\": \"Method for Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-12-20\",\n    \"filing_date\": \"2009-12-20\",\n    \"issue_date\": \"2018-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for enhancing wireless communication reliability through adaptive modulation and coding schemes. This invention aims to improve data transmission rates in challenging environments.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for wireless communication...\",\n        \"An adaptive modulation scheme...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66810", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Cell Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved lithium-ion battery cell design featuring enhanced energy density and cycle life. The design incorporates a novel electrolyte composition and electrode architecture optimized for high-power applications. This battery is useful for portable electronic devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery cell comprising...\",\n        \"An electrolyte composition for a lithium-ion battery cell...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66810", "text": "{\n    \"patent_title\": \"Electric Vehicle Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Tesla\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2020-07-01\",\n    \"filing_date\": \"2020-07-01\",\n    \"issue_date\": \"2022-09-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system for electric vehicles, designed to optimize battery performance and extend range. The system includes advanced thermal management and cell balancing algorithms to ensure safe and efficient operation of the battery pack in an electric vehicle.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for an electric vehicle comprising...\",\n        \"A method for controlling the charging and discharging of a battery in an electric vehicle...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66811", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition using Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-12-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing image recognition accuracy using deep neural networks, particularly convolutional neural networks, is disclosed.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for enhancing image recognition...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66811", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Tesla, Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-08-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery technology for electric vehicles offering increased energy density and faster charging times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising...\",\n        \"An electric vehicle utilizing said battery cell...\",\n        \"A method for charging said battery cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66812", "text": "{\n    \"patent_title\": \"Implantable Cardiac Monitor with Remote Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Medtronic Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-07-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac monitor with the capability to remotely transmit data to a central monitoring station for real-time analysis and alerts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for remotely monitoring cardiac activity.\",\n        \"An implantable device for detecting arrhythmias.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66812", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Independent Inventor\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-12-20\",\n    \"filing_date\": \"2009-12-20\",\n    \"issue_date\": \"2018-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A braking system for bicycles utilizing a novel caliper design and lever mechanism.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle braking system with improved stopping power.\",\n        \"A caliper designed for enhanced heat dissipation.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66813", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-05-15\",\n    \"filing_date\": \"2010-03-22\",\n    \"issue_date\": \"2019-07-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to improved electrode materials for lithium-ion batteries, enhancing energy density and cycle life. The materials comprise a novel composite structure with enhanced ionic conductivity and reduced impedance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art in lithium-ion battery technology\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrode material characterized by...\",\n        \"A method for manufacturing...\",\n        \"The battery of claim 1, wherein...\",\n        \"The electrode material of claim 2, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66813", "text": "{\n    \"patent_title\": \"Novel Solar Cell Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Chloe Davis\",\n            \"affiliation\": \"California Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2011-11-01\",\n    \"filing_date\": \"2012-05-08\",\n    \"issue_date\": \"2020-01-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a new solar cell design utilizing perovskite materials for increased efficiency in converting sunlight into electricity. The design incorporates a novel light-trapping structure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"relevance\": \"Related work on perovskite solar cells\"\n        }\n    ],\n    \"claims\": [\n        \"A solar cell comprising...\",\n        \"A perovskite layer...\",\n        \"A light-trapping structure...\",\n        \"The solar cell of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66814", "text": "{\n    \"patent_title\": \"Method and System for Optimized Data Stream Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"UC Berkeley\"\n        },\n        {\n            \"name\": \"Diana Miller\",\n            \"affiliation\": \"Google\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-04-20\",\n    \"issue_date\": \"2012-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for optimizing data stream processing by utilizing parallel processing and adaptive algorithms.  The system reduces latency and improves throughput for real-time data analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing data streams comprising...\",\n        \"A system for optimizing data processing comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66814", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Eve Davis\",\n            \"affiliation\": \"Independent Inventor\"\n        },\n        {\n            \"name\": \"Frank Wilson\",\n            \"affiliation\": \"Cycling Dynamics Inc.\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2011-01-25\",\n    \"filing_date\": \"2011-02-10\",\n    \"issue_date\": \"2013-03-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved braking system for bicycles utilizing a novel caliper design and friction material to enhance stopping power and control.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A bicycle braking system comprising...\",\n        \"A caliper assembly for a bicycle...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66815", "text": "{\n    \"patent_title\": \"Novel Composite Material with Enhanced Strength\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT Materials Science Department\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-15\",\n    \"issue_date\": \"2013-09-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel composite material is disclosed, exhibiting significantly enhanced tensile strength and durability compared to existing materials. The material comprises a polymer matrix reinforced with carbon nanotubes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A composite material comprising...\",\n        \"The composite material of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66815", "text": "{\n    \"patent_title\": \"Improved Battery Electrode\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2009-12-10\",\n    \"filing_date\": \"2009-12-10\",\n    \"issue_date\": \"2012-05-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved electrode material for lithium-ion batteries is described, offering enhanced energy density and cycle life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"An electrode material comprising...\",\n        \"The electrode material of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66816", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2008-12-15\",\n    \"filing_date\": \"2009-06-01\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor is disclosed, comprising a microfabricated sensor, a wireless communication module, and a power management system. The sensor provides continuous glucose monitoring and transmits data wirelessly to an external receiver.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Glucose Monitoring System\"\n        },\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"title\": \"Wireless Communication Device\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Microfabricated Sensor\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Power Management Circuit\"\n        },\n        {\n            \"patent_number\": \"US11123456B2\",\n            \"title\": \"Biocompatible Materials\"\n        }\n    ],\n    \"claims\": [\n        \"A glucose sensor comprising...\",\n        \"A wireless communication module...\",\n        \"A method for monitoring glucose levels...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66816", "text": "{\n    \"patent_title\": \"Portable Blood Pressure Monitor\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US1234567B2\",\n    \"priority_date\": \"2011-03-10\",\n    \"filing_date\": \"2011-09-01\",\n    \"issue_date\": \"2018-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A portable blood pressure monitor with a digital display and memory function is disclosed. The device is designed for home use and provides accurate blood pressure readings.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Blood Pressure Measurement Device\"\n        },\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"title\": \"Digital Display Technology\"\n        }\n    ],\n    \"claims\": [\n        \"A blood pressure monitor comprising...\",\n        \"A digital display for showing readings...\",\n        \"A method for measuring blood pressure...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66817", "text": "{\n    \"patent_title\": \"Miniature Implantable Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature implantable pressure sensor system for continuous monitoring of physiological pressure within the body. The system comprises a pressure sensor, a signal conditioning circuit, and a wireless communication module.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Implantable Biosensor\"\n        }\n    ],\n    \"claims\": [\n        \"A pressure sensor system comprising...\",\n        \"A method for monitoring pressure...\",\n        \"A wireless communication module for transmitting data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66817", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Independent Inventor\"\n        }\n    ],\n    \"patent_number\": \"US10293847B1\",\n    \"priority_date\": \"2017-07-20\",\n    \"filing_date\": \"2017-07-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A bicycle brake system with improved modulation and stopping power. The system utilizes a novel hydraulic actuator design.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A bicycle brake system comprising...\",\n        \"A hydraulic actuator for applying braking force...\",\n        \"A lever mechanism for controlling the actuator...\"\n    ]\n}"}
