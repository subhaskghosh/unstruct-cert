{"_id": "Academic--patents--p--69084", "text": "{\n    \"patent_title\": \"Method and System for Training Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Ilya Sutskever\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-05-15\",\n    \"filing_date\": \"2011-02-28\",\n    \"issue_date\": \"2019-07-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for training deep neural networks is disclosed. The method includes iteratively adjusting weights of the network based on a gradient descent algorithm, optimizing performance and reducing computational costs. The system includes hardware and software components for efficient neural network training.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7653152B2\",\n            \"title\": \"Deep Belief Networks\"\n        }\n    ],\n    \"claims\": [\n        \"A method for training a deep neural network...\",\n        \"A system comprising a processor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69084", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Elon Musk\",\n            \"affiliation\": \"Tesla\"\n        },\n        {\n            \"name\": \"J.B. Straubel\",\n            \"affiliation\": \"Tesla\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2010-11-01\",\n    \"filing_date\": \"2012-05-10\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles is disclosed. The system optimizes charging and discharging cycles to maximize battery life and performance. It includes advanced temperature control and fault detection mechanisms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"title\": \"Lithium-Ion Battery Pack\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system...\",\n        \"A method for controlling battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69085", "text": "{\n    \"patent_title\": \"Deep Learning Based Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel image recognition system utilizing deep learning techniques for improved accuracy and efficiency in identifying objects within images. The system employs convolutional neural networks and a unique training methodology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Prior Art Image Recognition\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for image recognition comprising...\",\n        \"2. The method of claim 1, wherein...\",\n        \"3. A system for implementing the method of claim 1...\",\n        \"4. The system of claim 3, further comprising...\",\n        \"5. A computer-readable medium storing...\",\n        \"6. The computer-readable medium of claim 5, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69085", "text": "{\n    \"patent_title\": \"Enhanced Object Detection Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2021-04-01\",\n    \"filing_date\": \"2021-06-10\",\n    \"issue_date\": \"2022-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved algorithm for object detection in real-time video streams. The algorithm utilizes a combination of feature extraction and machine learning techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Real-time Object Detection\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for object detection comprising...\",\n        \"2. The method of claim 1, wherein...\",\n        \"3. A system for implementing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69086", "text": "{\n    \"patent_title\": \"High-Performance Lithium-Ion Battery with Enhanced Electrolyte\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a high-performance lithium-ion battery with an enhanced electrolyte composition, resulting in increased energy density and improved cycle life. The battery is suitable for electric vehicles and grid-scale energy storage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"Cited by Examiner\"\n        }\n    ],\n    \"claims\": [\n        \"1. A lithium-ion battery comprising...\",\n        \"2. The lithium-ion battery of claim 1, wherein...\",\n        \"3. An electrolyte composition for a lithium-ion battery...\",\n        \"4. The electrolyte composition of claim 3, further comprising...\",\n        \"5. A method of manufacturing a lithium-ion battery...\",\n        \"6. The method of claim 5, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69086", "text": "{\n    \"patent_title\": \"Improved Solar Cell Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved design for solar cells, enhancing their efficiency in converting sunlight into electricity. The design incorporates novel materials and structural features.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"kind\": \"Cited by Applicant\"\n        }\n    ],\n    \"claims\": [\n        \"1. A solar cell comprising...\",\n        \"2. The solar cell of claim 1, wherein...\",\n        \"3. A method of fabricating a solar cell...\",\n        \"4. The method of claim 3, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69087", "text": "{\n    \"patent_title\": \"Improved Battery Electrode Material\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel electrode material for lithium-ion batteries with improved energy density and cycle life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A battery electrode comprising...\",\n        \"The battery electrode of claim 1, wherein...\",\n        \"A lithium-ion battery comprising...\",\n        \"The lithium-ion battery of claim 3, wherein...\",\n        \"A method of manufacturing...\",\n        \"The method of claim 5, wherein...\",\n        \"The method of claim 5, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69087", "text": "{\n    \"patent_title\": \"Wireless Communication System\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2014-12-01\",\n    \"filing_date\": \"2014-12-01\",\n    \"issue_date\": \"2018-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new wireless communication system using advanced modulation techniques.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A wireless communication device comprising...\",\n        \"A method for transmitting data...\",\n        \"The method of claim 2, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69088", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Independent Researcher\"\n        }\n    ],\n    \"patent_number\": \"US10543210B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-01-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for improved image recognition accuracy using deep convolutional neural networks. The system utilizes a novel training algorithm that enhances feature extraction and reduces overfitting. Applications include autonomous vehicles, medical image analysis, and security systems. The core concept is to apply image recognition techniques to various complex scenarios.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Classification System\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for image recognition comprising...\",\n        \"2. The system of claim 1, wherein the neural network...\",\n        \"3. A method for training an image recognition system...\",\n        \"4. The method of claim 3, further comprising...\",\n        \"5. A computer-readable medium storing instructions...\",\n        \"6. The computer-readable medium of claim 5...\",\n        \"7. The system of claim 1, wherein the images...\",\n        \"8. A method for classifying images...\",\n        \"9. The method of claim 8, wherein the feature extraction...\",\n        \"10. The system of claim 1, wherein the accuracy...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69088", "text": "{\n    \"patent_title\": \"Method for Object Detection in Video Streams\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2021-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method for detecting objects in real-time video streams. It uses a combination of background subtraction and optical flow analysis to identify moving objects. The method is suitable for surveillance and traffic monitoring applications. This is an important improvement on existing systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Video Surveillance System\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for detecting objects in a video stream...\",\n        \"2. The method of claim 1, wherein the background subtraction...\",\n        \"3. A system for object detection comprising...\",\n        \"4. The system of claim 3, wherein the optical flow analysis...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69089", "text": "{\n    \"patent_title\": \"System and method for image recognition using convolutional neural networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for identifying objects within images using convolutional neural networks. The system is trained on a large dataset of labeled images and can accurately classify objects with high precision.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image classification using support vector machines\"\n        },\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"title\": \"Object detection using Haar-like features\"\n        },\n        {\n            \"patent_number\": \"US9234567B1\",\n            \"title\": \"Deep learning for image segmentation\"\n        },\n        {\n            \"patent_number\": \"US8876543B2\",\n            \"title\": \"Real-time image recognition system\"\n        },\n        {\n            \"patent_number\": \"US9345678B1\",\n            \"title\": \"Improved convolutional neural network architecture\"\n        }\n    ],\n    \"claims\": [\n        \"A method for identifying objects in an image comprising...\",\n        \"A system for image recognition comprising...\",\n        \"A computer-readable medium storing instructions for...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69089", "text": "{\n    \"patent_title\": \"Method for improved data compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2018-11-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel data compression method that utilizes Huffman coding and run-length encoding to achieve high compression ratios.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Data compression using Lempel-Ziv algorithm\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Lossless image compression technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data comprising...\",\n        \"A system for data compression comprising...\",\n        \"A computer-readable medium storing instructions for...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69090", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-14\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery design incorporating a new electrolyte formulation to enhance thermal stability and cycle life. The battery exhibits improved performance characteristics under extreme operating conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"Related prior art in lithium-ion electrolyte compositions.\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte formulation for a lithium-ion battery...\",\n        \"A method for manufacturing a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69090", "text": "{\n    \"patent_title\": \"Nickel-Metal Hydride Battery with Improved Charge Retention\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob White\",\n            \"affiliation\": \"California Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2012-05-20\",\n    \"filing_date\": \"2012-05-19\",\n    \"issue_date\": \"2018-01-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A nickel-metal hydride battery with a modified electrode structure to improve charge retention and reduce self-discharge. The battery demonstrates enhanced performance in portable electronic devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"relevance\": \"Previous work on nickel-metal hydride electrode materials.\"\n        }\n    ],\n    \"claims\": [\n        \"A nickel-metal hydride battery comprising...\",\n        \"An electrode structure for a nickel-metal hydride battery...\",\n        \"A method for assembling a nickel-metal hydride battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69091", "text": "{\n    \"patent_title\": \"Improved Electrolyte for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved electrolyte composition for lithium-ion batteries, enhancing their energy density and cycle life. The electrolyte contains a novel additive that stabilizes the solid electrolyte interphase (SEI) layer.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Lithium-Ion Battery with Modified Separator\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrolyte composition...\",\n        \"The electrolyte composition of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69091", "text": "{\n    \"patent_title\": \"Advanced Lithium-Ion Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"MIT Lincoln Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-05-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A sophisticated battery management system (BMS) for lithium-ion batteries, providing improved safety and performance monitoring. The system includes advanced algorithms for state-of-charge estimation and thermal management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Lithium-Ion Battery Cell Design\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for a lithium-ion battery comprising...\",\n        \"The battery management system of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69092", "text": "{\n    \"patent_title\": \"System and Method for Predictive Maintenance using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-12-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for predicting equipment failures using machine learning algorithms. The system analyzes sensor data to identify patterns indicative of potential failures, allowing for proactive maintenance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Data Analytics for Industrial Control Systems\"\n        }\n    ],\n    \"claims\": [\n        \"A method for predicting equipment failure comprising: collecting sensor data...\",\n        \"A system for predictive maintenance...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69092", "text": "{\n    \"patent_title\": \"Image Recognition System Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Visionary AI Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-01\",\n    \"issue_date\": \"2023-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An image recognition system utilizing deep learning techniques for accurate object detection and classification in visual data. The system is designed for high-performance image analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"title\": \"Methods for Image Feature Extraction\"\n        },\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"title\": \"Convolutional Neural Networks for Image Processing\"\n        }\n    ],\n    \"claims\": [\n        \"An image recognition system comprising: a deep learning model...\",\n        \"A method for object detection using convolutional neural networks...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69093", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Medical Device for Targeted Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2019-08-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable medical device for the controlled release of therapeutic agents directly to a targeted site within the body. The device utilizes microfluidic channels and biocompatible materials for precise drug delivery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related prior art in implantable devices\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable medical device comprising...\",\n        \"A method for targeted drug delivery using the device...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69093", "text": "{\n    \"patent_title\": \"Surgical Instrument for Bone Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-02-28\",\n    \"filing_date\": \"2019-02-28\",\n    \"issue_date\": \"2021-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical instrument designed to facilitate precise bone reconstruction procedures. The instrument incorporates ergonomic features and advanced cutting mechanisms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Previous designs in surgical instruments\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising...\",\n        \"A method for bone reconstruction using the instrument...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69094", "text": "{\n    \"patent_title\": \"Novel Polymer Composites for Enhanced Structural Integrity\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel polymer composites exhibiting enhanced structural integrity and thermal stability. The materials are synthesized using a unique polymerization process, resulting in superior mechanical properties compared to existing materials.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Similar polymer composition\"\n        }\n    ],\n    \"claims\": [\n        \"A polymer composite comprising...\",\n        \"A method for synthesizing the polymer composite...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69094", "text": "{\n    \"patent_title\": \"Advanced Control Systems for Robotics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-05\",\n    \"issue_date\": \"2023-06-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents an advanced control system for robotic manipulators, enabling precise and coordinated movements. The system utilizes a novel algorithm for trajectory planning and obstacle avoidance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\",\n            \"relevance\": \"Related robotic control methods\"\n        }\n    ],\n    \"claims\": [\n        \"A control system for a robotic manipulator...\",\n        \"A method for trajectory planning...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69095", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Improved Electrolyte Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery comprising a novel electrolyte formulation that enhances stability and extends cycle life. The invention addresses degradation issues common in high-energy density lithium-ion cells, particularly at elevated temperatures. The electrolyte includes a lithium salt and a solvent mixture with additives that form a stable solid electrolyte interphase (SEI) layer.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Lithium-Ion Battery with Improved Cycling Performance\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising: an anode; a cathode; and an electrolyte comprising a lithium salt and a solvent mixture.\",\n        \"The lithium-ion battery of claim 1, wherein the solvent mixture comprises ethylene carbonate and dimethyl carbonate.\",\n        \"The lithium-ion battery of claim 2, wherein the lithium salt is lithium hexafluorophosphate.\",\n        \"The lithium-ion battery of claim 1, further comprising an additive to enhance SEI layer formation.\",\n        \"The lithium-ion battery of claim 4, wherein the additive is vinylene carbonate.\",\n        \"The lithium-ion battery of claim 1, having a cycle life of at least 500 cycles.\",\n        \"A method for manufacturing a lithium-ion battery comprising the steps of…\"\n    ]\n}"}
{"_id": "Academic--patents--n--69095", "text": "{\n    \"patent_title\": \"Nickel-Metal Hydride Battery with Improved Charge Retention\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US8123456B1\",\n    \"priority_date\": \"2009-12-01\",\n    \"filing_date\": \"2009-12-01\",\n    \"issue_date\": \"2012-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A nickel-metal hydride battery designed for improved charge retention during extended periods of storage. The invention focuses on modifications to the electrode materials to minimize self-discharge. This addresses a significant limitation of NiMH batteries in portable electronic devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"title\": \"Nickel-Metal Hydride Battery with Enhanced Capacity\"\n        }\n    ],\n    \"claims\": [\n        \"A nickel-metal hydride battery comprising: an anode; a cathode; and an electrolyte.\",\n        \"The nickel-metal hydride battery of claim 1, wherein the anode comprises a metal hydride alloy.\",\n        \"The nickel-metal hydride battery of claim 2, wherein the metal hydride alloy comprises LaNi5.\",\n        \"The nickel-metal hydride battery of claim 1, wherein the cathode comprises nickel hydroxide.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69096", "text": "{\n    \"patent_title\": \"Method and System for Efficient Neural Network Training\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for efficiently training neural networks using a novel optimization algorithm. The system utilizes distributed computing to accelerate the training process and achieves state-of-the-art performance on image recognition tasks. The algorithm minimizes loss functions using stochastic gradient descent.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in neural network optimization\"\n        }\n    ],\n    \"claims\": [\n        \"A method for training a neural network...\",\n        \"A system comprising a processor...\",\n        \"The method of claim 1, wherein the neural network is a convolutional neural network...\",\n        \"The system of claim 2, wherein the distributed computing environment comprises...\",\n        \"The method of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69096", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Motors\"\n        }\n    ],\n    \"patent_number\": \"US11345678B2\",\n    \"priority_date\": \"2020-03-10\",\n    \"filing_date\": \"2020-04-05\",\n    \"issue_date\": \"2021-09-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system for electric vehicles that optimizes charging and discharging cycles to extend battery life and improve performance. The system uses advanced algorithms to monitor battery health and prevent overcharging or deep discharging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in battery management\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"The system of claim 1, further comprising a temperature sensor...\",\n        \"The system of claim 1, wherein the charging algorithm is adaptive...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69097", "text": "{\n    \"patent_title\": \"System and Method for Predictive Maintenance using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2018-11-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for predicting equipment failure using machine learning algorithms. The system analyzes sensor data to identify patterns indicative of potential failures, enabling proactive maintenance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"cited_by\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predictive maintenance comprising...\",\n        \"A method for analyzing sensor data using a machine learning algorithm...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69097", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-05-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved data compression algorithm that utilizes Huffman coding and run-length encoding to achieve higher compression ratios. The algorithm is applicable to various data types.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"kind\": \"cited_by\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data comprising...\",\n        \"A data compression system utilizing Huffman coding...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69098", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-05-20\",\n    \"issue_date\": \"2012-08-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system and method for image recognition using artificial intelligence and machine learning algorithms. The system utilizes convolutional neural networks to analyze images and identify objects with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Image Processing System\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for identifying objects in an image using artificial intelligence...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69098", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2009-12-10\",\n    \"filing_date\": \"2010-01-15\",\n    \"issue_date\": \"2011-06-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved bicycle brake system featuring enhanced stopping power and durability. The system utilizes a novel cable tensioning mechanism and high-friction brake pads.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"title\": \"Bicycle Brake Design\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle brake system comprising...\",\n        \"A cable tensioning mechanism for improved braking performance...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69099", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for image recognition utilizing artificial intelligence and deep learning algorithms. The system is capable of identifying objects with high accuracy and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Classification System\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for identifying objects in an image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69099", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Robert Williams\",\n            \"affiliation\": \"Tesla\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2016-11-01\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery management system designed to improve energy efficiency and lifespan. The system utilizes advanced algorithms to monitor and control battery performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Lithium-Ion Battery Charging System\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery performance...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69100", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized wireless pressure sensor system for biomedical applications. The system incorporates a MEMS pressure sensor and a low-power wireless transceiver for remote data transmission. The abstract describes the sensor's application and performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising...\",\n        \"A method for measuring pressure using a wireless sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69100", "text": "{\n    \"patent_title\": \"Advanced Image Processing Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-14\",\n    \"issue_date\": \"2020-07-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image processing algorithm for enhancing image clarity and reducing noise. The algorithm utilizes advanced filtering techniques to improve image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"An image processing method comprising...\",\n        \"A system for enhancing image quality...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69101", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications is disclosed. The sensor utilizes a MEMS pressure transducer and a low-power wireless communication module to transmit pressure data. This is particularly useful for continuous monitoring of physiological parameters.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for monitoring pressure using a wireless sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69101", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2009-12-01\",\n    \"filing_date\": \"2009-12-01\",\n    \"issue_date\": \"2012-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles is disclosed. The system includes advanced charging algorithms and thermal management techniques to enhance battery life and performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for charging a battery using an improved algorithm...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69102", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel electrode materials for lithium-ion batteries with enhanced energy density and cycle life. The materials exhibit improved performance characteristics suitable for electric vehicle applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art on lithium-ion battery technology\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode material...\",\n        \"The electrode material according to claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69102", "text": "{\n    \"patent_title\": \"Novel Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2022-01-10\",\n    \"filing_date\": \"2022-01-10\",\n    \"issue_date\": \"2023-11-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a battery management system for optimizing battery performance and safety in various applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related prior art on battery management systems\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising a controller...\",\n        \"The controller according to claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69103", "text": "{\n    \"patent_title\": \"Neural Network Based Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel neural network architecture for improved image recognition accuracy. The system utilizes convolutional neural networks and recurrent neural networks to analyze visual data and provide accurate classifications. The system is highly adaptable and can be trained on various datasets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"kind\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising a convolutional neural network.\",\n        \"The system of claim 1, further comprising a recurrent neural network.\",\n        \"The system of claim 2, wherein the recurrent neural network is a long short-term memory network.\",\n        \"A method for training a neural network for image recognition.\",\n        \"The method of claim 4, wherein the training data is labeled.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69103", "text": "{\n    \"patent_title\": \"Method for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10111213B1\",\n    \"priority_date\": \"2009-11-01\",\n    \"filing_date\": \"2010-05-20\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new data compression algorithm that achieves high compression ratios with low computational overhead. The algorithm employs a combination of Huffman coding and run-length encoding.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"kind\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data comprising applying Huffman coding.\",\n        \"The method of claim 1, further comprising applying run-length encoding.\",\n        \"A system for compressing data using the method of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69104", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Data Encryption\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n        }\n    ],\n    \"patent_number\": \"US10567890B2\",\n    \"priority_date\": \"2014-12-15\",\n    \"filing_date\": \"2015-03-01\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for encrypting data using a novel algorithm providing enhanced security features.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"Claim 1: A method for encrypting data comprising...\",\n        \"Claim 2: A system for decrypting data comprising...\",\n        \"Claim 3: The method of claim 1, wherein...\",\n        \"Claim 4: The system of claim 2, wherein...\",\n        \"Claim 5: The method of claim 3, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69104", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2016-05-20\",\n    \"filing_date\": \"2017-01-10\",\n    \"issue_date\": \"2021-07-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery design that improves energy density and lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"Claim 1: A battery cell comprising...\",\n        \"Claim 2: The battery cell of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69105", "text": "{\n    \"patent_title\": \"Method and System for AI-Powered Drug Discovery\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for accelerating drug discovery using artificial intelligence and machine learning techniques. It analyzes large datasets of chemical compounds and biological targets to predict potential drug candidates with improved efficacy and reduced side effects.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for identifying potential drug candidates comprising...\",\n        \"A system for analyzing biological data using artificial intelligence...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69105", "text": "{\n    \"patent_title\": \"Enhanced Image Processing Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2021-07-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel image processing technique for enhancing the clarity and resolution of digital images. The method involves a series of filtering and reconstruction algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising...\",\n        \"An image processing system utilizing filtering algorithms...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69106", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-14\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel method and system for enhanced image processing, employing advanced algorithms for noise reduction and feature extraction. The technique improves image quality and accuracy for various applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Image Filtering Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image processing comprising...\",\n        \"A system for enhancing image quality...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69106", "text": "{\n    \"patent_title\": \"Improved Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2010-12-01\",\n    \"filing_date\": \"2010-12-01\",\n    \"issue_date\": \"2018-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new algorithm for data compression, achieving significant improvements in compression ratio and speed. The algorithm is applicable to a variety of data types.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B2\",\n            \"title\": \"Data Compression Methods\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression...\",\n        \"A system for reducing data size...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69107", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Recognition Using Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for enhanced image recognition utilizing deep neural networks. The system is capable of identifying objects with high accuracy and efficiency. The neural network architecture incorporates convolutional layers and recurrent layers for robust feature extraction and classification.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69107", "text": "{\n    \"patent_title\": \"Improved Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Inc.\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Panasonic\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-22\",\n    \"issue_date\": \"2023-05-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles, designed to enhance battery life, performance, and safety. This system incorporates advanced algorithms for cell balancing and thermal management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Prior art in battery technology\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling a battery comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69108", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for high-accuracy image recognition utilizing artificial intelligence and deep learning algorithms. It improves upon existing methods by incorporating a novel attention mechanism.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for image recognition comprising...\",\n        \"2. The system of claim 1, wherein...\",\n        \"3. A method for performing image recognition...\",\n        \"4. The method of claim 3, further comprising...\",\n        \"5. A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69108", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Cycling Dynamics Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-08-10\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2021-01-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an enhanced bicycle brake system utilizing a new hydraulic fluid and lever design for improved stopping power and responsiveness.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"1. A bicycle brake system comprising...\",\n        \"2. The brake system of claim 1, wherein...\",\n        \"3. A hydraulic fluid for use in a bicycle brake system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69109", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for image recognition using artificial intelligence and deep learning techniques. The system processes images to identify objects with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"kind\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for processing images using AI...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69109", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Tesla\"\n        },\n        {\n            \"name\": \"Eve Franklin\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved battery management system for electric vehicles, enhancing safety and extending battery life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"kind\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69110", "text": "{\n    \"patent_title\": \"System and Method for Predictive Maintenance using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for predicting equipment failures using machine learning algorithms. The system analyzes sensor data to identify patterns indicative of impending failures, enabling proactive maintenance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for predictive maintenance comprising...\",\n        \"2. The system of claim 1, wherein the machine learning algorithm is a neural network.\",\n        \"3. A method for predicting equipment failures comprising...\",\n        \"4. The method of claim 3, wherein the sensor data includes temperature readings.\",\n        \"5. The method of claim 3, further comprising generating an alert when a predicted failure probability exceeds a threshold.\",\n        \"6. A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69110", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Cycling Solutions Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-08-01\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2021-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a bicycle braking system with improved stopping power and modulation. It features a novel caliper design and lever mechanism.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"1. A bicycle braking system comprising...\",\n        \"2. The braking system of claim 1, wherein the caliper is made of aluminum alloy.\",\n        \"3. A bicycle lever mechanism comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69111", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for enhanced image recognition using deep convolutional neural networks. The system is capable of identifying objects with high accuracy and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"cited_by\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for processing images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69111", "text": "{\n    \"patent_title\": \"Improved Image Recognition Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Global Tech Corp\"\n        }\n    ],\n    \"patent_number\": \"US10246813B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This patent details an improved algorithm for image recognition, focusing on speed and accuracy in identifying various objects within images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"kind\": \"cited_by\"\n        }\n    ],\n    \"claims\": [\n        \"An image recognition algorithm...\",\n        \"A computer-implemented method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69112", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-14\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel electrode materials for lithium-ion batteries, exhibiting enhanced energy density and cycle life. The materials are based on a modified lithium metal oxide composition and are particularly suitable for electric vehicle applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrode comprising...\",\n        \"A method of manufacturing a lithium-ion battery electrode...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69112", "text": "{\n    \"patent_title\": \"Novel Solar Cell Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2012-07-20\",\n    \"filing_date\": \"2012-07-19\",\n    \"issue_date\": \"2018-11-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new type of solar cell that utilizes perovskite materials to achieve high conversion efficiency. The design incorporates a unique light trapping structure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"relevance\": \"Relevant prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A solar cell comprising a perovskite layer...\",\n        \"A method for fabricating a solar cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69113", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Fraud Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-06-15\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for detecting fraudulent transactions using artificial intelligence and machine learning algorithms. The system analyzes transaction data in real-time to identify patterns indicative of fraud.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting fraudulent transactions comprising...\",\n        \"A system for analyzing transaction data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69113", "text": "{\n    \"patent_title\": \"AI-Assisted Diagnostic Tool for Cardiac Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MedTech Solutions\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2018-11-20\",\n    \"filing_date\": \"2019-01-10\",\n    \"issue_date\": \"2021-04-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An artificial intelligence-based system for analyzing cardiac signals to assist in the diagnosis of heart conditions.  The system provides real-time analysis and alerts to medical professionals.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"related to medical device control\"\n        },\n        {\n            \"patent_number\": \"US91234567B1\",\n            \"relevance\": \"prior art in ECG analysis\"\n        }\n    ],\n    \"claims\": [\n        \"A system for analyzing cardiac signals comprising...\",\n        \"A method for diagnosing heart conditions...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69114", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Processing Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2012-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method and system for enhanced image processing utilizing deep learning algorithms. It provides improved image quality and efficient processing capabilities, particularly for medical imaging applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Image Enhancement Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image quality comprising...\",\n        \"A system for processing images using deep learning...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69114", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-05-20\",\n    \"issue_date\": \"2013-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel algorithm for data compression, significantly reducing file sizes without compromising data integrity. It is applicable to various data types, including text, images, and audio.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US89012345B2\",\n            \"title\": \"Data Compression Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data comprising...\",\n        \"A system for encoding data efficiently...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69115", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Neural Network Training\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2019-11-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing the training of neural networks using a novel optimization algorithm. This algorithm improves convergence speed and accuracy, particularly for deep learning models.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for training a neural network...\",\n        \"A method for optimizing a neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69115", "text": "{\n    \"patent_title\": \"Advanced Robotics Control System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"California Institute of Technology\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2019-05-20\",\n    \"filing_date\": \"2019-05-20\",\n    \"issue_date\": \"2021-03-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel control system for advanced robotic applications, featuring enhanced precision and responsiveness. The system utilizes feedback loops and adaptive algorithms to optimize performance in dynamic environments.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10112233B2\"\n        }\n    ],\n    \"claims\": [\n        \"A control system for a robot...\",\n        \"A method for controlling a robotic arm...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69116", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Maria Lopez\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Chen\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-03-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to novel materials for lithium-ion battery electrodes, enhancing energy density and cycle life. The materials incorporate a unique coating process improving ion conductivity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrode comprising...\",\n        \"A method for manufacturing said electrode...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69116", "text": "{\n    \"patent_title\": \"Novel Polymer Electrolyte for Sodium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"California Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11123456B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new polymer electrolyte for use in sodium-ion batteries, demonstrating improved ionic conductivity and thermal stability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A polymer electrolyte composition comprising...\",\n        \"A sodium-ion battery including said electrolyte...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69117", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-10\",\n    \"filing_date\": \"2011-05-09\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for remote monitoring. The sensor utilizes MEMS technology and transmits data via Bluetooth. This invention builds upon prior art in wireless sensing and data acquisition.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Wireless Data Transmission System\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"title\": \"Microelectromechanical Systems (MEMS) Pressure Sensor\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising...\",\n        \"A method for remote pressure monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69117", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2012-03-15\",\n    \"filing_date\": \"2012-03-14\",\n    \"issue_date\": \"2018-12-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery management system that improves energy efficiency and prolongs battery life. This system utilizes advanced algorithms for charge control and discharge optimization.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery charge...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69118", "text": "{\n    \"patent_title\": \"System and method for image recognition using a convolutional neural network\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition using a convolutional neural network is disclosed. The system comprises a plurality of processing units configured to perform convolutional operations on input image data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Similar image processing technique\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for processing image data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69118", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-08-10\",\n    \"filing_date\": \"2017-08-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles is disclosed. The system optimizes charging and discharging cycles to extend battery life and improve performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Prior art in battery technology\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69119", "text": "{\n    \"patent_title\": \"Image Processing System for Enhanced Video Quality\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system for advanced image processing techniques to enhance video quality. It utilizes novel algorithms for noise reduction and edge detection, resulting in clearer and more detailed images. Applications include surveillance systems and content creation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in noise reduction\"\n        }\n    ],\n    \"claims\": [\n        \"A system for processing images comprising...\",\n        \"A method for reducing noise in images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69119", "text": "{\n    \"patent_title\": \"Medical Image Processing System for Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-05\",\n    \"issue_date\": \"2023-06-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a system for medical image processing specifically designed for the detection of tumors in MRI and CT scans. The system uses deep learning algorithms to identify cancerous regions with high accuracy. This is a medical imaging application.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\",\n            \"relevance\": \"Prior art in medical imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A system for detecting tumors in medical images...\",\n        \"A method for processing MRI scans...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69120", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Processing in Autonomous Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2018-11-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing image processing capabilities in autonomous vehicles, specifically focusing on object detection and scene understanding. The system utilizes deep learning algorithms to improve the accuracy and efficiency of image analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art in object detection.\"\n        }\n    ],\n    \"claims\": [\n        \"A system for processing images comprising:...\",\n        \"A method for enhancing image clarity...\",\n        \"The system of claim 1, wherein the images are captured from a vehicle.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69120", "text": "{\n    \"patent_title\": \"Medical Image Analysis System with Enhanced Contrast\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2015-03-15\",\n    \"filing_date\": \"2015-03-15\",\n    \"issue_date\": \"2017-09-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel medical image analysis system designed for enhanced contrast and improved diagnostic accuracy. The system utilizes advanced algorithms to process medical images such as X-rays, MRIs, and CT scans.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art in medical imaging algorithms.\"\n        }\n    ],\n    \"claims\": [\n        \"A system for analyzing medical images comprising:...\",\n        \"A method for enhancing contrast in medical images...\",\n        \"The system of claim 1, wherein the images are medical X-rays.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69121", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications. The system includes a MEMS pressure sensor, a low-power wireless transceiver, and a battery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A pressure sensor system comprising...\",\n        \"The system of claim 1, wherein the sensor is wireless.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69121", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2021-01-20\",\n    \"filing_date\": \"2021-04-15\",\n    \"issue_date\": \"2022-07-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery technology with increased energy density and lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising...\",\n        \"The battery cell of claim 1, wherein the energy density is increased.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69122", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2019-03-20\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system incorporating a novel 3D visualization technique and robotic arm control for enhanced precision during surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Robotic Surgical System\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"3D Visualization System\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Minimally Invasive Instruments\"\n        },\n        {\n            \"patent_number\": \"US11000001B2\",\n            \"title\": \"Haptic Feedback System\"\n        },\n        {\n            \"patent_number\": \"US11111111B2\",\n            \"title\": \"Image Guided Surgery\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising...\",\n        \"A method for performing minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69122", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Angioplasty\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Medtronic\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"Boston Scientific\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2018-07-12\",\n    \"issue_date\": \"2022-02-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design for angioplasty procedures, featuring enhanced flexibility and reduced risk of vessel damage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Angioplasty Catheter\"\n        },\n        {\n            \"patent_number\": \"US10987654B2\",\n            \"title\": \"Vessel Wall Imaging\"\n        },\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"title\": \"Balloon Angioplasty\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising...\",\n        \"A method for performing angioplasty...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69123", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-15\",\n    \"filing_date\": \"2014-05-15\",\n    \"issue_date\": \"2018-03-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications. The sensor utilizes MEMS technology to provide accurate and reliable pressure readings. This system incorporates a low-power communication protocol and is designed for implantable or wearable devices.  The sensor offers high sensitivity and low drift.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising...\",\n        \"A system for measuring pressure...\",\n        \"A method of using a wireless pressure sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69123", "text": "{\n    \"patent_title\": \"Advanced Image Processing Techniques\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-01-20\",\n    \"filing_date\": \"2017-01-20\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"Novel image processing algorithms for enhancing image clarity and reducing noise. This invention utilizes Fourier transforms and wavelet analysis to improve image quality in various applications.  It includes methods for edge detection and object recognition.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"An image processing method comprising...\",\n        \"A system for enhancing image quality...\",\n        \"A computer-readable medium...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69124", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to improved electrode materials for lithium-ion batteries, enhancing their energy density and cycle life. The materials are based on novel composite structures and coatings.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode material...\",\n        \"The electrode material of claim 1, wherein...\",\n        \"A method for manufacturing...\",\n        \"A device incorporating the lithium-ion battery...\",\n        \"The device of claim 4, further comprising...\",\n        \"An electrolyte for use with the lithium-ion battery...\",\n        \"The electrolyte of claim 6, comprising...\",\n        \"A system for controlling the lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69124", "text": "{\n    \"patent_title\": \"Novel Polymer Composites for Automotive Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Ford Motor Company\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-12-01\",\n    \"filing_date\": \"2009-12-01\",\n    \"issue_date\": \"2018-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes new polymer composite materials for use in automotive body panels and structural components. These materials offer improved strength and reduced weight.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A polymer composite material comprising...\",\n        \"The polymer composite material of claim 1, wherein...\",\n        \"A method for manufacturing...\",\n        \"An automotive component comprising the polymer composite...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69125", "text": "{\n    \"patent_title\": \"System and method for AI-powered image recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition using artificial intelligence and deep learning techniques. The system analyzes images to identify objects and patterns with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Similar image processing techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for identifying objects in an image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69125", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"ACME Corp\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Independent\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2014-12-15\",\n    \"filing_date\": \"2014-12-14\",\n    \"issue_date\": \"2017-06-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved bicycle brake system providing enhanced stopping power and reliability. The system utilizes a novel cable tensioning mechanism.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Previous brake designs\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle brake system comprising...\",\n        \"A cable tensioning mechanism...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69126", "text": "{\n    \"patent_title\": \"High-Capacity Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"Novel electrode materials for lithium-ion batteries with significantly increased capacity and cycle life are disclosed. The materials comprise a composite of a metal oxide and a carbon nanotube network, improving electron transport and structural stability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"title\": \"Improved Electrolytes for Lithium Batteries\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode material...\",\n        \"The electrode material of claim 1, wherein the metal oxide is titanium dioxide.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69126", "text": "{\n    \"patent_title\": \"Advanced Battery Management System with Predictive Algorithms\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Texas Instruments\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system (BMS) incorporating predictive algorithms to optimize charging and discharging cycles, extend battery life, and enhance safety. The system utilizes machine learning to adapt to varying usage patterns and environmental conditions. Includes lithium-ion battery monitoring features.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Lithium-Ion Battery State Estimation Techniques\"\n        },\n        {\n            \"patent_number\": \"US8987654B1\",\n            \"title\": \"Methods for Thermal Management of Battery Packs\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising a processor and memory...\",\n        \"The battery management system of claim 1, wherein the processor is configured to implement a predictive algorithm.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69127", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications. The sensor utilizes MEMS technology to accurately measure pressure changes and transmit data wirelessly to a remote monitoring device. The abstract includes the word 'sensor'.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related medical device patent\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for measuring pressure using a MEMS sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69127", "text": "{\n    \"patent_title\": \"Automotive Tire Pressure Monitoring System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Ford Motor Company\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automotive tire pressure monitoring system using integrated sensors. The system provides real-time tire pressure data to the vehicle's control system. The abstract includes the word 'sensor'.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art automotive TPMS\"\n        },\n        {\n            \"patent_number\": \"US9654321B1\",\n            \"relevance\": \"Related automotive control system patent\"\n        }\n    ],\n    \"claims\": [\n        \"An automotive tire pressure monitoring system...\",\n        \"A method for detecting tire pressure changes...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69128", "text": "{\n    \"patent_title\": \"Method and System for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for image recognition using artificial intelligence techniques, specifically deep convolutional neural networks. The system improves accuracy and speed of image identification.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in image processing.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\",\n        \"The method of claim 1, wherein...\",\n        \"The system of claim 2, wherein...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69128", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Motors\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2016-11-01\",\n    \"issue_date\": \"2018-12-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved battery management system for electric vehicles, enhancing energy efficiency and safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"relevance\": \"Related art in battery technology.\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"The system of claim 1, wherein...\",\n        \"A method for managing battery charge...\",\n        \"The method of claim 2, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69129", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method and system for enhancing the resolution of digital images using deep learning techniques. The system utilizes a convolutional neural network trained on a large dataset of high-resolution images to predict missing details in low-resolution images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Super-Resolution Using Sparse Representation\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Deep Convolutional Neural Networks for Image Classification\"\n        },\n        {\n            \"patent_number\": \"US9543210B1\",\n            \"title\": \"Generative Adversarial Networks for Image Synthesis\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"title\": \"Real-Time Image Enhancement Techniques\"\n        },\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Adaptive Image Filtering Methods\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing the resolution of a digital image comprising...\",\n        \"A system for enhancing the resolution of a digital image comprising...\",\n        \"The method of claim 1, wherein the convolutional neural network is trained...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69129", "text": "{\n    \"patent_title\": \"Novel Display Technology for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Samsung Electronics\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Apple Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a new display technology for mobile devices with improved brightness and contrast ratio. The technology utilizes a unique arrangement of pixels and a novel backlight system.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Organic Light-Emitting Diode Display Devices\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Liquid Crystal Display Technologies\"\n        },\n        {\n            \"patent_number\": \"US9123456B1\",\n            \"title\": \"Backlight Systems for Displays\"\n        }\n    ],\n    \"claims\": [\n        \"A display device comprising...\",\n        \"The display device of claim 1, wherein the pixel arrangement is...\",\n        \"The display device of claim 2, wherein the backlight system is...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69130", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-05-20\",\n    \"issue_date\": \"2018-07-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a miniature wireless pressure sensor system for biomedical applications. The system includes a MEMS pressure sensor, a low-power transceiver, and a biocompatible package.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"The system of claim 1, wherein the sensor is a MEMS device.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69130", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Caltech\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-11-01\",\n    \"filing_date\": \"2010-01-15\",\n    \"issue_date\": \"2017-05-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel lithium-ion battery with improved energy density and cycle life. The battery utilizes a new electrolyte composition and a modified electrode structure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"The battery of claim 1, wherein the electrolyte contains...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69131", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Improved Electrolyte\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a lithium-ion battery with an improved electrolyte composition, leading to increased energy density and cycle life. The novel electrolyte reduces dendrite formation and enhances safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in lithium-ion battery technology\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition comprising...\",\n        \"A method for manufacturing a lithium-ion battery...\",\n        \"The lithium-ion battery according to claim 1, wherein...\",\n        \"The electrolyte composition according to claim 2, further comprising...\",\n        \"The method according to claim 3, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69131", "text": "{\n    \"patent_title\": \"Advanced Solar Cell Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-03-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel design for a high-efficiency solar cell utilizing perovskite materials. The design maximizes light absorption and electron transport.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related work on perovskite solar cells\"\n        }\n    ],\n    \"claims\": [\n        \"A solar cell comprising...\",\n        \"A perovskite material with enhanced light absorption...\",\n        \"A method for fabricating a solar cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69132", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications. The system incorporates a low-power MEMS pressure sensor and a custom integrated circuit for signal conditioning and wireless transmission. The sensor's small size enables minimally invasive monitoring.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Wireless Physiological Monitoring System\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising...\",\n        \"A method for measuring pressure using...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69132", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2017-01-10\",\n    \"filing_date\": \"2017-01-10\",\n    \"issue_date\": \"2020-02-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel lithium-ion battery with improved energy density and cycle life. The battery utilizes a new electrolyte formulation and a modified electrode structure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Lithium-Ion Battery with Enhanced Stability\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"A method for manufacturing a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69133", "text": "{\n    \"patent_title\": \"Method and System for Optimized Neural Network Training\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for optimizing the training of neural networks using a novel gradient descent algorithm. The system improves convergence speed and accuracy. It leverages adaptive learning rates and momentum techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in neural network optimization\"\n        }\n    ],\n    \"claims\": [\n        \"A method for training a neural network...\",\n        \"A system comprising a processor and memory...\",\n        \"The method of claim 1, wherein the gradient descent algorithm...\",\n        \"The system of claim 2, wherein the adaptive learning rate is...\",\n        \"The method of claim 1, further comprising...\",\n        \"The system of claim 2, further comprising...\",\n        \"The method of claim 1, wherein the neural network is...\",\n        \"The system of claim 2, wherein the neural network is...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69133", "text": "{\n    \"patent_title\": \"Image Recognition System using Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Google LLC\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Google LLC\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-01\",\n    \"issue_date\": \"2023-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An image recognition system utilizing convolutional neural networks for object detection and classification. The system achieves high accuracy and real-time performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"relevance\": \"Related art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A system for recognizing images...\",\n        \"A method for classifying objects...\",\n        \"The system of claim 1, wherein the convolutional neural network...\",\n        \"The method of claim 2, comprising the steps of...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69134", "text": "{\n    \"patent_title\": \"Improved Electrolyte for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-06-15\",\n    \"issue_date\": \"2018-02-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel electrolyte composition for lithium-ion batteries, enhancing energy density and cycle life. The electrolyte contains a specific blend of lithium salts and organic solvents.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Lithium-Ion Battery with Enhanced Stability\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrolyte containing...\",\n        \"The electrolyte according to claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69134", "text": "{\n    \"patent_title\": \"Advanced Lithium-Ion Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"MIT Lincoln Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-08-01\",\n    \"filing_date\": \"2017-09-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system for lithium-ion batteries that optimizes charging and discharging profiles, improving battery performance and safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Improved Electrolyte for Lithium-Ion Batteries\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising a controller configured to...\",\n        \"The system according to claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69135", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for improved image recognition using artificial intelligence techniques, specifically deep convolutional neural networks. The system is capable of identifying objects with high accuracy and speed.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69135", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Tesla\"\n        },\n        {\n            \"name\": \"Eve Wilson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2021-07-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a battery management system designed to enhance the efficiency and lifespan of lithium-ion batteries. It incorporates advanced algorithms for charge control and temperature regulation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling battery charge...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69136", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for remote monitoring of industrial equipment. The system utilizes a MEMS pressure sensor and a low-power transceiver for data transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"The system of claim 1, wherein the sensor is a MEMS sensor.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69136", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876544B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-02-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles, enhancing charge efficiency and lifespan.  The system optimizes power distribution and thermal regulation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"The system of claim 1, wherein the power distribution is optimized based on vehicle load.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69137", "text": "{\n    \"patent_title\": \"Novel Polymer Composites for High-Strength Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to novel polymer composites exhibiting high tensile strength and impact resistance. The materials are suitable for use in aerospace and automotive applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A polymer composite comprising...\",\n        \"A method for manufacturing the polymer composite...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69137", "text": "{\n    \"patent_title\": \"Advanced Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Caltech\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles, optimizing charge and discharge cycles to enhance battery life and performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10112233A1\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling the battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69138", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor for Intracranial Pressure Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2020-05-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor for intracranial pressure monitoring. The device utilizes MEMS technology and wireless communication for real-time data transmission, aiding in accurate diagnosis and improved patient care. Imaging capabilities are used for precise placement.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9546532B2\",\n            \"relevance\": \"Related prior art in wireless sensors\"\n        }\n    ],\n    \"claims\": [\n        \"1. A wireless pressure sensor...\",\n        \"2. The sensor of claim 1, comprising...\",\n        \"3. A method of monitoring intracranial pressure...\",\n        \"4. The method of claim 3, wherein...\",\n        \"5. The sensor of claim 1, further comprising...\",\n        \"6. A system for intracranial pressure monitoring...\",\n        \"7. The system of claim 6, including...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69138", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emily Davis\",\n            \"affiliation\": \"UCSF\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2021-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This patent discloses an improved catheter design for targeted drug delivery. The catheter features a novel tip geometry to enhance maneuverability and reduce patient discomfort. It enhances the delivery of therapeutic agents to specific locations within the body.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art in catheter design\"\n        }\n    ],\n    \"claims\": [\n        \"1. A catheter comprising...\",\n        \"2. The catheter of claim 1, wherein...\",\n        \"3. A method of drug delivery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69139", "text": "{\n    \"patent_title\": \"Miniaturized Biosensor System for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-06-20\",\n    \"issue_date\": \"2021-12-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a miniaturized biosensor system for continuous glucose monitoring. The system utilizes novel enzymatic reactions coupled with electrochemical detection, providing accurate and reliable glucose measurements. The system includes a biocompatible interface and wireless data transmission capabilities. The biosensors are fabricated using microfabrication techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\",\n            \"relevance\": \"Related prior art on glucose monitoring systems.\"\n        }\n    ],\n    \"claims\": [\n        \"A biosensor system for continuous glucose monitoring comprising...\",\n        \"A method for fabricating a miniaturized biosensor...\",\n        \"A wireless communication module for transmitting glucose data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69139", "text": "{\n    \"patent_title\": \"Surgical Instrument with Enhanced Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2021-08-10\",\n    \"filing_date\": \"2021-11-05\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel surgical instrument designed to improve ergonomics and reduce surgeon fatigue during complex procedures. The instrument incorporates adjustable handles, optimized weight distribution, and a streamlined design for enhanced maneuverability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"relevance\": \"Prior art relating to surgical instrument design.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising adjustable handles...\",\n        \"An ergonomic design for improved surgeon comfort...\",\n        \"A method for reducing surgeon fatigue...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69140", "text": "{\n    \"patent_title\": \"System and Method for Predictive Maintenance Using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for predicting equipment failure using machine learning algorithms. The system analyzes sensor data to identify patterns indicative of potential failures, allowing for proactive maintenance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"cited_by\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predicting equipment failure, comprising:...\",\n        \"A method for analyzing sensor data, comprising:...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69140", "text": "{\n    \"patent_title\": \"Improved Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Jones\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Smith\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved data compression algorithm that reduces file size without significant loss of information. This algorithm is particularly effective for image and video data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"kind\": \"cited_by\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data, comprising:...\",\n        \"A system for encoding data, comprising:...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69141", "text": "{\n    \"patent_title\": \"System and Method for Image Recognition Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-14\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition using deep convolutional neural networks are disclosed. The system includes a convolutional neural network trained to identify objects in images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\"\n        },\n        {\n            \"patent_number\": \"US9000000B1\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        },\n        {\n            \"patent_number\": \"US9234567B1\"\n        },\n        {\n            \"patent_number\": \"US9345678B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for identifying objects in an image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69141", "text": "{\n    \"patent_title\": \"Method for Enhancing Contrast in Medical Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Mayo Clinic\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-12-20\",\n    \"filing_date\": \"2009-12-18\",\n    \"issue_date\": \"2017-05-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for enhancing the contrast of medical images is presented, improving diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        },\n        {\n            \"patent_number\": \"US8543210B2\"\n        },\n        {\n            \"patent_number\": \"US8678901B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for contrast enhancement...\",\n        \"A medical imaging system utilizing the contrast enhancement method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69142", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2010-05-15\",\n    \"filing_date\": \"2010-06-01\",\n    \"issue_date\": \"2012-11-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for image recognition using artificial intelligence techniques, specifically convolutional neural networks. The system improves accuracy and efficiency in identifying objects within images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Prior Art Image Processing System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for identifying objects in an image comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69142", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tesla\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2011-03-10\",\n    \"filing_date\": \"2011-04-05\",\n    \"issue_date\": \"2013-09-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel battery composition and architecture, improving energy density and lifespan. It utilizes new electrode materials and electrolyte formulations.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"title\": \"Previous Battery Design\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising...\",\n        \"An electrolyte formulation for enhanced battery performance...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69143", "text": "{\n    \"patent_title\": \"System and method for image recognition using deep convolutional neural networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876453B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-01-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition utilizing deep convolutional neural networks. The system is capable of accurately identifying objects within images by leveraging learned features from a large dataset.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8576741B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69143", "text": "{\n    \"patent_title\": \"Method for object detection in video streams\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9988765B1\",\n    \"priority_date\": \"2017-08-15\",\n    \"filing_date\": \"2017-08-14\",\n    \"issue_date\": \"2019-05-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for detecting objects in real-time video streams, employing background subtraction and motion analysis techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9235678B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for object detection in video streams comprising...\",\n        \"A system for real-time object detection comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69144", "text": "{\n    \"patent_title\": \"Microfluidic Sensor with Integrated Signal Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-15\",\n    \"filing_date\": \"2015-03-20\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic sensor for detecting biomolecules with high sensitivity and specificity. Includes integrated signal processing for real-time analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        },\n        {\n            \"patent_number\": \"US7654321B1\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\"\n        },\n        {\n            \"patent_number\": \"US9234567B1\"\n        },\n        {\n            \"patent_number\": \"US9345678B2\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic sensor comprising...\",\n        \"A method for detecting a biomolecule using the sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69144", "text": "{\n    \"patent_title\": \"Wireless Communication System Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Bell Labs\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2021-02-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"Improvements to wireless communication systems, focusing on data throughput and reliability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        },\n        {\n            \"patent_number\": \"US9765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication system comprising...\",\n        \"A method for improving data throughput in a wireless system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69145", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Intel Corp\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications. The system utilizes a low-power microcontroller and a MEMS pressure sensor to transmit data wirelessly. This is a novel design for implantable sensors.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Wireless Physiological Monitoring System\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"The system of claim 1, wherein the sensor is a MEMS sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69145", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles. This system optimizes charging and discharging cycles to extend battery life and improve performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Lithium-Ion Battery Monitoring\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"The system of claim 1, wherein the battery is a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69146", "text": "{\n    \"patent_title\": \"Improved Electrolyte for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel electrolyte composition for lithium-ion batteries, enhancing their energy density and cycle life. The composition incorporates a unique additive that improves ionic conductivity and reduces degradation. Applications include portable electronics and grid-scale energy storage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Lithium Salt for Electrolytes\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrolyte comprising...\",\n        \"The electrolyte of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69146", "text": "{\n    \"patent_title\": \"Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) for electric vehicles, providing advanced cell balancing and thermal management to optimize performance and lifespan. This system utilizes machine learning algorithms to predict and prevent battery failures, ensuring safe and reliable operation of electric vehicles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Improved Electrolyte for Lithium-Ion Batteries\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Electric Vehicle Powertrain Control\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for an electric vehicle comprising...\",\n        \"The BMS of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69147", "text": "{\n    \"patent_title\": \"Method and System for AI-Powered Predictive Maintenance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for predictive maintenance utilizing artificial intelligence algorithms to analyze sensor data and predict equipment failures. It improves efficiency and reduces downtime.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for predictive maintenance comprising:...\",\n        \"A system for predictive maintenance comprising:...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69147", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"CycleTech Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-05-20\",\n    \"filing_date\": \"2016-05-20\",\n    \"issue_date\": \"2018-11-13\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel bicycle braking system utilizing a dual-piston caliper and improved pad material for enhanced stopping power and modulation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle braking system comprising:...\",\n        \"A caliper assembly for a bicycle brake comprising:...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69148", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for image recognition using artificial intelligence, specifically deep convolutional neural networks. The system is capable of identifying objects with high accuracy and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a neural network...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The system of claim 1, wherein the neural network...\",\n        \"The method of claim 2, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69148", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Independent Inventor\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-05-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved braking system for bicycles, providing increased stopping power and safety.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A bicycle braking system comprising...\",\n        \"A brake lever adapted to...\",\n        \"A cable connecting the brake lever...\",\n        \"A brake caliper configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69149", "text": "{\n    \"patent_title\": \"Method and System for Training Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for efficiently training deep neural networks with improved convergence rates are disclosed. The invention utilizes a novel optimization algorithm to minimize the loss function and enhance the accuracy of the network.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for training a deep neural network...\",\n        \"A system comprising a processor and memory...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69149", "text": "{\n    \"patent_title\": \"Improved Image Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US8901234B1\",\n    \"priority_date\": \"2009-12-01\",\n    \"filing_date\": \"2009-12-01\",\n    \"issue_date\": \"2018-04-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image compression technique that reduces file size without significant loss of quality is described.  The technique employs wavelet transforms and quantization methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"An image compression method...\",\n        \"A device for compressing images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69150", "text": "{\n    \"patent_title\": \"High-Efficiency Perovskite Solar Cell with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"National Renewable Energy Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US10563456B2\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2019-02-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel perovskite solar cell structure with enhanced stability and efficiency. The device incorporates a new hole transport material, resulting in improved performance characteristics.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A perovskite solar cell comprising...\",\n        \"A method for fabricating a perovskite solar cell...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69150", "text": "{\n    \"patent_title\": \"Silicon Solar Cell with Improved Light Trapping\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"SunPower Corporation\"\n        }\n    ],\n    \"patent_number\": \"US8987654B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-08-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a silicon solar cell with improved light trapping achieved through nanostructuring of the cell surface. This increases efficiency compared to standard silicon cells.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9127329B2\",\n            \"kind\": \"Cited as relevant\"\n        }\n    ],\n    \"claims\": [\n        \"A silicon solar cell comprising a nanostructured surface...\",\n        \"A method for manufacturing a silicon solar cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69151", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel composite material for lithium-ion battery electrodes, exhibiting enhanced energy density and cycle life. The material utilizes a unique nanostructure to improve ion transport and reduce resistance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrode comprising...\",\n        \"The electrode of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69151", "text": "{\n    \"patent_title\": \"Novel Polymer Electrolyte for Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new polymer electrolyte is described that enhances the safety and performance of batteries. It demonstrates high ionic conductivity and thermal stability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A polymer electrolyte comprising...\",\n        \"The electrolyte of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69152", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel system and method for enhanced image processing, utilizing advanced algorithms to improve image quality and reduce noise. The system employs a multi-stage filtering process to achieve optimal results in a variety of applications including medical imaging and surveillance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Filtering Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image comprising...\",\n        \"A system for processing images, the system comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69152", "text": "{\n    \"patent_title\": \"Novel Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a new data compression algorithm designed to improve efficiency and reduce storage requirements. The algorithm utilizes a unique encoding scheme based on fractal geometry. It does not relate to image processing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"System and Method for Enhanced Image Processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data comprising...\",\n        \"A system for data compression...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69153", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Predictive Maintenance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-05-15\",\n    \"filing_date\": \"2020-06-15\",\n    \"issue_date\": \"2022-11-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for predicting equipment failures using artificial intelligence and machine learning techniques. The system analyzes sensor data to identify patterns indicative of potential failures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Prior art in predictive maintenance\"\n        },\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"relevance\": \"Related machine learning algorithm\"\n        },\n        {\n            \"patent_number\": \"US76543210B1\",\n            \"relevance\": \"Sensor data analysis techniques\"\n        },\n        {\n            \"patent_number\": \"US65432109B2\",\n            \"relevance\": \"Fault diagnosis methods\"\n        },\n        {\n            \"patent_number\": \"US54321098B1\",\n            \"relevance\": \"Data processing techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predicting equipment failures comprising a sensor data acquisition module, a machine learning model, and a prediction output module.\",\n        \"A method for predicting equipment failures comprising the steps of acquiring sensor data, training a machine learning model, and generating a prediction.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69153", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US98765432B3\",\n    \"priority_date\": \"2021-03-10\",\n    \"filing_date\": \"2021-04-10\",\n    \"issue_date\": \"2023-07-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system that extends battery life and enhances safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B3\",\n            \"relevance\": \"Prior art in battery management\"\n        },\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related charging algorithms\"\n        },\n        {\n            \"patent_number\": \"US65432109B1\",\n            \"relevance\": \"Battery cell monitoring techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising a charging control module, a cell monitoring module, and a safety protection module.\",\n        \"A method for managing a battery comprising the steps of monitoring cell voltage, controlling charging current, and providing safety protection.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69154", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2015-03-15\",\n    \"filing_date\": \"2015-05-20\",\n    \"issue_date\": \"2018-12-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications. The system utilizes a MEMS pressure sensor and a low-power wireless transceiver for remote data transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"title\": \"Wireless Medical Device\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising a MEMS pressure sensor...\",\n        \"The system of claim 1, wherein the wireless transceiver operates in the 2.4 GHz band.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69154", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-08-01\",\n    \"filing_date\": \"2016-10-15\",\n    \"issue_date\": \"2019-05-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery with enhanced energy density and cycle life. This technology utilizes a new electrolyte formulation to improve performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Lithium Ion Battery Electrode\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrolyte...\",\n        \"The battery of claim 1, wherein the electrolyte comprises a novel lithium salt.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69155", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Recognition Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for enhancing image recognition accuracy by leveraging deep convolutional neural networks. The system includes a preprocessing module, a convolutional neural network module, and a classification module. The network is trained on a large dataset of labeled images to achieve state-of-the-art performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Classification Using Support Vector Machines\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69155", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"IBM\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2018-01-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents an improved data compression algorithm based on Huffman coding and run-length encoding. It achieves a higher compression ratio with lower computational complexity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Huffman Coding Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising...\",\n        \"A system for data compression comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69156", "text": "{\n    \"patent_title\": \"High-Performance Lithium-Ion Battery Electrode Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-14\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery electrode material with enhanced energy density and cycle life is described. The material utilizes a unique nanostructure to improve ion transport and reduce internal resistance. This invention focuses on novel cathode materials.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Novel Electrolytes for Lithium-Ion Batteries\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrode comprising...\",\n        \"A method for manufacturing the lithium-ion battery electrode...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69156", "text": "{\n    \"patent_title\": \"Battery Management System for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Texas Instruments\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2012-05-20\",\n    \"filing_date\": \"2012-05-19\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) for lithium-ion batteries that provides advanced monitoring and control features. The BMS includes cell balancing, overcharge protection, and thermal management capabilities. This invention deals with managing and controlling battery performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Advanced Algorithms for Battery State Estimation\"\n        },\n        {\n            \"patent_number\": \"US9123456B1\",\n            \"title\": \"Improved Cooling Systems for Lithium-Ion Batteries\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling the charging and discharging of a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69157", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved lithium-ion battery with a novel electrolyte composition and cathode material, resulting in enhanced stability and increased energy density. The battery is suitable for use in electric vehicles and portable electronic devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"The battery of claim 1, wherein the electrolyte...\",\n        \"The battery of claim 1, wherein the cathode...\",\n        \"A method for manufacturing the battery...\",\n        \"The method of claim 4, comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69157", "text": "{\n    \"patent_title\": \"Novel Polymer Electrolyte for Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new polymer electrolyte for use in various battery types, focusing on improved ionic conductivity and safety. It does not specifically focus on Lithium-ion chemistry.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A polymer electrolyte comprising...\",\n        \"The electrolyte of claim 1, wherein the polymer...\",\n        \"A battery cell comprising the electrolyte...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69158", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Improved Electrolyte\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery comprising a novel electrolyte formulation that enhances ion conductivity and improves battery lifespan. The electrolyte includes a lithium salt dissolved in a mixture of organic solvents.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"kind\": \"Cited by Applicant\"\n        }\n    ],\n    \"claims\": [\n        \"1. A lithium-ion battery comprising...\",\n        \"2. The lithium-ion battery of claim 1, wherein the electrolyte...\",\n        \"3. The lithium-ion battery of claim 2, wherein the lithium salt...\",\n        \"4. The lithium-ion battery of claim 3, wherein the organic solvents...\",\n        \"5. The lithium-ion battery of claim 4, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69158", "text": "{\n    \"patent_title\": \"Advanced Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Ji-hoon Kim\",\n            \"affiliation\": \"Samsung Electronics\"\n        },\n        {\n            \"name\": \"Su-jin Park\",\n            \"affiliation\": \"Samsung Electronics\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2012-03-10\",\n    \"filing_date\": \"2012-03-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system for lithium-ion batteries designed to optimize charging and discharging cycles, extending battery life and ensuring safe operation. It includes advanced thermal management features.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"kind\": \"Cited by Examiner\"\n        }\n    ],\n    \"claims\": [\n        \"1. A battery management system comprising...\",\n        \"2. The battery management system of claim 1, wherein the thermal...\",\n        \"3. The battery management system of claim 2, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69159", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for enhancing the quality of reconstructed images obtained from various imaging modalities. It utilizes advanced image processing techniques to reduce noise and improve resolution, leading to more accurate diagnostic results.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image reconstruction comprising...\",\n        \"A system for image processing including...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69159", "text": "{\n    \"patent_title\": \"Novel Camera Lens Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-08-22\",\n    \"filing_date\": \"2017-08-22\",\n    \"issue_date\": \"2020-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new design for a camera lens offering improved light transmission and reduced distortion. The lens is designed for high-resolution photography.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A camera lens comprising...\",\n        \"A method of manufacturing a camera lens...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69160", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to improved electrode materials for lithium-ion batteries, enhancing energy density and cycle life. The materials comprise a novel composite structure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art on lithium-ion battery materials\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrode comprising...\",\n        \"The electrode of claim 1, wherein...\",\n        \"A method for manufacturing the electrode...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69160", "text": "{\n    \"patent_title\": \"Advanced Lithium-Ion Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2021-02-01\",\n    \"filing_date\": \"2021-04-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel battery management system for lithium-ion batteries, improving safety and performance. It uses advanced algorithms for cell balancing and thermal control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US12345678B2\",\n            \"relevance\": \"Related technology in battery management\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"The system of claim 1, further comprising...\",\n        \"A method for controlling the battery...\",\n        \"Another claim...\",\n        \"Yet another claim...\",\n        \"And another claim...\",\n        \"A final claim...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69161", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2020-11-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for image recognition using artificial intelligence and deep learning techniques. The system is capable of identifying objects with high accuracy and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training an AI model...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69161", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Local Bike Shop\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Independent Inventor\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2015-08-20\",\n    \"filing_date\": \"2015-08-19\",\n    \"issue_date\": \"2019-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved bicycle brake system providing enhanced stopping power and durability.  The system incorporates a novel cable tensioning mechanism.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle brake system...\",\n        \"A cable tensioning mechanism...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69162", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Battery Management in Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for enhanced battery management in electric vehicles. The system utilizes advanced algorithms to optimize charging and discharging cycles, extending battery life and improving overall vehicle performance. It includes features for temperature monitoring, state-of-charge estimation, and cell balancing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A system for managing a battery pack comprising:...\",\n        \"The system of claim 1, further comprising:...\",\n        \"A method for managing a battery pack...\",\n        \"The method of claim 3, wherein...\",\n        \"The system of claim 1, wherein...\",\n        \"The method of claim 3, further comprising...\",\n        \"The system of claim 2, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69162", "text": "{\n    \"patent_title\": \"Improved Solar Cell Design for Residential Use\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2012-11-01\",\n    \"filing_date\": \"2012-11-01\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved solar cell design for residential use, enhancing energy conversion efficiency and reducing manufacturing costs. The design incorporates a novel light trapping mechanism and a highly conductive electrode material.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A solar cell comprising:...\",\n        \"The solar cell of claim 1, wherein...\",\n        \"A method for manufacturing a solar cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69163", "text": "{\n    \"patent_title\": \"Method and System for Real-time Image Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Marc Levoy\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Ren Ng\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-05-15\",\n    \"filing_date\": \"2010-03-22\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for real-time image enhancement using a novel algorithm for improving image quality.  This invention utilizes advanced image processing techniques to reduce noise and enhance details in digital images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image comprising...\",\n        \"The method of claim 1, wherein the image is a digital image.\",\n        \"The method of claim 1, wherein the enhancement includes noise reduction.\",\n        \"A system for enhancing an image...\",\n        \"The system of claim 4, wherein the image processing algorithm is implemented in hardware.\",\n        \"The system of claim 4, comprising a display for viewing the enhanced image.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69163", "text": "{\n    \"patent_title\": \"Digital Signal Processing Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2008-11-20\",\n    \"filing_date\": \"2009-01-10\",\n    \"issue_date\": \"2018-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel digital signal processing technique for improving the clarity of audio signals.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for processing a digital signal comprising...\",\n        \"The method of claim 1, wherein the signal is an audio signal.\",\n        \"A system for processing a digital signal...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69164", "text": "{\n    \"patent_title\": \"Wireless Sensor Network for Structural Health Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless sensor network is described for monitoring the structural integrity of bridges and buildings. The sensors detect strain, temperature, and vibration data, transmitting it wirelessly to a central processing unit for analysis. This system provides real-time assessment of structural health.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Low-Power Wireless Communication Protocol\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor network comprising a plurality of sensor nodes...\",\n        \"A method for monitoring structural health using a wireless sensor network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69164", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-09-01\",\n    \"filing_date\": \"2017-09-01\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor is disclosed for continuous monitoring of blood glucose levels in diabetic patients. The sensor wirelessly transmits data to an external receiver for display and analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Miniaturized Implantable Medical Device\"\n        },\n        {\n            \"patent_number\": \"US8789012B1\",\n            \"title\": \"Wireless Communication for Biomedical Applications\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable glucose sensor comprising...\",\n        \"A system for continuous glucose monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69165", "text": "{\n    \"patent_title\": \"Method and System for Real-Time Object Recognition in Video Streams\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-02-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for real-time object recognition in video streams. The system utilizes advanced image processing techniques to identify and track objects with high accuracy and speed.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Prior Art Object Detection System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for real-time object recognition comprising...\",\n        \"A system for processing video streams to identify objects...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69165", "text": "{\n    \"patent_title\": \"Image Enhancement Technique for Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Lee\",\n            \"affiliation\": \"Stanford University Medical Center\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2012-03-10\",\n    \"filing_date\": \"2012-03-10\",\n    \"issue_date\": \"2020-05-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An image enhancement technique for improving the clarity and diagnostic value of medical images. The method employs image processing algorithms to reduce noise and enhance contrast.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"title\": \"Medical Image Processing System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing medical images comprising...\",\n        \"A system for processing medical images to improve clarity...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69166", "text": "{\n    \"patent_title\": \"Method and System for Optimized Neural Network Training\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-06-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method and system for training neural networks with improved convergence speed and accuracy. The method utilizes a dynamic learning rate adjustment based on gradient information, resulting in significantly faster training times.  The system implements this method using a distributed computing framework.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on gradient descent optimization.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for training a neural network comprising:...\",\n        \"The method of claim 1, wherein the learning rate is...\",\n        \"A system for training a neural network comprising:...\",\n        \"The system of claim 3, wherein the distributed computing framework...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69166", "text": "{\n    \"patent_title\": \"Improved Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-01-10\",\n    \"filing_date\": \"2022-01-10\",\n    \"issue_date\": \"2023-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a battery management system for electric vehicles. It includes advanced thermal regulation and charge balancing techniques to improve battery lifespan and performance. The system also provides real-time monitoring and diagnostic capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art on battery thermal management.\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for an electric vehicle comprising:...\",\n        \"The system of claim 1, wherein the thermal regulation...\",\n        \"A method for monitoring battery health...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69167", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-06-15\",\n    \"filing_date\": \"2015-03-20\",\n    \"issue_date\": \"2019-05-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel electrode materials for lithium-ion batteries with enhanced energy density and cycle life. The materials exhibit improved ionic conductivity and stability, leading to superior battery performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"relevance\": \"Related art\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode material...\",\n        \"The electrode material comprising a composite of...\",\n        \"A method of manufacturing a lithium-ion battery...\",\n        \"The method comprising coating the electrode...\",\n        \"The lithium-ion battery having a cycle life of at least 500 cycles.\",\n        \"The lithium-ion battery having an energy density of at least 250 Wh/kg.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69167", "text": "{\n    \"patent_title\": \"New Polymer Electrolyte for Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-01-10\",\n    \"filing_date\": \"2016-07-22\",\n    \"issue_date\": \"2020-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new polymer electrolyte for use in advanced battery systems, improving safety and performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A battery comprising a polymer electrolyte...\",\n        \"The polymer electrolyte having an ionic conductivity...\",\n        \"A method of manufacturing a battery comprising the polymer electrolyte...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69168", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel electrode materials for lithium-ion batteries, exhibiting enhanced energy density and cycle life. The materials are composed of a modified lithium metal oxide structure and a new electrolyte formulation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrode material for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69168", "text": "{\n    \"patent_title\": \"Novel Polymer Electrolyte for Solid-State Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"University of Texas\"\n        },\n        {\n            \"name\": \"Eve Davis\",\n            \"affiliation\": \"Rice University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a new polymer electrolyte for use in solid-state batteries, improving safety and performance. The electrolyte exhibits high ionic conductivity and mechanical stability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A solid-state battery comprising...\",\n        \"A polymer electrolyte for a solid-state battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69169", "text": "{\n    \"patent_title\": \"Implantable Cardiovascular Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Medtronic\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-06-20\",\n    \"issue_date\": \"2021-01-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiovascular sensor system for monitoring heart function. The system utilizes a micro-sensor to detect changes in blood flow and pressure, providing real-time data for diagnosis and treatment.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art in implantable devices\"\n        }\n    ],\n    \"claims\": [\n        \"A system for monitoring cardiovascular function comprising a sensor.\",\n        \"A method for diagnosing heart conditions using sensor data.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69169", "text": "{\n    \"patent_title\": \"Surgical Instrument for Orthopedic Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Johnson & Johnson\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-08-15\",\n    \"issue_date\": \"2020-03-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical instrument designed for precision orthopedic procedures. The instrument features an ergonomic handle and a durable cutting blade.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related prior art in surgical tools\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising an ergonomic handle.\",\n        \"A cutting blade for orthopedic procedures.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69170", "text": "{\n    \"patent_title\": \"Neural Network Architecture for Efficient Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel neural network architecture that significantly improves the efficiency of image recognition tasks. The architecture utilizes a sparse connectivity pattern and a unique activation function to reduce computational complexity while maintaining high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"1. A neural network comprising...\",\n        \"2. The neural network of claim 1, wherein...\",\n        \"3. The neural network of claim 2, wherein...\",\n        \"4. The neural network of claim 3, wherein...\",\n        \"5. The neural network of claim 4, wherein...\",\n        \"6. The neural network of claim 5, wherein...\",\n        \"7. The neural network of claim 6, wherein...\",\n        \"8. The neural network of claim 7, wherein...\",\n        \"9. The neural network of claim 8, wherein...\",\n        \"10. The neural network of claim 9, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69170", "text": "{\n    \"patent_title\": \"Improved Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11223344B2\",\n    \"priority_date\": \"2017-08-22\",\n    \"filing_date\": \"2017-08-22\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a new data compression algorithm based on Huffman coding and run-length encoding, achieving better compression ratios than existing methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for compressing data comprising...\",\n        \"2. The method of claim 1, wherein...\",\n        \"3. The method of claim 2, wherein...\",\n        \"4. The method of claim 3, wherein...\",\n        \"5. The method of claim 4, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69171", "text": "{\n    \"patent_title\": \"Method and System for Neural Network-Based Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-04-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for image recognition using a deep neural network. The system comprises a convolutional neural network and a classification module to identify objects within images with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760723B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69171", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system with improved thermal regulation and charging efficiency. The system utilizes advanced control algorithms to optimize battery performance and lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling battery charging comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69172", "text": "{\n    \"patent_title\": \"High-Sensitivity Pressure Sensor with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a high-sensitivity pressure sensor utilizing a novel nanomaterial. The sensor exhibits enhanced stability and is suitable for a wide range of applications including medical devices and industrial process control. This new sensor improves upon previous technology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Prior Art Pressure Sensor\"\n        }\n    ],\n    \"claims\": [\n        \"A pressure sensor comprising...\",\n        \"The pressure sensor of claim 1...\",\n        \"A method of manufacturing...\",\n        \"The method of claim 2...\",\n        \"A system including...\",\n        \"The system of claim 4...\",\n        \"The sensor of claim 1 wherein...\",\n        \"The method of claim 2 further comprising...\",\n        \"The system of claim 4 further including...\",\n        \"A device using...\",\n        \"The device of claim 9...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69172", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-05-20\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved battery management system for electric vehicles. The system enhances battery life and safety through advanced monitoring and control algorithms. This system is a breakthrough in battery technology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Existing Battery System\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system...\",\n        \"The battery management system of claim 1...\",\n        \"A method for controlling...\",\n        \"The method of claim 2...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69173", "text": "{\n    \"patent_title\": \"System and Method for Image Recognition using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition utilizing deep convolutional neural networks. The system is capable of identifying objects and scenes within images with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8780536B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition...\"\n    ]\n}"}
