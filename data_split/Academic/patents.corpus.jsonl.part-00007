{"_id": "Academic--patents--p--66888", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-15\",\n    \"filing_date\": \"2015-03-10\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor providing continuous monitoring and wireless data transmission to a mobile device.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8652098B2\",\n            \"title\": \"Continuous Glucose Monitoring System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for continuously monitoring glucose levels in a patient.\",\n        \"An implantable sensor for detecting glucose concentration.\",\n        \"A wireless communication module for transmitting glucose data.\",\n        \"A mobile application for displaying glucose readings.\",\n        \"A system comprising an implantable sensor and a mobile application.\",\n        \"A method for calibrating the glucose sensor.\",\n        \"A device for analyzing glucose trends.\"\n    ]\n}"}
