{"_id": "Academic--patents--p--66522", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Detail\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for enhancing image detail through a novel filtering algorithm. The algorithm effectively reduces noise while preserving edges, resulting in improved image clarity. This is particularly useful in medical imaging and surveillance systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in image filtering\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for enhancing image detail comprising...\",\n        \"2. The method of claim 1, wherein the filtering algorithm...\",\n        \"3. A system for enhancing image detail comprising...\",\n        \"4. The system of claim 3, wherein the processor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66522", "text": "{\n    \"patent_title\": \"Advanced Data Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new technique for data compression using wavelet transforms. This method significantly reduces file sizes while maintaining data integrity. The technique is applicable to various data types, including images, audio, and video.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related work in data compression\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for data compression comprising...\",\n        \"2. The method of claim 1, wherein the wavelet transform...\",\n        \"3. A system for data compression comprising...\",\n        \"4. The system of claim 3, wherein the memory...\",\n        \"5. The method of claim 1, further comprising...\",\n        \"6. The system of claim 3, further comprising...\",\n        \"7. The method of claim 1, wherein the data is...\",\n        \"8. The system of claim 3, wherein the processor...\",\n        \"9. The method of claim 1, wherein the compression ratio...\",\n        \"10. The system of claim 3, wherein the output is...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66523", "text": "{\n    \"patent_title\": \"Neural Network Based Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a neural network based system for image recognition. The system utilizes convolutional neural networks to achieve high accuracy in object detection and classification.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Previous Image Recognition Method\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66523", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Tesla\"\n        },\n        {\n            \"name\": \"Eve Garcia\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-11-01\",\n    \"filing_date\": \"2022-11-01\",\n    \"issue_date\": \"2024-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a battery management system that enhances battery life and performance through optimized charging and discharging algorithms. It includes temperature monitoring and voltage regulation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Existing Battery Technology\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for regulating voltage in a battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66524", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-15\",\n    \"filing_date\": \"2015-03-10\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor is disclosed, comprising a glucose oxidase enzyme, a working electrode, a reference electrode, and a wireless communication module for transmitting glucose readings to an external device.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"relevance\": \"Prior art relating to glucose sensing.\"\n        }\n    ],\n    \"claims\": [\n        \"A glucose sensor comprising a glucose oxidase enzyme immobilized on a working electrode.\",\n        \"The glucose sensor of claim 1, further comprising a wireless communication module.\",\n        \"The glucose sensor of claim 2, wherein the wireless communication module transmits data via Bluetooth.\",\n        \"A method for measuring glucose levels using the sensor of claim 1.\",\n        \"A system comprising the glucose sensor of claim 1 and an external receiving device.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66524", "text": "{\n    \"patent_title\": \"Novel Algorithm for Image Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2017-05-15\",\n    \"issue_date\": \"2020-02-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel algorithm for enhancing image clarity and reducing noise is presented. The algorithm utilizes a wavelet transform and adaptive filtering techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related to wavelet transform techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image processing comprising applying a wavelet transform.\",\n        \"The method of claim 1, further comprising adaptive filtering.\",\n        \"A system for implementing the method of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66525", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-12-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery design featuring a solid-state electrolyte and enhanced thermal stability. The improved design significantly extends battery lifespan and reduces the risk of fire. This invention utilizes a new lithium alloy anode material.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art related to solid-state electrolytes\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising a solid-state electrolyte.\",\n        \"The battery of claim 1, further comprising a lithium alloy anode.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66525", "text": "{\n    \"patent_title\": \"Sodium-Ion Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-06-15\",\n    \"issue_date\": \"2022-03-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A sodium-ion battery with increased energy density compared to existing technologies.  The invention focuses on optimizing the cathode material for improved performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Previous work on sodium-ion cathode materials\"\n        }\n    ],\n    \"claims\": [\n        \"A sodium-ion battery comprising a modified cathode material.\",\n        \"The battery of claim 1, having an energy density of at least 150 Wh/kg.\"\n    ]\n}"}
