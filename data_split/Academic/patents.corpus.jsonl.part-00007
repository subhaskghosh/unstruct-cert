{"_id": "Academic--patents--p--66683", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Recognition Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-08-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method and system for enhancing image recognition accuracy using deep convolutional neural networks. The system incorporates a new activation function and a multi-scale feature extraction module.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Classification System\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Deep Learning for Image Analysis\"\n        },\n        {\n            \"patent_number\": \"US11223344B1\",\n            \"title\": \"Convolutional Neural Network Architecture\"\n        },\n        {\n            \"patent_number\": \"US12112233B2\",\n            \"title\": \"Object Detection using Deep Learning\"\n        },\n        {\n            \"patent_number\": \"US13113344B1\",\n            \"title\": \"Image Segmentation using Neural Networks\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image recognition accuracy...\",\n        \"A system comprising a deep convolutional neural network...\"\n    ]\n}"}
