{"_id": "Academic--patents--n--66686", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11123456B2\",\n    \"priority_date\": \"2017-12-20\",\n    \"filing_date\": \"2017-12-20\",\n    \"issue_date\": \"2020-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a new type of battery with significantly increased energy density and lifespan. It uses a novel electrolyte material and a modified electrode structure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10112233B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A battery comprising...\",\n        \"An electrolyte material...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66687", "text": "{\n    \"patent_title\": \"System and Method for Personalized Medicine Based on Genomic Data\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Genentech\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-15\",\n    \"filing_date\": \"2015-03-20\",\n    \"issue_date\": \"2019-07-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for providing personalized medicine based on genomic data analysis.  The system identifies genetic markers associated with disease susceptibility and tailors treatment plans accordingly.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"relevance\": \"Prior art in genomic sequencing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for identifying genetic markers associated with disease.\",\n        \"A system for providing personalized treatment plans.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66687", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Tesla\"\n        }\n    ],\n    \"patent_number\": \"US10246813B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery technology utilizing novel electrolyte materials, resulting in higher energy density and faster charging times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9586721B2\",\n            \"relevance\": \"Related to electrolyte composition\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising a novel electrolyte composition.\",\n        \"A method for manufacturing a high-energy density battery.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66688", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrolyte\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel electrolyte composition for lithium-ion batteries, improving performance and safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Lithium-Ion Battery Separator\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrolyte composition...\",\n        \"The electrolyte composition according to claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66688", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for managing the charge and discharge of lithium-ion batteries, optimizing performance and lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Battery Monitoring Device\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising a microcontroller...\",\n        \"The system according to claim 1, further comprising a temperature sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66689", "text": "{\n    \"patent_title\": \"Implantable Cardiac Monitor with Enhanced Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-06-15\",\n    \"filing_date\": \"2010-03-01\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac monitor with improved data transmission capabilities using a novel frequency hopping algorithm. The device is designed for long-term monitoring of cardiac function and provides early detection of arrhythmias.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        },\n        {\n            \"patent_number\": \"US8123456B2\"\n        },\n        {\n            \"patent_number\": \"US8901234B1\"\n        },\n        {\n            \"patent_number\": \"US9210987B2\"\n        },\n        {\n            \"patent_number\": \"US10345678B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for transmitting cardiac data...\",\n        \"An implantable cardiac monitor...\",\n        \"A system for detecting arrhythmias...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66689", "text": "{\n    \"patent_title\": \"Novel Surgical Stapler Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2008-11-20\",\n    \"filing_date\": \"2011-01-10\",\n    \"issue_date\": \"2017-10-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical stapler with an improved ergonomic design and enhanced staple deployment mechanism. This invention aims to increase surgical precision and reduce patient recovery time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\"\n        },\n        {\n            \"patent_number\": \"US7210987B2\"\n        },\n        {\n            \"patent_number\": \"US7890123B1\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"A method of using the surgical stapler...\",\n        \"A staple cartridge for use with the stapler...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66690", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Predictive Maintenance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of Innovation\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-06-15\",\n    \"issue_date\": \"2020-12-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for predictive maintenance utilizing artificial intelligence algorithms to analyze sensor data and forecast equipment failures. The system improves efficiency and reduces downtime.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"cited by\"\n        },\n        {\n            \"patent_number\": \"US6543210B2\",\n            \"relevance\": \"similar\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predictive maintenance comprising...\",\n        \"A method for analyzing sensor data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66690", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Cycle Dynamics\"\n        }\n    ],\n    \"patent_number\": \"US90123456B2\",\n    \"priority_date\": \"2019-03-10\",\n    \"filing_date\": \"2019-04-10\",\n    \"issue_date\": \"2021-08-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved bicycle braking system using a novel caliper design and pad material for enhanced stopping power and rider safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B1\",\n            \"relevance\": \"prior art\"\n        },\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle braking system comprising...\",\n        \"A caliper design for improved braking...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66691", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-06-15\",\n    \"filing_date\": \"2010-03-01\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for improving the accuracy of image recognition systems using deep learning techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Image Processing System\"\n        },\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"title\": \"Deep Learning Architecture\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Neural Network Training Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition...\"\n    ]\n}"}
