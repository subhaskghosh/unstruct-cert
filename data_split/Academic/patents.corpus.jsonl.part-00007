{"_id": "Academic--patents--p--66293", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-10\",\n    \"filing_date\": \"2015-03-15\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor provides continuous glucose monitoring and wirelessly transmits data to an external device for analysis and display. The sensor utilizes a novel enzyme-based electrochemical detection method for improved accuracy and stability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"title\": \"Continuous Glucose Monitoring System\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Wireless Data Transmission System\"\n        },\n        {\n            \"patent_number\": \"US9012345B1\",\n            \"title\": \"Implantable Medical Device\"\n        }\n    ],\n    \"claims\": [\n        \"A glucose sensor comprising...\",\n        \"A wireless communication module...\",\n        \"A method for continuous glucose monitoring...\"\n    ]\n}"}
