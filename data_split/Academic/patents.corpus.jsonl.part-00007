{"_id": "Academic--patents--p--66144", "text": "{\n    \"patent_title\": \"Miniature Implantable Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature implantable pressure sensor system for monitoring physiological parameters within the body. The system comprises a MEMS pressure sensor, a wireless communication module, and a biocompatible power source.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art in implantable sensors\"\n        }\n    ],\n    \"claims\": [\n        \"A pressure sensor system comprising a MEMS pressure sensor.\",\n        \"The system of claim 1, further comprising a wireless communication module.\",\n        \"The system of claim 2, wherein the wireless communication module transmits data via Bluetooth.\",\n        \"The system of claim 1, further comprising a biocompatible power source.\",\n        \"A method for monitoring physiological pressure using the system of claim 1.\",\n        \"The method of claim 5, wherein the physiological pressure is intracranial pressure.\"\n    ]\n}"}
