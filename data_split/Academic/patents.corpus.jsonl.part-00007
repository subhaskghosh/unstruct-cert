{"_id": "Academic--patents--p--66390", "text": "{\n    \"patent_title\": \"Improved MRI Contrast Agents for Enhanced Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-02-26\",\n    \"patent_office\": \"US\",\n    \"abstract\": \"This invention provides novel MRI contrast agents that significantly enhance tumor detection capabilities due to their improved biocompatibility and targeted delivery. The agents exhibit increased signal intensity in affected areas, providing clearer diagnostic images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8652412B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A composition comprising a gadolinium-based contrast agent and a targeting ligand.\",\n        \"A method for imaging a tumor comprising administering the composition of claim 1 to a subject.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66390", "text": "{\n    \"patent_title\": \"Novel X-ray Imaging System with Reduced Radiation Exposure\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"US\",\n    \"abstract\": \"This invention discloses an improved X-ray imaging system designed to minimize radiation exposure to patients. The system employs advanced filtering techniques and optimized detector arrays to provide high-quality images with reduced dose levels.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7541234B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising a radiation source, a detector array, and a filtering system.\",\n        \"A method for reducing radiation exposure during X-ray imaging.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66391", "text": "{\n    \"patent_title\": \"System and Method for Dynamic Spectrum Access\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-03-15\",\n    \"filing_date\": \"2010-05-20\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for dynamically accessing spectrum resources in a wireless communication network. The system utilizes cognitive radio techniques to identify and exploit unused spectrum bands.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Cognitive Radio System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for dynamic spectrum access comprising...\",\n        \"A system for identifying unused spectrum bands...\"\n    ]\n}"}
