{"_id": "Academic--patents--p--66174", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2018-03-01\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for improving image recognition accuracy using deep convolutional neural networks.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for recognizing images using a deep learning model.\",\n        \"A system comprising a processor and a memory storing a deep learning model.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66174", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-02-20\",\n    \"filing_date\": \"2018-05-10\",\n    \"issue_date\": \"2021-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new battery technology that provides increased energy density and lifespan for electric vehicles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising a novel electrolyte composition.\",\n        \"An electric vehicle powered by the battery cell.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66175", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2019-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to novel electrode materials for lithium-ion batteries, improving energy density and cycle life. The materials incorporate a unique coating that enhances ion transport.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on lithium-ion battery design\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode material...\",\n        \"The electrode material according to claim 1, further comprising a coating...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66175", "text": "{\n    \"patent_title\": \"Advanced Solar Cell Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Caltech\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2019-07-01\",\n    \"filing_date\": \"2019-09-10\",\n    \"issue_date\": \"2020-02-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new design for solar cells, increasing efficiency through light trapping and improved semiconductor materials.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10112233B2\",\n            \"relevance\": \"Related solar cell technology\"\n        }\n    ],\n    \"claims\": [\n        \"A solar cell comprising a light trapping structure...\",\n        \"The solar cell according to claim 1, utilizing a perovskite semiconductor...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66176", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2022-08-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the resolution of digital images using deep convolutional neural networks. The system utilizes a generative adversarial network (GAN) to create high-resolution images from low-resolution inputs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Super-Resolution Using Convolutional Neural Networks\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Generative Adversarial Networks for Image Synthesis\"\n        },\n        {\n            \"patent_number\": \"US11223344B1\",\n            \"title\": \"Deep Learning Based Image Enhancement\"\n        },\n        {\n            \"patent_number\": \"US12334455B2\",\n            \"title\": \"Real-time Image Processing System\"\n        },\n        {\n            \"patent_number\": \"US13445566B1\",\n            \"title\": \"Adaptive Image Filtering Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing the resolution of a digital image...\",\n        \"A system comprising a deep convolutional neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66176", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2018-11-22\",\n    \"filing_date\": \"2020-03-01\",\n    \"issue_date\": \"2021-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved algorithm for lossless data compression utilizing Huffman coding and run-length encoding. The algorithm provides increased compression ratios compared to existing methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\",\n            \"title\": \"Data Compression using Huffman Coding\"\n        },\n        {\n            \"patent_number\": \"US87654320B2\",\n            \"title\": \"Run-Length Encoding for Data Compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing digital data...\",\n        \"A system implementing a Huffman coding algorithm...\"\n    ]\n}"}
