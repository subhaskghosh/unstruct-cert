{"_id": "Academic--patents--n--69882", "text": "{\n    \"patent_title\": \"Wireless Communication System\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Qualcomm\"\n        },\n        {\n            \"name\": \"Peter Smith\",\n            \"affiliation\": \"Intel\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2011-11-01\",\n    \"filing_date\": \"2012-02-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless communication system with improved data transmission rates and reduced latency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Wireless Communication Protocol\"\n        },\n        {\n            \"patent_number\": \"US9123456B1\",\n            \"title\": \"Signal Processing Algorithm\"\n        },\n        {\n            \"patent_number\": \"US9345678B1\",\n            \"title\": \"Antenna Design\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication system comprising...\",\n        \"The wireless communication system of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69883", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-06-20\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for improving the quality of reconstructed images using deep learning techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"Claim 1: A method for reconstructing an image...\",\n        \"Claim 2: The method of claim 1, wherein...\",\n        \"Claim 3: A system comprising...\",\n        \"Claim 4: The system of claim 3, wherein...\",\n        \"Claim 5: The method of claim 1, further comprising...\"\n    ]\n}"}
