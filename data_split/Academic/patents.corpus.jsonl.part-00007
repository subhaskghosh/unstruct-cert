{"_id": "Academic--patents--p--66420", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a miniature wireless pressure sensor system for biomedical applications. The system includes a highly sensitive pressure sensor, a low-power communication module, and a biocompatible package. The sensor can be used for continuous monitoring of physiological parameters.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Wireless Physiological Monitoring System\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"The system of claim 1, wherein the sensor is...\",\n        \"A method for monitoring pressure using the system of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66420", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-04-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel battery management system for electric vehicles. The system optimizes charging and discharging cycles to extend battery life and improve performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Lithium-Ion Battery Charging Control\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"The system of claim 1, wherein the charging cycle is...\",\n        \"A method for managing battery charging using the system of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66421", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Improved Biocompatibility\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2009-03-15\",\n    \"filing_date\": \"2010-05-20\",\n    \"issue_date\": \"2012-11-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor with a novel biocompatible coating for long-term monitoring of glucose levels in diabetic patients.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\"\n        },\n        {\n            \"patent_number\": \"US9234567B3\"\n        }\n    ],\n    \"claims\": [\n        \"A glucose sensor comprising a biocompatible coating.\",\n        \"A method for monitoring glucose levels using the sensor.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66421", "text": "{\n    \"patent_title\": \"Surgical Stapler with Enhanced Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2008-12-01\",\n    \"filing_date\": \"2009-07-10\",\n    \"issue_date\": \"2011-04-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical stapler designed for improved handling and precision during surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7435678B2\"\n        },\n        {\n            \"patent_number\": \"US8123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler with an ergonomic handle.\",\n        \"A method for performing surgical stapling using the stapler.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66422", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"UC Berkeley\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing image recognition accuracy using deep learning algorithms. The system utilizes convolutional neural networks and transfer learning to improve object detection and classification.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for enhancing image recognition accuracy...\"\n    ]\n}"}
