{"_id": "Academic--patents--p--66396", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-12-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to novel electrode materials for lithium-ion batteries, enhancing energy density and cycle life. The materials are composed of a unique blend of nickel, manganese, and cobalt oxides with a modified surface coating.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in battery electrode materials\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrode material comprising...\",\n        \"The lithium-ion battery electrode material of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66396", "text": "{\n    \"patent_title\": \"Advanced Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2024-01-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A sophisticated battery management system for optimizing the performance and safety of lithium-ion batteries. It includes algorithms for state-of-charge estimation, thermal management, and fault detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related to battery monitoring techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"The battery management system of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66397", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2018-03-10\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a miniature wireless pressure sensor system for remote monitoring applications. The system incorporates a highly sensitive pressure sensor, a low-power transceiver, and a compact energy harvesting module.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A miniature wireless pressure sensor system comprising...\",\n        \"The system of claim 1, wherein the sensor is a piezoelectric sensor.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66397", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11334455B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2018-02-15\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery management system designed to optimize charging and discharging cycles, extending battery life and improving overall performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"The system of claim 1, further comprising a temperature sensor.\"\n    ]\n}"}
