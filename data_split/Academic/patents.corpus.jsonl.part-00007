{"_id": "Academic--patents--p--66299", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved lithium-ion battery electrode material with enhanced energy density and cycle life. The material comprises a novel composite structure facilitating efficient ion transport.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrode comprising...\",\n        \"A method for manufacturing said electrode...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66299", "text": "{\n    \"patent_title\": \"Novel Solar Cell Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-06-10\",\n    \"issue_date\": \"2021-08-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new design for high-efficiency solar cells utilizing perovskite materials and advanced light trapping techniques. This invention significantly improves energy conversion rates.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related prior art in solar cell technology\"\n        }\n    ],\n    \"claims\": [\n        \"A solar cell comprising a perovskite layer...\",\n        \"A method for fabricating said solar cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66300", "text": "{\n    \"patent_title\": \"High-Performance Lithium-Ion Battery Electrode Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10556789B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel lithium-ion battery electrode material with enhanced energy density and cycle life. The material comprises a unique composite structure optimized for fast ion transport.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8980422B2\",\n            \"kind\": \"relevant\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrode comprising...\",\n        \"A method for manufacturing a lithium-ion battery electrode...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66300", "text": "{\n    \"patent_title\": \"Advanced Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2019-10-29\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A sophisticated battery management system (BMS) designed to optimize the performance and safety of lithium-ion batteries in electric vehicles. The BMS utilizes advanced algorithms for cell balancing and thermal management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7236144B2\",\n            \"kind\": \"relevant\"\n        },\n        {\n            \"patent_number\": \"US9124123B2\",\n            \"kind\": \"relevant\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling a lithium-ion battery pack...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66301", "text": "{\n    \"patent_title\": \"Method and System for Intelligent Data Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-10\",\n    \"filing_date\": \"2014-05-10\",\n    \"issue_date\": \"2019-02-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method and system for intelligent data analysis utilizing artificial intelligence algorithms. The system is capable of identifying patterns and anomalies in large datasets with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Similar data analysis techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for analyzing data using artificial intelligence.\",\n        \"A system comprising a processor and memory for implementing the method.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66301", "text": "{\n    \"patent_title\": \"Improved Mechanical Gear Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-08-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel design for mechanical gears, improving efficiency and reducing wear. The design incorporates a unique tooth profile and material composition.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in gear technology\"\n        }\n    ],\n    \"claims\": [\n        \"A mechanical gear with a novel tooth profile.\",\n        \"A method for manufacturing the gear.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66302", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for enhancing image resolution using deep convolutional neural networks. The system utilizes a generative adversarial network (GAN) to produce high-resolution images from low-resolution inputs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Super-Resolution Using Convolutional Neural Networks\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for enhancing image resolution...\",\n        \"2. The method of claim 1, wherein the neural network...\",\n        \"3. A system for enhancing image resolution...\",\n        \"4. The system of claim 3, comprising...\",\n        \"5. A computer-readable medium storing...\",\n        \"6. The computer-readable medium of claim 5...\",\n        \"7. A method for training a neural network...\"\n    ]\n}"}
