{"_id": "Academic--patents--p--69891", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-14\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a miniature wireless pressure sensor system for real-time monitoring of various parameters. The system incorporates a highly sensitive pressure sensor, a low-power wireless transmitter, and a data processing unit. Applications include biomedical monitoring and industrial control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"The system of claim 1, wherein the sensor is a MEMS-based pressure sensor.\",\n        \"The system of claim 1, further comprising a battery.\",\n        \"The system of claim 2, wherein the battery is a lithium-ion battery.\",\n        \"A method for monitoring pressure using the system of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69891", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Independent Inventor\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-12-01\",\n    \"filing_date\": \"2009-12-01\",\n    \"issue_date\": \"2017-05-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved bicycle brake system utilizing hydraulic disc brakes for enhanced stopping power and control. The system features a novel lever design and improved brake pad material.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle brake system comprising...\",\n        \"The brake system of claim 1, wherein the brakes are disc brakes.\",\n        \"The brake system of claim 1, further comprising a hydraulic fluid reservoir.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69892", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-06-15\",\n    \"filing_date\": \"2018-02-20\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for enhanced image recognition using deep learning techniques. It addresses challenges in accurately identifying objects in complex scenes, improving performance in various applications such as autonomous driving and medical imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a deep learning model...\",\n        \"The system of claim 1, wherein...\",\n        \"The method of claim 2, further comprising...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69892", "text": "{\n    \"patent_title\": \"Improved Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2016-12-01\",\n    \"filing_date\": \"2017-03-10\",\n    \"issue_date\": \"2019-08-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel data compression algorithm that significantly reduces file sizes while maintaining data integrity. It utilizes advanced techniques to identify and eliminate redundancy in data streams.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related prior art in data compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data comprising...\",\n        \"A system for decompressing data...\",\n        \"The method of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69893", "text": "{\n    \"patent_title\": \"Method and System for AI-Powered Predictive Maintenance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method and system for predictive maintenance utilizing artificial intelligence algorithms to analyze sensor data and predict equipment failures. The system improves efficiency and reduces downtime.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for predicting equipment failure comprising...\",\n        \"A system for predictive maintenance comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69893", "text": "{\n    \"patent_title\": \"Novel Battery Technology for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2016-05-20\",\n    \"filing_date\": \"2016-05-20\",\n    \"issue_date\": \"2018-08-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new battery chemistry and cell design for electric vehicles, offering increased energy density and faster charging times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising...\",\n        \"A battery pack for an electric vehicle comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69894", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Thermal Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"QuantumScape\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery design incorporating a novel electrolyte and separator to improve thermal stability and prevent dendrite formation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7601547B2\",\n            \"title\": \"Lithium Ion Battery Electrolyte\"\n        },\n        {\n            \"patent_number\": \"US8124231B2\",\n            \"title\": \"Electrolyte Additive for Lithium-Ion Batteries\"\n        },\n        {\n            \"patent_number\": \"US8501296B2\",\n            \"title\": \"Separator for Lithium-Ion Batteries\"\n        },\n        {\n            \"patent_number\": \"US9214491B2\",\n            \"title\": \"Lithium-Ion Battery Cell Structure\"\n        },\n        {\n            \"patent_number\": \"US9556354B2\",\n            \"title\": \"Method for Manufacturing Lithium-Ion Batteries\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"The battery of claim 1, wherein the electrolyte comprises...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69894", "text": "{\n    \"patent_title\": \"Novel Polymer for Capacitors\",\n    \"inventors\": [\n        {\n            \"name\": \"Charles Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-05-20\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new polymer material with high dielectric constant for use in capacitors.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"High-K Dielectric Materials\"\n        },\n        {\n            \"patent_number\": \"US8456789B2\",\n            \"title\": \"Polymer Electrolytes for Capacitors\"\n        }\n    ],\n    \"claims\": [\n        \"A polymer material characterized by...\",\n        \"The polymer material of claim 1, wherein the dielectric constant is...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69895", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Processing in Autonomous Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-06-15\",\n    \"issue_date\": \"2018-01-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for enhancing image processing capabilities in autonomous vehicles, improving object detection and scene understanding for safer navigation. The system utilizes a novel algorithm for real-time image analysis, focusing on edge detection and feature extraction to improve the performance of autonomous driving systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Real-Time Object Detection System\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image processing...\",\n        \"A method for enhancing image quality...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69895", "text": "{\n    \"patent_title\": \"Medical Image Processing System for Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        }\n    ],\n    \"patent_number\": \"US9876544B2\",\n    \"priority_date\": \"2016-07-01\",\n    \"filing_date\": \"2016-08-01\",\n    \"issue_date\": \"2018-02-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a medical image processing system for the automated detection of tumors in MRI and CT scans. The system uses advanced algorithms to identify and classify suspicious regions, assisting radiologists in accurate diagnosis and treatment planning. The system’s core technology involves sophisticated image segmentation and pattern recognition techniques for medical applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765433B1\",\n            \"title\": \"Automated Tumor Segmentation\"\n        }\n    ],\n    \"claims\": [\n        \"A medical image processing system...\",\n        \"A method for detecting tumors...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69896", "text": "{\n    \"patent_title\": \"System and method for intelligent data analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2018-02-20\",\n    \"issue_date\": \"2020-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system and method for intelligent data analysis utilizing artificial intelligence algorithms to identify patterns and anomalies in large datasets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for analyzing data comprising...\",\n        \"A method for identifying patterns in data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69896", "text": "{\n    \"patent_title\": \"Improved battery charging circuit\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2019-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved battery charging circuit with enhanced efficiency and reduced heat generation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A battery charging circuit comprising...\",\n        \"A method for charging a battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69897", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-10\",\n    \"filing_date\": \"2015-06-20\",\n    \"issue_date\": \"2019-02-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel electrode materials for lithium-ion batteries, offering improved energy density and cycle life. The materials are based on a new composite structure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Lithium-Ion Battery Separators\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrode comprising...\",\n        \"The electrode of claim 1, wherein...\",\n        \"A method for manufacturing the electrode...\",\n        \"The method of claim 3, further comprising...\",\n        \"A lithium-ion battery cell incorporating the electrode...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69897", "text": "{\n    \"patent_title\": \"Solar Cell Efficiency Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10246813B1\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2015-01-05\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to methods for increasing the efficiency of solar cells using novel surface treatments. It doesn't relate to lithium-ion batteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Improved Solar Cell Designs\"\n        }\n    ],\n    \"claims\": [\n        \"A solar cell comprising...\",\n        \"The solar cell of claim 1, wherein...\",\n        \"A method for manufacturing the solar cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69898", "text": "{\n    \"patent_title\": \"High-Performance Lithium-Ion Battery with Novel Electrolyte\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery design incorporating a new electrolyte composition for enhanced performance and safety. The battery demonstrates improved energy density and cycle life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"The battery of claim 1, wherein...\",\n        \"An electrolyte composition for a lithium-ion battery...\",\n        \"A method of manufacturing...\",\n        \"The method of claim 4, wherein...\",\n        \"A device utilizing the battery of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69898", "text": "{\n    \"patent_title\": \"Improved Lead-Acid Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Exide Technologies\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Johnson Controls\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-01-05\",\n    \"filing_date\": \"2021-03-10\",\n    \"issue_date\": \"2023-04-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to improvements in lead-acid battery technology, specifically focusing on electrode design and separator materials.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A lead-acid battery comprising...\",\n        \"The battery of claim 1, wherein...\",\n        \"An electrode for a lead-acid battery...\",\n        \"A separator for a lead-acid battery...\",\n        \"A method of assembling the battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69899", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for remote monitoring applications. The system incorporates a MEMS pressure sensor, a low-power microcontroller, and a Bluetooth transceiver. It is designed for applications in healthcare, industrial monitoring, and environmental sensing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for remotely monitoring pressure using...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69899", "text": "{\n    \"patent_title\": \"Improved Battery Life for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-07-20\",\n    \"filing_date\": \"2017-07-19\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel power management technique for extending battery life in mobile devices. The system dynamically adjusts the clock speed and voltage based on the current workload. It results in significant power savings without compromising performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"cited\"\n        }\n    ],\n    \"claims\": [\n        \"A mobile device comprising...\",\n        \"A method for dynamically adjusting power consumption...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69900", "text": "{\n    \"patent_title\": \"Neural Network Based Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-02-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel system for image recognition utilizing a deep neural network architecture. The system achieves state-of-the-art accuracy on benchmark datasets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69900", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Caltech\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-15\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new battery technology utilizing advanced materials for increased energy density and cycle life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A battery comprising...\",\n        \"A method for manufacturing a battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69901", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Processing Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method and system for enhancing image processing capabilities using deep learning algorithms. The system utilizes convolutional neural networks to improve image quality, object detection, and image segmentation. The method involves preprocessing, feature extraction, and classification stages.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Enhancement Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image quality comprising:...\",\n        \"A system for processing images comprising:...\",\n        \"The method of claim 1, wherein the image is a medical image.\",\n        \"The system of claim 2, further comprising a display device.\",\n        \"The method of claim 1, wherein the deep learning algorithm is a convolutional neural network.\",\n        \"The system of claim 2, wherein the neural network is trained using a dataset of labeled images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69901", "text": "{\n    \"patent_title\": \"Novel Wireless Communication Protocol\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10293847B1\",\n    \"priority_date\": \"2017-09-01\",\n    \"filing_date\": \"2017-09-01\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel wireless communication protocol designed to improve data transmission efficiency and security. It incorporates advanced encryption methods and adaptive modulation techniques to enhance performance in challenging environments.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Wireless Communication System\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication system comprising...\",\n        \"A method for transmitting data wirelessly comprising...\",\n        \"The system of claim 1, wherein the encryption method is AES.\",\n        \"The method of claim 2, further comprising error correction.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69902", "text": "{\n    \"patent_title\": \"Method and System for Real-Time Image Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for real-time image enhancement using novel image processing algorithms. It improves image quality in various applications, including medical imaging and surveillance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image...\",\n        \"A system comprising a processor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69902", "text": "{\n    \"patent_title\": \"Improved Battery Charging Circuit\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"TechCorp Inc.\"\n        },\n        {\n            \"name\": \"David Davis\"\n        }\n    ],\n    \"patent_number\": \"US9876544B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved battery charging circuit that efficiently charges lithium-ion batteries. The circuit utilizes a novel control algorithm for optimal charging performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8999999B1\"\n        }\n    ],\n    \"claims\": [\n        \"A battery charging circuit comprising...\",\n        \"A control algorithm for charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69903", "text": "{\n    \"patent_title\": \"Method for Enhanced Image Recognition Using Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method for enhancing image recognition accuracy using convolutional neural networks and artificial intelligence algorithms. The system improves object detection in complex visual scenes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for object detection...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69903", "text": "{\n    \"patent_title\": \"System and Method for Personalized Education using AI\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11321456B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-11-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for providing personalized educational content to students using artificial intelligence to adapt to individual learning styles and paces.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123789B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for personalized education comprising...\",\n        \"A method for adaptive learning...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69904", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Detail Using Adaptive Filtering\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of Innovation\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for enhancing the detail in digital images using adaptive filtering techniques. The system analyzes image content to dynamically adjust filter parameters, resulting in improved clarity and sharpness. The core innovation lies in its ability to handle images with varying levels of noise and contrast.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8888888B1\",\n            \"relevance\": \"Background Art\"\n        },\n        {\n            \"patent_number\": \"US9999999B2\",\n            \"relevance\": \"Related Art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing the detail in a digital image comprising...\",\n        \"A system for processing digital images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69904", "text": "{\n    \"patent_title\": \"Medical Image Analysis System with Automated Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Medical Devices Ltd.\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"General Hospital\"\n        }\n    ],\n    \"patent_number\": \"US11111111B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-11-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for analyzing medical images to detect tumors. The invention uses advanced image processing techniques to identify potentially cancerous regions within MRI and CT scans, improving diagnostic accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7777777B2\",\n            \"relevance\": \"Medical Imaging Background\"\n        },\n        {\n            \"patent_number\": \"US8999999B1\",\n            \"relevance\": \"Related Medical Imaging Patent\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting tumors in medical images...\",\n        \"A medical image analysis system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69905", "text": "{\n    \"patent_title\": \"Wireless Temperature Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless temperature sensor system for industrial applications. The system uses low-power communication protocols to transmit temperature data to a central monitoring station. This allows for remote monitoring and control of temperature-sensitive processes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Wireless Communication System\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless temperature sensor comprising...\",\n        \"A system for monitoring temperature...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69905", "text": "{\n    \"patent_title\": \"Implantable Medical Sensor for Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Wilson\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2012-03-10\",\n    \"filing_date\": \"2012-03-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable medical sensor for continuous glucose monitoring in diabetic patients. The sensor provides real-time glucose levels and transmits data wirelessly to an external receiver. This enables improved diabetes management and reduces the need for frequent blood tests. It is specifically designed for medical applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Implantable Biosensor\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable glucose sensor comprising...\",\n        \"A method for monitoring glucose levels...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69906", "text": "{\n    \"patent_title\": \"Neural Network Based Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2021-11-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel image recognition system utilizing a deep neural network architecture. The system achieves high accuracy in classifying images and is applicable to various fields such as autonomous driving and medical diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"The system of claim 1, wherein the neural network is a convolutional neural network.\",\n        \"The system of claim 2, further comprising a preprocessing module.\",\n        \"A method for training a neural network...\",\n        \"The method of claim 4, wherein the training data is labeled.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69906", "text": "{\n    \"patent_title\": \"Method for Optimizing Database Queries\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2018-12-01\",\n    \"filing_date\": \"2020-03-20\",\n    \"issue_date\": \"2022-05-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a new method for optimizing database query performance by utilizing indexing techniques and query rewriting. It improves efficiency in data retrieval.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for optimizing database queries comprising...\",\n        \"The method of claim 1, wherein the indexing technique is a B-tree index.\",\n        \"The method of claim 2, further comprising a query rewriting module.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69907", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery with Enhanced Cycle Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved lithium-ion battery design incorporating a novel electrolyte and electrode materials. The battery exhibits significantly enhanced cycle life and improved energy density compared to existing lithium-ion batteries. The improved battery is suitable for electric vehicles and portable electronic devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"1. A lithium-ion battery comprising...\",\n        \"2. The battery of claim 1, wherein...\",\n        \"3. The battery of claim 1, further comprising...\",\n        \"4. An electrolyte composition for use in a lithium-ion battery...\",\n        \"5. A method of manufacturing a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69907", "text": "{\n    \"patent_title\": \"Novel Solar Cell Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-05-20\",\n    \"issue_date\": \"2018-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel design for a high-efficiency solar cell using perovskite materials. The solar cell demonstrates improved light absorption and conversion efficiency compared to conventional silicon-based solar cells.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"relevance\": \"Related Art\"\n        }\n    ],\n    \"claims\": [\n        \"1. A solar cell comprising...\",\n        \"2. The solar cell of claim 1, wherein...\",\n        \"3. A method of fabricating a solar cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69908", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for enhanced image processing, utilizing advanced algorithms for noise reduction and feature extraction. The invention significantly improves image clarity and detail in various applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Previous Image Processing Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image quality comprising...\",\n        \"A system for processing images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69908", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-05-20\",\n    \"issue_date\": \"2019-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery technology offering increased energy density and lifespan. The battery utilizes a new electrolyte composition.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Previous Battery Technology\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising...\",\n        \"An electrolyte composition for batteries...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69909", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Physiological Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2019-06-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized wireless sensor system for continuous monitoring of physiological parameters. The system comprises a flexible sensor, a low-power communication module, and a data processing unit. The sensor detects changes in blood pressure, temperature, and heart rate.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A sensor system comprising a flexible sensor...\",\n        \"The sensor system of claim 1, wherein the sensor is wireless.\",\n        \"The sensor system of claim 1, further comprising a data processing unit.\",\n        \"The sensor system of claim 2, wherein the sensor measures blood pressure.\",\n        \"The sensor system of claim 3, wherein the data processing unit transmits data via Bluetooth.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69909", "text": "{\n    \"patent_title\": \"Surgical Instrument with Improved Grip\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11321456B1\",\n    \"priority_date\": \"2019-02-10\",\n    \"filing_date\": \"2019-08-12\",\n    \"issue_date\": \"2021-03-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical instrument with an ergonomic grip designed for enhanced precision and reduced fatigue during long procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising an ergonomic grip...\",\n        \"The surgical instrument of claim 1, wherein the grip is coated with a non-slip material.\",\n        \"The surgical instrument of claim 1, further comprising a cutting blade.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69910", "text": "{\n    \"patent_title\": \"Neural Network Based Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel neural network architecture for robust image recognition. The system utilizes convolutional layers and recurrent neural networks to achieve high accuracy in various image classification tasks.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising: applying a convolutional neural network to an input image; generating a feature map; and classifying the image based on the feature map.\",\n        \"The method of claim 1, wherein the convolutional neural network comprises at least three convolutional layers.\",\n        \"A system for image recognition comprising: a memory storing a convolutional neural network; a processor configured to apply the convolutional neural network to an input image; and an output device for displaying a classification result.\",\n        \"The system of claim 3, wherein the convolutional neural network is trained using a dataset of labeled images.\",\n        \"The system of claim 3, wherein the processor is a GPU.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69910", "text": "{\n    \"patent_title\": \"Improved Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11890123B1\",\n    \"priority_date\": \"2020-03-01\",\n    \"filing_date\": \"2020-04-15\",\n    \"issue_date\": \"2021-10-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new data compression algorithm that achieves higher compression ratios than existing methods. The algorithm utilizes entropy encoding and adaptive dictionary techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising: receiving an input data stream; applying an entropy encoding scheme to the data stream; and generating a compressed data stream.\",\n        \"The method of claim 1, wherein the entropy encoding scheme is Huffman coding.\",\n        \"A system for data compression comprising: an encoder configured to apply an entropy encoding scheme to an input data stream; and a decoder configured to decode the compressed data stream.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69911", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Improved Electrolyte Composition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery design incorporating a new electrolyte composition for enhanced energy density and cycle life. The battery exhibits improved performance at high temperatures and reduced degradation over time. The invention offers a significant advancement in lithium-ion battery technology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related prior art in electrolyte formulations\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition for a lithium-ion battery...\",\n        \"A method of manufacturing a lithium-ion battery...\",\n        \"The battery of claim 1, wherein the electrolyte...\",\n        \"The battery of claim 2, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69911", "text": "{\n    \"patent_title\": \"Improved Lead-Acid Battery Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2010-12-01\",\n    \"filing_date\": \"2010-12-01\",\n    \"issue_date\": \"2018-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention pertains to an improved design for lead-acid batteries, focusing on enhancing electrode plate efficiency and reducing internal resistance. The battery demonstrates a longer lifespan and improved charge acceptance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"relevance\": \"Prior art in lead-acid battery electrodes\"\n        }\n    ],\n    \"claims\": [\n        \"A lead-acid battery comprising...\",\n        \"An electrode plate for a lead-acid battery...\",\n        \"A method of assembling a lead-acid battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69912", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor with Integrated Circuitry\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-14\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor utilizing integrated circuitry for remote monitoring applications. The sensor provides high accuracy and low power consumption.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"kind\": \"Cited by Applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A pressure sensor comprising...\",\n        \"The pressure sensor of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69912", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-12-10\",\n    \"filing_date\": \"2009-12-09\",\n    \"issue_date\": \"2018-11-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery technology offering increased energy density and lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B2\",\n            \"kind\": \"Cited by Examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising...\",\n        \"The battery cell of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69913", "text": "{\n    \"patent_title\": \"Wireless Sensor Network for Structural Health Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-06-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless sensor network for monitoring the structural integrity of bridges. The system utilizes low-power sensors to detect strain, vibration, and corrosion, providing real-time data for preventative maintenance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor network comprising...\",\n        \"A method for monitoring structural integrity...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69913", "text": "{\n    \"patent_title\": \"Implantable Medical Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876544B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-04-20\",\n    \"issue_date\": \"2019-02-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable medical sensor system for continuous glucose monitoring. The device utilizes a biocompatible sensor to measure glucose levels in real-time, transmitting data to an external receiver for medical diagnosis and treatment.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765433B1\",\n            \"relevance\": \"Prior art in medical sensors\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable sensor for glucose monitoring...\",\n        \"A system for transmitting glucose data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69914", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-06-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized wireless pressure sensor system is presented. The system incorporates a MEMS pressure sensor, a low-power transmitter, and a rechargeable battery. This invention enables remote monitoring of pressure in various applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Similar sensor technology\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for remote pressure monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69914", "text": "{\n    \"patent_title\": \"Improved Battery Life for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-04-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This patent describes a novel power management technique for extending battery life in mobile devices. The system optimizes energy consumption based on user activity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"Related power management techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A power management system for mobile devices...\",\n        \"A method for optimizing energy consumption...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69915", "text": "{\n    \"patent_title\": \"Surgical Instrument with Enhanced Precision Control\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-06-20\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a surgical instrument with a novel feedback control system designed to enhance precision during minimally invasive procedures. The system incorporates micro-sensors and actuators to provide real-time adjustments, minimizing tremor and improving surgical accuracy. Keywords: precision, surgical instrument, minimally invasive, control system, feedback.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Prior Art Surgical Tool\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising a sensor for detecting movement...\",\n        \"A control system for adjusting the instrument's position...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69915", "text": "{\n    \"patent_title\": \"Dental Implant System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Los Angeles\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2021-03-10\",\n    \"issue_date\": \"2022-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel dental implant system utilizing biocompatible materials and a streamlined insertion process. The implant design enhances osseointegration and provides a stable foundation for prosthetic teeth. Keywords: dental implant, osseointegration, biocompatible, prosthesis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Early Dental Implant Design\"\n        }\n    ],\n    \"claims\": [\n        \"A dental implant comprising a titanium alloy...\",\n        \"A surface treatment for enhancing osseointegration...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69916", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-06-15\",\n    \"filing_date\": \"2015-03-20\",\n    \"issue_date\": \"2018-05-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery technology utilizing a new electrolyte composition to improve energy density and lifespan in electric vehicles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A battery comprising a novel electrolyte composition...\",\n        \"The battery of claim 1, wherein the electrolyte composition...\",\n        \"An electric vehicle powered by the battery of claim 1...\",\n        \"A method of manufacturing the battery of claim 1...\",\n        \"The method of claim 4, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69916", "text": "{\n    \"patent_title\": \"Wireless Communication System\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2016-01-10\",\n    \"filing_date\": \"2016-04-05\",\n    \"issue_date\": \"2019-10-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless communication system employing advanced modulation techniques for improved data transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication system comprising a transmitter...\",\n        \"The system of claim 1, wherein the transmitter...\",\n        \"A receiver for receiving signals from the transmitter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69917", "text": "{\n    \"patent_title\": \"Image Noise Reduction Using Adaptive Filtering\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9784523B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for reducing noise in digital images using an adaptive filtering technique. The filter adapts to local image characteristics to effectively remove noise while preserving important image details.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8988521B2\",\n            \"title\": \"Wavelet-Based Image Denoising\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reducing noise in a digital image comprising...\",\n        \"A system for noise reduction...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69917", "text": "{\n    \"patent_title\": \"Method for Color Image Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-08-22\",\n    \"filing_date\": \"2017-08-22\",\n    \"issue_date\": \"2020-04-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method for enhancing the color fidelity of digital images. It adjusts color balance and saturation to improve visual appearance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9546872B2\",\n            \"title\": \"Adaptive Histogram Equalization\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing color in a digital image...\",\n        \"A system for improving image colors...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69918", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials and Methods\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Yet-Ming Chiang\",\n            \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-14\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel electrode materials for lithium-ion batteries, exhibiting improved energy density and cycle life. The materials are synthesized using a unique nano-structuring process. This significantly enhances the performance of lithium-ion batteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"1. A lithium-ion battery comprising...\",\n        \"2. The lithium-ion battery of claim 1, wherein...\",\n        \"3. An electrode material for a lithium-ion battery...\",\n        \"4. The electrode material of claim 3, wherein...\",\n        \"5. A method of manufacturing a lithium-ion battery...\",\n        \"6. The method of claim 5, wherein...\",\n        \"7. A device powered by the lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69918", "text": "{\n    \"patent_title\": \"Advanced Battery Cooling System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2012-05-10\",\n    \"filing_date\": \"2012-05-09\",\n    \"issue_date\": \"2018-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel cooling system for high-power batteries, improving thermal management and preventing overheating. It incorporates a phase-change material and a microfluidic network for efficient heat dissipation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"1. A battery cooling system comprising...\",\n        \"2. The battery cooling system of claim 1, wherein...\",\n        \"3. A method of cooling a battery...\",\n        \"4. The method of claim 3, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69919", "text": "{\n    \"patent_title\": \"AI-Powered Predictive Maintenance System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-04-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system for predictive maintenance using artificial intelligence and machine learning algorithms to analyze sensor data and predict equipment failures, reducing downtime and maintenance costs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predicting equipment failure comprising: a sensor network...\",\n        \"The system of claim 1, wherein the machine learning algorithm is a deep neural network.\",\n        \"A method for predicting equipment failure...\",\n        \"The method of claim 3, further comprising...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The computer-readable medium of claim 5...\",\n        \"An apparatus for...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69919", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2021-05-01\",\n    \"filing_date\": \"2021-06-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new lithium-ion battery design with improved energy density and cycle life. The battery utilizes a novel electrolyte composition to enhance performance and safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising: an anode...\",\n        \"The battery of claim 1, wherein the anode material is graphite.\",\n        \"A method for manufacturing a lithium-ion battery...\",\n        \"The method of claim 3, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69920", "text": "{\n    \"patent_title\": \"System and Method for Deep Learning-Based Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition using deep convolutional neural networks. The system includes a training module and an inference module.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760708\"\n        },\n        {\n            \"patent_number\": \"US9235456\"\n        },\n        {\n            \"patent_number\": \"US9341678\"\n        },\n        {\n            \"patent_number\": \"US9453890\"\n        },\n        {\n            \"patent_number\": \"US9568421\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a deep learning model...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69920", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"David Patterson\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US8765432\",\n    \"priority_date\": \"2015-07-20\",\n    \"filing_date\": \"2015-07-19\",\n    \"issue_date\": \"2018-12-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved algorithm for lossless data compression utilizing a novel entropy encoding technique.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321\"\n        },\n        {\n            \"patent_number\": \"US8543210\"\n        },\n        {\n            \"patent_number\": \"US8654321\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising...\",\n        \"A system for lossless data encoding...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69921", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery Electrode and Manufacturing Method\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Kenji Tanaka\",\n            \"affiliation\": \"Toyota Motor Corporation\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-05-15\",\n    \"filing_date\": \"2010-03-22\",\n    \"issue_date\": \"2019-07-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery electrode material comprising a composite of lithium metal oxide and carbon nanotubes. The material exhibits enhanced conductivity and cycle life. The invention also relates to a method for manufacturing said electrode.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrode comprising...\",\n        \"The electrode of claim 1, wherein...\",\n        \"A method for manufacturing...\",\n        \"The method of claim 3, further comprising...\",\n        \"A lithium-ion battery cell including...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69921", "text": "{\n    \"patent_title\": \"Improved Lead-Acid Battery Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Wilson\",\n            \"affiliation\": \"Exide Technologies\"\n        }\n    ],\n    \"patent_number\": \"US8123456B1\",\n    \"priority_date\": \"2008-11-01\",\n    \"filing_date\": \"2009-05-10\",\n    \"issue_date\": \"2012-03-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved design for a lead-acid battery, enhancing energy density and lifespan through a modified grid structure and electrolyte formulation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A lead-acid battery comprising...\",\n        \"The battery of claim 1, wherein...\",\n        \"An electrolyte formulation for...\",\n        \"A grid structure for...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69922", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Predictive Maintenance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of Innovation\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system and method for predicting equipment failure using artificial intelligence and machine learning algorithms. The system analyzes sensor data to identify patterns indicative of potential failures, enabling proactive maintenance and reducing downtime.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in predictive maintenance\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for predicting equipment failure comprising...\",\n        \"2. The system of claim 1, wherein the artificial intelligence algorithm...\",\n        \"3. A method for performing predictive maintenance...\",\n        \"4. The method of claim 3, further comprising...\",\n        \"5. The system of claim 1, wherein the sensor data comprises...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69922", "text": "{\n    \"patent_title\": \"Improved Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"DataTech Corp.\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2013-11-20\",\n    \"filing_date\": \"2013-11-20\",\n    \"issue_date\": \"2018-07-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved data compression algorithm that utilizes novel techniques to reduce file sizes without significant loss of data quality. It's applicable to various data types, including images, audio, and video.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related data compression techniques\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for compressing data...\",\n        \"2. The method of claim 1, wherein the compression ratio is...\",\n        \"3. A system for implementing the data compression method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69923", "text": "{\n    \"patent_title\": \"Novel Polymer Composites for High-Strength Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-15\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to novel polymer composites exhibiting enhanced strength and durability. The composites comprise a polymer matrix reinforced with carbon nanotubes, resulting in materials suitable for high-stress applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"kind\": \"Cited by Examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A composite material comprising a polymer matrix and carbon nanotubes.\",\n        \"The composite material of claim 1, wherein the polymer matrix is epoxy resin.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69923", "text": "{\n    \"patent_title\": \"Microfluidic Device for Cell Sorting\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Caltech\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"UCLA\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2012-05-10\",\n    \"filing_date\": \"2012-05-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for the rapid and efficient sorting of cells based on size and shape. The device utilizes a series of microchannels and inertial focusing to separate cells with high precision.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"kind\": \"Cited by Applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising a plurality of microchannels.\",\n        \"The microfluidic device of claim 1, further comprising an inlet and an outlet.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69924", "text": "{\n    \"patent_title\": \"Method for Enhanced Oil Recovery Using Nanoparticles\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-15\",\n    \"filing_date\": \"2014-05-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for enhancing oil recovery utilizing engineered nanoparticles to alter interfacial tension and improve oil displacement efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing oil recovery...\",\n        \"The method of claim 1, wherein the nanoparticles...\",\n        \"The method of claim 2, further comprising...\",\n        \"A composition comprising...\",\n        \"The composition of claim 4, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69924", "text": "{\n    \"patent_title\": \"System for Automated Crop Irrigation\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2012-03-10\",\n    \"filing_date\": \"2012-03-10\",\n    \"issue_date\": \"2016-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An automated system for precise crop irrigation based on real-time sensor data.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A system for automated crop irrigation...\",\n        \"The system of claim 1, comprising a sensor...\",\n        \"The system of claim 2, wherein the sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69925", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-14\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for image recognition using deep convolutional neural networks. The system utilizes a large labeled dataset for training and achieves state-of-the-art accuracy in identifying objects within images. The core technology involves novel architectures for convolutional layers and pooling operations.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321\"\n        },\n        {\n            \"patent_number\": \"US8123456\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\",\n        \"A computer-readable medium storing...\",\n        \"The method of claim 1, wherein...\",\n        \"The system of claim 2, wherein...\",\n        \"The computer-readable medium of claim 3, wherein...\",\n        \"The method of claim 4, wherein...\",\n        \"The system of claim 5, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69925", "text": "{\n    \"patent_title\": \"Method for Optimizing Database Queries\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876544\",\n    \"priority_date\": \"2012-05-20\",\n    \"filing_date\": \"2012-05-19\",\n    \"issue_date\": \"2020-02-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method for optimizing database queries, reducing response times, and improving overall database performance. It employs a novel indexing technique combined with query rewriting strategies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654322\"\n        }\n    ],\n    \"claims\": [\n        \"A method for optimizing a database query comprising...\",\n        \"A system for optimizing a database query comprising...\",\n        \"A computer-readable medium storing...\",\n        \"The method of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69926", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications. The system comprises a pressure sensor, a wireless transmitter, and a receiver.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\",\n            \"relevance\": \"Related prior art on wireless sensors\"\n        }\n    ],\n    \"claims\": [\n        \"A pressure sensor system comprising: a pressure sensing element; a wireless transmitter; and a receiver.\",\n        \"The system of claim 1, wherein the pressure sensor is a MEMS sensor.\",\n        \"The system of claim 1, further comprising a power source.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69926", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-01\",\n    \"issue_date\": \"2023-06-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved lithium-ion battery with increased energy density and cycle life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"relevance\": \"Related prior art on battery materials\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising: a cathode; an anode; and an electrolyte.\",\n        \"The battery of claim 1, wherein the cathode material is NMC.\",\n        \"The battery of claim 1, having an energy density of at least 250 Wh/kg.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69927", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized wireless pressure sensor system is disclosed. The system utilizes a MEMS pressure sensor and a low-power wireless transceiver for remote data acquisition. Applications include biomedical monitoring and industrial process control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for remote pressure monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69927", "text": "{\n    \"patent_title\": \"Improved Battery Life for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10246813B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a new power management technique for mobile devices, significantly extending battery life. The method optimizes processor utilization and reduces background data consumption.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for power management in a mobile device...\",\n        \"A system for optimizing battery life...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69928", "text": "{\n    \"patent_title\": \"High-Performance Lithium-Ion Battery with Enhanced Electrolyte\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a high-performance lithium-ion battery utilizing a novel electrolyte composition for improved energy density and cycle life. The battery is particularly suited for electric vehicle applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition for use in a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69928", "text": "{\n    \"patent_title\": \"Electric Vehicle Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Elon Musk\",\n            \"affiliation\": \"Tesla, Inc.\"\n        },\n        {\n            \"name\": \"James Chen\",\n            \"affiliation\": \"Tesla, Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-15\",\n    \"issue_date\": \"2018-03-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system for electric vehicles, optimizing lithium-ion battery performance and safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Cited as prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery performance...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69929", "text": "{\n    \"patent_title\": \"Improved Electrolyte Composition for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-07-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved electrolyte composition for lithium-ion batteries, enhancing energy density and cycle life. The composition includes a novel additive that stabilizes the solid electrolyte interphase (SEI). This improves battery performance in stationary power storage applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related prior art on SEI formation.\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrolyte composition...\",\n        \"The electrolyte composition according to claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69929", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-04-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) specifically designed for lithium-ion batteries used in electric vehicles.  The system optimizes charging and discharging profiles for extended range and safety. The BMS monitors cell voltage, current, and temperature to prevent overheating and ensure optimal performance in automotive applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art on electrolyte composition.\"\n        },\n        {\n            \"patent_number\": \"US20180012345A1\",\n            \"relevance\": \"Related prior art on EV battery control algorithms.\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for an electric vehicle...\",\n        \"The battery management system according to claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69930", "text": "{\n    \"patent_title\": \"AI-Powered Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2022-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an artificial intelligence system for image recognition. The system utilizes deep learning algorithms to accurately identify objects within images, with applications in autonomous vehicles and medical diagnostics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a deep learning model...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The system of claim 1, wherein the objects are vehicles.\",\n        \"The method of claim 2, wherein the deep learning model is a convolutional neural network.\",\n        \"The system of claim 1, further comprising a user interface.\",\n        \"The method of claim 2, wherein the training data is labeled.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69930", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-11-01\",\n    \"filing_date\": \"2020-12-10\",\n    \"issue_date\": \"2022-04-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new battery management system designed to improve efficiency and lifespan of lithium-ion batteries. It utilizes advanced control algorithms to optimize charging and discharging cycles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling battery charging...\",\n        \"A circuit for monitoring battery voltage...\",\n        \"The system of claim 1, wherein the battery is a lithium-ion battery.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69931", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"IBM Research\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the resolution of images using deep learning techniques. The system utilizes a convolutional neural network to upscale low-resolution images, resulting in improved visual quality. Applications include medical image analysis, surveillance, and general image processing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in image upscaling\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising...\",\n        \"A system for processing images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69931", "text": "{\n    \"patent_title\": \"Image Processing Techniques for Medical Diagnosis\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Stanford Hospital\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2021-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to novel image processing techniques used in medical diagnosis. Specifically, it details methods for identifying anomalies in X-ray images using computer vision algorithms. This is a critical advancement in image processing within the medical field.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related work in medical imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting anomalies in medical images...\",\n        \"A system for medical image analysis...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69932", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Predictive Maintenance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of Science\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for predictive maintenance utilizing artificial intelligence algorithms to analyze sensor data and predict potential equipment failures, reducing downtime and maintenance costs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11111111B1\",\n            \"title\": \"Prior Art Predictive Maintenance System\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predictive maintenance comprising...\",\n        \"A method for analyzing sensor data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69932", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking Mechanism\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Cycling Dynamics Corp.\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Independent Inventor\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2019-12-01\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-05-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents an improved bicycle braking mechanism with enhanced stopping power and modulation. It utilizes a novel lever design and pad material.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"title\": \"Conventional Bicycle Brake System\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle braking mechanism comprising...\",\n        \"A lever arm with enhanced ergonomic features...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69933", "text": "{\n    \"patent_title\": \"Image Recognition System Using Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition using deep neural networks. The system includes a convolutional neural network for feature extraction and a recurrent neural network for classification. The system is capable of accurately identifying objects in images with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for image recognition comprising...\",\n        \"2. The system of claim 1, wherein the neural network is a convolutional neural network.\",\n        \"3. The system of claim 2, wherein the convolutional neural network comprises...\",\n        \"4. The system of claim 1, wherein the neural network is a recurrent neural network.\",\n        \"5. The system of claim 1, further comprising a database...\",\n        \"6. A method for image recognition...\",\n        \"7. The method of claim 6, wherein the neural network is trained...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69933", "text": "{\n    \"patent_title\": \"Method for Data Compression Using Huffman Coding\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"IBM\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2014-12-10\",\n    \"filing_date\": \"2014-12-10\",\n    \"issue_date\": \"2018-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for data compression using Huffman coding. The method efficiently encodes data to reduce storage space and transmission bandwidth.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for data compression comprising...\",\n        \"2. The method of claim 1, wherein the data is encoded using Huffman coding.\",\n        \"3. The method of claim 1, further comprising a step of decoding...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69934", "text": "{\n    \"patent_title\": \"High-Density Lithium-Ion Battery for Mobile Phone Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Samsung Research America\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a high-density lithium-ion battery with improved energy storage capacity for use in portable electronic devices such as smartphones and laptops. The battery utilizes a novel electrolyte composition and a modified cathode material to enhance performance and lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8546062B2\",\n            \"relevance\": \"Related prior art on lithium-ion battery materials.\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising a cathode material...\",\n        \"An electrolyte composition for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69934", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a battery management system (BMS) specifically designed for lithium-ion batteries used in electric vehicles. The BMS optimizes battery performance, extends lifespan, and ensures safe operation in automotive applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Prior art on electric vehicle battery systems.\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for an electric vehicle...\",\n        \"A method for controlling charge and discharge of a lithium-ion battery in an electric vehicle...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69935", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Recognition Using Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-11-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for enhancing image recognition accuracy using deep neural networks. The system utilizes a novel architecture to improve feature extraction and classification, leading to more accurate and robust image recognition capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69935", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-09-01\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-12-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an improved algorithm for data compression, offering higher compression ratios and faster processing speeds.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Previous compression techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising...\",\n        \"A system for data compression comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69936", "text": "{\n    \"patent_title\": \"Improved Electrolyte for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved electrolyte composition for lithium-ion batteries, enhancing energy density and cycle life. The electrolyte includes a novel additive that stabilizes the solid electrolyte interphase (SEI) layer.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Lithium-Ion Battery with Polymer Electrolyte\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition comprising...\",\n        \"The electrolyte composition of claim 1, further comprising...\",\n        \"A method of manufacturing a lithium-ion battery...\",\n        \"The method of claim 3, wherein...\",\n        \"A device powered by the lithium-ion battery of claim 1\"\n    ]\n}"}
{"_id": "Academic--patents--n--69936", "text": "{\n    \"patent_title\": \"Advanced Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Kenji Tanaka\",\n            \"affiliation\": \"Toyota Motor Corporation\"\n        },\n        {\n            \"name\": \"Hiroshi Sato\",\n            \"affiliation\": \"Toyota Motor Corporation\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2010-12-01\",\n    \"filing_date\": \"2010-12-01\",\n    \"issue_date\": \"2017-11-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a battery management system for electric vehicles, improving safety and performance. The system monitors cell voltage, current, and temperature to optimize battery operation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Battery Monitoring System for Hybrid Vehicles\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method of monitoring battery performance...\",\n        \"The battery management system of claim 1, further comprising...\",\n        \"A control unit configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69937", "text": "{\n    \"patent_title\": \"High-Efficiency Silicon Heterojunction Solar Cells\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"National Renewable Energy Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel silicon heterojunction solar cell design achieving high efficiency through improved surface passivation and carrier collection. The cell structure incorporates a thin intrinsic amorphous silicon layer to minimize surface recombination losses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Improved Silicon Wafer Passivation Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A solar cell comprising...\",\n        \"A method for fabricating a solar cell...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69937", "text": "{\n    \"patent_title\": \"Flexible Perovskite Solar Cells for Wearable Electronics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10456789B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-02-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to flexible perovskite solar cells designed for integration into wearable electronic devices. A flexible substrate and encapsulation layer are used to protect the perovskite active layer from environmental degradation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Flexible Substrates for Electronic Devices\"\n        },\n        {\n            \"patent_number\": \"US8901234B1\",\n            \"title\": \"Perovskite Solar Cell Fabrication\"\n        }\n    ],\n    \"claims\": [\n        \"A flexible solar cell comprising...\",\n        \"A method for fabricating a flexible solar cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69938", "text": "{\n    \"patent_title\": \"AI-Powered Predictive Maintenance System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system for predictive maintenance utilizing artificial intelligence algorithms to analyze sensor data and predict equipment failures. The system improves operational efficiency and reduces downtime.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in sensor data analysis.\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predictive maintenance comprising...\",\n        \"A method for analyzing sensor data using AI...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69938", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"Princeton University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-01\",\n    \"issue_date\": \"2023-06-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel battery composition offering enhanced energy density and lifespan. It utilizes advanced material science principles for improved performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"relevance\": \"Related art in battery materials.\"\n        }\n    ],\n    \"claims\": [\n        \"A battery comprising a novel anode material...\",\n        \"A method for manufacturing a high-density battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69939", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-05-15\",\n    \"filing_date\": \"2010-03-01\",\n    \"issue_date\": \"2018-01-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel data compression algorithm that significantly reduces file sizes while maintaining data integrity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"Prior art in data compression.\"\n        },\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"relevance\": \"Related technique for lossless compression.\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Alternative compression method.\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Similar approach to data reduction.\"\n        },\n        {\n            \"patent_number\": \"US9543210B1\",\n            \"relevance\": \"Advancement in information theory.\"\n        },\n        {\n            \"patent_number\": \"US10234567B2\",\n            \"relevance\": \"Related work on data encoding.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data comprising...\",\n        \"A system for data compression utilizing...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69939", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"David Smith\",\n            \"affiliation\": \"CycleTech Solutions\"\n        }\n    ],\n    \"patent_number\": \"US8765432B2\",\n    \"priority_date\": \"2011-08-10\",\n    \"filing_date\": \"2012-02-15\",\n    \"issue_date\": \"2016-06-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A braking system for bicycles that provides enhanced stopping power and control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"Previous braking system designs.\"\n        },\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"relevance\": \"Related technology in vehicle braking.\"\n        },\n        {\n            \"patent_number\": \"US8234567B1\",\n            \"relevance\": \"Different braking mechanism.\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle braking system comprising...\",\n        \"A braking lever adapted for...\",\n        \"A caliper assembly configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69940", "text": "{\n    \"patent_title\": \"System and method for image recognition using deep convolutional neural networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition utilizing deep convolutional neural networks to identify objects within images. The system includes a training module, an inference module, and a database of labeled images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Classification System\"\n        },\n        {\n            \"patent_number\": \"US9000001B2\",\n            \"title\": \"Convolutional Neural Network Architecture\"\n        },\n        {\n            \"patent_number\": \"US9234567B1\",\n            \"title\": \"Deep Learning for Image Analysis\"\n        },\n        {\n            \"patent_number\": \"US9567890B2\",\n            \"title\": \"Object Detection with CNNs\"\n        },\n        {\n            \"patent_number\": \"US9789012B1\",\n            \"title\": \"Image Segmentation using Deep Networks\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for identifying objects in an image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69940", "text": "{\n    \"patent_title\": \"Method for compressing images using wavelet transforms\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2018-11-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for efficiently compressing images using wavelet transforms, reducing storage space and transmission bandwidth.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"title\": \"Wavelet-Based Image Compression\"\n        },\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Lossy Image Compression Techniques\"\n        },\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"title\": \"Adaptive Wavelet Compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image comprising...\",\n        \"An apparatus for applying wavelet transforms...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69941", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-11-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel lithium-ion battery with improved thermal stability and cycle life. The battery incorporates a new electrolyte formulation and a modified electrode structure to enhance performance and safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art related to electrolyte compositions\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte formulation for a lithium-ion battery...\",\n        \"A method of manufacturing a lithium-ion battery...\",\n        \"The battery of claim 1, wherein the electrolyte comprises...\",\n        \"The method of claim 3, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69941", "text": "{\n    \"patent_title\": \"Advanced Solid-State Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2019-08-01\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a solid-state battery utilizing a ceramic electrolyte and novel electrode materials for high energy density applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"relevance\": \"Related to ceramic electrolyte materials\"\n        }\n    ],\n    \"claims\": [\n        \"A solid-state battery comprising...\",\n        \"A ceramic electrolyte for a solid-state battery...\",\n        \"A method of assembling a solid-state battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69942", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Qualcomm Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for enhancing wireless communication efficiency through adaptive modulation and coding. The system utilizes advanced signal processing techniques to mitigate interference and improve data throughput.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art relating to modulation techniques.\"\n        }\n    ],\n    \"claims\": [\n        \"A system for wireless communication comprising...\",\n        \"A method for adaptive modulation and coding...\",\n        \"A device for mitigating interference in a wireless network...\",\n        \"The system of claim 1, wherein...\",\n        \"The method of claim 2, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69942", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2011-05-10\",\n    \"filing_date\": \"2011-05-10\",\n    \"issue_date\": \"2018-11-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved battery management system for electric vehicles. The system enhances battery life and safety through advanced charge control algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"relevance\": \"Related prior art on battery charge controllers.\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling battery charge...\",\n        \"A device for monitoring battery health...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69943", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Improved Thermal Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9783456B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a lithium-ion battery with enhanced thermal stability achieved through a novel electrolyte composition and cell design. The improved thermal properties reduce the risk of thermal runaway and enhance battery safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8546052B2\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69943", "text": "{\n    \"patent_title\": \"Advanced Nickel-Metal Hydride Battery Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-01-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel design for a nickel-metal hydride battery with improved energy density and cycle life. The battery utilizes a new electrode material and optimized cell structure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A nickel-metal hydride battery comprising...\",\n        \"An electrode material for a nickel-metal hydride battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69944", "text": "{\n    \"patent_title\": \"Improved Electrolyte Composition for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel electrolyte composition for lithium-ion batteries, enhancing their energy density and cycle life. The composition includes a lithium salt, a solvent mixture, and an additive that improves the stability of the solid electrolyte interphase.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8758843B2\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69944", "text": "{\n    \"patent_title\": \"Advanced Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Elon Musk\",\n            \"affiliation\": \"Tesla, Inc.\"\n        },\n        {\n            \"name\": \"James Chen\",\n            \"affiliation\": \"Tesla, Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10456789B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-15\",\n    \"issue_date\": \"2020-02-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) for electric vehicles is disclosed, incorporating advanced algorithms for cell balancing, thermal management, and state of charge estimation. This BMS optimizes the performance and lifespan of lithium-ion battery packs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9546421B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling a lithium-ion battery pack...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69945", "text": "{\n    \"patent_title\": \"High-Efficiency Perovskite Solar Cell with Improved Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"National Renewable Energy Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel perovskite solar cell architecture is disclosed, demonstrating a power conversion efficiency of 25.2% and improved long-term stability under continuous illumination. The device incorporates a modified electron transport layer to mitigate degradation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Perovskite Solar Cell with Enhanced Light Absorption\"\n        }\n    ],\n    \"claims\": [\n        \"A perovskite solar cell comprising...\",\n        \"An electron transport layer...\",\n        \"A method of fabricating a perovskite solar cell...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69945", "text": "{\n    \"patent_title\": \"Improved Silicon Solar Cell Design\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"SunPower Corp.\"\n        },\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"SunPower Corp.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved silicon solar cell design utilizing a textured front surface and passivated rear contact is described. This design results in a significant increase in light trapping and carrier collection efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Textured Silicon Solar Cell\"\n        }\n    ],\n    \"claims\": [\n        \"A silicon solar cell comprising...\",\n        \"A textured front surface...\",\n        \"A passivated rear contact...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69946", "text": "{\n    \"patent_title\": \"Deep Learning for Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-11-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep learning system for image recognition utilizes convolutional neural networks to achieve state-of-the-art accuracy. The system incorporates machine learning algorithms for feature extraction and classification.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69946", "text": "{\n    \"patent_title\": \"Robotics Control System\",\n    \"inventors\": [\n        {\n            \"name\": \"Rodney Brooks\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-08-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A control system for robots utilizing sensor feedback and adaptive algorithms to navigate complex environments. The system incorporates robotic kinematics and dynamic modelling.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic control system comprising...\",\n        \"A method for robot navigation...\",\n        \"A sensor feedback loop for robotic control...\",\n        \"A dynamic model for robot movement...\",\n        \"An adaptive algorithm for robot behavior...\",\n        \"A kinematic model of the robot...\",\n        \"A method for processing sensor data...\",\n        \"A system for obstacle avoidance...\",\n        \"A control interface for robot operation...\",\n        \"A safety mechanism for robot control...\",\n        \"A method for calibrating robot sensors...\",\n        \"A system for remote robot control...\",\n        \"An algorithm for optimizing robot performance...\",\n        \"A method for simulating robot behavior...\",\n        \"A control system for multiple robots...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69947", "text": "{\n    \"patent_title\": \"Neural Network Based Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image recognition system utilizing a deep neural network architecture for accurate and efficient object detection. The system improves upon existing methods by employing a convolutional neural network with multiple layers and a specialized training algorithm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Image Recognition Using Support Vector Machines\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"An image recognition system comprising...\",\n        \"A neural network architecture...\",\n        \"A training algorithm...\",\n        \"A computer-readable medium...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69947", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2010-12-01\",\n    \"filing_date\": \"2010-12-01\",\n    \"issue_date\": \"2018-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new algorithm for compressing digital data, achieving higher compression ratios and faster processing speeds. It utilizes a combination of Huffman coding and Lempel-Ziv techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B2\",\n            \"title\": \"Data Compression Using Huffman Coding\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression...\",\n        \"A data compression system...\",\n        \"An encoding algorithm...\",\n        \"A decoding algorithm...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69948", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Processing using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-06-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method and system for enhanced image processing utilizing deep learning algorithms. The system is capable of real-time image analysis and feature extraction, improving image quality and accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Prior Art Image Processing Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing an image comprising...\",\n        \"A system for enhancing image quality...\",\n        \"A computer-readable medium...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69948", "text": "{\n    \"patent_title\": \"Novel Display Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2017-03-10\",\n    \"filing_date\": \"2017-04-10\",\n    \"issue_date\": \"2020-02-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a new display technology with improved color accuracy and energy efficiency. It involves novel pixel arrangements and control mechanisms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Existing Display Technology\"\n        }\n    ],\n    \"claims\": [\n        \"A display device comprising...\",\n        \"A pixel arrangement...\",\n        \"A control system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69949", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system and method for image recognition using artificial intelligence and deep learning algorithms. The system utilizes convolutional neural networks to analyze images and identify objects with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Processing System\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for analyzing images using deep learning...\",\n        \"A computer-readable medium storing instructions for...\",\n        \"The system of claim 1, wherein the deep learning algorithm is a convolutional neural network.\",\n        \"The method of claim 2, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69949", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2018-11-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved braking system for bicycles, enhancing stopping power and rider safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Disc Brake Assembly\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle brake system comprising...\",\n        \"A brake lever configured to...\",\n        \"A braking mechanism adapted to...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69950", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"MIT Lincoln Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US10526347B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-01-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved electrode material for lithium-ion batteries, enhancing energy density and cycle life. The material comprises a novel composite structure with enhanced lithium ion conductivity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art on lithium-ion battery electrolytes\"\n        }\n    ],\n    \"claims\": [\n        \"1. A lithium-ion battery electrode material comprising...\",\n        \"2. The electrode material of claim 1, wherein...\",\n        \"3. A lithium-ion battery comprising the electrode material of claim 1...\",\n        \"4. A method of manufacturing the electrode material...\",\n        \"5. The method of claim 4, wherein...\",\n        \"6. An electronic device comprising...\",\n        \"7. The electronic device of claim 6...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69950", "text": "{\n    \"patent_title\": \"Novel Solar Cell Design\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new design for high-efficiency solar cells utilizing perovskite materials. It addresses issues of stability and cost-effectiveness.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Prior art on perovskite solar cell structures.\"\n        }\n    ],\n    \"claims\": [\n        \"1. A solar cell comprising...\",\n        \"2. The solar cell of claim 1, wherein...\",\n        \"3. A method for fabricating the solar cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69951", "text": "{\n    \"patent_title\": \"Deep Learning for Enhanced Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Chen\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Lee\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10246789B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a deep learning system for improved image recognition accuracy, particularly in challenging conditions. The system utilizes convolutional neural networks and novel training algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"An apparatus for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69951", "text": "{\n    \"patent_title\": \"Novel Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Diana Wilson\",\n            \"affiliation\": \"IBM Research\"\n        }\n    ],\n    \"patent_number\": \"US11123456B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2021-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new algorithm for lossless data compression is described. The algorithm significantly reduces file sizes while maintaining data integrity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising...\",\n        \"A system for data compression comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69952", "text": "{\n    \"patent_title\": \"Wireless Power Transfer System and Method\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless power transfer system employing resonant inductive coupling for efficient charging of electronic devices. The system includes a transmitter and a receiver, optimized for maximizing power transfer efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8552521B2\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless power transfer system comprising...\",\n        \"A method for wirelessly charging a device...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69952", "text": "{\n    \"patent_title\": \"Advanced Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        },\n        {\n            \"name\": \"Eve Wilson\",\n            \"affiliation\": \"Georgia Tech\"\n        }\n    ],\n    \"patent_number\": \"US10245879B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2019-12-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles, enhancing battery life and safety through advanced algorithms and temperature control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery performance...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69953", "text": "{\n    \"patent_title\": \"AI-Powered Predictive Maintenance System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an artificial intelligence-powered system for predicting equipment failures in industrial settings. The system utilizes machine learning algorithms to analyze sensor data and identify patterns indicative of impending maintenance needs, reducing downtime and costs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\",\n            \"title\": \"Predictive Maintenance Using Sensor Data\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predicting equipment failures comprising...\",\n        \"A method for analyzing sensor data using machine learning...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The system of claim 1, wherein the machine learning algorithm is a neural network.\",\n        \"The method of claim 2, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69953", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Local Bike Shop\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2019-08-01\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2021-10-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved bicycle braking system utilizing a novel cable tensioning mechanism for enhanced stopping power and rider control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"title\": \"Bicycle Brake System with Enhanced Modulation\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle braking system comprising...\",\n        \"A cable tensioning mechanism for adjusting braking force.\",\n        \"A brake lever configured to activate the braking system.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69954", "text": "{\n    \"patent_title\": \"Deep Learning System for Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2018-03-01\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a deep learning system for image recognition utilizing convolutional neural networks and artificial intelligence techniques. The system achieves state-of-the-art accuracy in object detection and classification.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\"\n        },\n        {\n            \"patent_number\": \"US7654321B1\"\n        },\n        {\n            \"patent_number\": \"US6543210B2\"\n        },\n        {\n            \"patent_number\": \"US5432109B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a deep learning model...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69954", "text": "{\n    \"patent_title\": \"Improved Method for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2018-05-10\",\n    \"filing_date\": \"2018-08-15\",\n    \"issue_date\": \"2020-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel data compression algorithm achieving high compression ratios. It utilizes a combination of Huffman coding and Lempel-Ziv techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US99887766B2\"\n        },\n        {\n            \"patent_number\": \"US88776655B1\"\n        },\n        {\n            \"patent_number\": \"US77665544B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising...\",\n        \"A system for encoding data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69955", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications. The sensor utilizes MEMS technology to detect pressure changes and transmits data wirelessly. This invention relates to a novel method for calibrating the sensor and improving its accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"1. A pressure sensor system comprising...\",\n        \"2. The system of claim 1, wherein...\",\n        \"3. The system of claim 2, further comprising...\",\n        \"4. A method for calibrating a pressure sensor...\",\n        \"5. The method of claim 4, wherein...\",\n        \"6. The method of claim 5, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69955", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-08-10\",\n    \"filing_date\": \"2017-08-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved lithium-ion battery technology for electric vehicles, increasing energy density and lifespan. The invention involves a new electrolyte composition and electrode materials.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"1. A lithium-ion battery comprising...\",\n        \"2. The battery of claim 1, wherein...\",\n        \"3. The battery of claim 2, further comprising...\",\n        \"4. An electrolyte composition for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69956", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized wireless pressure sensor system for use in medical implants. The system includes a pressure sensor, a wireless communication module, and a power management unit. The abstract details the improved sensitivity of this sensor.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A pressure sensor system comprising...\",\n        \"A wireless communication module for transmitting pressure data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69956", "text": "{\n    \"patent_title\": \"Improved Optical Flow Sensor\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-22\",\n    \"filing_date\": \"2017-03-22\",\n    \"issue_date\": \"2018-07-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved optical flow sensor for autonomous vehicles. The sensor utilizes a novel algorithm for accurate motion estimation. The abstract details the use of machine learning within the sensor.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"An optical flow sensor comprising...\",\n        \"A motion estimation algorithm for processing image data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69957", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-06-15\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a miniature wireless pressure sensor system for monitoring various applications. The system utilizes a MEMS pressure sensor and a low-power wireless communication module.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system...\",\n        \"The system of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69957", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2018-02-20\",\n    \"filing_date\": \"2018-03-20\",\n    \"issue_date\": \"2021-01-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery management system for electric vehicles, enhancing battery life and safety.  The system incorporates advanced algorithms for charge control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system...\",\n        \"The system of claim 1, wherein the...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69958", "text": "{\n    \"patent_title\": \"System and Method for Image Recognition Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition using deep convolutional neural networks. The system is capable of accurately identifying objects within images and providing a confidence level for each identification.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for image recognition comprising...\",\n        \"2. The system of claim 1, wherein...\",\n        \"3. A method for image recognition comprising...\",\n        \"4. The method of claim 3, wherein...\",\n        \"5. The system of claim 1, further comprising...\",\n        \"6. The method of claim 3, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69958", "text": "{\n    \"patent_title\": \"Method for Enhanced Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2017-01-10\",\n    \"filing_date\": \"2017-01-09\",\n    \"issue_date\": \"2020-11-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for data compression using a wavelet transform. This method provides improved compression ratios and faster processing times.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for data compression comprising...\",\n        \"2. The method of claim 1, wherein...\",\n        \"3. A system for data compression comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69959", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Segmentation\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for image segmentation using deep convolutional neural networks is presented. This system significantly improves the accuracy of identifying objects within images, particularly in challenging conditions. This enhances image processing applications in medical imaging and autonomous vehicles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Recognition System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for segmenting images comprising...\",\n        \"A system for image segmentation...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69959", "text": "{\n    \"patent_title\": \"Improved Image Processing Techniques\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-02-29\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to methods and systems for processing digital images. The techniques described herein improve image clarity and reduce noise, utilizing a novel filtering algorithm. Advanced image processing is applied to enhance various applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Method and System for Enhanced Image Segmentation\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing digital images...\",\n        \"A system for improving image clarity...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69960", "text": "{\n    \"patent_title\": \"Method and System for Optimized Neural Network Training\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for optimizing the training of neural networks using a novel adaptive learning rate algorithm. The system utilizes distributed computing to accelerate the training process and achieves improved accuracy compared to existing methods. This invention leverages a deep neural network architecture to analyze complex data patterns.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for training a neural network...\",\n        \"A system for optimizing neural network parameters...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69960", "text": "{\n    \"patent_title\": \"Improved Image Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image compression algorithm that achieves higher compression ratios with minimal loss of image quality. The algorithm utilizes wavelet transforms and quantization techniques. This improves performance in applications requiring efficient image transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"An image compression method...\",\n        \"A system for compressing images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69961", "text": "{\n    \"patent_title\": \"Method and System for Efficient Neural Network Training\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for training neural networks with improved efficiency and reduced computational cost. The invention utilizes a distributed training architecture and adaptive learning rate optimization.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for training a neural network...\",\n        \"A system comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69961", "text": "{\n    \"patent_title\": \"Improved Image Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2019-11-20\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2021-04-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An innovative image compression algorithm that achieves higher compression ratios while maintaining acceptable image quality. The invention employs a wavelet transform and entropy coding.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image...\",\n        \"An apparatus for...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69962", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for image recognition utilizing artificial intelligence techniques, specifically convolutional neural networks. The system achieves high accuracy in identifying objects within images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69962", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-11-01\",\n    \"filing_date\": \"2009-11-01\",\n    \"issue_date\": \"2012-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved bicycle brake system featuring enhanced stopping power and durability. The system uses a novel cable tensioning mechanism.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A bicycle brake system comprising...\",\n        \"A cable tensioning mechanism...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69963", "text": "{\n    \"patent_title\": \"Method and system for image enhancement using deep learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-06-20\",\n    \"issue_date\": \"2021-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for enhancing image quality using convolutional neural networks. The system utilizes a multi-stage approach to reduce noise and improve clarity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image comprising...\",\n        \"The method of claim 1, wherein the neural network is a convolutional neural network.\",\n        \"A system for enhancing an image comprising...\",\n        \"The system of claim 3, further comprising...\",\n        \"Claim 5\",\n        \"Claim 6\"\n    ]\n}"}
{"_id": "Academic--patents--n--69963", "text": "{\n    \"patent_title\": \"Apparatus for controlling fluid flow in microfluidic devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-05-22\",\n    \"filing_date\": \"2019-08-10\",\n    \"issue_date\": \"2020-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for precise control of fluid flow, utilizing electrostatic forces.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"An apparatus for controlling fluid flow comprising...\",\n        \"The apparatus of claim 1, wherein the electrostatic force is controlled by...\",\n        \"A method for controlling fluid flow comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69964", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction for PET Scanners\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method for improving image reconstruction in Positron Emission Tomography (PET) scanners, leading to higher resolution and reduced noise.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Prior Art PET Reconstruction Method\"\n        },\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"title\": \"Advanced Statistical Iteration\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Attenuation Correction Techniques\"\n        },\n        {\n            \"patent_number\": \"US8901234B1\",\n            \"title\": \"Motion Correction in PET\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Time-of-Flight PET\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an image...\",\n        \"The method of claim 1, wherein...\",\n        \"A PET scanner comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69964", "text": "{\n    \"patent_title\": \"Novel Surgical Instrument for Minimally Invasive Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Carol Davis\",\n            \"affiliation\": \"Acme Medical Devices Inc.\"\n        },\n        {\n            \"name\": \"Dr. David Miller\",\n            \"affiliation\": \"Acme Medical Devices Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-10\",\n    \"filing_date\": \"2017-03-10\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a surgical instrument designed for performing minimally invasive procedures with increased precision and dexterity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8654321B2\",\n            \"title\": \"Existing Surgical Instrument Design\"\n        },\n        {\n            \"patent_number\": \"US9102345B1\",\n            \"title\": \"Articulating Surgical Tools\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising...\",\n        \"The surgical instrument of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69965", "text": "{\n    \"patent_title\": \"Method and System for AI-Powered Predictive Maintenance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"TechCorp Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of Innovation\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for predictive maintenance using artificial intelligence and machine learning algorithms to analyze sensor data and predict equipment failures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related prior art\"\n        },\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"relevance\": \"Background technology\"\n        },\n        {\n            \"patent_number\": \"US9234567B1\",\n            \"relevance\": \"Similar approach\"\n        },\n        {\n            \"patent_number\": \"US9345678B2\",\n            \"relevance\": \"Relevant art\"\n        },\n        {\n            \"patent_number\": \"US9456789B1\",\n            \"relevance\": \"Related work\"\n        },\n        {\n            \"patent_number\": \"US9567890B2\",\n            \"relevance\": \"Background information\"\n        },\n        {\n            \"patent_number\": \"US9678901B1\",\n            \"relevance\": \"Prior art\"\n        },\n        {\n            \"patent_number\": \"US9789012B2\",\n            \"relevance\": \"Relevant context\"\n        },\n        {\n            \"patent_number\": \"US9890123B1\",\n            \"relevance\": \"Comparable technology\"\n        },\n        {\n            \"patent_number\": \"US9901234B2\",\n            \"relevance\": \"Related system\"\n        },\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"Background concept\"\n        }\n    ],\n    \"claims\": [\n        \"A method for predictive maintenance comprising...\",\n        \"A system for analyzing sensor data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69965", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Energy Solutions Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-01-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents an improved battery management system for electric vehicles, focusing on thermal regulation and charge control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B1\",\n            \"relevance\": \"Prior art in battery technology\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related battery management techniques\"\n        },\n        {\n            \"patent_number\": \"US9345678B1\",\n            \"relevance\": \"Background in thermal management\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling battery charge...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69966", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2014-05-15\",\n    \"filing_date\": \"2015-02-20\",\n    \"issue_date\": \"2023-12-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for remote monitoring applications. The sensor utilizes MEMS technology and transmits data via Bluetooth. This invention improves upon existing sensor designs by offering reduced size and enhanced power efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising...\",\n        \"A system for remote monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69966", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Caltech\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2016-03-10\",\n    \"filing_date\": \"2017-01-05\",\n    \"issue_date\": \"2024-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery design featuring increased energy density and improved cycle life. The battery utilizes a new electrolyte material and a unique cell architecture.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising...\",\n        \"A method for manufacturing...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69967", "text": "{\n    \"patent_title\": \"Improved Image Reconstruction for MRI\",\n    \"inventors\": [\n        {\n            \"name\": \"David Jones\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emily Chen\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-06-15\",\n    \"issue_date\": \"2021-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method for improving image reconstruction in Magnetic Resonance Imaging (MRI), leading to faster scan times and improved image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"An MRI system configured to perform the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69967", "text": "{\n    \"patent_title\": \"Enhanced X-Ray Detection System\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Jessica Brown\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2018-03-10\",\n    \"filing_date\": \"2018-04-10\",\n    \"issue_date\": \"2020-12-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved X-ray detection system with enhanced sensitivity and reduced noise.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray detection system comprising...\",\n        \"A method for detecting X-rays using the system of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69968", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications. The system incorporates a highly sensitive MEMS pressure sensor, a low-power wireless transceiver, and a biocompatible housing. The sensor data is transmitted wirelessly to a remote monitoring station.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A pressure sensor system comprising...\",\n        \"The system of claim 1, wherein...\",\n        \"A method for measuring pressure...\",\n        \"The method of claim 3, further comprising...\",\n        \"A wireless communication module...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69968", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery with enhanced energy density and cycle life. The battery utilizes a new electrolyte formulation and a modified electrode structure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"cited\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"The battery of claim 1, wherein...\",\n        \"An electrolyte formulation...\",\n        \"A method for manufacturing...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69969", "text": "{\n    \"patent_title\": \"Method and System for Adaptive Neural Network Training\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-14\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for adaptively training a neural network, improving convergence speed and accuracy by dynamically adjusting learning rates based on gradient information. The system utilizes a novel regularization technique to prevent overfitting.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A method for training a neural network...\",\n        \"A system comprising a processor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69969", "text": "{\n    \"patent_title\": \"Improved Image Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10246813B1\",\n    \"priority_date\": \"2010-12-01\",\n    \"filing_date\": \"2010-12-01\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved image compression algorithm based on wavelet transforms and entropy coding.  The algorithm achieves higher compression ratios with minimal loss of image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image...\",\n        \"A system for decoding a compressed image...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69970", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-06-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for enhancing image processing quality, specifically focusing on noise reduction and edge detection in digital images. It utilizes a novel filtering algorithm for improved clarity and detail.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8654321B1\",\n            \"title\": \"Image Filtering Techniques\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Edge Detection Algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image quality comprising...\",\n        \"A system for processing digital images...\",\n        \"The method of claim 1, wherein the filtering algorithm...\",\n        \"The system of claim 2, further comprising...\",\n        \"The method of claim 3, utilizing adaptive filtering parameters...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69970", "text": "{\n    \"patent_title\": \"Medical Image Reconstruction System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Medical Devices Corp.\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-01\",\n    \"filing_date\": \"2017-04-10\",\n    \"issue_date\": \"2019-05-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a system for reconstructing medical images from CT scans, utilizing advanced algorithms for improved diagnostic accuracy. The system provides detailed visualizations of anatomical structures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"CT Scan Reconstruction Techniques\"\n        },\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Image Filtering Techniques for Medical Images\"\n        }\n    ],\n    \"claims\": [\n        \"A system for reconstructing medical images comprising...\",\n        \"A method for processing CT scan data...\",\n        \"The system of claim 1, wherein the reconstruction algorithm...\",\n        \"The method of claim 2, using noise reduction techniques...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69971", "text": "{\n    \"patent_title\": \"System and method for improved image recognition using deep learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-03-15\",\n    \"filing_date\": \"2015-06-20\",\n    \"issue_date\": \"2019-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for improving the accuracy of image recognition using deep learning techniques.  The system utilizes a novel convolutional neural network architecture to achieve state-of-the-art results.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image recognition using convolutional neural networks\"\n        },\n        {\n            \"patent_number\": \"US9000001B2\",\n            \"title\": \"Deep learning for object detection\"\n        },\n        {\n            \"patent_number\": \"US9234567B1\",\n            \"title\": \"Improved training methods for deep neural networks\"\n        },\n        {\n            \"patent_number\": \"US9345678B2\",\n            \"title\": \"Real-time image recognition system\"\n        },\n        {\n            \"patent_number\": \"US9456789B1\",\n            \"title\": \"Robust image recognition with adversarial training\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for improving the accuracy of image recognition...\",\n        \"The system of claim 1, wherein the neural network is a convolutional neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69971", "text": "{\n    \"patent_title\": \"Novel Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2016-05-01\",\n    \"filing_date\": \"2017-02-15\",\n    \"issue_date\": \"2020-07-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new type of battery with improved energy density and lifespan. This invention utilizes a novel electrolyte material.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8888888B2\",\n            \"title\": \"Lithium-ion battery improvements\"\n        },\n        {\n            \"patent_number\": \"US9999999B1\",\n            \"title\": \"Solid-state battery technology\"\n        }\n    ],\n    \"claims\": [\n        \"A battery comprising...\",\n        \"The battery of claim 1, wherein the electrolyte material is...\",\n        \"A method for manufacturing the battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69972", "text": "{\n    \"patent_title\": \"Method and System for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for image recognition utilizing artificial intelligence algorithms. The system analyzes image data to identify objects and patterns with high accuracy.  This enables applications in autonomous vehicles and medical diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image analysis including...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69972", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US9876542B2\",\n    \"priority_date\": \"2015-12-15\",\n    \"filing_date\": \"2015-12-14\",\n    \"issue_date\": \"2019-01-29\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved bicycle brake system featuring enhanced stopping power and durability.  The system utilizes a novel lever design and friction material.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle brake system comprising...\",\n        \"A lever assembly for a bicycle brake...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69973", "text": "{\n    \"patent_title\": \"Method and system for enhanced image processing using deep learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method and system for enhancing image processing quality using deep learning algorithms. The system can improve image resolution, reduce noise, and identify objects within images with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image quality comprising...\",\n        \"A system for processing images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69973", "text": "{\n    \"patent_title\": \"Apparatus for automated document scanning\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"IBM Research\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2017-02-15\",\n    \"filing_date\": \"2017-02-14\",\n    \"issue_date\": \"2020-04-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An apparatus for automatically scanning documents, converting them to digital formats, and storing them securely. The apparatus includes a high-resolution scanner, image correction software, and a data storage module.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"An apparatus for scanning documents comprising...\",\n        \"A method for converting scanned documents...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69974", "text": "{\n    \"patent_title\": \"Advanced Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) for electric vehicles utilizing advanced algorithms for cell balancing, state of charge estimation, and thermal management. The system improves battery life and performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        },\n        {\n            \"patent_number\": \"US8123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for cell balancing...\",\n        \"A system for thermal regulation...\",\n        \"A device for state of charge estimation...\",\n        \"Claim 5 dependent on claim 1...\",\n        \"Claim 6 dependent on claim 2...\",\n        \"Claim 7 dependent on claim 3...\",\n        \"Claim 8 dependent on claim 4...\",\n        \"Claim 9 dependent on claim 1...\",\n        \"Claim 10 dependent on claim 2...\",\n        \"Claim 11...\",\n        \"Claim 12...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69974", "text": "{\n    \"patent_title\": \"Novel Chemical Composition for Battery Electrodes\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9210987B1\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-05-20\",\n    \"issue_date\": \"2016-03-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new chemical composition for battery electrodes, focusing on increased energy density. The invention involves a novel lithium-sulfur compound.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8987654B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery electrode comprising...\",\n        \"A method for synthesizing the electrode material...\",\n        \"A battery cell utilizing the electrode...\",\n        \"Claim 2 dependent on claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69975", "text": "{\n    \"patent_title\": \"Wireless Power Transfer System and Method\",\n    \"inventors\": [\n        {\n            \"name\": \"Lee, Jae-won\",\n            \"affiliation\": \"Samsung Electronics Co., Ltd.\"\n        },\n        {\n            \"name\": \"Park, Ji-hoon\",\n            \"affiliation\": \"Samsung Electronics Co., Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US9876345B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless power transfer system and method for wirelessly charging electronic devices using resonant inductive coupling. The system includes a transmitter and a receiver, optimized for high efficiency and power delivery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8546789B2\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless power transfer system comprising...\",\n        \"A method for wirelessly charging...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69975", "text": "{\n    \"patent_title\": \"Efficient Inductive Charging Coil Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Smith, John\",\n            \"affiliation\": \"Apple Inc.\"\n        },\n        {\n            \"name\": \"Jones, Alice\",\n            \"affiliation\": \"Intel Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-08-10\",\n    \"filing_date\": \"2017-08-10\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An inductive charging coil design that minimizes energy loss and maximizes charging efficiency.  The design focuses on advanced materials and geometric optimization.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"An inductive charging coil comprising...\",\n        \"A method for optimizing coil geometry...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69976", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford Research Institute\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system is disclosed, enabling remote monitoring of pressure in various applications. The sensor utilizes a MEMS pressure transducer and a low-power wireless communication module.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art in wireless sensor networks\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for remotely monitoring pressure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69976", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2012-03-10\",\n    \"filing_date\": \"2012-03-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles is presented. This system optimizes charging and discharging cycles to extend battery life and improve performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related to battery charging algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery performance...\"\n    ]\n}"}
