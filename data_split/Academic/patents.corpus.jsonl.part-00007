{"_id": "Academic--patents--p--66557", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Enhanced Biocompatibility\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-03-15\",\n    \"filing_date\": \"2010-05-20\",\n    \"issue_date\": \"2018-12-04\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor is disclosed, featuring a novel biocompatible coating that minimizes tissue response and enhances long-term stability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Prior Art Glucose Sensor\"\n        }\n    ],\n    \"claims\": [\n        \"A glucose sensor comprising a biocompatible coating.\",\n        \"The glucose sensor of claim 1, wherein the coating is comprised of polyethylene glycol.\",\n        \"A method of measuring glucose levels using the glucose sensor of claim 1.\",\n        \"The method of claim 3, wherein the glucose levels are measured in vivo.\",\n        \"A system for continuous glucose monitoring utilizing the glucose sensor of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66557", "text": "{\n    \"patent_title\": \"Novel Surgical Stapler Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2008-11-01\",\n    \"filing_date\": \"2009-12-10\",\n    \"issue_date\": \"2017-08-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical stapler with an improved cartridge loading mechanism is disclosed.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"title\": \"Previous Stapler Design\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising a cartridge loading mechanism.\",\n        \"The surgical stapler of claim 1, wherein the mechanism is spring-loaded.\",\n        \"A staple cartridge for use with the surgical stapler of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66558", "text": "{\n    \"patent_title\": \"System and method for adaptive beamforming in wireless communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Qualcomm Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-03-15\",\n    \"filing_date\": \"2010-05-20\",\n    \"issue_date\": \"2019-07-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An adaptive beamforming system that dynamically adjusts the beam pattern based on channel conditions and user demand.  The system improves signal strength and reduces interference.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Beamforming techniques for wireless networks\"\n        },\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"title\": \"Adaptive antenna arrays\"\n        }\n    ],\n    \"claims\": [\n        \"A system for adaptive beamforming comprising...\",\n        \"A method for adjusting a beam pattern...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66558", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Independent Inventor\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2008-11-01\",\n    \"filing_date\": \"2009-12-10\",\n    \"issue_date\": \"2012-04-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel bicycle braking system incorporating improved lever mechanics and enhanced pad materials.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A bicycle braking system comprising...\",\n        \"A lever mechanism for applying braking force...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66559", "text": "{\n    \"patent_title\": \"Implantable Cardiovascular Monitoring Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Medtronic\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-06-10\",\n    \"issue_date\": \"2021-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an implantable device for continuous cardiovascular monitoring, providing real-time data for improved patient care. The device utilizes advanced sensor technology to detect arrhythmias and other cardiovascular events.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for continuously monitoring cardiovascular activity.\",\n        \"An implantable device comprising a sensor and a transmitter.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66559", "text": "{\n    \"patent_title\": \"Surgical Tool for Orthopedic Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Johns Hopkins University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-20\",\n    \"filing_date\": \"2019-01-20\",\n    \"issue_date\": \"2020-07-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel surgical tool designed to enhance precision during orthopedic procedures, particularly joint replacements. It features an ergonomic handle and a micro-adjusting cutting mechanism.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical tool comprising an ergonomic handle.\",\n        \"A cutting mechanism with micro-adjustment capabilities.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66560", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery with Enhanced Cycle Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-06-10\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved lithium-ion battery with a novel electrolyte formulation and electrode materials that significantly enhances the cycle life and energy density of the battery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art related to electrolyte composition.\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte formulation for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66560", "text": "{\n    \"patent_title\": \"Novel Solar Cell Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-01\",\n    \"filing_date\": \"2017-04-15\",\n    \"issue_date\": \"2019-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new design for solar cells utilizing perovskite materials, resulting in increased efficiency and lower manufacturing costs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related to perovskite solar cell technology.\"\n        }\n    ],\n    \"claims\": [\n        \"A solar cell comprising a perovskite layer...\",\n        \"A method for manufacturing a perovskite solar cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66561", "text": "{\n    \"patent_title\": \"Miniaturized Optical Sensor System and Method\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-12-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized optical sensor system is disclosed, utilizing novel microfabrication techniques for enhanced sensitivity and reduced size. The sensor is applicable in environmental monitoring and biomedical diagnostics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art related to optical sensing.\"\n        }\n    ],\n    \"claims\": [\n        \"A sensor comprising...\",\n        \"A method for detecting...\",\n        \"The sensor of claim 1, wherein...\",\n        \"The method of claim 2, further comprising...\",\n        \"A system including the sensor of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66561", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2021-01-10\",\n    \"issue_date\": \"2023-03-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery management system is described, improving the efficiency and lifespan of lithium-ion batteries. Includes advanced charging algorithms and thermal management techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"Related to battery charging circuits.\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling the charging of...\",\n        \"The system of claim 1, wherein...\",\n        \"The method of claim 2, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66562", "text": "{\n    \"patent_title\": \"Miniature Implantable Cardiac Monitor with Extended Battery Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Medtronic Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-07-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2021-12-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable cardiac monitor with a novel battery management system for extended operational life. The device continuously monitors heart rhythm and wirelessly transmits data to a remote receiver.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art related to cardiac monitoring\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable cardiac monitor comprising...\",\n        \"A battery management system for extending the operational life of said monitor...\",\n        \"A wireless communication module for transmitting data...\",\n        \"A method for continuously monitoring heart rhythm...\",\n        \"A method for remotely receiving and analyzing cardiac data...\",\n        \"A system for alerting medical personnel to abnormal heart activity...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66562", "text": "{\n    \"patent_title\": \"Surgical Instrument for Laparoscopic Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-10\",\n    \"issue_date\": \"2021-04-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical instrument for use in minimally invasive laparoscopic procedures. The instrument provides enhanced dexterity and precision for surgeons.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related art in the field of surgical instruments\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising...\",\n        \"A handle for manipulating the instrument...\",\n        \"An articulating end effector...\",\n        \"A mechanism for controlling the end effector...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66563", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Predictive Maintenance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for predictive maintenance using artificial intelligence and machine learning algorithms. The system analyzes sensor data to predict equipment failures and optimize maintenance schedules.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predictive maintenance comprising...\",\n        \"A method for analyzing sensor data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66563", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved battery management system for electric vehicles, enhancing efficiency and lifespan. It uses advanced control algorithms for optimal charging and discharging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66564", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2022-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing image recognition accuracy using deep learning algorithms. The system employs a novel convolutional neural network architecture to improve object detection and classification.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for enhancing image recognition accuracy...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66564", "text": "{\n    \"patent_title\": \"Improved Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2021-04-12\",\n    \"issue_date\": \"2023-01-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles designed to optimize performance and extend battery life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art in battery technology\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for an electric vehicle comprising...\",\n        \"A method for optimizing battery performance...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66565", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-05-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for medical applications. The system utilizes a MEMS pressure sensor and a low-power wireless transceiver to transmit data to a remote monitoring station. This device allows continuous monitoring of physiological pressures with increased patient comfort.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in MEMS sensor technology\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for monitoring pressure using said system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66565", "text": "{\n    \"patent_title\": \"Improved Battery Life for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2021-09-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new power management technique for extending the battery life of mobile devices. This invention focuses on optimizing the power consumption of the device's processor and display.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Prior art in power management\"\n        }\n    ],\n    \"claims\": [\n        \"A mobile device comprising a power management system...\",\n        \"A method for optimizing power consumption...\"\n    ]\n}"}
