{"_id": "Academic--patents--p--66283", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for improving image recognition accuracy using deep convolutional neural networks. The system utilizes a novel training algorithm to enhance feature extraction and classification performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66283", "text": "{\n    \"patent_title\": \"Wireless Communication Protocol for Low-Power Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel wireless communication protocol optimized for low-power Internet of Things (IoT) devices. The protocol reduces energy consumption while maintaining reliable data transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication protocol comprising...\",\n        \"A low-power device utilizing the protocol comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66284", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a miniature wireless pressure sensor system for biomedical applications. The system comprises a low-power sensor, a wireless communication module, and a power management unit.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A miniature wireless pressure sensor system...\",\n        \"The system according to claim 1, wherein the sensor is a piezoresistive sensor.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66284", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-07-01\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved lithium-ion battery with enhanced energy density and cycle life. It incorporates a novel electrolyte formulation and electrode materials.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"The battery according to claim 1, wherein the electrolyte comprises...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66285", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Improved Electrolyte Composition\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to lithium-ion batteries with a novel electrolyte composition exhibiting enhanced stability and conductivity. The new electrolyte allows for higher energy density and improved safety characteristics. The design also addresses dendrite formation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an anode, a cathode, and an electrolyte.\",\n        \"The lithium-ion battery of claim 1, wherein the electrolyte comprises a lithium salt dissolved in a solvent.\",\n        \"The lithium-ion battery of claim 2, wherein the solvent comprises ethylene carbonate and dimethyl carbonate.\",\n        \"The lithium-ion battery of claim 1, further comprising a separator.\",\n        \"The lithium-ion battery of claim 1, exhibiting a cycle life of at least 500 cycles.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66285", "text": "{\n    \"patent_title\": \"Novel Polymer Electrolyte for Sodium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Chloe Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2012-05-10\",\n    \"filing_date\": \"2012-05-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new polymer electrolyte for sodium-ion batteries. The polymer enhances ionic conductivity and allows for flexible battery designs. This overcomes limitations of traditional liquid electrolytes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8987654B2\",\n            \"relevance\": \"Related Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A sodium-ion battery comprising an anode, a cathode, and a polymer electrolyte.\",\n        \"The sodium-ion battery of claim 1, wherein the polymer electrolyte comprises a polyether.\",\n        \"The sodium-ion battery of claim 2, wherein the polyether is polyethylene oxide (PEO).\",\n        \"The sodium-ion battery of claim 1, exhibiting a high ionic conductivity.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66286", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel system and method for image recognition utilizing deep convolutional neural networks is disclosed. The system incorporates a unique attention mechanism for improved accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a deep learning model...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66286", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new battery management system providing enhanced performance and safety is presented.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66287", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel system and method for improving the accuracy of image recognition using deep convolutional neural networks. The system incorporates attention mechanisms and transfer learning techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        },\n        {\n            \"patent_number\": \"US11223344B1\"\n        },\n        {\n            \"patent_number\": \"US12334455B2\"\n        },\n        {\n            \"patent_number\": \"US13445566B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a deep neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66287", "text": "{\n    \"patent_title\": \"Improved Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-12-01\",\n    \"filing_date\": \"2020-06-20\",\n    \"issue_date\": \"2023-04-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new battery management system that optimizes charging and discharging cycles to extend battery life and improve vehicle performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        },\n        {\n            \"patent_number\": \"US87654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66288", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Predictive Maintenance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for predictive maintenance using artificial intelligence algorithms. By analyzing sensor data, the system predicts potential equipment failures, enabling proactive maintenance and reducing downtime.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in sensor data analysis\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predictive maintenance comprising...\",\n        \"A method for analyzing sensor data...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The system of claim 1, wherein the artificial intelligence algorithm is a neural network.\",\n        \"The method of claim 2, further comprising displaying a predicted failure time.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66288", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"CycleTech Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-01\",\n    \"issue_date\": \"2023-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved braking system for bicycles, providing enhanced stopping power and safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art in bicycle braking systems\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle braking system comprising...\",\n        \"A brake lever assembly...\",\n        \"A caliper assembly...\",\n        \"A brake pad material...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66289", "text": "{\n    \"patent_title\": \"Neural Network Architecture for Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel neural network architecture for high-accuracy image recognition. The architecture utilizes convolutional layers and recurrent neural networks to improve feature extraction and classification.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Convolutional Neural Networks\"\n        },\n        {\n            \"patent_number\": \"US9543210B2\",\n            \"title\": \"Recurrent Neural Networks\"\n        },\n        {\n            \"patent_number\": \"US20170123456A1\",\n            \"title\": \"Image Classification Algorithms\"\n        },\n        {\n            \"patent_number\": \"US20180456789A1\",\n            \"title\": \"Deep Learning Frameworks\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Feature Extraction Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A neural network architecture comprising a convolutional layer and a recurrent neural network.\",\n        \"A method for image recognition using the claimed neural network architecture.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66289", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11223344B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2020-10-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system with improved charging and discharging efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B1\",\n            \"title\": \"Lithium-ion Battery Technology\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"title\": \"Battery Charging Circuits\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising a charging circuit and a discharging circuit.\",\n        \"A method for managing battery charging and discharging.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66290", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Improved Biocompatibility\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor is described, featuring a novel biocompatible coating that minimizes inflammatory response and extends sensor lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Prior Art Glucose Sensor\"\n        },\n        {\n            \"patent_number\": \"US8212345B2\",\n            \"title\": \"Biocompatible Polymers\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Microfabrication Techniques\"\n        },\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Wireless Communication for Sensors\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Encapsulation Methods\"\n        }\n    ],\n    \"claims\": [\n        \"A glucose sensor comprising a biocompatible coating.\",\n        \"The sensor of claim 1, wherein the coating comprises...\",\n        \"A method of measuring glucose levels using the sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66290", "text": "{\n    \"patent_title\": \"Portable Blood Pressure Monitor\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-05-20\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A compact and portable blood pressure monitor for home use is disclosed.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"title\": \"Early Blood Pressure Monitors\"\n        },\n        {\n            \"patent_number\": \"US7432109B1\",\n            \"title\": \"Digital Signal Processing\"\n        }\n    ],\n    \"claims\": [\n        \"A portable blood pressure monitor.\",\n        \"The monitor of claim 1, comprising...\",\n        \"A method of measuring blood pressure...\"\n    ]\n}"}
