{"_id": "Academic--patents--p--66392", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor for Biomedical Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor is disclosed. The sensor is designed for implantable biomedical applications, providing real-time physiological data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A pressure sensor comprising...\",\n        \"A wireless communication module...\",\n        \"A method for measuring pressure...\",\n        \"A system for real-time monitoring...\",\n        \"The sensor of claim 1, wherein...\",\n        \"The wireless communication module of claim 2...\",\n        \"The method of claim 3, further comprising...\",\n        \"The system of claim 4, wherein...\",\n        \"The pressure sensor of claim 5...\",\n        \"The wireless communication module of claim 6...\",\n        \"The method of claim 7, wherein...\",\n        \"The system of claim 8, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66392", "text": "{\n    \"patent_title\": \"Improved Optical Sensor Calibration Method\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-03-01\",\n    \"issue_date\": \"2021-09-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This patent describes a new method for calibrating optical sensors, enhancing their accuracy and reliability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for calibrating an optical sensor...\",\n        \"A calibration system comprising...\",\n        \"The method of claim 1, wherein...\",\n        \"The calibration system of claim 2...\",\n        \"An optical sensor calibrated using...\",\n        \"The method of claim 3, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66393", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Tesla, Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2019-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel lithium-ion battery design incorporating a modified electrolyte composition and a three-dimensional current collector, resulting in significantly enhanced stability and cycle life. The battery demonstrates improved performance under extreme temperature conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8980421B2\",\n            \"year\": 2015\n        },\n        {\n            \"patent_number\": \"US9780482B2\",\n            \"year\": 2018\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition for a lithium-ion battery...\"\n    ]\n}"}
