{"_id": "Academic--patents--p--66703", "text": "{\n    \"patent_title\": \"Implantable Cardiac Monitor with Enhanced Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Medtronic Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac monitor is disclosed, comprising a sensor for detecting cardiac signals and a transmitter for wirelessly transmitting data to an external receiver. The transmitter utilizes a novel modulation scheme to enhance data transmission range and reliability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Prior Art Cardiac Monitor\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Wireless Data Transmission System\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Implantable Sensor Technology\"\n        },\n        {\n            \"patent_number\": \"US11000001B2\",\n            \"title\": \"Enhanced Signal Processing for Cardiac Data\"\n        },\n        {\n            \"patent_number\": \"US10999999B2\",\n            \"title\": \"Low-Power Wireless Communication Protocol\"\n        }\n    ],\n    \"claims\": [\n        \"A cardiac monitor comprising a sensor and a transmitter.\",\n        \"The transmitter utilizing a modulation scheme to improve transmission range.\",\n        \"The cardiac monitor being implantable.\"\n    ]\n}"}
