{"_id": "Academic--patents--p--66408", "text": "{\n    \"patent_title\": \"Method for Enhanced Genome Editing Using CRISPR-Cas9\",\n    \"inventors\": [\n        {\n            \"name\": \"Jennifer Doudna\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Emmanuelle Charpentier\",\n            \"affiliation\": \"Max Planck Unit for the Science of Pathogens\"\n        },\n        {\n            \"name\": \"Feng Zhang\",\n            \"affiliation\": \"Broad Institute of MIT and Harvard\"\n        }\n    ],\n    \"patent_number\": \"US9889831B2\",\n    \"priority_date\": \"2012-06-07\",\n    \"filing_date\": \"2015-02-12\",\n    \"issue_date\": \"2019-02-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"The invention provides methods and compositions for targeted genome editing using a CRISPR-Cas9 system. The methods utilize a single guide RNA (sgRNA) to direct the Cas9 protein to a specific genomic locus, enabling precise gene editing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8697359B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for editing a genome comprising...\",\n        \"A guide RNA comprising...\",\n        \"A Cas9 protein comprising...\"\n    ]\n}"}
