{"_id": "Academic--patents--p--66555", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Enhanced Biocompatibility\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor with a novel biocompatible coating for long-term use in diabetic patients. The sensor provides continuous glucose monitoring with improved accuracy and reduced inflammation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Prior Art Glucose Sensor\"\n        }\n    ],\n    \"claims\": [\n        \"A glucose sensor comprising a biocompatible coating.\",\n        \"The glucose sensor of claim 1, wherein the coating comprises hyaluronic acid.\",\n        \"A method for monitoring glucose levels using the glucose sensor of claim 1.\",\n        \"The method of claim 3, wherein the glucose levels are monitored continuously.\",\n        \"A system for displaying glucose levels measured by the glucose sensor of claim 1.\",\n        \"The system of claim 5, wherein the system includes a wireless communication module.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66555", "text": "{\n    \"patent_title\": \"Surgical Instrument for Minimally Invasive Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-12-10\",\n    \"filing_date\": \"2009-12-10\",\n    \"issue_date\": \"2017-08-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical instrument designed for performing minimally invasive procedures with enhanced precision and maneuverability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"title\": \"Traditional Surgical Instrument\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising a flexible shaft.\",\n        \"The surgical instrument of claim 1, wherein the shaft is made of titanium alloy.\",\n        \"A method for performing a surgical procedure using the surgical instrument of claim 1.\",\n        \"The method of claim 3, wherein the procedure is a laparoscopic cholecystectomy.\"\n    ]\n}"}
