{"_id": "Academic--patents--p--66409", "text": "{\n    \"patent_title\": \"AI-Powered Predictive Maintenance System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system for predictive maintenance utilizing artificial intelligence algorithms to analyze sensor data and predict equipment failures, reducing downtime and improving efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in sensor data analysis\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predicting equipment failure comprising...\",\n        \"A method for analyzing sensor data using machine learning...\",\n        \"A non-transitory computer-readable medium storing instructions...\",\n        \"The system of claim 1, wherein the artificial intelligence algorithm is a neural network.\",\n        \"The method of claim 2, further comprising...\"\n    ]\n}"}
