{"_id": "Academic--patents--p--66720", "text": "{\n    \"patent_title\": \"Systems and methods for personalized recommendations using machine learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Sergey Brin\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Larry Page\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2008-05-15\",\n    \"filing_date\": \"2008-05-15\",\n    \"issue_date\": \"2019-02-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides systems and methods for providing personalized recommendations to users, utilizing machine learning algorithms to analyze user preferences and historical data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for providing personalized recommendations...\",\n        \"A system comprising a machine learning module...\"\n    ]\n}"}
