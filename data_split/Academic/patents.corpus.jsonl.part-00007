{"_id": "Academic--patents--p--66298", "text": "{\n    \"patent_title\": \"System and Method for Intelligent Data Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2008-05-15\",\n    \"filing_date\": \"2008-05-15\",\n    \"issue_date\": \"2019-02-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for intelligent data analysis utilizing artificial intelligence techniques to identify patterns and anomalies in large datasets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"type\": \"Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for analyzing data comprising...\",\n        \"A method for identifying patterns in data...\"\n    ]\n}"}
