{"_id": "Academic--patents--p--66459", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Machine Learning Model Training\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-11-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for improving the training efficiency of machine learning models, particularly deep neural networks. The system utilizes a dynamic learning rate adjustment algorithm based on gradient statistics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for training a machine learning model comprising...\",\n        \"A system for implementing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66459", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-10-01\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-09-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new braking system for bicycles featuring enhanced modulation and stopping power. The system utilizes a novel caliper design and pad material.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle braking system comprising...\",\n        \"A caliper assembly for use in the braking system of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66460", "text": "{\n    \"patent_title\": \"Improved Electrode Material for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-14\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel electrode material for lithium-ion batteries with enhanced energy density and cycle life. The material utilizes a unique nano-structured composite to improve ion transport and reduce degradation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Lithium Iron Phosphate Cathode Material\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode material...\",\n        \"The electrode material according to claim 1, wherein the material is nano-structured.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66460", "text": "{\n    \"patent_title\": \"Advanced Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2010-11-01\",\n    \"filing_date\": \"2010-11-01\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an advanced battery management system (BMS) for electric vehicles, optimizing battery performance, safety, and lifespan. The BMS utilizes sophisticated algorithms for cell balancing, temperature control, and state-of-charge estimation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Battery Management System with Enhanced Fault Detection\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Lithium-Ion Battery Cell Balancing Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for an electric vehicle...\",\n        \"The battery management system according to claim 1, comprising a cell balancing circuit.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66461", "text": "{\n    \"patent_title\": \"Lithium Ion Battery with Improved Electrolyte\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium ion battery incorporating a novel electrolyte composition exhibiting enhanced ionic conductivity and improved safety characteristics. The electrolyte comprises a lithium salt dissolved in a mixture of organic solvents, resulting in a higher energy density and longer cycle life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Lithium Polymer Battery\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium ion battery comprising...\",\n        \"An electrolyte composition for a lithium ion battery...\",\n        \"A method of manufacturing a lithium ion battery...\",\n        \"The lithium ion battery of claim 1, wherein the electrolyte...\",\n        \"The method of claim 3, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66461", "text": "{\n    \"patent_title\": \"Nickel-Metal Hydride Battery\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US8901234B1\",\n    \"priority_date\": \"2011-05-10\",\n    \"filing_date\": \"2011-05-10\",\n    \"issue_date\": \"2017-03-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A nickel-metal hydride battery with an improved electrode structure. This electrode offers increased surface area and enhanced charge-discharge performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"title\": \"Nickel-Hydrogen Battery\"\n        }\n    ],\n    \"claims\": [\n        \"A nickel-metal hydride battery comprising...\",\n        \"An electrode structure for a nickel-metal hydride battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66462", "text": "{\n    \"patent_title\": \"Miniature Pressure Sensor with Enhanced Sensitivity\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-05-15\",\n    \"filing_date\": \"2020-06-01\",\n    \"issue_date\": \"2022-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a miniature pressure sensor utilizing a novel MEMS design for enhanced sensitivity and accuracy. The sensor is particularly suited for biomedical applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\",\n            \"relevance\": \"Prior art in MEMS sensor technology\"\n        }\n    ],\n    \"claims\": [\n        \"A pressure sensor comprising...\",\n        \"The pressure sensor of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66462", "text": "{\n    \"patent_title\": \"Method for Calibrating Temperature Sensors\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2020-12-01\",\n    \"filing_date\": \"2021-01-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new method for calibrating temperature sensors to achieve high accuracy and stability. This method utilizes a feedback loop and advanced algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"relevance\": \"Related calibration techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for calibrating a temperature sensor...\",\n        \"The method of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66463", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-12-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing image recognition accuracy utilizing a novel deep learning architecture. The system incorporates attention mechanisms and transfer learning to improve performance on diverse image datasets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        },\n        {\n            \"patent_number\": \"US11000001B1\"\n        },\n        {\n            \"patent_number\": \"US10555555B2\"\n        },\n        {\n            \"patent_number\": \"US11111111B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a deep learning model...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66463", "text": "{\n    \"patent_title\": \"Improved Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Motors\"\n        }\n    ],\n    \"patent_number\": \"US11999999B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-08-10\",\n    \"issue_date\": \"2022-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles that optimizes charging and discharging cycles to extend battery life and improve performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8888888B1\"\n        },\n        {\n            \"patent_number\": \"US9999999B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66464", "text": "{\n    \"patent_title\": \"Deep Learning Accelerator with Integrated Memory\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2018-11-15\",\n    \"filing_date\": \"2019-05-20\",\n    \"issue_date\": \"2020-02-04\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel deep learning accelerator utilizing an integrated memory architecture to improve performance and efficiency of neural network computations. The architecture minimizes data movement and reduces latency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Convolutional Neural Network Hardware Implementation\"\n        }\n    ],\n    \"claims\": [\n        \"A deep learning accelerator comprising...\",\n        \"A memory system integrated with the accelerator...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66464", "text": "{\n    \"patent_title\": \"Improved Image Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9123456B2\",\n    \"priority_date\": \"2010-03-10\",\n    \"filing_date\": \"2010-09-01\",\n    \"issue_date\": \"2012-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents an improved image compression algorithm based on wavelet transforms and entropy coding, resulting in higher compression ratios and faster encoding/decoding speeds.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Wavelet-Based Image Compression\"\n        }\n    ],\n    \"claims\": [\n        \"An image compression method comprising...\",\n        \"A wavelet transform module configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66465", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-08-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the resolution of digital images using deep convolutional neural networks. The system analyzes low-resolution images and reconstructs high-resolution counterparts with improved clarity and detail.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        },\n        {\n            \"patent_number\": \"US11223344B1\"\n        },\n        {\n            \"patent_number\": \"US12112233B2\"\n        },\n        {\n            \"patent_number\": \"US13123344B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution...\",\n        \"A system comprising a neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66465", "text": "{\n    \"patent_title\": \"Image Compression Technique using Wavelet Transform\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-04-15\",\n    \"issue_date\": \"2021-12-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image compression technique based on wavelet transform, achieving high compression ratios with minimal loss of image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\"\n        },\n        {\n            \"patent_number\": \"US87654321B2\"\n        },\n        {\n            \"patent_number\": \"US98765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image...\",\n        \"An apparatus for image compression...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66466", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-12-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing image recognition accuracy using deep learning techniques. The system comprises a convolutional neural network and a novel attention mechanism.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Processing Algorithm\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Deep Learning Framework\"\n        },\n        {\n            \"patent_number\": \"US11112222B1\",\n            \"title\": \"Object Detection System\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Feature Extraction Method\"\n        },\n        {\n            \"patent_number\": \"US10234567B2\",\n            \"title\": \"Neural Network Architecture\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for enhancing image recognition accuracy...\"\n    ]\n}"}
