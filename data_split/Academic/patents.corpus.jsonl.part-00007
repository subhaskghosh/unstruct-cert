{"_id": "Academic--patents--p--66500", "text": "{\n    \"patent_title\": \"Image Enhancement Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image enhancement technique using deep convolutional neural networks is presented. The method improves image quality by reducing noise and enhancing details.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image comprising...\",\n        \"A system for processing images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66500", "text": "{\n    \"patent_title\": \"Real-Time Object Detection in Video Streams\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2019-11-20\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2021-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for real-time object detection in video streams using a combination of machine learning and computer vision techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for detecting objects in a video stream...\",\n        \"A method for processing video data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66501", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized wireless pressure sensor system for biomedical applications. The system includes a low-power sensor, a wireless transmitter, and a data processing unit. The sensor measures pressure variations and transmits the data wirelessly to a remote monitoring station.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Similar sensor technology\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for measuring pressure using a wireless sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66501", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-20\",\n    \"issue_date\": \"2020-11-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles. The system provides accurate state-of-charge estimation and thermal management to enhance battery life and performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in battery management\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system including...\",\n        \"A method for estimating battery state-of-charge...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66502", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Electrolyte\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-05-15\",\n    \"filing_date\": \"2010-06-01\",\n    \"issue_date\": \"2018-02-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery comprising an improved electrolyte composition, leading to enhanced energy density and cycle life. The electrolyte contains a novel additive that stabilizes the solid electrolyte interphase (SEI).\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Lithium-Ion Battery Cathode Material\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrolyte composition...\",\n        \"The electrolyte composition of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66502", "text": "{\n    \"patent_title\": \"Novel Polymer for Flexible Displays\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-12-10\",\n    \"filing_date\": \"2010-01-15\",\n    \"issue_date\": \"2017-05-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new polymer material designed for use in flexible display applications. The material exhibits high transparency and mechanical strength.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Organic Light Emitting Diode\"\n        }\n    ],\n    \"claims\": [\n        \"A polymer material comprising...\",\n        \"The polymer material of claim 1, having a transparency of at least...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66503", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Enhanced Biocompatibility\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor with a novel biocompatible coating, improving long-term stability and accuracy of glucose monitoring.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art glucose sensor technology\"\n        }\n    ],\n    \"claims\": [\n        \"A glucose sensor comprising a biocompatible coating.\",\n        \"The glucose sensor of claim 1, wherein the coating is based on polyethylene glycol.\",\n        \"A method for monitoring glucose levels using the glucose sensor of claim 1.\",\n        \"The method of claim 3, wherein the glucose levels are monitored continuously.\",\n        \"A system for delivering insulin based on the glucose levels monitored by the glucose sensor of claim 1.\",\n        \"The system of claim 5, comprising a closed-loop control algorithm.\",\n        \"The sensor of claim 1 with a sensitivity of 10 nA/mg/dL\"\n    ]\n}"}
{"_id": "Academic--patents--n--66503", "text": "{\n    \"patent_title\": \"Surgical Instrument for Minimally Invasive Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-12-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical instrument designed for precise and minimally invasive surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related surgical instrument design\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising a handle and a cutting blade.\",\n        \"The surgical instrument of claim 1, wherein the blade is rotatable.\",\n        \"A method for performing a surgical procedure using the surgical instrument of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66504", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Pathogen Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for rapid and accurate detection of pathogens in biological samples.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"The device of claim 1, wherein...\",\n        \"A method for detecting a pathogen...\",\n        \"The method of claim 3, further comprising...\",\n        \"The device of claim 1, wherein the pathogen is a virus.\",\n        \"The device of claim 5, wherein the virus is influenza.\",\n        \"The method of claim 3, wherein the sample is blood.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66504", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Independent Inventor\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2021-02-15\",\n    \"issue_date\": \"2023-03-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved braking system for bicycles, providing enhanced stopping power and safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A braking system for a bicycle comprising...\",\n        \"The braking system of claim 1, wherein...\",\n        \"A brake lever adapted for use with the braking system...\",\n        \"The brake lever of claim 3, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66505", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-03-15\",\n    \"filing_date\": \"2010-05-20\",\n    \"issue_date\": \"2019-07-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor utilizing microfabrication techniques for continuous glucose monitoring and wireless data transmission to an external receiver.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Prior Art Glucose Sensor\"\n        },\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"title\": \"Wireless Communication Protocol\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"title\": \"Microfabricated Sensor Array\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Biocompatible Materials\"\n        },\n        {\n            \"patent_number\": \"US9543210B2\",\n            \"title\": \"Data Processing Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A glucose sensor comprising...\",\n        \"A wireless communication module...\",\n        \"A method for continuous glucose monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66505", "text": "{\n    \"patent_title\": \"Novel Surgical Instrument for Orthopedic Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2011-11-01\",\n    \"filing_date\": \"2012-03-10\",\n    \"issue_date\": \"2020-01-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical instrument designed for enhanced precision and control during orthopedic surgeries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Prior Art Surgical Tool\"\n        },\n        {\n            \"patent_number\": \"US8456789B2\",\n            \"title\": \"Ergonomic Handle Design\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising...\",\n        \"A handle configured for ergonomic grip...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66506", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for enhancing the quality of reconstructed images, particularly in medical imaging applications. The system utilizes a deep learning algorithm to reduce noise and artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Denoising Technique\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Adaptive Image Filtering\"\n        },\n        {\n            \"patent_number\": \"US11223344B1\",\n            \"title\": \"Image Reconstruction Method\"\n        },\n        {\n            \"patent_number\": \"US12345678B2\",\n            \"title\": \"Advanced Image Processing Algorithm\"\n        },\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Another Image Denoising Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image reconstruction...\",\n        \"A system comprising a processor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66506", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2021-02-10\",\n    \"issue_date\": \"2023-09-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new data compression algorithm that provides higher compression ratios with minimal loss of data. It uses a novel entropy encoding scheme.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Data Compression Method\"\n        },\n        {\n            \"patent_number\": \"US87654321B1\",\n            \"title\": \"Entropy Encoding Scheme\"\n        },\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"title\": \"Lossless Data Compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data...\",\n        \"A system for encoding data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66507", "text": "{\n    \"patent_title\": \"System and Method for Predictive Maintenance Using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for predicting equipment failures using machine learning algorithms. Sensor data is analyzed to identify patterns indicative of potential failures, allowing for proactive maintenance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predicting equipment failures comprising: a sensor for collecting data...\",\n        \"A method for analyzing sensor data using a machine learning algorithm...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66507", "text": "{\n    \"patent_title\": \"Improved Combustion Engine Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Ford Motor Company\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2014-12-10\",\n    \"filing_date\": \"2014-12-10\",\n    \"issue_date\": \"2018-05-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new combustion engine design that improves fuel efficiency and reduces emissions. The engine incorporates a novel valve timing system and a redesigned combustion chamber.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"An internal combustion engine comprising: a cylinder...\",\n        \"A valve timing system configured to optimize combustion...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66508", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for improving image recognition accuracy using a novel deep learning architecture.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Similar deep learning approach\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a deep learning model...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66508", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Tesla Motors\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2023-01-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new battery technology that increases energy density and lifespan for electric vehicles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related battery chemistry\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising...\",\n        \"An electric vehicle powered by...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66509", "text": "{\n    \"patent_title\": \"Wireless Temperature Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-05-20\",\n    \"issue_date\": \"2018-07-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless temperature sensor system for industrial monitoring. The system comprises a network of low-power sensors that transmit temperature data wirelessly to a central base station. The sensors utilize a novel energy harvesting technique to prolong battery life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art in wireless communication\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless temperature sensor system comprising...\",\n        \"A method for transmitting temperature data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66509", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2011-11-01\",\n    \"filing_date\": \"2012-02-15\",\n    \"issue_date\": \"2019-04-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor for continuous monitoring of blood glucose levels in diabetic patients. The sensor utilizes a biocompatible material and a microfluidic system to accurately measure glucose concentration.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related to prior art in glucose sensing\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable glucose sensor comprising...\",\n        \"A method for continuous glucose monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66510", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-15\",\n    \"filing_date\": \"2015-03-20\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel electrode material for lithium-ion batteries, improving energy density and cycle life. The material comprises a unique coating that enhances ion transport and reduces degradation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8546123B1\",\n            \"relevance\": \"Related prior art on lithium-ion battery electrodes.\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode material with enhanced ion conductivity.\",\n        \"The battery of claim 1, wherein the electrode material is coated with a protective layer.\",\n        \"A method for manufacturing the electrode material.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66510", "text": "{\n    \"patent_title\": \"Solid-State Lithium-Ion Battery with Enhanced Safety\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a solid-state lithium-ion battery utilizing a novel electrolyte material, enhancing safety and enabling higher energy densities. The solid electrolyte prevents dendrite formation and thermal runaway.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Previous work on solid-state electrolytes.\"\n        }\n    ],\n    \"claims\": [\n        \"A solid-state lithium-ion battery comprising a solid electrolyte.\",\n        \"The battery of claim 1, wherein the solid electrolyte is a ceramic material.\",\n        \"A method for manufacturing the solid-state lithium-ion battery.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66511", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2018-02-20\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for improving the accuracy of image recognition using deep convolutional neural networks. The system employs a novel training algorithm that enhances the feature extraction capabilities of the network.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Recognition System\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a deep learning network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66511", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2018-03-10\",\n    \"issue_date\": \"2019-10-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system for electric vehicles that improves efficiency and longevity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10112233B2\",\n            \"title\": \"Battery Charging Circuit\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling battery charge...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66512", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Processing Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for enhanced image processing using deep learning techniques. The system utilizes convolutional neural networks to improve image quality, perform object detection, and enable real-time image analysis.  It leverages advanced algorithms for efficient image processing and achieves state-of-the-art results.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image processing...\",\n        \"A system for enhancing image quality...\"\n    ]\n}"}
