{"_id": "Academic--patents--p--66410", "text": "{\n    \"patent_title\": \"High-Performance Lithium-Ion Battery with Silicon Anode\",\n    \"inventors\": [\n        {\n            \"name\": \"Yi Cui\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Ju Li\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876234B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery featuring a silicon anode and a novel electrolyte is disclosed, exhibiting high capacity and improved cycle life. The battery is suitable for electric vehicles and grid-scale energy storage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765341B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising a silicon anode...\",\n        \"An electrolyte formulation for enhancing cycle life...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66410", "text": "{\n    \"patent_title\": \"Advanced Sodium-Ion Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Maria Forsyth\",\n            \"affiliation\": \"Deakin University\"\n        },\n        {\n            \"name\": \"John Goodenough\",\n            \"affiliation\": \"University of Texas at Austin\"\n        }\n    ],\n    \"patent_number\": \"US10233579B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a sodium-ion battery with improved performance characteristics, utilizing a unique cathode material and electrolyte system. It provides a cost-effective alternative to lithium-ion batteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9540552B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A sodium-ion battery comprising a novel cathode material...\",\n        \"An electrolyte composition for enhanced ionic conductivity...\"\n    ]\n}"}
