{"_id": "Academic--patents--p--69525", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Evelyn Wang\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Mr. Jian Li\",\n            \"affiliation\": \"MIT Lincoln Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel electrode materials for lithium-ion batteries, improving energy density and cycle life. The materials incorporate a unique nanostructure to enhance ion transport.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Lithium Ion Battery Separator\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode material...\",\n        \"The electrode material according to claim 1, wherein the nanostructure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69525", "text": "{\n    \"patent_title\": \"Advanced Sodium-Ion Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Maria Garcia\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Mr. David Chen\",\n            \"affiliation\": \"California Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-19\",\n    \"issue_date\": \"2019-03-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel sodium-ion battery with enhanced performance characteristics, addressing limitations of current lithium-ion technologies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Sodium Ion Conduction Materials\"\n        }\n    ],\n    \"claims\": [\n        \"A sodium-ion battery comprising an electrode material...\",\n        \"The electrode material according to claim 1, wherein the composition...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69526", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2019-09-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications. The system incorporates a MEMS pressure sensor, a low-power transmitter, and a biocompatible encapsulation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for measuring pressure using the wireless sensor system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69526", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11123456B1\",\n    \"priority_date\": \"2017-12-01\",\n    \"filing_date\": \"2018-01-15\",\n    \"issue_date\": \"2020-04-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An advanced battery management system for electric vehicles, enhancing efficiency and longevity.  It utilizes complex algorithms to optimize charging and discharging cycles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10000000B2\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling battery charge using the system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69527", "text": "{\n    \"patent_title\": \"Novel Polymer Composition for Enhanced Durability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10253847B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2019-04-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel polymer composition exhibiting enhanced durability and resistance to degradation. The polymer is synthesized using a unique catalytic process, resulting in improved mechanical properties and extended lifespan. Applications include coatings, adhesives, and structural materials.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A polymer composition comprising...\",\n        \"The polymer composition according to claim 1, wherein...\",\n        \"A method for producing the polymer composition...\",\n        \"The method according to claim 3, wherein...\",\n        \"A coating comprising the polymer composition...\",\n        \"An adhesive comprising the polymer composition...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69527", "text": "{\n    \"patent_title\": \"Improved Battery Electrode Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11123456B1\",\n    \"priority_date\": \"2019-07-20\",\n    \"filing_date\": \"2019-07-20\",\n    \"issue_date\": \"2021-01-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel electrode material for lithium-ion batteries. The material exhibits improved energy density and cycle life. The fabrication process is scalable and cost-effective.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10000001B2\",\n            \"type\": \"cited by\"\n        }\n    ],\n    \"claims\": [\n        \"An electrode material comprising...\",\n        \"The electrode material according to claim 1, wherein...\",\n        \"A lithium-ion battery comprising the electrode material...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69528", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Processing using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2020-06-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method and system for enhancing image quality and performing complex image processing tasks using deep learning algorithms. The system is capable of identifying objects in images with high accuracy and can be applied to various fields such as medical imaging and autonomous vehicles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"kind\": \"Cited by\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image comprising...\",\n        \"The method of claim 1, wherein the deep learning algorithm is a convolutional neural network.\",\n        \"A system for performing image processing, comprising...\",\n        \"The system of claim 3, further comprising a display unit.\",\n        \"The system of claim 3, wherein the image processing includes object detection.\",\n        \"The system of claim 5, wherein the object detection is performed using a pre-trained model.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69528", "text": "{\n    \"patent_title\": \"Apparatus for Improved Data Storage\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-05-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel apparatus for storing data more efficiently. The apparatus uses a unique magnetic storage medium and a new encoding scheme. It does not involve image processing.\",\n    \"citations\": [],\n    \"claims\": [\n        \"An apparatus for storing data comprising...\",\n        \"The apparatus of claim 1, wherein the magnetic storage medium is...\",\n        \"A method of encoding data for storage in the apparatus of claim 1.\"\n    ]\n}"}
