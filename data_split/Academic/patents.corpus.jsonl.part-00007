{"_id": "Academic--patents--p--66321", "text": "{\n    \"patent_title\": \"System for Efficient Neural Network Training\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system for accelerating the training of deep neural networks using distributed computing techniques. The system improves convergence speed and reduces computational costs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for training a neural network comprising...\",\n        \"A method for distributing training data...\"\n    ]\n}"}
