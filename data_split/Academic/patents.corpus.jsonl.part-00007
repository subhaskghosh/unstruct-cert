{"_id": "Academic--patents--p--66123", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2019-03-10\",\n    \"issue_date\": \"2021-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications. The sensor utilizes MEMS technology and transmits data wirelessly, enabling remote monitoring of physiological parameters. The system incorporates advanced calibration techniques for accurate measurements and a low-power design for extended operation. Sensor data is transmitted securely.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art in wireless communication\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for remote monitoring of physiological parameters using the sensor system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66123", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2018-08-22\",\n    \"issue_date\": \"2022-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles. The system optimizes charging and discharging cycles to extend battery life and improve performance. It includes advanced algorithms for state of charge estimation and thermal management. Focuses on safety and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art in battery monitoring\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing charging cycles...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66124", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Object Detection in Digital Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for accurately detecting objects within digital images, utilizing a novel convolutional neural network architecture. The system improves upon existing object detection techniques by incorporating attention mechanisms and contextual reasoning.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Recognition Using Deep Learning\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting objects in a digital image comprising...\",\n        \"A system for object detection comprising...\"\n    ]\n}"}
