{"_id": "Academic--patents--p--66933", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing wireless communication using advanced signal processing techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"Related Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing wireless signal strength.\",\n        \"A system for reducing interference in wireless communication.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66933", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"California Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-12-10\",\n    \"filing_date\": \"2009-12-10\",\n    \"issue_date\": \"2018-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery technology with higher energy density and longer lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B2\",\n            \"relevance\": \"Related Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A battery with increased energy storage capacity.\",\n        \"A battery with extended cycle life.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66934", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical Instrument with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-11-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical instrument designed for minimally invasive procedures, incorporating enhanced fiber optic visualization and micro-robotic articulation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Prior Art Surgical Instrument\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising a fiber optic bundle and a micro-robotic arm.\",\n        \"The instrument of claim 1, wherein the fiber optic bundle provides high-resolution imaging.\",\n        \"A method for performing minimally invasive surgery using the instrument of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66934", "text": "{\n    \"patent_title\": \"Method for Automated Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-10-01\",\n    \"filing_date\": \"2019-12-10\",\n    \"issue_date\": \"2020-08-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for automated drug delivery based on patient physiological parameters.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Prior Art Drug Delivery System\"\n        }\n    ],\n    \"claims\": [\n        \"A drug delivery system comprising a sensor and a pump.\",\n        \"The system of claim 1, wherein the sensor measures blood glucose levels.\",\n        \"A method for controlling drug dosage using the system of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66935", "text": "{\n    \"patent_title\": \"Method and system for enhanced image processing using deep learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2020-11-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method and system for enhancing image processing capabilities through the utilization of deep learning algorithms. Specifically, it addresses noise reduction and image sharpening in low-light conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image enhancement technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image using a deep learning model.\",\n        \"A system comprising a processor and a memory configured to implement the method.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66935", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2019-03-10\",\n    \"filing_date\": \"2019-03-10\",\n    \"issue_date\": \"2021-07-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a battery management system designed to optimize energy storage and delivery in electric vehicles. It features advanced algorithms for monitoring cell voltage, temperature, and current.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Battery charging circuit\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising a voltage monitoring circuit.\",\n        \"A method for optimizing battery charging based on temperature feedback.\"\n    ]\n}"}
