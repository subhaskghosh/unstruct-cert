{"_id": "Academic--patents--p--66735", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"SLAC National Accelerator Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2021-08-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery electrode material with enhanced energy density and cycle life is disclosed. The material comprises a modified lithium metal oxide composition and a unique nanoscale structure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art in lithium-ion battery technology\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrode comprising...\",\n        \"A method for manufacturing the lithium-ion battery electrode...\"\n    ]\n}"}
