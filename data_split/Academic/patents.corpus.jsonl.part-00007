{"_id": "Academic--patents--p--66922", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Processing using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method and system for enhanced image processing utilizing deep learning algorithms. The system improves image quality, reduces noise, and enables faster processing speeds. Applications include medical imaging, satellite imagery, and security systems. This method effectively leverages convolutional neural networks for superior results in image processing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Related Art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image quality comprising...\",\n        \"A system for image processing utilizing deep learning...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66922", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Motors\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-06-01\",\n    \"issue_date\": \"2021-10-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved battery management system for electric vehicles, focusing on enhanced charging efficiency and battery life. The system includes a sophisticated algorithm for monitoring and controlling battery parameters. This is intended to improve the overall lifespan and safety of batteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related Art\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling battery charging...\"\n    ]\n}"}
