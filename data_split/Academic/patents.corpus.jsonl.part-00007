{"_id": "Academic--patents--p--66017", "text": "{\n    \"patent_title\": \"Miniature Pressure Sensor with Integrated Signal Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-05-20\",\n    \"issue_date\": \"2018-01-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a miniature pressure sensor integrating signal processing circuitry for accurate and reliable pressure measurements. The sensor utilizes a MEMS structure and is particularly suited for medical applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A pressure sensor comprising a MEMS element...\",\n        \"A signal processing circuit integrated with the MEMS element...\"\n    ]\n}"}
