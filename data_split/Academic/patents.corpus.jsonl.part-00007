{"_id": "Academic--patents--p--66264", "text": "{\n    \"patent_title\": \"Implantable Cardiac Monitor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Medtronic Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-15\",\n    \"filing_date\": \"2015-03-10\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac monitor provides real-time heart rhythm monitoring and transmits data wirelessly to a remote server for analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"relevance\": \"Similar monitoring technology\"\n        }\n    ],\n    \"claims\": [\n        \"A method for remotely monitoring cardiac rhythm...\",\n        \"An implantable device comprising a sensor...\",\n        \"A communication system for transmitting cardiac data...\",\n        \"A server for analyzing cardiac data...\",\n        \"A system for alerting medical personnel...\"\n    ]\n}"}
