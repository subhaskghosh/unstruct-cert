{"_id": "Academic--patents--p--66989", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Thermal Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a lithium-ion battery with a novel electrolyte composition that enhances thermal stability and improves battery lifespan. The battery is particularly suited for electric vehicle applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Electrolyte Additive for Lithium-Ion Batteries\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66989", "text": "{\n    \"patent_title\": \"Solid Oxide Fuel Cell with Integrated Battery System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Bloom Energy\"\n        }\n    ],\n    \"patent_number\": \"US11789012B1\",\n    \"priority_date\": \"2020-06-01\",\n    \"filing_date\": \"2020-08-15\",\n    \"issue_date\": \"2023-04-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A hybrid system incorporating a solid oxide fuel cell for primary power generation and a battery for peak load demands. The battery component enhances system responsiveness and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Solid Oxide Fuel Cell Design\"\n        },\n        {\n            \"patent_number\": \"US9987654B2\",\n            \"title\": \"Battery Management System for Hybrid Power Systems\"\n        }\n    ],\n    \"claims\": [\n        \"A hybrid power system comprising a solid oxide fuel cell...\",\n        \"A battery integrated with a solid oxide fuel cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66990", "text": "{\n    \"patent_title\": \"Wireless Charging System with Improved Efficiency\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a wireless charging system utilizing resonant inductive coupling to achieve high efficiency power transfer. The system includes a transmitter and a receiver, optimized for mobile devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless charging system comprising...\",\n        \"The system of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66990", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-03-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new lithium-ion battery technology with enhanced energy density and cycle life for use in electric vehicles. The battery utilizes a novel electrolyte composition to improve performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery cell comprising...\",\n        \"The cell of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66991", "text": "{\n    \"patent_title\": \"Miniature Implantable Pressure Sensor for Intracranial Pressure Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature implantable pressure sensor for continuous monitoring of intracranial pressure. The sensor utilizes MEMS technology for high sensitivity and accuracy, providing real-time data for improved diagnosis and treatment of neurological conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in pressure sensing\"\n        }\n    ],\n    \"claims\": [\n        \"A miniature pressure sensor for implantation within the skull.\",\n        \"A system for continuous intracranial pressure monitoring.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66991", "text": "{\n    \"patent_title\": \"Wireless Communication System for Automotive Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-08-10\",\n    \"filing_date\": \"2017-08-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless communication system for use in automotive vehicles. The system includes a transceiver, antenna, and control logic for enabling seamless data exchange between vehicle components and external networks. The system uses a sensor to monitor signal strength.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Prior art in wireless communication\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication system for automotive vehicles.\",\n        \"A method for transmitting data between vehicle components.\"\n    ]\n}"}
