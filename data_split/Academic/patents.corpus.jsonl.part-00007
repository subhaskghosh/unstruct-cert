{"_id": "Academic--patents--p--69712", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-05-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel electrode material for lithium-ion batteries, improving energy density and cycle life. The material consists of a modified lithium metal oxide with enhanced ionic conductivity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Lithium-Ion Battery Separator\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode material...\",\n        \"The electrode material of claim 1, wherein the material...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69712", "text": "{\n    \"patent_title\": \"Novel Solar Cell Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2021-01-05\",\n    \"filing_date\": \"2021-04-15\",\n    \"issue_date\": \"2023-07-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a new design for high-efficiency solar cells utilizing perovskite materials. The design incorporates a novel light-trapping structure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Perovskite Solar Cell Fabrication\"\n        }\n    ],\n    \"claims\": [\n        \"A solar cell comprising a perovskite absorber layer...\",\n        \"The solar cell of claim 1, wherein the absorber layer...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69713", "text": "{\n    \"patent_title\": \"System and method for intelligent image recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2012-05-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for intelligent image recognition using artificial intelligence and deep learning techniques. It provides enhanced accuracy and efficiency in image analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Image processing system\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for enhancing image analysis...\"\n    ]\n}"}
