{"_id": "Academic--patents--p--66435", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Recognition Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing image recognition accuracy using a novel deep learning architecture. The system utilizes convolutional neural networks with attention mechanisms to identify and classify objects within images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"kind\": \"cited_by\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for image recognition comprising...\",\n        \"2. The method of claim 1, wherein...\",\n        \"3. A system for image recognition comprising...\",\n        \"4. The system of claim 3, wherein...\",\n        \"5. A computer-readable medium storing...\",\n        \"6. The computer-readable medium of claim 5, wherein...\",\n        \"7. The method of claim 1, further comprising...\"\n    ]\n}"}
