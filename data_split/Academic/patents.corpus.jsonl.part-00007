{"_id": "Academic--patents--p--69175", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery Electrode Materials with Enhanced Cycle Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"Novel lithium-ion battery electrode materials are disclosed, exhibiting significantly improved cycle life and energy density. The materials incorporate a unique nanostructure for enhanced ion transport.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrode material...\",\n        \"A method of manufacturing...\",\n        \"A device utilizing the battery...\",\n        \"A composition including...\",\n        \"A method of using the composition...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69175", "text": "{\n    \"patent_title\": \"Improved Lead-Acid Battery Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-12-01\",\n    \"filing_date\": \"2009-12-01\",\n    \"issue_date\": \"2017-03-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved design for lead-acid batteries, focusing on enhanced grid structures and electrolyte formulations.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\"\n        }\n    ],\n    \"claims\": [\n        \"A lead-acid battery comprising...\",\n        \"A grid structure...\",\n        \"An electrolyte formulation...\",\n        \"A method of assembling...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69176", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-15\",\n    \"filing_date\": \"2015-03-20\",\n    \"issue_date\": \"2018-07-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel battery design utilizing advanced materials to improve energy density and charging speed for electric vehicles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on battery materials\"\n        },\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"relevance\": \"Related work on charging systems\"\n        },\n        {\n            \"patent_number\": \"US9234567B1\",\n            \"relevance\": \"Alternative battery architectures\"\n        },\n        {\n            \"patent_number\": \"US9567890B2\",\n            \"relevance\": \"Improvements to battery management systems\"\n        },\n        {\n            \"patent_number\": \"US9678901B1\",\n            \"relevance\": \"Related work on thermal management\"\n        },\n        {\n            \"patent_number\": \"US9789012B2\",\n            \"relevance\": \"Similar battery compositions\"\n        }\n    ],\n    \"claims\": [\n        \"A battery comprising a novel electrolyte composition...\",\n        \"A method for charging said battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69176", "text": "{\n    \"patent_title\": \"New Solar Panel Design\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2016-01-10\",\n    \"filing_date\": \"2016-04-15\",\n    \"issue_date\": \"2019-02-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new design for solar panels with improved efficiency and durability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"relevance\": \"Prior art in solar panel technology\"\n        },\n        {\n            \"patent_number\": \"US9123456B1\",\n            \"relevance\": \"Related work on solar cell materials\"\n        },\n        {\n            \"patent_number\": \"US9345678B2\",\n            \"relevance\": \"Alternative solar panel designs\"\n        }\n    ],\n    \"claims\": [\n        \"A solar panel comprising a novel cell structure...\",\n        \"A method for manufacturing said solar panel...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69177", "text": "{\n    \"patent_title\": \"Electrode Material for High-Performance Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-06-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel electrode material comprising a lithium-ion conducting polymer electrolyte is disclosed. This material exhibits enhanced ionic conductivity and improved cycling stability, leading to high-performance lithium-ion batteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related art in lithium insertion compounds.\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode material...\",\n        \"The electrode material according to claim 1, wherein the polymer electrolyte...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69177", "text": "{\n    \"patent_title\": \"Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2018-01-10\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) for electric vehicles is described. The BMS monitors and controls the charging and discharging of a lithium-ion battery pack, ensuring safe and efficient operation. The system includes algorithms for state-of-charge estimation, cell balancing, and thermal management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Prior art relating to cell balancing techniques.\"\n        },\n        {\n            \"patent_number\": \"US8987654B1\",\n            \"relevance\": \"Reference for thermal management systems in batteries.\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising a processor...\",\n        \"The battery management system according to claim 1, further comprising a cell balancing circuit...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69178", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-11-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for improving the accuracy of image recognition using deep learning techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"kind\": \"cited by examiner\"\n        },\n        {\n            \"patent_number\": \"US1011121314B2\",\n            \"kind\": \"cited by applicant\"\n        },\n        {\n            \"patent_number\": \"US87654321B1\",\n            \"kind\": \"cited by examiner\"\n        },\n        {\n            \"patent_number\": \"US1122334455B2\",\n            \"kind\": \"cited by applicant\"\n        },\n        {\n            \"patent_number\": \"US76543210B1\",\n            \"kind\": \"cited by examiner\"\n        },\n        {\n            \"patent_number\": \"US1233445566B2\",\n            \"kind\": \"cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for enhancing image recognition accuracy...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69178", "text": "{\n    \"patent_title\": \"Novel Battery Charging Circuit\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US99887766B1\",\n    \"priority_date\": \"2019-12-01\",\n    \"filing_date\": \"2020-05-15\",\n    \"issue_date\": \"2021-09-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new circuit design for optimizing battery charging efficiency and reducing charging time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US88776655B2\",\n            \"kind\": \"cited by examiner\"\n        },\n        {\n            \"patent_number\": \"US99776655B1\",\n            \"kind\": \"cited by applicant\"\n        },\n        {\n            \"patent_number\": \"US77665544B1\",\n            \"kind\": \"cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A battery charging circuit comprising...\",\n        \"A method for optimizing battery charge...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69179", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery Electrode Materials with Enhanced Cycle Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to novel lithium-ion battery electrode materials exhibiting improved cycle life and energy density. The materials incorporate a modified surface coating to enhance stability and reduce degradation during charge-discharge cycles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Lithium-Ion Battery Separator\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrode material comprising...\",\n        \"The electrode material of claim 1, further comprising...\",\n        \"A lithium-ion battery cell comprising the electrode material...\",\n        \"A method of manufacturing the electrode material...\",\n        \"A lithium-ion battery pack comprising the cell...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69179", "text": "{\n    \"patent_title\": \"Solid-State Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-09\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a solid-state battery utilizing a ceramic electrolyte. The battery offers improved safety and energy density compared to conventional lithium-ion batteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Solid Electrolyte Materials\"\n        }\n    ],\n    \"claims\": [\n        \"A solid-state battery comprising...\",\n        \"The solid-state battery of claim 1, wherein the electrolyte...\",\n        \"A method of manufacturing the solid-state battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69180", "text": "{\n    \"patent_title\": \"Implantable Cardiac Monitor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Medtronic\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-06-20\",\n    \"issue_date\": \"2019-07-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac monitor wirelessly transmits data to an external receiver for remote monitoring of heart rhythm and function.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Prior Art Cardiac Monitor\"\n        },\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"title\": \"Wireless Communication Protocol\"\n        },\n        {\n            \"patent_number\": \"US8987654B1\",\n            \"title\": \"Implantable Power Source\"\n        },\n        {\n            \"patent_number\": \"US9102345B2\",\n            \"title\": \"Data Analysis Algorithms\"\n        },\n        {\n            \"patent_number\": \"US9234567B1\",\n            \"title\": \"Remote Monitoring System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for remotely monitoring a patient's cardiac function.\",\n        \"An implantable device for transmitting cardiac data wirelessly.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69180", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2011-05-01\",\n    \"filing_date\": \"2011-08-15\",\n    \"issue_date\": \"2018-12-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A bicycle brake system with improved stopping power and modulation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"title\": \"Existing Bicycle Brake Design\"\n        },\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Brake Pad Material\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle brake system comprising a lever and a caliper.\",\n        \"A brake pad material with increased friction.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69181", "text": "{\n    \"patent_title\": \"System and Method for Personalized Recommendations Using Artificial Intelligence\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for providing personalized recommendations to users based on their preferences and historical data using artificial intelligence algorithms, specifically a deep learning model. The system analyzes user behavior and context to predict items that the user may be interested in.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating personalized recommendations, comprising:...\",\n        \"A system for providing personalized recommendations...\",\n        \"The method of claim 1, wherein the artificial intelligence algorithm is a deep learning model.\",\n        \"The system of claim 2, further comprising a user interface...\",\n        \"The method of claim 1, further comprising storing user preference data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69181", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Motors\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2016-11-01\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system that optimizes charging and discharging cycles to prolong battery life and improve performance. The system employs advanced control algorithms to prevent overcharging and overheating.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising:...\",\n        \"The system of claim 1, wherein the control algorithm is based on...\",\n        \"A method for managing a battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69182", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Recognition Using Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhanced image recognition utilizing convolutional neural networks. The system employs a multi-layer architecture to achieve high accuracy in identifying objects within images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69182", "text": "{\n    \"patent_title\": \"Improved Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Motors\"\n        }\n    ],\n    \"patent_number\": \"US11876544B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2023-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system designed to optimize the performance and lifespan of lithium-ion batteries in electric vehicles. The system includes advanced thermal control and cell balancing features.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling a battery comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69183", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2022-03-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to novel electrode materials for lithium-ion batteries, enhancing energy density and cycle life. The materials incorporate a unique nano-structured coating for improved performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrode material...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69183", "text": "{\n    \"patent_title\": \"Novel Solar Cell Design\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Eve Garcia\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-06-01\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new design for solar cells utilizing perovskite materials, improving efficiency and reducing manufacturing costs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A solar cell comprising...\",\n        \"A perovskite layer...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69184", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-08-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for improving the accuracy and speed of image recognition using deep learning techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"title\": \"Prior Art Image Recognition System\"\n        },\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"title\": \"Related Image Processing Method\"\n        },\n        {\n            \"patent_number\": \"US76543210B1\",\n            \"title\": \"Another Relevant Image Technique\"\n        },\n        {\n            \"patent_number\": \"US65432109B2\",\n            \"title\": \"Image Filtering Algorithm\"\n        },\n        {\n            \"patent_number\": \"US54321098B1\",\n            \"title\": \"Deep Learning Framework\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for enhancing image recognition accuracy...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69184", "text": "{\n    \"patent_title\": \"Novel Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US90123456B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2021-10-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new battery technology providing increased energy density and lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US88776655B2\",\n            \"title\": \"Existing Battery Design\"\n        },\n        {\n            \"patent_number\": \"US77665544B1\",\n            \"title\": \"Battery Management System\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising...\",\n        \"A method for charging a battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69185", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Improved Electrolyte\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-05-15\",\n    \"filing_date\": \"2010-02-20\",\n    \"issue_date\": \"2019-07-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a lithium-ion battery with an improved electrolyte composition, enhancing energy density and cycle life. The electrolyte contains a novel additive that mitigates dendrite formation. This builds on the concepts in US7654321B1.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"kind\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69185", "text": "{\n    \"patent_title\": \"Novel Solar Cell Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2008-11-01\",\n    \"filing_date\": \"2009-12-10\",\n    \"issue_date\": \"2018-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new solar cell design with increased efficiency and reduced manufacturing costs is disclosed. It utilizes a unique arrangement of semiconductor materials to maximize light absorption.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A solar cell comprising...\",\n        \"A method for manufacturing a solar cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69186", "text": "{\n    \"patent_title\": \"System and Method for Image Recognition Using Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition utilizing convolutional neural networks are disclosed. The system comprises a plurality of convolutional layers, pooling layers, and fully connected layers for extracting features from images and classifying them with high accuracy. Applications include object detection and image classification.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Feature Extraction Method\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for image classification using a neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69186", "text": "{\n    \"patent_title\": \"Advanced Video Processing Techniques\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Microsoft Research\"\n        },\n        {\n            \"name\": \"Eve Franklin\",\n            \"affiliation\": \"IBM\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to advanced video processing techniques, including frame rate conversion and noise reduction. It improves the quality and efficiency of video streaming and storage. It also includes methods for analyzing video content.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Video Compression Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A method for video frame rate conversion...\",\n        \"A system for reducing noise in video signals...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69187", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Visualization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Intuitive Surgical\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system featuring enhanced 3D visualization and robotic control for improved surgical precision.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising a robotic arm...\",\n        \"A visualization module for displaying a 3D image...\",\n        \"A control system for manipulating the robotic arm...\",\n        \"A method for performing minimally invasive surgery...\",\n        \"A method for enhancing surgical visualization...\",\n        \"A method for controlling the robotic arm...\",\n        \"A surgical instrument adapted for use with the robotic arm...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69187", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved bicycle braking system featuring enhanced stopping power and modulation.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A bicycle braking system comprising a brake lever...\",\n        \"A brake caliper for applying friction to a wheel...\",\n        \"A brake cable connecting the brake lever to the brake caliper...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69188", "text": "{\n    \"patent_title\": \"Improved Electrolyte Composition for High-Performance Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel electrolyte composition for lithium-ion batteries, enhancing their energy density and cycle life. The composition utilizes a unique combination of lithium salts and additives to improve ionic conductivity and reduce degradation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Lithium-Ion Battery with Enhanced Safety Features\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrolyte composition...\",\n        \"The electrolyte composition according to claim 1, wherein the lithium salt is...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69188", "text": "{\n    \"patent_title\": \"High-Capacity Lithium-Ion Battery with Silicon Anode\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Emily Wilson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A high-capacity lithium-ion battery incorporating a silicon anode material is disclosed. This design enhances the battery's energy storage capabilities while maintaining stable performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Silicon Nanowire Anodes for Lithium-Ion Batteries\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising a silicon anode...\",\n        \"The silicon anode according to claim 1, wherein the silicon is in the form of...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69189", "text": "{\n    \"patent_title\": \"System and Method for Image Recognition Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10542345B2\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2018-03-01\",\n    \"issue_date\": \"2020-01-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition using deep convolutional neural networks. The system includes a training module for training a deep convolutional neural network and an inference module for recognizing images using the trained network.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a deep convolutional neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69189", "text": "{\n    \"patent_title\": \"Image Processing Method for Medical Diagnostics\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2021-06-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for processing medical images to aid in diagnostics. The method uses a combination of filtering and edge detection techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing medical images comprising...\",\n        \"A system for detecting edges in medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69190", "text": "{\n    \"patent_title\": \"Deep Learning System for Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2019-07-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep learning system utilizing convolutional neural networks for improved image recognition accuracy. The system comprises multiple layers of interconnected nodes, enabling the extraction of complex features from input images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a neural network...\",\n        \"A computer-readable medium storing...\",\n        \"The system of claim 1, wherein...\",\n        \"The method of claim 2, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69190", "text": "{\n    \"patent_title\": \"Method for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11223344B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2021-01-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel data compression algorithm utilizing Huffman coding to reduce file sizes. This method improves upon existing compression techniques by...\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data...\",\n        \"A system for decompressing data...\",\n        \"A computer-readable medium storing...\",\n        \"The method of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69191", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a miniature wireless pressure sensor system for real-time monitoring of various parameters. The system utilizes a novel MEMS sensor and a low-power communication protocol.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A miniature wireless pressure sensor system comprising...\",\n        \"The system of claim 1, wherein the sensor is a MEMS sensor.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69191", "text": "{\n    \"patent_title\": \"Advanced Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"David Jones\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Emily Brown\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2019-01-05\",\n    \"filing_date\": \"2019-03-10\",\n    \"issue_date\": \"2021-08-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention pertains to an advanced battery management system for electric vehicles. It includes algorithms for optimizing charging and discharging cycles to prolong battery life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"The system of claim 1, wherein the algorithm optimizes charging cycles.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69192", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition utilizing artificial intelligence and deep learning techniques. The system analyzes images to identify objects and patterns with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Processing System\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for identifying objects in an image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69192", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Robert Brown\",\n            \"affiliation\": \"Tesla\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-03-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery technology designed to increase energy density and lifespan for electric vehicle applications. The invention utilizes advanced materials and a unique cell structure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Lithium-Ion Battery Design\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising...\",\n        \"A method for manufacturing a high-density battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69193", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for enhancing the resolution of images using deep learning techniques. The system utilizes convolutional neural networks to upscale images while preserving detail and reducing artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Super-Resolution Using Generative Adversarial Networks\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for enhancing image resolution comprising...\",\n        \"2. A system for enhancing image resolution comprising...\",\n        \"3. The method of claim 1, wherein the deep learning model...\",\n        \"4. The system of claim 2, wherein the convolutional neural network...\",\n        \"5. The method of claim 1, further comprising...\",\n        \"6. The system of claim 2, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69193", "text": "{\n    \"patent_title\": \"Novel Approach to Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-05-01\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2021-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a new data compression algorithm that achieves high compression ratios with minimal loss of data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Efficient Data Encoding Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for compressing data comprising...\",\n        \"2. A system for compressing data comprising...\",\n        \"3. The method of claim 1, wherein the compression algorithm...\",\n        \"4. The system of claim 2, wherein the encoding technique...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69194", "text": "{\n    \"patent_title\": \"Wireless Sensor Network for Industrial Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of Engineering\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-06-15\",\n    \"issue_date\": \"2018-12-04\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless sensor network for monitoring temperature, pressure, and vibration in industrial settings. The system utilizes low-power sensors and a robust communication protocol to ensure reliable data transmission. Data analytics are performed to predict equipment failures and optimize performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Remote Monitoring System\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor network comprising a plurality of sensor nodes...\",\n        \"A method for monitoring industrial equipment using a wireless sensor network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69194", "text": "{\n    \"patent_title\": \"Medical Sensor for Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"BioMed Innovations\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Healthcare Research Institute\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-22\",\n    \"filing_date\": \"2017-04-28\",\n    \"issue_date\": \"2019-07-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized medical sensor for continuous glucose monitoring. The sensor utilizes electrochemical techniques to measure glucose levels in interstitial fluid. This device is designed for use by diabetic patients to manage their condition. Medical applications are central to its functionality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Implantable Glucose Sensor\"\n        }\n    ],\n    \"claims\": [\n        \"A medical sensor for glucose monitoring comprising an electrochemical cell...\",\n        \"A method for continuous glucose monitoring using an implantable sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69195", "text": "{\n    \"patent_title\": \"Image Enhancement Using Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-09-22\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method for enhancing the quality of digital images using convolutional neural networks. The system employs a novel architecture for improved noise reduction and detail preservation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Filtering Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing digital images comprising...\",\n        \"A system for image processing...\",\n        \"A convolutional neural network architecture...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69195", "text": "{\n    \"patent_title\": \"Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-11-01\",\n    \"filing_date\": \"2022-06-15\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel algorithm for compressing data, reducing storage requirements and transmission bandwidth. It leverages Huffman coding and run-length encoding.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Data Encoding Methods\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression...\",\n        \"A system for encoding data...\",\n        \"A data compression algorithm utilizing Huffman coding...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69196", "text": "{\n    \"patent_title\": \"Advanced Environmental Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2023-05-15\",\n    \"filing_date\": \"2023-08-20\",\n    \"issue_date\": \"2024-02-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel sensor system for detecting pollutants in the environment. The system utilizes advanced signal processing techniques to provide accurate and reliable measurements.  Key components include a highly sensitive sensor array and a low-power communication module.\",\n    \"citations\": [\n        {\n            \"title\": \"Remote Sensing Techniques\"\n        },\n        {\n            \"title\": \"Signal Processing for Sensor Data\"\n        }\n    ],\n    \"claims\": [\n        \"A sensor system comprising a sensor array and a processing unit.\",\n        \"A method for detecting pollutants using the sensor system.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69196", "text": "{\n    \"patent_title\": \"Medical Diagnostic Sensor\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2023-11-01\",\n    \"filing_date\": \"2024-01-15\",\n    \"issue_date\": \"2024-06-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature sensor for in-vivo medical diagnostics, capable of detecting specific biomarkers. The sensor provides real-time data for improved patient care.\",\n    \"citations\": [\n        {\n            \"title\": \"Advanced Medical Imaging Techniques\"\n        },\n        {\n            \"title\": \"Biomarker Detection Using Sensor Technology\"\n        },\n        {\n            \"title\": \"Medical Device Safety Standards\"\n        }\n    ],\n    \"claims\": [\n        \"A medical sensor for detecting biomarkers.\",\n        \"A method for in-vivo diagnostics using the sensor.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69197", "text": "{\n    \"patent_title\": \"Method and System for Image Recognition Using Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for image recognition utilizing deep neural networks. The system employs convolutional neural network layers to extract features from images, followed by fully connected layers for classification. The method improves accuracy and efficiency in image recognition tasks.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US20100256981A1\",\n            \"filing_date\": \"2010-01-01\"\n        },\n        {\n            \"patent_number\": \"US20150323456A1\",\n            \"filing_date\": \"2015-02-10\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69197", "text": "{\n    \"patent_title\": \"Data Compression Algorithm Using Fractal Geometry\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US8654321B1\",\n    \"priority_date\": \"2016-08-20\",\n    \"filing_date\": \"2016-08-20\",\n    \"issue_date\": \"2018-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel data compression algorithm based on fractal geometry. The algorithm achieves high compression ratios by identifying self-similar patterns within the data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6789012B1\",\n            \"filing_date\": \"1998-05-05\"\n        },\n        {\n            \"patent_number\": \"US20050123456A1\",\n            \"filing_date\": \"2005-03-17\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising...\",\n        \"A system for data compression comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69198", "text": "{\n    \"patent_title\": \"Miniature Implantable Wireless Pressure Sensor\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford Hospital\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature, implantable, wireless pressure sensor for monitoring physiological parameters. The sensor transmits data wirelessly to an external receiver.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Wireless Physiological Monitoring System\"\n        }\n    ],\n    \"claims\": [\n        \"A miniature implantable pressure sensor.\",\n        \"A wireless communication module for transmitting pressure data.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69198", "text": "{\n    \"patent_title\": \"Surgical Robotic Arm with Enhanced Precision\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Boston Medical Center\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2016-11-01\",\n    \"issue_date\": \"2020-02-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical robotic arm designed to improve precision and dexterity during minimally invasive surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Robotic Surgical System\"\n        }\n    ],\n    \"claims\": [\n        \"A robotic arm for surgical procedures.\",\n        \"A control system for precise movement.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69199", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Biomarker Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"David Jones\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-08-20\",\n    \"issue_date\": \"2021-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for rapid and sensitive detection of biomarkers in biological samples.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Similar microfluidic design\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for detecting biomarkers...\",\n        \"The device of claim 1, wherein...\",\n        \"The method of claim 2, wherein...\",\n        \"The device of claim 3, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69199", "text": "{\n    \"patent_title\": \"Surgical Instrument for Minimally Invasive Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-02-15\",\n    \"issue_date\": \"2020-12-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical instrument designed for enhanced precision in minimally invasive procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related surgical tool design\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising...\",\n        \"A method for performing surgery...\",\n        \"The instrument of claim 1, wherein...\",\n        \"The method of claim 2, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69200", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Processing Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method and system for enhancing image processing capabilities through the application of deep learning algorithms. The system utilizes convolutional neural networks to achieve superior image recognition and object detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"title\": \"Image Filtering Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution using deep learning.\",\n        \"A system comprising a convolutional neural network for image analysis.\",\n        \"The method of claim 1, wherein the deep learning model is trained on a large dataset of images.\",\n        \"The system of claim 2, wherein the convolutional neural network includes multiple layers.\",\n        \"A computer-readable medium storing instructions for performing the method of claim 1.\",\n        \"A method for object detection within an image using the system of claim 2.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69200", "text": "{\n    \"patent_title\": \"Wireless Communication System with Improved Signal Strength\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Bell Labs\"\n        }\n    ],\n    \"patent_number\": \"US10112233A1\",\n    \"priority_date\": \"2012-03-10\",\n    \"filing_date\": \"2012-03-10\",\n    \"issue_date\": \"2019-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a wireless communication system designed to improve signal strength and reduce interference. It employs advanced modulation techniques and error correction codes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Modulation Techniques for Wireless Communication\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication system comprising a transmitter and a receiver.\",\n        \"The system of claim 1, wherein the transmitter uses quadrature amplitude modulation.\",\n        \"A method for improving signal strength in a wireless communication system.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69201", "text": "{\n    \"patent_title\": \"System and Method for Predictive Maintenance Using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Acme Corporation\"\n        },\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Beta Technologies\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2017-05-15\",\n    \"issue_date\": \"2019-01-29\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for predicting equipment failure using machine learning algorithms. The system analyzes sensor data to identify patterns indicative of impending failures, allowing for proactive maintenance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related Art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predicting equipment failure comprising...\",\n        \"A method for analyzing sensor data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69201", "text": "{\n    \"patent_title\": \"Improved Combustion Engine Design\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Acme Corporation\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Beta Technologies\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-11-10\",\n    \"filing_date\": \"2016-11-10\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel design for an internal combustion engine that improves fuel efficiency and reduces emissions. The engine incorporates a new combustion chamber geometry and fuel injection system.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related Art\"\n        }\n    ],\n    \"claims\": [\n        \"An internal combustion engine comprising...\",\n        \"A combustion chamber with a specific geometry...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69202", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2015-03-15\",\n    \"filing_date\": \"2015-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a miniature wireless pressure sensor system for real-time monitoring of various parameters. The sensor utilizes micro-electromechanical systems (MEMS) technology and transmits data wirelessly to a remote base station.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Wireless Data Transmission System\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising a MEMS pressure sensor...\",\n        \"A method for wirelessly transmitting pressure data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69202", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Robert Jones\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-05-20\",\n    \"filing_date\": \"2016-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel lithium-ion battery design with enhanced energy density and cycle life, suitable for use in mobile electronic devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Miniature Wireless Pressure Sensor System\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery cell comprising...\",\n        \"A method for manufacturing a high-energy density battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69203", "text": "{\n    \"patent_title\": \"Wireless Sensor Network for Environmental Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2018-03-01\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless sensor network for monitoring environmental conditions such as temperature, humidity, and air quality. The system utilizes low-power sensors and a mesh network topology for reliable data transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Low-Power Wireless Communication Protocol\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor network comprising a plurality of sensor nodes...\",\n        \"A method for monitoring environmental conditions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69203", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11123456B2\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2018-02-15\",\n    \"issue_date\": \"2020-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor providing continuous glucose monitoring and wireless data transmission to an external device. This allows for real-time management of diabetes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Implantable Medical Device Power Management\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Method for Continuous Glucose Monitoring\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable glucose sensor comprising...\",\n        \"A method for continuously monitoring glucose levels...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69204", "text": "{\n    \"patent_title\": \"System and method for image-based object recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-06-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for performing image recognition using deep convolutional neural networks. The system accurately identifies objects within images, enhancing performance in various applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image analysis utilizing...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69204", "text": "{\n    \"patent_title\": \"Advanced image processing techniques\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Eve Franklin\",\n            \"affiliation\": \"Caltech\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2021-02-28\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-08-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"Novel image processing algorithms for enhancing image quality and extracting relevant features. The techniques improve the clarity and detail of images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"similar\"\n        }\n    ],\n    \"claims\": [\n        \"An image processing method characterized by...\",\n        \"A system for enhancing image resolution...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69205", "text": "{\n    \"patent_title\": \"Magnetic Resonance Imaging with Optimized Contrast Agents\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-06-20\",\n    \"issue_date\": \"2018-12-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to improved magnetic resonance imaging (MRI) techniques utilizing novel contrast agents for enhanced visualization of tissues and organs. The contrast agents exhibit improved biocompatibility and target specificity, leading to higher image quality and more accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"kind\": \"Cited by Applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A method for performing MRI comprising...\",\n        \"A contrast agent comprising...\",\n        \"A system for MRI imaging comprising...\",\n        \"The contrast agent of claim 2...\",\n        \"The method of claim 1...\",\n        \"The system of claim 3...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69205", "text": "{\n    \"patent_title\": \"Digital X-Ray Image Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2011-05-22\",\n    \"filing_date\": \"2011-08-15\",\n    \"issue_date\": \"2017-04-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes methods for digitally enhancing the quality of X-ray images, improving clarity and reducing noise. It focuses on algorithms for image processing and display.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"kind\": \"Cited by Examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing a digital X-ray image...\",\n        \"A system for processing X-ray images...\",\n        \"The method of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69206", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrolyte Composition\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an improved electrolyte composition for lithium-ion batteries, resulting in enhanced energy density and cycle life. The composition includes a novel additive that mitigates dendrite formation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Similar electrolyte composition\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrolyte comprising...\",\n        \"A method for improving the cycle life of a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69206", "text": "{\n    \"patent_title\": \"Novel Lead-Acid Battery Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Green\",\n            \"affiliation\": \"California Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2021-03-10\",\n    \"issue_date\": \"2023-01-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel design for lead-acid batteries, improving their performance and reducing their environmental impact. A new plate geometry is utilized for enhanced energy storage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art lead-acid battery design\"\n        }\n    ],\n    \"claims\": [\n        \"A lead-acid battery comprising...\",\n        \"A method for manufacturing a lead-acid battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69207", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2015-03-15\",\n    \"filing_date\": \"2015-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications. The sensor utilizes MEMS technology and a low-power communication protocol.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for measuring pressure using a wireless sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69207", "text": "{\n    \"patent_title\": \"Improved Image Sensor Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Eve Franklin\",\n            \"affiliation\": \"Caltech\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-05-20\",\n    \"filing_date\": \"2016-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved image sensor technology utilizing novel pixel designs for enhanced light sensitivity and reduced noise.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"An image sensor comprising...\",\n        \"A method for capturing images using an improved image sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69208", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery with Enhanced Cycle Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10500000B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2021-11-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel lithium-ion battery design incorporating a new electrolyte composition and electrode structure, resulting in significantly enhanced cycle life and improved energy density. The battery is suitable for use in electric vehicles and portable electronic devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"The lithium-ion battery of claim 1, wherein...\",\n        \"An electrolyte composition for use in a lithium-ion battery...\",\n        \"A method of manufacturing a lithium-ion battery...\",\n        \"An electric vehicle powered by the lithium-ion battery of claim 1.\",\n        \"The lithium-ion battery of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69208", "text": "{\n    \"patent_title\": \"Novel Electrolyte for Sodium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2019-12-01\",\n    \"filing_date\": \"2019-12-01\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel electrolyte composition for sodium-ion batteries. The electrolyte enhances ionic conductivity and improves battery performance at low temperatures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Relevant background art\"\n        }\n    ],\n    \"claims\": [\n        \"A sodium-ion battery comprising...\",\n        \"The sodium-ion battery of claim 1, wherein...\",\n        \"An electrolyte composition for use in a sodium-ion battery...\",\n        \"A method of manufacturing a sodium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69209", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Thermal Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2015-03-15\",\n    \"filing_date\": \"2015-05-20\",\n    \"issue_date\": \"2017-06-13\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery with an improved electrolyte composition and cell structure, resulting in enhanced thermal stability and cycle life. The electrolyte contains a novel additive that suppresses dendrite formation. This design improves safety and performance for various applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8652456B2\",\n            \"relevance\": \"Related prior art on electrolyte additives.\"\n        }\n    ],\n    \"claims\": [\n        \"1. A lithium-ion battery comprising...\",\n        \"2. The lithium-ion battery of claim 1, wherein...\",\n        \"3. The lithium-ion battery of claim 1, further comprising...\",\n        \"4. The lithium-ion battery of claim 2, wherein...\",\n        \"5. The lithium-ion battery of claim 3, wherein...\",\n        \"6. A method of manufacturing a lithium-ion battery...\",\n        \"7. The method of claim 6, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69209", "text": "{\n    \"patent_title\": \"Solid-State Electrolyte for Sodium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10456789B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2017-02-10\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel solid-state electrolyte material for sodium-ion batteries, exhibiting high ionic conductivity and electrochemical stability. This invention focuses on improving energy density and safety in battery technology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Background art on solid-state electrolytes.\"\n        }\n    ],\n    \"claims\": [\n        \"1. A solid-state electrolyte comprising...\",\n        \"2. The solid-state electrolyte of claim 1, wherein...\",\n        \"3. A sodium-ion battery comprising the solid-state electrolyte...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69210", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-06-15\",\n    \"filing_date\": \"2010-03-20\",\n    \"issue_date\": \"2018-07-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system designed to improve the efficiency and lifespan of lithium-ion batteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Battery Charging Circuit\"\n        },\n        {\n            \"patent_number\": \"US8210543B2\",\n            \"title\": \"Thermal Management System for Batteries\"\n        },\n        {\n            \"patent_number\": \"US9123456B1\",\n            \"title\": \"Advanced Battery Cell Design\"\n        },\n        {\n            \"patent_number\": \"US10234567B2\",\n            \"title\": \"Battery Monitoring Techniques\"\n        },\n        {\n            \"patent_number\": \"US11345678B1\",\n            \"title\": \"Optimized Battery Discharge Control\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for managing battery charge...\",\n        \"A system for monitoring battery temperature...\"\n    ]\n}"}
