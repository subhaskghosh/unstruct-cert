{"_id": "Academic--patents--n--66202", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-12-01\",\n    \"filing_date\": \"2020-06-20\",\n    \"issue_date\": \"2021-08-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system that optimizes charging and discharging cycles for improved battery life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66203", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Enhancement for Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-06-15\",\n    \"filing_date\": \"2020-03-01\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel deep learning architecture for enhancing the quality of medical images, improving diagnostic accuracy. The system leverages convolutional neural networks and generative adversarial networks to remove noise and artifacts while preserving essential image details.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11111111B1\",\n            \"title\": \"Image Denoising Using Wavelet Transform\"\n        },\n        {\n            \"patent_number\": \"US22222222B1\",\n            \"title\": \"Medical Image Segmentation with Convolutional Neural Networks\"\n        },\n        {\n            \"patent_number\": \"US33333333B1\",\n            \"title\": \"Adaptive Histogram Equalization for Image Contrast Enhancement\"\n        },\n        {\n            \"patent_number\": \"US44444444B1\",\n            \"title\": \"Deep Convolutional Neural Networks for Image Classification\"\n        },\n        {\n            \"patent_number\": \"US55555555B1\",\n            \"title\": \"Generative Adversarial Networks for Image Synthesis\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing medical images using a deep learning model.\",\n        \"A system comprising a convolutional neural network and a generative adversarial network.\",\n        \"The method according to claim 1, wherein the deep learning model is trained on a dataset of medical images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66203", "text": "{\n    \"patent_title\": \"Method for Compressing Digital Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US98765432B2\",\n    \"priority_date\": \"2018-12-10\",\n    \"filing_date\": \"2020-05-15\",\n    \"issue_date\": \"2021-09-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a new algorithm for compressing digital images, reducing file size while maintaining acceptable image quality. It employs a combination of wavelet transform and entropy coding.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US66666666B1\",\n            \"title\": \"JPEG Image Compression Standard\"\n        },\n        {\n            \"patent_number\": \"US77777777B1\",\n            \"title\": \"Lossless Image Compression Using Lempel-Ziv-Welch Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing digital images using wavelet transform.\",\n        \"A system for encoding and decoding compressed images.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66204", "text": "{\n    \"patent_title\": \"System and Method for Dynamic Spectrum Allocation\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-03-15\",\n    \"filing_date\": \"2010-05-20\",\n    \"issue_date\": \"2018-07-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for dynamically allocating spectrum resources based on real-time demand and interference levels. The system utilizes a centralized controller to manage spectrum allocation and optimize network performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Spectrum Sensing Techniques\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"title\": \"Interference Management System\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Dynamic Resource Allocation in Wireless Networks\"\n        },\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Cognitive Radio Systems\"\n        },\n        {\n            \"patent_number\": \"US9345678B2\",\n            \"title\": \"Adaptive Modulation and Coding\"\n        }\n    ],\n    \"claims\": [\n        \"A system for dynamically allocating spectrum resources...\",\n        \"A method for managing interference levels...\"\n    ]\n}"}
