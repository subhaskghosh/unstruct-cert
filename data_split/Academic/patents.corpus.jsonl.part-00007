{"_id": "Academic--patents--p--66699", "text": "{\n    \"patent_title\": \"System and Method for Anomaly Detection Using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for anomaly detection in time series data using machine learning algorithms. The system is designed for early identification of potential failures in industrial equipment.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for anomaly detection comprising...\",\n        \"A method for identifying anomalies...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66699", "text": "{\n    \"patent_title\": \"Improved Engine Control System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2019-11-20\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2021-04-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved engine control system for enhancing fuel efficiency and reducing emissions. The system utilizes advanced sensors and control algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"An engine control system comprising...\",\n        \"A method for controlling engine performance...\"\n    ]\n}"}
