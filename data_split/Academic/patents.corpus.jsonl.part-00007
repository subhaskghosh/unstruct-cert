{"_id": "Academic--patents--p--66057", "text": "{\n    \"patent_title\": \"Method and System for Personalized Medicine Using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2021-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for predicting patient response to treatment using machine learning algorithms. The system analyzes patient data to identify personalized treatment plans.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Similar machine learning approach\"\n        }\n    ],\n    \"claims\": [\n        \"A method for predicting patient response to treatment comprising...\",\n        \"A system for analyzing patient data...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The method of claim 1, wherein the machine learning algorithm is a neural network.\",\n        \"The system of claim 2, further comprising a user interface.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66057", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-01-10\",\n    \"filing_date\": \"2019-01-10\",\n    \"issue_date\": \"2022-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery technology with improved energy density and charging speed for electric vehicle applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related battery chemistry\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising...\",\n        \"An electric vehicle utilizing the battery cell of claim 1.\",\n        \"A method for manufacturing the battery cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66058", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-06-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the resolution of digital images using deep convolutional neural networks. The system leverages a generative adversarial network (GAN) to produce high-resolution images from low-resolution inputs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Super-Resolution Using Convolutional Neural Networks\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Generative Adversarial Networks\"\n        },\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"title\": \"Deep Learning for Image Recognition\"\n        },\n        {\n            \"patent_number\": \"US12112233B2\",\n            \"title\": \"Image Enhancement Techniques\"\n        },\n        {\n            \"patent_number\": \"US13131313B2\",\n            \"title\": \"High-Resolution Image Reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing the resolution of a digital image...\",\n        \"A system comprising a deep convolutional neural network...\"\n    ]\n}"}
