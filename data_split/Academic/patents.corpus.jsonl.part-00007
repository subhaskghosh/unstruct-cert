{"_id": "Academic--patents--p--66841", "text": "{\n    \"patent_title\": \"System and method for machine learning based anomaly detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Sergey Levine\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Pieter Abbeel\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for detecting anomalies in data using machine learning techniques. The system learns a model of normal data behavior and identifies deviations from this model as anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8769032B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for anomaly detection comprising...\",\n        \"A method for training a machine learning model...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66841", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US8901234B1\",\n    \"priority_date\": \"2015-06-20\",\n    \"filing_date\": \"2015-06-20\",\n    \"issue_date\": \"2018-04-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved battery management system for electric vehicles, optimizing charging and discharging cycles to extend battery life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling charging current...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66842", "text": "{\n    \"patent_title\": \"System and Method for Automated Code Generation Using Artificial Intelligence\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for automated code generation using artificial intelligence techniques. The system analyzes natural language descriptions of desired functionalities and translates them into executable code, improving software development efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art in code analysis\"\n        }\n    ],\n    \"claims\": [\n        \"A method for automated code generation comprising...\",\n        \"A system for translating natural language into code...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66842", "text": "{\n    \"patent_title\": \"AI-Powered Diagnostic Tool for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Medical Research Labs\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-03-15\",\n    \"filing_date\": \"2022-03-15\",\n    \"issue_date\": \"2024-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an AI-powered diagnostic tool for the early detection of cancer. The system utilizes machine learning algorithms to analyze medical images and identify potential cancerous tissues with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"relevance\": \"Prior art in medical imaging analysis\"\n        }\n    ],\n    \"claims\": [\n        \"A diagnostic system comprising an AI module for cancer detection...\",\n        \"A method for analyzing medical images using machine learning...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66843", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-12-15\",\n    \"filing_date\": \"2019-06-20\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the resolution of an image using deep convolutional neural networks. The system is trained on a large dataset of high-resolution images and can effectively upscale low-resolution images while preserving detail.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising...\",\n        \"A system for processing images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66843", "text": "{\n    \"patent_title\": \"Real-time Object Detection in Video Streams\",\n    \"inventors\": [\n        {\n            \"name\": \"Yann LeCun\",\n            \"affiliation\": \"New York University\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2017-03-10\",\n    \"filing_date\": \"2018-09-05\",\n    \"issue_date\": \"2022-01-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for real-time object detection in video streams using convolutional neural networks. The system can identify and track multiple objects in a video stream with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for detecting objects in a video stream comprising...\",\n        \"A method for tracking objects...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66844", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-03-15\",\n    \"filing_date\": \"2015-06-20\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor for continuous monitoring of blood glucose levels, featuring wireless communication capabilities for data transmission to external devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Prior Art Glucose Sensor\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Wireless Communication Protocol\"\n        },\n        {\n            \"patent_number\": \"US9654321B1\",\n            \"title\": \"Implantable Device Packaging\"\n        }\n    ],\n    \"claims\": [\n        \"A glucose sensor comprising a glucose-sensitive electrode...\",\n        \"A wireless communication module for transmitting glucose data...\",\n        \"A method for continuously monitoring glucose levels...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66844", "text": "{\n    \"patent_title\": \"Surgical Instrument for Minimally Invasive Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-01-10\",\n    \"filing_date\": \"2016-07-15\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical instrument designed for precise and minimally invasive surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Existing Surgical Instrument\"\n        },\n        {\n            \"patent_number\": \"US8901234B1\",\n            \"title\": \"Miniaturization Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising a handle and a shaft...\",\n        \"A cutting mechanism positioned at the distal end of the shaft...\",\n        \"A method for performing minimally invasive surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66845", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Recognition Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-11-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-05-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for improving the accuracy of image recognition using a deep learning algorithm. The system utilizes convolutional neural networks to identify features in images and classify them with high precision.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Classification System\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for image recognition comprising...\",\n        \"2. A system for image analysis...\",\n        \"3. The method of claim 1, wherein...\",\n        \"4. The system of claim 2, further comprising...\",\n        \"5. A computer-readable medium storing...\",\n        \"6. A method for improving image quality...\",\n        \"7. A system for object detection...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66845", "text": "{\n    \"patent_title\": \"Novel Image Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-08-01\",\n    \"filing_date\": \"2019-12-20\",\n    \"issue_date\": \"2021-04-13\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new method for compressing images to reduce file size without significant loss of quality. The technique utilizes wavelet transforms and entropy encoding.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Image Compression Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for image compression comprising...\",\n        \"2. A system for encoding images...\",\n        \"3. The method of claim 1, wherein...\"\n    ]\n}"}
