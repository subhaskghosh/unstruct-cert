{"_id": "Academic--patents--p--69832", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition using deep convolutional neural networks. The system improves accuracy and efficiency in identifying objects within images. Applications include autonomous vehicles and medical diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for image recognition comprising...\",\n        \"2. The method of claim 1, wherein...\",\n        \"3. A system for image recognition comprising...\",\n        \"4. The system of claim 3, wherein...\",\n        \"5. The method of claim 1, further comprising...\",\n        \"6. The system of claim 3, further comprising...\",\n        \"7. A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69832", "text": "{\n    \"patent_title\": \"Method for Data Compression and Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2011-07-20\",\n    \"filing_date\": \"2011-07-20\",\n    \"issue_date\": \"2018-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel data compression technique utilizing Huffman coding and run-length encoding to reduce file size and improve transmission speed.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for data compression comprising...\",\n        \"2. The method of claim 1, wherein...\",\n        \"3. A system for data compression comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69833", "text": "{\n    \"patent_title\": \"Deep Convolutional Neural Networks for Image Classification\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-04-13\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep convolutional neural network architecture for accurately classifying images with improved efficiency and robustness.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Recognition System\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Object Detection Method\"\n        },\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Feature Extraction Algorithm\"\n        },\n        {\n            \"patent_number\": \"US6543210B2\",\n            \"title\": \"Neural Network Training Technique\"\n        },\n        {\n            \"patent_number\": \"US5432109B1\",\n            \"title\": \"Image Segmentation Approach\"\n        }\n    ],\n    \"claims\": [\n        \"A method for classifying images using a deep convolutional neural network.\",\n        \"A system for performing image recognition based on extracted features.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69833", "text": "{\n    \"patent_title\": \"Method for Automated Image Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11223344B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-07-10\",\n    \"issue_date\": \"2022-01-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A technique to automatically enhance the quality of digital images by adjusting contrast and brightness.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B1\",\n            \"title\": \"Image Processing Algorithm\"\n        },\n        {\n            \"patent_number\": \"US8234567B2\",\n            \"title\": \"Contrast Enhancement Method\"\n        },\n        {\n            \"patent_number\": \"US7345678B1\",\n            \"title\": \"Brightness Adjustment System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image contrast.\",\n        \"A system for automatically adjusting image brightness.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69834", "text": "{\n    \"patent_title\": \"High-Performance Lithium-Ion Battery with Novel Electrolyte\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a high-performance lithium-ion battery utilizing a novel electrolyte composition for improved energy density and cycle life. The electrolyte enhances ion conductivity and suppresses dendrite formation, leading to a safer and more durable battery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition...\",\n        \"A method for manufacturing...\",\n        \"The battery of claim 1, wherein...\",\n        \"The electrolyte composition of claim 2, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69834", "text": "{\n    \"patent_title\": \"Improved Lead-Acid Battery Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Exide Technologies\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved lead-acid battery design featuring enhanced electrode materials and a more efficient charging system.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A lead-acid battery comprising...\",\n        \"An electrode material...\",\n        \"A charging system...\",\n        \"The battery of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69835", "text": "{\n    \"patent_title\": \"System and Method for Personalized Recommendations Using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-11-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for providing personalized recommendations to users based on machine learning algorithms. The system analyzes user behavior and preferences to predict relevant items.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating personalized recommendations...\",\n        \"A system comprising a machine learning module...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69835", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"Tesla Motors\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-08-01\",\n    \"filing_date\": \"2020-10-15\",\n    \"issue_date\": \"2021-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a battery management system designed to improve the lifespan and efficiency of lithium-ion batteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for monitoring battery health...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69836", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Predictive Maintenance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of Innovation\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2012-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for predictive maintenance using artificial intelligence algorithms to analyze sensor data and predict equipment failures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predictive maintenance comprising...\",\n        \"A method for analyzing sensor data using AI...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69836", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Cycle Dynamics Ltd.\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Independent Inventor\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2009-11-01\",\n    \"filing_date\": \"2009-11-01\",\n    \"issue_date\": \"2011-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved bicycle brake system utilizing a novel cable tensioning mechanism for enhanced stopping power and responsiveness.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle brake system comprising...\",\n        \"A cable tensioning mechanism...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69837", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Battery Management in Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Tesla, Inc.\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2012-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel system and method for battery management in electric vehicles. It improves battery life, efficiency, and safety by optimizing charging and discharging processes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for managing a battery...\",\n        \"A method for optimizing battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69837", "text": "{\n    \"patent_title\": \"Improved Solar Cell Efficiency\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2009-12-10\",\n    \"filing_date\": \"2009-12-10\",\n    \"issue_date\": \"2011-08-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a novel design for solar cells that significantly improves energy conversion efficiency. It utilizes new materials and fabrication techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US81234567B2\"\n        }\n    ],\n    \"claims\": [\n        \"A solar cell comprising...\",\n        \"A method for fabricating a solar cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69838", "text": "{\n    \"patent_title\": \"Method and System for Image Recognition Using Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-10\",\n    \"filing_date\": \"2011-05-09\",\n    \"issue_date\": \"2019-04-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for image recognition utilizing convolutional neural networks. The system processes image data to identify objects and features with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image processing...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69838", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Tesla\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2009-12-15\",\n    \"filing_date\": \"2009-12-14\",\n    \"issue_date\": \"2018-03-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for managing battery charge and discharge cycles, improving efficiency and lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery performance...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69839", "text": "{\n    \"patent_title\": \"Neural Network Based Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel neural network architecture for image recognition. The network utilizes convolutional layers and recurrent layers to achieve high accuracy in identifying objects in images. This system dramatically improves object detection and recognition.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition using a neural network.\",\n        \"A system comprising a convolutional neural network.\",\n        \"The system of claim 1, further comprising a recurrent neural network.\",\n        \"The method of claim 1, wherein the neural network is trained on a labeled dataset.\",\n        \"The system of claim 2, wherein the recurrent neural network improves temporal consistency of image processing.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69839", "text": "{\n    \"patent_title\": \"Improved Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2019-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new data compression algorithm utilizing Huffman coding and run-length encoding. The algorithm achieves significant compression ratios with low computational overhead.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Relevant prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression using Huffman coding.\",\n        \"A system for implementing the data compression method.\",\n        \"The method of claim 1, wherein run-length encoding is also utilized.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69840", "text": "{\n    \"patent_title\": \"Wireless Sensor Network for Environmental Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless sensor network for monitoring environmental conditions such as temperature, humidity, and pressure. The network utilizes low-power sensors and a mesh topology for robust communication.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A system for monitoring environmental conditions comprising a plurality of wireless sensors.\",\n        \"The system of claim 1, wherein the sensors measure temperature, humidity, and pressure.\",\n        \"The system of claim 1, wherein the sensors are configured to transmit data using a mesh topology.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69840", "text": "{\n    \"patent_title\": \"Implantable Biosensor for Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable biosensor for continuous glucose monitoring in diabetic patients. The sensor utilizes enzymatic reactions to detect glucose levels in bodily fluids.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A biosensor for in-vivo glucose monitoring comprising an enzymatic reaction chamber.\",\n        \"The biosensor of claim 1, wherein the enzymatic reaction chamber contains glucose oxidase.\",\n        \"The biosensor of claim 1, adapted for implantation within a patient.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69841", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2015-03-15\",\n    \"filing_date\": \"2015-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for implantable medical devices. The system incorporates a low-power MEMS pressure sensor, a wireless communication module, and a biocompatible energy harvesting unit. The sensor provides accurate and real-time pressure measurements.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Wireless Medical Sensor Network\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for measuring pressure using the wireless sensor system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69841", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-05-20\",\n    \"filing_date\": \"2016-05-20\",\n    \"issue_date\": \"2019-04-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery management system for electric vehicles. This system enhances battery life and performance by optimizing charging and discharging cycles. It employs advanced algorithms for thermal management and cell balancing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Lithium-Ion Battery Control System\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling battery charging and discharging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69842", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-14\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to improved electrode materials for lithium-ion batteries, enhancing energy density and cycle life. The materials comprise a novel composite structure…\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7682722B2\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an anode, a cathode, and an electrolyte.\",\n        \"The lithium-ion battery of claim 1, wherein the cathode comprises a novel composite material.\",\n        \"The lithium-ion battery of claim 2, wherein the composite material exhibits enhanced energy density.\",\n        \"The lithium-ion battery of claim 3, wherein the composite material exhibits improved cycle life.\",\n        \"A method of manufacturing the lithium-ion battery of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69842", "text": "{\n    \"patent_title\": \"Novel Polymer Electrolyte for Fuel Cells\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US8546210B1\",\n    \"priority_date\": \"2009-12-01\",\n    \"filing_date\": \"2009-11-30\",\n    \"issue_date\": \"2013-10-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel polymer electrolyte for use in fuel cells, exhibiting high proton conductivity and improved thermal stability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7202104B2\"\n        }\n    ],\n    \"claims\": [\n        \"A polymer electrolyte comprising a sulfonated polymer matrix.\",\n        \"The polymer electrolyte of claim 1, exhibiting a proton conductivity of at least 10^-2 S/cm.\",\n        \"The polymer electrolyte of claim 2, exhibiting a thermal stability up to 150°C.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69843", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Neural Network Training\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-11-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2023-01-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method and system for training neural networks with improved efficiency and accuracy. The system utilizes a dynamic learning rate adjustment technique to optimize the training process.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in neural network training.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for training a neural network comprising...\",\n        \"A system for implementing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69843", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2018-05-20\",\n    \"filing_date\": \"2020-07-15\",\n    \"issue_date\": \"2022-12-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a battery management system designed to improve the lifespan and performance of lithium-ion batteries. The system incorporates advanced thermal management techniques and predictive algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related to battery thermal management.\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling battery temperature...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69844", "text": "{\n    \"patent_title\": \"System and Method for Automated Data Analysis Using Artificial Intelligence\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system and method for automated data analysis using artificial intelligence techniques. The system comprises a data input module, an AI processing module, and a data output module. It provides improved efficiency and accuracy in data processing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for automated data analysis comprising...\",\n        \"A method for processing data using artificial intelligence...\",\n        \"The system of claim 1, wherein the AI processing module utilizes machine learning algorithms.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69844", "text": "{\n    \"patent_title\": \"AI-Powered Diagnostic System for Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Medical Tech Solutions\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2019-02-20\",\n    \"filing_date\": \"2019-02-20\",\n    \"issue_date\": \"2021-07-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An artificial intelligence-powered system for analyzing medical images to assist in the diagnosis of diseases. The system provides accurate and efficient diagnostic results.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10456789B2\"\n        }\n    ],\n    \"claims\": [\n        \"A diagnostic system comprising an AI module for analyzing medical images...\",\n        \"The system of claim 1, wherein the AI module is trained on a dataset of medical images.\",\n        \"A method for diagnosing a medical condition using the system of claim 1.\",\n        \"The method of claim 3, wherein the medical condition is cancer.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69845", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-06-15\",\n    \"issue_date\": \"2018-03-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing image processing algorithms, focusing on noise reduction and edge detection in digital photographs. The technique utilizes a novel filtering approach to improve image clarity and detail without introducing artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on image filtering\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image comprising...\",\n        \"A system for processing images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69845", "text": "{\n    \"patent_title\": \"Medical Image Analysis System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"HealthTech Solutions\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10243876B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2018-01-05\",\n    \"issue_date\": \"2019-05-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for analyzing medical images to detect anomalies and assist in diagnosis. This invention utilizes advanced image processing techniques to identify potential tumors and lesions in MRI and CT scans. The system provides a detailed report of its findings for medical professionals.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related work in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A system for analyzing medical images...\",\n        \"A method for detecting tumors...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69846", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhanced data compression using a novel algorithm to reduce file sizes while maintaining data integrity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"Claim 1: A method for compressing data...\",\n        \"Claim 2: A system for compressing data...\",\n        \"Claim 3: A computer-readable medium...\",\n        \"Claim 4: The method of claim 1...\",\n        \"Claim 5: The system of claim 2...\",\n        \"Claim 6: The computer-readable medium of claim 3...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69846", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery technology with increased energy density and lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"Claim 1: A battery comprising...\",\n        \"Claim 2: The battery of claim 1...\",\n        \"Claim 3: A device incorporating the battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69847", "text": "{\n    \"patent_title\": \"Wireless Sensor Network for Environmental Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless sensor network is described for monitoring environmental conditions. The network utilizes low-power sensors and a mesh topology for reliable data transmission. The system includes a central gateway for data aggregation and analysis. The sensors measure temperature, humidity, and pressure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Data Communication Protocol\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor network comprising...\",\n        \"A method for monitoring environmental conditions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69847", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2012-03-10\",\n    \"filing_date\": \"2012-03-10\",\n    \"issue_date\": \"2020-05-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor is disclosed, providing continuous monitoring of blood glucose levels. The sensor communicates wirelessly with an external receiver for data display and analysis. This device aims to improve the management of diabetes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Miniature Medical Sensor Design\"\n        },\n        {\n            \"patent_number\": \"US9123456B1\",\n            \"title\": \"Wireless Communication for Medical Implants\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable glucose sensor comprising...\",\n        \"A method for continuous glucose monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69848", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Sensor for Biomedical Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-06-15\",\n    \"issue_date\": \"2020-11-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized wireless sensor system for real-time monitoring of physiological parameters. The sensor utilizes low-power communication protocols and biocompatible materials.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor comprising...\",\n        \"A method for monitoring physiological parameters...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69848", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"California Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2019-03-10\",\n    \"filing_date\": \"2019-04-10\",\n    \"issue_date\": \"2021-02-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery design with enhanced energy density and improved charging characteristics for electric vehicle applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US1012345678B1\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising...\",\n        \"A method for charging a battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69849", "text": "{\n    \"patent_title\": \"Method and System for Efficient Neural Network Training\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-05-15\",\n    \"filing_date\": \"2020-06-15\",\n    \"issue_date\": \"2022-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for training neural networks with improved efficiency and reduced computational cost. The system utilizes a distributed training approach and optimized gradient descent algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Highly Relevant\"\n        },\n        {\n            \"patent_number\": \"US1012345678B2\",\n            \"relevance\": \"Relevant\"\n        },\n        {\n            \"patent_number\": \"US1122334455B2\",\n            \"relevance\": \"Related\"\n        },\n        {\n            \"patent_number\": \"US1213141516B2\",\n            \"relevance\": \"Related\"\n        },\n        {\n            \"patent_number\": \"US1314151617B2\",\n            \"relevance\": \"Related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for training a neural network comprising...\",\n        \"A system for distributed neural network training...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69849", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2021-03-10\",\n    \"filing_date\": \"2021-04-10\",\n    \"issue_date\": \"2022-09-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles, providing enhanced safety and performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\",\n            \"relevance\": \"Highly Relevant\"\n        },\n        {\n            \"patent_number\": \"US8901234567B2\",\n            \"relevance\": \"Relevant\"\n        },\n        {\n            \"patent_number\": \"US9012345678B2\",\n            \"relevance\": \"Related\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for monitoring battery health...\",\n        \"A control circuit for regulating battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69850", "text": "{\n    \"patent_title\": \"Method for Optimized Neural Network Training\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for optimizing the training of neural networks using a novel gradient descent algorithm. This approach significantly reduces training time and improves model accuracy. The invention utilizes adaptive learning rates and momentum techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on gradient descent\"\n        }\n    ],\n    \"claims\": [\n        \"A method for training a neural network, comprising...\",\n        \"The method of claim 1, wherein the learning rate is...\",\n        \"The method of claim 2, further comprising...\",\n        \"A neural network trained by the method of claim 1.\",\n        \"A computer-readable medium storing instructions for...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69850", "text": "{\n    \"patent_title\": \"Neural Network System for Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11334455B1\",\n    \"priority_date\": \"2017-07-10\",\n    \"filing_date\": \"2017-07-10\",\n    \"issue_date\": \"2021-11-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A neural network system for image recognition and classification. The system includes a convolutional neural network architecture and is optimized for performance on mobile devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related image recognition technology\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition, comprising...\",\n        \"The system of claim 1, wherein the neural network is...\",\n        \"The system of claim 2, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69851", "text": "{\n    \"patent_title\": \"AI-Powered Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an artificial intelligence-powered image recognition system for enhanced object detection and classification. The system utilizes deep learning algorithms to achieve high accuracy and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition using artificial intelligence.\",\n        \"A system comprising a deep learning model for object classification.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69851", "text": "{\n    \"patent_title\": \"Improved Mechanical Gear Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Motors\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Ford Motor Company\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2021-01-05\",\n    \"filing_date\": \"2021-03-10\",\n    \"issue_date\": \"2023-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel mechanical gear design providing enhanced durability and reduced friction. The gear utilizes a unique tooth profile and material composition for improved performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Previous gear designs\"\n        }\n    ],\n    \"claims\": [\n        \"A gear with a specific tooth profile.\",\n        \"A material composition for enhanced gear durability.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69852", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Recognition Using Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2023-03-15\",\n    \"filing_date\": \"2023-04-15\",\n    \"issue_date\": \"2024-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method and system for enhanced image recognition using deep neural networks. The system utilizes a convolutional neural network architecture trained on a large dataset of images to achieve state-of-the-art accuracy in object detection and classification.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\",\n        \"The method of claim 1, wherein the neural network...\",\n        \"The system of claim 2, further comprising...\",\n        \"The method of claim 1, wherein the dataset...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69852", "text": "{\n    \"patent_title\": \"System for Real-Time Data Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2023-01-10\",\n    \"filing_date\": \"2023-02-10\",\n    \"issue_date\": \"2023-09-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a system for real-time data analysis utilizing complex algorithms to process information efficiently.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A system for data analysis comprising...\",\n        \"The system of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69853", "text": "{\n    \"patent_title\": \"System and Method for Improved Battery Management\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for battery management in electric vehicles is disclosed. The system monitors battery health and optimizes charging cycles to prolong battery life and improve performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for managing a battery...\",\n        \"The system of claim 1, further comprising...\",\n        \"A method for optimizing battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69853", "text": "{\n    \"patent_title\": \"Advanced Battery Technology for Grid Storage\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Energy Solutions Corp.\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2015-11-01\",\n    \"filing_date\": \"2015-11-01\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention pertains to advanced battery technology designed for large-scale grid energy storage. It includes novel electrode materials and a sophisticated thermal management system.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A battery system for grid storage...\",\n        \"The battery system of claim 1, comprising a novel electrode material...\",\n        \"A method for controlling temperature...\",\n        \"Claim 4, with an additional cooling system...\",\n        \"Claim 5, utilizing phase change materials...\",\n        \"Claim 6, optimized for 5000 cycles...\",\n        \"Claim 7, further including a monitoring system...\",\n        \"Claim 8, integrated with a smart grid...\",\n        \"Claim 9, designed for peak shaving...\",\n        \"Claim 10, capable of bidirectional power flow...\",\n        \"Claim 11, comprising a safety mechanism...\",\n        \"Claim 12, suitable for residential applications...\",\n        \"Claim 13, built with sustainable materials...\",\n        \"Claim 14, optimized for cost-effectiveness...\",\n        \"Claim 15, exhibiting high energy density...\",\n        \"Claim 16, controlled by a machine learning algorithm...\",\n        \"Claim 17, integrated with a renewable energy source...\",\n        \"Claim 18, featuring a modular design...\",\n        \"Claim 19, enhanced with a predictive maintenance system...\",\n        \"Claim 20, utilizing a lithium-sulfur chemistry...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69854", "text": "{\n    \"patent_title\": \"System and method for intelligent image recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for intelligent image recognition using artificial intelligence and deep learning techniques. The system can identify objects, faces, and scenes with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image analysis system\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for image recognition comprising...\",\n        \"2. The system of claim 1, wherein...\",\n        \"3. A method for image analysis comprising...\",\n        \"4. The method of claim 3, wherein...\",\n        \"5. The system of claim 1, further comprising...\",\n        \"6. The method of claim 3, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69854", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2018-11-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new braking system for bicycles offering enhanced stopping power and modulation. Uses a novel lever design and pad material.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"System and method for intelligent image recognition\"\n        }\n    ],\n    \"claims\": [\n        \"1. A bicycle braking system comprising...\",\n        \"2. The system of claim 1, wherein...\",\n        \"3. A lever for a braking system comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69855", "text": "{\n    \"patent_title\": \"Improved Electrolyte Composition for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"EP3123456A1\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2017-09-20\",\n    \"issue_date\": \"2018-06-10\",\n    \"patent_office\": \"European Patent Office\",\n    \"abstract\": \"This invention relates to an improved electrolyte composition for lithium-ion batteries, enhancing energy density and cycle life. The composition includes a novel lithium salt and a solvent mixture.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8878248B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrolyte composition...\",\n        \"The electrolyte composition according to claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69855", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2018-01-15\",\n    \"issue_date\": \"2019-04-22\",\n    \"patent_office\": \"United States Patent and Trademark Office\",\n    \"abstract\": \"A battery management system for lithium-ion batteries, improving safety and performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"WO2015173521A1\",\n            \"relevance\": \"related application\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising a microcontroller...\",\n        \"The battery management system according to claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69856", "text": "{\n    \"patent_title\": \"Method and System for Enhancing Image Clarity Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-11-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-20\",\n    \"patent_office\": \"US\",\n    \"abstract\": \"This invention provides a method and system for enhancing the clarity of digital images using deep learning techniques. The system employs a convolutional neural network to remove noise and artifacts, resulting in improved image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for enhancing image clarity comprising...\",\n        \"2. The method of claim 1, wherein the image is a digital photograph.\",\n        \"3. A system for enhancing image clarity...\",\n        \"4. The system of claim 3, further comprising a display device.\",\n        \"5. The method of claim 1, using a convolutional neural network.\",\n        \"6. The method of claim 5, wherein the network is trained on a dataset of noisy images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69856", "text": "{\n    \"patent_title\": \"Digital Image Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-05-22\",\n    \"filing_date\": \"2019-12-15\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"US\",\n    \"abstract\": \"This invention presents a novel technique for compressing digital images to reduce storage space and bandwidth requirements. The method utilizes wavelet transforms and entropy coding.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10111213B2\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for compressing a digital image comprising...\",\n        \"2. The method of claim 1, wherein the compression ratio is greater than 2:1.\",\n        \"3. A system for compressing digital images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69857", "text": "{\n    \"patent_title\": \"Neural Network Based Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2023-12-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel neural network architecture for improved image recognition accuracy. The system utilizes a convolutional neural network with a unique attention mechanism to focus on relevant features in the input image.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Convolutional Neural Network for Object Detection\"\n        }\n    ],\n    \"claims\": [\n        \"A neural network system for image recognition.\",\n        \"A method for training a neural network...\",\n        \"A computer-readable medium...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69857", "text": "{\n    \"patent_title\": \"Enhanced Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new data compression algorithm that improves compression ratio and speed. It utilizes a combination of Huffman coding and Lempel-Ziv techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Data Compression Method\"\n        }\n    ],\n    \"claims\": [\n        \"A data compression algorithm.\",\n        \"A method for compressing data...\",\n        \"A system for data compression...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69858", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for enhanced image processing, utilizing novel algorithms to improve image clarity and reduce noise. Applications include medical imaging and satellite imagery analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in image filtering\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing an image comprising...\",\n        \"A system for processing an image comprising...\",\n        \"The method of claim 1, wherein...\",\n        \"The system of claim 2, wherein...\",\n        \"The method of claim 3, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69858", "text": "{\n    \"patent_title\": \"Novel Semiconductor Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10111213B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2019-11-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel semiconductor device with improved efficiency and performance. It utilizes new materials and fabrication techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related work on semiconductor materials\"\n        }\n    ],\n    \"claims\": [\n        \"A semiconductor device comprising...\",\n        \"The device of claim 1, wherein...\",\n        \"A method for fabricating the device of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69859", "text": "{\n    \"patent_title\": \"Method and System for Real-Time Image Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of Innovation\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for real-time image enhancement using adaptive histogram equalization and noise reduction techniques. The system improves image quality for various applications including surveillance and satellite imagery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Image Processing Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image comprising...\",\n        \"A system for real-time image processing...\",\n        \"The method of claim 1, wherein the image is a grayscale image.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69859", "text": "{\n    \"patent_title\": \"Medical Image Reconstruction Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Healthcare Innovations\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Medical Research Institute\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-05-20\",\n    \"issue_date\": \"2018-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel technique for reconstructing high-resolution medical images from low-dose CT scans. This invention addresses the challenges of noise reduction and artifact removal in medical imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"CT Scan Enhancement\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image comprising...\",\n        \"The method of claim 1, wherein the medical image is a radiology scan.\",\n        \"A system for processing medical imagery.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69860", "text": "{\n    \"patent_title\": \"System and method for AI-powered image recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for image recognition utilizing artificial intelligence and deep learning techniques. The system is capable of identifying objects within images with high accuracy and speed.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for identifying objects in an image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69860", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2017-12-10\",\n    \"filing_date\": \"2017-12-10\",\n    \"issue_date\": \"2018-10-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved bicycle brake system providing enhanced stopping power and reliability.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A bicycle brake system...\",\n        \"A method for braking a bicycle...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69861", "text": "{\n    \"patent_title\": \"Improved Automotive Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"XYZ Automotive\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"XYZ Automotive\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved automotive braking system utilizing advanced sensor technology and a novel control algorithm to enhance vehicle safety. The system monitors wheel speed, brake pedal pressure, and road conditions to optimize braking performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art related to ABS systems\"\n        }\n    ],\n    \"claims\": [\n        \"A braking system comprising a sensor, a controller, and an actuator.\",\n        \"The braking system of claim 1, wherein the sensor is a wheel speed sensor.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69861", "text": "{\n    \"patent_title\": \"Method and System for Real-Time Data Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"ABC Tech\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"ABC Tech\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method and system for real-time data analysis, specifically utilizing advanced software algorithms for predictive modeling and pattern recognition. The software component enables efficient data processing and provides actionable insights.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"relevance\": \"Related data mining techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for analyzing data comprising a software module, a processing unit, and a display interface.\",\n        \"The method of claim 1, wherein the software module implements a machine learning algorithm.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69862", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable biosensor system for continuous monitoring of physiological parameters. The system utilizes a novel sensor technology for high sensitivity and accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A biosensor system comprising...\",\n        \"A method for monitoring physiological parameters...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69862", "text": "{\n    \"patent_title\": \"Improved Glucose Monitoring Device\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Sarah Chen\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved glucose monitoring device using enzymatic sensors. Provides more accurate and reliable glucose readings.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A glucose monitoring device comprising...\",\n        \"A method for determining glucose levels...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69863", "text": "{\n    \"patent_title\": \"System and method for improved image recognition using deep learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for improved image recognition utilizing deep convolutional neural networks. The system is trained on a large dataset of labeled images and provides accurate and efficient image classification and object detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760987B1\",\n            \"relevance\": \"Prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a neural network...\",\n        \"The system of claim 1, wherein...\",\n        \"The method of claim 2, wherein...\",\n        \"A computer-readable medium storing...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69863", "text": "{\n    \"patent_title\": \"Method for Enhanced Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2012-03-10\",\n    \"filing_date\": \"2012-03-10\",\n    \"issue_date\": \"2013-09-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel approach to data compression utilizing advanced entropy encoding techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related to data compression algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression...\",\n        \"A system for implementing the compression method...\",\n        \"A data storage device utilizing...\",\n        \"A communication network employing...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69864", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery Electrode Material and Method of Manufacture\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-14\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to novel electrode materials for lithium-ion batteries, improving energy density and cycle life. The materials are synthesized using a unique precipitation method.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art on lithium-ion battery electrodes\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrode comprising...\",\n        \"A method for manufacturing a lithium-ion battery electrode...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69864", "text": "{\n    \"patent_title\": \"Improved Lead-Acid Battery Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Exide Technologies\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Exide Technologies\"\n        },\n        {\n            \"name\": \"Eve Wilson\",\n            \"affiliation\": \"Exide Technologies\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2010-02-20\",\n    \"filing_date\": \"2010-02-19\",\n    \"issue_date\": \"2017-04-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel design for lead-acid batteries, enhancing their performance and longevity. The design focuses on improved plate geometry and electrolyte distribution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"relevance\": \"Prior art on lead-acid battery design\"\n        }\n    ],\n    \"claims\": [\n        \"A lead-acid battery comprising...\",\n        \"A method for assembling a lead-acid battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69865", "text": "{\n    \"patent_title\": \"Wireless Sensor Network for Industrial Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of Engineering\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-06-15\",\n    \"issue_date\": \"2018-08-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless sensor network for monitoring temperature, pressure, and humidity in industrial environments. The system utilizes low-power sensors and a secure communication protocol.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Low Power Wireless Communication\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor network comprising...\",\n        \"A method for monitoring industrial parameters...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69865", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Medical Device Corp.\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"BioTech Research Labs\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-04-20\",\n    \"issue_date\": \"2019-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor providing real-time monitoring of blood glucose levels with wireless transmission to a handheld device. Designed for diabetic patients.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Miniature Implantable Sensors\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Medical Data Transmission Protocols\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable glucose sensor...\",\n        \"A method for continuously monitoring glucose levels...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69866", "text": "{\n    \"patent_title\": \"System and Method for Wireless Power Transfer\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for wirelessly transferring power to a receiving device using resonant inductive coupling.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\"\n        },\n        {\n            \"patent_number\": \"US9123456B1\"\n        },\n        {\n            \"patent_number\": \"US9234567B2\"\n        },\n        {\n            \"patent_number\": \"US9345678B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for wirelessly transferring power...\",\n        \"A method for wirelessly transferring power...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69866", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US1234567B2\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-05-20\",\n    \"issue_date\": \"2018-11-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery technology with increased energy density and lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        },\n        {\n            \"patent_number\": \"US9123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A battery comprising...\",\n        \"A method for manufacturing a battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69867", "text": "{\n    \"patent_title\": \"High-Density Lithium-Ion Battery with Enhanced Electrolyte Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel lithium-ion battery design utilizing a modified electrolyte formulation to enhance stability and increase energy density. The battery exhibits superior performance in portable electronic devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8455247B2\",\n            \"title\": \"Electrolyte additive for lithium-ion batteries\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte formulation...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69867", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Motors\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system specifically designed for lithium-ion batteries used in electric vehicles. The system optimizes charging and discharging profiles for extended battery life and improved vehicle performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8802434B2\",\n            \"title\": \"Electric vehicle battery pack design\"\n        },\n        {\n            \"patent_number\": \"US9124204B2\",\n            \"title\": \"Control system for hybrid electric vehicles\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for an electric vehicle comprising...\",\n        \"A method for controlling...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69868", "text": "{\n    \"patent_title\": \"Neural Network Based Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image recognition system utilizing a deep convolutional neural network architecture. This system achieves state-of-the-art accuracy on standard image datasets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for image recognition comprising...\",\n        \"2. The method of claim 1, wherein...\",\n        \"3. A system for image recognition...\",\n        \"4. The system of claim 3, wherein...\",\n        \"5. A computer-readable medium...\",\n        \"6. The computer-readable medium of claim 5, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69868", "text": "{\n    \"patent_title\": \"Improved Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11112222B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new algorithm for compressing data, achieving higher compression ratios and faster decompression speeds.\",\n    \"citations\": [],\n    \"claims\": [\n        \"1. A method for data compression comprising...\",\n        \"2. The method of claim 1, wherein...\",\n        \"3. A system for data compression...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69869", "text": "{\n    \"patent_title\": \"System and Method for Image Recognition using Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition using deep neural networks. The system processes images to identify objects and scenes with high accuracy. The method involves training a deep neural network on a large dataset of labeled images and utilizing the trained network for classifying new images. The system has applications in various fields, including autonomous driving, robotics, and security.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8780553B1\"\n        },\n        {\n            \"patent_number\": \"US9235456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising a deep neural network.\",\n        \"The system of claim 1, wherein the deep neural network is trained on a labeled dataset.\",\n        \"A method for classifying an image using a deep neural network.\",\n        \"The method of claim 3, further comprising pre-processing the image.\",\n        \"The method of claim 3, further comprising post-processing the image.\",\n        \"The system of claim 1, wherein the deep neural network includes convolutional layers.\",\n        \"The system of claim 1, wherein the deep neural network includes recurrent layers.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69869", "text": "{\n    \"patent_title\": \"Method for Object Detection in Video Streams\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for detecting objects in video streams using computer vision techniques. The method involves analyzing each frame of the video stream to identify and track objects of interest. Applications include surveillance, traffic monitoring, and industrial automation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting objects in a video stream.\",\n        \"The method of claim 1, comprising tracking identified objects across consecutive frames.\",\n        \"The method of claim 1, wherein the objects of interest are vehicles.\",\n        \"The method of claim 1, wherein the objects of interest are pedestrians.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69870", "text": "{\n    \"patent_title\": \"Deep Learning for Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-10\",\n    \"filing_date\": \"2011-05-09\",\n    \"issue_date\": \"2019-02-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition using deep neural networks is disclosed. The invention utilizes convolutional neural networks to analyze image data and identify objects with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Image Processing System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image classification...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69870", "text": "{\n    \"patent_title\": \"Mechanical Gear System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Beta Industries\"\n        }\n    ],\n    \"patent_number\": \"US8901234B1\",\n    \"priority_date\": \"2009-12-15\",\n    \"filing_date\": \"2009-12-14\",\n    \"issue_date\": \"2018-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel gear system designed to improve efficiency and reduce wear. The invention utilizes a unique tooth profile to minimize friction and increase torque transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B2\",\n            \"title\": \"Gear Manufacturing Process\"\n        }\n    ],\n    \"claims\": [\n        \"A gear system comprising...\",\n        \"A method of manufacturing gears...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69871", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Processing in Autonomous Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for enhancing image processing capabilities in autonomous vehicles, focusing on real-time object detection and scene understanding. The system utilizes advanced algorithms to improve image clarity and accuracy under varying lighting and weather conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Processing for Digital Cameras\"\n        }\n    ],\n    \"claims\": [\n        \"A system for processing images comprising...\",\n        \"A method for enhancing image quality...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69871", "text": "{\n    \"patent_title\": \"Medical Image Analysis System for Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Medical Innovations Ltd.\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2016-11-01\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a medical image analysis system specifically designed for the detection of tumors in medical images such as X-rays and MRIs. The system utilizes deep learning algorithms to identify subtle anomalies indicative of cancerous growths.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Medical Imaging Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A medical image analysis system for detecting tumors...\",\n        \"A method for identifying anomalies in medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69872", "text": "{\n    \"patent_title\": \"Image Processing System for Enhanced Medical Diagnostics\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-06-15\",\n    \"issue_date\": \"2020-03-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system for image processing to enhance the clarity and accuracy of medical diagnostic images. The system utilizes a novel algorithm for noise reduction and edge detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for processing images...\",\n        \"A method for enhancing image clarity...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69872", "text": "{\n    \"patent_title\": \"Method for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11334455B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-12-01\",\n    \"issue_date\": \"2021-04-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a novel data compression method utilizing Huffman coding and run-length encoding to achieve significant reduction in file size.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data...\",\n        \"A system for encoding information...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69873", "text": "{\n    \"patent_title\": \"System and method for image recognition using deep convolutional neural networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for image recognition using deep convolutional neural networks. The system is capable of accurately identifying objects in images and videos, enabling applications in various fields such as autonomous vehicles and medical diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for image recognition comprising...\",\n        \"2. The system of claim 1, wherein...\",\n        \"3. A method for image recognition comprising...\",\n        \"4. The method of claim 3, wherein...\",\n        \"5. The system of claim 1, further comprising...\",\n        \"6. The method of claim 3, further comprising...\",\n        \"7. A computer-readable medium...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69873", "text": "{\n    \"patent_title\": \"Method for improving battery life in mobile devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Apple Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method for improving battery life in mobile devices by optimizing power consumption of various components.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for extending battery life...\",\n        \"2. The method of claim 1, wherein...\",\n        \"3. A mobile device comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69874", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Cardiac Monitor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MedTech Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2021-09-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable cardiac monitor is disclosed, capable of continuous ECG monitoring and wireless data transmission to a remote server for real-time analysis. The device is designed to be fully biocompatible and long-lasting.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US11000001B2\"\n        },\n        {\n            \"patent_number\": \"US10555555B1\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized implantable cardiac monitor...\",\n        \"A system for remotely monitoring cardiac activity...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69874", "text": "{\n    \"patent_title\": \"Surgical Instrument for Laparoscopic Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Boston Scientific\"\n        }\n    ],\n    \"patent_number\": \"US11333444B2\",\n    \"priority_date\": \"2020-01-10\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2021-11-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical instrument designed for use in laparoscopic procedures, enabling precise tissue manipulation and cutting.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9999999B2\"\n        },\n        {\n            \"patent_number\": \"US10222222B1\"\n        },\n        {\n            \"patent_number\": \"US8888888B2\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising...\",\n        \"A method for performing laparoscopic surgery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69875", "text": "{\n    \"patent_title\": \"Improved Electrolyte Composition for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel electrolyte composition for lithium-ion batteries that enhances energy density and cycle life. The electrolyte utilizes a lithium salt dissolved in a mixture of organic solvents, improving ionic conductivity and reducing dendrite formation. This significantly improves battery performance in portable electronic devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8758901B2\",\n            \"relevance\": \"Related prior art on electrolyte formulations.\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition consisting of...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69875", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Tesla Inc.\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2018-03-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) for lithium-ion batteries used in electric vehicles. The BMS provides accurate state-of-charge estimation, thermal management, and fault detection to ensure safe and reliable operation of the battery pack in automotive applications. It utilizes advanced algorithms to optimize battery performance and longevity within the constraints of automotive environments.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9546587B2\",\n            \"relevance\": \"Prior art relating to electric vehicle battery systems.\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for an electric vehicle...\",\n        \"A method for controlling a lithium-ion battery pack in an automotive system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69876", "text": "{\n    \"patent_title\": \"System and Method for Intelligent Traffic Flow Optimization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel system and method for optimizing traffic flow using artificial intelligence and machine learning algorithms. The system analyzes real-time traffic data to predict congestion and dynamically adjust traffic signals to minimize delays.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A system for optimizing traffic flow comprising...\",\n        \"A method for predicting traffic congestion...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69876", "text": "{\n    \"patent_title\": \"AI-Powered Diagnostic Tool for Cardiovascular Disease\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An artificial intelligence-based diagnostic tool designed for the early detection of cardiovascular disease. The system analyzes medical imaging data to identify potential anomalies and provide healthcare professionals with critical insights.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A diagnostic system comprising...\",\n        \"A method for detecting cardiovascular disease...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69877", "text": "{\n    \"patent_title\": \"Wireless Power Transfer System and Method\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless power transfer system and method for efficiently charging electronic devices. The system utilizes resonant inductive coupling to transmit power over a distance without physical connections. This invention improves wireless charging efficiency and range.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in inductive power transfer\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless power transfer system comprising...\",\n        \"A method for wirelessly charging a device comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69877", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Emily Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An advanced battery management system that optimizes charging and discharging cycles to extend battery life and improve safety. The system includes algorithms for predicting battery degradation and dynamically adjusting charging parameters.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Prior art in battery monitoring\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery charging comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69878", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel electrode material for lithium-ion batteries, exhibiting improved energy density and cycle life. The material comprises a modified lithium metal oxide composition.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"keywords\": [\n                \"lithium\",\n                \"electrode\",\n                \"energy storage\"\n            ]\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrode material for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69878", "text": "{\n    \"patent_title\": \"Advanced Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-15\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A sophisticated battery management system (BMS) for electric vehicles, optimizing performance and safety. Includes algorithms for state of charge estimation and thermal management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"keywords\": [\n                \"battery management\",\n                \"BMS\",\n                \"thermal control\"\n            ]\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling a battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69879", "text": "{\n    \"patent_title\": \"Method and System for Deep Learning-Based Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for image recognition using deep learning and neural network architectures. The system processes images to identify objects and features with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8766894\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition using a convolutional neural network.\",\n        \"A system comprising a processor and a memory storing instructions for image recognition.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69879", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10234567\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved data compression algorithm that significantly reduces file size without loss of information. Utilizes advanced coding techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression using a Huffman coding scheme.\",\n        \"A system for compressing data files.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69880", "text": "{\n    \"patent_title\": \"High-Efficiency Perovskite Solar Cells with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"National Renewable Energy Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel perovskite solar cell structure with enhanced efficiency and long-term stability. The device incorporates a modified hole transport layer and a robust encapsulation technique, resulting in a power conversion efficiency exceeding 22%.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art perovskite cell design\"\n        }\n    ],\n    \"claims\": [\n        \"A perovskite solar cell comprising...\",\n        \"A method for fabricating a perovskite solar cell...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69880", "text": "{\n    \"patent_title\": \"Electric Vehicle Charging System with Integrated Solar Power\",\n    \"inventors\": [\n        {\n            \"name\": \"Elon Musk\",\n            \"affiliation\": \"Tesla, Inc.\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Tesla, Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-10\",\n    \"filing_date\": \"2017-03-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for charging electric vehicles utilizing integrated solar power generation and grid connectivity. The system optimizes energy harvesting and storage to minimize charging costs and maximize grid stability. This is a system for charging electric vehicles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Prior art EV charging technology\"\n        }\n    ],\n    \"claims\": [\n        \"An electric vehicle charging system comprising...\",\n        \"A method for charging an electric vehicle...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69881", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-09-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the resolution of digital images using a deep learning algorithm. The system utilizes a convolutional neural network to upscale low-resolution images while preserving detail and reducing artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Super-Resolution with Generative Adversarial Networks\"\n        },\n        {\n            \"patent_number\": \"US9543210B2\",\n            \"title\": \"Deep Convolutional Neural Network for Image Recognition\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Processing using Fourier Transforms\"\n        },\n        {\n            \"patent_number\": \"US20170259102A1\",\n            \"title\": \"Neural Network-Based Image Enhancement\"\n        },\n        {\n            \"patent_number\": \"US20190322001A1\",\n            \"title\": \"Adaptive Image Sharpening\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising...\",\n        \"A system for enhancing image resolution comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69881", "text": "{\n    \"patent_title\": \"Improved Algorithm for Audio Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2019-05-01\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2021-07-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved algorithm for compressing audio signals using a modified discrete cosine transform. The algorithm provides better compression ratios and higher audio quality compared to existing methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Audio Compression using DCT\"\n        },\n        {\n            \"patent_number\": \"US8901234B1\",\n            \"title\": \"Perceptual Audio Coding\"\n        }\n    ],\n    \"claims\": [\n        \"An audio compression method comprising...\",\n        \"A system for audio compression comprising...\"\n    ]\n}"}
