{"_id": "Academic--patents--p--66035", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Predictive Maintenance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-06-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for predictive maintenance using artificial intelligence algorithms to analyze sensor data and predict equipment failures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predictive maintenance comprising...\",\n        \"A method for analyzing sensor data...\",\n        \"The system of claim 1, further comprising...\",\n        \"The method of claim 2, wherein the analysis...\",\n        \"The system of claim 3, wherein the sensor data...\",\n        \"The method of claim 4, wherein the prediction...\",\n        \"The system of claim 5, wherein the artificial intelligence...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66035", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Cycle Dynamics Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-01-10\",\n    \"filing_date\": \"2022-01-10\",\n    \"issue_date\": \"2023-09-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details an improved braking system for bicycles, focusing on enhanced stopping power and rider control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle brake system comprising...\",\n        \"The brake system of claim 1, wherein the lever...\",\n        \"A cable for transmitting force...\",\n        \"A caliper for applying braking force...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66036", "text": "{\n    \"patent_title\": \"System and method for dynamic allocation of network resources\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Cisco Systems\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-05-15\",\n    \"filing_date\": \"2010-03-20\",\n    \"issue_date\": \"2018-07-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for dynamically allocating network resources based on real-time demand. The system utilizes machine learning algorithms to predict network congestion and proactively allocate resources to prevent bottlenecks.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Network congestion control method\"\n        },\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"title\": \"Adaptive resource allocation in wireless networks\"\n        },\n        {\n            \"patent_number\": \"US9012345B1\",\n            \"title\": \"Dynamic bandwidth allocation system\"\n        },\n        {\n            \"patent_number\": \"US6789012B2\",\n            \"title\": \"Quality of service management in networks\"\n        },\n        {\n            \"patent_number\": \"US5432109B1\",\n            \"title\": \"Resource scheduling algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A system for dynamically allocating network resources...\",\n        \"A method for predicting network congestion...\"\n    ]\n}"}
