{"_id": "Academic--patents--p--66806", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized wireless pressure sensor system is disclosed. The system utilizes a MEMS pressure sensor and a low-power wireless communication module for remote data acquisition. Applications include biomedical monitoring and industrial process control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A pressure sensor system comprising a MEMS pressure sensor...\",\n        \"A wireless communication module for transmitting data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66806", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles is presented. This system enhances battery life and safety through advanced charging algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising a charging controller...\",\n        \"A safety circuit for preventing overcharge...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66807", "text": "{\n    \"patent_title\": \"System and Method for Dynamic Resource Allocation in Cloud Computing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9785123B2\",\n    \"priority_date\": \"2014-11-15\",\n    \"filing_date\": \"2015-03-10\",\n    \"issue_date\": \"2019-09-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for dynamically allocating resources in a cloud computing environment based on real-time demand and availability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8566234B1\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A method for dynamically allocating resources in a cloud computing environment...\",\n        \"A system for dynamically allocating resources...\"\n    ]\n}"}
