{"_id": "Academic--patents--p--66429", "text": "{\n    \"patent_title\": \"Microfluidic Device with Integrated Optical Sensor\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device integrating an optical sensor for real-time monitoring of biochemical reactions. The device uses a novel sensor design to achieve high sensitivity and accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising an optical sensor.\",\n        \"The device of claim 1, wherein the sensor is a fluorescence sensor.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66429", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-12-01\",\n    \"filing_date\": \"2019-12-01\",\n    \"issue_date\": \"2022-08-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system that optimizes charging and discharging cycles to extend battery life. The system incorporates advanced algorithms for thermal management and voltage control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising a voltage regulator.\",\n        \"The system of claim 1, further comprising a temperature sensor.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66430", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-11-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-05-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for improving the accuracy and speed of image recognition using deep learning techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
