{"_id": "Academic--patents--p--66118", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Predictive Maintenance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for predicting equipment failure using artificial intelligence and machine learning algorithms. The system analyzes sensor data to identify patterns indicative of impending failures, enabling proactive maintenance and reducing downtime.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Predictive Maintenance System\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predicting equipment failure comprising...\",\n        \"A method for analyzing sensor data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66118", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Energy Solutions Corp.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-07-01\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2020-12-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles, offering enhanced safety and longevity.  The system includes advanced charging algorithms and thermal regulation features.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Battery Management System\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for charging a battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66119", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-11-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a miniaturized wireless pressure sensor system for biomedical applications. The system utilizes a MEMS pressure sensor and a low-power wireless communication module to transmit pressure data to a remote receiver.  The sensor is designed for continuous monitoring of physiological pressure parameters.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"1. A pressure sensor system comprising...\",\n        \"2. The system of claim 1, wherein the sensor is miniaturized...\",\n        \"3. The system of claim 1, further comprising a wireless communication module...\",\n        \"4. The system of claim 3, wherein the wireless communication module is low-power...\",\n        \"5. The system of claim 1, for use in biomedical applications...\",\n        \"6. A method of measuring pressure using the system of claim 1...\",\n        \"7. The method of claim 6, wherein the pressure is physiological pressure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66119", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-08-10\",\n    \"issue_date\": \"2021-06-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved battery management system for electric vehicles. The system optimizes charging and discharging processes to extend battery life and improve overall vehicle performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"1. A battery management system comprising...\",\n        \"2. The system of claim 1, further comprising a temperature sensor...\",\n        \"3. The system of claim 1, for use in electric vehicles...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66120", "text": "{\n    \"patent_title\": \"Method for Enhanced Drug Delivery using Nanoparticles\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for encapsulating and delivering drugs using novel nanoparticle formulations, enhancing bioavailability and targeted drug delivery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art on nanoparticle synthesis.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for encapsulating a drug using a nanoparticle.\",\n        \"A nanoparticle formulation comprising a drug and a polymer coating.\"\n    ]\n}"}
