{"_id": "Academic--patents--p--66358", "text": "{\n    \"patent_title\": \"Neural Network Architecture for Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel neural network architecture optimized for image recognition tasks. The network utilizes a unique combination of convolutional and recurrent layers to achieve state-of-the-art accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Convolutional Neural Network for Object Detection\"\n        }\n    ],\n    \"claims\": [\n        \"A neural network comprising a convolutional layer and a recurrent layer.\",\n        \"A method for image recognition using the neural network of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66358", "text": "{\n    \"patent_title\": \"Method for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-08-01\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2021-10-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new algorithm for lossless data compression. The method utilizes Huffman coding and run-length encoding to minimize file size.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Improved Huffman Coding Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression utilizing Huffman coding.\",\n        \"A system for implementing the data compression method of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66359", "text": "{\n    \"patent_title\": \"System and Method for Wireless Power Transfer\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-06-15\",\n    \"filing_date\": \"2015-03-10\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for wirelessly transferring power to electronic devices using resonant inductive coupling.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for wirelessly transferring power comprising...\",\n        \"A method for wirelessly charging an electronic device...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66359", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2013-11-20\",\n    \"filing_date\": \"2014-05-15\",\n    \"issue_date\": \"2018-12-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery technology utilizing new materials to increase energy density and lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising...\",\n        \"A method for manufacturing a high-density battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66360", "text": "{\n    \"patent_title\": \"System and method for dynamic spectrum access\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-05-15\",\n    \"filing_date\": \"2010-03-20\",\n    \"issue_date\": \"2019-07-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for dynamic spectrum access allowing secondary users to utilize licensed spectrum when not used by primary users.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Spectrum sensing techniques\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Interference mitigation in wireless networks\"\n        },\n        {\n            \"patent_number\": \"US9123456B1\",\n            \"title\": \"Cognitive radio systems\"\n        },\n        {\n            \"patent_number\": \"US10234567B2\",\n            \"title\": \"Dynamic frequency selection\"\n        },\n        {\n            \"patent_number\": \"US11345678B1\",\n            \"title\": \"Spectrum allocation algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"A method for dynamic spectrum access comprising...\",\n        \"A system for dynamic spectrum access comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66360", "text": "{\n    \"patent_title\": \"Improved Battery Life for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2008-11-01\",\n    \"filing_date\": \"2009-06-10\",\n    \"issue_date\": \"2018-04-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and device for extending battery life in mobile communication devices through intelligent power management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Power saving modes in mobile devices\"\n        },\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"title\": \"Adaptive voltage scaling techniques\"\n        },\n        {\n            \"patent_number\": \"US9123456B1\",\n            \"title\": \"Low-power wireless communication\"\n        }\n    ],\n    \"claims\": [\n        \"A mobile device comprising...\",\n        \"A method for power management comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66361", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"US\",\n    \"abstract\": \"A method and system for enhancing the resolution of images using a deep learning model. The model is trained on a large dataset of high-resolution images and is capable of upscaling low-resolution images with minimal loss of detail.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for enhancing the resolution of an image comprising...\",\n        \"2. The method of claim 1, wherein the deep learning model is a convolutional neural network.\",\n        \"3. A system for enhancing the resolution of an image comprising...\",\n        \"4. The system of claim 3, wherein the deep learning model is trained on a dataset of high-resolution images.\",\n        \"5. The system of claim 4, wherein the dataset comprises at least 1 million images.\",\n        \"6. The method of claim 1, further comprising a pre-processing step to remove noise from the low-resolution image.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66361", "text": "{\n    \"patent_title\": \"Image Compression Technique Using Wavelet Transform\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-08-20\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"US\",\n    \"abstract\": \"A new image compression technique based on wavelet transform. This method provides a higher compression ratio than traditional JPEG compression while maintaining acceptable image quality.\",\n    \"citations\": [],\n    \"claims\": [\n        \"1. A method for compressing an image comprising...\",\n        \"2. The method of claim 1, wherein the wavelet transform is a Daubechies wavelet.\",\n        \"3. A system for compressing an image comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66362", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel electrode materials for lithium-ion batteries with enhanced energy density and cycle life. The materials incorporate a unique doping strategy to improve ionic conductivity and structural stability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode material...\",\n        \"The electrode material according to claim 1, wherein the material comprises...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66362", "text": "{\n    \"patent_title\": \"Novel Polymer Composites for Automotive Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Ford Motor Company\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-14\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to polymer composites with improved strength and thermal resistance for use in automotive components. The composites are formed by incorporating reinforcing fibers into a polymer matrix.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A polymer composite comprising a polymer matrix and reinforcing fibers...\",\n        \"The polymer composite according to claim 1, wherein the polymer matrix comprises...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66363", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for improving image recognition accuracy using a novel deep learning architecture.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system comprising a convolutional neural network...\",\n        \"A method for training the neural network...\"\n    ]\n}"}
