{"_id": "Academic--patents--p--66624", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Improved Thermal Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-07-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery with an improved electrolyte composition and a novel separator design providing enhanced thermal stability and cycle life. The battery is suitable for electric vehicles and grid-scale energy storage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art on electrolyte additives\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"The battery of claim 1, wherein...\",\n        \"An electrolyte composition for a lithium-ion battery...\",\n        \"A separator for a lithium-ion battery...\",\n        \"A method of manufacturing a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66624", "text": "{\n    \"patent_title\": \"Advanced Solar Cell Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Caltech\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-08-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel solar cell design utilizing perovskite materials to achieve high energy conversion efficiency. The design incorporates a unique light trapping structure to maximize photon absorption.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"Prior art on perovskite solar cells\"\n        }\n    ],\n    \"claims\": [\n        \"A solar cell comprising...\",\n        \"The solar cell of claim 1, wherein...\",\n        \"A perovskite composition for a solar cell...\",\n        \"A light trapping structure for a solar cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66625", "text": "{\n    \"patent_title\": \"System and method for adaptive beamforming in wireless communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Qualcomm Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-06-15\",\n    \"filing_date\": \"2010-03-20\",\n    \"issue_date\": \"2019-07-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An adaptive beamforming system and method dynamically adjusts beam parameters to optimize signal strength and minimize interference in a wireless communication network.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Beamforming technique for MIMO systems\"\n        },\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"title\": \"Adaptive antenna array for wireless communication\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Interference cancellation in wireless networks\"\n        },\n        {\n            \"patent_number\": \"US9210123B2\",\n            \"title\": \"Signal processing for beam steering\"\n        },\n        {\n            \"patent_number\": \"US9543210B2\",\n            \"title\": \"Channel estimation for adaptive beamforming\"\n        }\n    ],\n    \"claims\": [\n        \"A system for adaptive beamforming comprising...\",\n        \"A method for dynamically adjusting beam parameters...\",\n        \"The system of claim 1, wherein...\"\n    ]\n}"}
