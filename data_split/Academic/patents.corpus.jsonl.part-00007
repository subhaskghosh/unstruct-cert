{"_id": "Academic--patents--p--66669", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Biomarker Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2018-04-20\",\n    \"issue_date\": \"2020-09-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for the rapid and sensitive detection of biomarkers in biological samples. The device incorporates a novel microchannel design and surface chemistry to enhance signal amplification.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"title\": \"Microfluidic Mixing Device\"\n        },\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"title\": \"Biomarker Detection Assay\"\n        },\n        {\n            \"patent_number\": \"US76543210B1\",\n            \"title\": \"Surface Modification for Microfluidics\"\n        },\n        {\n            \"patent_number\": \"US65432109B2\",\n            \"title\": \"Miniaturized Diagnostic System\"\n        },\n        {\n            \"patent_number\": \"US54321098B1\",\n            \"title\": \"Lab-on-a-Chip Technology\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for detecting a biomarker...\",\n        \"The device of claim 1, wherein...\"\n    ]\n}"}
