{"_id": "Academic--patents--n--69620", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2019-10-01\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new battery technology with enhanced energy density and lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"High\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Medium\"\n        },\n        {\n            \"patent_number\": \"US11345678B1\",\n            \"relevance\": \"High\"\n        }\n    ],\n    \"claims\": [\n        \"A battery comprising...\",\n        \"A method for charging a battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69621", "text": "{\n    \"patent_title\": \"High-Performance Lithium-Ion Battery with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel lithium-ion battery design incorporating a new electrolyte composition and electrode materials, resulting in enhanced stability and improved performance characteristics. The battery exhibits a significantly longer cycle life and higher energy density.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related art in electrolyte composition\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Prior art on electrode materials\"\n        },\n        {\n            \"patent_number\": \"US9543210B2\",\n            \"relevance\": \"Relevant battery management system\"\n        },\n        {\n            \"patent_number\": \"US20170259120A1\",\n            \"relevance\": \"Similar cathode material\"\n        },\n        {\n            \"patent_number\": \"US20180127682A1\",\n            \"relevance\": \"Relevant separator design\"\n        },\n        {\n            \"patent_number\": \"US10233345B2\",\n            \"relevance\": \"Related anode structure\"\n        },\n        {\n            \"patent_number\": \"US8980421B2\",\n            \"relevance\": \"Previous lithium-ion technology\"\n        },\n        {\n            \"patent_number\": \"US9657123B2\",\n            \"relevance\": \"Related battery safety feature\"\n        },\n        {\n            \"patent_number\": \"US11234567B2\",\n            \"relevance\": \"Comparable charging technique\"\n        },\n        {\n            \"patent_number\": \"US20170306058A1\",\n            \"relevance\": \"Similar cell configuration\"\n        },\n        {\n            \"patent_number\": \"US20180318921A1\",\n            \"relevance\": \"Related battery coating\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69621", "text": "{\n    \"patent_title\": \"Improved Solar Cell Efficiency\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2017-08-15\",\n    \"filing_date\": \"2017-08-15\",\n    \"issue_date\": \"2019-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a new solar cell architecture utilizing perovskite materials, leading to significantly improved efficiency in converting sunlight into electricity. It addresses limitations in current silicon-based solar cells.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9456789B2\",\n            \"relevance\": \"Prior art in perovskite materials\"\n        },\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related art on solar cell design\"\n        }\n    ],\n    \"claims\": [\n        \"A solar cell comprising a perovskite layer...\",\n        \"A method for manufacturing a high-efficiency solar cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69622", "text": "{\n    \"patent_title\": \"High-Performance Lithium-Ion Battery Electrode Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery electrode material comprising a high-capacity cathode and a stable electrolyte, resulting in improved energy density and cycle life. This invention addresses the limitations of existing lithium-ion batteries by providing a more durable and efficient energy storage solution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Lithium Iron Phosphate Cathode Material\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrode material comprising...\",\n        \"The lithium-ion battery electrode material according to claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69622", "text": "{\n    \"patent_title\": \"Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tesla, Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A comprehensive battery management system (BMS) for electric vehicles, providing accurate state-of-charge estimation, thermal management, and cell balancing. The system improves battery life and safety in EV applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Advanced Cell Balancing Techniques\"\n        },\n        {\n            \"patent_number\": \"US8987654B1\",\n            \"title\": \"Thermal Management System for Batteries\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"The battery management system according to claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69623", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-07-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications. The system utilizes a MEMS pressure sensor and a low-power wireless transceiver to transmit data to a remote base station.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Wireless Sensor Network\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for measuring pressure using a wireless sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69623", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Caltech\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2012-03-10\",\n    \"filing_date\": \"2012-03-10\",\n    \"issue_date\": \"2020-01-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles, enhancing energy efficiency and safety.  Utilizes advanced algorithms for charge control and thermal management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Lithium Ion Battery Technology\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling battery charge...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69624", "text": "{\n    \"patent_title\": \"Image Enhancement Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing images using deep convolutional neural networks. The system learns to map low-resolution images to high-resolution images, improving image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760789B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image comprising...\",\n        \"A system for enhancing an image comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69624", "text": "{\n    \"patent_title\": \"Method for Compressing Digital Images\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9123456B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2018-09-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for compressing digital images utilizing wavelet transforms and entropy encoding. This method achieves high compression ratios while maintaining acceptable image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a digital image comprising...\",\n        \"A system for compressing a digital image comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69625", "text": "{\n    \"patent_title\": \"Image Recognition System Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2018-03-01\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an image recognition system utilizing deep convolutional neural networks for accurate object detection and classification. The system is applicable to various fields including autonomous vehicles and medical imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Convolutional Neural Network Architectures\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"An apparatus for image classification...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69625", "text": "{\n    \"patent_title\": \"Method for Enhanced Video Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2018-02-10\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2020-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel video compression method utilizing wavelet transforms and entropy coding. This reduces bandwidth requirements for streaming and storage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Wavelet Transform Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for video compression comprising...\",\n        \"An apparatus for data encoding...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69626", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Thermal Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Tesla, Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery with a novel electrolyte composition is disclosed, providing enhanced thermal stability and improved cycle life. The invention addresses safety concerns associated with conventional lithium-ion batteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"kind\": \"Cited by Applicant\"\n        }\n    ],\n    \"claims\": [\n        \"1. A lithium-ion battery comprising...\",\n        \"2. The lithium-ion battery of claim 1, wherein...\",\n        \"3. The lithium-ion battery of claim 2, further comprising...\",\n        \"4. A method of manufacturing a lithium-ion battery...\",\n        \"5. The method of claim 4, wherein...\",\n        \"6. An electronic device comprising the lithium-ion battery of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69626", "text": "{\n    \"patent_title\": \"Sodium-Ion Battery with Polymer Electrolyte\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-05-20\",\n    \"issue_date\": \"2020-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A sodium-ion battery utilizing a novel polymer electrolyte is described. The battery exhibits high ionic conductivity and operates at room temperature.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"kind\": \"Cited by Examiner\"\n        }\n    ],\n    \"claims\": [\n        \"1. A sodium-ion battery comprising...\",\n        \"2. The sodium-ion battery of claim 1, wherein...\",\n        \"3. A method of assembling the sodium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69627", "text": "{\n    \"patent_title\": \"Neural Network Based Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel neural network architecture for improved image recognition accuracy. The system utilizes convolutional neural networks and recurrent neural networks to analyze images and identify objects with high precision.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Prior Art Image Processing Method\"\n        }\n    ],\n    \"claims\": [\n        \"A neural network comprising a convolutional layer and a recurrent layer.\",\n        \"A method for image recognition using the claimed neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69627", "text": "{\n    \"patent_title\": \"Advanced Signal Processing Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"EP1234567A1\",\n    \"priority_date\": \"2014-12-20\",\n    \"filing_date\": \"2015-01-10\",\n    \"issue_date\": \"2017-07-05\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"This invention details a new signal processing algorithm for enhancing audio quality. The method involves filtering and compression techniques to improve clarity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Existing Audio Processing Method\"\n        }\n    ],\n    \"claims\": [\n        \"A signal processing algorithm comprising a filtering step.\",\n        \"A method for audio enhancement using the claimed algorithm.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69628", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a lithium-ion battery with a novel electrolyte composition and a modified cathode material, resulting in enhanced stability and cycle life. The battery exhibits improved performance in high-temperature environments.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Lithium-Ion Battery with Polymer Electrolyte\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"The lithium-ion battery of claim 1, wherein the electrolyte comprises...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69628", "text": "{\n    \"patent_title\": \"Advanced Lithium-Ion Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Park Ji-hoon\",\n            \"affiliation\": \"Samsung SDI\"\n        },\n        {\n            \"name\": \"Kim Min-seo\",\n            \"affiliation\": \"Samsung Electronics\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery design featuring a three-dimensional electrode architecture for improved energy density and power output. The battery utilizes a silicon-carbon composite anode and a nickel-manganese-cobalt cathode.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"High-Capacity Lithium-Ion Battery Anode\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising a three-dimensional electrode architecture...\",\n        \"The lithium-ion battery of claim 1, wherein the anode comprises...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69629", "text": "{\n    \"patent_title\": \"System and method for image recognition using deep convolutional neural networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for image recognition using deep convolutional neural networks. The system comprises a training module and a recognition module, enabling accurate and efficient identification of objects within images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69629", "text": "{\n    \"patent_title\": \"Advanced Image Processing Techniques\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"IBM\"\n        },\n        {\n            \"name\": \"Eve Franklin\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2010-12-01\",\n    \"filing_date\": \"2010-12-01\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details several advanced image processing techniques, including edge detection and noise reduction. The innovations contribute to improved image clarity and quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"An image processing method comprising...\",\n        \"A system for enhancing image quality...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69630", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Processing in Autonomous Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing image processing capabilities in autonomous vehicles, specifically focusing on object detection and scene understanding. This invention improves the reliability of self-driving systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing an image comprising:...\",\n        \"A system for object detection...\",\n        \"The system of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69630", "text": "{\n    \"patent_title\": \"Medical Image Enhancement Technique Using Novel Filtering\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Mayo Clinic\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of Minnesota\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel technique for enhancing medical images, improving diagnostic accuracy through advanced filtering algorithms. The invention is applicable to various medical imaging modalities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing a medical image comprising...\",\n        \"The method of claim 1, wherein the medical image is an X-ray...\",\n        \"A system for processing medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69631", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-06-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications. The system comprises a MEMS pressure sensor, a low-power wireless transceiver, and a battery.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for measuring pressure using the system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69631", "text": "{\n    \"patent_title\": \"Advanced Navigation System\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Brown\",\n            \"affiliation\": \"California Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-01\",\n    \"filing_date\": \"2017-04-05\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel navigation system utilizing GPS and inertial sensors for improved accuracy in challenging environments.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A navigation system comprising...\",\n        \"A method for determining location using GPS and inertial sensors...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69632", "text": "{\n    \"patent_title\": \"System and Method for Predictive Maintenance using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for predicting equipment failures using machine learning algorithms. The system analyzes sensor data to identify patterns indicative of potential maintenance needs, reducing downtime and improving operational efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Predictive Analytics for Industrial Equipment\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for predicting equipment failures comprising...\",\n        \"2. The system of claim 1, wherein the machine learning algorithm is a neural network.\",\n        \"3. A method for predicting equipment failures comprising...\",\n        \"4. The method of claim 3, wherein the sensor data includes temperature and vibration readings.\",\n        \"5. The system of claim 1, further comprising a user interface for displaying predicted failure times.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69632", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Energy Solutions Corp.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-03-01\",\n    \"filing_date\": \"2021-04-15\",\n    \"issue_date\": \"2023-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel battery management system that improves energy efficiency and extends battery life. It incorporates advanced charging algorithms and temperature control mechanisms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Efficient Battery Charging Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"1. A battery management system comprising...\",\n        \"2. The system of claim 1, wherein the charging algorithm is optimized for lithium-ion batteries.\",\n        \"3. A method for managing a battery comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69633", "text": "{\n    \"patent_title\": \"Miniature Implantable Wireless Pressure Sensor\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature implantable wireless pressure sensor for monitoring intracranial pressure. The sensor transmits data wirelessly to an external receiver.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A miniature implantable pressure sensor comprising...\",\n        \"A wireless communication module for transmitting data...\",\n        \"A method for monitoring intracranial pressure...\",\n        \"The sensor according to claim 1, wherein the pressure sensor is biocompatible.\",\n        \"The sensor according to claim 2, wherein the wireless communication uses Bluetooth.\",\n        \"The method according to claim 3, further comprising displaying the pressure data on a user interface.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69633", "text": "{\n    \"patent_title\": \"Improved Catheter Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-12-10\",\n    \"filing_date\": \"2009-12-10\",\n    \"issue_date\": \"2017-05-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved catheter design with enhanced flexibility and maneuverability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising...\",\n        \"A flexible distal tip...\",\n        \"A lumen for fluid delivery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69634", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Processing using Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-15\",\n    \"issue_date\": \"2013-09-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method and system for enhanced image processing using deep neural networks. The system utilizes convolutional neural networks to improve image quality, object recognition, and image segmentation. The technology has applications in medical imaging, autonomous vehicles, and surveillance systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Image Processing Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image quality using a convolutional neural network.\",\n        \"A system comprising a neural network configured for object recognition.\",\n        \"A computer-readable medium storing instructions for image segmentation.\",\n        \"The method of claim 1, wherein the neural network is trained on a large dataset of images.\",\n        \"The system of claim 2, wherein the neural network is configured to identify objects in real-time.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69634", "text": "{\n    \"patent_title\": \"System for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2009-11-01\",\n    \"filing_date\": \"2009-11-01\",\n    \"issue_date\": \"2012-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel data compression algorithm utilizing Huffman coding and run-length encoding. The system is designed for efficient storage and transmission of digital data. Applications include file archiving and network communication.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"title\": \"Data Compression Methods\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing digital data using Huffman coding.\",\n        \"A system for encoding data using run-length encoding.\",\n        \"A computer-readable medium storing instructions for data compression.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69635", "text": "{\n    \"patent_title\": \"System and method for image recognition using convolutional neural networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10500000B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for image recognition utilizing deep convolutional neural networks. The system is capable of identifying objects and scenes with high accuracy, enabling applications in autonomous vehicles, medical imaging, and security systems. The core technology involves a novel network architecture and training methodology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a convolutional neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69635", "text": "{\n    \"patent_title\": \"Improved Method for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US9222222B1\",\n    \"priority_date\": \"2014-12-10\",\n    \"filing_date\": \"2014-12-09\",\n    \"issue_date\": \"2016-01-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel method for data compression utilizing Huffman coding and run-length encoding. It achieves significant compression ratios with minimal computational overhead.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8888888B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising...\",\n        \"A system for encoding data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69636", "text": "{\n    \"patent_title\": \"System and method for AI-powered image recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2019-02-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition utilizing artificial intelligence algorithms. The system improves accuracy and efficiency in identifying objects within images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for identifying objects...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69636", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Motors\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2019-04-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel battery technology for electric vehicles, enhancing energy density and lifespan. The technology uses advanced materials and manufacturing processes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising...\",\n        \"A system for managing battery charge...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69637", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for image recognition using artificial intelligence and deep learning techniques. The system can accurately identify objects in images with high precision and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Processing System\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for identifying objects in an image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69637", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Energy Solutions Ltd.\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Eve Green\",\n            \"affiliation\": \"Energy Solutions Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel battery design improving energy density and lifespan for mobile devices. It features a new electrolyte composition and electrode structure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Lithium-Ion Battery Design\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising...\",\n        \"An electrolyte composition for improved performance...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69638", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-02-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications. The sensor utilizes MEMS technology and a low-power communication protocol. This system is designed for continuous monitoring of physiological pressure parameters.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8652123B1\"\n        }\n    ],\n    \"claims\": [\n        \"A pressure sensor system comprising...\",\n        \"The system of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69638", "text": "{\n    \"patent_title\": \"Enhanced Data Transmission Protocol\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-08-22\",\n    \"filing_date\": \"2017-08-22\",\n    \"issue_date\": \"2020-05-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved data transmission protocol for wireless networks, focusing on increased bandwidth and reduced latency. The protocol utilizes advanced error correction codes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A data transmission method comprising...\",\n        \"The method of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69639", "text": "{\n    \"patent_title\": \"System and method for image recognition using deep convolutional neural networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2020-01-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition using deep convolutional neural networks are provided. The system includes a convolutional neural network trained to identify objects within images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US10234567B2\"\n        },\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for identifying objects in an image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69639", "text": "{\n    \"patent_title\": \"Method for processing audio signals\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11223344B2\",\n    \"priority_date\": \"2019-03-10\",\n    \"filing_date\": \"2019-03-10\",\n    \"issue_date\": \"2021-04-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for processing audio signals to improve clarity and reduce noise is disclosed.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US99887766B1\"\n        },\n        {\n            \"patent_number\": \"US88776655B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing audio signals comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69640", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel lithium-ion battery design incorporating a solid-state electrolyte to improve stability and prevent thermal runaway. The battery exhibits a significantly extended lifespan and enhanced safety features.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising a solid-state electrolyte...\",\n        \"A method for manufacturing a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69640", "text": "{\n    \"patent_title\": \"Sodium-Ion Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Sarah Jones\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Michael Brown\",\n            \"affiliation\": \"California Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a new sodium-ion battery composition exhibiting high energy density and rapid charge/discharge capabilities. It utilizes a unique electrode material to overcome the limitations of existing sodium-ion batteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A sodium-ion battery comprising a novel electrode material...\",\n        \"A method for enhancing the performance of a sodium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69641", "text": "{\n    \"patent_title\": \"Neural Network Architecture for Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel neural network architecture for improved image recognition accuracy. The network utilizes a unique combination of convolutional and recurrent layers to achieve state-of-the-art performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A neural network comprising a convolutional layer and a recurrent layer.\",\n        \"The neural network of claim 1, wherein the convolutional layer performs feature extraction.\",\n        \"The neural network of claim 2, wherein the recurrent layer processes sequential data.\",\n        \"A method for image recognition using the neural network of claim 1.\",\n        \"A system for object detection utilizing the neural network of claim 4.\",\n        \"...\",\n        \"The method of claim 4, wherein the image is a medical image.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69641", "text": "{\n    \"patent_title\": \"Method for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-19\",\n    \"issue_date\": \"2018-07-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel data compression algorithm based on Huffman coding and run-length encoding.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising encoding data using Huffman coding.\",\n        \"The method of claim 1, further comprising run-length encoding.\",\n        \"A system for compressing data using the method of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69642", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-06-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel battery technology utilizing a new electrolyte composition for improved energy density and lifespan in electric vehicles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related prior art on electrolyte materials.\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Similar battery structure.\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Previous work on battery management systems.\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related art on Lithium-ion batteries\"\n        },\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Earlier version of the same technology.\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising...\",\n        \"An electrolyte composition...\",\n        \"A method for manufacturing...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69642", "text": "{\n    \"patent_title\": \"Wireless Communication System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2017-03-10\",\n    \"filing_date\": \"2017-04-10\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless communication system utilizing advanced modulation techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related prior art on modulation schemes.\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Similar communication protocols.\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Previous work on signal processing.\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication device...\",\n        \"A modulation scheme...\",\n        \"A method for transmitting data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69643", "text": "{\n    \"patent_title\": \"Improved Battery Electrode Material\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel electrode material for lithium-ion batteries with enhanced energy density and cycle life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Lithium Battery Composition\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Electrode Materials for Batteries\"\n        },\n        {\n            \"patent_number\": \"US9543210B1\",\n            \"title\": \"High Capacity Battery\"\n        },\n        {\n            \"patent_number\": \"US20170239875A1\",\n            \"title\": \"Electrode Coating\"\n        },\n        {\n            \"patent_number\": \"US20180327379A1\",\n            \"title\": \"Solid State Electrolyte\"\n        }\n    ],\n    \"claims\": [\n        \"A battery electrode material comprising...\",\n        \"A lithium-ion battery including the electrode material...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69643", "text": "{\n    \"patent_title\": \"Wireless Communication System\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless communication system utilizing advanced modulation techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"title\": \"Wireless Signal Processing\"\n        },\n        {\n            \"patent_number\": \"US9456789B1\",\n            \"title\": \"Data Transmission Methods\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication system comprising...\",\n        \"A method for transmitting data wirelessly...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69644", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications. The system incorporates a MEMS pressure sensor, a low-power transceiver, and a rechargeable battery. This invention utilizes a novel signal processing algorithm to minimize noise and improve accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"The system of claim 1, wherein the sensor is a MEMS device.\",\n        \"The system of claim 1, further comprising a battery.\",\n        \"The system of claim 2, wherein the MEMS device includes...\",\n        \"A method for measuring pressure using the system of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69644", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-01-05\",\n    \"filing_date\": \"2019-07-12\",\n    \"issue_date\": \"2021-04-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved bicycle brake system using a hydraulic disc brake design. The system provides increased stopping power and modulation compared to traditional cable-actuated brakes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle brake system comprising...\",\n        \"The brake system of claim 1, wherein the brake is a disc brake.\",\n        \"The brake system of claim 1, further comprising a hydraulic actuator.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69645", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Electrolyte Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Jane Doe\",\n            \"affiliation\": \"MIT, Department of Materials Science and Engineering\"\n        },\n        {\n            \"name\": \"Dr. John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a lithium-ion battery with an improved electrolyte formulation that enhances stability and performance at high temperatures. The battery utilizes a novel additive that prevents dendrite formation and extends cycle life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art related to electrolyte additives\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte formulation for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69645", "text": "{\n    \"patent_title\": \"Novel Sodium-Ion Battery Architecture\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Jane Doe\",\n            \"affiliation\": \"Stanford University, Department of Chemical Engineering\"\n        },\n        {\n            \"name\": \"Dr. John Smith\",\n            \"affiliation\": \"SLAC National Accelerator Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a new architecture for sodium-ion batteries, improving energy density and rate capability. It utilizes a three-dimensional electrode structure and a high-voltage electrolyte.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related work on energy storage\"\n        }\n    ],\n    \"claims\": [\n        \"A sodium-ion battery comprising...\",\n        \"An electrode structure for a sodium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69646", "text": "{\n    \"patent_title\": \"System and Method for Image Recognition Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for image recognition utilizing deep convolutional neural networks. The system is capable of accurately identifying objects within images, even in challenging conditions. The method includes pre-processing, feature extraction, and classification stages.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for identifying objects in an image comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69646", "text": "{\n    \"patent_title\": \"Method for Data Compression Using Huffman Coding\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel method for data compression utilizing Huffman coding. The method achieves significant compression ratios while maintaining data integrity.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for compressing data comprising...\",\n        \"A system for decompressing data comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69647", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-14\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel electrode materials for lithium-ion batteries, enhancing energy density and cycle life. The materials comprise a modified lithium metal oxide structure with improved ionic conductivity. The invention also covers methods for manufacturing these electrodes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Lithium-Ion Battery Separator\"\n        }\n    ],\n    \"claims\": [\n        \"1. A lithium-ion battery comprising an electrode material...\",\n        \"2. The lithium-ion battery of claim 1, wherein the electrode material...\",\n        \"3. A method for manufacturing the lithium-ion battery...\",\n        \"4. The method of claim 3, further comprising...\",\n        \"5. An electrolyte for use in a lithium-ion battery...\",\n        \"6. The electrolyte of claim 5, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69647", "text": "{\n    \"patent_title\": \"Novel Polymer Coating for Corrosion Resistance\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US8901234B1\",\n    \"priority_date\": \"2009-12-01\",\n    \"filing_date\": \"2009-12-01\",\n    \"issue_date\": \"2015-04-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new polymer coating designed to protect metal surfaces from corrosion in harsh environments. The coating is durable, environmentally friendly, and easily applied.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Corrosion Inhibitor Composition\"\n        }\n    ],\n    \"claims\": [\n        \"1. A polymer coating comprising...\",\n        \"2. The polymer coating of claim 1, wherein...\",\n        \"3. A method for applying the polymer coating...\",\n        \"4. The method of claim 3, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69648", "text": "{\n    \"patent_title\": \"System and Method for Machine Learning-Based Fraud Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for detecting fraudulent transactions using machine learning algorithms. The system analyzes transaction data to identify patterns indicative of fraudulent activity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for detecting fraudulent transactions, comprising...\",\n        \"2. The system of claim 1, wherein the machine learning algorithm is a neural network.\",\n        \"3. A method for detecting fraudulent transactions, comprising...\",\n        \"4. The method of claim 3, wherein the transaction data includes...\",\n        \"5. The system of claim 1, further comprising a user interface...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69648", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Energy Solutions Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-11-20\",\n    \"filing_date\": \"2009-11-20\",\n    \"issue_date\": \"2018-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system designed to improve battery life and efficiency in portable electronic devices.\",\n    \"citations\": [],\n    \"claims\": [\n        \"1. A battery management system comprising...\",\n        \"2. The system of claim 1, wherein the battery is a lithium-ion battery.\",\n        \"3. The system of claim 1, further comprising a temperature sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69649", "text": "{\n    \"patent_title\": \"Novel Polymer Composites for High-Strength Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to novel polymer composites exhibiting enhanced strength and durability. The composites are formed using a unique blending process and are suitable for various applications, including aerospace and automotive industries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A polymer composite comprising...\",\n        \"A method for manufacturing the polymer composite...\",\n        \"The polymer composite of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69649", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Georgia Tech\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2017-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles is disclosed. The system optimizes charging and discharging cycles to extend battery life and enhance safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling battery charging...\",\n        \"The battery management system of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69650", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-04-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for enhancing the resolution of images using deep learning techniques. The system comprises a convolutional neural network trained on a large dataset of high-resolution images. The method involves inputting a low-resolution image into the network and outputting a high-resolution version. The improved image processing capabilities contribute to better visual clarity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for enhancing image resolution comprising a convolutional neural network.\",\n        \"A method for enhancing image resolution using deep learning.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69650", "text": "{\n    \"patent_title\": \"Medical Image Analysis System Utilizing Advanced Filtering Techniques\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Mayo Clinic\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-15\",\n    \"issue_date\": \"2020-03-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a medical image analysis system that utilizes advanced filtering techniques to enhance the visibility of tumors and other anomalies in medical images, such as X-rays and MRI scans. The system provides improved diagnostic accuracy and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"prior art in image processing\"\n        },\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"specifically focused on medical imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A medical image analysis system comprising advanced filtering algorithms.\",\n        \"A method for detecting tumors in medical images using the system.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69651", "text": "{\n    \"patent_title\": \"System and Method for Image Recognition Using Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-11-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for image recognition using deep neural networks. It applies convolutional neural networks to analyze images and identify objects with high accuracy.  The system leverages artificial intelligence algorithms for improved performance in computer vision tasks.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for identifying objects in an image...\",\n        \"The method of claim 1, wherein the neural network is a convolutional neural network...\",\n        \"The system of claim 2, further comprising a database...\",\n        \"The method of claim 1, wherein the image is a digital image...\",\n        \"The system of claim 2, wherein the identified objects are classified...\",\n        \"The method of claim 3, wherein the convolutional neural network is trained...\",\n        \"The system of claim 2, wherein the database stores features...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69651", "text": "{\n    \"patent_title\": \"Method for Improving Battery Life in Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Apple Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2021-09-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method for dynamically adjusting the power consumption of a mobile device based on usage patterns. The method aims to prolong battery life by optimizing resource allocation. It does not involve artificial intelligence.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for managing power consumption in a mobile device...\",\n        \"The method of claim 1, wherein the usage patterns are determined...\",\n        \"The method of claim 2, further comprising a step of...\",\n        \"The method of claim 1, wherein the resource allocation is optimized...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69652", "text": "{\n    \"patent_title\": \"System and method for image-based object recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for accurate and efficient image-based object recognition using deep convolutional neural networks. The system can identify objects in real-time with high precision.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69652", "text": "{\n    \"patent_title\": \"Method for improved audio signal processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-14\",\n    \"issue_date\": \"2020-02-29\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved method for audio signal processing, including noise reduction and speech enhancement techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"cited\"\n        }\n    ],\n    \"claims\": [\n        \"A method for audio signal processing comprising...\",\n        \"An apparatus for audio signal processing comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69653", "text": "{\n    \"patent_title\": \"Method and system for enhanced image resolution using deep learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-11-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the resolution of images using deep convolutional neural networks. The system is capable of increasing the resolution of low-resolution images while maintaining perceptual quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        },\n        {\n            \"patent_number\": \"US9210321B2\"\n        },\n        {\n            \"patent_number\": \"US8543210B2\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\"\n        },\n        {\n            \"patent_number\": \"US6543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising...\",\n        \"A system for enhancing image resolution...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69653", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11223344B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel algorithm for compressing data, achieving higher compression ratios while maintaining data integrity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US99887766B1\"\n        },\n        {\n            \"patent_number\": \"US88776655B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data...\",\n        \"A system for data compression...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69654", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Processing Using Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method and system for enhanced image processing using deep neural networks. The system efficiently processes images to improve clarity and reduce noise. The method is applicable to various image formats and can be used in diverse applications such as medical imaging, satellite imagery, and consumer photography.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"Cited by Examiner\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for enhancing an image comprising...\",\n        \"2. The method of claim 1, wherein the neural network...\",\n        \"3. A system for enhancing an image...\",\n        \"4. The system of claim 3, wherein the processor...\",\n        \"5. The method of claim 1, further comprising...\",\n        \"6. The system of claim 3, further comprising...\",\n        \"7. The method of claim 2, wherein the neural network is a convolutional neural network.\",\n        \"8. The system of claim 4, wherein the processor is a GPU.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69654", "text": "{\n    \"patent_title\": \"Improved Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Motors\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-08-22\",\n    \"filing_date\": \"2017-08-22\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system for electric vehicles that optimizes charging and discharging cycles to improve battery life and performance. The system monitors cell voltage, current, and temperature to prevent overcharging and overheating.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"kind\": \"Cited by Applicant\"\n        }\n    ],\n    \"claims\": [\n        \"1. A battery management system comprising...\",\n        \"2. The system of claim 1, wherein the controller...\",\n        \"3. The system of claim 1, further comprising...\",\n        \"4. A method for managing a battery...\",\n        \"5. The method of claim 4, wherein the optimization...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69655", "text": "{\n    \"patent_title\": \"Method and System for Distributed Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Sergey Brin\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Larry Page\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for distributed machine learning using a novel parallel processing architecture.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"High\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Medium\"\n        },\n        {\n            \"patent_number\": \"US9543210B1\",\n            \"relevance\": \"High\"\n        },\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"relevance\": \"Low\"\n        },\n        {\n            \"patent_number\": \"US10234567B1\",\n            \"relevance\": \"Medium\"\n        }\n    ],\n    \"claims\": [\n        \"A method for distributing a machine learning task...\",\n        \"A system comprising a plurality of processing nodes...\"\n    ]\n}"}
