{"_id": "Academic--patents--p--66942", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-05-15\",\n    \"filing_date\": \"2010-02-20\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor utilizing microfabrication techniques for continuous glucose monitoring with wireless data transmission to an external receiver.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"Prior art in glucose sensing\"\n        }\n    ],\n    \"claims\": [\n        \"A glucose sensor comprising a microfabricated sensor element.\",\n        \"A wireless communication module for transmitting glucose data.\",\n        \"A method for continuously monitoring glucose levels.\",\n        \"A system for displaying glucose data to a user.\",\n        \"A power management circuit for extending sensor lifespan.\",\n        \"A biocompatible coating for the sensor element.\",\n        \"A calibration algorithm for accurate glucose measurements.\"\n    ]\n}"}
