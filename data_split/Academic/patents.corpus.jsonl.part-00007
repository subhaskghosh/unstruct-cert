{"_id": "Academic--patents--p--66471", "text": "{\n    \"patent_title\": \"System and method for personalized recommendations using machine learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for providing personalized recommendations to users based on machine learning algorithms. The system analyzes user behavior and preferences to identify relevant items for recommendation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Recommendation system using collaborative filtering\"\n        }\n    ],\n    \"claims\": [\n        \"A system for providing personalized recommendations, comprising:\",\n        \"A processor configured to analyze user behavior data.\",\n        \"A memory configured to store user preference data.\",\n        \"A machine learning module configured to generate recommendations based on the analyzed data and preference data.\",\n        \"A display module configured to present the recommendations to a user.\",\n        \"The system of claim 1, wherein the user behavior data includes purchase history.\",\n        \"The system of claim 1, wherein the machine learning module utilizes a neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66471", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved bicycle brake system offering increased stopping power and rider safety. The system utilizes a novel cable tensioning mechanism.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Hydraulic disc brake for bicycles\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle brake system comprising:\",\n        \"A brake lever.\",\n        \"A cable connecting the brake lever to a brake caliper.\",\n        \"A brake caliper configured to apply friction to a wheel rim.\",\n        \"A cable tensioning mechanism configured to maintain consistent braking performance.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66472", "text": "{\n    \"patent_title\": \"System and method for dynamic resource allocation in a cloud computing environment\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Cloud Solutions Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for dynamically allocating resources in a cloud computing environment based on real-time demand and resource availability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Resource Management in Cloud Computing\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Dynamic Scaling of Virtual Machines\"\n        },\n        {\n            \"patent_number\": \"US11345678B1\",\n            \"title\": \"Load Balancing Techniques\"\n        },\n        {\n            \"patent_number\": \"US10567890B2\",\n            \"title\": \"Container Orchestration\"\n        },\n        {\n            \"patent_number\": \"US11456789B1\",\n            \"title\": \"Serverless Computing Architecture\"\n        }\n    ],\n    \"claims\": [\n        \"A system for dynamically allocating resources in a cloud computing environment.\",\n        \"A method for optimizing resource utilization based on real-time demand.\"\n    ]\n}"}
