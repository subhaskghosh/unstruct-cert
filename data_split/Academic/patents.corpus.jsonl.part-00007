{"_id": "Academic--patents--p--66836", "text": "{\n    \"patent_title\": \"Wireless Temperature Sensor Network\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Intel Corporation\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless sensor network for monitoring temperature in industrial environments. The system utilizes low-power sensors and a mesh network topology for reliable data transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"Related prior art on wireless communication protocols.\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor network comprising a plurality of sensors...\",\n        \"A method for transmitting temperature data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66836", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-05-20\",\n    \"issue_date\": \"2019-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor system for continuous monitoring of blood glucose levels in diabetic patients. The sensor utilizes enzymatic reactions to detect glucose concentration.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art relating to enzymatic glucose sensing.\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable glucose sensor comprising an enzymatic layer...\",\n        \"A method for monitoring blood glucose levels...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66837", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Processing using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method and system for enhanced image processing using deep learning techniques. It significantly improves the accuracy and efficiency of image recognition and analysis, particularly in low-light conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Prior Art Image Processing System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image quality using a convolutional neural network.\",\n        \"A system comprising a processor and memory for implementing the method.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66837", "text": "{\n    \"patent_title\": \"Improved Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Motors\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2022-01-10\",\n    \"filing_date\": \"2022-01-10\",\n    \"issue_date\": \"2023-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a battery management system designed to optimize the performance and lifespan of batteries in electric vehicles. It includes advanced algorithms for monitoring cell voltage, temperature, and current.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"title\": \"Existing Battery Monitoring Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising a voltage sensor and a temperature sensor.\",\n        \"A method for controlling battery charging based on temperature readings.\"\n    ]\n}"}
