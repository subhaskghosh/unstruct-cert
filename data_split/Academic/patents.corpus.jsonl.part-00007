{"_id": "Academic--patents--n--66403", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2007-11-01\",\n    \"filing_date\": \"2007-12-01\",\n    \"issue_date\": \"2011-04-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery technology offering higher energy density and longer lifespan for mobile electronic devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\"\n        }\n    ],\n    \"claims\": [\n        \"Claim 1: A battery cell comprising...\",\n        \"Claim 2: The battery cell of claim 1...\",\n        \"Claim 3: A mobile device including...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66404", "text": "{\n    \"patent_title\": \"Miniature Implantable Medical Device for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2015-03-15\",\n    \"filing_date\": \"2015-03-15\",\n    \"issue_date\": \"2018-05-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature implantable device for continuous glucose monitoring. The device utilizes a biocompatible sensor and wireless communication for real-time data transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on glucose sensing technology\"\n        }\n    ],\n    \"claims\": [\n        \"A miniature implantable device for glucose monitoring.\",\n        \"The device comprising a biocompatible sensor.\",\n        \"A wireless communication module for data transmission.\",\n        \"A method for continuous glucose monitoring using the device.\",\n        \"The device is less than 10mm in size.\",\n        \"A power management system for long-term operation.\"\n    ]\n}"}
