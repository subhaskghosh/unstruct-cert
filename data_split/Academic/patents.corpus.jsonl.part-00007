{"_id": "Academic--patents--p--66627", "text": "{\n    \"patent_title\": \"Implantable Cardiac Monitor with Remote Data Transmission\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Medtronic Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-05-15\",\n    \"filing_date\": \"2010-03-20\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable cardiac monitor that wirelessly transmits data to a remote receiver for real-time monitoring of heart activity. Includes algorithms for detecting arrhythmias and alerting medical personnel.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Prior Art Cardiac Monitor\"\n        },\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"title\": \"Wireless Data Transmission System\"\n        },\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"title\": \"Arrhythmia Detection Algorithm\"\n        },\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Miniaturized Implantable Device\"\n        },\n        {\n            \"patent_number\": \"US8567890B2\",\n            \"title\": \"Remote Patient Monitoring System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for remotely monitoring cardiac activity...\",\n        \"An implantable device comprising a sensor...\",\n        \"A system for detecting arrhythmias...\"\n    ]\n}"}
