{"_id": "Academic--patents--p--66137", "text": "{\n    \"patent_title\": \"Neural Network Based Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel image recognition system leveraging deep neural networks for accurate object detection and classification. The system utilizes convolutional neural networks to extract features from images and a fully connected layer for classification.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising a convolutional neural network.\",\n        \"A method for training a neural network for image classification.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66137", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2018-08-20\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2021-02-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a battery management system designed to optimize energy storage and discharge in electric vehicles. It incorporates advanced algorithms for cell balancing and thermal management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising a cell balancing circuit.\",\n        \"A method for optimizing battery performance.\"\n    ]\n}"}
