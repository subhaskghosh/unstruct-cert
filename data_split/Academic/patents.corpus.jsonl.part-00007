{"_id": "Academic--patents--p--66725", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-14\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system is disclosed. The system incorporates a novel MEMS pressure sensor and a low-power communication module for remote data transmission. Applications include medical monitoring and industrial process control. The system utilizes advanced signal processing techniques to minimize noise and maximize accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A pressure sensor system comprising...\",\n        \"A wireless communication module...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66725", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2009-12-20\",\n    \"filing_date\": \"2009-12-19\",\n    \"issue_date\": \"2015-05-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel battery management system designed to enhance the lifespan and performance of lithium-ion batteries. The system utilizes advanced algorithms to optimize charging and discharging cycles. It also includes features for thermal management and fault detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A charging control circuit...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66726", "text": "{\n    \"patent_title\": \"Miniature Wireless Implantable Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2019-03-10\",\n    \"issue_date\": \"2021-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless implantable pressure sensor system for continuous monitoring of physiological pressure parameters.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B1\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless implantable pressure sensor system comprising...\",\n        \"A method for monitoring physiological pressure using the system...\"\n    ]\n}"}
