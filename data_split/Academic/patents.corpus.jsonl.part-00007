{"_id": "Academic--patents--p--66370", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Recognition using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-12-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing image recognition accuracy using deep convolutional neural networks. The system leverages transfer learning and data augmentation techniques to improve performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image classification\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image recognition comprising...\",\n        \"A system for processing images comprising...\",\n        \"A computer-readable medium storing instructions for...\",\n        \"The method of claim 1, wherein the deep learning model...\",\n        \"The system of claim 2, further comprising...\",\n        \"The method of claim 3, wherein the data augmentation...\",\n        \"The system of claim 4, wherein the transfer learning...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66370", "text": "{\n    \"patent_title\": \"Digital Image Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-20\",\n    \"issue_date\": \"2021-08-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel digital image compression technique that utilizes wavelet transforms and entropy encoding to achieve high compression ratios.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related art in image compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image comprising...\",\n        \"A system for encoding image data comprising...\",\n        \"An apparatus for image compression...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66371", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel electrode materials for lithium-ion batteries, enhancing energy density and cycle life. The materials are based on a new composite structure that improves ion conductivity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"patent_office\": \"USPTO\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrode material for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66371", "text": "{\n    \"patent_title\": \"Advanced Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"University of Berlin\"\n        }\n    ],\n    \"patent_number\": \"EP3876543B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-06-15\",\n    \"issue_date\": \"2021-09-22\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"This patent describes an improvement in lithium-ion battery technology focusing on electrolyte additives. The electrolyte additive enhances stability at high temperatures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"patent_office\": \"USPTO\"\n        },\n        {\n            \"patent_number\": \"EP2987654B1\",\n            \"patent_office\": \"EPO\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrolyte additive...\",\n        \"An electrolyte additive for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66372", "text": "{\n    \"patent_title\": \"Method and System for Image Recognition Using Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2019-12-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for image recognition utilizing deep neural networks. The system comprises multiple convolutional layers, pooling layers, and fully connected layers, enabling high-accuracy image classification. The neural network is trained using a large dataset of labeled images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Convolutional Neural Network Architecture\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for image recognition comprising...\",\n        \"2. The method of claim 1, wherein the neural network...\",\n        \"3. A system for image recognition...\",\n        \"4. The system of claim 3, further comprising...\",\n        \"5. The method of claim 1, wherein the convolutional layers...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66372", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Motors\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2017-03-10\",\n    \"filing_date\": \"2017-03-10\",\n    \"issue_date\": \"2020-05-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system for electric vehicles. The system includes a temperature sensor, a voltage monitor, and a current sensor to optimize battery performance and lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Lithium-ion Battery Safety Circuit\"\n        }\n    ],\n    \"claims\": [\n        \"1. A battery management system comprising...\",\n        \"2. The system of claim 1, further comprising...\",\n        \"3. The system of claim 1, wherein the temperature sensor...\"\n    ]\n}"}
