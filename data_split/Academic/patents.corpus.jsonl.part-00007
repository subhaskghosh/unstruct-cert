{"_id": "Academic--patents--p--69494", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Improved Electrolyte\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2018-06-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery incorporating a novel electrolyte composition is disclosed, improving cycle life and safety. The electrolyte contains a lithium salt and a mixed solvent system.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising:...\",\n        \"An electrolyte composition for a lithium-ion battery...\",\n        \"The battery of claim 1, further comprising...\",\n        \"The electrolyte composition of claim 2, wherein...\",\n        \"A method of manufacturing a lithium-ion battery...\"\n    ]\n}"}
