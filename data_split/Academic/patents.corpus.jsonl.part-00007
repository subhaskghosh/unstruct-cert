{"_id": "Academic--patents--p--66426", "text": "{\n    \"patent_title\": \"Method for Enhanced Genome Editing Using CRISPR-Cas9\",\n    \"inventors\": [\n        {\n            \"name\": \"Jennifer Doudna\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emmanuelle Charpentier\",\n            \"affiliation\": \"Max Planck Unit for the Science of Pathogens\"\n        }\n    ],\n    \"patent_number\": \"US9889831B2\",\n    \"priority_date\": \"2012-05-02\",\n    \"filing_date\": \"2015-03-16\",\n    \"issue_date\": \"2019-02-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"The invention provides methods and compositions for genome editing using a CRISPR-Cas9 system. The methods are highly efficient and specific, and can be used to edit a wide range of target genes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8697397B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for editing a genome comprising...\",\n        \"A composition comprising a Cas9 protein and a guide RNA...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66426", "text": "{\n    \"patent_title\": \"System and Method for Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10526789B2\",\n    \"priority_date\": \"2016-08-15\",\n    \"filing_date\": \"2017-02-28\",\n    \"issue_date\": \"2020-01-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enabling reliable wireless communication between devices. The system utilizes advanced signal processing techniques to mitigate interference and improve data throughput.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9450968B2\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication system comprising...\",\n        \"A method for transmitting data wirelessly...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66427", "text": "{\n    \"patent_title\": \"System and Method for Personalized Recommendation Using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-05-15\",\n    \"filing_date\": \"2010-03-01\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for providing personalized recommendations to users based on their past behavior and preferences, utilizing machine learning algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Recommendation Engine\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"title\": \"Collaborative Filtering System\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"User Profiling Method\"\n        },\n        {\n            \"patent_number\": \"US10234567B1\",\n            \"title\": \"Machine Learning Based Prediction\"\n        },\n        {\n            \"patent_number\": \"US11345678B2\",\n            \"title\": \"Personalized Content Delivery\"\n        }\n    ],\n    \"claims\": [\n        \"A system for providing personalized recommendations...\",\n        \"A method for generating user profiles...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66427", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp.\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2011-01-10\",\n    \"filing_date\": \"2011-06-15\",\n    \"issue_date\": \"2018-11-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved braking system for bicycles, providing enhanced stopping power and control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"title\": \"Bicycle Brake Lever\"\n        },\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Hydraulic Brake System\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle braking system comprising...\",\n        \"A brake lever assembly...\",\n        \"A hydraulic braking mechanism...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66428", "text": "{\n    \"patent_title\": \"System and method for adaptive noise cancellation in wireless communication devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Qualcomm Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-05-15\",\n    \"filing_date\": \"2010-03-22\",\n    \"issue_date\": \"2019-07-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for adaptively canceling noise in wireless communication devices are provided. The system includes a noise estimation module and a noise cancellation module.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"kind\": \"cited by\"\n        }\n    ],\n    \"claims\": [\n        \"A system for adaptively canceling noise...\",\n        \"A method for adaptively canceling noise...\"\n    ]\n}"}
