{"_id": "Academic--patents--p--66259", "text": "{\n    \"patent_title\": \"Novel Cathode Material for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel cathode material for lithium-ion batteries, utilizing a new composite structure to enhance energy density and cycle life. The material exhibits improved electrochemical performance compared to existing technologies. This invention focuses solely on the cathode material itself.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A cathode material comprising...\",\n        \"A lithium-ion battery incorporating the cathode material...\",\n        \"A method for manufacturing the cathode material...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66259", "text": "{\n    \"patent_title\": \"Advanced Battery Management System for Lithium-Ion Packs\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Tesla\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-08-01\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2021-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An advanced battery management system (BMS) for lithium-ion battery packs, designed to optimize performance, safety, and lifespan. The system includes sophisticated algorithms for cell balancing, state-of-charge estimation, and thermal management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling a lithium-ion battery pack...\",\n        \"A system for monitoring battery cell voltage...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66260", "text": "{\n    \"patent_title\": \"Method and System for Neural Network-Based Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2021-12-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for image recognition utilizing a deep neural network architecture. The system comprises a convolutional neural network (CNN) for feature extraction and a recurrent neural network (RNN) for sequential processing of image data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition...\",\n        \"A system comprising a CNN...\",\n        \"A system comprising an RNN...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66260", "text": "{\n    \"patent_title\": \"Improved Optical Lens Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-05-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This patent discloses an improved design for optical lenses, enhancing image clarity and reducing chromatic aberration. The design utilizes novel glass compositions and surface profiling techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"An optical lens comprising...\",\n        \"A method for manufacturing an optical lens...\",\n        \"A glass composition for optical lenses...\"\n    ]\n}"}
