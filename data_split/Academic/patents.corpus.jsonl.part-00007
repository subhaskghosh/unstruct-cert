{"_id": "Academic--patents--p--66265", "text": "{\n    \"patent_title\": \"Method for Enhanced Oil Recovery Using Nanoparticles\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-05-15\",\n    \"filing_date\": \"2010-03-20\",\n    \"issue_date\": \"2018-07-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for enhancing oil recovery from subterranean reservoirs using nanoparticles to alter fluid properties.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing oil recovery...\",\n        \"The method of claim 1, wherein the nanoparticles are silica-based.\"\n    ]\n}"}
