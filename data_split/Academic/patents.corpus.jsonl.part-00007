{"_id": "Academic--patents--p--66329", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing image recognition accuracy using a deep convolutional neural network. The system includes a pre-processing module, a feature extraction module, and a classification module.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Classification Using Convolutional Neural Networks\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Deep Learning Framework for Object Detection\"\n        },\n        {\n            \"patent_number\": \"US11345678B1\",\n            \"title\": \"Method for Training Deep Neural Networks\"\n        },\n        {\n            \"patent_number\": \"US10234567B2\",\n            \"title\": \"Image Segmentation using Fully Convolutional Networks\"\n        },\n        {\n            \"patent_number\": \"US9987654B2\",\n            \"title\": \"Adversarial Training for Robust Image Classification\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for enhancing image recognition accuracy...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66329", "text": "{\n    \"patent_title\": \"Improved Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Motors\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-07-15\",\n    \"issue_date\": \"2023-03-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system that improves the efficiency and lifespan of batteries used in electric vehicles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B1\",\n            \"title\": \"Battery Charging Control System\"\n        },\n        {\n            \"patent_number\": \"US10456789B2\",\n            \"title\": \"Thermal Management System for Batteries\"\n        },\n        {\n            \"patent_number\": \"US11567890B1\",\n            \"title\": \"Battery State Estimation Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery performance...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66330", "text": "{\n    \"patent_title\": \"Method and System for AI-Powered Predictive Maintenance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of Innovation\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for predictive maintenance utilizing artificial intelligence algorithms to analyze sensor data and predict equipment failures. The system improves efficiency and reduces downtime in industrial settings.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Predictive Maintenance System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for predicting equipment failure comprising...\",\n        \"A system for predictive maintenance utilizing AI algorithms...\"\n    ]\n}"}
