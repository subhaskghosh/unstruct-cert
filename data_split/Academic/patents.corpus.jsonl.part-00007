{"_id": "Academic--patents--p--66538", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for improving image recognition accuracy using convolutional neural networks and attention mechanisms. The system is capable of identifying objects in images with higher precision than existing methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Classification Using Deep Neural Networks\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Attention Mechanisms for Image Recognition\"\n        },\n        {\n            \"patent_number\": \"US11000001B2\",\n            \"title\": \"Convolutional Neural Network Architectures\"\n        },\n        {\n            \"patent_number\": \"US10234567B1\",\n            \"title\": \"Object Detection in Images\"\n        },\n        {\n            \"patent_number\": \"US11345678B2\",\n            \"title\": \"Data Augmentation Techniques for Image Recognition\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a neural network...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66538", "text": "{\n    \"patent_title\": \"Method for Optimizing Wireless Communication Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"Qualcomm\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for optimizing wireless communication networks by dynamically adjusting network parameters based on real-time traffic conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9765432B1\",\n            \"title\": \"Wireless Network Optimization Techniques\"\n        },\n        {\n            \"patent_number\": \"US10345678B2\",\n            \"title\": \"Dynamic Resource Allocation in Wireless Networks\"\n        },\n        {\n            \"patent_number\": \"US11223344B1\",\n            \"title\": \"Interference Management in Wireless Communication\"\n        }\n    ],\n    \"claims\": [\n        \"A method for optimizing a wireless network comprising...\",\n        \"A system for dynamically adjusting network parameters...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66539", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system and method for image recognition using artificial intelligence techniques, specifically convolutional neural networks. The system can identify objects and patterns within images with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"type\": \"Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising a convolutional neural network.\",\n        \"A method for identifying objects in an image using artificial intelligence.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66539", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Motors\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2019-08-20\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2021-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel battery cell architecture that significantly increases energy density and lifespan for electric vehicles. It utilizes a new electrolyte composition and electrode material to achieve improved performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"type\": \"Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising a novel electrolyte composition.\",\n        \"An electric vehicle powered by the battery cell of claim 1.\"\n    ]\n}"}
