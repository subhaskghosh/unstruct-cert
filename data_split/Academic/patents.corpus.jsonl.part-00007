{"_id": "Academic--patents--p--66012", "text": "{\n    \"patent_title\": \"Method and System for Neural Network-Based Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Sergey Levin\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Chelsea Finn\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for image recognition using a deep neural network. The system comprises a convolutional neural network trained on a large dataset of images to identify objects within an image.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760724B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising: training a convolutional neural network...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66012", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Mark Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9234567B1\",\n    \"priority_date\": \"2014-05-10\",\n    \"filing_date\": \"2014-05-10\",\n    \"issue_date\": \"2016-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles, designed to increase battery life and efficiency. Includes advanced charging algorithms and temperature control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising: a temperature sensor...\",\n        \"A charging algorithm for an electric vehicle battery...\"\n    ]\n}"}
