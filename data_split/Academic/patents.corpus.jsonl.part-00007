{"_id": "Academic--patents--n--69237", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Caltech\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery design with increased energy density and improved cycle life. The battery utilizes a new electrolyte composition.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery comprising...\",\n        \"The battery of claim 1, wherein the electrolyte...\"\n    ]\n}"}
