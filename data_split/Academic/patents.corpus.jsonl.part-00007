{"_id": "Academic--patents--p--66905", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Enhanced Biocompatibility\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor with a novel biocompatible coating to minimize immune response and improve long-term functionality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Prior Art Glucose Sensor\"\n        }\n    ],\n    \"claims\": [\n        \"A glucose sensor comprising a biocompatible coating.\",\n        \"The glucose sensor of claim 1, wherein the coating is a polymer.\",\n        \"The glucose sensor of claim 2, wherein the polymer is polyethylene glycol.\",\n        \"A method for measuring glucose levels using the sensor.\",\n        \"The method of claim 4, wherein the sensor is implanted subcutaneously.\",\n        \"A system comprising the glucose sensor and a monitoring device.\",\n        \"The system of claim 6, wherein the monitoring device wirelessly transmits data.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66905", "text": "{\n    \"patent_title\": \"Method for Optimizing Solar Panel Efficiency\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10246813B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for optimizing the angle of solar panels based on real-time weather data to maximize energy generation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Solar Tracking System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for adjusting the angle of a solar panel.\",\n        \"The method of claim 1, wherein the adjustment is based on weather data.\",\n        \"A solar panel system comprising a tracking mechanism.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66906", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-12-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for improved image recognition utilizing deep convolutional neural networks. The system pre-processes images to enhance feature extraction and employs a novel training algorithm for higher accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Processing Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising a convolutional neural network.\",\n        \"A method for pre-processing images to enhance feature extraction.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66906", "text": "{\n    \"patent_title\": \"Method for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-09-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel data compression algorithm achieving high compression ratios with minimal loss of information.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Data Compression Methods\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data using a Huffman coding scheme.\",\n        \"A system for decompressing compressed data.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66907", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a miniature wireless pressure sensor system for use in biomedical applications. The system incorporates a highly sensitive pressure sensor and a low-power wireless communication module. It is designed for minimally invasive monitoring of physiological parameters.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"The system of claim 1, wherein the sensor is a piezoresistive sensor.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66907", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2018-08-20\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2021-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel battery technology utilizing a new electrolyte composition and cell architecture to improve energy density and cycle life in electric vehicles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising...\",\n        \"The battery cell of claim 1, wherein the electrolyte comprises...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66908", "text": "{\n    \"patent_title\": \"Novel Electrode Material for High-Performance Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel composite material is disclosed for use as an electrode in lithium-ion batteries, exhibiting enhanced energy density and cycle life. The material comprises a lithium metal oxide and a conductive polymer matrix.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Method for Synthesizing Lithium Metal Oxide\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode made of the described composite material.\",\n        \"A method for manufacturing the composite electrode material.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66908", "text": "{\n    \"patent_title\": \"Advanced Battery Management System for Lithium-Ion Storage\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system (BMS) for lithium-ion batteries is disclosed, optimizing charging and discharging profiles to extend battery lifespan and ensure safe operation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10112233B2\",\n            \"title\": \"Lithium-Ion Battery Cell with Enhanced Safety Features\"\n        },\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"title\": \"Method for State-of-Charge Estimation in Lithium-Ion Batteries\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system configured to control the charging and discharging of a lithium-ion battery.\",\n        \"A method for optimizing battery performance using the described BMS.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66909", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-06-15\",\n    \"issue_date\": \"2021-03-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for reconstructing images from incomplete data using deep learning techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Prior art in image reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an image...\",\n        \"A system for implementing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66909", "text": "{\n    \"patent_title\": \"Digital Image Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob White\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-12-01\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new algorithm for compressing digital images with high efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US1011121314B2\",\n            \"relevance\": \"Related work in image compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a digital image...\",\n        \"A system for implementing the compression method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66910", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Recognition using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for image recognition utilizing deep convolutional neural networks. The system achieves state-of-the-art accuracy on benchmark datasets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"title\": \"Image Classification using Support Vector Machines\"\n        },\n        {\n            \"patent_number\": \"US1012345678B2\",\n            \"title\": \"Object Detection with Recurrent Neural Networks\"\n        },\n        {\n            \"patent_number\": \"US1122334455B2\",\n            \"title\": \"Image Segmentation using Graph Cuts\"\n        },\n        {\n            \"patent_number\": \"US1211223344B2\",\n            \"title\": \"Generative Adversarial Networks for Image Synthesis\"\n        },\n        {\n            \"patent_number\": \"US1312334455B2\",\n            \"title\": \"Transfer Learning for Image Recognition\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image analysis...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66910", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-12-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new algorithm for lossless data compression, improving compression ratios over existing methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\",\n            \"title\": \"Huffman Coding\"\n        },\n        {\n            \"patent_number\": \"US98765432B2\",\n            \"title\": \"Lempel-Ziv Compression\"\n        },\n        {\n            \"patent_number\": \"US1012345679B2\",\n            \"title\": \"Arithmetic Coding\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression...\",\n        \"A system for encoding data...\",\n        \"A computer program for lossless compression...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66911", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Improved Thermal Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery with a novel electrolyte composition exhibiting improved thermal stability and cycle life. The electrolyte includes additives to prevent dendrite formation and enhance safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66911", "text": "{\n    \"patent_title\": \"Novel Polymer Electrolyte for Sodium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2012-03-10\",\n    \"filing_date\": \"2012-03-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A sodium-ion battery employing a new polymer electrolyte to enhance ionic conductivity and flexibility. This design addresses limitations of traditional liquid electrolytes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A sodium-ion battery comprising...\",\n        \"A polymer electrolyte for a sodium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66912", "text": "{\n    \"patent_title\": \"Method for Enhanced Contrast Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"US\",\n    \"abstract\": \"A method for improving contrast in medical images using a novel signal processing algorithm. The algorithm enhances the visibility of subtle features in images obtained through MRI, CT, and X-ray techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8652123B2\",\n            \"title\": \"Prior Art Imaging Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing contrast in a medical image comprising...\",\n        \"The method of claim 1, wherein the medical image is an MRI image.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66912", "text": "{\n    \"patent_title\": \"Surgical Robotics System with Precision Control\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-05-01\",\n    \"patent_office\": \"US\",\n    \"abstract\": \"A robotic system for performing surgical procedures with enhanced precision and dexterity. The system includes a robotic arm, a control interface, and a visualization system.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Previous Robotic Surgery System\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical robotic system comprising...\",\n        \"The system of claim 1, wherein the robotic arm is controlled by a surgeon.\"\n    ]\n}"}
