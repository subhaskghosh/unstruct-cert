{"_id": "Academic--patents--p--66588", "text": "{\n    \"patent_title\": \"Solar Tracking System with Enhanced Efficiency\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"SunPower Corporation\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A solar tracking system designed to maximize energy capture by continuously adjusting the angle of solar panels based on the sun's position. This system incorporates advanced algorithms and sensor technology to achieve higher efficiency compared to conventional tracking systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art in solar tracking\"\n        }\n    ],\n    \"claims\": [\n        \"A solar tracking system comprising...\",\n        \"A method for optimizing solar panel angle...\",\n        \"A sensor configuration for accurate sun position detection...\",\n        \"A control algorithm for maximizing energy output...\",\n        \"A system for remote monitoring and control...\",\n        \"A method for predicting sun position based on time and location...\",\n        \"A feedback loop for adjusting panel angle based on energy output...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66588", "text": "{\n    \"patent_title\": \"Improved Wind Turbine Blade Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-12-01\",\n    \"filing_date\": \"2009-12-01\",\n    \"issue_date\": \"2018-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel wind turbine blade design that reduces aerodynamic drag and increases energy capture efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B2\",\n            \"relevance\": \"Early wind turbine blade designs\"\n        }\n    ],\n    \"claims\": [\n        \"A wind turbine blade comprising...\",\n        \"A method for reducing aerodynamic drag...\",\n        \"A blade profile optimized for high wind speeds...\",\n        \"A system for monitoring blade stress...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66589", "text": "{\n    \"patent_title\": \"Artificial Intelligence-Powered Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel image recognition system utilizing artificial intelligence techniques, specifically deep convolutional neural networks, to accurately identify objects in images. The system improves upon existing methods by reducing false positive rates and increasing processing speed.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Prior Art Image Recognition\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training an artificial intelligence model...\",\n        \"The system of claim 1, wherein...\",\n        \"The method of claim 2, further comprising...\",\n        \"The system of claim 3, wherein the deep convolutional neural network comprises...\",\n        \"The method of claim 4, wherein the training data is labeled...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66589", "text": "{\n    \"patent_title\": \"Improved Battery Life for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Apple Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11345678B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a power management system for mobile devices that significantly improves battery life by optimizing energy consumption. It utilizes a novel algorithm to predict user activity and adjust power settings accordingly.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Power Saving Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A power management system for a mobile device comprising...\",\n        \"A method for optimizing energy consumption...\",\n        \"The system of claim 1, wherein...\",\n        \"The method of claim 2, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66590", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for enhancing the resolution of digital images using deep convolutional neural networks. The system utilizes a generative adversarial network (GAN) architecture to generate high-resolution images from low-resolution inputs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Super-Resolution using Convolutional Neural Networks\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing the resolution of an image comprising...\",\n        \"The method of claim 1, wherein the neural network is a generative adversarial network.\",\n        \"A system for enhancing the resolution of an image...\",\n        \"The system of claim 3, comprising a low-resolution image input module...\",\n        \"The system of claim 4, further comprising a display module...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66590", "text": "{\n    \"patent_title\": \"System for Real-time Object Detection in Video Streams\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-06-10\",\n    \"filing_date\": \"2019-12-20\",\n    \"issue_date\": \"2020-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for detecting objects in real-time video streams using a combination of computer vision and machine learning techniques. The system is optimized for embedded applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Method for Object Tracking in Video Sequences\"\n        }\n    ],\n    \"claims\": [\n        \"A system for detecting objects in a video stream comprising...\",\n        \"The system of claim 1, wherein the object detection algorithm is based on convolutional neural networks.\",\n        \"The system of claim 2, comprising a pre-processing module...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66591", "text": "{\n    \"patent_title\": \"System and method for image recognition using convolutional neural networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2018-03-01\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for performing image recognition using convolutional neural networks. The system utilizes a deep learning architecture to accurately identify objects within images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Prior Art Image Processing System\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition...\",\n        \"A method for identifying objects in an image...\"\n    ]\n}"}
