{"_id": "Academic--patents--p--66851", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2020-09-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for image recognition using artificial intelligence and deep learning techniques. The system accurately identifies objects in images with improved efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training an AI model...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66851", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2009-11-01\",\n    \"filing_date\": \"2009-11-01\",\n    \"issue_date\": \"2012-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel braking system for bicycles utilizing a modified cable mechanism to provide increased stopping power and improved control. The system is lightweight and easy to install.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle braking system comprising...\",\n        \"A cable mechanism for increased braking force...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66852", "text": "{\n    \"patent_title\": \"High-Speed Optical Fiber Communication System with Enhanced Signal Integrity\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-05-20\",\n    \"issue_date\": \"2019-07-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel optical fiber communication system designed for high-speed data transmission with improved signal integrity. The system utilizes advanced modulation techniques and error correction codes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Optical Fiber Amplification Techniques\"\n        },\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"title\": \"Modulation Schemes for Optical Communication\"\n        },\n        {\n            \"patent_number\": \"US9234567B1\",\n            \"title\": \"Error Correction in Optical Systems\"\n        },\n        {\n            \"patent_number\": \"US9456789B2\",\n            \"title\": \"Fiber Optic Cable Design\"\n        },\n        {\n            \"patent_number\": \"US9678901B1\",\n            \"title\": \"Optical Signal Processing\"\n        }\n    ],\n    \"claims\": [\n        \"A system for optical fiber communication comprising...\",\n        \"A method for modulating an optical signal...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66852", "text": "{\n    \"patent_title\": \"Improved Wavelength Division Multiplexing for Optical Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2018-01-10\",\n    \"issue_date\": \"2020-05-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for wavelength division multiplexing in optical networks, enhancing bandwidth and spectral efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"title\": \"Wavelength Division Multiplexing Systems\"\n        },\n        {\n            \"patent_number\": \"US9123456B1\",\n            \"title\": \"Optical Network Topologies\"\n        },\n        {\n            \"patent_number\": \"US9345678B2\",\n            \"title\": \"Spectral Efficiency Enhancement\"\n        }\n    ],\n    \"claims\": [\n        \"A wavelength division multiplexing system comprising...\",\n        \"A method for allocating wavelengths in an optical network...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66853", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Predictive Maintenance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"TechCorp Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of Innovation\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for predictive maintenance utilizing artificial intelligence and machine learning algorithms to analyze sensor data and predict potential equipment failures. The system improves efficiency and reduces downtime.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Predictive Maintenance System\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for predictive maintenance comprising...\",\n        \"2. The system of claim 1, wherein the data analysis is performed using artificial intelligence...\",\n        \"3. A method for predicting equipment failures...\",\n        \"4. The method of claim 3, further comprising...\",\n        \"5. The system of claim 1, wherein the sensor data includes...\",\n        \"6. A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66853", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"CycleTech Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved bicycle brake system offering enhanced stopping power and durability. The system utilizes a novel lever mechanism and brake pad material.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Bicycle Brake Design\"\n        }\n    ],\n    \"claims\": [\n        \"1. A bicycle brake system comprising...\",\n        \"2. The bicycle brake system of claim 1, wherein the lever mechanism is...\",\n        \"3. The bicycle brake system of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66854", "text": "{\n    \"patent_title\": \"Adaptive Modulation and Coding for Wireless Communication Systems\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Qualcomm Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-09-20\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for adaptively modulating and coding data for transmission in a wireless communication system to improve spectral efficiency and reliability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Wireless Communication System with Interference Cancellation\"\n        }\n    ],\n    \"claims\": [\n        \"A method for adaptively modulating data for transmission.\",\n        \"A system for encoding data based on channel conditions.\",\n        \"A wireless communication device comprising a modulator and an encoder.\",\n        \"The method of claim 1, wherein the modulation scheme is selected from QPSK, 16QAM, and 64QAM.\",\n        \"The system of claim 2, wherein the channel conditions are estimated using a pilot signal.\",\n        \"The method of claim 1, further comprising decoding the transmitted data.\",\n        \"The system of claim 2, further comprising a receiver for decoding the transmitted data.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66854", "text": "{\n    \"patent_title\": \"Improved Antenna Design for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Samsung Electronics\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2020-12-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel antenna design for mobile devices that provides improved signal strength and reduced interference.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Miniature Antenna for Portable Communication Devices\"\n        }\n    ],\n    \"claims\": [\n        \"An antenna for a mobile device.\",\n        \"The antenna of claim 1, comprising a resonant element.\",\n        \"The antenna of claim 2, wherein the resonant element is a patch antenna.\",\n        \"The antenna of claim 1, further comprising a matching network.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66855", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-10\",\n    \"filing_date\": \"2011-05-09\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition utilizing artificial intelligence algorithms are disclosed. The system comprises a neural network trained to identify objects within images with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition...\"\n    ]\n}"}
