{"_id": "Academic--patents--p--66570", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Thermal Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-08-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a lithium-ion battery with improved thermal stability, utilizing a novel electrolyte composition and cell architecture. The battery exhibits enhanced safety and performance characteristics, making it suitable for a wide range of applications including electric vehicles and grid storage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art related to electrolyte composition\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition...\",\n        \"A method for manufacturing...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66570", "text": "{\n    \"patent_title\": \"Improved Solar Panel Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2021-05-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new design for solar panels utilizing perovskite materials to improve efficiency.  The design incorporates a novel light-trapping structure to maximize energy absorption.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related to perovskite solar cells\"\n        }\n    ],\n    \"claims\": [\n        \"A solar panel comprising...\",\n        \"A light-trapping structure...\",\n        \"A method for manufacturing...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66571", "text": "{\n    \"patent_title\": \"System and Method for Dynamic Spectrum Access\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Qualcomm\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-05-15\",\n    \"filing_date\": \"2010-03-22\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for dynamically accessing spectrum based on real-time availability and interference conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Spectrum Sensing Techniques\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Adaptive Modulation Schemes\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Cognitive Radio Networks\"\n        },\n        {\n            \"patent_number\": \"US7890123B1\",\n            \"title\": \"Interference Mitigation Strategies\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"title\": \"Dynamic Channel Allocation\"\n        }\n    ],\n    \"claims\": [\n        \"A method for dynamically accessing spectrum...\",\n        \"A system comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66571", "text": "{\n    \"patent_title\": \"Improved Battery Life for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Apple Inc.\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Samsung\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2011-11-01\",\n    \"filing_date\": \"2012-05-10\",\n    \"issue_date\": \"2016-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for extending battery life in mobile devices through intelligent power management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"title\": \"Power Saving Modes\"\n        },\n        {\n            \"patent_number\": \"US7543210B2\",\n            \"title\": \"Adaptive Brightness Control\"\n        },\n        {\n            \"patent_number\": \"US8543210B1\",\n            \"title\": \"Low-Power Communication Protocols\"\n        }\n    ],\n    \"claims\": [\n        \"A mobile device comprising...\",\n        \"A method for managing power consumption...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66572", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel electrode material for lithium-ion batteries, significantly enhancing energy density and cycle life. The material comprises a modified lithium metal oxide with improved structural stability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode material...\",\n        \"The electrode material of claim 1, wherein...\",\n        \"A method of manufacturing the electrode material...\",\n        \"The method of claim 3, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66572", "text": "{\n    \"patent_title\": \"Novel Polymer Composite for Automotive Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of Detroit\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new polymer composite material with high strength-to-weight ratio suitable for automotive body panels. The composite demonstrates excellent impact resistance and corrosion protection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Relevant background\"\n        }\n    ],\n    \"claims\": [\n        \"A polymer composite material comprising...\",\n        \"The composite material of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66573", "text": "{\n    \"patent_title\": \"System and Method for Predictive Maintenance Using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of Innovation\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2018-03-01\",\n    \"issue_date\": \"2019-04-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for predicting equipment failure using machine learning algorithms.  The system analyzes sensor data to identify patterns indicative of impending maintenance needs, improving efficiency and reducing downtime.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for predictive maintenance comprising...\",\n        \"2. The system of claim 1, wherein the machine learning algorithm is...\",\n        \"3. A method for predicting equipment failure...\",\n        \"4. The method of claim 3, further comprising...\",\n        \"5. The system of claim 1, wherein the sensor data includes...\",\n        \"6. The method of claim 3, wherein the data is pre-processed...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66573", "text": "{\n    \"patent_title\": \"Improved Battery Life for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Mobile Tech Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US11123456B2\",\n    \"priority_date\": \"2019-01-10\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2020-11-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method for optimizing power consumption in mobile devices, extending battery life through intelligent software management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10111222B1\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"1. A mobile device comprising...\",\n        \"2. The mobile device of claim 1, wherein the power management system...\",\n        \"3. A method for extending battery life...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66574", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for improving the accuracy of image recognition using deep learning techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"kind\": \"Cited by Examiner\"\n        }\n    ],\n    \"claims\": [\n        \"Claim 1: A system comprising...\",\n        \"Claim 2: The system of claim 1, wherein...\",\n        \"Claim 3: A method for...\",\n        \"Claim 4: The method of claim 3, wherein...\",\n        \"Claim 5: The system of claim 1, further comprising...\",\n        \"Claim 6: The method of claim 3, further comprising...\"\n    ]\n}"}
