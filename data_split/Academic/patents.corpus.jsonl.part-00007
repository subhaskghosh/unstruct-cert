{"_id": "Academic--patents--p--66864", "text": "{\n    \"patent_title\": \"System and method for AI-powered anomaly detection in network traffic\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for detecting anomalies in network traffic using artificial intelligence. The system employs machine learning algorithms to identify patterns and flag unusual activity. It offers improved accuracy and speed compared to traditional methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for detecting anomalies in network traffic, comprising...\",\n        \"2. The system of claim 1, wherein the machine learning algorithm is a deep neural network...\",\n        \"3. A method for detecting anomalies in network traffic...\",\n        \"4. The method of claim 3, further comprising...\",\n        \"5. The system of claim 1, wherein the anomalies are indicative of a security breach...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66864", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-08-10\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2020-12-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel data compression algorithm that significantly reduces file size without compromising data integrity. The algorithm uses a combination of Huffman coding and run-length encoding.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for compressing data, comprising...\",\n        \"2. The method of claim 1, wherein the Huffman coding is adaptive...\",\n        \"3. A system for compressing data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66865", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2021-08-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel system and method for image recognition leveraging deep neural networks with improved accuracy and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a deep neural network...\"\n    ]\n}"}
