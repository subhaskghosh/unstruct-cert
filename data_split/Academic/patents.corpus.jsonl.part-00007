{"_id": "Academic--patents--p--66178", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Improved Electrolyte\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a lithium-ion battery with an improved electrolyte composition, enhancing energy density and cycle life. The electrolyte contains a novel lithium salt and solvent mixture.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Lithium-Ion Battery Cell Design\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66178", "text": "{\n    \"patent_title\": \"Nickel-Metal Hydride Battery Improvement\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"California Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10246813B1\",\n    \"priority_date\": \"2015-12-20\",\n    \"filing_date\": \"2015-12-19\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses improvements in nickel-metal hydride battery technology, specifically focusing on electrode materials and charging methods to increase efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Nickel-Metal Hydride Battery Electrode\"\n        }\n    ],\n    \"claims\": [\n        \"A nickel-metal hydride battery comprising...\",\n        \"An electrode material for a nickel-metal hydride battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66179", "text": "{\n    \"patent_title\": \"Method and System for AI-Powered Predictive Maintenance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"TechCorp Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of Innovation\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for predicting equipment failures using artificial intelligence and machine learning algorithms. The system analyzes sensor data to identify patterns indicative of potential failures, enabling proactive maintenance and reducing downtime.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in predictive maintenance.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for predicting equipment failure comprising: receiving sensor data...\",\n        \"A system for predictive maintenance comprising: a sensor data input...\",\n        \"The method of claim 1, wherein the artificial intelligence algorithm is a neural network.\",\n        \"The system of claim 2, further comprising a user interface for displaying predictions.\",\n        \"The method of claim 1, wherein the sensor data includes temperature, pressure, and vibration data.\",\n        \"The system of claim 2, wherein the AI algorithm is trained on historical failure data.\",\n        \"The method of claim 1, further comprising generating an alert when a predicted failure exceeds a threshold.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66179", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Energy Solutions Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-08-01\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2021-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system designed to enhance battery life and safety in electric vehicles. The system optimizes charging and discharging cycles to minimize degradation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art in battery management.\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising: a voltage sensor...\",\n        \"A method for controlling battery charging comprising: monitoring battery voltage...\",\n        \"The system of claim 1, wherein the battery is a lithium-ion battery.\",\n        \"The method of claim 2, further comprising adjusting the charging current based on temperature.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66180", "text": "{\n    \"patent_title\": \"System and Method for Personalized Medicine Based on Genomic Data\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for personalized medicine using genomic data analysis to predict drug response and optimize treatment plans.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for predicting drug response...\",\n        \"A system comprising a database of genomic data...\"\n    ]\n}"}
