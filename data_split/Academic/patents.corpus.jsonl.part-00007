{"_id": "Academic--patents--p--66684", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"David A. Hodges\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2008-05-15\",\n    \"filing_date\": \"2009-03-10\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized wireless pressure sensor system for biomedical applications. The sensor utilizes a MEMS pressure transducer and a low-power wireless communication protocol. This invention enables remote monitoring of physiological pressure parameters.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Wireless Sensor Network\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising...\",\n        \"A method for remotely monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66684", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2007-11-20\",\n    \"filing_date\": \"2008-08-05\",\n    \"issue_date\": \"2015-02-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles. This system optimizes battery charging and discharging to extend battery life and improve performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"title\": \"Lithium Ion Battery Control\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery...\"\n    ]\n}"}
