{"_id": "Academic--patents--p--66436", "text": "{\n    \"patent_title\": \"Neural Network Based Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-10-26\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2021-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a neural network-based system for image recognition with improved accuracy and efficiency. It utilizes a novel architecture to enhance feature extraction and classification.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising a neural network.\",\n        \"A method for training a neural network for image classification.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66436", "text": "{\n    \"patent_title\": \"Enhanced Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-07-12\",\n    \"filing_date\": \"2018-12-05\",\n    \"issue_date\": \"2022-06-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an improved battery management system for electric vehicles, focusing on charge efficiency and lifespan extension.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system with improved charge control.\",\n        \"A method for extending battery lifespan.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66437", "text": "{\n    \"patent_title\": \"Miniature Implantable Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature implantable pressure sensor system for monitoring physiological parameters. The system includes a pressure sensor, a signal processing circuit, and a wireless communication module.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A pressure sensor system comprising...\",\n        \"The system of claim 1, further comprising...\",\n        \"The system of claim 2, wherein...\",\n        \"A method for monitoring pressure...\",\n        \"The method of claim 4, wherein...\"\n    ]\n}"}
