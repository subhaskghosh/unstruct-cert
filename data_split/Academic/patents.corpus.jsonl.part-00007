{"_id": "Academic--patents--n--69464", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Jones\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876544B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for managing battery charge using a control system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69465", "text": "{\n    \"patent_title\": \"Improved Battery Electrode Material\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel electrode material for lithium-ion batteries with improved energy density and cycle life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Lithium Battery Electrode\"\n        },\n        {\n            \"patent_number\": \"US8987654B2\",\n            \"title\": \"Improved Battery Composition\"\n        },\n        {\n            \"patent_number\": \"US9234567B2\",\n            \"title\": \"Electrode Coating Process\"\n        }\n    ],\n    \"claims\": [\n        \"A battery electrode comprising...\",\n        \"The battery electrode of claim 1, wherein...\",\n        \"A lithium-ion battery comprising the electrode of claim 1.\",\n        \"The lithium-ion battery of claim 3, wherein...\",\n        \"A method of manufacturing the battery electrode...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69465", "text": "{\n    \"patent_title\": \"Wireless Communication System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-05-20\",\n    \"issue_date\": \"2018-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel wireless communication system with improved data throughput.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Wireless Data Transmission\"\n        },\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"title\": \"Enhanced Wireless Protocol\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication system comprising...\",\n        \"The wireless communication system of claim 1, wherein...\",\n        \"A method for transmitting data using the system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69466", "text": "{\n    \"patent_title\": \"Deep Learning Accelerator with On-Chip Memory\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10456789B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning accelerator is presented, utilizing on-chip memory to significantly reduce power consumption. The architecture is optimized for convolutional neural network applications, providing high throughput and low latency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A deep learning accelerator comprising...\",\n        \"A method for accelerating neural network computation...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69466", "text": "{\n    \"patent_title\": \"Improved Image Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2019-03-10\",\n    \"filing_date\": \"2019-03-10\",\n    \"issue_date\": \"2021-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new image compression algorithm that achieves higher compression ratios with minimal loss of image quality. The algorithm utilizes wavelet transforms and adaptive quantization techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"An image compression method comprising...\",\n        \"A system for compressing images using wavelet transforms...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69467", "text": "{\n    \"patent_title\": \"Method and System for Automated Code Generation using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for automatically generating source code from natural language descriptions using deep learning models. The system utilizes a transformer-based architecture and is trained on a large corpus of code examples. The generated code aims to improve developer productivity and reduce the time required for software development, focusing on artificial intelligence applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Neural Network Architecture for Image Recognition\"\n        }\n    ],\n    \"claims\": [\n        \"A method for automatically generating source code comprising: receiving a natural language description as input; processing the description using a deep learning model; and generating source code based on the processed description.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69467", "text": "{\n    \"patent_title\": \"Implantable Device with AI-Powered Diagnostics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MedTech Innovations\"\n        }\n    ],\n    \"patent_number\": \"US11123456B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-11-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an implantable medical device that uses artificial intelligence algorithms to diagnose and monitor heart conditions. The device includes sensors, a processing unit, and a wireless communication module. The AI algorithms analyze sensor data to detect anomalies and provide real-time feedback to healthcare professionals.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Pacemaker with Adaptive Pacing Algorithm\"\n        },\n        {\n            \"patent_number\": \"US9123456B1\",\n            \"title\": \"Implantable Cardiac Monitor\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable medical device comprising: a sensor for measuring physiological signals; a processing unit for analyzing the signals using an artificial intelligence algorithm; and a communication module for transmitting the analyzed data.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69468", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel electrode materials for lithium-ion batteries exhibiting improved energy density and cycle life. The materials incorporate a unique nanoscale structure that enhances ion transport.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrode material...\",\n        \"A method for manufacturing...\",\n        \"The battery of claim 1, wherein...\",\n        \"The electrode material of claim 2, characterized by...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69468", "text": "{\n    \"patent_title\": \"Advanced Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9012345B1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-19\",\n    \"issue_date\": \"2016-05-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A sophisticated battery management system for optimizing the performance and safety of various battery types, including lithium-ion.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling...\",\n        \"The system of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69469", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications. The sensor utilizes a MEMS pressure transducer and a low-power communication protocol to transmit data to a remote receiver. This invention relates to improved monitoring of physiological parameters.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Wireless Biomedical Sensor\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising...\",\n        \"A method for measuring pressure using a wireless sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69469", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Caltech\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-11-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery with enhanced energy density and cycle life. This invention improves upon existing battery technologies through a new electrode material and electrolyte composition.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9987654B2\",\n            \"title\": \"Lithium-Ion Battery with Improved Performance\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"A method for manufacturing a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69470", "text": "{\n    \"patent_title\": \"Method and System for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for image recognition using artificial intelligence techniques, including convolutional neural networks and deep learning algorithms.  The system improves accuracy and efficiency in identifying objects within images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69470", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876544B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-14\",\n    \"issue_date\": \"2019-02-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new battery management system to improve efficiency and lifespan of lithium-ion batteries. Includes advanced charging algorithms and thermal regulation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for charging a battery comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69471", "text": "{\n    \"patent_title\": \"Method and System for Neural Network-Based Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2018-03-01\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for image recognition using a deep neural network. The system employs convolutional neural networks for feature extraction and classification.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\",\n        \"The method of claim 1, wherein...\",\n        \"The system of claim 2, wherein...\",\n        \"A computer-readable medium storing...\",\n        \"The computer-readable medium of claim 5, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69471", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2018-02-15\",\n    \"issue_date\": \"2019-10-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel algorithm for compressing digital data, utilizing Huffman coding and run-length encoding.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for data compression comprising...\",\n        \"A system for data compression comprising...\",\n        \"The method of claim 1, wherein...\",\n        \"The system of claim 2, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69472", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a miniature wireless pressure sensor system for biomedical applications. The system utilizes a MEMS pressure sensor integrated with a low-power wireless communication module. The sensor data is transmitted wirelessly to a remote monitoring station.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related art in wireless sensor networks\"\n        }\n    ],\n    \"claims\": [\n        \"A miniature wireless pressure sensor system comprising...\",\n        \"A method for wirelessly transmitting pressure data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69472", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-01-10\",\n    \"filing_date\": \"2017-01-10\",\n    \"issue_date\": \"2020-02-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an improved lithium-ion battery with increased energy density and cycle life. The battery utilizes a novel electrolyte formulation and electrode materials.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Prior art in lithium-ion battery technology\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte formulation for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69473", "text": "{\n    \"patent_title\": \"Deep Convolutional Neural Networks for Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel deep convolutional neural networks for accurate and efficient image recognition. The system uses a layered architecture to extract features from images, enabling robust object detection and classification.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8761523\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition using deep convolutional neural networks.\",\n        \"A system comprising a plurality of convolutional layers for feature extraction.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69473", "text": "{\n    \"patent_title\": \"Improved Object Tracking in Video Streams\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9988776\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention focuses on improving the accuracy and speed of object tracking in video streams. It utilizes a Kalman filter approach with adaptive parameter tuning.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456\"\n        }\n    ],\n    \"claims\": [\n        \"A method for object tracking in video streams using a Kalman filter.\",\n        \"A system for real-time object tracking.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69474", "text": "{\n    \"patent_title\": \"System and Method for Intelligent Route Optimization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for optimizing routes using artificial intelligence algorithms. The system analyzes real-time traffic data and historical patterns to identify the most efficient routes for delivery vehicles. The core of the invention lies in a novel reinforcement learning approach to dynamic route planning. No medical applications are included.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A system for route optimization comprising...\",\n        \"A method for dynamic route planning...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69474", "text": "{\n    \"patent_title\": \"AI-Powered Diagnostic System for Early Disease Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"MedTech Solutions\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-15\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an artificial intelligence-powered diagnostic system for the early detection of diseases, particularly cardiovascular conditions. It utilizes machine learning algorithms to analyze medical imaging data and identify subtle anomalies indicative of disease. The system significantly improves diagnostic accuracy and allows for earlier intervention, resulting in better patient healthcare outcomes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A diagnostic system comprising...\",\n        \"A method for disease detection using AI...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69475", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-05-20\",\n    \"issue_date\": \"2018-07-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system is disclosed. The system includes a MEMS pressure sensor, a low-power wireless transceiver, and a microcontroller for data processing. This invention enables remote monitoring of pressure in various applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"The sensor system as described in claim 1.\",\n        \"The wireless transceiver as described in claim 2.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69475", "text": "{\n    \"patent_title\": \"Advanced Image Processing Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2011-01-05\",\n    \"filing_date\": \"2011-03-10\",\n    \"issue_date\": \"2019-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An advanced image processing algorithm for enhancing image clarity and reducing noise is disclosed. The algorithm utilizes a novel filtering technique to improve image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\"\n        }\n    ],\n    \"claims\": [\n        \"The image processing algorithm as described in claim 1.\",\n        \"The filtering technique as described in claim 2.\",\n        \"The method for enhancing image clarity as described in claim 3.\",\n        \"The system for reducing noise as described in claim 4.\",\n        \"The application of the algorithm to medical images as described in claim 5.\",\n        \"The use of the filtering technique in video processing as described in claim 6.\",\n        \"The implementation of the algorithm on a mobile device as described in claim 7.\",\n        \"The integration of the algorithm with a cloud-based platform as described in claim 8.\",\n        \"The use of the algorithm for security applications as described in claim 9.\",\n        \"The application of the filtering technique to satellite imagery as described in claim 10.\",\n        \"The use of the algorithm for facial recognition as described in claim 11.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69476", "text": "{\n    \"patent_title\": \"Deep Learning Accelerator with Integrated Memory\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2020-12-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning accelerator architecture is presented, incorporating integrated high-bandwidth memory for efficient neural network processing.  This design significantly reduces latency and power consumption compared to existing approaches.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A deep learning accelerator comprising...\",\n        \"A method for accelerating neural network computations...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69476", "text": "{\n    \"patent_title\": \"Improved Image Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new image compression algorithm that achieves higher compression ratios with minimal loss of image quality. The algorithm utilizes a novel wavelet transform.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"An image compression method comprising...\",\n        \"A system for encoding and decoding images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69477", "text": "{\n    \"patent_title\": \"Wireless Sensor Network for Environmental Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless sensor network for monitoring environmental conditions, including temperature, humidity, and pressure. The system utilizes low-power sensors and a mesh network topology for reliable data transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Low-Power Wireless Communication Protocol\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor network comprising a plurality of sensor nodes...\",\n        \"A method for monitoring environmental conditions using a wireless sensor network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69477", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-08-20\",\n    \"filing_date\": \"2017-08-20\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor that wirelessly transmits data to an external receiver. The sensor utilizes enzymatic reactions to measure glucose levels in the blood.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Miniaturized Implantable Medical Device\"\n        },\n        {\n            \"patent_number\": \"US8789012B1\",\n            \"title\": \"Wireless Data Transmission for Medical Applications\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable glucose sensor comprising an enzymatic reaction chamber...\",\n        \"A method for wirelessly transmitting glucose data from an implantable sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69478", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Detail\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for enhancing image detail using a novel image processing algorithm. The algorithm effectively reduces noise and sharpens edges, resulting in improved image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image detail comprising...\",\n        \"A system for processing images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69478", "text": "{\n    \"patent_title\": \"Advanced Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An advanced image recognition system utilizing deep learning techniques for accurate object identification.  The system incorporates sophisticated image processing algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"cited\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for identifying objects in an image...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69479", "text": "{\n    \"patent_title\": \"Deep Learning Based Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10543217B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2020-01-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep learning system for accurate image recognition, utilizing convolutional neural networks and transfer learning to achieve state-of-the-art results.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition using a convolutional neural network.\",\n        \"A system comprising a processor and memory configured to execute the method.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69479", "text": "{\n    \"patent_title\": \"Method for Enhanced Image Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"IBM Research\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2013-05-20\",\n    \"filing_date\": \"2013-05-19\",\n    \"issue_date\": \"2017-09-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved image processing technique for enhancing contrast and reducing noise in digital images.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for image enhancement.\",\n        \"A system for processing images.\",\n        \"A digital image processing apparatus.\",\n        \"A method for filtering noise from an image.\",\n        \"A method for enhancing contrast in an image.\",\n        \"A method for adjusting brightness in an image.\",\n        \"A method for correcting color balance in an image.\",\n        \"A method for sharpening image details.\",\n        \"A method for reducing image artifacts.\",\n        \"A method for improving image quality.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69480", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Processing Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for enhanced image processing using deep learning techniques. The system utilizes convolutional neural networks to improve image quality and extract relevant features. It is applicable in a wide range of image processing tasks including medical imaging and autonomous driving.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related art in image filtering\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image quality comprising...\",\n        \"A system for processing images using a convolutional neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69480", "text": "{\n    \"patent_title\": \"Digital Signal Processing Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2017-03-10\",\n    \"filing_date\": \"2017-03-10\",\n    \"issue_date\": \"2020-02-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel digital signal processing technique for improving audio clarity and reducing noise. This invention focuses on time-frequency analysis and adaptive filtering.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related art in signal filtering\"\n        }\n    ],\n    \"claims\": [\n        \"A method for improving audio quality comprising...\",\n        \"A system for digital signal processing using adaptive filtering...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69481", "text": "{\n    \"patent_title\": \"System and Method for Image Recognition Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2018-10-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for image recognition using deep convolutional neural networks. The system is capable of accurately identifying objects within images and videos.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8766871B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69481", "text": "{\n    \"patent_title\": \"Method for Enhanced Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"EP2987654B1\",\n    \"priority_date\": \"2014-12-01\",\n    \"filing_date\": \"2015-01-10\",\n    \"issue_date\": \"2017-05-17\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"This invention relates to a novel method for data compression, achieving higher compression ratios than existing techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7543210B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising...\",\n        \"A system for data compression comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69482", "text": "{\n    \"patent_title\": \"System and Method for Image Recognition using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9898023B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-02-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition using deep convolutional neural networks. The system is configured to receive an image, process the image through a series of convolutional layers, and identify objects within the image based on the output of the convolutional layers. The method includes training a deep convolutional neural network on a large dataset of labeled images and then using the trained network to classify new images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8724144B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a neural network...\",\n        \"A non-transitory computer-readable medium...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69482", "text": "{\n    \"patent_title\": \"Method for Object Detection in Video Streams\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10246835B1\",\n    \"priority_date\": \"2016-05-20\",\n    \"filing_date\": \"2016-05-20\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for detecting objects in video streams using background subtraction and motion analysis. The system is capable of identifying and tracking multiple objects simultaneously.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9129003B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting objects in a video stream...\",\n        \"A system for tracking objects...\",\n        \"A computer program...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69483", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-05-20\",\n    \"issue_date\": \"2018-11-13\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel data compression algorithm utilizing adaptive dictionary encoding. The system offers improved compression ratios compared to existing methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data comprising...\",\n        \"A system for compressing data...\",\n        \"The method of claim 1, wherein...\",\n        \"The system of claim 2, further comprising...\",\n        \"A computer-readable medium storing...\",\n        \"The method of claim 1, wherein the dictionary...\",\n        \"The system of claim 2, wherein the encoding...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69483", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Williams\",\n            \"affiliation\": \"Independent Inventor\"\n        }\n    ],\n    \"patent_number\": \"US8543210B1\",\n    \"priority_date\": \"2008-12-01\",\n    \"filing_date\": \"2009-02-10\",\n    \"issue_date\": \"2013-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A bicycle brake system utilizing a novel cable tensioning mechanism for enhanced stopping power.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A bicycle brake system comprising...\",\n        \"The brake system of claim 1, wherein...\",\n        \"A cable tensioning mechanism for a bicycle brake...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69484", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Recognition Using Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-01-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for image recognition using deep neural networks. The system employs a novel architecture to improve accuracy and efficiency. The neural network is trained on a large dataset of labeled images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Convolutional Neural Network Architecture\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising:...\",\n        \"A system for image recognition comprising:...\",\n        \"The method of claim 1, wherein the neural network is a convolutional neural network.\",\n        \"The system of claim 2, wherein the neural network has at least 10 layers.\",\n        \"The method of claim 1, further comprising a preprocessing step.\",\n        \"The system of claim 2, further comprising a database for storing training data.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69484", "text": "{\n    \"patent_title\": \"Improved Battery Charging Circuit\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2020-03-01\",\n    \"filing_date\": \"2020-04-15\",\n    \"issue_date\": \"2022-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved circuit for charging batteries more efficiently. The circuit utilizes a novel feedback mechanism to optimize the charging process.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Battery Management System\"\n        }\n    ],\n    \"claims\": [\n        \"A charging circuit comprising:...\",\n        \"The circuit of claim 1, wherein the feedback mechanism is based on voltage.\",\n        \"The circuit of claim 1, further comprising a temperature sensor.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69485", "text": "{\n    \"patent_title\": \"Method and System for Deep Learning-Based Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2018-01-20\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition using deep convolutional neural networks. The system utilizes a large-scale dataset of labeled images to train the network.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432\"\n        },\n        {\n            \"patent_number\": \"US9123456\"\n        },\n        {\n            \"patent_number\": \"US9234567\"\n        },\n        {\n            \"patent_number\": \"US9345678\"\n        },\n        {\n            \"patent_number\": \"US9456789\"\n        },\n        {\n            \"patent_number\": \"US9567890\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69485", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US8765431\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2018-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An efficient data compression algorithm that reduces storage space and transmission bandwidth.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321\"\n        },\n        {\n            \"patent_number\": \"US8123456\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising...\",\n        \"A system for data compression comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69486", "text": "{\n    \"patent_title\": \"AI-Powered Predictive Maintenance System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system for predictive maintenance using artificial intelligence algorithms to analyze sensor data and predict equipment failures. The system improves efficiency and reduces downtime.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predicting equipment failure comprising...\",\n        \"A method for analyzing sensor data using artificial intelligence...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69486", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Independent Researcher\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2019-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a novel braking system for bicycles, improving stopping power and rider control. It utilizes a new lever design and brake pad material.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Relevant prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle braking system comprising...\",\n        \"A lever assembly for improved braking performance...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69487", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Detail using Adaptive Filtering\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-06-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for enhancing the detail in digital images using adaptive filtering techniques. The system analyzes image characteristics to dynamically adjust filter parameters, resulting in improved image clarity and reduced noise. The technique is applicable to various image processing tasks, including enhancement of satellite imagery and security footage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Filtering Method\"\n        },\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"title\": \"Adaptive Noise Reduction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing detail in a digital image...\",\n        \"A system comprising a processor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69487", "text": "{\n    \"patent_title\": \"Medical Image Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Medical Imaging Corp.\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-01\",\n    \"filing_date\": \"2017-04-01\",\n    \"issue_date\": \"2019-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel deep learning architecture for reconstructing high-quality medical images from raw sensor data. The system utilizes convolutional neural networks to improve image resolution and reduce artifacts, enabling more accurate diagnosis and treatment planning.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"title\": \"Medical Image Processing Techniques\"\n        },\n        {\n            \"patent_number\": \"US9234567B1\",\n            \"title\": \"Deep Learning for Image Analysis\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"A deep learning model configured...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69488", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery with Enhanced Cycle Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Emily Carter\",\n            \"affiliation\": \"Princeton University\"\n        },\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-06-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved lithium-ion battery with a novel electrolyte composition and electrode structure, resulting in enhanced cycle life and improved energy density. The battery is particularly suitable for electric vehicles and grid storage applications. The design incorporates a solid-state electrolyte and a silicon-carbon composite anode.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Lithium-Ion Battery Electrode Materials\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Electrolyte Additives for Lithium-Ion Batteries\"\n        },\n        {\n            \"patent_number\": \"US10234567B1\",\n            \"title\": \"Solid-State Electrolytes for Batteries\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Silicon-Carbon Composite Anodes\"\n        },\n        {\n            \"patent_number\": \"US8901234B1\",\n            \"title\": \"Battery Management Systems\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition for a lithium-ion battery...\",\n        \"An electrode structure for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69488", "text": "{\n    \"patent_title\": \"Novel Solar Cell Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2017-03-10\",\n    \"filing_date\": \"2017-04-10\",\n    \"issue_date\": \"2020-05-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a new design for high-efficiency solar cells utilizing perovskite materials. The structure incorporates a novel light-trapping scheme and improved charge transport layers. This design results in significant improvements in power conversion efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Perovskite Solar Cell Materials\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Light-Trapping Structures for Solar Cells\"\n        },\n        {\n            \"patent_number\": \"US10234567B1\",\n            \"title\": \"Charge Transport Layers for Solar Cells\"\n        }\n    ],\n    \"claims\": [\n        \"A solar cell comprising...\",\n        \"A perovskite material for solar cell applications...\",\n        \"A light-trapping structure for a solar cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69489", "text": "{\n    \"patent_title\": \"Method and System for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method and system for performing image recognition using artificial intelligence techniques, specifically convolutional neural networks. It enables accurate and efficient identification of objects within images for various applications such as autonomous vehicles and security systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Deep Learning Framework for Data Analysis\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition using artificial intelligence.\",\n        \"A system comprising a convolutional neural network for identifying objects in images.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69489", "text": "{\n    \"patent_title\": \"Automated Diagnostic System Using AI\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Medical Tech Solutions\"\n        }\n    ],\n    \"patent_number\": \"US11123456B2\",\n    \"priority_date\": \"2019-02-20\",\n    \"filing_date\": \"2019-02-20\",\n    \"issue_date\": \"2021-01-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention is an automated diagnostic system utilizing artificial intelligence to analyze medical images and assist physicians in disease detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Medical Imaging Device\"\n        },\n        {\n            \"patent_number\": \"US9432109B2\",\n            \"title\": \"Automated Blood Analysis System\"\n        }\n    ],\n    \"claims\": [\n        \"A system for medical diagnosis using artificial intelligence.\",\n        \"A method for analyzing medical images to detect diseases.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69490", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel electrode material for lithium-ion batteries with improved energy density and cycle life. The material comprises a composite of nickel-rich NMC and carbon nanotubes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"1. A lithium-ion battery comprising...\",\n        \"2. The lithium-ion battery of claim 1, wherein...\",\n        \"3. An electrode material for a lithium-ion battery...\",\n        \"4. The electrode material of claim 3, comprising...\",\n        \"5. A method of manufacturing a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69490", "text": "{\n    \"patent_title\": \"Novel Solar Cell Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Caltech\"\n        }\n    ],\n    \"patent_number\": \"US10293847B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new architecture for high-efficiency solar cells, utilizing perovskite materials and a multi-layer structure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"1. A solar cell comprising...\",\n        \"2. The solar cell of claim 1, wherein...\",\n        \"3. A method of fabricating a solar cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69491", "text": "{\n    \"patent_title\": \"Method and System for Personalized Machine Learning Models\",\n    \"inventors\": [\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for generating personalized machine learning models based on user data and preferences. The system uses a reinforcement learning approach to optimize model parameters for individual users.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"title\": \"Deep Learning Framework\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Neural Network Architecture\"\n        },\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"title\": \"Data Preprocessing Techniques\"\n        },\n        {\n            \"patent_number\": \"US12112233B2\",\n            \"title\": \"Model Evaluation Metrics\"\n        },\n        {\n            \"patent_number\": \"US13113322B2\",\n            \"title\": \"Federated Learning System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating a personalized machine learning model...\",\n        \"A system comprising a processor and memory...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69491", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Maria Garcia\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-05\",\n    \"issue_date\": \"2023-08-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system designed to improve the efficiency and lifespan of lithium-ion batteries. The system utilizes advanced charging algorithms and temperature control mechanisms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"title\": \"Battery Charging Circuit\"\n        },\n        {\n            \"patent_number\": \"US96543210B1\",\n            \"title\": \"Thermal Management System\"\n        },\n        {\n            \"patent_number\": \"US10543219B2\",\n            \"title\": \"Battery Capacity Estimation\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising a charging controller...\",\n        \"A method for optimizing battery lifespan...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69492", "text": "{\n    \"patent_title\": \"System and Method for Predictive Maintenance Using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for predictive maintenance using machine learning algorithms to analyze sensor data and predict equipment failures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for predictive maintenance comprising...\",\n        \"2. The system of claim 1, wherein the machine learning algorithm is...\",\n        \"3. A method for predicting equipment failure...\",\n        \"4. The method of claim 3, further comprising...\",\n        \"5. The system of claim 1, wherein the sensor data includes...\"\n    ]\n}"}
