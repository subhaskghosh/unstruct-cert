{"_id": "Academic--patents--p--66294", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2021-03-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhanced image recognition using deep learning techniques. The system utilizes convolutional neural networks to improve accuracy and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Similar image recognition approach\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for improving image recognition accuracy...\"\n    ]\n}"}
