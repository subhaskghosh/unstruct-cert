{"_id": "Academic--patents--p--69430", "text": "{\n    \"patent_title\": \"System and method for automated fraud detection using machine learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for detecting fraudulent transactions using machine learning algorithms, specifically artificial intelligence techniques. The system analyzes transaction data to identify patterns indicative of fraudulent activity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in fraud detection.\"\n        }\n    ],\n    \"claims\": [\n        \"A system for detecting fraudulent transactions comprising...\",\n        \"A method for analyzing transaction data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69430", "text": "{\n    \"patent_title\": \"Improved method for image recognition with deep neural networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"MIT Lincoln Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel approach to image recognition utilizing deep neural networks and artificial intelligence.  The method achieves state-of-the-art accuracy in identifying objects within images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Prior art in image processing.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A deep neural network configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69431", "text": "{\n    \"patent_title\": \"Neural Network Accelerator for Edge Computing\",\n    \"inventors\": [\n        {\n            \"name\": \"Li Zhang\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Anna Lee\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10872345B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2020-06-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel neural network accelerator designed for efficient execution of deep learning models on edge devices. The architecture utilizes specialized hardware to accelerate matrix multiplication and convolution operations, resulting in significant performance improvements and reduced power consumption. The system is built on a novel spiking neural network paradigm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        },\n        {\n            \"patent_number\": \"US10234567B1\"\n        }\n    ],\n    \"claims\": [\n        \"A neural network accelerator comprising...\",\n        \"A method for accelerating neural network computations...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69431", "text": "{\n    \"patent_title\": \"Improved Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Emily Brown\",\n            \"affiliation\": \"IBM Research\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-19\",\n    \"issue_date\": \"2021-04-13\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An advanced image recognition system leveraging convolutional neural networks to accurately identify objects in real-time. The system incorporates novel image preprocessing techniques and optimization algorithms to achieve state-of-the-art performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"An image recognition system comprising...\",\n        \"A method for recognizing images using convolutional neural networks...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69432", "text": "{\n    \"patent_title\": \"Wireless Power Transfer System with Beamforming\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-07-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless power transfer system using beamforming techniques to enhance efficiency and range. This invention significantly improves wireless charging capabilities for mobile devices and other electronic equipment. It utilizes advanced antenna arrays and signal processing algorithms to focus power transmission towards the receiver.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Wireless Energy Transfer Using Resonant Coupling\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless power transfer system comprising...\",\n        \"A beamforming module configured to...\",\n        \"A receiver device adapted to...\",\n        \"A method for wirelessly transferring power...\",\n        \"The system of claim 1, wherein...\",\n        \"The method of claim 4, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69432", "text": "{\n    \"patent_title\": \"Enhanced Battery Charging Circuit\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-14\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery charging circuit utilizing advanced control algorithms to optimize charging speed and battery life.  This invention provides a more efficient way to charge batteries for a variety of applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Battery Management System\"\n        }\n    ],\n    \"claims\": [\n        \"A battery charging circuit comprising...\",\n        \"A control module configured to...\",\n        \"A power source adapted to...\",\n        \"A method for charging a battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69433", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-04-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for reconstructing high-resolution images from low-resolution data. This invention uses advanced filtering techniques to improve image quality and reduce artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Filtering Algorithm\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Data Compression Techniques\"\n        },\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Image Enhancement Method\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"title\": \"Signal Processing Algorithms\"\n        },\n        {\n            \"patent_number\": \"US9234567B1\",\n            \"title\": \"Noise Reduction Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing images comprising...\",\n        \"A system for image reconstruction comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69433", "text": "{\n    \"patent_title\": \"Digital Signal Processing for Audio Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for digital signal processing, specifically tailored for audio applications. This invention enhances sound quality and reduces noise.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Audio Filtering Algorithm\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Digital Audio Compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing audio signals...\",\n        \"A system for audio enhancement comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69434", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2018-03-01\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a miniature wireless pressure sensor system for biomedical applications. The system comprises a MEMS pressure sensor, a low-power transceiver, and a flexible power source.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"The system of claim 1, wherein the sensor is a MEMS device.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69434", "text": "{\n    \"patent_title\": \"Improved Battery Life for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Apple Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11445566B1\",\n    \"priority_date\": \"2019-01-10\",\n    \"filing_date\": \"2019-07-15\",\n    \"issue_date\": \"2021-11-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents techniques for extending battery life in mobile devices through optimized power management algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A mobile device comprising...\",\n        \"A power management system configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69435", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications. The sensor utilizes a MEMS pressure transducer and transmits data wirelessly to a base station. The system is designed for implantable applications and provides real-time pressure monitoring. This system leverages advanced sensor technology for precise measurements.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Wireless Data Transmission System\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for measuring pressure using a wireless sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69435", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-02-15\",\n    \"filing_date\": \"2017-02-14\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles, optimizing energy efficiency and extending battery life. The system includes advanced algorithms for charge control and thermal management. This system uses innovative power distribution techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Electric Vehicle Battery System\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for managing battery charge...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69436", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode and Method of Manufacture\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel lithium-ion battery electrode material with enhanced energy density and cycle life. The material comprises a composite structure of nickel-rich NMC and a conductive polymer coating.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrode comprising...\",\n        \"A method of manufacturing a lithium-ion battery electrode...\",\n        \"The electrode according to claim 1, wherein...\",\n        \"The method according to claim 2, wherein...\",\n        \"The lithium-ion battery electrode according to claim 3, comprising...\",\n        \"The method according to claim 4, comprising...\",\n        \"The lithium-ion battery electrode according to claim 5, wherein the conductive polymer coating...\",\n        \"The method according to claim 6, wherein the composite structure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69436", "text": "{\n    \"patent_title\": \"Novel Polymer Composite Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2014-11-01\",\n    \"filing_date\": \"2015-02-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new polymer composite material with improved mechanical properties. The material consists of a polyethylene matrix reinforced with carbon nanotubes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A polymer composite material comprising...\",\n        \"A method of manufacturing a polymer composite material...\",\n        \"The composite material according to claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69437", "text": "{\n    \"patent_title\": \"Wireless Sensor Network for Environmental Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-10\",\n    \"filing_date\": \"2011-05-09\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless sensor network is disclosed for monitoring environmental parameters such as temperature, humidity, and pressure. The system utilizes low-power sensors and a robust communication protocol.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Power Saving Techniques in Wireless Sensor Networks\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor network comprising a plurality of sensor nodes...\",\n        \"A method for monitoring environmental parameters using a wireless sensor network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69437", "text": "{\n    \"patent_title\": \"Biometric Sensor for Medical Diagnosis\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2012-03-15\",\n    \"filing_date\": \"2012-03-14\",\n    \"issue_date\": \"2019-11-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A biometric sensor is described for accurate medical diagnosis. The sensor utilizes advanced signal processing techniques to detect biomarkers.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"title\": \"Portable Medical Diagnostic Device\"\n        },\n        {\n            \"patent_number\": \"US9012345B1\",\n            \"title\": \"Medical Sensor Calibration Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A biometric sensor comprising a detection module...\",\n        \"A method for diagnosing a medical condition using a biometric sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69438", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-15\",\n    \"filing_date\": \"2015-02-20\",\n    \"issue_date\": \"2018-10-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized wireless sensor system for environmental monitoring. The system utilizes low-power components and advanced signal processing techniques to accurately measure various parameters, including temperature, humidity, and pressure. The sensor data is transmitted wirelessly to a central data logger for analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"cited_by\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor system comprising...\",\n        \"A method for measuring environmental parameters...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69438", "text": "{\n    \"patent_title\": \"Improved Data Transmission Protocol\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9123456B2\",\n    \"priority_date\": \"2013-11-01\",\n    \"filing_date\": \"2014-03-10\",\n    \"issue_date\": \"2016-07-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel data transmission protocol for enhancing network performance. The protocol incorporates adaptive modulation and coding schemes to optimize data throughput and reliability. This invention has applications in a wide range of communication systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"kind\": \"cited_by\"\n        }\n    ],\n    \"claims\": [\n        \"A data transmission protocol comprising...\",\n        \"A method for optimizing data throughput...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69439", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-06-15\",\n    \"filing_date\": \"2015-03-10\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved lithium-ion battery electrode material with enhanced stability and energy density.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Lithium-Ion Battery Composition\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Electrode Material for Batteries\"\n        },\n        {\n            \"patent_number\": \"US20120259008A1\",\n            \"title\": \"High Capacity Battery Electrode\"\n        },\n        {\n            \"patent_number\": \"US20160083298A1\",\n            \"title\": \"Novel Battery Separator\"\n        },\n        {\n            \"patent_number\": \"US9546321B2\",\n            \"title\": \"Improved Electrolyte for Lithium-Ion Batteries\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrode comprising...\",\n        \"The electrode of claim 1, further comprising...\",\n        \"A lithium-ion battery cell comprising the electrode of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69439", "text": "{\n    \"patent_title\": \"Wireless Communication System\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-01-20\",\n    \"filing_date\": \"2016-07-15\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel wireless communication system with improved signal processing capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"title\": \"Wireless Data Transmission\"\n        },\n        {\n            \"patent_number\": \"US9234567B1\",\n            \"title\": \"Signal Processing Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication system comprising...\",\n        \"The system of claim 1, further comprising...\",\n        \"A method for wireless data transmission.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69440", "text": "{\n    \"patent_title\": \"Systems and Methods for Machine Learning-Based Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses systems and methods for image recognition using machine learning algorithms, specifically convolutional neural networks. The system is capable of identifying objects within images with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760789B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a machine learning model...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69440", "text": "{\n    \"patent_title\": \"Novel Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9123456B1\",\n    \"priority_date\": \"2015-11-01\",\n    \"filing_date\": \"2015-11-01\",\n    \"issue_date\": \"2016-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel data compression algorithm that utilizes Huffman coding and Lempel-Ziv techniques to achieve high compression ratios.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data comprising...\",\n        \"A system for decompressing compressed data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69441", "text": "{\n    \"patent_title\": \"Improved Electrolyte for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel electrolyte composition for lithium-ion batteries, improving performance and safety characteristics. The electrolyte contains a unique additive that enhances ion conductivity and reduces dendrite formation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Lithium Iron Phosphate Cathode Material\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrolyte composition...\",\n        \"The electrolyte composition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69441", "text": "{\n    \"patent_title\": \"Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-14\",\n    \"issue_date\": \"2020-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) for electric vehicles, including cell balancing, thermal management, and state-of-charge estimation. The BMS utilizes advanced algorithms to optimize battery life and performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Advanced Cell Balancing Techniques\"\n        },\n        {\n            \"patent_number\": \"US8910112B1\",\n            \"title\": \"Thermal Management System for Batteries\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"The battery management system including...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69442", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Segmentation\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for image segmentation using deep convolutional neural networks.  Improves accuracy and efficiency compared to prior art.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for segmenting an image comprising...\",\n        \"A system for performing image segmentation...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69442", "text": "{\n    \"patent_title\": \"Real-Time Object Detection in Video Streams\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Amazon\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-04-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for detecting objects in real-time video streams using a combination of machine learning and image processing techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for real-time object detection comprising...\",\n        \"A method for identifying objects in a video stream...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69443", "text": "{\n    \"patent_title\": \"Method and System for Image Enhancement Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2017-05-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing images using deep convolutional neural networks. The system is trained on a large dataset of images and can effectively improve image quality and resolution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760753B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for enhancing an image...\",\n        \"2. The method of claim 1, wherein the neural network...\",\n        \"3. A system comprising...\",\n        \"4. The system of claim 3, wherein...\",\n        \"5. The method of claim 1, further comprising...\",\n        \"6. The system of claim 3, further comprising...\",\n        \"7. A computer-readable medium...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69443", "text": "{\n    \"patent_title\": \"Image Compression Technique Using Wavelet Transforms\",\n    \"inventors\": [\n        {\n            \"name\": \"Alan Turing\",\n            \"affiliation\": \"University of Manchester\"\n        }\n    ],\n    \"patent_number\": \"US6543210B1\",\n    \"priority_date\": \"2000-01-10\",\n    \"filing_date\": \"2000-01-10\",\n    \"issue_date\": \"2002-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for compressing images using wavelet transforms to reduce file size without significant quality loss.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US5446839\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for compressing an image...\",\n        \"2. The method of claim 1, wherein the wavelet transform...\",\n        \"3. An apparatus for compressing an image...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69444", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a miniaturized wireless pressure sensor system for industrial monitoring applications. The sensor utilizes MEMS technology to provide accurate pressure readings and transmits data wirelessly to a central hub. It does not relate to medical devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Wireless Data Transmission Protocol\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"MEMS Pressure Sensor Fabrication\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising...\",\n        \"A system for monitoring pressure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69444", "text": "{\n    \"patent_title\": \"Implantable Blood Pressure Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an implantable blood pressure sensor with wireless communication capabilities for continuous monitoring of patients with cardiovascular diseases. The sensor is designed for long-term implantation and transmits data to an external receiver.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"title\": \"Implantable Medical Device Power Management\"\n        },\n        {\n            \"patent_number\": \"US9567890B1\",\n            \"title\": \"Miniature Wireless Communication for Medical Devices\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable blood pressure sensor...\",\n        \"A method for continuously monitoring blood pressure...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69445", "text": "{\n    \"patent_title\": \"Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless pressure sensor system for monitoring tire pressure in vehicles. The system utilizes a low-power sensor and a communication protocol for transmitting data to a central processing unit.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Tire Pressure Monitoring System\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for monitoring tire pressure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69445", "text": "{\n    \"patent_title\": \"Improved Sensor Calibration Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2019-02-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel technique for calibrating sensors with improved accuracy and reduced drift. The method utilizes a self-calibration algorithm and a temperature compensation scheme.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Sensor Calibration Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for calibrating a sensor...\",\n        \"A sensor calibration system comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69446", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition Using Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhanced image recognition using deep convolutional neural networks. The system utilizes transfer learning and fine-tuning techniques to improve accuracy and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760987B2\"\n        },\n        {\n            \"patent_number\": \"US9123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a neural network...\",\n        \"The system of claim 1, wherein...\",\n        \"The method of claim 2, further comprising...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69446", "text": "{\n    \"patent_title\": \"Improved Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-09\",\n    \"issue_date\": \"2019-07-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles, optimizing charging and discharging cycles for extended battery life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling battery charging...\",\n        \"The system of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69447", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-06-20\",\n    \"issue_date\": \"2020-11-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for reconstructing images from incomplete data using a novel iterative algorithm. The system improves image quality and reduces artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Processing Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an image...\",\n        \"The method of claim 1, wherein the iterative algorithm...\",\n        \"A system comprising...\",\n        \"The system of claim 3, further comprising...\",\n        \"A non-transitory computer-readable medium...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69447", "text": "{\n    \"patent_title\": \"Improved Video Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2019-01-10\",\n    \"filing_date\": \"2019-04-05\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A video compression algorithm that achieves higher compression ratios while maintaining acceptable video quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Video Encoding Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a video stream...\",\n        \"The method of claim 1, wherein the compression ratio...\",\n        \"A video encoder comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69448", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-05-20\",\n    \"issue_date\": \"2012-11-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system designed to improve battery life and safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"Related prior art\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"relevance\": \"Similar approach\"\n        },\n        {\n            \"patent_number\": \"US9123456B1\",\n            \"relevance\": \"Background technology\"\n        },\n        {\n            \"patent_number\": \"US10234567B2\",\n            \"relevance\": \"Alternative method\"\n        },\n        {\n            \"patent_number\": \"US11345678B1\",\n            \"relevance\": \"Related to charging algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for managing battery charge...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69448", "text": "{\n    \"patent_title\": \"Novel Solar Panel Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Emily Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2011-06-01\",\n    \"filing_date\": \"2011-08-15\",\n    \"issue_date\": \"2013-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new solar panel design with increased efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US78901234B2\",\n            \"relevance\": \"Related prior art\"\n        },\n        {\n            \"patent_number\": \"US80123456B1\",\n            \"relevance\": \"Similar technology\"\n        },\n        {\n            \"patent_number\": \"US91234567B2\",\n            \"relevance\": \"Background information\"\n        }\n    ],\n    \"claims\": [\n        \"A solar panel comprising...\",\n        \"A method for converting sunlight to electricity...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69449", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Chen\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system and method for enhanced image reconstruction, particularly in the field of medical imaging. Utilizing advanced image processing techniques, the system improves image clarity and reduces noise.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image reconstruction comprising...\",\n        \"A method for enhancing image clarity...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69449", "text": "{\n    \"patent_title\": \"Novel Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"IBM\"\n        }\n    ],\n    \"patent_number\": \"US9876544B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-08-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel data compression algorithm that efficiently reduces file sizes without significant loss of information. The algorithm uses a combination of entropy encoding and transform coding.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9012345B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising...\",\n        \"A system for encoding data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69450", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-06-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for improving the accuracy of image recognition using deep convolutional neural networks. The system employs a novel architecture for feature extraction and classification, resulting in significantly enhanced performance in identifying objects within images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for image recognition comprising...\",\n        \"2. The system of claim 1, wherein...\",\n        \"3. A method for image recognition...\",\n        \"4. The method of claim 3, further comprising...\",\n        \"5. A computer-readable medium storing...\",\n        \"6. The computer-readable medium of claim 5, wherein...\",\n        \"7. ...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69450", "text": "{\n    \"patent_title\": \"Method for Optimizing Data Storage in Cloud Environments\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Amazon Web Services\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2018-01-10\",\n    \"issue_date\": \"2020-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method for optimizing data storage in cloud environments by utilizing a tiered storage approach. The system dynamically allocates data to different storage tiers based on access frequency and data importance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for data storage comprising...\",\n        \"2. The method of claim 1, wherein...\",\n        \"3. A system for data storage...\",\n        \"4. The system of claim 3, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69451", "text": "{\n    \"patent_title\": \"High-Speed Optical Fiber Communication System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel optical fiber communication system utilizing advanced modulation techniques to achieve high data rates.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Optical Fiber Amplifier\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Wavelength Division Multiplexing\"\n        },\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Optical Signal Processing\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"title\": \"Coherent Optical Communication\"\n        },\n        {\n            \"patent_number\": \"US9234567B1\",\n            \"title\": \"Fiber Optic Cable Design\"\n        }\n    ],\n    \"claims\": [\n        \"A method for transmitting data using an optical fiber.\",\n        \"An optical fiber communication system comprising a transmitter and a receiver.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69451", "text": "{\n    \"patent_title\": \"Wireless Communication System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-02-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless communication system using radio frequency signals for data transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Radio Transceiver\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Antenna Design\"\n        }\n    ],\n    \"claims\": [\n        \"A method for transmitting data using radio waves.\",\n        \"A wireless communication system comprising a transmitter and a receiver.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69452", "text": "{\n    \"patent_title\": \"System for Image Recognition Using Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition using deep convolutional neural networks are disclosed. The system processes image data to identify objects and features with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"Cited by Examiner\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for image recognition comprising...\",\n        \"2. The system of claim 1, wherein...\",\n        \"3. A method for training a neural network...\",\n        \"4. The method of claim 3, wherein...\",\n        \"5. A computer-readable medium...\",\n        \"6. The computer-readable medium of claim 5, wherein...\",\n        \"7. A system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69452", "text": "{\n    \"patent_title\": \"A Method for Enhanced Data Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method for enhancing data analysis through statistical modeling. It improves efficiency and accuracy in identifying trends and patterns.\",\n    \"citations\": [],\n    \"claims\": [\n        \"1. A method for data analysis comprising...\",\n        \"2. The method of claim 1, wherein...\",\n        \"3. A system for implementing...\",\n        \"4. The system of claim 3, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69453", "text": "{\n    \"patent_title\": \"System and Method for Automated Text Summarization Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2019-08-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system and method for automatically summarizing text using deep learning techniques, specifically transformer networks. The system leverages artificial intelligence to identify key sentences and generate concise summaries. It has applications in news aggregation, document analysis, and information retrieval.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Neural Network Architecture for Language Modeling\"\n        }\n    ],\n    \"claims\": [\n        \"A system for automated text summarization comprising...\",\n        \"A method for generating a concise summary of a text document...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69453", "text": "{\n    \"patent_title\": \"AI-Powered Diagnostic Tool for Early Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11223344B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2021-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an artificial intelligence-based diagnostic tool for the early detection of cancerous tumors using medical imaging. It employs deep learning algorithms to analyze images and identify subtle indicators of malignancy.  The system aids radiologists in improving accuracy and speed of diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Medical Image Analysis System\"\n        },\n        {\n            \"patent_number\": \"US9654321B2\",\n            \"title\": \"Automated Cancer Cell Detection\"\n        }\n    ],\n    \"claims\": [\n        \"A method for diagnosing cancer utilizing AI...\",\n        \"A system for analyzing medical images to detect tumors...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69454", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Detail\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"IBM Research\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-06-10\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing image detail using a novel image processing algorithm. The algorithm improves clarity and resolution of digital images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image detail comprising...\",\n        \"A system for processing images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69454", "text": "{\n    \"patent_title\": \"Image Compression Technique Using Wavelets\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9123456B1\",\n    \"priority_date\": \"2015-02-15\",\n    \"filing_date\": \"2015-03-15\",\n    \"issue_date\": \"2017-09-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image compression technique utilizing wavelet transforms to reduce file size while maintaining image quality. This is achieved through a unique image processing approach.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing images using wavelet transforms...\",\n        \"A system for encoding and decoding image data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69455", "text": "{\n    \"patent_title\": \"Miniature Pressure Sensor with Integrated Signal Conditioning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-02-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature pressure sensor with integrated signal conditioning circuitry is disclosed. The sensor utilizes a MEMS diaphragm and provides high sensitivity and low noise. Applications include medical devices and industrial process control. This sensor offers improved accuracy and reliability compared to existing technologies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Similar pressure sensor design\"\n        }\n    ],\n    \"claims\": [\n        \"A pressure sensor comprising: a MEMS diaphragm...\",\n        \"The pressure sensor of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69455", "text": "{\n    \"patent_title\": \"Advanced Image Processing Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-09-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An advanced image processing algorithm for enhancing the quality of digital images. This algorithm utilizes a novel filtering technique to reduce noise and improve clarity. Applications include medical imaging and security surveillance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"relevance\": \"Related image filtering technique\"\n        }\n    ],\n    \"claims\": [\n        \"An image processing method comprising: applying a filtering...\",\n        \"The image processing method of claim 1, wherein the filtering...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69456", "text": "{\n    \"patent_title\": \"High-Performance Lithium-Ion Battery Electrode Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery electrode material comprising a composite of nickel-rich layered oxide and carbon nanotubes is disclosed. This material exhibits enhanced electrochemical performance and cycle life, making it suitable for high-energy density battery applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8546209B2\",\n            \"cited_document_title\": \"Advanced Lithium Ion Battery Separators\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrode material comprising...\",\n        \"The electrode material of claim 1, wherein the nickel-rich layered oxide...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69456", "text": "{\n    \"patent_title\": \"Battery Management System with Advanced Thermal Control\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Texas Instruments\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"University of Texas at Austin\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) is disclosed that utilizes advanced thermal control techniques to optimize the performance and lifespan of lithium-ion batteries. The BMS includes...\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"cited_document_title\": \"Battery Management System for Electric Vehicles\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"cited_document_title\": \"Advanced Lithium Ion Battery Chemistry\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"The battery management system of claim 1, wherein the thermal control...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69457", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Processing using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2019-06-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method and system for enhanced image processing utilizing deep learning techniques. The system allows for real-time image analysis, object recognition, and image enhancement.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Image Filtering Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing an image comprising...\",\n        \"A system for enhancing image quality...\",\n        \"The method of claim 1, wherein...\",\n        \"The system of claim 2, further comprising...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69457", "text": "{\n    \"patent_title\": \"Apparatus for Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2011-05-10\",\n    \"filing_date\": \"2011-05-10\",\n    \"issue_date\": \"2018-12-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An apparatus for improved wireless communication utilizing advanced modulation techniques. The invention enhances signal strength and reduces interference.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B2\",\n            \"title\": \"Modulation Techniques for Wireless Signals\"\n        }\n    ],\n    \"claims\": [\n        \"An apparatus comprising a transmitter...\",\n        \"A receiver configured to...\",\n        \"The apparatus of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69458", "text": "{\n    \"patent_title\": \"Novel Cathode Material for High-Performance Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel cathode material for lithium-ion batteries with improved energy density and cycle life. The material comprises a unique crystalline structure that enhances lithium-ion diffusion and stability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Material science related to electrode materials\"\n        }\n    ],\n    \"claims\": [\n        \"A cathode material for a lithium-ion battery comprising...\",\n        \"A lithium-ion battery comprising the cathode material...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69458", "text": "{\n    \"patent_title\": \"Battery Management System with Advanced Thermal Control\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2020-08-15\",\n    \"filing_date\": \"2020-08-15\",\n    \"issue_date\": \"2022-06-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a battery management system (BMS) for lithium-ion batteries, incorporating advanced thermal control algorithms to prevent overheating and extend battery lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"relevance\": \"Battery management system\"\n        },\n        {\n            \"patent_number\": \"US10101010B2\",\n            \"relevance\": \"Thermal regulation in batteries\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for thermal control of a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69459", "text": "{\n    \"patent_title\": \"Method and system for image enhancement using deep learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing images using deep convolutional neural networks. The system is trained on a large dataset of images and can automatically improve the quality of images by removing noise, increasing contrast, and enhancing details.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760978B2\",\n            \"title\": \"Image processing using wavelet transforms\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for enhancing an image comprising...\",\n        \"2. The method of claim 1, wherein the deep convolutional neural network...\",\n        \"3. A system for enhancing an image comprising...\",\n        \"4. The system of claim 3, wherein the training data...\",\n        \"5. The method of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69459", "text": "{\n    \"patent_title\": \"Improved Color Correction Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"David Smith\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2019-06-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new algorithm for color correction in digital images, enhancing visual appearance and clarity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7982845B2\",\n            \"title\": \"Digital image color space conversion\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for color correcting an image...\",\n        \"2. The method of claim 1, wherein the color correction...\",\n        \"3. A system for color correction...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69460", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2018-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system is disclosed. The system comprises a pressure sensor, a wireless communication module, and a power source. This sensor is designed for remote monitoring of various pressures in harsh environments.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"The system of claim 1, wherein the sensor is a piezoelectric sensor.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69460", "text": "{\n    \"patent_title\": \"Novel Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-02-15\",\n    \"filing_date\": \"2017-02-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery management system is disclosed. The system optimizes charging and discharging cycles to maximize battery life and performance. It utilizes advanced algorithms to prevent overheating and overcharging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"The system of claim 1, wherein the algorithms are based on machine learning.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69461", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to improved electrode materials for lithium-ion batteries, enhancing energy density and cycle life. The materials comprise a novel composite structure with enhanced lithium-ion conductivity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"kind\": \"Cited by Examiner\"\n        }\n    ],\n    \"claims\": [\n        \"1. A lithium-ion battery comprising...\",\n        \"2. The lithium-ion battery of claim 1, wherein...\",\n        \"3. An electrode material for a lithium-ion battery...\",\n        \"4. The electrode material of claim 3, comprising...\",\n        \"5. A method for manufacturing...\",\n        \"6. The method of claim 5, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69461", "text": "{\n    \"patent_title\": \"Novel Polymer Electrolytes for Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-12-10\",\n    \"filing_date\": \"2009-12-10\",\n    \"issue_date\": \"2017-05-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes novel polymer electrolytes for use in advanced battery systems, offering improved safety and flexibility. The electrolytes are based on a new class of sulfonated polymers.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"kind\": \"Cited by Applicant\"\n        }\n    ],\n    \"claims\": [\n        \"1. A polymer electrolyte comprising...\",\n        \"2. The polymer electrolyte of claim 1, wherein...\",\n        \"3. A battery cell comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69462", "text": "{\n    \"patent_title\": \"Wireless Temperature Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless temperature sensor system for industrial monitoring. The system utilizes low-power sensors to transmit temperature data to a central base station. The sensors are designed for harsh environments and can operate for extended periods on battery power. The data is processed to provide real-time temperature readings and alerts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related prior art in wireless communication\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless temperature sensor system comprising...\",\n        \"A method for monitoring temperature using a wireless sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69462", "text": "{\n    \"patent_title\": \"Implantable Medical Sensor\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-04-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable medical sensor for continuous glucose monitoring. The sensor utilizes biocompatible materials and provides accurate glucose readings in real-time. The system includes a wireless transmitter for data communication to an external receiver. This device is designed for diabetes management and patient health monitoring. Medical applications are central to this invention.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related prior art in glucose sensing technology\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable sensor for measuring glucose levels...\",\n        \"A system for continuous glucose monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69463", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Recognition Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2019-11-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing image recognition accuracy using deep convolutional neural networks. The system includes a preprocessing module, a feature extraction module, and a classification module.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Classification Using Support Vector Machines\"\n        },\n        {\n            \"patent_number\": \"US10234567B2\",\n            \"title\": \"Deep Learning for Object Detection\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Image Segmentation Techniques\"\n        },\n        {\n            \"patent_number\": \"US8901234B1\",\n            \"title\": \"Convolutional Neural Networks for Image Processing\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Feature Extraction from Images\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image recognition accuracy...\",\n        \"A system comprising a preprocessing module...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69463", "text": "{\n    \"patent_title\": \"Novel Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2019-05-20\",\n    \"filing_date\": \"2019-05-20\",\n    \"issue_date\": \"2021-02-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new algorithm for compressing data using Huffman coding and run-length encoding.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"title\": \"Data Compression using Lempel-Ziv Algorithm\"\n        },\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Huffman Coding for Data Compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data comprising...\",\n        \"A system for data compression based on...\"\n    ]\n}"}
