{"_id": "Academic--patents--n--66377", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11123456B2\",\n    \"priority_date\": \"2019-01-10\",\n    \"filing_date\": \"2019-05-20\",\n    \"issue_date\": \"2020-11-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a battery management system with improved charging efficiency and safety features. The system utilizes advanced algorithms to optimize battery performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10112233B1\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"The system of claim 1, wherein the charging algorithm is adaptive.\"\n    ]\n}"}
