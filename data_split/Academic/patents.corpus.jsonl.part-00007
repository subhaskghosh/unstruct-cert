{"_id": "Academic--patents--p--66236", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Predictive Maintenance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"University of Innovation\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for predictive maintenance utilizing artificial intelligence algorithms to analyze sensor data and predict potential equipment failures. The system improves efficiency and reduces downtime.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art in predictive maintenance.\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predictive maintenance comprising...\",\n        \"A method for analyzing sensor data using artificial intelligence...\",\n        \"The system of claim 1, further comprising...\",\n        \"The method of claim 2, wherein the artificial intelligence algorithm is a neural network...\",\n        \"The system of claim 3, wherein the sensor data includes vibration data...\",\n        \"The method of claim 2, wherein the prediction accuracy is at least 90%...\"\n    ]\n}"}
