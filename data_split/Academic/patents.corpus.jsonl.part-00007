{"_id": "Academic--patents--p--66671", "text": "{\n    \"patent_title\": \"Advanced Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-12-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to novel electrode materials for lithium-ion batteries, improving energy density and cycle life. The materials incorporate a unique nano-structured composite, resulting in enhanced performance characteristics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Similar electrode material composition\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode material...\",\n        \"The electrode material according to claim 1, wherein the nano-structured composite...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66671", "text": "{\n    \"patent_title\": \"Improved Lead-Acid Battery Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-01\",\n    \"issue_date\": \"2023-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved design for lead-acid batteries, focusing on enhanced electrolyte circulation and reduced corrosion.  The design includes a new grid structure for the lead plates.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Previous lead-acid battery designs\"\n        }\n    ],\n    \"claims\": [\n        \"A lead-acid battery comprising a grid structure...\",\n        \"The grid structure according to claim 1, characterized by...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66672", "text": "{\n    \"patent_title\": \"Method and System for AI-Powered Predictive Maintenance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2010-05-15\",\n    \"filing_date\": \"2010-06-01\",\n    \"issue_date\": \"2012-03-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for predictive maintenance using artificial intelligence techniques. Machine learning algorithms analyze sensor data to predict equipment failures and optimize maintenance schedules.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for predicting equipment failure comprising...\",\n        \"A system for implementing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66672", "text": "{\n    \"patent_title\": \"Improved Battery Charging Circuit\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2011-01-20\",\n    \"filing_date\": \"2011-02-10\",\n    \"issue_date\": \"2013-04-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new circuit design for improving the efficiency of battery charging. It uses a novel control algorithm to reduce charging time and improve battery life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery charging circuit comprising...\",\n        \"A control algorithm for optimizing charging efficiency...\"\n    ]\n}"}
