{"_id": "Academic--patents--p--66976", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Processing in Autonomous Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2021-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for enhancing image processing capabilities in autonomous vehicles, utilizing advanced algorithms to improve object detection and scene understanding. The system enhances the perception capabilities for safe navigation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Object Detection System\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Sensor Fusion Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A system for enhancing image processing in autonomous vehicles...\",\n        \"A method for improving object detection using image processing...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66976", "text": "{\n    \"patent_title\": \"Medical Image Analysis System for Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Mayo Clinic\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US11345678B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-03-01\",\n    \"issue_date\": \"2021-02-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system and method for analyzing medical images to detect tumors with high accuracy. The system employs advanced image processing techniques to identify subtle anomalies indicative of cancerous growths.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Medical Imaging System\"\n        },\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Segmentation Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A medical image analysis system for detecting tumors...\",\n        \"A method for identifying cancerous growths in medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66977", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Quality in Digital Photography\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for enhancing image quality in digital photography by employing advanced image processing techniques, including noise reduction and sharpening filters. It improves clarity and detail in photographs without introducing artifacts.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image quality...\",\n        \"A system for processing digital images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66977", "text": "{\n    \"patent_title\": \"Medical Image Analysis System with Enhanced Contrast\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Medical Tech Corp.\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US1234567B2\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-05-20\",\n    \"issue_date\": \"2019-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An image analysis system designed for medical applications. The system utilizes sophisticated image processing algorithms to enhance the contrast of medical images, facilitating more accurate diagnosis of diseases and conditions. Specifically targeting MRI and CT scan data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A system for analyzing medical images...\",\n        \"A method for improving contrast in MRI scans...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66978", "text": "{\n    \"patent_title\": \"Image Enhancement System Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-15\",\n    \"issue_date\": \"2013-06-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing the quality of digital images using deep convolutional neural networks. The system is capable of reducing noise, increasing sharpness, and improving overall image clarity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing a digital image comprising...\",\n        \"An image enhancement system comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66978", "text": "{\n    \"patent_title\": \"Wireless Communication System for Sensor Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2012-05-10\",\n    \"filing_date\": \"2012-05-10\",\n    \"issue_date\": \"2014-11-04\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless communication system designed for use in sensor networks. The system provides low-power, high-reliability communication between sensor nodes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication system comprising...\",\n        \"A sensor node comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66979", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Disease Diagnosis\",\n    \"inventors\": [\n        {\n            \"name\": \"David A. Sinclair\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Chen\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2019-03-10\",\n    \"issue_date\": \"2021-02-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a microfluidic device for the rapid and accurate diagnosis of infectious diseases. The device integrates sample preparation, nucleic acid amplification, and detection into a single, automated platform, providing results within 30 minutes. This enables point-of-care diagnostics in resource-limited settings.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in microfluidic sample preparation.\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for diagnosing a disease...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66979", "text": "{\n    \"patent_title\": \"Improved Surgical Instrument\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2018-08-20\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical instrument designed for increased precision.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related surgical instrument design.\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising...\",\n        \"A method of using the surgical instrument...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66980", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Thermal Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-15\",\n    \"filing_date\": \"2015-03-20\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery with improved thermal stability and cycle life is disclosed. The battery utilizes a novel electrolyte composition and electrode materials to prevent dendrite formation and thermal runaway.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"Cited by Applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66980", "text": "{\n    \"patent_title\": \"Novel Polymer Electrolyte for Solid-State Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-02-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A solid-state battery utilizing a novel polymer electrolyte is presented. The electrolyte exhibits high ionic conductivity and electrochemical stability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"kind\": \"Cited by Examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A solid-state battery comprising...\",\n        \"A polymer electrolyte with high ionic conductivity...\"\n    ]\n}"}
