{"_id": "Academic--patents--p--66134", "text": "{\n    \"patent_title\": \"System and method for dynamic resource allocation in cloud computing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for dynamically allocating resources in a cloud computing environment based on real-time demand and workload characteristics.  The system utilizes machine learning algorithms to predict future resource needs and proactively adjust resource allocation to optimize performance and cost.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related art in cloud resource management\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for dynamic resource allocation comprising...\",\n        \"2. The system of claim 1, wherein the resource allocation is...\",\n        \"3. A method for dynamic resource allocation...\",\n        \"4. The method of claim 3, further comprising...\",\n        \"5. The system of claim 1, wherein the machine learning algorithm is...\",\n        \"6. The system of claim 5, wherein the machine learning algorithm is a neural network...\",\n        \"7. The method of claim 3, wherein the real-time demand is measured by...\"\n    ]\n}"}
