{"_id": "Academic--patents--p--69065", "text": "{\n    \"patent_title\": \"Method and System for Image Enhancement Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-06-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the quality of digital images using a deep convolutional neural network. The network is trained to remove noise and artifacts, and to improve the overall visual appearance of the image.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Filtering Techniques\"\n        },\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"title\": \"Neural Network Architecture for Image Recognition\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing a digital image comprising:...\",\n        \"A system for enhancing a digital image comprising:...\"\n    ]\n}"}
