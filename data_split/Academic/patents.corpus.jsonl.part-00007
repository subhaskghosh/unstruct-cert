{"_id": "Academic--patents--p--66692", "text": "{\n    \"patent_title\": \"Novel Composite Material with Enhanced Strength\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT Materials Science\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel composite material exhibiting enhanced tensile strength and durability. The material comprises a polymer matrix reinforced with carbon nanotubes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Carbon Nanotube Reinforced Polymers\"\n        }\n    ],\n    \"claims\": [\n        \"A composite material comprising a polymer matrix and carbon nanotubes.\",\n        \"The composite material of claim 1, wherein the polymer matrix is epoxy resin.\",\n        \"The composite material of claim 1, wherein the carbon nanotubes have a diameter of between 1 and 10 nanometers.\",\n        \"A method for manufacturing the composite material of claim 1.\",\n        \"The method of claim 4, wherein the carbon nanotubes are dispersed in the polymer matrix using ultrasonication.\",\n        \"The method of claim 4, further comprising a curing step.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66692", "text": "{\n    \"patent_title\": \"Improved Semiconductor Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Intel Corporation\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2014-12-10\",\n    \"filing_date\": \"2014-12-10\",\n    \"issue_date\": \"2017-05-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved semiconductor device with reduced power consumption. The device utilizes a novel transistor structure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Low Power Transistor Design\"\n        }\n    ],\n    \"claims\": [\n        \"A semiconductor device comprising a transistor with a gate length of less than 10 nanometers.\",\n        \"The semiconductor device of claim 1, wherein the transistor is a FinFET.\",\n        \"The semiconductor device of claim 1, further comprising a power management circuit.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66693", "text": "{\n    \"patent_title\": \"Method and System for Personalized Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for providing personalized learning experiences based on individual student performance and learning styles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"Prior art in adaptive learning systems\"\n        }\n    ],\n    \"claims\": [\n        \"A method for personalized learning comprising...\",\n        \"A system for analyzing student performance...\",\n        \"A computer-readable medium storing instructions...\",\n        \"A graphical user interface for displaying learning content...\",\n        \"A method for generating personalized recommendations...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66693", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Sarah Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-05-20\",\n    \"issue_date\": \"2017-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery technology utilizing a new electrolyte material to improve energy density and lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"relevance\": \"Prior art in lithium-ion battery chemistry\"\n        }\n    ],\n    \"claims\": [\n        \"A battery comprising...\",\n        \"An electrolyte material...\",\n        \"A method for manufacturing a battery...\",\n        \"A battery cell with improved energy density...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66694", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel system and method for enhancing image recognition accuracy using deep convolutional neural networks. The system includes a pre-processing module, a feature extraction module, and a classification module.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for improving image recognition...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66694", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla, Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-07-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new battery management system designed to improve efficiency and lifespan of lithium-ion batteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system including...\",\n        \"A method for optimizing battery performance...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66695", "text": "{\n    \"patent_title\": \"System and Method for Machine Learning-Based Anomaly Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for detecting anomalies in data streams using machine learning algorithms. The system utilizes a deep neural network trained on historical data to identify patterns and deviations.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for anomaly detection comprising...\",\n        \"2. The system of claim 1, wherein the machine learning algorithm is a deep neural network.\",\n        \"3. A method for anomaly detection...\",\n        \"4. The method of claim 3, further comprising...\",\n        \"5. The system of claim 1, wherein the historical data comprises...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66695", "text": "{\n    \"patent_title\": \"Improved Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2021-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel data compression algorithm that achieves higher compression ratios compared to existing methods. It employs a combination of Huffman coding and run-length encoding.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10112233B2\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for data compression comprising...\",\n        \"2. The method of claim 1, wherein the Huffman coding is adaptive.\",\n        \"3. A system for data compression...\",\n        \"4. The system of claim 3, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66696", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a lithium-ion battery with a novel electrolyte composition and cell architecture, resulting in improved stability and cycle life. The improved battery is suitable for use in electric vehicles and other high-demand applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"The battery of claim 1, wherein...\",\n        \"A method of manufacturing...\",\n        \"The method of claim 3, wherein...\",\n        \"The battery of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66696", "text": "{\n    \"patent_title\": \"New Polymer Electrolyte for Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2022-01-10\",\n    \"filing_date\": \"2022-01-10\",\n    \"issue_date\": \"2023-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new polymer electrolyte for use in batteries, offering improved ionic conductivity and safety. The electrolyte is based on a novel polymer blend and exhibits excellent electrochemical performance.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A polymer electrolyte comprising...\",\n        \"The electrolyte of claim 1, wherein...\",\n        \"A battery cell comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66697", "text": "{\n    \"patent_title\": \"AI-Powered Predictive Maintenance System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an AI-powered system for predictive maintenance in industrial settings. Utilizing machine learning algorithms, the system analyzes sensor data to predict equipment failures and optimize maintenance schedules. Artificial intelligence is used for anomaly detection and predictive modeling.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Sensor Data Analysis System\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predicting equipment failure comprising...\",\n        \"A method for optimizing maintenance schedules...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66697", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Bicycle Technologies\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-01\",\n    \"issue_date\": \"2023-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a new bicycle brake design utilizing advanced materials for improved stopping power and durability. The system features a novel lever mechanism and enhanced heat dissipation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"title\": \"Bicycle Braking System\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle brake comprising...\",\n        \"A lever mechanism for applying braking force...\"\n    ]\n}"}
