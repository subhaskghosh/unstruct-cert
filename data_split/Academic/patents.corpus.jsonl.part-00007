{"_id": "Academic--patents--p--66932", "text": "{\n    \"patent_title\": \"System and Method for Federated Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2018-11-15\",\n    \"filing_date\": \"2019-05-20\",\n    \"issue_date\": \"2020-01-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for performing federated learning on decentralized data sources, enhancing privacy and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for federated learning comprising...\",\n        \"2. A method for training a machine learning model...\",\n        \"3. The system of claim 1, wherein...\",\n        \"4. The method of claim 2, further comprising...\",\n        \"5. A non-transitory computer-readable medium...\",\n        \"6. The system of claim 1, where privacy is enhanced...\"\n    ]\n}"}
