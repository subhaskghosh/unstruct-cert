{"_id": "Academic--patents--p--66032", "text": "{\n    \"patent_title\": \"Miniature Implantable Cardiac Monitor\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MedTech Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature implantable cardiac monitor for long-term heart rhythm monitoring. The device is designed for minimal invasiveness and extended battery life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art related to implantable cardiac devices\"\n        }\n    ],\n    \"claims\": [\n        \"A miniature implantable cardiac monitor comprising a sensor, a power source, and a communication module.\",\n        \"The monitor of claim 1, wherein the sensor is an electrocardiogram (ECG) sensor.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66032", "text": "{\n    \"patent_title\": \"Software for Data Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tech Solutions Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A software application for advanced data analysis and visualization. The software utilizes machine learning algorithms to identify patterns and trends in large datasets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US91234567B2\",\n            \"relevance\": \"Related algorithms for data processing\"\n        }\n    ],\n    \"claims\": [\n        \"A computer-implemented method for analyzing data comprising the steps of: receiving data input, processing the data using a machine learning algorithm, and displaying the results.\"\n    ]\n}"}
