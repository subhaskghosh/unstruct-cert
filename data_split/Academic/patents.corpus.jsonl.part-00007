{"_id": "Academic--patents--p--69715", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Improved Electrolyte Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Ben Carter\",\n            \"affiliation\": \"QuantumScape Corporation\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-05-20\",\n    \"issue_date\": \"2013-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery incorporating a novel electrolyte formulation exhibiting enhanced stability and extended cycle life. The electrolyte comprises a lithium salt dissolved in a mixture of organic carbonates.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related art in electrolyte compositions\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte formulation...\",\n        \"A method for manufacturing...\",\n        \"The lithium-ion battery according to claim 1...\",\n        \"The electrolyte formulation according to claim 2...\",\n        \"A system including the lithium-ion battery...\",\n        \"The system according to claim 6...\",\n        \"The method according to claim 3...\",\n        \"The lithium-ion battery according to claim 1, further comprising...\",\n        \"The electrolyte formulation according to claim 2, wherein...\",\n        \"The method according to claim 3, further comprising...\",\n        \"Claim 11\",\n        \"Claim 12\"\n    ]\n}"}
{"_id": "Academic--patents--n--69715", "text": "{\n    \"patent_title\": \"Nickel-Metal Hydride Battery with Enhanced Capacity\",\n    \"inventors\": [\n        {\n            \"name\": \"Carlos Rodriguez\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2009-12-01\",\n    \"filing_date\": \"2010-01-10\",\n    \"issue_date\": \"2012-08-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A nickel-metal hydride battery demonstrating increased energy density and improved performance characteristics. The battery employs a novel electrode material and optimized cell design.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"relevance\": \"Prior art in nickel-metal hydride battery technology\"\n        }\n    ],\n    \"claims\": [\n        \"A nickel-metal hydride battery...\",\n        \"An electrode material...\",\n        \"A method for assembling...\",\n        \"The nickel-metal hydride battery according to claim 1...\",\n        \"The electrode material according to claim 2...\",\n        \"The method according to claim 3...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69716", "text": "{\n    \"patent_title\": \"System and Method for Predictive Maintenance Using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for predictive maintenance utilizing machine learning algorithms to analyze sensor data and predict potential equipment failures. The system improves efficiency and reduces downtime.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art related to sensor data analysis.\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for predictive maintenance comprising...\",\n        \"2. The system of claim 1, wherein the machine learning algorithm is a neural network.\",\n        \"3. A method for predicting equipment failure...\",\n        \"4. The method of claim 3, further comprising...\",\n        \"5. The system of claim 1, wherein the sensor data includes temperature readings.\",\n        \"6. The system of claim 5, wherein the temperature readings are used to predict bearing failure.\",\n        \"7. The method of claim 3, further comprising sending an alert when a failure is predicted.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69716", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"CycleTech Corp.\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2023-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved bicycle brake system with enhanced stopping power and modulation. It features a novel caliper design and brake pad material.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art related to bicycle braking mechanisms.\"\n        }\n    ],\n    \"claims\": [\n        \"1. A bicycle brake system comprising...\",\n        \"2. The brake system of claim 1, wherein the caliper is made of aluminum.\",\n        \"3. A brake pad material for use in a bicycle brake system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69717", "text": "{\n    \"patent_title\": \"System and Method for Automated Code Generation using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2021-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for automatically generating source code from natural language descriptions using deep learning models. The system employs a transformer network to translate natural language into executable code, improving developer productivity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Neural Machine Translation System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating code...\",\n        \"A system comprising a neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69717", "text": "{\n    \"patent_title\": \"AI-Powered Diagnostic Tool for Cancer Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2018-11-22\",\n    \"filing_date\": \"2018-11-22\",\n    \"issue_date\": \"2021-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An artificial intelligence-based system for early detection of cancerous tumors using medical imaging data. The system utilizes convolutional neural networks to analyze images and identify potential abnormalities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Medical Image Analysis Method\"\n        },\n        {\n            \"patent_number\": \"US9987654B1\",\n            \"title\": \"Diagnostic Imaging System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for diagnosing cancer...\",\n        \"A system for analyzing medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69718", "text": "{\n    \"patent_title\": \"Improved Electrolyte for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-07-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel electrolyte composition for lithium-ion batteries, exhibiting enhanced ionic conductivity and improved thermal stability. It addresses issues of dendrite formation and capacity fade in high-energy-density lithium-ion cells.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8546220B2\",\n            \"title\": \"Lithium Iron Phosphate Cathode Material\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrolyte composition...\",\n        \"The electrolyte composition of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69718", "text": "{\n    \"patent_title\": \"Advanced Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10245789B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-14\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A sophisticated battery management system (BMS) designed to optimize the performance and lifespan of lithium-ion battery packs. It incorporates advanced algorithms for state-of-charge estimation, thermal management, and fault detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9124123B2\",\n            \"title\": \"Battery Management System with Cell Balancing\"\n        },\n        {\n            \"patent_number\": \"US8872541B2\",\n            \"title\": \"Thermal Management for Lithium-Ion Batteries\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising a processor...\",\n        \"The battery management system of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69719", "text": "{\n    \"patent_title\": \"Improved Electrode Material for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel electrode material for lithium-ion batteries with enhanced energy density and cycle life. The material comprises a modified lithium metal oxide composition.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8546045B2\",\n            \"relevance\": \"related art, different material composition\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode material...\",\n        \"The electrode material according to claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69719", "text": "{\n    \"patent_title\": \"Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Motors\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) for electric vehicles, optimizing charge and discharge cycles to prolong battery life and ensure safety. It utilizes advanced algorithms for state-of-charge estimation and cell balancing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9124112B2\",\n            \"relevance\": \"prior art in battery management\"\n        },\n        {\n            \"patent_number\": \"US8785690B2\",\n            \"relevance\": \"related to cell balancing techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"The battery management system according to claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69720", "text": "{\n    \"patent_title\": \"Method and System for Federated Learning with Differential Privacy\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for federated learning with differential privacy guarantees.  The system allows multiple clients to collaboratively train a machine learning model without sharing their raw data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        },\n        {\n            \"patent_number\": \"US11223344B1\"\n        },\n        {\n            \"patent_number\": \"US12112233B2\"\n        },\n        {\n            \"patent_number\": \"US13121122B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for federated learning...\",\n        \"A system for training a machine learning model...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69720", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2022-11-01\",\n    \"filing_date\": \"2022-11-01\",\n    \"issue_date\": \"2024-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery management system that optimizes charging and discharging cycles to extend battery life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B1\"\n        },\n        {\n            \"patent_number\": \"US87654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery performance...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69721", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Compression using Wavelet Transform\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Adobe Systems\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2015-03-15\",\n    \"filing_date\": \"2015-03-15\",\n    \"issue_date\": \"2018-05-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for enhancing image compression ratios using a novel wavelet transform technique. The method improves image quality at lower bitrates, suitable for various applications including digital photography and video streaming. It focuses on efficient encoding of image data for reduced storage and bandwidth requirements. This method offers improved image processing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8654321B1\",\n            \"title\": \"Improved Wavelet Coding Scheme\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image comprising...\",\n        \"A system for performing image compression...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69721", "text": "{\n    \"patent_title\": \"Medical Image Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-07-01\",\n    \"filing_date\": \"2016-07-01\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method for reconstructing medical images from raw data using deep learning techniques. It improves the quality and speed of image reconstruction for applications like MRI and CT scans. This is a significant advancement in image processing for diagnostic medicine.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"MRI Reconstruction Algorithm\"\n        },\n        {\n            \"patent_number\": \"US8789012B1\",\n            \"title\": \"CT Scan Image Enhancement\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing a medical image...\",\n        \"A system for processing medical imaging data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69722", "text": "{\n    \"patent_title\": \"Method and System for Noise Cancellation in Audio Signals\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Qualcomm\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-05-15\",\n    \"filing_date\": \"2010-06-01\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for noise cancellation in audio signals using adaptive signal processing techniques. The system utilizes a feedback loop to minimize unwanted noise and improve audio clarity. The invention is particularly useful in applications such as mobile phones and hearing aids.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Adaptive Filter for Noise Reduction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for noise cancellation in an audio signal comprising...\",\n        \"A system for noise cancellation comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69722", "text": "{\n    \"patent_title\": \"Improved Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2011-03-10\",\n    \"filing_date\": \"2011-04-01\",\n    \"issue_date\": \"2018-12-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a battery management system designed to optimize the performance and lifespan of lithium-ion batteries in electric vehicles. It includes advanced algorithms for state-of-charge estimation and thermal management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Lithium-ion Battery Monitoring System\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling the charge of a lithium-ion battery comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69723", "text": "{\n    \"patent_title\": \"Minimally Invasive Surgical System with Enhanced Feedback Control\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Langer\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Paula Hammond\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2008-05-15\",\n    \"filing_date\": \"2009-06-22\",\n    \"issue_date\": \"2019-04-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A minimally invasive surgical system incorporating haptic feedback and advanced imaging to reduce patient discomfort and improve surgical precision. The system utilizes micro-robotics and biocompatible materials for enhanced patient safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical system comprising a micro-robotic arm...\",\n        \"A method for performing minimally invasive surgery...\",\n        \"A haptic feedback mechanism for real-time force sensing...\",\n        \"A biocompatible coating for surgical instruments...\",\n        \"An imaging system integrated with the surgical arm...\",\n        \"A control system for precise robotic movements...\",\n        \"A user interface for controlling the surgical system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69723", "text": "{\n    \"patent_title\": \"Improved Catheter Design for Cardiovascular Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"James Collins\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2017-03-10\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel catheter design with improved flexibility and maneuverability for use in cardiovascular procedures.  Enhancements in material science allow for better navigation through complex vascular pathways.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8987654B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A catheter comprising a flexible distal tip...\",\n        \"A method for navigating a catheter through a blood vessel...\",\n        \"A material composition for enhancing catheter flexibility...\",\n        \"A coating for reducing friction within the vessel...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69724", "text": "{\n    \"patent_title\": \"System and Method for Image-Based Object Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2020-12-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for image-based object recognition utilizing deep convolutional neural networks. The system is capable of identifying objects with high accuracy and speed, and is applicable to a wide range of applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for image-based object recognition...\",\n        \"2. The system of claim 1, wherein the object is a...\",\n        \"3. A method for image-based object recognition...\",\n        \"4. The method of claim 3, comprising...\",\n        \"5. The system of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69724", "text": "{\n    \"patent_title\": \"Improved Method for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2019-01-10\",\n    \"filing_date\": \"2019-03-01\",\n    \"issue_date\": \"2021-08-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel method for data compression, improving efficiency and reducing storage requirements.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for data compression...\",\n        \"2. The method of claim 1, comprising...\",\n        \"3. A system for data compression...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69725", "text": "{\n    \"patent_title\": \"System and method for enhanced medical image analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing medical image analysis through advanced image processing techniques, including noise reduction and feature extraction. The system utilizes a novel algorithm to improve the accuracy of diagnostic imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"Prior art in image filtering\"\n        }\n    ],\n    \"claims\": [\n        \"A system for enhancing medical images comprising...\",\n        \"A method for reducing noise in medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69725", "text": "{\n    \"patent_title\": \"Improved image processing for mobile devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2010-03-01\",\n    \"filing_date\": \"2010-03-01\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to improved image processing techniques for mobile devices, enabling faster and more efficient image capture and display. Advanced algorithms are used for real-time image enhancement.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related to mobile image sensors\"\n        }\n    ],\n    \"claims\": [\n        \"A mobile device comprising an image processor configured to...\",\n        \"A method for real-time image enhancement in a mobile device...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69726", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-15\",\n    \"filing_date\": \"2015-03-10\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a miniature wireless pressure sensor system for real-time monitoring of physiological parameters. The system utilizes a MEMS pressure sensor and a low-power wireless transceiver.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for monitoring pressure using a wireless sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69726", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2013-11-20\",\n    \"filing_date\": \"2014-02-15\",\n    \"issue_date\": \"2019-05-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel lithium-ion battery with enhanced energy density and cycle life. The battery utilizes a new electrode material and electrolyte formulation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"A method for fabricating a high-energy-density battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69727", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Predictive Maintenance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US10545678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-11-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for predicting equipment failures using artificial intelligence and machine learning algorithms. The system analyzes sensor data to identify patterns indicative of potential failures, enabling proactive maintenance and reducing downtime.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predicting equipment failures comprising: a sensor data acquisition module; an artificial intelligence module...\",\n        \"A method for predictive maintenance…\"\n    ]\n}"}
{"_id": "Academic--patents--n--69727", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Cycle Dynamics Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2014-12-10\",\n    \"filing_date\": \"2014-12-10\",\n    \"issue_date\": \"2017-05-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an improved bicycle braking system utilizing a novel lever mechanism for increased stopping power and rider control. It addresses issues of brake fade and responsiveness during prolonged downhill rides.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle braking system comprising: a brake lever assembly...\",\n        \"A method of braking a bicycle…\"\n    ]\n}"}
{"_id": "Academic--patents--p--69728", "text": "{\n    \"patent_title\": \"System and Method for Personalized Medicine\",\n    \"inventors\": [\n        {\n            \"name\": \"David Baker\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jennifer Dunn\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-15\",\n    \"filing_date\": \"2015-03-20\",\n    \"issue_date\": \"2019-01-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for tailoring medical treatments to individual patients based on their genetic profiles and other relevant data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\"\n        },\n        {\n            \"patent_number\": \"US8901234B1\"\n        },\n        {\n            \"patent_number\": \"US9234567B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for personalized medicine comprising...\",\n        \"A system for identifying optimal treatment plans...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69728", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Elon Musk\",\n            \"affiliation\": \"Tesla\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-02-10\",\n    \"filing_date\": \"2016-08-15\",\n    \"issue_date\": \"2020-03-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved lithium-ion battery design with enhanced energy density and lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"A method for manufacturing a high-density battery cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69729", "text": "{\n    \"patent_title\": \"System for Image Recognition Using Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for image recognition utilizing deep convolutional neural networks. The system is capable of identifying objects with high accuracy and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Early Image Recognition Systems\"\n        }\n    ],\n    \"claims\": [\n        \"A system comprising a convolutional neural network for image recognition.\",\n        \"A method for training a convolutional neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69729", "text": "{\n    \"patent_title\": \"Method for Optimizing Neural Network Training with Gradient Descent\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2017-03-01\",\n    \"filing_date\": \"2017-03-01\",\n    \"issue_date\": \"2019-04-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved method for training neural networks using stochastic gradient descent. This method reduces training time and improves model accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9987654B2\",\n            \"title\": \"Stochastic Gradient Descent Algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"A method for training a neural network using stochastic gradient descent.\",\n        \"A system implementing the training method.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69730", "text": "{\n    \"patent_title\": \"System and method for AI-powered image recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for image recognition utilizing artificial intelligence techniques.  The system employs convolutional neural networks to identify objects within images with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69730", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2014-12-20\",\n    \"filing_date\": \"2014-12-20\",\n    \"issue_date\": \"2017-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved bicycle braking system utilizing a novel cable mechanism for increased responsiveness and safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle braking system comprising...\",\n        \"A cable mechanism for a bicycle brake...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69731", "text": "{\n    \"patent_title\": \"Miniaturized Electrochemical Sensor for Real-Time Biomarker Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2021-03-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized electrochemical sensor is disclosed for real-time detection of biomarkers in biological fluids. The sensor incorporates a novel nanomaterial-based sensing element and a microfluidic channel for efficient sample delivery. This sensor enables rapid and accurate diagnosis of various diseases.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A sensor comprising a nanomaterial-based sensing element.\",\n        \"A microfluidic device for delivering samples to the sensor.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69731", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Williams\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Emily Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2019-11-20\",\n    \"filing_date\": \"2019-11-20\",\n    \"issue_date\": \"2022-01-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system for electric vehicles, optimizing charge and discharge cycles to extend battery life and improve performance. Includes advanced algorithms for thermal management and cell balancing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising a thermal management module.\",\n        \"A cell balancing algorithm for optimizing battery performance.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69732", "text": "{\n    \"patent_title\": \"System and method for personalized learning using machine learning\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for personalized learning are disclosed. The system utilizes machine learning algorithms to analyze a student's performance and adapt the learning content accordingly. This improves learning outcomes and engagement.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for personalized learning comprising...\",\n        \"A system for personalized learning comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69732", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Tesla Motors\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system is described, enhancing efficiency and extending battery life. The system optimizes charging and discharging processes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for managing battery charging comprising...\"\n    ]\n}"}
