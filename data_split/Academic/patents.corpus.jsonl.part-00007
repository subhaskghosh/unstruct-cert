{"_id": "Academic--patents--p--66676", "text": "{\n    \"patent_title\": \"Method and System for Neural Network Based Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for image recognition using a deep neural network architecture. The system comprises a convolutional neural network followed by a fully connected layer for classification. The system achieves state-of-the-art accuracy on various image datasets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Prior Art Image Recognition System\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for image recognition comprising...\",\n        \"2. The method of claim 1, wherein the neural network is a convolutional neural network.\",\n        \"3. A system for performing image recognition...\",\n        \"4. The system of claim 3, comprising a processor...\",\n        \"5. The system of claim 3, further comprising a memory...\",\n        \"6. The method of claim 1, further comprising pre-processing the image data.\",\n        \"7. A non-transitory computer-readable medium...\"\n    ]\n}"}
