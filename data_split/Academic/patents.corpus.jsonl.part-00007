{"_id": "Academic--patents--n--66009", "text": "{\n    \"patent_title\": \"Advanced Image Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image compression technique using wavelet transforms and advanced quantization methods for efficient storage and transmission of image data. This involves advanced image processing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Wavelet Image Compression\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for compressing an image...\",\n        \"2. A system for compressing an image...\",\n        \"3. The method of claim 1, wherein...\",\n        \"4. The system of claim 2, wherein...\",\n        \"5. The method of claim 1, further comprising...\",\n        \"6. The system of claim 2, further comprising...\",\n        \"7. An apparatus for image compression...\"\n    ]\n}"}
