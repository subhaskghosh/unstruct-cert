{"_id": "Academic--patents--p--66172", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Restoration\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for restoring degraded images using deep learning techniques. The system employs a convolutional neural network to remove noise and enhance image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Denoising Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image restoration comprising...\",\n        \"A system for enhancing image quality...\",\n        \"A computer-readable medium storing instructions for...\",\n        \"The method of claim 1, wherein...\",\n        \"The system of claim 2, further comprising...\",\n        \"The method of claim 3, wherein the neural network is...\",\n        \"The system of claim 4, wherein the image is...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66172", "text": "{\n    \"patent_title\": \"Digital Image Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-08-01\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2021-03-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for compressing digital images using a wavelet transform. The technique reduces file size without significant loss of image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Wavelet Image Compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image comprising...\",\n        \"A system for reducing image file size...\",\n        \"A computer-readable medium storing instructions for...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66173", "text": "{\n    \"patent_title\": \"System and Method for Dynamic Spectrum Access\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-03-15\",\n    \"filing_date\": \"2010-05-20\",\n    \"issue_date\": \"2018-07-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for dynamically accessing spectrum resources based on real-time demand and interference levels.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Spectrum Sensing Techniques\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"title\": \"Cognitive Radio Systems\"\n        },\n        {\n            \"patent_number\": \"US9123456B1\",\n            \"title\": \"Interference Mitigation Techniques\"\n        },\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Dynamic Frequency Selection\"\n        },\n        {\n            \"patent_number\": \"US9345678B1\",\n            \"title\": \"Adaptive Modulation and Coding\"\n        }\n    ],\n    \"claims\": [\n        \"A system for dynamically accessing spectrum resources...\",\n        \"A method for allocating spectrum resources...\"\n    ]\n}"}
