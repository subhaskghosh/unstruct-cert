{"_id": "Academic--patents--p--66413", "text": "{\n    \"patent_title\": \"Method and System for Accelerated MRI Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for accelerated Magnetic Resonance Imaging (MRI) image reconstruction using deep learning techniques. The method significantly reduces scan time while maintaining image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in MRI reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing an MRI image comprising...\",\n        \"A system for performing MRI image reconstruction...\"\n    ]\n}"}
