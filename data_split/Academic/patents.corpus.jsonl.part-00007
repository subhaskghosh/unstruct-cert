{"_id": "Academic--patents--p--66856", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Data Encryption\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-08-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel system and method for encrypting data using a combination of symmetric and asymmetric encryption techniques to provide enhanced security.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for encrypting data comprising...\",\n        \"A method for decrypting data comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66856", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-06-01\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new battery technology providing increased energy density and longer lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10111213B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising...\",\n        \"A method for manufacturing a battery cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66857", "text": "{\n    \"patent_title\": \"System and method for image recognition using convolutional neural networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition utilizing convolutional neural networks to classify images with high accuracy. The system includes a preprocessing module, a convolutional network, and a classification module. The method involves inputting an image, processing it through the network, and outputting a classification result. This invention enables efficient and accurate image recognition for various applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Prior Art Image Recognition System\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for classifying images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66857", "text": "{\n    \"patent_title\": \"Novel Chemical Compound for Pharmaceutical Use\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Pfizer Inc.\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2008-11-01\",\n    \"filing_date\": \"2008-11-01\",\n    \"issue_date\": \"2012-07-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel chemical compound with pharmaceutical applications, specifically for the treatment of cardiovascular diseases. The compound exhibits high efficacy and minimal side effects. The invention relates to the synthesis and formulation of this compound, as well as methods of its use.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Existing Cardiovascular Drug\"\n        }\n    ],\n    \"claims\": [\n        \"A chemical compound with the formula...\",\n        \"A pharmaceutical composition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66858", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Processing Using Adaptive Filtering\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-03-15\",\n    \"filing_date\": \"2010-02-20\",\n    \"issue_date\": \"2018-07-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method and system for enhanced image processing utilizing adaptive filtering techniques. The system improves image quality and reduces noise in various applications, including medical imaging and surveillance. The core of the invention lies in the dynamic adjustment of filter parameters based on image characteristics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"Prior art in image filtering\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image comprising...\",\n        \"A system for processing images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66858", "text": "{\n    \"patent_title\": \"Improved Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2011-05-01\",\n    \"filing_date\": \"2011-11-15\",\n    \"issue_date\": \"2017-04-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery management system for electric vehicles is disclosed, improving energy efficiency and extending battery life. The system incorporates advanced control algorithms and monitoring capabilities to optimize battery performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"relevance\": \"Related to battery charging circuits\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66859", "text": "{\n    \"patent_title\": \"Miniature Implantable Device for Targeted Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2018-02-20\",\n    \"issue_date\": \"2019-06-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature implantable device for controlled and targeted drug delivery. The device utilizes microfluidic channels and biocompatible materials to provide precise dosage and minimize side effects.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Implantable Microchip for Drug Monitoring\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Controlled Release Drug Delivery System\"\n        },\n        {\n            \"patent_number\": \"US9543210B1\",\n            \"title\": \"Microfluidic Device for Biomedical Applications\"\n        },\n        {\n            \"patent_number\": \"US10012345B2\",\n            \"title\": \"Biocompatible Polymer for Implants\"\n        }\n    ],\n    \"claims\": [\n        \"A miniature implantable device comprising...\",\n        \"A method for targeted drug delivery using the device...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66859", "text": "{\n    \"patent_title\": \"Improved Surgical Scalpel Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11321456B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-01-10\",\n    \"issue_date\": \"2020-09-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical scalpel with enhanced ergonomics and blade sharpness, leading to more precise incisions and reduced patient trauma.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Ergonomic Surgical Instrument Handle\"\n        },\n        {\n            \"patent_number\": \"US8987654B1\",\n            \"title\": \"High-Precision Scalpel Blade Manufacturing\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical scalpel comprising...\",\n        \"A method for performing a surgical incision...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66860", "text": "{\n    \"patent_title\": \"Method and System for Adaptive Image Enhancement Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for adaptively enhancing images using a deep convolutional neural network. The network is trained to map low-quality images to high-quality images, improving visual clarity and detail.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for enhancing an image comprising...\",\n        \"2. The method of claim 1, wherein the neural network is a convolutional neural network.\",\n        \"3. A system for enhancing an image...\",\n        \"4. The system of claim 3, comprising a memory...\",\n        \"5. The method of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66860", "text": "{\n    \"patent_title\": \"Digital Image Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-09-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel approach to compressing digital images using wavelet transforms and quantization techniques.  The method achieves high compression ratios with minimal loss of image quality.\",\n    \"citations\": [],\n    \"claims\": [\n        \"1. A method for compressing an image comprising...\",\n        \"2. The method of claim 1, wherein the wavelet transform is a Daubechies wavelet.\",\n        \"3. A system for compressing an image...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66861", "text": "{\n    \"patent_title\": \"System and Method for Dynamic Resource Allocation in Cloud Computing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2019-10-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for dynamically allocating resources in a cloud computing environment based on real-time demand and performance metrics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Resource Management in Distributed Systems\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for dynamic resource allocation...\",\n        \"2. The system of claim 1, wherein...\",\n        \"3. A method for allocating resources...\",\n        \"4. The method of claim 3, comprising...\",\n        \"5. The system of claim 1, further comprising...\",\n        \"6. The method of claim 3, further comprising...\",\n        \"7. A computer-readable medium...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66861", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-02-10\",\n    \"issue_date\": \"2020-07-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery technology utilizing new materials to enhance energy density and lifespan for electric vehicle applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10112233B2\",\n            \"title\": \"Lithium-Ion Battery Improvements\"\n        }\n    ],\n    \"claims\": [\n        \"1. A battery cell comprising...\",\n        \"2. The battery cell of claim 1, wherein...\",\n        \"3. An electric vehicle utilizing...\"\n    ]\n}"}
