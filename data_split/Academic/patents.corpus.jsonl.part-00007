{"_id": "Academic--patents--p--69424", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2018-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved lithium-ion battery with enhanced stability and cycle life. The battery incorporates a novel electrolyte formulation and a modified electrode structure to mitigate dendrite formation and improve overall performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art related to electrolyte compositions.\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte formulation for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69424", "text": "{\n    \"patent_title\": \"Novel Polymer Electrolyte for Solid-State Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"3M\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2017-02-28\",\n    \"filing_date\": \"2017-02-28\",\n    \"issue_date\": \"2019-03-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel polymer electrolyte for use in solid-state batteries, offering improved safety and energy density.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related work on lithium-ion battery technology.\"\n        }\n    ],\n    \"claims\": [\n        \"A solid-state battery comprising...\",\n        \"A polymer electrolyte characterized by...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69425", "text": "{\n    \"patent_title\": \"System and method for AI-powered image recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-06-20\",\n    \"issue_date\": \"2012-09-04\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for image recognition utilizing artificial intelligence algorithms to improve accuracy and efficiency. The system employs deep learning techniques to analyze image data and identify objects with high precision.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for analyzing image data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69425", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Cycle Dynamics Ltd.\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Independent Consultant\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2011-05-10\",\n    \"filing_date\": \"2011-08-15\",\n    \"issue_date\": \"2013-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel bicycle brake system is disclosed, featuring improved modulation and stopping power. The system utilizes a new hydraulic fluid and caliper design for enhanced performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8234567B2\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle brake system comprising...\",\n        \"A hydraulic fluid for bicycle brakes...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69426", "text": "{\n    \"patent_title\": \"Medical Image Enhancement Using Adaptive Histogram Equalization\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing medical images using adaptive histogram equalization to improve contrast and visibility of subtle features. This invention is particularly useful in X-ray and MRI imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Histogram Equalization for Image Enhancement\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing a medical image comprising...\",\n        \"The method of claim 1, wherein the medical image is an X-ray image.\",\n        \"The method of claim 1, wherein the medical image is an MRI image.\",\n        \"A system for enhancing a medical image comprising...\",\n        \"The system of claim 4, wherein the medical image is a CT scan.\",\n        \"The system of claim 4, further comprising a display for visualizing the enhanced medical image.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69426", "text": "{\n    \"patent_title\": \"Method for Compressing Digital Images\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-05-20\",\n    \"issue_date\": \"2017-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel technique for compressing digital images using wavelet transform and quantization. This invention reduces storage space and transmission bandwidth.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"title\": \"Wavelet Image Compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a digital image comprising...\",\n        \"The method of claim 1, wherein the wavelet transform is a Daubechies wavelet.\",\n        \"A system for compressing a digital image comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69427", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for improved image recognition accuracy using deep convolutional neural networks. The system employs a novel architecture and training algorithm to achieve state-of-the-art results in various image classification tasks. The technology leverages advancements in machine learning for automated image analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        },\n        {\n            \"patent_number\": \"US8987654B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a convolutional neural network...\",\n        \"The system of claim 1, wherein the convolutional neural network...\",\n        \"The method of claim 2, further comprising...\",\n        \"The system of claim 1, wherein the image is a photograph.\",\n        \"The method of claim 2, wherein the training data is labeled.\",\n        \"A computer-readable medium storing instructions for...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69427", "text": "{\n    \"patent_title\": \"Method for Object Detection in Video Streams\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Beta Industries\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2012-06-01\",\n    \"filing_date\": \"2012-06-01\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a method for detecting objects in real-time video streams using background subtraction and motion analysis. It is useful in surveillance systems and automated monitoring applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for object detection in video streams...\",\n        \"The method of claim 1, wherein the background subtraction...\",\n        \"The method of claim 1, further comprising a filtering step...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69428", "text": "{\n    \"patent_title\": \"System and Method for Intelligent Route Planning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-05-20\",\n    \"issue_date\": \"2018-07-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for intelligent route planning using artificial intelligence algorithms. The system analyzes real-time traffic data to optimize routes for delivery vehicles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"description\": \"Route optimization algorithms.\"\n        }\n    ],\n    \"claims\": [\n        \"A system for route planning comprising...\",\n        \"A method for optimizing routes based on real-time data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69428", "text": "{\n    \"patent_title\": \"Smart Insulin Pump Control System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"BioTech Solutions\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-09-01\",\n    \"filing_date\": \"2017-11-15\",\n    \"issue_date\": \"2019-03-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a smart insulin pump control system utilizing artificial intelligence to personalize insulin delivery for patients with diabetes. The system continuously monitors glucose levels and adjusts insulin dosage accordingly.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"description\": \"Closed-loop insulin delivery systems for healthcare applications.\"\n        },\n        {\n            \"patent_number\": \"US8876543B1\",\n            \"description\": \"Glucose monitoring devices used in medical contexts.\"\n        }\n    ],\n    \"claims\": [\n        \"An insulin pump comprising...\",\n        \"A method for personalized insulin delivery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69429", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery management system with improved efficiency and safety features.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"Claim 1: A battery management system comprising...\",\n        \"Claim 2: The system of claim 1, further comprising...\",\n        \"Claim 3: The system of claim 2, wherein...\",\n        \"Claim 4: A method for managing a battery...\",\n        \"Claim 5: The method of claim 4, wherein...\",\n        \"Claim 6: The method of claim 4, comprising...\"\n    ]\n}"}
