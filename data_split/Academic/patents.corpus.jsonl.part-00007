{"_id": "Academic--patents--p--66351", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Data Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for leveraging artificial intelligence to analyze large datasets, identify patterns, and generate actionable insights. The system utilizes machine learning algorithms to improve data processing efficiency and accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for analyzing data using artificial intelligence.\",\n        \"A method for identifying patterns in large datasets.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66351", "text": "{\n    \"patent_title\": \"AI-Assisted Diagnostic Tool for Cardiac Arrhythmias\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MedTech Solutions\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Stanford Medical Center\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2020-06-10\",\n    \"filing_date\": \"2020-06-10\",\n    \"issue_date\": \"2022-12-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An AI-powered diagnostic tool for detecting and classifying cardiac arrhythmias using ECG data. This invention significantly improves the accuracy and speed of arrhythmia diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US12345678B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for diagnosing cardiac arrhythmias using artificial intelligence.\",\n        \"A diagnostic tool incorporating machine learning algorithms.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66352", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Segmentation Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-11-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for accurately segmenting images using deep convolutional neural networks. The system employs a multi-stage approach to improve segmentation performance, especially in challenging scenarios.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Segmentation Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A method for segmenting an image comprising...\",\n        \"The method of claim 1, wherein the deep learning model is a convolutional neural network.\",\n        \"A system for segmenting an image...\",\n        \"The system of claim 3, further comprising a user interface.\",\n        \"The system of claim 4, wherein the user interface allows a user to adjust segmentation parameters.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66352", "text": "{\n    \"patent_title\": \"Real-time Object Detection in Video Streams\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-07-01\",\n    \"filing_date\": \"2019-12-10\",\n    \"issue_date\": \"2021-03-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for real-time object detection in video streams using a combination of computer vision and machine learning techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10112233B2\",\n            \"title\": \"Video Analysis System\"\n        }\n    ],\n    \"claims\": [\n        \"A system for detecting objects in a video stream comprising...\",\n        \"The system of claim 1, wherein the objects are detected using a convolutional neural network.\",\n        \"The system of claim 2, further comprising a tracking module.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66353", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-05-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications. The sensor utilizes a MEMS pressure transducer and a low-power wireless communication module. The system offers high sensitivity and accuracy for remote monitoring of physiological pressure parameters.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A pressure sensor system comprising...\",\n        \"The system of claim 1, wherein the sensor is wireless.\",\n        \"The system of claim 2, further comprising a data processing unit.\",\n        \"The system of claim 3, wherein the data processing unit is configured to...\",\n        \"A method for measuring pressure using the system of claim 1.\",\n        \"The method of claim 5, wherein the pressure is physiological pressure.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66353", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2021-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles. The system enhances battery life and safety by optimizing charging and discharging processes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"The system of claim 1, wherein the battery is a lithium-ion battery.\",\n        \"The system of claim 2, further comprising a temperature sensor.\",\n        \"The system of claim 3, wherein the temperature sensor is used to regulate the charging rate.\"\n    ]\n}"}
