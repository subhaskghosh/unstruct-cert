{"_id": "Academic--patents--p--66552", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Recognition Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for improving image recognition accuracy using deep convolutional neural networks.  The system incorporates novel attention mechanisms to focus on relevant image features.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Classification Using Convolutional Neural Networks\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for image recognition comprising...\",\n        \"2. The method of claim 1, further comprising...\",\n        \"3. A system for image recognition...\",\n        \"4. The system of claim 3, wherein...\",\n        \"5. A computer-readable medium...\",\n        \"6. The computer-readable medium of claim 5, wherein...\"\n    ]\n}"}
