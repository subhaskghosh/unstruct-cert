{"_id": "Academic--patents--p--66070", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-06-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a miniature wireless pressure sensor system for biomedical applications. The system includes a low-power sensor, a wireless transmitter, and a receiver for data analysis. The sensor detects pressure changes within the body and transmits this data wirelessly to a remote monitoring station.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for measuring pressure using a wireless sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66070", "text": "{\n    \"patent_title\": \"Advanced Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2014-12-01\",\n    \"filing_date\": \"2014-12-01\",\n    \"issue_date\": \"2018-04-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel battery management system for electric vehicles. The system improves battery life and performance by optimizing charging and discharging cycles. It also provides real-time monitoring of battery health and safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"similar\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery performance...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66071", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrolyte Composition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel electrolyte composition for lithium-ion batteries, enhancing energy density and cycle life. The composition utilizes a unique solvent blend and lithium salt combination, resulting in improved ionic conductivity and electrochemical stability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8546062B2\",\n            \"year\": \"2013\"\n        },\n        {\n            \"patent_number\": \"US9203289B2\",\n            \"year\": \"2015\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrolyte comprising...\",\n        \"The electrolyte of claim 1, wherein the solvent blend...\",\n        \"A lithium-ion battery cell comprising the electrolyte of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66071", "text": "{\n    \"patent_title\": \"Advanced Lithium-Ion Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2011-11-20\",\n    \"filing_date\": \"2011-11-20\",\n    \"issue_date\": \"2019-03-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A sophisticated battery management system (BMS) designed for lithium-ion batteries. It optimizes charging and discharging, monitors cell health, and provides thermal management for improved battery performance and safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7005723B1\",\n            \"year\": \"2005\"\n        },\n        {\n            \"patent_number\": \"US7892551B2\",\n            \"year\": \"2010\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for a lithium-ion battery...\",\n        \"The system of claim 1, comprising a temperature sensor...\",\n        \"A method for controlling a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66072", "text": "{\n    \"patent_title\": \"High-Capacity Optical Fiber Communication System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Bell Labs\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-15\",\n    \"filing_date\": \"2014-08-20\",\n    \"issue_date\": \"2018-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel optical fiber communication system for high-speed signal transmission. The system employs a new fiber design and modulation scheme to achieve increased capacity and reduced signal loss.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Optical Fiber Amplifier\"\n        }\n    ],\n    \"claims\": [\n        \"A system for transmitting optical signals...\",\n        \"An optical fiber with a modified core...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66072", "text": "{\n    \"patent_title\": \"Wireless Communication Device\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10293847B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2017-02-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A portable wireless communication device utilizing radio frequency signals. This device allows for efficient data exchange between users.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"High-Capacity Optical Fiber Communication System\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication device comprising...\",\n        \"A method for transmitting data wirelessly...\"\n    ]\n}"}
