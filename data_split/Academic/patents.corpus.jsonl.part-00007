{"_id": "Academic--patents--n--66219", "text": "{\n    \"patent_title\": \"Advanced Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-08-15\",\n    \"issue_date\": \"2021-06-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel data compression algorithm that significantly reduces file sizes without loss of information.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for data compression...\",\n        \"2. A system for implementing the compression algorithm...\",\n        \"3. A software application utilizing the compression method...\",\n        \"4. A hardware device employing the compression method...\",\n        \"5. A process for encoding data...\",\n        \"6. A process for decoding data...\",\n        \"7. A computer-readable medium storing the compression algorithm...\",\n        \"8. A network configuration utilizing the compressed data...\",\n        \"9. A data storage system utilizing the compressed data...\",\n        \"10. A communication protocol utilizing the compressed data...\",\n        \"11. A method for transmitting data...\",\n        \"12. A method for receiving data...\",\n        \"13. A system for managing compressed data...\",\n        \"14. A method for verifying the integrity of compressed data...\",\n        \"15. A method for recovering compressed data...\",\n        \"16. A system for secure data compression...\",\n        \"17. A method for optimizing compression parameters...\",\n        \"18. A method for adapting to different data types...\",\n        \"19. A system for real-time data compression...\",\n        \"20. A method for error correction in compressed data...\"\n    ]\n}"}
