{"_id": "Academic--patents--p--66182", "text": "{\n    \"patent_title\": \"Neural Network Accelerator for Edge Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-04-20\",\n    \"issue_date\": \"2022-08-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel neural network accelerator optimized for edge devices. The accelerator utilizes a sparse matrix representation to reduce memory bandwidth requirements and improve energy efficiency. It is designed for deployment in mobile and embedded systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Low-Power Memory Access for Neural Networks\"\n        }\n    ],\n    \"claims\": [\n        \"A neural network accelerator comprising...\",\n        \"A method for accelerating neural network inference...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66182", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"California Institute of Technology (Caltech)\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2020-05-01\",\n    \"filing_date\": \"2020-06-10\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved battery management system for electric vehicles. The system utilizes advanced algorithms to optimize charging and discharging cycles, extending battery life and improving performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Adaptive Charging Control for Lithium-Ion Batteries\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery charging...\"\n    ]\n}"}
