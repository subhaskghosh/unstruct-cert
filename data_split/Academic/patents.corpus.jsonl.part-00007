{"_id": "Academic--patents--p--66039", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the resolution of digital images using deep convolutional neural networks. The system learns to map low-resolution images to high-resolution images, improving image clarity and detail.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for enhancing image resolution comprising...\",\n        \"2. The method of claim 1, wherein the deep learning model is a convolutional neural network.\",\n        \"3. A system for enhancing image resolution...\",\n        \"4. The system of claim 3, comprising a processor...\",\n        \"5. The method of claim 1, further comprising...\",\n        \"6. The system of claim 3, further comprising...\",\n        \"7. A non-transitory computer-readable medium...\",\n        \"8. The computer-readable medium of claim 7...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66039", "text": "{\n    \"patent_title\": \"Improved Color Calibration for Digital Cameras\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-08-01\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2021-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for automatically calibrating the colors of digital cameras to ensure accurate color reproduction. The system analyzes a test chart and adjusts the camera's color settings accordingly.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for calibrating color in a digital camera...\",\n        \"2. The method of claim 1, wherein the test chart comprises a series of color patches...\",\n        \"3. A system for calibrating color...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66040", "text": "{\n    \"patent_title\": \"AI-Powered Predictive Maintenance System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system for predictive maintenance using artificial intelligence algorithms. The system analyzes sensor data to predict equipment failures and optimize maintenance schedules.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art on sensor data analysis\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predicting equipment failures comprising...\",\n        \"A method for optimizing maintenance schedules...\",\n        \"The system of claim 1, wherein the algorithms are based on machine learning.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66040", "text": "{\n    \"patent_title\": \"Smart Insulin Pump with AI Control\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MedicalTech Solutions\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-01\",\n    \"issue_date\": \"2022-08-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An intelligent insulin pump utilizing artificial intelligence for automated glucose level management. The pump adjusts insulin dosage based on real-time patient data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous work on insulin pump technology\"\n        }\n    ],\n    \"claims\": [\n        \"An insulin pump comprising an AI control module...\",\n        \"A method for automated glucose level management using AI...\",\n        \"The pump of claim 1, further comprising a medical device interface.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66041", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery with Enhanced Safety Features\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-04-20\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved lithium-ion battery design incorporating a novel electrolyte and separator material to enhance safety and performance. The battery exhibits increased cycle life and reduced risk of thermal runaway.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"The battery of claim 1, wherein the electrolyte...\",\n        \"The battery of claim 2, further comprising...\",\n        \"A method for manufacturing...\",\n        \"A system utilizing the lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66041", "text": "{\n    \"patent_title\": \"Novel Solar Cell Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2019-12-01\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2021-05-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new type of solar cell with improved efficiency using perovskite materials.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A solar cell comprising...\",\n        \"The solar cell of claim 1, wherein the perovskite...\",\n        \"The solar cell of claim 2, further comprising...\",\n        \"A method for manufacturing...\",\n        \"A system utilizing the solar cell...\",\n        \"Another claim...\",\n        \"Yet another claim...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66042", "text": "{\n    \"patent_title\": \"System and method for anomaly detection using machine learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for detecting anomalies in data streams using machine learning algorithms. The system utilizes a recurrent neural network to identify deviations from normal patterns.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for anomaly detection comprising...\",\n        \"A method for training a machine learning model...\"\n    ]\n}"}
