{"_id": "Academic--patents--p--66967", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Thermal Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-07-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery design featuring a polymer electrolyte and enhanced thermal stability. This invention addresses the safety concerns associated with conventional lithium-ion batteries and improves their overall performance. This battery technology is applicable in electric vehicles and grid storage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Improved Battery Management System\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising a polymer electrolyte...\",\n        \"A battery cell with enhanced thermal stability...\",\n        \"An electric vehicle utilizing the battery of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66967", "text": "{\n    \"patent_title\": \"Wireless Communication Protocol for IoT Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-08-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new wireless communication protocol optimized for low-power Internet of Things (IoT) devices. This protocol utilizes a novel modulation scheme to reduce energy consumption and improve data throughput.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A wireless communication protocol comprising a novel modulation scheme...\",\n        \"An IoT device utilizing the protocol of claim 1...\"\n    ]\n}"}
