{"_id": "Academic--patents--p--66995", "text": "{\n    \"patent_title\": \"System and Method for Intelligent Data Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2018-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for intelligent data analysis utilizing artificial intelligence techniques, including machine learning and deep neural networks, to identify patterns and anomalies in large datasets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Data Mining System\"\n        }\n    ],\n    \"claims\": [\n        \"A system for intelligent data analysis comprising...\",\n        \"A method for identifying anomalies in a dataset...\"\n    ]\n}"}
