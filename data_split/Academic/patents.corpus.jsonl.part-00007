{"_id": "Academic--patents--p--69340", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for enhancing image reconstruction using advanced image processing techniques.  This invention significantly improves image quality in low-light conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image reconstruction comprising...\",\n        \"A system for enhancing image quality...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69340", "text": "{\n    \"patent_title\": \"Improved Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US11334455B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An innovative data compression algorithm achieving high compression ratios while maintaining data integrity. This algorithm is applicable to various data types and storage systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10112233B1\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A data compression method comprising...\",\n        \"A system for compressing data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69341", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Stability and Cycle Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery design incorporating a solid-state electrolyte and a modified cathode material to improve stability, cycle life, and energy density. The battery demonstrates enhanced safety features and improved performance characteristics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"The lithium-ion battery of claim 1, wherein...\",\n        \"A method for manufacturing...\",\n        \"The method of claim 3, wherein...\",\n        \"A system comprising the lithium-ion battery of claim 1.\",\n        \"The system of claim 5, wherein...\",\n        \"The solid-state electrolyte of claim 2, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69341", "text": "{\n    \"patent_title\": \"Improved Lead-Acid Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Motors\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-07-01\",\n    \"filing_date\": \"2017-07-01\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved lead-acid battery with enhanced charging efficiency and reduced sulfation. The battery uses a novel additive to the electrolyte to prolong its lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A lead-acid battery comprising...\",\n        \"The lead-acid battery of claim 1, wherein...\",\n        \"A method for charging...\",\n        \"The method of claim 3, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69342", "text": "{\n    \"patent_title\": \"Improved Electrolyte Composition for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Anya Sharma\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Ben Carter\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-14\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel electrolyte composition for lithium-ion batteries, enhancing energy density and cycle life. The electrolyte incorporates a new lithium salt and a tailored solvent mixture, resulting in improved performance characteristics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Lithium-Ion Battery with Enhanced Stability\"\n        }\n    ],\n    \"claims\": [\n        \"1. An electrolyte composition comprising...\",\n        \"2. The electrolyte composition of claim 1, wherein...\",\n        \"3. A lithium-ion battery cell comprising...\",\n        \"4. The lithium-ion battery cell of claim 3, wherein...\",\n        \"5. A method of manufacturing...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69342", "text": "{\n    \"patent_title\": \"Electric Vehicle Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Elon Musk\",\n            \"affiliation\": \"Tesla, Inc.\"\n        },\n        {\n            \"name\": \"JB Straubel\",\n            \"affiliation\": \"Tesla, Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10458912B1\",\n    \"priority_date\": \"2017-05-01\",\n    \"filing_date\": \"2017-04-30\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system for electric vehicles that optimizes performance and longevity. The system monitors cell voltage, temperature, and current to ensure safe and efficient operation. Utilizes lithium-ion battery technology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8987654B2\",\n            \"title\": \"Advanced Battery Control Algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"1. A battery management system comprising...\",\n        \"2. The battery management system of claim 1, wherein...\",\n        \"3. A method of controlling...\",\n        \"4. The method of claim 3, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69343", "text": "{\n    \"patent_title\": \"Method and System for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for image recognition using artificial intelligence techniques, including convolutional neural networks. The system significantly improves accuracy and speed compared to prior art.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Previous Image Recognition System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69343", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Independent Inventor\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2014-12-01\",\n    \"filing_date\": \"2014-12-01\",\n    \"issue_date\": \"2017-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new bicycle brake system that provides enhanced stopping power and improved modulation. It uses a novel hydraulic lever design for better control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Traditional Bicycle Brake System\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle brake system comprising...\",\n        \"A hydraulic lever for a bicycle brake system...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69344", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Cycle Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2018-06-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery with a novel electrolyte composition demonstrating enhanced cycle life and improved safety characteristics is disclosed. The invention addresses limitations in current lithium-ion battery technology by utilizing a new polymer electrolyte blend.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69344", "text": "{\n    \"patent_title\": \"Advanced Sodium-Ion Battery Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        },\n        {\n            \"name\": \"Eve Franklin\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-05-20\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a sodium-ion battery with improved energy density and power output. The battery utilizes a novel cathode material and electrolyte system.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related Art\"\n        }\n    ],\n    \"claims\": [\n        \"A sodium-ion battery comprising...\",\n        \"A cathode material for a sodium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69345", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for implantable medical devices. The system includes a micro-sensor, a low-power transmitter, and a receiver for remote data monitoring. The sensor utilizes MEMS technology to achieve high sensitivity and accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising: a micro-sensor configured to measure pressure; a transmitter...\",\n        \"The system of claim 1, wherein the micro-sensor is a MEMS device.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69345", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Tesla\"\n        },\n        {\n            \"name\": \"Eve Green\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery management system designed to improve the efficiency and lifespan of lithium-ion batteries in electric vehicles. The system utilizes advanced algorithms for cell balancing and thermal management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising: a cell balancing circuit; a thermal management system...\",\n        \"The system of claim 1, wherein the cell balancing circuit utilizes a capacitive charge transfer method.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69346", "text": "{\n    \"patent_title\": \"Method and System for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-06-01\",\n    \"issue_date\": \"2018-04-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for image recognition utilizing artificial intelligence algorithms, specifically convolutional neural networks. The system improves accuracy and speed of image analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image analysis using...\",\n        \"An artificial intelligence algorithm...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69346", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"California Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-08-10\",\n    \"issue_date\": \"2017-01-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel braking system for bicycles, providing enhanced stopping power and control. It features a modified caliper design and improved pad materials.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"relevance\": \"Prior art in bicycle brakes\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle braking system comprising...\",\n        \"A caliper design for improved...\",\n        \"Braking pads with enhanced...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69347", "text": "{\n    \"patent_title\": \"System and Method for Image Recognition Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition utilizing deep convolutional neural networks. The system is capable of identifying objects and scenes with high accuracy, even in challenging conditions. Applications include autonomous vehicles, medical imaging, and security systems. The invention improves upon existing image recognition techniques by employing a novel network architecture.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        },\n        {\n            \"patent_number\": \"US10234567B1\"\n        },\n        {\n            \"patent_number\": \"US11345678B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition...\",\n        \"A method for identifying objects in an image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69347", "text": "{\n    \"patent_title\": \"Method for Enhancing Audio Signal Clarity\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2012-03-10\",\n    \"filing_date\": \"2012-03-10\",\n    \"issue_date\": \"2018-11-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for enhancing the clarity of audio signals by reducing noise and distortion. The method employs a novel filtering technique to improve signal quality. Applications include telecommunications, audio recording, and music production.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        },\n        {\n            \"patent_number\": \"US8123456B2\"\n        },\n        {\n            \"patent_number\": \"US9123457B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing audio signal clarity...\",\n        \"A system for reducing noise in an audio signal...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69348", "text": "{\n    \"patent_title\": \"System and Method for Image Recognition using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-05-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for image recognition using deep convolutional neural networks. The system can identify objects, scenes, and faces with high accuracy. Applications include autonomous vehicles, medical imaging, and security systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Prior Art Image Recognition System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69348", "text": "{\n    \"patent_title\": \"Novel Method for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"EP1234567A1\",\n    \"priority_date\": \"2017-01-10\",\n    \"filing_date\": \"2017-01-10\",\n    \"issue_date\": \"2019-08-01\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"This invention describes a novel method for data compression utilizing wavelet transforms and entropy encoding. It achieves high compression ratios with minimal data loss.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Previous Data Compression Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising...\",\n        \"A system for data compression comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69349", "text": "{\n    \"patent_title\": \"Method and System for Personalized Recommendation Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for providing personalized recommendations to users. The system employs a deep learning model trained on user data to predict user preferences and generate relevant recommendations. This method significantly improves the accuracy of recommendations compared to traditional collaborative filtering techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for providing personalized recommendations...\",\n        \"2. The method of claim 1, wherein the deep learning model...\",\n        \"3. A system comprising...\",\n        \"4. The system of claim 3, further comprising...\",\n        \"5. A computer-readable medium storing...\",\n        \"6. The computer-readable medium of claim 5...\",\n        \"7. The method of claim 1, wherein user data includes...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69349", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel bicycle brake system incorporating a dual-piston caliper design and improved heat dissipation properties. This brake system provides increased stopping power and enhanced safety for cyclists.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"1. A bicycle brake system comprising...\",\n        \"2. The bicycle brake system of claim 1, wherein the caliper...\",\n        \"3. The bicycle brake system of claim 2, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69350", "text": "{\n    \"patent_title\": \"Wireless Power Transfer System and Method\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-05-15\",\n    \"filing_date\": \"2010-06-01\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless power transfer system utilizes resonant inductive coupling to efficiently transfer power from a power source to a receiving device. The system is designed for various applications, including charging portable electronic devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art in inductive charging\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless power transfer system comprising...\",\n        \"A method for wirelessly charging a device...\",\n        \"The system of claim 1, wherein...\",\n        \"The method of claim 2, wherein...\",\n        \"A resonant inductive coupling circuit...\",\n        \"A control unit configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69350", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2011-02-10\",\n    \"filing_date\": \"2011-03-15\",\n    \"issue_date\": \"2017-09-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery design utilizing advanced materials for increased energy density and lifespan. This invention focuses on improving the chemical composition of battery electrodes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related to lithium-ion battery technology\"\n        }\n    ],\n    \"claims\": [\n        \"A battery comprising...\",\n        \"An electrode material...\",\n        \"The battery of claim 1, wherein...\",\n        \"A method for manufacturing the battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69351", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Processing Using Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2013-12-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for enhanced image processing using convolutional neural networks. The system efficiently processes images for object recognition and classification.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image processing comprising...\",\n        \"A system for image processing...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69351", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Microsoft Research\"\n        },\n        {\n            \"name\": \"Eve Edwards\",\n            \"affiliation\": \"IBM\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2010-03-01\",\n    \"filing_date\": \"2010-03-01\",\n    \"issue_date\": \"2012-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an improved algorithm for lossless data compression, achieving higher compression ratios and faster processing speeds.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising...\",\n        \"A system for data compression...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69352", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel electrode materials for lithium-ion batteries with improved energy density and cycle life. The materials exhibit enhanced ionic conductivity and reduced polarization.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Lithium-Ion Battery Separators\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode material...\",\n        \"The electrode material according to claim 1, wherein the material...\",\n        \"A method for manufacturing a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69352", "text": "{\n    \"patent_title\": \"Advanced Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-22\",\n    \"filing_date\": \"2017-03-22\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new battery design utilizing lithium-ion technology with improved thermal management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Battery Cooling Systems\"\n        }\n    ],\n    \"claims\": [\n        \"A battery system comprising a lithium-ion cell...\",\n        \"The battery system according to claim 1, wherein the system...\",\n        \"A method for controlling the temperature of a battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69353", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Improved Electrolyte\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery utilizing a novel electrolyte composition to enhance performance and safety. The electrolyte includes a lithium salt and a blend of organic solvents, resulting in improved ionic conductivity and reduced flammability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69353", "text": "{\n    \"patent_title\": \"Nickel-Metal Hydride Battery Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-12-10\",\n    \"filing_date\": \"2009-12-10\",\n    \"issue_date\": \"2017-05-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved nickel-metal hydride battery design with enhanced cycle life and energy density. The invention focuses on a novel electrode structure and a new metal hydride alloy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A nickel-metal hydride battery comprising...\",\n        \"An electrode structure for a nickel-metal hydride battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69354", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Improved Thermal Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Tesla, Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery with a novel electrolyte formulation and cell structure to improve thermal stability and cycle life. The invention addresses safety concerns associated with high-energy density lithium-ion batteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"The battery of claim 1, wherein the electrolyte...\",\n        \"A method of manufacturing a lithium-ion battery...\",\n        \"The method of claim 3, wherein the cell structure...\",\n        \"The battery of claim 1, further comprising a safety mechanism...\",\n        \"The safety mechanism of claim 5, comprising a thermal fuse...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69354", "text": "{\n    \"patent_title\": \"Novel Polymer for Flexible Electronics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-05-20\",\n    \"issue_date\": \"2018-01-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new polymer material with exceptional flexibility and conductivity, suitable for use in flexible electronic devices. The material exhibits high tensile strength and resistance to degradation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"type\": \"related_art\"\n        }\n    ],\n    \"claims\": [\n        \"A polymer material comprising...\",\n        \"The polymer material of claim 1, wherein the molecular weight...\",\n        \"A flexible electronic device comprising the polymer material...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69355", "text": "{\n    \"patent_title\": \"Novel Polymer Composites for High-Strength Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2018-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to novel polymer composites exhibiting enhanced strength and durability. The polymers are modified with nanoparticles to achieve superior mechanical properties. Applications include aerospace and automotive industries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A polymer composite comprising...\",\n        \"A method for manufacturing the polymer composite...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69355", "text": "{\n    \"patent_title\": \"Advanced Ceramic Coatings for Turbine Blades\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Caltech\"\n        }\n    ],\n    \"patent_number\": \"US9123456B1\",\n    \"priority_date\": \"2017-02-20\",\n    \"filing_date\": \"2017-02-20\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel ceramic coating process for turbine blades, enhancing thermal resistance and reducing wear. The coating consists of a multi-layered structure of refractory oxides.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A ceramic coating composition comprising...\",\n        \"A turbine blade coated with the ceramic composition...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69356", "text": "{\n    \"patent_title\": \"Method and System for Image Enhancement using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing images using deep convolutional neural networks. The system learns to remove noise and improve image clarity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Processing Techniques\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Convolutional Neural Networks\"\n        },\n        {\n            \"patent_number\": \"US9456789B1\",\n            \"title\": \"Image Noise Reduction\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Digital Image Processing\"\n        },\n        {\n            \"patent_number\": \"US8901234B1\",\n            \"title\": \"Image Enhancement Algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image comprising...\",\n        \"A system for enhancing an image comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69356", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10293847B1\",\n    \"priority_date\": \"2017-08-10\",\n    \"filing_date\": \"2017-08-10\",\n    \"issue_date\": \"2020-02-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new algorithm for compressing data efficiently. This algorithm provides better compression ratios than existing methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Data Compression Techniques\"\n        },\n        {\n            \"patent_number\": \"US8765431B2\",\n            \"title\": \"Lossless Data Compression\"\n        },\n        {\n            \"patent_number\": \"US9123455B1\",\n            \"title\": \"Efficient Data Encoding\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data comprising...\",\n        \"A system for compressing data comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69357", "text": "{\n    \"patent_title\": \"Improved Electrolyte Composition for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel electrolyte composition for lithium-ion batteries, improving their energy density and cycle life. The electrolyte comprises a lithium salt, a solvent mixture, and an additive that enhances the ionic conductivity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Lithium Metal Anode for High Energy Density Batteries\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrolyte...\",\n        \"The electrolyte of claim 1, further comprising an additive...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69357", "text": "{\n    \"patent_title\": \"Battery Management System with Advanced Thermal Control\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla, Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-09-20\",\n    \"filing_date\": \"2017-09-20\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) for lithium-ion batteries featuring advanced thermal control and cell balancing algorithms. The BMS improves battery performance and safety by regulating temperature and voltage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Methods for Controlling Temperature in Battery Packs\"\n        },\n        {\n            \"patent_number\": \"US8789012B1\",\n            \"title\": \"Cell Balancing Techniques for Lithium-Ion Batteries\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for a lithium-ion battery...\",\n        \"The battery management system of claim 1, comprising a thermal control unit...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69358", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for image recognition using artificial intelligence techniques, specifically convolutional neural networks. It improves accuracy and efficiency in identifying objects within images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69358", "text": "{\n    \"patent_title\": \"Improved Internal Combustion Engine Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Robert Smith\",\n            \"affiliation\": \"General Motors\"\n        }\n    ],\n    \"patent_number\": \"US8654321B1\",\n    \"priority_date\": \"2009-12-10\",\n    \"filing_date\": \"2009-12-10\",\n    \"issue_date\": \"2018-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved design for internal combustion engines, focusing on fuel efficiency and reduced emissions. It utilizes a novel valve timing mechanism.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B2\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"An internal combustion engine comprising...\",\n        \"A valve timing mechanism...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69359", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Material\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery electrode material with enhanced energy density and cycle life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in lithium-ion battery technology\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrode material comprising...\",\n        \"The electrode material of claim 1, wherein...\",\n        \"A lithium-ion battery cell comprising the electrode material...\",\n        \"The battery cell of claim 3, wherein...\",\n        \"A method for manufacturing the electrode material...\",\n        \"The method of claim 5, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69359", "text": "{\n    \"patent_title\": \"Method for Enhanced Oil Recovery\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"ExxonMobil\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2022-06-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for enhancing oil recovery from subterranean reservoirs using a novel polymer flooding technique.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related to polymer flooding techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing oil recovery comprising...\",\n        \"The method of claim 1, wherein...\",\n        \"A polymer composition for use in the method...\",\n        \"The polymer composition of claim 3, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69360", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2019-06-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery design featuring a solid-state electrolyte and a modified cathode material for improved stability and energy density.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Lithium-Ion Battery Cathode Material\"\n        },\n        {\n            \"patent_number\": \"US9543210B2\",\n            \"title\": \"Solid-State Electrolyte for Batteries\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Battery Management System\"\n        },\n        {\n            \"patent_number\": \"US20170321012A1\",\n            \"title\": \"Improved Electrolyte Additives\"\n        },\n        {\n            \"patent_number\": \"US20190289012A1\",\n            \"title\": \"Advanced Battery Separators\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"The battery of claim 1, wherein the electrolyte is...\",\n        \"A method for manufacturing the battery of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69360", "text": "{\n    \"patent_title\": \"New Solar Cell Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11223344B2\",\n    \"priority_date\": \"2019-03-10\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2021-07-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A highly efficient solar cell based on perovskite materials with improved light absorption.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Perovskite Solar Cell Materials\"\n        },\n        {\n            \"patent_number\": \"US8899001B1\",\n            \"title\": \"Light Trapping in Solar Cells\"\n        }\n    ],\n    \"claims\": [\n        \"A solar cell comprising...\",\n        \"The solar cell of claim 1, wherein the perovskite material is...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69361", "text": "{\n    \"patent_title\": \"Novel Framework for Reinforcement Learning with Theoretical Guarantees\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2022-07-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel framework for reinforcement learning algorithms with provable convergence guarantees. It addresses limitations in existing methods by incorporating advanced mathematical techniques from control theory and optimization. The core contribution lies in providing a theoretical foundation for designing more robust and efficient AI agents.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"kind\": \"Non-Patent Literature\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reinforcement learning comprising...\",\n        \"An apparatus for implementing said method...\",\n        \"A computer program product...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69361", "text": "{\n    \"patent_title\": \"AI-Powered Image Recognition System for Medical Diagnosis\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2018-05-10\",\n    \"filing_date\": \"2018-05-10\",\n    \"issue_date\": \"2021-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An artificial intelligence system for analyzing medical images to detect anomalies. The system employs deep convolutional neural networks trained on a large dataset of labeled images, achieving high accuracy in identifying cancerous tissues. The invention revolutionizes medical diagnosis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"Patent\"\n        },\n        {\n            \"patent_number\": \"US20170253892A1\",\n            \"kind\": \"Patent Application\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for detecting anomalies in images...\",\n        \"A computer-readable medium...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69362", "text": "{\n    \"patent_title\": \"System and method for enhanced wireless communication using beamforming\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing wireless communication by utilizing beamforming techniques to focus radio frequency energy towards a specific receiver, improving signal strength and reducing interference. The invention applies to various wireless communication standards including 5G and beyond.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Prior art wireless communication system\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for wireless communication...\",\n        \"2. A system comprising...\",\n        \"3. The method of claim 1, wherein...\",\n        \"4. The system of claim 2, further comprising...\",\n        \"5. A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69362", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-12-01\",\n    \"filing_date\": \"2009-12-01\",\n    \"issue_date\": \"2018-04-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system for electric vehicles, improving charge/discharge efficiency and lifespan of batteries.\",\n    \"citations\": [],\n    \"claims\": [\n        \"1. A battery management system...\",\n        \"2. The system of claim 1, comprising...\",\n        \"3. A method for managing a battery...\",\n        \"4. The method of claim 3, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69363", "text": "{\n    \"patent_title\": \"High-Efficiency Perovskite Solar Cells with Improved Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"National Renewable Energy Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-06-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to perovskite solar cells with enhanced efficiency and stability achieved through a novel composition and fabrication process. The solar cell demonstrates a power conversion efficiency of over 22% and maintains 90% of its initial performance after 500 hours of continuous operation. The abstract contains the term 'solar cell'.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A perovskite solar cell comprising...\",\n        \"A method for fabricating a perovskite solar cell...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69363", "text": "{\n    \"patent_title\": \"Novel Wind Turbine Blade Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-14\",\n    \"issue_date\": \"2020-03-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved wind turbine blade design aimed at increasing energy capture efficiency. The blade features a unique airfoil shape and a novel control system. It doesn't include 'solar cell'.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A wind turbine blade having...\",\n        \"A control system for a wind turbine...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69364", "text": "{\n    \"patent_title\": \"Artificial Intelligence Driven Predictive Maintenance System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2013-02-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system for predictive maintenance using artificial intelligence and machine learning algorithms to analyze sensor data and predict equipment failures. The system improves efficiency and reduces downtime in industrial settings.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Predictive Maintenance System\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predicting equipment failure comprising...\",\n        \"A method for analyzing sensor data using machine learning...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69364", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Smith\",\n            \"affiliation\": \"Energy Solutions Ltd.\"\n        },\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2009-12-10\",\n    \"filing_date\": \"2009-12-10\",\n    \"issue_date\": \"2012-05-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a novel battery design utilizing advanced materials to increase energy density and lifespan for electric vehicle applications. The design improves performance and safety in extreme temperatures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8234567B2\",\n            \"title\": \"Lithium-Ion Battery Technology\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising...\",\n        \"A method for manufacturing a high-density battery...\",\n        \"A system for controlling battery temperature...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69365", "text": "{\n    \"patent_title\": \"Method and system for enhanced image processing using deep learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing image quality using deep convolutional neural networks. The system includes a training module and an inference module for real-time image processing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Prior Art Image Processing Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image comprising...\",\n        \"A system for processing images comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69365", "text": "{\n    \"patent_title\": \"Apparatus for fluid dynamics control\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Caltech\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An apparatus for controlling fluid dynamics using a novel nozzle design. The invention improves efficiency in fluid delivery systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Prior Fluid Control Device\"\n        }\n    ],\n    \"claims\": [\n        \"An apparatus for fluid control comprising...\",\n        \"A nozzle assembly for directing fluid...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69366", "text": "{\n    \"patent_title\": \"Wireless Sensor Network for Structural Health Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless sensor network for monitoring the structural integrity of bridges and buildings. The system utilizes low-power sensors to detect strain, vibration, and temperature changes, providing real-time data for preventative maintenance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8543210B2\",\n            \"title\": \"Energy Harvesting for Wireless Sensors\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor network comprising...\",\n        \"A method for detecting structural defects...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69366", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-10-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor for continuous monitoring of blood sugar levels in diabetic patients. The sensor transmits data wirelessly to a mobile device for real-time tracking and analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Miniaturized Implantable Medical Devices\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Wireless Communication for Medical Implants\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable glucose sensor comprising...\",\n        \"A method for wirelessly transmitting glucose data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69367", "text": "{\n    \"patent_title\": \"Lithium-Ion Conductive Ceramic Membranes for Hydrogen Separation\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-10\",\n    \"filing_date\": \"2011-05-09\",\n    \"issue_date\": \"2019-07-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion conductive ceramic membrane for highly selective hydrogen separation is described. The membrane exhibits high hydrogen permeability and excellent mechanical stability. This technology can be applied in various industrial processes requiring efficient hydrogen purification.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Hydrogen Purification Method\"\n        },\n        {\n            \"patent_number\": \"US8987654B2\",\n            \"title\": \"Ceramic Membrane Fabrication\"\n        }\n    ],\n    \"claims\": [\n        \"A ceramic membrane comprising...\",\n        \"A method for separating hydrogen using the ceramic membrane...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69367", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Performance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Wilson\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2012-03-15\",\n    \"filing_date\": \"2012-03-14\",\n    \"issue_date\": \"2020-01-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery with enhanced energy density and cycle life is presented. The battery incorporates a novel electrolyte and electrode materials to achieve improved performance characteristics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Lithium-Ion Battery Electrolyte Composition\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Battery Management System\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69368", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2018-05-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system is described. The system utilizes a MEMS pressure sensor integrated with a low-power wireless transceiver for remote monitoring applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in wireless sensing\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for remotely monitoring pressure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69368", "text": "{\n    \"patent_title\": \"Improved Battery Life for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10246813B1\",\n    \"priority_date\": \"2017-09-01\",\n    \"filing_date\": \"2017-08-31\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel power management technique to extend the battery life of mobile devices.  It focuses on optimizing processor usage and reducing background activity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related to power efficiency\"\n        }\n    ],\n    \"claims\": [\n        \"A mobile device with an extended battery life...\",\n        \"A method for optimizing power consumption...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69369", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method and system for enhancing the quality of reconstructed images using advanced image processing techniques. The system employs a deep learning algorithm to reduce noise and improve resolution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image reconstruction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image reconstruction comprising...\",\n        \"A system for processing images...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69369", "text": "{\n    \"patent_title\": \"Image Processing System for Medical Diagnostics\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Stanford Hospital\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2021-07-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image processing tailored to medical diagnostic applications. The system utilizes machine learning algorithms to detect anomalies in medical images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"Related art in medical imaging\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting anomalies in medical images...\",\n        \"A system for displaying medical images...\",\n        \"A computer program for analyzing medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69370", "text": "{\n    \"patent_title\": \"Method for Enhanced Oil Recovery Using Nanoparticles\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of Texas\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Chevron Corporation\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for enhancing oil recovery utilizing nanoparticles to alter the wettability of reservoir rock and increase oil displacement efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"kind\": \"cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing oil recovery comprising...\",\n        \"The method of claim 1 wherein the nanoparticles...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69370", "text": "{\n    \"patent_title\": \"System and Method for Automated Image Recognition Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10456789B1\",\n    \"priority_date\": \"2017-05-01\",\n    \"filing_date\": \"2017-05-01\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for automated image recognition using deep learning techniques, including convolutional neural networks.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"kind\": \"cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"The system of claim 1 wherein the deep learning model...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69371", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition Using Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2019-03-15\",\n    \"issue_date\": \"2021-06-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for improved image recognition accuracy using deep neural networks. The system employs a novel architecture and training algorithm to achieve state-of-the-art performance in object detection and image classification.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a neural network...\",\n        \"The system of claim 1, wherein...\",\n        \"The method of claim 2, further comprising...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The system of claim 3, including a user interface...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69371", "text": "{\n    \"patent_title\": \"Improved Image Processing Techniques\",\n    \"inventors\": [\n        {\n            \"name\": \"David Smith\",\n            \"affiliation\": \"Global Tech Solutions\"\n        },\n        {\n            \"name\": \"Emily Brown\",\n            \"affiliation\": \"Research Labs Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-20\",\n    \"filing_date\": \"2018-11-20\",\n    \"issue_date\": \"2020-04-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to novel image processing techniques for enhancing image quality and reducing noise. It covers algorithms for filtering, sharpening, and color correction.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image processing comprising...\",\n        \"A system for enhancing image quality...\",\n        \"The method of claim 1, further comprising...\",\n        \"The system of claim 2, including a display...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69372", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system is disclosed. The system comprises a pressure sensor, a wireless transmitter, and a power source. The sensor transmits pressure data wirelessly to a remote receiver.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"The system of claim 1, wherein the wireless transmitter...\",\n        \"The system of claim 2, wherein the power source is a battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69372", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Robert Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-12-20\",\n    \"filing_date\": \"2009-12-20\",\n    \"issue_date\": \"2018-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system is described. This system optimizes battery charging and discharging to extend battery life and improve performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"The system of claim 1, further comprising...\",\n        \"The system of claim 2, wherein the battery is a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69373", "text": "{\n    \"patent_title\": \"High-Performance Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Michael McAkley\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-06-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel electrode materials for lithium-ion batteries exhibiting enhanced energy density and cycle life. The materials incorporate a unique nano-structured composite design.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Lithium-Ion Battery Separators\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrode material comprising...\",\n        \"A method for manufacturing a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69373", "text": "{\n    \"patent_title\": \"Battery Management System with Adaptive Control\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-02-28\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a battery management system (BMS) for lithium-ion batteries featuring adaptive control algorithms to optimize performance and safety. The BMS utilizes advanced monitoring and control techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"High-Performance Lithium-Ion Battery Electrode Materials\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Lithium-Ion Battery Separators\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69374", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for enhanced image recognition utilizing deep learning techniques. The system processes images to identify objects and patterns with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8766814B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for identifying objects in an image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69374", "text": "{\n    \"patent_title\": \"Improved Method for Facial Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Facebook AI\"\n        }\n    ],\n    \"patent_number\": \"US91234567B1\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2018-11-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for improving facial recognition accuracy using novel algorithms.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for facial recognition comprising...\",\n        \"A system for identifying faces in images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69375", "text": "{\n    \"patent_title\": \"High-Capacity Optical Fiber Communication System with Signal Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"US Patent and Trademark Office\",\n    \"abstract\": \"A high-capacity optical fiber communication system designed to enhance signal integrity and reduce signal loss over long distances. This system utilizes advanced modulation techniques and error correction codes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Optical Signal Processing Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for transmitting optical signals...\",\n        \"An optical fiber communication system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69375", "text": "{\n    \"patent_title\": \"Wireless Communication System for IoT Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11345678B2\",\n    \"priority_date\": \"2019-11-20\",\n    \"filing_date\": \"2019-11-20\",\n    \"issue_date\": \"2021-07-01\",\n    \"patent_office\": \"US Patent and Trademark Office\",\n    \"abstract\": \"A low-power wireless communication system designed for Internet of Things (IoT) devices. It features a novel antenna design and efficient data transmission protocols.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10456789B1\",\n            \"title\": \"Low-Power Wireless Protocols\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication device...\",\n        \"A method for transmitting data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69376", "text": "{\n    \"patent_title\": \"System and method for AI-powered image recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for image recognition using artificial intelligence, specifically convolutional neural networks. The system improves accuracy and efficiency in object detection tasks.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for object detection using a neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69376", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a battery management system for electric vehicles, improving charge efficiency and lifespan. It incorporates advanced algorithms for thermal regulation and state-of-charge estimation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for regulating battery temperature...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69377", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition Using Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-05-15\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for enhancing image recognition accuracy using deep neural networks. The system utilizes a novel architecture for feature extraction and classification, resulting in improved performance on challenging image datasets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for enhancing image recognition accuracy...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69377", "text": "{\n    \"patent_title\": \"Method for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2018-11-20\",\n    \"filing_date\": \"2018-11-20\",\n    \"issue_date\": \"2021-01-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for compressing data, reducing storage requirements and transmission bandwidth.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for data compression comprising...\",\n        \"A system for encoding and decoding data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69378", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Improved Electrolyte\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-03-15\",\n    \"filing_date\": \"2015-05-20\",\n    \"issue_date\": \"2017-11-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery incorporating a novel electrolyte composition for enhanced safety and performance. The electrolyte comprises a blend of lithium salts and organic solvents, resulting in improved ionic conductivity and reduced flammability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Lithium-Ion Battery Separator\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69378", "text": "{\n    \"patent_title\": \"Novel Fuel Cell Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"EP1234567A1\",\n    \"priority_date\": \"2014-11-01\",\n    \"filing_date\": \"2016-02-10\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"A new fuel cell design utilizing proton exchange membranes for efficient energy conversion. The design incorporates a novel flow field configuration to enhance gas distribution and reduce polarization losses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Fuel Cell Stack Assembly\"\n        }\n    ],\n    \"claims\": [\n        \"A fuel cell comprising...\",\n        \"A flow field configuration for a fuel cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69379", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2020-06-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for enhanced image recognition utilizing deep learning techniques. The system employs convolutional neural networks to accurately identify objects within images, improving upon existing state-of-the-art image recognition systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9786842B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for identifying objects in an image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69379", "text": "{\n    \"patent_title\": \"Method for Data Compression in Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2019-01-10\",\n    \"filing_date\": \"2019-01-10\",\n    \"issue_date\": \"2021-11-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel method for compressing data transmitted in wireless communication systems, reducing bandwidth requirements and improving transmission efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising...\",\n        \"A system for wireless data transmission...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69380", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9784567B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-06-15\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a miniaturized wireless pressure sensor system for remote monitoring applications. The system utilizes a MEMS pressure sensor, a low-power wireless transceiver, and a battery for operation. The sensor data is transmitted wirelessly to a central processing unit for analysis and display. The system is designed for use in harsh environments.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"title\": \"Wireless Sensor Network\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"The system of claim 1, wherein the sensor is a MEMS sensor.\",\n        \"The system of claim 1, further comprising a battery.\",\n        \"The system of claim 1, wherein the wireless transceiver operates in the 2.4 GHz band.\",\n        \"The system of claim 1, wherein the sensor data is transmitted in a packetized format.\",\n        \"The system of claim 1, wherein the system is for remote monitoring applications.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69380", "text": "{\n    \"patent_title\": \"Improved Battery Life for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10456789B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-12-01\",\n    \"issue_date\": \"2020-07-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to techniques for extending the battery life of mobile devices, such as smartphones and tablets. The invention includes a power management system that dynamically adjusts the operating frequency of the processor based on the workload.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Dynamic Frequency Scaling\"\n        }\n    ],\n    \"claims\": [\n        \"A mobile device comprising...\",\n        \"The device of claim 1, wherein the processor is a multi-core processor.\",\n        \"The device of claim 1, further comprising a touch screen display.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69381", "text": "{\n    \"patent_title\": \"Wireless Communication System with Improved Signal Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2018-03-01\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a wireless communication system incorporating novel signal processing techniques for improved data transmission and reduced interference. The system utilizes adaptive filtering and coding schemes to enhance the reliability and efficiency of wireless communication.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543\",\n            \"relevance\": \"Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication system comprising...\",\n        \"A method for signal processing in a wireless network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69381", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2018-02-15\",\n    \"issue_date\": \"2021-01-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel battery technology utilizing advanced materials to increase energy density and lifespan in mobile devices. The battery design allows for faster charging and improved thermal stability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US12345678\",\n            \"relevance\": \"Related Art\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising...\",\n        \"A mobile device incorporating the battery cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69382", "text": "{\n    \"patent_title\": \"Method and System for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for image recognition utilizing artificial intelligence and deep learning algorithms. The system improves accuracy and speed in identifying objects within images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69382", "text": "{\n    \"patent_title\": \"Novel Chemical Compound for Drug Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"California Institute of Technology (Caltech)\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel chemical compound designed for targeted drug delivery systems. It enhances the bioavailability of therapeutic agents and minimizes side effects.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10111213B2\",\n            \"relevance\": \"Related Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A chemical compound having the formula...\",\n        \"A method for drug delivery comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69383", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery with Enhanced Thermal Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2022-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2023-11-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a lithium-ion battery with an improved electrolyte and separator, resulting in enhanced thermal stability and safety. The new design also increases energy density.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on lithium-ion battery separators\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"The battery of claim 1, wherein...\",\n        \"An electrolyte composition for use in...\",\n        \"A method of manufacturing a lithium-ion battery...\",\n        \"The method of claim 4, further comprising...\",\n        \"A system including a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69383", "text": "{\n    \"patent_title\": \"Novel Electrode Material for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2021-11-10\",\n    \"filing_date\": \"2020-04-15\",\n    \"issue_date\": \"2023-09-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a new electrode material for lithium-ion batteries, enhancing their charging capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related work on electrode materials\"\n        }\n    ],\n    \"claims\": [\n        \"An electrode material comprising...\",\n        \"The material of claim 1, wherein...\",\n        \"A lithium-ion battery including the electrode material...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69384", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition using Deep Convolutional Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for enhancing image recognition accuracy using deep convolutional neural networks. The system includes a training module, a feature extraction module, and a classification module. It achieves state-of-the-art results on benchmark image recognition datasets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760702B2\",\n            \"relevance\": \"Prior art in convolutional neural networks\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The method of claim 1, wherein...\",\n        \"The system of claim 2, wherein...\",\n        \"The computer-readable medium of claim 3, wherein...\",\n        \"Claim 7 further comprising...\",\n        \"Claim 8 further comprising...\",\n        \"Claim 9 further comprising...\",\n        \"Claim 10 further comprising...\",\n        \"Claim 11 further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69384", "text": "{\n    \"patent_title\": \"Method for Automated Plant Species Identification\",\n    \"inventors\": [\n        {\n            \"name\": \"David Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9542187B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-14\",\n    \"issue_date\": \"2019-06-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for identifying plant species based on image analysis of leaf characteristics. The system utilizes machine learning algorithms to classify different plant types.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8994935B2\",\n            \"relevance\": \"Prior art in plant identification systems\"\n        }\n    ],\n    \"claims\": [\n        \"A method for plant species identification comprising...\",\n        \"A system for plant species identification comprising...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69385", "text": "{\n    \"patent_title\": \"Neural Network Based Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2020-06-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A neural network based system for image recognition is described. The system utilizes convolutional neural networks to identify objects within images with high accuracy. Applications include autonomous vehicles and medical image analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9897564B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising a convolutional neural network.\",\n        \"The system of claim 1, wherein the convolutional neural network is trained on a large dataset of images.\",\n        \"The system of claim 2, wherein the dataset comprises at least 1 million images.\",\n        \"A method for identifying objects in an image using the system of claim 1.\",\n        \"The method of claim 4, further comprising displaying the identified objects.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69385", "text": "{\n    \"patent_title\": \"Method for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-05-10\",\n    \"issue_date\": \"2021-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a novel method for lossless data compression, utilizing a combination of Huffman coding and Lempel-Ziv algorithms.  It provides efficient storage of digital information.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data comprising...\",\n        \"The method of claim 1, wherein the Huffman coding is adaptive.\",\n        \"A system for implementing the method of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69386", "text": "{\n    \"patent_title\": \"System and method for image recognition using deep convolutional neural networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for image recognition using deep convolutional neural networks. The system is capable of accurately identifying objects in images, even in challenging conditions. The invention employs a novel training algorithm that significantly improves the accuracy of the image recognition process.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for image recognition comprising...\",\n        \"2. The system of claim 1, wherein...\",\n        \"3. A method for image recognition comprising...\",\n        \"4. The method of claim 3, wherein...\",\n        \"5. The system of claim 1, further comprising...\",\n        \"6. The method of claim 3, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69386", "text": "{\n    \"patent_title\": \"Method for improved data compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876544B2\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2019-02-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a method for improved data compression utilizing Huffman coding and run-length encoding. It allows for efficient storage and transmission of digital information.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"kind\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for data compression comprising...\",\n        \"2. The method of claim 1, wherein...\",\n        \"3. A system for data compression comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69387", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for enhancing image recognition accuracy using deep convolutional neural networks. The system utilizes a novel architecture that improves feature extraction and classification performance. It has applications in areas such as autonomous vehicles, medical imaging, and security systems. The core of the invention lies in its ability to accurately identify objects within images, even under varying conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for enhancing image recognition accuracy...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69387", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10293847B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel data compression algorithm that achieves higher compression ratios with reduced computational complexity. It utilizes a combination of entropy coding and transform coding techniques. Applications include storage and transmission of digital data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing digital data...\",\n        \"A system for achieving high compression ratios...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69388", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery Electrode Material and Method of Manufacture\",\n    \"inventors\": [\n        {\n            \"name\": \"Gerbrand Ceder\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Yet-Ming Chiang\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876345B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2017-05-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery electrode material comprising a composite of lithium metal oxide and a carbonaceous material, offering improved cycle life and rate capability. The method of manufacture involves a solid-state reaction process.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123789B2\",\n            \"relevance\": \"Similar electrode material\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrode comprising...\",\n        \"A method for manufacturing a lithium-ion battery electrode...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69388", "text": "{\n    \"patent_title\": \"Improved Nickel-Metal Hydride Battery Design\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US7654321B2\",\n    \"priority_date\": \"2008-03-10\",\n    \"filing_date\": \"2008-03-10\",\n    \"issue_date\": \"2009-11-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new design for nickel-metal hydride batteries, improving energy density and reducing self-discharge rate. The design incorporates a novel electrolyte composition.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"relevance\": \"Prior art in nickel-metal hydride battery technology\"\n        }\n    ],\n    \"claims\": [\n        \"A nickel-metal hydride battery comprising...\",\n        \"A method for assembling a nickel-metal hydride battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69389", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Wireless Communication Security\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system and method for enhancing security in wireless communication networks. It utilizes advanced encryption techniques to protect data transmitted over wireless channels.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in wireless security\"\n        }\n    ],\n    \"claims\": [\n        \"A method for encrypting data for wireless transmission.\",\n        \"A system for secure wireless communication.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69389", "text": "{\n    \"patent_title\": \"Improved Antenna Design for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Georgia Tech\"\n        },\n        {\n            \"name\": \"Eve Evans\",\n            \"affiliation\": \"Purdue University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved antenna design for mobile devices, resulting in increased signal strength and reduced interference. The design incorporates novel materials and geometric configurations.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related to antenna technology\"\n        }\n    ],\n    \"claims\": [\n        \"An antenna design for mobile devices with enhanced signal strength.\",\n        \"A method for manufacturing the antenna design.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69390", "text": "{\n    \"patent_title\": \"Wireless Sensor Network for Structural Health Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless sensor network for monitoring the structural health of bridges and buildings. The system utilizes low-power sensors to detect strain, temperature, and vibration, providing real-time data for analysis and predictive maintenance. This system utilizes a novel data compression algorithm and energy harvesting techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A system for structural health monitoring comprising...\",\n        \"A sensor network node comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69390", "text": "{\n    \"patent_title\": \"Implantable Medical Sensor for Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2010-05-20\",\n    \"filing_date\": \"2010-05-20\",\n    \"issue_date\": \"2017-04-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable medical sensor for continuous glucose monitoring in diabetic patients. The sensor utilizes enzymatic reactions to detect glucose levels and transmits data wirelessly to an external receiver. This device is designed for long-term implantation and provides real-time glucose data for improved medical management. It requires specialized biocompatible materials and rigorous testing for medical use.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable glucose sensor comprising...\",\n        \"A method for continuous glucose monitoring comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69391", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel electrode materials for lithium-ion batteries, exhibiting enhanced energy density and cycle life. The materials incorporate a unique nanostructure that improves ion transport and reduces degradation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrode comprising...\",\n        \"A method for manufacturing the electrode...\",\n        \"The electrode of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69391", "text": "{\n    \"patent_title\": \"Novel Polymer Electrolytes for Sodium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of Texas at Austin\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2010-12-01\",\n    \"filing_date\": \"2010-12-01\",\n    \"issue_date\": \"2018-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new class of polymer electrolytes for sodium-ion batteries, offering improved ionic conductivity and thermal stability. These electrolytes overcome limitations in existing sodium-ion battery technologies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A polymer electrolyte for sodium-ion batteries...\",\n        \"A sodium-ion battery comprising the polymer electrolyte...\",\n        \"A method for preparing the polymer electrolyte...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69392", "text": "{\n    \"patent_title\": \"System and method for personalized recommendations using machine learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Sergey Brin\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Larry Page\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for providing personalized recommendations to users based on their past behavior and preferences, utilizing machine learning algorithms to predict future interests.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8769021B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for providing personalized recommendations comprising...\",\n        \"A method for predicting user preferences...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69392", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Elon Musk\",\n            \"affiliation\": \"Tesla, Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10456789B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-02-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery cell design and manufacturing process resulting in increased energy density and lifespan for electric vehicle applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9546321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising...\",\n        \"A method for manufacturing a battery cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69393", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Intel Corporation\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-15\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a miniature wireless pressure sensor system for remote monitoring applications. The system incorporates a MEMS pressure sensor and a low-power wireless transmitter.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"The system of claim 1, wherein the sensor is a MEMS sensor.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69393", "text": "{\n    \"patent_title\": \"Advanced Image Processing Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-12-10\",\n    \"filing_date\": \"2009-12-10\",\n    \"issue_date\": \"2018-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image processing algorithm for enhancing the quality of digital images. The algorithm utilizes advanced filtering techniques to reduce noise and improve clarity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"kind\": \"Cited by applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing digital images...\",\n        \"The method of claim 1, further comprising...\",\n        \"The method of claim 2, wherein the filtering technique is...\",\n        \"The method of claim 3, wherein the filtering technique is a Gaussian filter...\",\n        \"The method of claim 4, wherein the filtering technique is a median filter...\",\n        \"The method of claim 5, wherein the filtering technique is a bilateral filter...\",\n        \"The method of claim 6, wherein the filtering technique is a non-local means filter...\",\n        \"The method of claim 7, wherein the filtering technique is a wavelet filter...\",\n        \"The method of claim 8, wherein the filtering technique is a total variation filter...\",\n        \"The method of claim 9, wherein the filtering technique is a deep learning based filter...\",\n        \"The method of claim 10, wherein the filtering technique is a convolutional neural network based filter...\",\n        \"The method of claim 11, wherein the filtering technique is a recurrent neural network based filter...\",\n        \"The method of claim 12, wherein the filtering technique is a generative adversarial network based filter...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69394", "text": "{\n    \"patent_title\": \"Improved Electrolyte for Lithium-Ion Batteries with Enhanced Thermal Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-09-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel electrolyte composition for lithium-ion batteries that exhibits significantly improved thermal stability and ionic conductivity, leading to enhanced battery performance and safety. The electrolyte contains a blend of organic carbonates and a lithium salt with a unique additive.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related art in electrolyte composition but not focused on thermal stability.\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrolyte comprising...\",\n        \"The electrolyte of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69394", "text": "{\n    \"patent_title\": \"Battery Management System with Advanced Cell Balancing\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Texas Instruments\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-11-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) that utilizes advanced cell balancing techniques to improve the performance and lifespan of lithium-ion battery packs. The system includes a microcontroller, cell voltage sensors, and current sensors.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"relevance\": \"Prior art related to cell balancing in BMS.\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"The battery management system of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69395", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Langer\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Daniel Anderson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized, implantable biosensor is disclosed for continuous glucose monitoring. The device comprises a biocompatible housing, a glucose oxidase enzyme, and a microelectrode array for detecting glucose levels in interstitial fluid. The sensor is designed for long-term implantation and provides real-time glucose data via a wireless communication link.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"kind\": \"Cited by Examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A biosensor comprising...\",\n        \"A method for continuously monitoring glucose levels...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69395", "text": "{\n    \"patent_title\": \"Surgical Instrument with Enhanced Ergonomics\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Boston University\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A surgical instrument is described, featuring an improved ergonomic handle design for enhanced user comfort and precision. The instrument utilizes a novel locking mechanism to maintain the desired clamping force during surgical procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"kind\": \"Cited by Applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising...\",\n        \"A handle assembly with ergonomic features...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69396", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode and Manufacturing Method\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Tesla, Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-12-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved lithium-ion battery electrode material and a method for its manufacture. The new material exhibits enhanced energy density and cycle life, addressing key limitations in current lithium-ion battery technology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"kind\": \"Cited by Examiner\"\n        }\n    ],\n    \"claims\": [\n        \"1. A lithium-ion battery electrode comprising...\",\n        \"2. The electrode of claim 1, wherein...\",\n        \"3. A method for manufacturing a lithium-ion battery electrode...\",\n        \"4. The method of claim 3, comprising...\",\n        \"5. A lithium-ion battery cell comprising the electrode of claim 1.\",\n        \"6. The battery cell of claim 5, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69396", "text": "{\n    \"patent_title\": \"Novel Polymer Coating for Corrosion Protection\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-06-15\",\n    \"issue_date\": \"2022-09-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new polymer coating that provides superior corrosion protection for metal surfaces. The coating is durable, environmentally friendly, and cost-effective.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"kind\": \"Cited by Applicant\"\n        }\n    ],\n    \"claims\": [\n        \"1. A coating composition comprising...\",\n        \"2. The composition of claim 1, wherein...\",\n        \"3. A metal article coated with the composition of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69397", "text": "{\n    \"patent_title\": \"Deep Learning System for Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-14\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep learning system utilizing convolutional neural networks for high-accuracy image recognition. The system employs multiple layers of neurons to extract features and classify images with improved performance compared to traditional methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising a convolutional neural network.\",\n        \"The system of claim 1, wherein the neural network comprises at least three layers.\",\n        \"A method for training a neural network for image recognition.\",\n        \"The method of claim 3, wherein the training data comprises labeled images.\",\n        \"A computer-readable medium storing instructions for implementing the system of claim 1.\",\n        \"The system of claim 1, further comprising a preprocessing module.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69397", "text": "{\n    \"patent_title\": \"Method for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2010-12-01\",\n    \"filing_date\": \"2010-11-30\",\n    \"issue_date\": \"2018-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for compressing data using Huffman coding. This invention provides an efficient way to reduce the size of digital files.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression using Huffman coding.\",\n        \"The method of claim 1, wherein the data is digital.\",\n        \"A computer-readable medium storing instructions for implementing the method of claim 1.\",\n        \"The method of claim 1, further comprising an entropy encoding step.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69398", "text": "{\n    \"patent_title\": \"Neural Network Architecture for Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11123456B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2021-03-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel neural network architecture is presented for improved image recognition accuracy. This invention utilizes a convolutional neural network with attention mechanisms to achieve state-of-the-art results on benchmark datasets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A neural network architecture comprising...\",\n        \"A method for image recognition using said neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69398", "text": "{\n    \"patent_title\": \"Improved Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2021-11-01\",\n    \"filing_date\": \"2022-01-10\",\n    \"issue_date\": \"2022-12-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel data compression algorithm that provides higher compression ratios with minimal loss of information. It employs a combination of Huffman coding and Lempel-Ziv variants.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A data compression method comprising...\",\n        \"A system for implementing said data compression method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69399", "text": "{\n    \"patent_title\": \"System and method for dynamic spectrum allocation\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-03-15\",\n    \"filing_date\": \"2014-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for dynamically allocating spectrum resources in a wireless communication network.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        },\n        {\n            \"patent_number\": \"US7654321B1\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\"\n        },\n        {\n            \"patent_number\": \"US9234567B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for dynamic spectrum allocation...\",\n        \"A system comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69399", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system with improved charging and discharging capabilities.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system...\",\n        \"A method for controlling...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69400", "text": "{\n    \"patent_title\": \"Method and System for Automated Data Analysis Using Artificial Intelligence\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for automated data analysis using artificial intelligence techniques, including machine learning and natural language processing, to identify patterns and insights in large datasets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Data Mining Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for automated data analysis comprising...\",\n        \"A system for implementing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69400", "text": "{\n    \"patent_title\": \"Smart Insulin Pump with AI-Powered Dosage Control\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Williams\",\n            \"affiliation\": \"MedTech Solutions\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An intelligent insulin pump using artificial intelligence to dynamically adjust insulin dosage based on patient glucose levels. This device improves glucose control and reduces the risk of hypoglycemia.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Implantable Glucose Sensors\"\n        },\n        {\n            \"patent_number\": \"US8543210B1\",\n            \"title\": \"Closed-Loop Insulin Delivery Systems\"\n        }\n    ],\n    \"claims\": [\n        \"An insulin pump comprising an AI module for dosage control...\",\n        \"A method for controlling insulin delivery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69401", "text": "{\n    \"patent_title\": \"Method and System for Image Recognition Using Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-10\",\n    \"filing_date\": \"2011-05-09\",\n    \"issue_date\": \"2019-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for image recognition using deep neural networks. The system utilizes convolutional neural networks to analyze images and identify objects with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69401", "text": "{\n    \"patent_title\": \"Improved Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"IBM\"\n        },\n        {\n            \"name\": \"Eve Green\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2012-03-15\",\n    \"filing_date\": \"2012-03-14\",\n    \"issue_date\": \"2018-11-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved data compression algorithm that achieves higher compression ratios than existing methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising...\",\n        \"A system for data compression comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69402", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876345B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition utilizing deep convolutional neural networks. The system is configured to analyze images and identify objects with high accuracy, leveraging transfer learning techniques and a large labeled dataset. The method allows for efficient training and deployment of the image recognition model, with applications in various fields.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760789B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69402", "text": "{\n    \"patent_title\": \"Method for Automated Object Detection in Video Streams\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-14\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for real-time object detection in video streams using a combination of background subtraction and feature matching. The method is optimized for computational efficiency and can be implemented on embedded systems. Applicable to surveillance and autonomous vehicle applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for object detection in video comprising...\",\n        \"A system for real-time object detection...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69403", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-14\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system is disclosed. The system comprises a pressure sensor, a signal processing unit, and a wireless communication module. The sensor is designed for biomedical applications and is capable of providing real-time pressure measurements.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A pressure sensor system comprising...\",\n        \"The system of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69403", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-12-01\",\n    \"filing_date\": \"2009-12-01\",\n    \"issue_date\": \"2018-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel battery design using advanced materials. The battery offers improved energy density and lifespan compared to existing technologies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\"\n        }\n    ],\n    \"claims\": [\n        \"A battery comprising...\",\n        \"The battery of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69404", "text": "{\n    \"patent_title\": \"Deep Learning for Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2017-05-15\",\n    \"issue_date\": \"2019-02-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A deep learning system for image recognition utilizing convolutional neural networks and backpropagation. The system is trained on a large dataset of labeled images and achieves state-of-the-art accuracy. Machine learning techniques are core to this invention.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69404", "text": "{\n    \"patent_title\": \"Improved Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2016-03-10\",\n    \"filing_date\": \"2016-03-10\",\n    \"issue_date\": \"2018-09-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel data compression algorithm that utilizes Huffman coding and Lempel-Ziv techniques. The algorithm achieves significant compression ratios for various data types.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising...\",\n        \"A system for data compression...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69405", "text": "{\n    \"patent_title\": \"Method and System for Neural Network Based Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11123456B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-12-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for image recognition using a novel neural network architecture. The system utilizes convolutional neural networks to achieve high accuracy in identifying objects within images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image processing using a neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69405", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2021-02-10\",\n    \"issue_date\": \"2022-08-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel data compression algorithm is presented, offering increased efficiency compared to existing methods.  This algorithm utilizes entropy encoding and statistical modeling.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising...\",\n        \"A system for encoding data using entropy principles...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69406", "text": "{\n    \"patent_title\": \"High-Performance Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"Novel electrode materials for lithium-ion batteries exhibiting improved energy density and cycle life. The materials are based on a modified nickel-manganese-cobalt oxide composition.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Improved Electrolytes for Lithium-Ion Batteries\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrode material comprising...\",\n        \"A method for fabricating a lithium-ion battery electrode...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69406", "text": "{\n    \"patent_title\": \"Battery Management System for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Texas Instruments\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2012-03-10\",\n    \"filing_date\": \"2012-03-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) designed to optimize the performance and lifespan of lithium-ion battery packs. The BMS includes algorithms for cell balancing, temperature monitoring, and fault detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Advanced Cell Balancing Techniques\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Thermal Management Strategies for Battery Packs\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling a lithium-ion battery pack...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69407", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-06-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system is disclosed. The system includes a MEMS pressure sensor, a low-power transceiver, and a microcontroller for data acquisition and transmission. The sensor is designed for biomedical applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"similar technology\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for measuring pressure using a wireless sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69407", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-14\",\n    \"issue_date\": \"2020-01-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery technology utilizing new electrolyte materials for increased energy density and lifespan is disclosed.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising...\",\n        \"A method for manufacturing a battery cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69408", "text": "{\n    \"patent_title\": \"Neural Network Architecture for Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2012-05-10\",\n    \"filing_date\": \"2015-03-15\",\n    \"issue_date\": \"2018-08-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel neural network architecture for improved image recognition. The network utilizes convolutional layers and recurrent connections to achieve state-of-the-art performance on benchmark datasets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Similar architecture\"\n        }\n    ],\n    \"claims\": [\n        \"A neural network comprising a convolutional layer.\",\n        \"A neural network comprising a recurrent layer.\",\n        \"A method for image recognition using the neural network.\",\n        \"A system for image processing utilizing the neural network.\",\n        \"The neural network according to claim 1, wherein the convolutional layer includes...\",\n        \"The method according to claim 3, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69408", "text": "{\n    \"patent_title\": \"Improved Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2009-11-01\",\n    \"filing_date\": \"2016-04-01\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new data compression algorithm based on Huffman coding. It improves compression ratios and processing speed.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related compression techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A data compression method comprising Huffman coding.\",\n        \"A system for compressing data using the method of claim 1.\",\n        \"The method according to claim 1, wherein the Huffman coding is adaptive.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69409", "text": "{\n    \"patent_title\": \"System and Method for Neural Network-Based Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for image recognition utilizing a deep convolutional neural network. The system efficiently processes image data to identify objects with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Processing System\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for processing image data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69409", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Microsoft Research\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"University of Washington\"\n        },\n        {\n            \"name\": \"Eve Franklin\",\n            \"affiliation\": \"Amazon\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-08-01\",\n    \"filing_date\": \"2017-08-01\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel data compression algorithm that achieves significantly higher compression ratios than existing methods. It utilizes a combination of Huffman coding and Lempel-Ziv techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Data Compression Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data comprising...\",\n        \"A system for decompressing data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69410", "text": "{\n    \"patent_title\": \"System and method for anomaly detection using machine learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-01-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for detecting anomalies in data streams using machine learning algorithms. The system learns normal patterns and identifies deviations from those patterns, signaling potential anomalies.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for anomaly detection comprising...\",\n        \"A system for anomaly detection comprising...\",\n        \"The method of claim 1, wherein...\",\n        \"The system of claim 2, wherein...\",\n        \"A computer-readable medium storing...\",\n        \"A computer program...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69410", "text": "{\n    \"patent_title\": \"Improved Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9123456B1\",\n    \"priority_date\": \"2013-11-20\",\n    \"filing_date\": \"2013-11-20\",\n    \"issue_date\": \"2017-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new data compression algorithm that achieves higher compression ratios than existing methods. It utilizes advanced coding techniques for efficient data storage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising...\",\n        \"A system for data compression comprising...\",\n        \"The method of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69411", "text": "{\n    \"patent_title\": \"System and Method for Image-Based Object Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for recognizing objects in images using convolutional neural networks. The system processes image data to identify and classify objects with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for image recognition comprising...\",\n        \"2. The method of claim 1, wherein...\",\n        \"3. A system for performing the method of claim 1...\",\n        \"4. The system of claim 3, further comprising...\",\n        \"5. A non-transitory computer-readable medium...\",\n        \"6. The medium of claim 5, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69411", "text": "{\n    \"patent_title\": \"Method for Automated Data Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-11-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for automated data analysis using statistical models. The method is applicable to various data types and provides insights into data patterns.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related Art\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for data analysis comprising...\",\n        \"2. The method of claim 1, wherein...\",\n        \"3. A system for performing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69412", "text": "{\n    \"patent_title\": \"Neural Network Architecture for Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-12-15\",\n    \"filing_date\": \"2010-03-01\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel neural network architecture for robust image recognition. The network utilizes convolutional layers and recurrent connections to achieve state-of-the-art accuracy on benchmark datasets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A neural network comprising a convolutional layer.\",\n        \"A neural network comprising a recurrent layer.\",\n        \"A method for image recognition using the neural network.\",\n        \"A system for image recognition using the neural network.\",\n        \"The neural network architecture as described in claim 1, further comprising a pooling layer.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69412", "text": "{\n    \"patent_title\": \"Improved Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2012-05-10\",\n    \"filing_date\": \"2011-11-15\",\n    \"issue_date\": \"2018-02-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel data compression algorithm that achieves higher compression ratios than existing methods. It utilizes a unique combination of Huffman coding and Lempel-Ziv algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\"\n        }\n    ],\n    \"claims\": [\n        \"A data compression algorithm comprising Huffman coding.\",\n        \"A data compression algorithm comprising Lempel-Ziv algorithms.\",\n        \"A method for compressing data using the algorithm.\",\n        \"A system for compressing data using the algorithm.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69413", "text": "{\n    \"patent_title\": \"Method and System for Neural Network Based Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for image recognition using a deep neural network. The system employs convolutional neural networks to accurately classify images with high precision.  It improves upon existing techniques by utilizing a novel activation function and training regime.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Prior Art Neural Network System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition using a neural network.\",\n        \"The method of claim 1, wherein the neural network is a convolutional neural network.\",\n        \"The method of claim 2, further comprising an activation function.\",\n        \"A system for performing image recognition.\",\n        \"The system of claim 4, including a processor and memory.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69413", "text": "{\n    \"patent_title\": \"Improved Battery Charging Circuit\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Motors\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved circuit for charging batteries more efficiently. The circuit utilizes a novel control scheme to minimize energy loss during the charging process and improve battery lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Existing Battery Charging Technology\"\n        }\n    ],\n    \"claims\": [\n        \"A circuit for charging batteries.\",\n        \"The circuit of claim 1, including a control mechanism.\",\n        \"The circuit of claim 2, wherein the control mechanism minimizes energy loss.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69414", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications. The sensor utilizes MEMS technology and transmits data wirelessly for remote monitoring. The device incorporates a low-power communication protocol and is designed for implantable applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising...\",\n        \"A method for remotely monitoring pressure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69414", "text": "{\n    \"patent_title\": \"Improved Chemical Sensor for Gas Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2010-12-01\",\n    \"filing_date\": \"2010-12-01\",\n    \"issue_date\": \"2018-04-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved chemical sensor for detecting various gases. The sensor utilizes a novel nanomaterial and provides high sensitivity and selectivity. It's designed for environmental monitoring and industrial safety applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A chemical sensor comprising...\",\n        \"A method for detecting gases...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69415", "text": "{\n    \"patent_title\": \"Advanced Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"Novel electrode materials for lithium-ion batteries with improved energy density and cycle life are disclosed. These materials utilize a unique nanostructure to enhance ion transport and reduce internal resistance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrode comprising a nanostructured material.\",\n        \"The electrode of claim 1, wherein the nanostructured material is composed of titanium dioxide.\",\n        \"A lithium-ion battery comprising the electrode of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69415", "text": "{\n    \"patent_title\": \"Battery Management System for Lithium-Ion Packs\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Texas Instruments\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Samsung SDI\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-14\",\n    \"issue_date\": \"2019-04-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) for lithium-ion battery packs is disclosed, providing precise cell voltage monitoring, temperature control, and charge balancing to optimize performance and safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for a lithium-ion battery pack, comprising a voltage monitoring circuit.\",\n        \"The system of claim 1, further comprising a temperature sensing circuit.\",\n        \"The system of claim 1, further comprising a charge balancing circuit.\",\n        \"The system of claim 1, wherein the lithium-ion battery pack comprises multiple cells connected in series.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69416", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Reconstruction\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and system for enhancing image reconstruction using advanced algorithms. The system utilizes a multi-stage processing pipeline to improve image quality and resolution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in image processing.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image reconstruction comprising...\",\n        \"A system for implementing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69416", "text": "{\n    \"patent_title\": \"Digital Image Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp.\"\n        }\n    ],\n    \"patent_number\": \"US10112233B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-14\",\n    \"issue_date\": \"2019-04-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A digital image compression technique based on wavelet transform and quantization. The method provides high compression ratios with minimal loss of image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"relevance\": \"Related to image compression.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing digital images comprising...\",\n        \"A system for implementing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69417", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to improved electrode materials for lithium-ion batteries, enhancing energy density and cycle life. The materials are fabricated using a novel nano-structuring technique.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode material...\",\n        \"The electrode material as claimed in claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69417", "text": "{\n    \"patent_title\": \"Novel Polymer Electrolyte for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Motors\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new polymer electrolyte is developed for use in lithium-ion batteries, offering improved safety and ionic conductivity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising a polymer electrolyte...\",\n        \"The polymer electrolyte as claimed in claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69418", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-03-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for image recognition utilizing artificial intelligence algorithms. The system employs convolutional neural networks for enhanced accuracy and speed.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for image classification...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69418", "text": "{\n    \"patent_title\": \"Improved Battery Life for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Apple Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2021-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method for improving battery life in mobile devices through optimized power management techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A mobile device with optimized power management...\",\n        \"A method for extending battery life...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69419", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"David A. Hodges\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jim R. Melcher\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system suitable for in-vivo biomedical measurements. The system comprises a pressure sensor, a wireless communication module, and a power management unit.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related sensor technology\"\n        },\n        {\n            \"patent_number\": \"US8987654B2\",\n            \"relevance\": \"Wireless communication protocols\"\n        },\n        {\n            \"patent_number\": \"US9210000B2\",\n            \"relevance\": \"Power management circuits\"\n        },\n        {\n            \"patent_number\": \"US9346000B2\",\n            \"relevance\": \"Miniaturization techniques\"\n        },\n        {\n            \"patent_number\": \"US9458000B2\",\n            \"relevance\": \"Biomedical applications\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"The system of claim 1, wherein...\",\n        \"A method for measuring pressure using...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69419", "text": "{\n    \"patent_title\": \"Advanced Image Processing Techniques\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-05-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"Novel image processing algorithms for enhancing image quality and extracting relevant features. Applications include medical imaging and computer vision.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"relevance\": \"Image enhancement algorithms\"\n        },\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"relevance\": \"Feature extraction methods\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image quality comprising...\",\n        \"The method of claim 1, wherein...\",\n        \"An apparatus for image processing...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69420", "text": "{\n    \"patent_title\": \"Method and System for Image Recognition Using Deep Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-02-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for image recognition utilizing deep neural networks. The system comprises a convolutional neural network architecture trained on a large dataset of labeled images to accurately classify objects within images. The system is designed for real-time applications, such as autonomous vehicles and medical imaging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Convolutional Neural Network Architecture\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for image recognition comprising...\",\n        \"2. The method of claim 1, wherein the neural network...\",\n        \"3. A system for image recognition...\",\n        \"4. The system of claim 3, wherein the convolutional layers...\",\n        \"5. The method of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69420", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Motors\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-15\",\n    \"issue_date\": \"2020-03-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles, focusing on enhanced thermal regulation and charge efficiency. The system uses advanced algorithms to predict battery degradation and optimize charging cycles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Battery Thermal Management Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"1. A battery management system comprising...\",\n        \"2. The system of claim 1, wherein the thermal regulation...\",\n        \"3. A method for optimizing battery charging...\",\n        \"4. The method of claim 3, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69421", "text": "{\n    \"patent_title\": \"System and Method for Federated Learning with Differential Privacy\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for performing federated learning with differential privacy to protect user data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\"\n        },\n        {\n            \"patent_number\": \"US1012345678B2\"\n        },\n        {\n            \"patent_number\": \"US1122334455B2\"\n        },\n        {\n            \"patent_number\": \"US1211223344B2\"\n        },\n        {\n            \"patent_number\": \"US1311334455B2\"\n        }\n    ],\n    \"claims\": [\n        \"A system for federated learning...\",\n        \"A method for protecting user data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69421", "text": "{\n    \"patent_title\": \"Improved Image Recognition Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2022-05-10\",\n    \"filing_date\": \"2022-05-10\",\n    \"issue_date\": \"2024-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved algorithm for image recognition based on convolutional neural networks.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US99887766B1\"\n        },\n        {\n            \"patent_number\": \"US100112233B2\"\n        },\n        {\n            \"patent_number\": \"US111223344B2\"\n        }\n    ],\n    \"claims\": [\n        \"An image recognition algorithm...\",\n        \"A system for processing images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69422", "text": "{\n    \"patent_title\": \"Wireless Power Transfer System and Method\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Qualcomm Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-06-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless power transfer system utilizing resonant inductive coupling to efficiently transfer power to portable electronic devices. This system allows for convenient charging without the need for physical connectors. The technology focuses on improving charging speed and range for consumer electronics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8754441B2\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless power transfer system comprising...\",\n        \"A method for wirelessly charging a device...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69422", "text": "{\n    \"patent_title\": \"Wireless Monitoring System for Medical Implants\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Boston Scientific\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-15\",\n    \"issue_date\": \"2020-03-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless monitoring system for implanted medical devices, enabling real-time data transmission and remote diagnostics. The system includes a miniature wireless transceiver and biocompatible antenna for continuous monitoring of physiological parameters within the patient's body, specifically cardiac functions. This is a medical application.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless monitoring system for an implanted medical device...\",\n        \"A method for remotely monitoring physiological data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69423", "text": "{\n    \"patent_title\": \"System and Method for Federated Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Sergey Brin\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Larry Page\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2017-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enabling federated learning across multiple devices without sharing raw data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\"\n        },\n        {\n            \"patent_number\": \"US6543210B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for federated learning comprising...\",\n        \"A system for federated learning comprising...\"\n    ]\n}"}
