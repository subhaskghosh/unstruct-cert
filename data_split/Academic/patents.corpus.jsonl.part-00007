{"_id": "Academic--patents--p--66272", "text": "{\n    \"patent_title\": \"High-Efficiency Solar Cell with Perovskite Absorber Layer\",\n    \"inventors\": [\n        {\n            \"name\": \"Li Wei\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Maria Rodriguez\",\n            \"affiliation\": \"National Renewable Energy Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A high-efficiency solar cell incorporating a perovskite absorber layer and novel charge transport materials, achieving a power conversion efficiency of over 25%.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8785432B1\",\n            \"relevance\": \"Cited as prior art in perovskite solar cell technology\"\n        },\n        {\n            \"patent_number\": \"US9123876B2\",\n            \"relevance\": \"Related to charge transport layer materials\"\n        }\n    ],\n    \"claims\": [\n        \"A solar cell comprising a perovskite absorber layer.\",\n        \"A charge transport layer configured to extract charge carriers from the perovskite absorber layer.\",\n        \"A method for fabricating a high-efficiency solar cell.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66272", "text": "{\n    \"patent_title\": \"Improved Wind Turbine Blade Design\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-02-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved wind turbine blade design featuring enhanced aerodynamic properties and reduced noise levels.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art related to wind turbine blade profiles.\"\n        }\n    ],\n    \"claims\": [\n        \"A wind turbine blade with an optimized airfoil shape.\",\n        \"A method for reducing noise generated by a wind turbine blade.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66273", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Processing using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method and system for enhanced image processing using deep learning techniques. The system is capable of significantly improving image quality, identifying objects within images, and performing real-time analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image enhancement.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing an image comprising...\",\n        \"A system for performing image analysis...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66273", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-09-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved algorithm for data compression, achieving higher compression ratios and faster processing speeds. It is particularly useful for large datasets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related work in data compression.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data comprising...\",\n        \"A system for decompressing data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66274", "text": "{\n    \"patent_title\": \"High-Performance Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-06-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel electrode materials for lithium-ion batteries, exhibiting enhanced energy density and cycle life. The materials comprise a unique nanocomposite structure utilizing silicon and carbon.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrode comprising...\",\n        \"A method for manufacturing...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66274", "text": "{\n    \"patent_title\": \"Battery Management System for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Texas Instruments\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Samsung SDI\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) for lithium-ion batteries is disclosed. The BMS monitors voltage, current, and temperature to optimize battery performance and ensure safety. The system incorporates advanced algorithms for state-of-charge estimation and cell balancing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66275", "text": "{\n    \"patent_title\": \"Method and system for enhanced image processing using deep learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for enhanced image processing utilizing deep learning algorithms. The system efficiently analyzes and optimizes images for various applications, including medical imaging and autonomous vehicles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image processing comprising...\",\n        \"A system for image analysis...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66275", "text": "{\n    \"patent_title\": \"Novel Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Motors\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-08-20\",\n    \"filing_date\": \"2017-08-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new battery management system designed to optimize energy storage and discharge efficiency in electric vehicles. The system includes advanced thermal control and state-of-charge estimation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling battery discharge...\"\n    ]\n}"}
