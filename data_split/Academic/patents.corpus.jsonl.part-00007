{"_id": "Academic--patents--p--66514", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications. The system incorporates a low-power sensor and a wireless transceiver for remote data acquisition.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for remotely monitoring pressure using a wireless sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66514", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2009-12-01\",\n    \"filing_date\": \"2009-12-01\",\n    \"issue_date\": \"2012-04-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles. The system utilizes advanced algorithms to optimize battery life and performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery performance...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66515", "text": "{\n    \"patent_title\": \"AI-Powered Predictive Maintenance System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Google AI\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"IBM Research\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-11-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an AI-powered system for predictive maintenance in industrial settings. Utilizing machine learning algorithms, the system analyzes sensor data to predict equipment failures and optimize maintenance schedules, leading to reduced downtime and cost savings. The core of the system is a novel artificial intelligence engine.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predicting equipment failures comprising...\",\n        \"A method for optimizing maintenance schedules...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66515", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Eve Miller\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Frank White\",\n            \"affiliation\": \"Independent Inventor\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-08-01\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2021-11-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents an improved bicycle brake system utilizing a novel cable mechanism to enhance braking performance and safety. The system provides more responsive and reliable braking, especially in wet conditions.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A bicycle brake system comprising...\",\n        \"A cable mechanism for enhanced braking...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66516", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Glucose Sensor\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MedTech Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-11-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized glucose sensor for continuous monitoring in diabetic patients. The sensor is implantable and utilizes a novel enzymatic reaction for accurate glucose detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on implantable sensors\"\n        }\n    ],\n    \"claims\": [\n        \"A miniaturized glucose sensor comprising...\",\n        \"A method for continuous glucose monitoring...\"\n    ]\n}"}
