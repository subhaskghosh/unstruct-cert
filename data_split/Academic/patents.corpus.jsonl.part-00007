{"_id": "Academic--patents--n--66322", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10987654B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2019-12-15\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery technology utilizing advanced materials to enhance energy density and charging speed for electric vehicle applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising...\",\n        \"A battery pack comprising...\",\n        \"An electric vehicle comprising...\",\n        \"The battery cell of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66323", "text": "{\n    \"patent_title\": \"System and Method for Personalized Recommendations Using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Sergey Brin\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Larry Page\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-03-15\",\n    \"filing_date\": \"2010-05-20\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for providing personalized recommendations to users based on machine learning algorithms. The system analyzes user behavior and preferences to predict items the user may be interested in.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"kind\": \"Cited by Applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating personalized recommendations comprising: receiving user data; applying a machine learning algorithm to the user data; and generating a recommendation based on the output of the machine learning algorithm.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66323", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2008-11-01\",\n    \"filing_date\": \"2011-02-10\",\n    \"issue_date\": \"2017-09-19\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles, providing enhanced efficiency and safety. The system monitors battery status and optimizes charging and discharging cycles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"kind\": \"Cited by Examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising: a voltage sensor; a current sensor; a temperature sensor; and a control unit configured to optimize battery charging and discharging.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66324", "text": "{\n    \"patent_title\": \"Microfluidic Device for Single-Cell Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-11-15\",\n    \"filing_date\": \"2019-03-20\",\n    \"issue_date\": \"2021-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a microfluidic device for high-throughput single-cell analysis. The device comprises a network of microchannels designed to isolate, culture, and analyze individual cells with high precision and efficiency. The device can be used for various applications including drug screening, disease diagnostics, and fundamental biological research. The fabrication process utilizes soft lithography and is scalable for mass production. Further, the design incorporates integrated sensors for real-time monitoring of cellular parameters.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Microfluidic Cell Sorting System\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device for single-cell analysis comprising...\",\n        \"The device of claim 1, wherein the microchannels are fabricated using soft lithography...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66324", "text": "{\n    \"patent_title\": \"Microfluidic Mixing Apparatus\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2017-09-01\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2020-12-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for efficient mixing of fluids. \",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Enhanced Microfluidic Mixing\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device for mixing fluids, comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66325", "text": "{\n    \"patent_title\": \"System and Method for Image Recognition Using a Deep Convolutional Neural Network\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for accurate image recognition using a deep convolutional neural network. The system is trained on a large dataset of images and can identify objects with high precision.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66325", "text": "{\n    \"patent_title\": \"Method for Optimizing Combustion Engine Efficiency\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Ford Motor Company\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2008-11-20\",\n    \"filing_date\": \"2008-11-20\",\n    \"issue_date\": \"2011-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel method for optimizing the combustion process in internal combustion engines, leading to increased fuel efficiency and reduced emissions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for combustion optimization...\",\n        \"An engine configured to utilize the combustion method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66326", "text": "{\n    \"patent_title\": \"System and method for generating personalized learning paths using artificial intelligence\",\n    \"inventors\": [\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Sergey Levine\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2020-12-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for generating personalized learning paths for students using artificial intelligence techniques. The system analyzes student performance data to identify knowledge gaps and recommend relevant learning materials.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Intelligent Tutoring System\"\n        }\n    ],\n    \"claims\": [\n        \"A system for generating personalized learning paths comprising...\",\n        \"A method for identifying knowledge gaps...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66326", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2015-03-10\",\n    \"filing_date\": \"2015-03-10\",\n    \"issue_date\": \"2018-07-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved bicycle brake system offering enhanced stopping power and modulation. Incorporates a novel hydraulic mechanism for optimal performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Prior Art Brake System\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle brake system comprising...\",\n        \"A hydraulic mechanism for improving braking performance...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66327", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Processing using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2015-03-15\",\n    \"filing_date\": \"2015-05-20\",\n    \"issue_date\": \"2018-11-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method and system for enhanced image processing using deep learning algorithms. The system utilizes convolutional neural networks to improve image quality and perform object recognition with high accuracy. Applications include medical imaging, autonomous vehicles, and security systems. The core concept lies in a new loss function to improve the image processing results.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in image segmentation\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image quality comprising...\",\n        \"A system for object recognition using deep learning...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66327", "text": "{\n    \"patent_title\": \"Novel Camera Lens Design\",\n    \"inventors\": [\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Optical Innovations Inc.\"\n        },\n        {\n            \"name\": \"Eve Brown\",\n            \"affiliation\": \"Optical Innovations Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-07-01\",\n    \"filing_date\": \"2017-01-10\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new camera lens design that improves image clarity and reduces distortion. The lens utilizes a combination of aspheric surfaces and high-refractive-index materials. The new design allows for a smaller and lighter camera while maintaining high optical performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Previous lens design concepts\"\n        }\n    ],\n    \"claims\": [\n        \"A camera lens comprising...\",\n        \"An optical system for reducing distortion...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66328", "text": "{\n    \"patent_title\": \"System and Method for Dynamic Spectrum Allocation\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-15\",\n    \"filing_date\": \"2015-03-10\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for dynamically allocating spectrum resources in a wireless communication network.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Spectrum Sensing Techniques\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Interference Management in Wireless Networks\"\n        },\n        {\n            \"patent_number\": \"US9234567B1\",\n            \"title\": \"Adaptive Modulation and Coding\"\n        },\n        {\n            \"patent_number\": \"US9345678B2\",\n            \"title\": \"Cognitive Radio Systems\"\n        },\n        {\n            \"patent_number\": \"US9456789B1\",\n            \"title\": \"Dynamic Spectrum Access Protocols\"\n        }\n    ],\n    \"claims\": [\n        \"A method for dynamically allocating spectrum...\",\n        \"A system comprising...\"\n    ]\n}"}
