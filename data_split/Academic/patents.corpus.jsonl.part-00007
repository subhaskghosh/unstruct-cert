{"_id": "Academic--patents--n--69225", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-02-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an improved battery management system for electric vehicles, enhancing efficiency and extending battery life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling battery charge and discharge...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69226", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to novel electrode materials for lithium-ion batteries, improving energy density and cycle life. The materials are composed of a modified lithium transition metal oxide.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on lithium-ion battery electrolytes\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrode material...\",\n        \"A method of manufacturing...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69226", "text": "{\n    \"patent_title\": \"Advanced Solid-State Battery Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-06-10\",\n    \"filing_date\": \"2020-06-10\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a solid-state battery design utilizing a ceramic electrolyte and lithium metal anode, enhancing safety and performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"relevance\": \"Related to solid electrolyte materials\"\n        }\n    ],\n    \"claims\": [\n        \"A solid-state battery comprising...\",\n        \"A ceramic electrolyte...\",\n        \"A lithium metal anode...\",\n        \"A method for assembling...\",\n        \"A manufacturing process...\",\n        \"A system for battery management...\",\n        \"An electrochemical cell structure...\",\n        \"A device incorporating the battery...\",\n        \"A power source utilizing the battery...\",\n        \"A method of controlling the battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69227", "text": "{\n    \"patent_title\": \"Medical Image Segmentation Using Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2018-06-20\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method for medical image segmentation using convolutional neural networks. It improves the accuracy and efficiency of identifying anatomical structures in MRI and CT scans.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Prior Art Image Processing Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for segmenting medical images comprising: applying a convolutional neural network to an input image; and generating a segmentation map.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69227", "text": "{\n    \"patent_title\": \"Enhanced X-Ray Imaging System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"GE Healthcare\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Siemens Medical Solutions\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2017-12-10\",\n    \"issue_date\": \"2021-01-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved X-ray imaging system with reduced radiation exposure and enhanced image clarity. The system utilizes novel detector technology.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Conventional X-Ray Imaging\"\n        }\n    ],\n    \"claims\": [\n        \"An X-ray imaging system comprising: a radiation source; a detector; and an image processing unit.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69228", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for industrial applications. This system uses a MEMS pressure sensor and a low-power radio transmitter to provide real-time pressure data.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"description\": \"Related pressure sensing technology\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for transmitting pressure data wirelessly...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69228", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, San Diego\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor for continuous monitoring of blood glucose levels in diabetic patients. Utilizes a novel enzyme-based detection method.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"description\": \"Prior art in implantable medical devices\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"description\": \"Related glucose sensing technology\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable glucose sensor comprising...\",\n        \"A method for monitoring glucose levels in vivo...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69229", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-06-15\",\n    \"issue_date\": \"2018-11-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a lithium-ion battery with a novel electrolyte formulation that improves stability and cycle life. The battery utilizes a solid-state electrolyte for enhanced safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art relating to lithium-ion battery electrolytes\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte formulation for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69229", "text": "{\n    \"patent_title\": \"Novel Sodium-Ion Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-10\",\n    \"filing_date\": \"2017-04-10\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a sodium-ion battery with improved energy density and power output. The battery uses a unique cathode material.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related to sodium-ion battery cathode materials\"\n        }\n    ],\n    \"claims\": [\n        \"A sodium-ion battery comprising...\",\n        \"A cathode material for a sodium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69230", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Processing in Autonomous Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-03-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for real-time image processing used in autonomous vehicles. The system utilizes advanced algorithms to improve object detection and scene understanding, enhancing the vehicle's navigational capabilities. The core innovation lies in a novel filtering technique that minimizes noise and maximizes image clarity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Image Enhancement Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A system for real-time image processing...\",\n        \"A method comprising the steps of...\",\n        \"The system of claim 1, wherein...\",\n        \"The method of claim 2, further comprising...\",\n        \"An apparatus for implementing...\",\n        \"A non-transitory computer-readable medium...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69230", "text": "{\n    \"patent_title\": \"Medical Image Reconstruction using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US11234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2021-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel method for reconstructing medical images from raw data using deep learning techniques. The method significantly improves image quality and reduces reconstruction time, leading to faster and more accurate diagnoses. Specifically, it focuses on MRI image processing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"MRI Image Processing Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing medical images...\",\n        \"The method of claim 1, wherein...\",\n        \"A system for performing the method...\",\n        \"A computer program product...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69231", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-11-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing image resolution using deep convolutional neural networks. This invention significantly improves the quality of low-resolution images through a novel image processing algorithm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution...\",\n        \"A system comprising a neural network...\"\n    ]\n}"}
