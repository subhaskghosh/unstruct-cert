{"_id": "Academic--patents--p--69802", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition utilizing artificial intelligence algorithms. The system employs deep learning techniques to analyze images and identify objects with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for identifying objects in an image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69802", "text": "{\n    \"patent_title\": \"Improved Mechanical Gear Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Williams\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-01-22\",\n    \"filing_date\": \"2019-03-05\",\n    \"issue_date\": \"2021-07-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved design for mechanical gears, enhancing efficiency and reducing wear. The new gear configuration utilizes a novel tooth profile for smoother operation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related Art\"\n        }\n    ],\n    \"claims\": [\n        \"A gear comprising a tooth profile...\",\n        \"A mechanical system utilizing the improved gear...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69803", "text": "{\n    \"patent_title\": \"System and Method for Image-Based Object Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image-based object recognition utilizing deep convolutional neural networks. The system is designed to accurately identify and categorize objects within images, with applications in autonomous vehicles and medical imaging. The system employs a novel attention mechanism to improve recognition accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760799B2\",\n            \"relevance\": \"Prior art in convolutional neural networks\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image-based object recognition comprising...\",\n        \"A method for identifying objects within an image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69803", "text": "{\n    \"patent_title\": \"Improved Algorithm for Facial Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"California Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2019-06-10\",\n    \"filing_date\": \"2019-06-10\",\n    \"issue_date\": \"2020-11-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved algorithm for real-time facial detection in video streams. The algorithm utilizes a cascade of boosted classifiers to achieve high accuracy and speed. It is applicable to security systems and mobile devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related work on Haar-like features\"\n        }\n    ],\n    \"claims\": [\n        \"A method for detecting faces in a video stream comprising...\",\n        \"A system for real-time facial recognition...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69804", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-06-15\",\n    \"filing_date\": \"2015-03-10\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery design utilizing new materials to improve energy density and charging speed for electric vehicle applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Lithium-Ion Battery Improvements\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Solid State Electrolytes\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Battery Management Systems\"\n        },\n        {\n            \"patent_number\": \"US8901234B1\",\n            \"title\": \"Charging Infrastructure\"\n        },\n        {\n            \"patent_number\": \"US9543210B2\",\n            \"title\": \"Advanced Electrode Materials\"\n        }\n    ],\n    \"claims\": [\n        \"A battery comprising...\",\n        \"A method of manufacturing...\",\n        \"A system for...\"\n    ]\n}"}
