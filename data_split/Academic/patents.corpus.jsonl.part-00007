{"_id": "Academic--patents--p--66485", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Predictive Maintenance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-07-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for predictive maintenance using artificial intelligence and machine learning algorithms. The system analyzes sensor data to predict equipment failures, reducing downtime and maintenance costs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in sensor data analysis\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for predictive maintenance comprising...\",\n        \"2. The system of claim 1, wherein the analysis is performed using...\",\n        \"3. A method for predictive maintenance...\",\n        \"4. The method of claim 3, further comprising...\",\n        \"5. The system of claim 1, wherein the artificial intelligence model is a deep neural network.\",\n        \"6. The method of claim 3, wherein the sensor data comprises vibration data.\",\n        \"7. The system of claim 1, including a user interface for displaying predicted failures.\"\n    ]\n}"}
