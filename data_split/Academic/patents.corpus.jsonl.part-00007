{"_id": "Academic--patents--p--66110", "text": "{\n    \"patent_title\": \"Method and Apparatus for Enhanced Image Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-06-20\",\n    \"issue_date\": \"2018-12-04\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method and apparatus for compressing images using wavelet transform and adaptive quantization.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"Related prior art on wavelet compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image comprising...\",\n        \"An apparatus for compressing an image...\",\n        \"The method of claim 1, wherein...\",\n        \"The apparatus of claim 2, further comprising...\",\n        \"A computer-readable medium storing instructions for...\",\n        \"The method of claim 1, wherein the wavelet transform is a Daubechies wavelet.\",\n        \"The apparatus of claim 2, wherein the quantization is adaptive.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66110", "text": "{\n    \"patent_title\": \"Improved Optical Lens Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2011-05-10\",\n    \"filing_date\": \"2011-08-15\",\n    \"issue_date\": \"2017-07-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new design for an optical lens with improved resolution and reduced distortion.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B2\",\n            \"relevance\": \"Prior art on optical lens design\"\n        }\n    ],\n    \"claims\": [\n        \"An optical lens comprising...\",\n        \"The lens of claim 1, wherein...\",\n        \"The lens of claim 2, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66111", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the resolution of digital images using deep convolutional neural networks. The system learns to predict high-resolution details from low-resolution inputs, resulting in sharper and more detailed images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Super-Resolution using Sparse Representation\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising:...\",\n        \"A system for enhancing image resolution comprising:...\",\n        \"The method of claim 1, wherein the neural network is a convolutional neural network.\",\n        \"The system of claim 2, further comprising a display device.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66111", "text": "{\n    \"patent_title\": \"System for Facial Recognition in Security Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-08-20\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2020-12-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for identifying individuals based on their facial features using advanced image processing algorithms. The system is designed for security applications such as access control and surveillance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Real-time Face Detection System\"\n        }\n    ],\n    \"claims\": [\n        \"A system for facial recognition comprising:...\",\n        \"The system of claim 1, wherein the facial features are extracted using a convolutional neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66112", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel system and method for improving the accuracy and efficiency of image recognition algorithms using deep learning techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for enhancing image recognition accuracy...\"\n    ]\n}"}
