{"_id": "Academic--patents--p--66221", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a miniature wireless pressure sensor system for biomedical applications. The system comprises a novel MEMS pressure sensor, a low-power transceiver, and a biocompatible encapsulation. The sensor provides real-time physiological data with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A miniature wireless pressure sensor comprising...\",\n        \"A method for measuring pressure using said sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66221", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"Google\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2019-11-22\",\n    \"filing_date\": \"2019-12-10\",\n    \"issue_date\": \"2021-07-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved battery management system for electric vehicles. The system enhances battery life and safety by optimizing charging and discharging cycles. It utilizes advanced algorithms and real-time data analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery performance...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66222", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-03-15\",\n    \"filing_date\": \"2015-05-20\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor with wireless communication capabilities for continuous glucose monitoring. The sensor utilizes a novel enzyme-based electrochemical detection method and transmits data via Bluetooth to a mobile device.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Continuous Glucose Monitoring System\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Wireless Communication Protocol for Medical Devices\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Implantable Biosensor\"\n        },\n        {\n            \"patent_number\": \"US20160123456A1\",\n            \"title\": \"Glucose Sensor Calibration\"\n        },\n        {\n            \"patent_number\": \"US20170456789A1\",\n            \"title\": \"Miniaturized Implantable Devices\"\n        }\n    ],\n    \"claims\": [\n        \"A method for continuously monitoring glucose levels in a patient.\",\n        \"An implantable glucose sensor comprising an enzyme-based electrochemical detection system.\",\n        \"A wireless communication module for transmitting glucose data.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66222", "text": "{\n    \"patent_title\": \"Portable Blood Pressure Monitor\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-01-10\",\n    \"filing_date\": \"2017-02-15\",\n    \"issue_date\": \"2020-05-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A portable blood pressure monitor with a digital display and memory function. The device is designed for home use and provides accurate blood pressure readings.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"title\": \"Digital Blood Pressure Measurement\"\n        },\n        {\n            \"patent_number\": \"US9234567B1\",\n            \"title\": \"Portable Medical Devices\"\n        }\n    ],\n    \"claims\": [\n        \"A portable blood pressure monitor with a digital display.\",\n        \"A memory function for storing blood pressure readings.\",\n        \"A cuff for measuring blood pressure.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66223", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel system and method for improving the accuracy and efficiency of image recognition using deep learning techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Classification Algorithm\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Convolutional Neural Network Architecture\"\n        },\n        {\n            \"patent_number\": \"US11112222B1\",\n            \"title\": \"Object Detection System\"\n        },\n        {\n            \"patent_number\": \"US12345678B2\",\n            \"title\": \"Deep Learning Framework\"\n        },\n        {\n            \"patent_number\": \"US13579246B1\",\n            \"title\": \"Image Segmentation Method\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for image recognition comprising...\"\n    ]\n}"}
