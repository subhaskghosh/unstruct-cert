{"_id": "Academic--patents--p--66765", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Improved Electrolyte Composition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a lithium-ion battery with an improved electrolyte composition for enhanced performance and safety. The new electrolyte formulation significantly increases energy density and cycle life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition consisting of...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66765", "text": "{\n    \"patent_title\": \"Novel Solar Panel Design for Enhanced Efficiency\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-08-01\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2021-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a new design for solar panels, focusing on increasing light absorption and converting it into electrical energy. The design incorporates a novel reflective layer and optimized cell arrangement.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A solar panel comprising...\",\n        \"A reflective layer with a specific refractive index...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66766", "text": "{\n    \"patent_title\": \"System and Method for Image Recognition using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition using deep learning techniques, specifically convolutional neural networks. The system is capable of identifying objects and patterns in images with high accuracy. This invention utilizes machine learning algorithms to improve performance over time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Prior Art Image Processing System\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising a convolutional neural network.\",\n        \"A method for training an image recognition model using a labeled dataset.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66766", "text": "{\n    \"patent_title\": \"Improved Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Williams\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-10-27\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system (BMS) for electric vehicles. The system optimizes battery performance and extends battery life by accurately monitoring and controlling charging and discharging cycles. The system uses data analysis techniques to predict battery degradation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Prior Art Battery Management System\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising a voltage monitoring circuit.\",\n        \"A method for optimizing battery charging based on temperature.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66767", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel lithium-ion battery design with improved thermal stability and cycle life. The design incorporates a new electrolyte formulation and electrode materials.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Lithium-Ion Battery Electrolyte\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"High-Capacity Anode Material\"\n        },\n        {\n            \"patent_number\": \"US11234567B1\",\n            \"title\": \"Battery Management System\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte formulation for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66767", "text": "{\n    \"patent_title\": \"Novel Polymer for Flexible Electronics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2021-03-10\",\n    \"issue_date\": \"2023-01-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new polymer material with high flexibility and conductivity, suitable for use in flexible electronic devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Flexible Substrate Material\"\n        },\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"title\": \"Conductive Polymer Coating\"\n        }\n    ],\n    \"claims\": [\n        \"A polymer material comprising...\",\n        \"A flexible electronic device incorporating the polymer...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66768", "text": "{\n    \"patent_title\": \"Novel Polymer Composite for High-Strength Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT Materials Science Department\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-06-20\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel polymer composite material exhibiting exceptional strength and durability is disclosed. The composite utilizes a unique combination of polymer matrices and reinforcing nanoparticles, resulting in enhanced mechanical properties.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A polymer composite comprising...\",\n        \"The polymer composite according to claim 1, wherein...\",\n        \"A method for manufacturing the polymer composite...\",\n        \"The method according to claim 3, wherein...\",\n        \"The polymer composite according to claim 1, exhibiting a tensile strength...\",\n        \"The polymer composite according to claim 5, with a tensile strength greater than 500 MPa.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66768", "text": "{\n    \"patent_title\": \"Improved Battery Electrode Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-08-12\",\n    \"issue_date\": \"2023-02-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved electrode material for lithium-ion batteries is presented. The material exhibits increased energy density and cycle life.\",\n    \"citations\": [],\n    \"claims\": [\n        \"An electrode material comprising...\",\n        \"The electrode material according to claim 1, wherein...\",\n        \"A lithium-ion battery comprising the electrode material...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66769", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a miniature wireless pressure sensor system for biomedical applications. The system incorporates a novel micro-fabrication process to create a highly sensitive and accurate pressure sensor. The sensor transmits data wirelessly to a remote monitoring station.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in wireless communication\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising...\",\n        \"A method for fabricating a miniature pressure sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66769", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"UC Berkeley\"\n        },\n        {\n            \"name\": \"Eve Foster\",\n            \"affiliation\": \"Tesla\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2018-07-01\",\n    \"filing_date\": \"2020-01-15\",\n    \"issue_date\": \"2021-10-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved battery management system for electric vehicles, optimizing charging and discharging cycles for extended battery life.  The system utilizes advanced algorithms to predict battery degradation and adjust performance accordingly.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"Prior art in battery control\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery performance...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66770", "text": "{\n    \"patent_title\": \"Wireless Temperature Sensor with Enhanced Accuracy\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-05-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless temperature sensor utilizing advanced signal processing techniques for improved accuracy and reliability in industrial applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Similar sensor technology\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless temperature sensor comprising...\",\n        \"A method for calibrating a wireless temperature sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66770", "text": "{\n    \"patent_title\": \"Miniature Biosensor for Medical Diagnostics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"HealthTech Solutions\"\n        }\n    ],\n    \"patent_number\": \"US10293847B1\",\n    \"priority_date\": \"2017-01-10\",\n    \"filing_date\": \"2017-01-10\",\n    \"issue_date\": \"2019-08-13\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature biosensor designed for rapid and accurate medical diagnostics, specifically for detecting biomarkers in blood samples.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related biosensor technology\"\n        }\n    ],\n    \"claims\": [\n        \"A miniature biosensor for medical applications...\",\n        \"A method for detecting biomarkers using a biosensor...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66771", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Data Encryption\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2021-09-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel system and method for encrypting data using a dynamically generated key based on user biometrics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for encrypting data comprising...\",\n        \"A system for secure data transmission...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The method of claim 1, wherein...\",\n        \"The system of claim 2, further comprising...\",\n        \"The computer-readable medium of claim 3, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66771", "text": "{\n    \"patent_title\": \"Improved Surgical Stapler Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Medical Devices Corp.\"\n        }\n    ],\n    \"patent_number\": \"US7654321B1\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2021-11-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical stapler with enhanced precision and reduced tissue damage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical stapler comprising...\",\n        \"The surgical stapler of claim 1, wherein...\",\n        \"A method for using the surgical stapler...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66772", "text": "{\n    \"patent_title\": \"Method and System for Dynamic Resource Allocation in Cloud Computing\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-05-15\",\n    \"filing_date\": \"2010-02-20\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for dynamically allocating resources in a cloud computing environment based on real-time demand and availability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Resource Management in Distributed Systems\"\n        }\n    ],\n    \"claims\": [\n        \"A method for dynamically allocating resources in a cloud computing environment.\",\n        \"A system for implementing the method of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66772", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Emily Brown\",\n            \"affiliation\": \"Tesla Motors\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2008-11-01\",\n    \"filing_date\": \"2011-03-10\",\n    \"issue_date\": \"2017-05-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery technology providing increased energy density and improved lifespan for electric vehicle applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B2\",\n            \"title\": \"Lithium-Ion Battery Improvements\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising a novel electrolyte composition.\",\n        \"An electric vehicle utilizing the battery cell of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66773", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Processing in Autonomous Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for improving image processing algorithms used in autonomous vehicles. The system utilizes advanced filtering techniques to enhance image clarity and object detection in various weather conditions, improving the safety and reliability of self-driving cars.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image filtering\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image processing in autonomous vehicles comprising...\",\n        \"A method for enhancing image clarity...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66773", "text": "{\n    \"patent_title\": \"Medical Image Analysis System Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Medical Imaging Solutions\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-01\",\n    \"issue_date\": \"2023-05-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system for analyzing medical images, such as X-rays and MRIs, using deep learning techniques. The system accurately detects anomalies and assists radiologists in making diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Prior art in medical imaging analysis\"\n        }\n    ],\n    \"claims\": [\n        \"A system for analyzing medical images comprising...\",\n        \"A method for detecting anomalies in medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66774", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhanced image recognition using deep learning techniques. This invention improves accuracy and efficiency in identifying objects within images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for enhancing image recognition accuracy...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66774", "text": "{\n    \"patent_title\": \"Improved Battery Life for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Apple Inc.\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-05-20\",\n    \"issue_date\": \"2016-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery life for mobile devices based on power management techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\"\n        }\n    ],\n    \"claims\": [\n        \"A mobile device comprising a battery and a power management system...\",\n        \"A method for extending battery life in a mobile device...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66775", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Segmentation Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method and system for image segmentation using deep convolutional neural networks. The system enhances accuracy and efficiency in identifying objects within images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image segmentation comprising...\",\n        \"A system for image segmentation comprising...\",\n        \"The method of claim 1, wherein...\",\n        \"The system of claim 2, wherein...\",\n        \"A computer-readable medium storing...\",\n        \"A device for performing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66775", "text": "{\n    \"patent_title\": \"Novel Image Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-05-01\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2021-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new image compression algorithm that improves the compression ratio while maintaining image quality.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for image compression...\",\n        \"An apparatus for image compression...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66776", "text": "{\n    \"patent_title\": \"System and method for AI-powered image recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2021-05-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for performing image recognition using artificial intelligence techniques, specifically convolutional neural networks. The system can identify objects in images with high accuracy and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for identifying objects in an image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66776", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2018-07-10\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2020-12-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel battery management system designed to improve the lifespan and efficiency of lithium-ion batteries. It utilizes advanced charging algorithms and temperature control mechanisms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling the charging of a battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66777", "text": "{\n    \"patent_title\": \"System and Method for Personalized Content Delivery\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-05-15\",\n    \"filing_date\": \"2010-02-20\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for delivering personalized content to users based on their preferences and historical data.  The system employs machine learning algorithms to identify relevant content and optimize delivery for enhanced user engagement.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"kind\": \"Cited by Examiner\"\n        },\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"kind\": \"Cited by Applicant\"\n        },\n        {\n            \"patent_number\": \"US9012345B1\",\n            \"kind\": \"Cited by Examiner\"\n        },\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"kind\": \"Cited by Applicant\"\n        },\n        {\n            \"patent_number\": \"US9234567B1\",\n            \"kind\": \"Cited by Examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A method for delivering personalized content...\",\n        \"A system comprising...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66777", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2011-11-01\",\n    \"filing_date\": \"2012-05-10\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery management system designed to enhance the lifespan and performance of lithium-ion batteries. The system incorporates advanced charging algorithms and thermal regulation techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"kind\": \"Cited by Examiner\"\n        },\n        {\n            \"patent_number\": \"US8901234B1\",\n            \"kind\": \"Cited by Applicant\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"kind\": \"Cited by Examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for charging a battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66778", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor for Intracranial Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor is disclosed for intracranial monitoring. The sensor comprises a piezoelectric element, a communication module, and a biocompatible housing. The device transmits pressure data wirelessly to an external receiver for real-time monitoring of intracranial pressure. This is particularly useful in medical applications for trauma patients.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Wireless Physiological Monitoring System\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising...\",\n        \"A method for monitoring intracranial pressure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66778", "text": "{\n    \"patent_title\": \"Improved Optical Fiber Cable\",\n    \"inventors\": [\n        {\n            \"name\": \"Robert Brown\",\n            \"affiliation\": \"Bell Labs\"\n        }\n    ],\n    \"patent_number\": \"US8901234B1\",\n    \"priority_date\": \"2008-11-01\",\n    \"filing_date\": \"2008-11-01\",\n    \"issue_date\": \"2018-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved optical fiber cable with enhanced bandwidth and reduced signal loss is described. The cable utilizes a novel cladding material and a precise manufacturing process to minimize attenuation. It is applicable in high-speed data transmission systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7123456B2\",\n            \"title\": \"High-Bandwidth Optical Fiber\"\n        }\n    ],\n    \"claims\": [\n        \"An optical fiber cable comprising...\",\n        \"A method for manufacturing an optical fiber cable...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66779", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Recognition Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method and system for enhancing image recognition accuracy using a deep convolutional neural network architecture. The system improves performance in challenging conditions such as low light and occlusions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Classification Using Convolutional Neural Networks\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Object Detection in Images\"\n        },\n        {\n            \"patent_number\": \"US11223344B1\",\n            \"title\": \"Image Segmentation Techniques\"\n        },\n        {\n            \"patent_number\": \"US12345000B2\",\n            \"title\": \"Deep Learning for Image Analysis\"\n        },\n        {\n            \"patent_number\": \"US13456789B1\",\n            \"title\": \"Advanced Image Processing Algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image recognition accuracy comprising...\",\n        \"A system for processing images using a deep learning model...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66779", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2021-02-15\",\n    \"issue_date\": \"2023-06-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved algorithm for data compression, resulting in higher compression ratios and faster processing speeds.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Data Compression Techniques\"\n        },\n        {\n            \"patent_number\": \"US87654320B1\",\n            \"title\": \"Efficient Data Encoding Methods\"\n        },\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"title\": \"Lossless Data Compression Algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"An algorithm for compressing data comprising...\",\n        \"A method for encoding data efficiently...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66780", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-03-15\",\n    \"filing_date\": \"2021-03-15\",\n    \"issue_date\": \"2023-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for remote monitoring applications. The sensor utilizes MEMS technology and low-power communication protocols.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art in pressure sensing\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising...\",\n        \"A method for remotely monitoring pressure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66780", "text": "{\n    \"patent_title\": \"Improved Glucose Sensor with Enhanced Sensitivity\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2020-05-10\",\n    \"filing_date\": \"2020-05-10\",\n    \"issue_date\": \"2022-08-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved glucose sensor utilizing enzymatic reactions and electrochemical detection for accurate glucose monitoring.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"Relevant art related to glucose sensing\"\n        }\n    ],\n    \"claims\": [\n        \"A glucose sensor comprising...\",\n        \"A method for measuring glucose levels...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66781", "text": "{\n    \"patent_title\": \"Miniaturized Implantable Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2021-08-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized implantable biosensor for continuous glucose monitoring, comprising a biocompatible housing, a glucose sensing enzyme, and a wireless communication module. The device provides real-time glucose data to a mobile application.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Prior art in glucose sensing technology.\"\n        }\n    ],\n    \"claims\": [\n        \"A biosensor comprising a biocompatible housing.\",\n        \"The biosensor of claim 1, further comprising a glucose sensing enzyme.\",\n        \"The biosensor of claim 2, wherein the enzyme is glucose oxidase.\",\n        \"A method for continuously monitoring glucose levels using the biosensor of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66781", "text": "{\n    \"patent_title\": \"Improved Algorithm for Image Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2018-11-20\",\n    \"filing_date\": \"2020-03-01\",\n    \"issue_date\": \"2021-05-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved algorithm for image compression utilizing wavelet transforms and adaptive quantization. This algorithm achieves higher compression ratios with minimal loss of image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in image compression.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image compression comprising wavelet transformation.\",\n        \"The method of claim 1, further comprising adaptive quantization.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66782", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-12-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor with wireless communication capabilities for continuous glucose monitoring. The sensor utilizes a biocompatible material and transmits data via Bluetooth.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US11456789B2\"\n        },\n        {\n            \"patent_number\": \"US10567890B2\"\n        }\n    ],\n    \"claims\": [\n        \"A glucose sensor comprising...\",\n        \"A wireless communication module...\",\n        \"A biocompatible housing...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66782", "text": "{\n    \"patent_title\": \"Portable Blood Pressure Monitor\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2021-08-03\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A portable blood pressure monitor with a digital display and memory storage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US91234567B2\"\n        },\n        {\n            \"patent_number\": \"US10987654B1\"\n        }\n    ],\n    \"claims\": [\n        \"A blood pressure monitor comprising...\",\n        \"A digital display...\",\n        \"A memory storage unit...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66783", "text": "{\n    \"patent_title\": \"System and Method for Adaptive Beamforming in Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology (MIT)\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for adaptive beamforming in wireless communication networks. The system dynamically adjusts the beamforming weights based on channel conditions and user demand.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for adaptive beamforming comprising...\",\n        \"A system for adaptive beamforming comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66783", "text": "{\n    \"patent_title\": \"Novel Chemical Compound for Pharmaceutical Application\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2012-03-10\",\n    \"filing_date\": \"2012-03-10\",\n    \"issue_date\": \"2018-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel chemical compound exhibiting pharmaceutical properties, specifically for treating cardiovascular diseases.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\"\n        }\n    ],\n    \"claims\": [\n        \"A chemical compound having the formula...\",\n        \"A pharmaceutical composition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66784", "text": "{\n    \"patent_title\": \"System and method for AI-powered image recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for improved image recognition using artificial intelligence techniques, specifically deep convolutional neural networks. The system is capable of identifying objects with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a neural network...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The system of claim 1, wherein the neural network...\",\n        \"The method of claim 2, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66784", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-11-01\",\n    \"filing_date\": \"2021-11-01\",\n    \"issue_date\": \"2023-02-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery management system designed to optimize performance and lifespan of lithium-ion batteries. Includes improved thermal regulation and charging algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Previous battery technology\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for charging a battery...\",\n        \"A thermal regulation module...\",\n        \"The system of claim 1, wherein the battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66785", "text": "{\n    \"patent_title\": \"Neural Network Architecture for Enhanced Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel neural network architecture is presented for improved image recognition accuracy. The network utilizes a unique combination of convolutional and recurrent layers to extract and process visual features effectively.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in convolutional neural networks.\"\n        }\n    ],\n    \"claims\": [\n        \"A neural network comprising a convolutional layer...\",\n        \"A method for image recognition using the neural network...\",\n        \"The neural network of claim 1, wherein...\",\n        \"The method of claim 2, further comprising...\",\n        \"A system for implementing the method of claim 2...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66785", "text": "{\n    \"patent_title\": \"Improved Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Motors\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2021-01-05\",\n    \"filing_date\": \"2021-05-12\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system designed to optimize the performance and longevity of lithium-ion batteries in electric vehicles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"Prior art in battery cell balancing.\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising a cell balancing circuit...\",\n        \"A method for monitoring battery voltage...\",\n        \"The battery management system of claim 1, wherein...\",\n        \"The method of claim 2, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66786", "text": "{\n    \"patent_title\": \"Improved Electrolyte Composition for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel electrolyte composition for lithium-ion batteries is disclosed, enhancing energy density and cycle life. The electrolyte includes a blend of lithium salts and organic solvents, demonstrating improved performance characteristics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrolyte composition...\",\n        \"The electrolyte composition of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66786", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery Pack Assembly with Enhanced Cooling\",\n    \"inventors\": [\n        {\n            \"name\": \"Ji-hoon Kim\",\n            \"affiliation\": \"Samsung SDI\"\n        },\n        {\n            \"name\": \"Young-seo Park\",\n            \"affiliation\": \"Samsung Electronics\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery pack with an improved cooling system is presented. The system utilizes a phase-change material to dissipate heat effectively, increasing battery lifespan and safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery pack comprising a cooling system...\",\n        \"The cooling system of claim 1, comprising a phase-change material...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66787", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Enhanced Biocompatibility\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor utilizing a novel biocompatible coating to minimize inflammatory response and improve long-term stability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Prior Art Glucose Sensor\"\n        }\n    ],\n    \"claims\": [\n        \"A glucose sensor comprising...\",\n        \"The glucose sensor of claim 1, wherein...\",\n        \"A method for measuring glucose levels...\",\n        \"The method of claim 3, wherein...\",\n        \"A biocompatible coating for a glucose sensor...\",\n        \"The coating of claim 5, comprising...\",\n        \"The coating of claim 6, wherein...\",\n        \"An implantable system comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66787", "text": "{\n    \"patent_title\": \"Wireless Communication Protocol for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US8901234B1\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-05-20\",\n    \"issue_date\": \"2017-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel wireless communication protocol designed to improve data transfer rates in mobile devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Existing Wireless Protocol\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication protocol...\",\n        \"The protocol of claim 1, wherein...\",\n        \"A mobile device comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66788", "text": "{\n    \"patent_title\": \"Microfluidic Device with Integrated Optical Sensor\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-11-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device incorporating an integrated optical sensor for real-time analyte detection. The sensor provides high sensitivity and specificity for various biochemical applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"An optical sensor integrated within said device...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66788", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2018-08-01\",\n    \"filing_date\": \"2019-12-10\",\n    \"issue_date\": \"2021-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery management system designed to optimize energy storage and extend battery life. The system utilizes advanced algorithms for cell balancing and thermal management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A cell balancing circuit configured...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66789", "text": "{\n    \"patent_title\": \"System and method for object recognition using deep convolutional neural networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876345B2\",\n    \"priority_date\": \"2015-03-15\",\n    \"filing_date\": \"2015-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for recognizing objects in images using deep convolutional neural networks. The system is trained on a large dataset of labeled images and is capable of achieving state-of-the-art accuracy on a variety of object recognition tasks.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8120506B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for recognizing objects in an image, comprising: receiving an image; processing the image using a deep convolutional neural network; and outputting a predicted object label.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66789", "text": "{\n    \"patent_title\": \"Method for improving image compression using wavelet transforms\",\n    \"inventors\": [\n        {\n            \"name\": \"Thomas Kwan\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Maria Garcia\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US7654321B1\",\n    \"priority_date\": \"2008-11-01\",\n    \"filing_date\": \"2008-11-01\",\n    \"issue_date\": \"2010-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for improving image compression using wavelet transforms. The method utilizes a novel wavelet transform algorithm to achieve higher compression ratios while maintaining image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6548742B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image, comprising: applying a wavelet transform to the image; quantizing the wavelet coefficients; and encoding the quantized coefficients.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66790", "text": "{\n    \"patent_title\": \"Microfluidic Device for Single Cell Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Chen\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Lee\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for analyzing single cells based on fluorescence detection. The device comprises a microchannel network and a detector for measuring fluorescence signals.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"relevance\": \"Similar microfluidic design\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising a microchannel network.\",\n        \"A method for analyzing single cells using the microfluidic device.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66790", "text": "{\n    \"patent_title\": \"Microfluidic Device for Drug Screening\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Wilson\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2017-07-20\",\n    \"filing_date\": \"2017-07-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for high-throughput drug screening. The device incorporates multiple microchannels and integrated sensors for real-time monitoring.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related microfluidic technology\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising a plurality of microchannels.\",\n        \"A method for screening drug candidates using the microfluidic device.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66791", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US10456789B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-02-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for image recognition using artificial intelligence and deep learning algorithms. The system is capable of identifying objects with high accuracy and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Processing Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for identifying objects in an image...\",\n        \"The system of claim 1, wherein the artificial intelligence...\",\n        \"The method of claim 2, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66791", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Energy Solutions Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US11223344B2\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2021-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel battery composition and architecture for enhanced performance in mobile devices. The battery offers improved energy density and lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Lithium-Ion Battery Improvements\"\n        }\n    ],\n    \"claims\": [\n        \"A battery comprising...\",\n        \"The battery of claim 1, wherein the composition includes...\",\n        \"A mobile device incorporating the battery of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66792", "text": "{\n    \"patent_title\": \"System and Method for Predictive Maintenance Using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for predicting equipment failures using machine learning algorithms. The system analyzes sensor data to identify patterns indicative of impending maintenance needs, reducing downtime and improving operational efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Prior art in predictive maintenance\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predicting equipment failures...\",\n        \"A method for analyzing sensor data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66792", "text": "{\n    \"patent_title\": \"Improved Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Independent Researcher\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2022-03-15\",\n    \"filing_date\": \"2022-03-15\",\n    \"issue_date\": \"2023-08-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a novel data compression algorithm, improving efficiency in data storage and transmission. It incorporates advanced encoding techniques for enhanced performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Related compression methods\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data...\",\n        \"A system for encoding information...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66793", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-12-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for improving image recognition accuracy using deep convolutional neural networks. The system includes a pre-processing module, a feature extraction module, and a classification module.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Similar image processing techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for processing an image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66793", "text": "{\n    \"patent_title\": \"Novel Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Tesla Motors\"\n        }\n    ],\n    \"patent_number\": \"US11456789B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-08-10\",\n    \"issue_date\": \"2022-03-08\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system designed to optimize the performance and lifespan of lithium-ion batteries in electric vehicles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"Related battery technology\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system including...\",\n        \"A method for controlling battery charge...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66794", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Qualcomm\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications. This invention utilizes a novel MEMS sensor and low-power communication protocol. The sensor is highly accurate and reliable.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"cited\"\n        },\n        {\n            \"patent_number\": \"US11111111B2\",\n            \"relevance\": \"similar\"\n        }\n    ],\n    \"claims\": [\n        \"A pressure sensor comprising a MEMS element...\",\n        \"A wireless communication module...\",\n        \"A system for monitoring pressure in a biological environment...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66794", "text": "{\n    \"patent_title\": \"Advanced Image Processing for Autonomous Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Tesla\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-08-01\",\n    \"filing_date\": \"2020-11-15\",\n    \"issue_date\": \"2022-02-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An advanced image processing system for autonomous vehicles, incorporating deep learning algorithms for object detection and path planning.  The system provides robust and reliable navigation in various conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US91234567B2\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US10456789B2\",\n            \"relevance\": \"cited\"\n        },\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"relevance\": \"similar\"\n        },\n        {\n            \"patent_number\": \"US11334455B2\",\n            \"relevance\": \"cited\"\n        },\n        {\n            \"patent_number\": \"US11445566B2\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US11556677B2\",\n            \"relevance\": \"similar\"\n        }\n    ],\n    \"claims\": [\n        \"An image processing system comprising a convolutional neural network...\",\n        \"A method for detecting objects in an image...\",\n        \"A system for autonomous vehicle navigation...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66795", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Biosensor for Continuous Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized wireless biosensor for continuous glucose monitoring is disclosed. The device utilizes a novel enzymatic reaction and a microfabricated sensor to provide accurate and real-time glucose measurements. This technology has the potential to significantly improve diabetes management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Implantable Glucose Sensor\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless biosensor for detecting glucose levels.\",\n        \"A method for continuous glucose monitoring using a miniaturized sensor.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66795", "text": "{\n    \"patent_title\": \"Surgical Instrument for Minimally Invasive Procedures\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-01\",\n    \"issue_date\": \"2023-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel surgical instrument designed for minimally invasive procedures is described. The instrument features a flexible shaft and a micro-camera for enhanced visualization. This invention allows surgeons to perform complex operations with greater precision and reduced patient trauma.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"title\": \"Endoscopic Surgical Tool\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument with a flexible shaft.\",\n        \"A method for performing minimally invasive surgery.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66796", "text": "{\n    \"patent_title\": \"System and Method for Predictive Maintenance Using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for predictive maintenance using machine learning algorithms to analyze sensor data and predict equipment failures. The system leverages historical data and real-time inputs to optimize maintenance schedules and reduce downtime.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Predictive Analytics System\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for predictive maintenance comprising...\",\n        \"2. The system of claim 1, wherein the machine learning algorithm is a neural network.\",\n        \"3. A method for predicting equipment failure...\",\n        \"4. The method of claim 3, further comprising...\",\n        \"5. The system of claim 1, wherein the sensor data includes temperature readings.\",\n        \"6. The system of claim 5, wherein the temperature readings are analyzed using a regression model.\",\n        \"7. The method of claim 3, wherein the historical data comprises maintenance logs.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66796", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Williams\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11876543B2\",\n    \"priority_date\": \"2020-11-01\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-03-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved battery management system designed to enhance the lifespan and safety of lithium-ion batteries. It focuses on thermal regulation and cell balancing techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10543210B1\",\n            \"title\": \"Battery Cell Balancing Circuit\"\n        }\n    ],\n    \"claims\": [\n        \"1. A battery management system comprising...\",\n        \"2. The system of claim 1, wherein the thermal regulation includes a cooling fan.\",\n        \"3. A method for cell balancing in a battery pack...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66797", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Improved Electrolyte\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery with a novel electrolyte composition exhibiting enhanced ionic conductivity and improved safety characteristics. The electrolyte contains a blend of lithium salts and organic solvents, enabling superior performance at both high and low temperatures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"kind\": \"Cited by Applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66797", "text": "{\n    \"patent_title\": \"Nickel-Metal Hydride Battery Improvements\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-05-20\",\n    \"issue_date\": \"2018-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"Improvements to nickel-metal hydride battery technology, focusing on electrode materials and cell design. These improvements lead to increased energy density and cycle life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"kind\": \"Cited by Examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A nickel-metal hydride battery comprising...\",\n        \"An electrode material for a nickel-metal hydride battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66798", "text": "{\n    \"patent_title\": \"System and Method for Personalized Recommendations Using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Sergey Brin\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Larry Page\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2008-05-15\",\n    \"filing_date\": \"2009-03-20\",\n    \"issue_date\": \"2019-07-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for providing personalized recommendations to users. The system utilizes machine learning algorithms to analyze user behavior and preferences, and generates recommendations tailored to each user's individual needs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating personalized recommendations...\",\n        \"A system comprising a machine learning module...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66798", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"James Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2007-11-01\",\n    \"filing_date\": \"2008-07-15\",\n    \"issue_date\": \"2015-02-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel battery technology with improved energy density and lifespan for use in mobile electronic devices. The design incorporates new materials and manufacturing processes to enhance performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising...\",\n        \"A method for manufacturing a battery cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66799", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved lithium-ion battery design incorporating a novel electrolyte composition for enhanced stability and energy density. The battery utilizes a solid-state electrolyte and a modified cathode material.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising a solid-state electrolyte.\",\n        \"The battery of claim 1, wherein the electrolyte comprises...\",\n        \"A method for manufacturing the battery of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66799", "text": "{\n    \"patent_title\": \"Novel Solar Panel Design for Increased Efficiency\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11987654B1\",\n    \"priority_date\": \"2018-08-01\",\n    \"filing_date\": \"2019-11-15\",\n    \"issue_date\": \"2020-12-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a novel solar panel design utilizing perovskite materials to achieve higher energy conversion efficiency. The panel features a unique light-trapping structure and improved thermal management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Prior art in solar cell technology\"\n        }\n    ],\n    \"claims\": [\n        \"A solar panel comprising a perovskite material.\",\n        \"The solar panel of claim 1, further comprising a light-trapping structure.\",\n        \"A method for manufacturing the solar panel of claim 1.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66800", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2022-08-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing image recognition accuracy using deep convolutional neural networks. The system includes a pre-processing module, a feature extraction module, and a classification module.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66800", "text": "{\n    \"patent_title\": \"Improved Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"General Motors\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-11-20\",\n    \"filing_date\": \"2021-03-01\",\n    \"issue_date\": \"2023-01-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles that provides enhanced safety and performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art in battery technology\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for managing battery charge comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66801", "text": "{\n    \"patent_title\": \"System and Method for Predictive Maintenance Using Artificial Intelligence\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"TechCorp Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"TechCorp Inc.\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for predictive maintenance utilizing artificial intelligence algorithms to analyze sensor data and predict equipment failures. The system improves efficiency and reduces downtime.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predictive maintenance...\",\n        \"A method for analyzing sensor data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66801", "text": "{\n    \"patent_title\": \"Implantable Medical Device with AI-Powered Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"MedTech Solutions\"\n        }\n    ],\n    \"patent_number\": \"US76543210B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2019-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable medical device utilizing artificial intelligence to monitor patient health metrics and provide real-time alerts. The device improves patient care and enables proactive interventions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable medical device comprising...\",\n        \"A method for monitoring patient health...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66802", "text": "{\n    \"patent_title\": \"System and Method for Dynamic Resource Allocation in Cloud Computing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2021-12-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for dynamically allocating resources in a cloud computing environment based on real-time demand and performance metrics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Cloud Resource Management\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Scalable Cloud Architecture\"\n        },\n        {\n            \"patent_number\": \"US11111111B2\",\n            \"title\": \"Dynamic Load Balancing\"\n        }\n    ],\n    \"claims\": [\n        \"A system for dynamically allocating resources in a cloud computing environment...\",\n        \"A method for managing cloud resources based on real-time demand...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66802", "text": "{\n    \"patent_title\": \"Improved Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2021-01-10\",\n    \"issue_date\": \"2022-08-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system designed to optimize the performance and lifespan of batteries used in electric vehicles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Battery Monitoring System\"\n        },\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Electric Vehicle Charging\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising a monitoring unit...\",\n        \"A method for optimizing battery performance in an electric vehicle...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66803", "text": "{\n    \"patent_title\": \"System and Method for Personalized Medicine Using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2022-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for personalized medicine using machine learning algorithms to predict patient response to treatment.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US98765432B1\",\n            \"relevance\": \"Related art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for predicting patient response to treatment...\",\n        \"A system comprising a machine learning model...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66803", "text": "{\n    \"patent_title\": \"Improved Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-11-20\",\n    \"filing_date\": \"2020-02-15\",\n    \"issue_date\": \"2021-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles that optimizes charging and discharging cycles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US1012345678B2\",\n            \"relevance\": \"Prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising a microcontroller...\",\n        \"A method for optimizing charging cycles...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66804", "text": "{\n    \"patent_title\": \"Artificial Intelligence Powered Diagnostic System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-03-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A diagnostic system utilizing artificial intelligence algorithms to improve the accuracy and speed of disease detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for diagnosing a disease using AI.\",\n        \"A system comprising an AI algorithm and a medical imaging device.\"\n    ]\n}"}
