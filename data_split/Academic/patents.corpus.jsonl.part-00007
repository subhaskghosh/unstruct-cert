{"_id": "Academic--patents--p--69495", "text": "{\n    \"patent_title\": \"Convolutional Neural Network for Image Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10245678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-06-20\",\n    \"issue_date\": \"2019-11-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a convolutional neural network architecture for enhancing the quality of images. The network employs multiple convolutional layers and pooling layers to extract features and improve image resolution.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Processing Using Deep Learning\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image quality using a convolutional neural network.\",\n        \"An image processing system comprising a convolutional neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69495", "text": "{\n    \"patent_title\": \"Method for Color Space Conversion\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11112222B1\",\n    \"priority_date\": \"2019-05-10\",\n    \"filing_date\": \"2019-08-12\",\n    \"issue_date\": \"2021-02-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel method for converting between different color spaces, such as RGB and YUV, utilizing a lookup table.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US88889999B2\",\n            \"title\": \"Digital Image Encoding\"\n        }\n    ],\n    \"claims\": [\n        \"A method for converting colors using a lookup table.\",\n        \"A system for color space conversion.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69496", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Predictive Maintenance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for predictive maintenance using artificial intelligence. The system analyzes sensor data to predict equipment failures and optimize maintenance schedules, reducing downtime and costs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predictive maintenance comprising...\",\n        \"A method for analyzing sensor data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69496", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"CycleTech Ltd.\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-05-20\",\n    \"filing_date\": \"2019-11-01\",\n    \"issue_date\": \"2021-08-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an improved braking system for bicycles, enhancing safety and performance through a novel lever design and cable tensioning mechanism.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle braking system comprising...\",\n        \"A lever assembly configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69497", "text": "{\n    \"patent_title\": \"System and Method for Object Recognition in Video Streams\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for accurately recognizing objects in video streams. The system utilizes deep learning algorithms to identify and classify objects in real-time. This is applied to security surveillance, autonomous vehicles, and retail analytics.  The core innovation lies in the efficient processing of high-resolution video data for robust image recognition.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Method for Feature Extraction in Images\"\n        }\n    ],\n    \"claims\": [\n        \"A system for object recognition comprising...\",\n        \"A method for processing video streams...\",\n        \"A non-transitory computer-readable medium...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69497", "text": "{\n    \"patent_title\": \"Medical Image Analysis System using Deep Convolutional Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Medical Imaging Solutions\"\n        }\n    ],\n    \"patent_number\": \"US10243987B1\",\n    \"priority_date\": \"2017-11-22\",\n    \"filing_date\": \"2017-11-22\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A medical image analysis system for detecting anomalies in radiological images using deep convolutional neural networks. Specifically tailored for identifying tumors in MRI scans and CT scans. The system provides enhanced accuracy and efficiency in diagnostic procedures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Method for Image Segmentation in Medical Scans\"\n        },\n        {\n            \"patent_number\": \"US8987654B1\",\n            \"title\": \"System for Automated Tumor Detection\"\n        }\n    ],\n    \"claims\": [\n        \"A medical image analysis system...\",\n        \"A method for detecting anomalies in radiological images...\",\n        \"A computer-implemented method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69498", "text": "{\n    \"patent_title\": \"Miniature Pressure Sensor with Enhanced Sensitivity\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2021-05-10\",\n    \"filing_date\": \"2021-05-10\",\n    \"issue_date\": \"2023-02-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature pressure sensor with enhanced sensitivity and low power consumption is disclosed. The sensor utilizes a novel MEMS design and advanced signal processing techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B1\"\n        }\n    ],\n    \"claims\": [\n        \"Claim 1: A pressure sensor comprising...\",\n        \"Claim 2: The pressure sensor of claim 1, wherein...\",\n        \"Claim 3: The pressure sensor of claim 1, further comprising...\",\n        \"Claim 4: A method for manufacturing the pressure sensor...\",\n        \"Claim 5: A system incorporating the pressure sensor...\",\n        \"Claim 6: The system of claim 5, wherein...\",\n        \"Claim 7: The system of claim 5, further comprising...\",\n        \"Claim 8: A device including the pressure sensor...\",\n        \"Claim 9: The device of claim 8, wherein...\",\n        \"Claim 10: The device of claim 8, further comprising...\",\n        \"Claim 11: The device of claim 8, comprising a display\"\n    ]\n}"}
{"_id": "Academic--patents--n--69498", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved battery management system for electric vehicles.  This system optimizes charging and discharging cycles for extended battery life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"Claim 1: A battery management system comprising...\",\n        \"Claim 2: The battery management system of claim 1, wherein...\",\n        \"Claim 3: The battery management system of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69499", "text": "{\n    \"patent_title\": \"Method and System for Neural Network-Based Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for image recognition utilizing a deep neural network architecture. The system employs convolutional layers and backpropagation to achieve high accuracy in identifying objects within images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69499", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-11-20\",\n    \"filing_date\": \"2009-11-20\",\n    \"issue_date\": \"2018-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel data compression algorithm achieving higher compression ratios than existing methods. The algorithm utilizes a combination of Huffman coding and Lempel-Ziv techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"relevance\": \"Prior art in data compression\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising...\",\n        \"A system for data compression comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69500", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for image recognition using artificial intelligence techniques. The system utilizes convolutional neural networks to analyze images and identify objects with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for identifying objects in an image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69500", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Inc.\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Eve Foster\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-06-01\",\n    \"filing_date\": \"2019-12-20\",\n    \"issue_date\": \"2021-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved lithium-ion battery technology with enhanced energy density and cycle life for use in electric vehicles. The battery utilizes novel electrolyte compositions and electrode materials.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Previous work on lithium-ion batteries\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"A method for manufacturing a high-density battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69501", "text": "{\n    \"patent_title\": \"System and method for intelligent image recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for intelligent image recognition utilizing artificial intelligence techniques. The system employs convolutional neural networks to identify objects within images with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Prior Art Image Recognition System\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for identifying objects in an image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69501", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US10293847B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved bicycle brake system utilizing a novel cable tensioning mechanism for enhanced stopping power and rider safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Traditional Bicycle Brake Design\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle brake system comprising...\",\n        \"A cable tensioning mechanism for bicycles...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69502", "text": "{\n    \"patent_title\": \"Wireless Sensor Network for Air Quality Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless sensor network for monitoring air quality, including temperature, humidity, and pollutant levels. The sensors transmit data wirelessly to a central server for analysis and visualization.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Remote Sensing System\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor network comprising a plurality of sensor nodes...\",\n        \"A method for monitoring air quality using a wireless sensor network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69502", "text": "{\n    \"patent_title\": \"Medical Sensor for Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized sensor for continuous glucose monitoring in diabetic patients. The sensor measures glucose levels in interstitial fluid and transmits the data to a mobile device.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9012345B1\",\n            \"title\": \"Implantable Glucose Sensor\"\n        }\n    ],\n    \"claims\": [\n        \"A glucose sensor comprising a biocompatible housing...\",\n        \"A method for measuring glucose levels using an implantable sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69503", "text": "{\n    \"patent_title\": \"System and method for object recognition using convolutional neural networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for recognizing objects in images using convolutional neural networks. The system employs a deep learning architecture to achieve high accuracy and efficiency in image recognition tasks.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for recognizing objects in an image comprising...\",\n        \"A system for performing image recognition...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69503", "text": "{\n    \"patent_title\": \"Image recognition system for medical diagnosis\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2016-11-01\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An image recognition system designed for medical diagnosis, utilizing machine learning algorithms to identify anomalies in medical images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for diagnosing medical conditions based on image analysis...\",\n        \"A method for identifying anomalies in medical images...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69504", "text": "{\n    \"patent_title\": \"High-Performance Lithium-Ion Battery with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel lithium-ion battery design incorporating a new electrolyte formulation for improved stability and performance. The battery exhibits enhanced energy density and cycle life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte formulation for a lithium-ion battery...\",\n        \"A method for manufacturing a lithium-ion battery...\",\n        \"The lithium-ion battery according to claim 1, wherein...\",\n        \"The electrolyte formulation according to claim 2, wherein...\",\n        \"The method according to claim 3, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69504", "text": "{\n    \"patent_title\": \"Improved Lead-Acid Battery Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-10\",\n    \"filing_date\": \"2017-05-09\",\n    \"issue_date\": \"2020-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details improvements to lead-acid battery technology, focusing on electrode design and corrosion resistance. The design allows for longer lifespan and reduced maintenance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Relevant prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A lead-acid battery comprising...\",\n        \"An electrode design for a lead-acid battery...\",\n        \"A method for reducing corrosion in a lead-acid battery...\",\n        \"The lead-acid battery according to claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69505", "text": "{\n    \"patent_title\": \"System and method for image recognition using deep learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition using deep learning techniques. The system utilizes convolutional neural networks to analyze images and identify objects with high accuracy. Machine learning algorithms are employed to improve the system's performance over time.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a deep learning model...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69505", "text": "{\n    \"patent_title\": \"Improved Method for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"XYZ Corp\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel data compression algorithm that reduces file sizes without significant loss of information. This method uses Huffman coding and run-length encoding to achieve high compression ratios.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data comprising...\",\n        \"A system for decompressing data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69506", "text": "{\n    \"patent_title\": \"System and method for image recognition using deep convolutional neural networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition using deep convolutional neural networks is disclosed. The system utilizes a multi-layered architecture to extract features from images and classify them with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related Art\"\n        },\n        {\n            \"patent_number\": \"US9012345B2\",\n            \"relevance\": \"Cited by Examiner\"\n        },\n        {\n            \"patent_number\": \"US9234567B1\",\n            \"relevance\": \"Cited by Applicant\"\n        },\n        {\n            \"patent_number\": \"US9345678B2\",\n            \"relevance\": \"Related Art\"\n        },\n        {\n            \"patent_number\": \"US9456789B1\",\n            \"relevance\": \"Cited by Examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a deep convolutional neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69506", "text": "{\n    \"patent_title\": \"Method for object detection in video streams\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-10\",\n    \"filing_date\": \"2017-03-10\",\n    \"issue_date\": \"2020-05-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for detecting objects in real-time video streams using background subtraction and feature tracking.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"relevance\": \"Related Art\"\n        },\n        {\n            \"patent_number\": \"US9123456B1\",\n            \"relevance\": \"Cited by Examiner\"\n        },\n        {\n            \"patent_number\": \"US9234567B1\",\n            \"relevance\": \"Related Art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for object detection in video streams comprising...\",\n        \"A system for real-time video analysis...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69507", "text": "{\n    \"patent_title\": \"Microfluidic Device for Rapid Blood Analysis\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device for rapid and accurate analysis of blood samples, enabling point-of-care diagnostics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8652345B1\",\n            \"relevance\": \"Prior art in microfluidics\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A method for analyzing a blood sample...\",\n        \"The device of claim 1, wherein...\",\n        \"The method of claim 2, comprising...\",\n        \"The device of claim 3, further comprising...\",\n        \"The method of claim 2, wherein the analysis includes...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69507", "text": "{\n    \"patent_title\": \"Surgical Instrument with Enhanced Grip\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2016-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved surgical instrument providing enhanced grip and precision for surgeons.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related to surgical instrument design\"\n        }\n    ],\n    \"claims\": [\n        \"A surgical instrument comprising...\",\n        \"The instrument of claim 1, wherein...\",\n        \"A handle for the instrument...\",\n        \"A gripping mechanism...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69508", "text": "{\n    \"patent_title\": \"Neural Network Based Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition utilizing a deep neural network architecture. The system is capable of identifying objects in images with high accuracy and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Previous Image Recognition Method\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising a neural network.\",\n        \"A method for identifying objects in an image using a deep learning algorithm.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69508", "text": "{\n    \"patent_title\": \"Improved Battery Charging Circuit\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-05-20\",\n    \"issue_date\": \"2017-12-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel circuit design for improving the efficiency and lifespan of lithium-ion batteries. The circuit includes a dynamic voltage regulator and a temperature monitoring system.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"title\": \"Early Battery Charging Method\"\n        }\n    ],\n    \"claims\": [\n        \"A battery charging circuit comprising a voltage regulator.\",\n        \"A method for extending battery life using temperature monitoring.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69509", "text": "{\n    \"patent_title\": \"Lithium-ion Battery with Improved Thermal Management\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-15\",\n    \"issue_date\": \"2019-04-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery incorporating a novel thermal management system to improve performance and lifespan. The system utilizes a phase change material to regulate temperature during charging and discharging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Improved Electrode Material for Lithium-ion Batteries\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"A thermal management system for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69509", "text": "{\n    \"patent_title\": \"Solid Oxide Fuel Cell with Enhanced Efficiency\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2012-05-20\",\n    \"filing_date\": \"2012-05-20\",\n    \"issue_date\": \"2018-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A solid oxide fuel cell design incorporating a novel electrolyte material to improve efficiency and reduce operating temperature.  The fuel cell utilizes a hydrogen-rich fuel source.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Hydrogen Fuel Storage Method\"\n        },\n        {\n            \"patent_number\": \"US9012345B1\",\n            \"title\": \"Fuel Cell Catalyst Composition\"\n        }\n    ],\n    \"claims\": [\n        \"A solid oxide fuel cell comprising...\",\n        \"An electrolyte material for a fuel cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69510", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel electrode material for lithium-ion batteries, exhibiting enhanced energy density and cycle life. The material comprises a modified lithium metal oxide with improved structural stability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"kind\": \"Cited by Examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode material...\",\n        \"The electrode material of claim 1, wherein the material comprises a lithium metal oxide.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69510", "text": "{\n    \"patent_title\": \"Novel Solar Cell Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob White\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US8901234B1\",\n    \"priority_date\": \"2012-05-20\",\n    \"filing_date\": \"2012-05-20\",\n    \"issue_date\": \"2018-01-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a new architecture for solar cells, increasing efficiency and reducing manufacturing costs. The design incorporates a multi-layer semiconductor structure for optimal light absorption.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"kind\": \"Cited by Applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A solar cell comprising a multi-layer semiconductor structure...\",\n        \"The solar cell of claim 1, wherein the structure includes a perovskite layer.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69511", "text": "{\n    \"patent_title\": \"Neural Network Architecture for Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel artificial neural network architecture designed for efficient and accurate image recognition. The network utilizes a unique combination of convolutional and recurrent layers to achieve state-of-the-art performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"An apparatus for implementing the method...\",\n        \"A neural network architecture...\",\n        \"A system for classifying images...\",\n        \"A computer-readable medium...\",\n        \"A method for training the neural network...\",\n        \"An improved loss function...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69511", "text": "{\n    \"patent_title\": \"System for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2018-08-20\",\n    \"filing_date\": \"2019-11-05\",\n    \"issue_date\": \"2021-03-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a new method for compressing data using Huffman coding and run-length encoding. It achieves high compression ratios for various data types.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression...\",\n        \"An apparatus for implementing the method...\",\n        \"A data compression algorithm...\",\n        \"A system for storing compressed data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69512", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-05-15\",\n    \"filing_date\": \"2017-05-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for enhancing the resolution of images using deep learning techniques. The system utilizes a convolutional neural network trained on a large dataset of high-resolution images to predict high-frequency details for low-resolution images, resulting in improved image quality. The process involves advanced image processing algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760854B1\",\n            \"title\": \"Image Enhancement System\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising:...\",\n        \"A system for enhancing image resolution comprising:...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69512", "text": "{\n    \"patent_title\": \"Digital Image Stabilization Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"David Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9234876B1\",\n    \"priority_date\": \"2015-03-10\",\n    \"filing_date\": \"2015-03-10\",\n    \"issue_date\": \"2016-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"The invention relates to a digital image stabilization technique used to reduce blur in images captured by moving devices. The system analyzes frame-to-frame motion and applies corrective transformations to produce a stable output image. This utilizes advanced signal processing.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Motion Detection Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A digital image stabilization method comprising:...\",\n        \"An apparatus for digital image stabilization comprising:...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69513", "text": "{\n    \"patent_title\": \"System and Method for Image Recognition using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for accurate image recognition using deep learning techniques. It improves upon existing methods by utilizing a novel convolutional neural network architecture. The system can be applied to various applications, including object detection, facial recognition, and image classification.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for image recognition comprising...\",\n        \"2. The system of claim 1, wherein...\",\n        \"3. A method for image recognition comprising...\",\n        \"4. The method of claim 3, wherein...\",\n        \"5. A computer-readable medium...\",\n        \"6. The computer-readable medium of claim 5...\",\n        \"7. The system of claim 1, further comprising...\",\n        \"8. The method of claim 3, further comprising...\",\n        \"9. The system of claim 7, wherein...\",\n        \"10. The method of claim 8, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69513", "text": "{\n    \"patent_title\": \"Improved Image Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2020-01-05\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel image compression algorithm that achieves higher compression ratios with minimal loss of image quality. It utilizes wavelet transforms and entropy coding techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art in image compression\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for compressing an image comprising...\",\n        \"2. The method of claim 1, wherein...\",\n        \"3. An apparatus for compressing an image...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69514", "text": "{\n    \"patent_title\": \"Deep Learning for Image Recognition with Enhanced Accuracy\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2020-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel deep learning architecture for image recognition, achieving state-of-the-art accuracy on benchmark datasets. The system utilizes convolutional neural networks with improved regularization techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in convolutional neural networks\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"Related work on image classification\"\n        },\n        {\n            \"patent_number\": \"US11223344B2\",\n            \"relevance\": \"Techniques for improving model generalization\"\n        },\n        {\n            \"patent_number\": \"US12112233B2\",\n            \"relevance\": \"Dataset used for training and evaluation\"\n        },\n        {\n            \"patent_number\": \"US13113322B2\",\n            \"relevance\": \"Application of image recognition in autonomous vehicles\"\n        }\n    ],\n    \"claims\": [\n        \"A deep learning system for image recognition comprising...\",\n        \"A method for training a convolutional neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69514", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-05\",\n    \"issue_date\": \"2023-04-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new data compression algorithm achieving higher compression ratios with lower computational cost.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Previous data compression techniques\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related work on lossless data compression\"\n        },\n        {\n            \"patent_number\": \"US9765432B2\",\n            \"relevance\": \"Algorithms for efficient data encoding\"\n        }\n    ],\n    \"claims\": [\n        \"A data compression method comprising...\",\n        \"A system for encoding data using a novel algorithm...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69515", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Predictive Maintenance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-05-22\",\n    \"issue_date\": \"2019-01-29\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system and method for predicting equipment failure using artificial intelligence and machine learning algorithms. The system analyzes sensor data to identify patterns indicative of potential failures, enabling proactive maintenance and reducing downtime.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"title\": \"Data Analysis Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predictive maintenance comprising...\",\n        \"A method for analyzing sensor data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69515", "text": "{\n    \"patent_title\": \"Implantable Medical Device with AI Diagnostics\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MedTech Solutions\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2017-02-10\",\n    \"issue_date\": \"2018-08-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable medical device incorporating artificial intelligence for real-time diagnostics and treatment adjustment. The device monitors physiological parameters and provides personalized therapy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Implantable Cardiac Pacemaker\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"AI-based Diagnostic Systems\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable medical device comprising...\",\n        \"A method for diagnosing medical conditions...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69516", "text": "{\n    \"patent_title\": \"Method and System for AI-Powered Predictive Maintenance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2012-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for predictive maintenance utilizing artificial intelligence algorithms to analyze sensor data and predict equipment failure. This allows for proactive maintenance scheduling, reducing downtime and costs.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"System for Remote Monitoring of Industrial Equipment\"\n        }\n    ],\n    \"claims\": [\n        \"A method for predicting equipment failure...\",\n        \"A system comprising a sensor and a processor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69516", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Independent Inventor\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2009-11-20\",\n    \"filing_date\": \"2009-11-20\",\n    \"issue_date\": \"2011-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved bicycle brake system providing enhanced stopping power and reliability. The system utilizes a novel cable mechanism and brake pad material.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"title\": \"Bicycle Brake Lever Design\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle brake system comprising a lever...\",\n        \"A cable mechanism for transmitting force...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69517", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-15\",\n    \"issue_date\": \"2013-06-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for enhancing the resolution of digital images using deep learning techniques. The system analyzes low-resolution images and generates high-resolution counterparts with improved clarity and detail, applicable to various image processing tasks.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Image Enhancement Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution...\",\n        \"A system comprising a deep learning module...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69517", "text": "{\n    \"patent_title\": \"MRI Image Reconstruction using Compressed Sensing\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Johns Hopkins University\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2012-05-10\",\n    \"filing_date\": \"2012-05-10\",\n    \"issue_date\": \"2015-09-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method for reconstructing magnetic resonance images (MRI) using compressed sensing techniques, improving image quality and reducing scan time in medical imaging applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B2\",\n            \"title\": \"Medical Image Processing Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing MRI images...\",\n        \"A system for compressed sensing in MRI...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69518", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Wireless Communication Security\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a system and method for enhancing security in wireless communication networks. It utilizes a novel encryption scheme to protect data transmission and prevent unauthorized access.  The system improves security while maintaining high data throughput for seamless wireless communication.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Wireless Security Protocol\"\n        }\n    ],\n    \"claims\": [\n        \"A method for securing wireless communication comprising...\",\n        \"A system for implementing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69518", "text": "{\n    \"patent_title\": \"Advanced Signal Processing for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10246813B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an advanced signal processing technique for improving the performance of mobile devices in noisy environments.  It utilizes adaptive filtering and noise cancellation to enhance signal quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Noise Reduction Algorithm\"\n        }\n    ],\n    \"claims\": [\n        \"A signal processing system comprising...\",\n        \"A method for reducing noise in mobile communication...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69519", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Processing Using Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10456789B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-02-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for enhanced image processing using deep convolutional neural networks. The system significantly improves image quality and reduces noise, enabling more accurate object recognition. The method utilizes a novel architecture for training the neural network, improving performance over existing image processing techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing an image...\",\n        \"A system comprising a processor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69519", "text": "{\n    \"patent_title\": \"Improved Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2021-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a novel data compression algorithm based on Huffman coding and run-length encoding. The algorithm offers a significant improvement in compression ratio compared to existing methods.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data...\",\n        \"A system for decompressing data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69520", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Segmentation Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-05-15\",\n    \"issue_date\": \"2019-08-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method and system for enhanced image segmentation using deep learning techniques. It provides improved accuracy and efficiency in processing complex images for applications such as medical imaging and autonomous driving. The core utilizes a convolutional neural network trained on a large dataset of annotated images, employing a new loss function for optimizing segmentation performance. Image processing capabilities are greatly enhanced.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related prior art in image segmentation\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image segmentation comprising...\",\n        \"A system for performing image segmentation...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69520", "text": "{\n    \"patent_title\": \"Improved Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2019-03-10\",\n    \"filing_date\": \"2019-03-10\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved battery management system (BMS) for electric vehicles. The BMS optimizes battery charging and discharging to extend battery life and enhance vehicle performance. It utilizes advanced algorithms for cell balancing and thermal management. \",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Relevant prior art in battery management\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69521", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Chen\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved lithium-ion battery with a novel electrolyte formulation that enhances stability and increases cycle life. The battery utilizes a solid-state electrolyte and a high-capacity cathode material.  The invention also details a new cell architecture.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Lithium-Ion Battery with Polymer Electrolyte\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"The lithium-ion battery of claim 1, wherein...\",\n        \"An electrolyte formulation for a lithium-ion battery...\",\n        \"A method of manufacturing a lithium-ion battery...\",\n        \"A cell architecture for a lithium-ion battery...\",\n        \"The cell architecture of claim 5, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69521", "text": "{\n    \"patent_title\": \"Novel Lead-Acid Battery Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Charles Davis\",\n            \"affiliation\": \"Exide Technologies\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-08-20\",\n    \"filing_date\": \"2017-08-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention pertains to a new design for a lead-acid battery, improving its energy density and reducing manufacturing costs. The new design incorporates a novel grid structure and electrolyte composition.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Lead-Acid Battery with Improved Grid Structure\"\n        }\n    ],\n    \"claims\": [\n        \"A lead-acid battery comprising...\",\n        \"The lead-acid battery of claim 1, wherein...\",\n        \"A grid structure for a lead-acid battery...\",\n        \"A method of manufacturing a lead-acid battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69522", "text": "{\n    \"patent_title\": \"Neural Network Architecture for Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel neural network architecture for robust image recognition. This invention utilizes convolutional layers and recurrent networks to achieve state-of-the-art accuracy on benchmark datasets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"kind\": \"Cited by examiner\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for image recognition comprising...\",\n        \"2. The system of claim 1, wherein the neural network...\",\n        \"3. A method for training a neural network...\",\n        \"4. The method of claim 3, further comprising...\",\n        \"5. A computer-readable medium storing...\",\n        \"6. The computer-readable medium of claim 5, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69522", "text": "{\n    \"patent_title\": \"Improved Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2017-11-01\",\n    \"filing_date\": \"2017-11-01\",\n    \"issue_date\": \"2020-02-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved data compression algorithm that achieves higher compression ratios and faster processing times.\",\n    \"citations\": [],\n    \"claims\": [\n        \"1. A method for compressing data...\",\n        \"2. The method of claim 1, wherein the data is...\",\n        \"3. A system for decompressing data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69523", "text": "{\n    \"patent_title\": \"Improved Electrolyte Composition for Lithium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel electrolyte composition for lithium-ion batteries, enhancing energy density and cycle life. The electrolyte utilizes a unique blend of lithium salts and solvents, resulting in improved ionic conductivity and electrochemical stability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8236543B1\",\n            \"title\": \"Lithium Iron Phosphate Cathode Material\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrolyte...\",\n        \"The electrolyte of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69523", "text": "{\n    \"patent_title\": \"Advanced Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Motors\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2020-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A sophisticated battery management system (BMS) designed for electric vehicles, optimizing performance, safety, and longevity of lithium-ion battery packs.  The system incorporates advanced algorithms for cell balancing, thermal management, and fault detection.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Lithium-Ion Cell Balancing Techniques\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Battery Management System with Predictive Analytics\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising a processor...\",\n        \"The battery management system of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69524", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2018-03-01\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery management system for electric vehicles, improving efficiency and lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related art\"\n        }\n    ],\n    \"claims\": [\n        \"Claim 1: A battery management system...\",\n        \"Claim 2: The system of claim 1...\",\n        \"Claim 3: A method for managing a battery...\",\n        \"Claim 4: The method of claim 3...\",\n        \"Claim 5: A computer-readable medium...\",\n        \"Claim 6: The medium of claim 5...\",\n        \"Claim 7: The system of claim 1, further comprising...\"\n    ]\n}"}
