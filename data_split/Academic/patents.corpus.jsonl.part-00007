{"_id": "Academic--patents--p--66585", "text": "{\n    \"patent_title\": \"Deep Learning-Based Image Enhancement System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel image enhancement system leveraging deep learning techniques to improve image quality and resolution. The system utilizes convolutional neural networks for artifact reduction and detail enhancement.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image using a deep learning model.\",\n        \"The method of claim 1, wherein the deep learning model is a convolutional neural network.\",\n        \"The method of claim 1, further comprising a pre-processing step to remove noise from the image.\",\n        \"The method of claim 1, further comprising a post-processing step to sharpen the image.\",\n        \"A system for enhancing an image according to claim 1.\",\n        \"The system of claim 5, comprising a processor and a memory storing the deep learning model.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66585", "text": "{\n    \"patent_title\": \"Improved Image Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-05-01\",\n    \"filing_date\": \"2020-01-25\",\n    \"issue_date\": \"2021-11-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a new image compression algorithm based on wavelet transforms. It achieves high compression ratios with minimal loss of image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image using wavelet transforms.\",\n        \"The method of claim 1, wherein the wavelet transforms are Daubechies wavelets.\",\n        \"The method of claim 1, further comprising a quantization step.\",\n        \"The method of claim 1, further comprising an entropy encoding step.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66586", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-14\",\n    \"issue_date\": \"2013-09-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing image recognition accuracy using deep learning techniques. The system processes images to identify objects and patterns with improved precision.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Image Processing Algorithm\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"title\": \"Neural Network Architecture\"\n        },\n        {\n            \"patent_number\": \"US9123456B1\",\n            \"title\": \"Object Detection System\"\n        },\n        {\n            \"patent_number\": \"US10234567B2\",\n            \"title\": \"Image Feature Extraction\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image recognition accuracy comprising...\",\n        \"A system for processing images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66586", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2012-05-10\",\n    \"filing_date\": \"2012-05-09\",\n    \"issue_date\": \"2015-11-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system designed to optimize energy storage and prolong battery life in electronic devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"Battery Cell Technology\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Charging Circuit Design\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system...\",\n        \"A method for optimizing battery performance...\"\n    ]\n}"}
