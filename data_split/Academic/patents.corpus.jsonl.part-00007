{"_id": "Academic--patents--p--66716", "text": "{\n    \"patent_title\": \"Method and System for Automated Machine Learning Model Selection\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a method and system for automatically selecting the optimal machine learning model for a given dataset. The system utilizes artificial intelligence techniques to evaluate various models and identify the one that provides the highest accuracy and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8769021\"\n        }\n    ],\n    \"claims\": [\n        \"A method for automated machine learning model selection.\",\n        \"A system comprising a processor and memory for implementing the method.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66716", "text": "{\n    \"patent_title\": \"Improved Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        },\n        {\n            \"name\": \"Yoshua Bengio\",\n            \"affiliation\": \"University of Montreal\"\n        }\n    ],\n    \"patent_number\": \"US10234567\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-03-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved image recognition system based on convolutional neural networks. It achieves state-of-the-art results on benchmark datasets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456\"\n        }\n    ],\n    \"claims\": [\n        \"An image recognition system comprising a convolutional neural network.\",\n        \"A method for training the convolutional neural network.\"\n    ]\n}"}
