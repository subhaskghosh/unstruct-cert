{"_id": "Academic--patents--p--66520", "text": "{\n    \"patent_title\": \"Neural Abstractive Summarization with Attention\",\n    \"inventors\": [\n        {\n            \"name\": \"Christopher Manning\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Percy Liang\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for generating abstractive summaries of text using a neural attention mechanism.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8786654B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for generating an abstractive summary of a text document.\",\n        \"The method of claim 1, wherein the abstractive summary is generated using a neural network.\"\n    ]\n}"}
