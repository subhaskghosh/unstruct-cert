{"_id": "Academic--patents--p--69211", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a miniature wireless pressure sensor system for remote monitoring applications. The sensor utilizes MEMS technology to provide high accuracy and low power consumption.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising...\",\n        \"A method for remote monitoring using the sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69211", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10293847B1\",\n    \"priority_date\": \"2017-03-22\",\n    \"filing_date\": \"2017-03-22\",\n    \"issue_date\": \"2020-04-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel lithium-ion battery with enhanced energy density and cycle life. It employs a new electrolyte composition for improved performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition for enhancing battery performance...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69212", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2020-07-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for improving the resolution of digital images using a novel super-resolution algorithm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Enhancement Technique\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Digital Image Processing System\"\n        },\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Resolution Enhancement Algorithm\"\n        },\n        {\n            \"patent_number\": \"US6543210B2\",\n            \"title\": \"Image Sharpening Method\"\n        },\n        {\n            \"patent_number\": \"US5432109B1\",\n            \"title\": \"Noise Reduction in Images\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing the resolution of a digital image...\",\n        \"A system for processing digital images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69212", "text": "{\n    \"patent_title\": \"Novel Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11223344B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-01-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new algorithm for compressing data efficiently.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US12345678B2\",\n            \"title\": \"Data Compression Method\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Information Encoding Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69213", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Detail Using Adaptive Filtering\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for enhancing the detail in digital images using an adaptive filtering technique. The system analyzes image characteristics to dynamically adjust filter parameters, resulting in improved clarity and reduced noise. This is applicable to various image processing tasks, including security and surveillance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image detail comprising...\",\n        \"A system for processing images...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69213", "text": "{\n    \"patent_title\": \"Medical Image Reconstruction Technique Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-03-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel deep learning approach for reconstructing high-quality images from medical scanning data, such as MRI and CT scans. The method significantly improves image resolution and reduces artifacts, aiding in accurate diagnoses.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"type\": \"related\"\n        },\n        {\n            \"patent_number\": \"US8901234B1\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for reconstructing medical images using a deep neural network...\",\n        \"A system for processing medical imaging data...\",\n        \"A computer program for image reconstruction...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69214", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition utilizing artificial intelligence techniques, specifically convolutional neural networks, to analyze and classify images with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for classifying images...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69214", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Samsung\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-12-01\",\n    \"filing_date\": \"2009-12-01\",\n    \"issue_date\": \"2018-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery design enhancing energy density and lifespan for portable electronic devices. Utilizing advanced material science principles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising...\",\n        \"A method for manufacturing a battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69215", "text": "{\n    \"patent_title\": \"Wireless Sensor Network for Structural Health Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless sensor network is disclosed for monitoring the structural health of bridges and buildings. The system utilizes low-power sensors to detect strain, vibration, and temperature changes. Data is transmitted wirelessly to a central server for analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8543210B2\",\n            \"title\": \"Method for Detecting Structural Defects\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor network comprising...\",\n        \"A method for monitoring structural health...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69215", "text": "{\n    \"patent_title\": \"Implantable Medical Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2019-10-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable medical sensor is disclosed for monitoring physiological parameters within the human body. The sensor utilizes wireless communication to transmit data to an external device.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Pacemaker with Remote Monitoring Capabilities\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"title\": \"Implantable Glucose Sensor\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable sensor comprising...\",\n        \"A method for monitoring physiological parameters...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69216", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Electrolyte Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-10\",\n    \"filing_date\": \"2011-05-09\",\n    \"issue_date\": \"2019-07-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a lithium-ion battery with an improved electrolyte composition that enhances stability and cycle life. The battery utilizes a novel additive to suppress dendrite formation and improve safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Lithium Ion Battery Electrode\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition for a lithium-ion battery...\",\n        \"A method of manufacturing a lithium-ion battery...\",\n        \"The battery of claim 1, further comprising...\",\n        \"The electrolyte composition of claim 2, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69216", "text": "{\n    \"patent_title\": \"Improved Lead-Acid Battery Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Motors\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2012-03-15\",\n    \"filing_date\": \"2012-03-14\",\n    \"issue_date\": \"2018-05-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel design for lead-acid batteries, focusing on improved plate geometry and electrolyte flow. It results in increased power output and longer lifespan compared to conventional lead-acid batteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"title\": \"Lead Acid Battery with Enhanced Performance\"\n        }\n    ],\n    \"claims\": [\n        \"A lead-acid battery comprising...\",\n        \"A battery plate design for a lead-acid battery...\",\n        \"A method of assembling a lead-acid battery...\",\n        \"The battery of claim 1, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69217", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-06-15\",\n    \"issue_date\": \"2021-02-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for biomedical applications. The system utilizes a novel MEMS sensor and low-power communication protocol.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for measuring pressure using said system...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69217", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2021-03-10\",\n    \"filing_date\": \"2021-04-10\",\n    \"issue_date\": \"2022-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved lithium-ion battery technology for use in electric vehicles, offering enhanced energy density and lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery cell comprising...\",\n        \"A method for manufacturing said battery cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69218", "text": "{\n    \"patent_title\": \"Method and System for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method and system for image recognition using artificial intelligence techniques, specifically convolutional neural networks. The system achieves high accuracy and efficiency in identifying objects within images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for image recognition comprising...\",\n        \"2. The method of claim 1, wherein...\",\n        \"3. A system for image recognition comprising...\",\n        \"4. The system of claim 3, wherein...\",\n        \"5. The method of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69218", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2014-11-01\",\n    \"filing_date\": \"2014-11-01\",\n    \"issue_date\": \"2017-05-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved battery management system for electric vehicles, enhancing safety and lifespan. It utilizes advanced algorithms for charge control and temperature regulation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\"\n        }\n    ],\n    \"claims\": [\n        \"1. A battery management system comprising...\",\n        \"2. The system of claim 1, wherein...\",\n        \"3. A method for controlling battery charge comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69219", "text": "{\n    \"patent_title\": \"High-Performance Lithium-Ion Battery with Enhanced Electrolyte\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery design featuring a modified electrolyte composition for improved performance and cycle life. The battery exhibits enhanced energy density and faster charging rates.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69219", "text": "{\n    \"patent_title\": \"Advanced Sodium-Ion Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Georgia Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-11-22\",\n    \"filing_date\": \"2017-11-22\",\n    \"issue_date\": \"2019-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A sodium-ion battery technology offering a cost-effective alternative to lithium-ion batteries. The design focuses on utilizing abundant sodium resources for sustainable energy storage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A sodium-ion battery comprising...\",\n        \"An electrode material for a sodium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69220", "text": "{\n    \"patent_title\": \"Miniature Pressure Sensor with Integrated Signal Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature pressure sensor integrated with signal processing circuitry for industrial automation and environmental monitoring. The sensor exhibits high sensitivity and low power consumption.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"field\": \"Industrial Automation\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"field\": \"Environmental Monitoring\"\n        }\n    ],\n    \"claims\": [\n        \"A pressure sensor comprising...\",\n        \"A signal processing circuit...\",\n        \"A method for measuring pressure...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69220", "text": "{\n    \"patent_title\": \"Biosensor for Glucose Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"BioTech Solutions Ltd.\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10246813B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2020-07-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel biosensor for continuous glucose monitoring in diabetic patients. The sensor utilizes enzymatic reactions to detect glucose levels in bodily fluids.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"field\": \"Medical Diagnostics\"\n        },\n        {\n            \"patent_number\": \"US8654321B1\",\n            \"field\": \"Medical Devices\"\n        }\n    ],\n    \"claims\": [\n        \"A biosensor for glucose monitoring comprising...\",\n        \"An enzymatic reaction module...\",\n        \"A method for measuring glucose...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69221", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Predictive Maintenance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2018-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for predictive maintenance using artificial intelligence algorithms to analyze sensor data and predict equipment failures. The system improves efficiency and reduces downtime in industrial settings.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art in sensor data analysis\"\n        }\n    ],\n    \"claims\": [\n        \"A system for predictive maintenance comprising a sensor data acquisition module, an artificial intelligence processing module, and an alert generation module.\",\n        \"A method for predicting equipment failures using artificial intelligence algorithms.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69221", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"CycleTech Corp.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-12-20\",\n    \"filing_date\": \"2014-12-20\",\n    \"issue_date\": \"2017-08-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an improved bicycle brake system utilizing a novel cable tensioning mechanism. It offers enhanced braking performance and reliability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in bicycle braking systems\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle brake system comprising a brake lever, a cable, and a braking mechanism.\",\n        \"A cable tensioning mechanism for a bicycle brake.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69222", "text": "{\n    \"patent_title\": \"System and method for image-based object recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image-based object recognition using deep convolutional neural networks. The system accurately identifies objects within images and provides real-time analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in image processing\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for image recognition comprising...\",\n        \"2. The method of claim 1, wherein...\",\n        \"3. A system for performing the method of claim 1...\",\n        \"4. The system of claim 3, further comprising...\",\n        \"5. A non-transitory computer-readable medium storing...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69222", "text": "{\n    \"patent_title\": \"Improved Method for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US9123456B1\",\n    \"priority_date\": \"2015-12-10\",\n    \"filing_date\": \"2015-12-10\",\n    \"issue_date\": \"2018-08-07\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel data compression algorithm that reduces file size without significant loss of information. The method utilizes a combination of Huffman coding and Lempel-Ziv techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Previous work on data compression\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for data compression comprising...\",\n        \"2. The method of claim 1, wherein...\",\n        \"3. A system for performing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69223", "text": "{\n    \"patent_title\": \"Enhanced Lithium-Ion Battery with Improved Cycle Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-06-15\",\n    \"issue_date\": \"2018-03-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved lithium-ion battery with enhanced cycle life and increased energy density. The battery incorporates a novel electrolyte formulation and electrode materials to improve performance and stability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Lithium-Ion Battery Electrode Material\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte formulation for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69223", "text": "{\n    \"patent_title\": \"Novel Solar Cell Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876544B2\",\n    \"priority_date\": \"2016-07-22\",\n    \"filing_date\": \"2016-08-01\",\n    \"issue_date\": \"2018-04-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a new solar cell design utilizing perovskite materials for increased efficiency. The cell incorporates a unique light-trapping structure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765433B1\",\n            \"title\": \"Perovskite Solar Cell Manufacturing\"\n        }\n    ],\n    \"claims\": [\n        \"A solar cell comprising...\",\n        \"A light-trapping structure for a solar cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69224", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Battery Management\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-10\",\n    \"filing_date\": \"2015-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhanced battery management in electric vehicles. The system dynamically adjusts charging rates and monitors cell health to maximize battery lifespan and performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in battery monitoring\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69224", "text": "{\n    \"patent_title\": \"Improved Mobile Phone Battery Life\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Apple Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2009-11-20\",\n    \"filing_date\": \"2010-05-18\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for extending the battery life of mobile phones by optimizing application usage.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A mobile device with extended battery life...\"\n    ]\n}"}
