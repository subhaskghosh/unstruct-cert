{"_id": "Academic--patents--p--69280", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Data Security\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-06-15\",\n    \"issue_date\": \"2018-12-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing data security using advanced encryption techniques. The system provides secure data storage and transmission, protecting sensitive information from unauthorized access.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Data Encryption Method\"\n        }\n    ],\n    \"claims\": [\n        \"Claim 1: A system for encrypting data...\",\n        \"Claim 2: A method for decrypting data...\",\n        \"Claim 3: A computer-readable medium storing instructions...\",\n        \"Claim 4: A network device comprising...\",\n        \"Claim 5: The system of claim 1, wherein...\",\n        \"Claim 6: The method of claim 2, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69280", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10246813B1\",\n    \"priority_date\": \"2017-03-10\",\n    \"filing_date\": \"2017-04-10\",\n    \"issue_date\": \"2019-01-29\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery technology offering improved energy density and lifespan. This invention utilizes new materials and cell designs for enhanced performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Lithium-Ion Battery Design\"\n        }\n    ],\n    \"claims\": [\n        \"Claim 1: A battery cell comprising...\",\n        \"Claim 2: The battery cell of claim 1, wherein...\",\n        \"Claim 3: A battery pack including...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69281", "text": "{\n    \"patent_title\": \"Method for High-Throughput Drug Screening\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Genentech\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-05-15\",\n    \"filing_date\": \"2010-03-20\",\n    \"issue_date\": \"2019-07-02\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for high-throughput drug screening utilizing microfluidic devices and automated image analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"prior art\"\n        },\n        {\n            \"patent_number\": \"US8123456B2\",\n            \"relevance\": \"related application\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"similar approach\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"alternative method\"\n        },\n        {\n            \"patent_number\": \"US11123456B2\",\n            \"relevance\": \"improves upon\"\n        }\n    ],\n    \"claims\": [\n        \"A method for screening compounds...\",\n        \"A microfluidic device for drug screening...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69281", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Acme Corp\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2011-11-01\",\n    \"filing_date\": \"2012-05-10\",\n    \"issue_date\": \"2018-01-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved bicycle brake system providing enhanced stopping power and modulation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"relevance\": \"prior art\"\n        },\n        {\n            \"patent_number\": \"US7432109B2\",\n            \"relevance\": \"related application\"\n        },\n        {\n            \"patent_number\": \"US8321098B1\",\n            \"relevance\": \"similar design\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle brake system comprising...\",\n        \"A brake lever adapted for...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69282", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Resolution using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US10234567B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-08-20\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"US Patent and Trademark Office\",\n    \"abstract\": \"A method and system for enhancing the resolution of images using deep convolutional neural networks. The system learns to reconstruct high-resolution images from low-resolution inputs, improving image quality and detail.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Super-Resolution with Generative Adversarial Networks\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Deep Learning for Image Recognition\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Convolutional Neural Networks for Image Processing\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Image Enhancement Techniques\"\n        },\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"title\": \"Digital Image Processing Algorithms\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution...\",\n        \"A system comprising a deep neural network...\",\n        \"The method of claim 1, wherein the deep neural network is a convolutional neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69282", "text": "{\n    \"patent_title\": \"Digital Image Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11223344B2\",\n    \"priority_date\": \"2019-01-05\",\n    \"filing_date\": \"2019-04-10\",\n    \"issue_date\": \"2021-07-20\",\n    \"patent_office\": \"US Patent and Trademark Office\",\n    \"abstract\": \"A novel technique for compressing digital images, reducing file size while maintaining acceptable image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Compression using Wavelet Transforms\"\n        },\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Lossy Image Compression Methods\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a digital image...\",\n        \"A system for implementing the compression method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69283", "text": "{\n    \"patent_title\": \"Method and System for Neural Network Based Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for image recognition utilizing a novel neural network architecture. The system improves accuracy and efficiency in identifying objects within images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition using a neural network...\",\n        \"A system comprising a neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69283", "text": "{\n    \"patent_title\": \"Advanced Control Systems for Robotics\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"California Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Carnegie Mellon University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-08-20\",\n    \"filing_date\": \"2017-08-20\",\n    \"issue_date\": \"2020-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides improved control algorithms for robotic systems, enhancing precision and responsiveness. The system integrates feedback loops and predictive modeling for optimal performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A control system for a robotic device...\",\n        \"A method for optimizing robotic movement...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69284", "text": "{\n    \"patent_title\": \"Method and System for AI-Powered Predictive Maintenance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-03-15\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for predictive maintenance utilizing artificial intelligence algorithms to analyze sensor data and predict equipment failures.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Related prior art on sensor data analysis.\"\n        }\n    ],\n    \"claims\": [\n        \"A method for predicting equipment failure comprising: collecting sensor data...\",\n        \"A system for predictive maintenance...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69284", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Garcia\",\n            \"affiliation\": \"Tesla\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-12-10\",\n    \"filing_date\": \"2018-02-01\",\n    \"issue_date\": \"2021-05-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents an improved battery management system for electric vehicles, optimizing charging and discharging processes to extend battery life and improve performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10112233B1\",\n            \"relevance\": \"Related prior art on battery charging algorithms.\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising: a voltage monitoring circuit...\",\n        \"A method for optimizing battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69285", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2022-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery management system that improves efficiency and lifespan.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"relevance\": \"similar\"\n        },\n        {\n            \"patent_number\": \"US11223344B1\",\n            \"relevance\": \"relevant\"\n        },\n        {\n            \"patent_number\": \"US12131415B2\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US13141516B1\",\n            \"relevance\": \"similar\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"The system of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69285", "text": "{\n    \"patent_title\": \"Novel Solar Panel Design\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2021-01-10\",\n    \"filing_date\": \"2021-03-01\",\n    \"issue_date\": \"2023-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new solar panel design improving energy absorption.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US99887766B2\",\n            \"relevance\": \"similar\"\n        },\n        {\n            \"patent_number\": \"US10112233B1\",\n            \"relevance\": \"relevant\"\n        }\n    ],\n    \"claims\": [\n        \"A solar panel comprising...\",\n        \"The panel of claim 1, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69286", "text": "{\n    \"patent_title\": \"High-Performance Lithium-Ion Battery with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10500000B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2020-11-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel lithium-ion battery design incorporating a new electrolyte material and electrode structure for improved performance and stability. The battery exhibits higher energy density and longer cycle life compared to conventional lithium-ion batteries.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8808940B2\",\n            \"title\": \"Lithium Ion Battery Cathode Materials\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"The battery of claim 1, wherein...\",\n        \"An electrolyte composition for use in a lithium-ion battery...\",\n        \"A method of manufacturing a lithium-ion battery...\",\n        \"The method of claim 4, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69286", "text": "{\n    \"patent_title\": \"Improved Fuel Cell Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Caltech\"\n        }\n    ],\n    \"patent_number\": \"US9771888B2\",\n    \"priority_date\": \"2017-06-20\",\n    \"filing_date\": \"2017-06-20\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a new fuel cell architecture with enhanced proton exchange membrane performance. The design incorporates a novel gas diffusion layer and improved flow field geometry.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7544330B2\",\n            \"title\": \"Fuel Cell System\"\n        }\n    ],\n    \"claims\": [\n        \"A fuel cell comprising...\",\n        \"The fuel cell of claim 1, wherein...\",\n        \"A gas diffusion layer for use in a fuel cell...\",\n        \"A method of operating a fuel cell...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69287", "text": "{\n    \"patent_title\": \"Method and System for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2019-06-15\",\n    \"issue_date\": \"2021-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method and system for enhancing image recognition accuracy using artificial intelligence and deep learning techniques. It improves upon existing algorithms by incorporating a novel convolutional neural network architecture.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69287", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US87654321B2\",\n    \"priority_date\": \"2018-03-10\",\n    \"filing_date\": \"2018-04-10\",\n    \"issue_date\": \"2020-09-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved battery management system for electric vehicles, enhancing battery life and safety. It utilizes advanced algorithms for charge control and thermal management.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10112233B1\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling battery charge...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69288", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Processing Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-03-15\",\n    \"filing_date\": \"2020-05-20\",\n    \"issue_date\": \"2022-12-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel method and system for enhancing image processing capabilities utilizing deep learning algorithms. The system is capable of improving image resolution, reducing noise, and performing object recognition with high accuracy. Specifically, it employs convolutional neural networks for feature extraction and image reconstruction, resulting in significant improvements over existing image processing techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Previous Image Enhancement Method\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising...\",\n        \"A system for processing images using deep learning...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69288", "text": "{\n    \"patent_title\": \"Novel Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"IBM Research\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2021-01-05\",\n    \"filing_date\": \"2021-08-12\",\n    \"issue_date\": \"2023-05-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a new algorithm for compressing digital data, achieving higher compression ratios with minimal loss of information. The algorithm utilizes a combination of Huffman coding and Lempel-Ziv variations to optimize data storage and transmission.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Prior Art Compression Technique\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing data comprising...\",\n        \"A system for efficient data storage...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69289", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Processing using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for enhancing image processing capabilities utilizing deep learning algorithms. The system improves image resolution and clarity, enabling more accurate object detection and analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising...\",\n        \"A system for processing images comprising...\",\n        \"The method of claim 1, wherein the deep learning algorithm is a convolutional neural network.\",\n        \"The system of claim 2, further comprising a user interface.\",\n        \"A non-transitory computer-readable medium storing instructions…\"\n    ]\n}"}
{"_id": "Academic--patents--n--69289", "text": "{\n    \"patent_title\": \"Digital Image Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Green\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-11-01\",\n    \"filing_date\": \"2009-11-01\",\n    \"issue_date\": \"2017-05-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a novel digital image compression technique that reduces file size without significant loss of image quality.  The method uses a wavelet transform and quantization.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing a digital image comprising...\",\n        \"A system for compressing digital images comprising...\",\n        \"The method of claim 1, wherein the wavelet transform is a Daubechies wavelet.\",\n        \"The system of claim 2, further comprising a memory module.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69290", "text": "{\n    \"patent_title\": \"System and Method for Object Recognition Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition utilizing deep convolutional neural networks. The system processes images to identify objects with high accuracy. Applications include autonomous vehicles and security systems.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Method for Feature Extraction in Images\"\n        }\n    ],\n    \"claims\": [\n        \"A method for identifying objects in an image comprising...\",\n        \"A system for image recognition...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69290", "text": "{\n    \"patent_title\": \"Medical Image Analysis System Using Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Williams\",\n            \"affiliation\": \"Mayo Clinic\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"GE Healthcare\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-09-22\",\n    \"filing_date\": \"2017-09-22\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A medical image analysis system employing convolutional neural networks to detect anomalies in medical scans. The system improves diagnostic accuracy and efficiency in healthcare settings. This invention uses image recognition for healthcare diagnostics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Method for Detecting Tumors in MRI Images\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"System for Automated X-Ray Analysis\"\n        }\n    ],\n    \"claims\": [\n        \"A method for analyzing medical images comprising...\",\n        \"A system for detecting anomalies in medical scans...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69291", "text": "{\n    \"patent_title\": \"System and method for AI-powered image recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition using artificial intelligence algorithms. The system utilizes convolutional neural networks to identify objects within images with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for identifying objects in an image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69291", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corp\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Independent\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-05-20\",\n    \"issue_date\": \"2018-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved braking system for bicycles, providing increased stopping power and reliability. Features include a novel caliper design and enhanced brake pad material.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle braking system comprising...\",\n        \"A caliper assembly for a bicycle brake...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69292", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2023-03-15\",\n    \"filing_date\": \"2023-03-15\",\n    \"issue_date\": \"2024-01-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to novel electrode materials for lithium-ion batteries, exhibiting improved energy density and cycle life. The materials comprise a modified lithium metal oxide composition.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US87654321B1\",\n            \"relevance\": \"Related prior art in lithium-ion battery technology\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrode material...\",\n        \"A method for manufacturing...\",\n        \"The battery of claim 1, wherein...\",\n        \"The electrode material of claim 2, wherein...\",\n        \"The method of claim 3, comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69292", "text": "{\n    \"patent_title\": \"Novel Polymer Electrolyte for Lithium Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2022-11-01\",\n    \"filing_date\": \"2022-11-01\",\n    \"issue_date\": \"2023-06-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a new polymer electrolyte for lithium batteries with enhanced ionic conductivity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"Prior art related to polymer electrolytes\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium battery comprising a polymer electrolyte...\",\n        \"The electrolyte of claim 1, wherein...\",\n        \"A method for using the electrolyte...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69293", "text": "{\n    \"patent_title\": \"Wireless Sensor Network for Industrial Monitoring\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of Engineering\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-03-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless sensor network for monitoring temperature, pressure, and vibration in industrial machinery. The system utilizes low-power sensors and a mesh network topology for reliable data transmission. This invention improves efficiency and reduces downtime in manufacturing processes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor network comprising a plurality of sensor nodes.\",\n        \"A method for monitoring industrial machinery using a wireless sensor network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69293", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Medical Innovations Corp.\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2012-08-20\",\n    \"filing_date\": \"2012-08-20\",\n    \"issue_date\": \"2020-05-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor that continuously monitors blood glucose levels and wirelessly transmits the data to a receiver. The device is designed for use by diabetic patients to manage their condition.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable glucose sensor comprising a sensing element.\",\n        \"A system for monitoring blood glucose levels wirelessly.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69294", "text": "{\n    \"patent_title\": \"Neural Network Based Image Recognition System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2018-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image recognition system utilizing a deep convolutional neural network for improved accuracy and efficiency. The system is trained on a large dataset of labeled images and demonstrates state-of-the-art performance on benchmark datasets.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for training a neural network...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69294", "text": "{\n    \"patent_title\": \"Improved Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"EP2345678A1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2017-11-20\",\n    \"issue_date\": \"2019-01-05\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"This invention describes a new algorithm for lossless data compression, achieving higher compression ratios than existing methods. The algorithm utilizes advanced entropy encoding techniques.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"related work\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising...\",\n        \"A system for encoding data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69295", "text": "{\n    \"patent_title\": \"Method and System for Neural Network-Based Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2019-02-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for image recognition using a deep neural network. The system comprises an input layer, multiple hidden layers, and an output layer, trained to classify images with high accuracy. The neural network architecture includes convolutional layers and pooling layers.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Image Processing System\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for image recognition comprising...\",\n        \"2. The method of claim 1, wherein the neural network...\",\n        \"3. A system for performing image recognition...\",\n        \"4. The system of claim 3, further comprising...\",\n        \"5. The method of claim 1, wherein the input image...\",\n        \"6. The system of claim 3, wherein the output is a classification label...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69295", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-05-20\",\n    \"issue_date\": \"2018-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system for electric vehicles, providing improved charge control and longevity. The system monitors cell voltage, temperature, and current to optimize battery performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234B2\",\n            \"title\": \"Battery Monitoring Device\"\n        }\n    ],\n    \"claims\": [\n        \"1. A battery management system comprising...\",\n        \"2. The system of claim 1, wherein the monitoring...\",\n        \"3. A method for managing battery charge...\",\n        \"4. The method of claim 3, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69296", "text": "{\n    \"patent_title\": \"System and Method for Image Recognition Using Deep Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition utilizing deep convolutional neural networks. The system identifies objects within images with high accuracy and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"kind\": \"Cited by Applicant\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for identifying objects in an image...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69296", "text": "{\n    \"patent_title\": \"Advanced Image Processing Techniques for Medical Imaging\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Mayo Clinic\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"University of Michigan\"\n        },\n        {\n            \"name\": \"Eve Franklin\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-12-01\",\n    \"filing_date\": \"2009-12-01\",\n    \"issue_date\": \"2018-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides novel image processing techniques for enhancing the clarity and diagnostic accuracy of medical images. Methods for noise reduction and contrast enhancement are described.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B2\",\n            \"kind\": \"Cited by Examiner\"\n        }\n    ],\n    \"claims\": [\n        \"A method for processing medical images comprising...\",\n        \"An apparatus for improving image quality...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69297", "text": "{\n    \"patent_title\": \"Method and System for Dynamic Resource Allocation\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of Tech\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Innovative Solutions Inc.\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2017-12-15\",\n    \"filing_date\": \"2018-02-10\",\n    \"issue_date\": \"2020-05-26\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for dynamically allocating resources in a distributed computing environment to optimize performance and efficiency. The system utilizes machine learning algorithms to predict resource demands and adjust allocations accordingly.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for dynamically allocating resources...\",\n        \"A system comprising a processor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69297", "text": "{\n    \"patent_title\": \"Improved Battery Electrode Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Materials Research Lab\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"Green Energy Corp\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2017-11-20\",\n    \"filing_date\": \"2018-03-01\",\n    \"issue_date\": \"2019-11-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel electrode material for lithium-ion batteries is described, exhibiting enhanced energy density and cycle life. The material is composed of a unique alloy structure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"An electrode material comprising...\",\n        \"A lithium-ion battery including...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69298", "text": "{\n    \"patent_title\": \"System and method for personalized recommendation using machine learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google Inc.\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for providing personalized recommendations to users based on machine learning algorithms. The system analyzes user data and preferences to predict items of interest.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art in recommendation systems\"\n        }\n    ],\n    \"claims\": [\n        \"1. A system for providing personalized recommendations, comprising...\",\n        \"2. The system of claim 1, wherein the machine learning algorithm is a neural network.\",\n        \"3. A method for generating personalized recommendations...\",\n        \"4. The method of claim 3, further comprising...\",\n        \"5. The system of claim 1, wherein user data includes purchase history.\",\n        \"6. The system of claim 1, wherein user data includes browsing history.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69298", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Independent Inventor\"\n        }\n    ],\n    \"patent_number\": \"US10246813B1\",\n    \"priority_date\": \"2017-08-20\",\n    \"filing_date\": \"2017-08-20\",\n    \"issue_date\": \"2019-03-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved bicycle brake system utilizing a novel cable tensioning mechanism for enhanced stopping power and reliability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related to bicycle braking systems\"\n        }\n    ],\n    \"claims\": [\n        \"1. A bicycle brake system comprising...\",\n        \"2. The brake system of claim 1, wherein the cable tensioning mechanism...\",\n        \"3. A method for adjusting the tension of a bicycle brake cable...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69299", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Processing in Aerial Photography\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-05-20\",\n    \"issue_date\": \"2018-07-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing image processing in aerial photography, utilizing advanced algorithms to improve clarity and detail. The system includes a high-resolution camera, a processing unit, and a display interface.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"title\": \"Image Stabilization Techniques\"\n        },\n        {\n            \"patent_number\": \"US8987654B2\",\n            \"title\": \"Aerial Data Acquisition Systems\"\n        }\n    ],\n    \"claims\": [\n        \"A system for enhanced image processing comprising...\",\n        \"A method for improving image clarity in aerial photography...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69299", "text": "{\n    \"patent_title\": \"Medical Image Analysis System for Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10123456B1\",\n    \"priority_date\": \"2011-01-05\",\n    \"filing_date\": \"2011-03-10\",\n    \"issue_date\": \"2019-05-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A medical image analysis system for automated detection of tumors in MRI scans. The system utilizes deep learning algorithms to identify potential cancerous regions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\",\n            \"title\": \"MRI Image Reconstruction Techniques\"\n        },\n        {\n            \"patent_number\": \"US9012345B1\",\n            \"title\": \"Medical Device for Biopsy Guidance\"\n        }\n    ],\n    \"claims\": [\n        \"A system for medical image analysis comprising...\",\n        \"A method for detecting tumors in MRI scans...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69300", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Electrolyte Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2009-05-15\",\n    \"filing_date\": \"2010-03-22\",\n    \"issue_date\": \"2019-07-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery comprising an improved electrolyte composition exhibiting enhanced stability and performance characteristics. The electrolyte includes a novel additive that mitigates degradation and extends cycle life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69300", "text": "{\n    \"patent_title\": \"Improved Lead-Acid Battery Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"General Motors\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Ford Motor Company\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2011-11-01\",\n    \"filing_date\": \"2012-05-10\",\n    \"issue_date\": \"2018-02-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lead-acid battery with a redesigned plate structure and improved electrolyte circulation, enhancing performance and lifespan.  Focuses on reducing sulfation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A lead-acid battery comprising...\",\n        \"A plate structure for a lead-acid battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69301", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-10\",\n    \"filing_date\": \"2011-05-09\",\n    \"issue_date\": \"2019-06-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to an improved lithium-ion battery with enhanced stability and cycle life. The battery incorporates a novel electrolyte formulation and electrode materials that mitigate degradation processes. Applications include electric vehicles and grid-scale energy storage.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        },\n        {\n            \"patent_number\": \"US8123456B2\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\"\n        },\n        {\n            \"patent_number\": \"US9234567B2\"\n        },\n        {\n            \"patent_number\": \"US9567890B2\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte formulation for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69301", "text": "{\n    \"patent_title\": \"Novel Polymer Electrolyte for Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Wilson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11223344B2\",\n    \"priority_date\": \"2012-03-15\",\n    \"filing_date\": \"2012-03-14\",\n    \"issue_date\": \"2020-11-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel polymer electrolyte for batteries with improved ionic conductivity and mechanical properties. This electrolyte enables the development of all-solid-state batteries with enhanced safety and performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\"\n        },\n        {\n            \"patent_number\": \"US8456789B2\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A polymer electrolyte comprising...\",\n        \"A battery cell incorporating a polymer electrolyte...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69302", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a miniature wireless pressure sensor system for biomedical applications. The sensor utilizes MEMS technology and low-power communication protocols for remote monitoring.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising...\",\n        \"A method for remote monitoring of pressure using the sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69302", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Diana Davis\",\n            \"affiliation\": \"UC Berkeley\"\n        },\n        {\n            \"name\": \"Eve Frank\",\n            \"affiliation\": \"Lawrence Livermore National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-05-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel lithium-ion battery with enhanced energy density and cycle life. The battery utilizes a new electrolyte composition for improved performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition for use in a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69303", "text": "{\n    \"patent_title\": \"System and method for distributed machine learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Andrew Ng\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A distributed machine learning system that enables training of models across multiple devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432\",\n            \"relevance\": \"prior art\"\n        },\n        {\n            \"patent_number\": \"US9123456\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US7654321\",\n            \"relevance\": \"cited by\"\n        },\n        {\n            \"patent_number\": \"US1234567\",\n            \"relevance\": \"cited by\"\n        },\n        {\n            \"patent_number\": \"US2345678\",\n            \"relevance\": \"cited by\"\n        }\n    ],\n    \"claims\": [\n        \"A system for distributed machine learning...\",\n        \"A method for training a machine learning model...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69303", "text": "{\n    \"patent_title\": \"Method for Improved Bicycle Braking\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US8765431\",\n    \"priority_date\": \"2015-02-10\",\n    \"filing_date\": \"2015-02-10\",\n    \"issue_date\": \"2018-05-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new braking system for bicycles improving safety and stopping distance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654320\",\n            \"relevance\": \"prior art\"\n        },\n        {\n            \"patent_number\": \"US8123456\",\n            \"relevance\": \"related\"\n        },\n        {\n            \"patent_number\": \"US6543210\",\n            \"relevance\": \"cited by\"\n        }\n    ],\n    \"claims\": [\n        \"A braking system for bicycles...\",\n        \"A method for controlling braking force...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69304", "text": "{\n    \"patent_title\": \"System and Method for Contextual Advertising Using Machine Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Sergey Brin\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Larry Page\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for contextual advertising using machine learning algorithms to predict user interests and deliver relevant advertisements.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Search Relevance Using Machine Learning\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Personalized Advertising System\"\n        },\n        {\n            \"patent_number\": \"US9543210B1\",\n            \"title\": \"Predictive Advertising Model\"\n        },\n        {\n            \"patent_number\": \"US8987654B2\",\n            \"title\": \"Contextual Advertising Network\"\n        },\n        {\n            \"patent_number\": \"US9654321B2\",\n            \"title\": \"Machine Learning for Ad Targeting\"\n        }\n    ],\n    \"claims\": [\n        \"A system for contextual advertising comprising...\",\n        \"A method for predicting user interests...\",\n        \"A computer-readable medium storing instructions...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69304", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US1234567A1\",\n    \"priority_date\": \"2015-05-10\",\n    \"filing_date\": \"2015-05-10\",\n    \"issue_date\": \"2017-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved bicycle brake system with enhanced stopping power and reliability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Bicycle Brake Lever Mechanism\"\n        },\n        {\n            \"patent_number\": \"US8901234B1\",\n            \"title\": \"Hydraulic Bicycle Brake System\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle brake system comprising...\",\n        \"A brake lever adapted for ergonomic operation...\",\n        \"A hydraulic line connecting the brake lever...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69305", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel lithium-ion battery design incorporating a solid-state electrolyte for improved safety and cycle life. The battery exhibits enhanced stability and performance characteristics.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"title\": \"Lithium-Ion Battery Electrode Materials\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"The battery of claim 1, wherein...\",\n        \"A method for manufacturing...\",\n        \"The method of claim 3, wherein...\",\n        \"A system comprising the battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69305", "text": "{\n    \"patent_title\": \"Advanced Sodium-Ion Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2012-10-01\",\n    \"filing_date\": \"2012-10-01\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a new sodium-ion battery with high energy density and rapid charge-discharge capabilities. The battery utilizes a unique electrode structure to enhance performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"title\": \"Sodium-Ion Battery Electrolytes\"\n        }\n    ],\n    \"claims\": [\n        \"A sodium-ion battery comprising...\",\n        \"The battery of claim 1, wherein...\",\n        \"An electrolyte composition for...\",\n        \"A method for operating...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69306", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing image processing, utilizing novel algorithms to improve image clarity and detail. This invention is particularly useful in medical imaging and satellite imagery analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image processing comprising...\",\n        \"A system for implementing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69306", "text": "{\n    \"patent_title\": \"Improved Data Compression Techniques\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Williams\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"David Brown\",\n            \"affiliation\": \"Harvard University\"\n        },\n        {\n            \"name\": \"Emily Davis\",\n            \"affiliation\": \"Yale University\"\n        }\n    ],\n    \"patent_number\": \"US10293847B1\",\n    \"priority_date\": \"2012-01-10\",\n    \"filing_date\": \"2012-01-10\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to improved data compression techniques, significantly reducing the storage space required for digital data. While related to image processing, its primary focus is on data reduction.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression comprising...\",\n        \"A system for implementing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69307", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a system and method for image recognition using artificial intelligence and deep learning techniques. The system efficiently analyzes images and identifies objects with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior Art\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for analyzing images using artificial intelligence...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69307", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Mobile Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Apple Inc.\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"Samsung Electronics\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-08-10\",\n    \"filing_date\": \"2017-08-10\",\n    \"issue_date\": \"2020-02-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel battery technology that significantly improves the energy density and lifespan of batteries used in mobile devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"Related Art\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising...\",\n        \"A method for manufacturing a high-density battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69308", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Pressure Sensor with University Collaboration\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2018-05-15\",\n    \"filing_date\": \"2018-06-15\",\n    \"issue_date\": \"2020-01-28\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized wireless pressure sensor utilizing MEMS technology. This invention allows for remote monitoring of pressure in various applications and was developed in collaboration with researchers from Stanford University and MIT. The sensor incorporates novel calibration techniques to improve accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising...\",\n        \"A method for calibrating a pressure sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69308", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"ACME Corporation\"\n        }\n    ],\n    \"patent_number\": \"US9876543B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2019-12-01\",\n    \"issue_date\": \"2021-03-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This patent describes an improved lithium-ion battery with increased energy density and faster charging capabilities. The battery utilizes a novel electrolyte formulation and electrode materials.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US12345678B2\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte formulation for improved battery performance...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69309", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-09\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system for real-time monitoring of physiological parameters. This system utilizes a novel MEMS sensor and low-power communication protocol.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Wireless Sensor Network\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for monitoring pressure using a wireless sensor...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69309", "text": "{\n    \"patent_title\": \"Improved Sensor Calibration Method\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2015-02-15\",\n    \"filing_date\": \"2015-02-14\",\n    \"issue_date\": \"2019-04-09\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method for calibrating sensors to improve accuracy and reliability in various applications. The method uses a feedback loop and adaptive algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"title\": \"Sensor Calibration Techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A method for calibrating a sensor comprising...\",\n        \"A system for improved sensor accuracy...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69310", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-06-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system is disclosed. The system comprises a MEMS pressure sensor, a low-power transceiver, and a battery. The sensor is capable of measuring pressure in a wide range of applications, including medical devices and industrial monitoring. The wireless communication allows for remote data acquisition.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related prior art on MEMS sensors\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor comprising a MEMS pressure sensor and a transceiver.\",\n        \"The wireless pressure sensor of claim 1, wherein the transceiver is low-power.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69310", "text": "{\n    \"patent_title\": \"Improved Battery Technology for Portable Devices\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-01-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery technology utilizing a new electrolyte material is disclosed. This battery offers improved energy density and cycle life compared to existing lithium-ion batteries. It is suitable for a wide range of portable devices.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related prior art on battery materials\"\n        }\n    ],\n    \"claims\": [\n        \"A battery comprising a novel electrolyte material.\",\n        \"The battery of claim 1, wherein the electrolyte material increases energy density.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69311", "text": "{\n    \"patent_title\": \"AI-Powered Diagnostic System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2023-07-15\",\n    \"filing_date\": \"2023-08-15\",\n    \"issue_date\": \"2024-02-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses an artificial intelligence-powered diagnostic system for early detection of diseases using medical imaging data. The system utilizes deep learning algorithms to analyze images and identify subtle patterns indicative of disease.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for diagnosing diseases comprising...\",\n        \"A method for analyzing medical images using artificial intelligence...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69311", "text": "{\n    \"patent_title\": \"Improved Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2024-01-10\",\n    \"filing_date\": \"2024-02-10\",\n    \"issue_date\": \"2024-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention presents a novel battery technology with enhanced energy density and lifespan. It utilizes a new electrolyte composition and electrode materials.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US11223344B2\"\n        }\n    ],\n    \"claims\": [\n        \"A battery cell comprising...\",\n        \"An electrolyte composition for use in a battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69312", "text": "{\n    \"patent_title\": \"Method and System for AI-Powered Predictive Maintenance\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US10550000B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2020-02-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for predictive maintenance using artificial intelligence and machine learning algorithms. The system analyzes sensor data to predict equipment failures and optimize maintenance schedules.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9880321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for predicting equipment failure comprising...\",\n        \"A system for implementing the method...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The method of claim 1, wherein the AI algorithm is...\",\n        \"The system of claim 2, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69312", "text": "{\n    \"patent_title\": \"Improved Algorithm for Image Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US9999999B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-19\",\n    \"issue_date\": \"2019-12-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved algorithm for compressing digital images. This invention utilizes a novel technique for reducing file size without significant loss of quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8888888B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing an image comprising...\",\n        \"A system for implementing the compression method...\",\n        \"A computer-readable medium storing instructions...\",\n        \"The method of claim 1, wherein the compression ratio is...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69313", "text": "{\n    \"patent_title\": \"Miniaturized Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniaturized wireless pressure sensor system for biomedical applications. The system utilizes a MEMS pressure sensor integrated with a low-power wireless transceiver.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"title\": \"Wireless Sensor Network\"\n        }\n    ],\n    \"claims\": [\n        \"A pressure sensor system comprising...\",\n        \"The system of claim 1, wherein...\",\n        \"A method for measuring pressure...\",\n        \"The method of claim 3, further comprising...\",\n        \"A wireless transceiver for transmitting data...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69313", "text": "{\n    \"patent_title\": \"Improved Chemical Sensor Design\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2014-11-01\",\n    \"filing_date\": \"2014-11-01\",\n    \"issue_date\": \"2017-05-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel chemical sensor design utilizing nanomaterials for enhanced sensitivity and selectivity.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"title\": \"Miniaturized Wireless Pressure Sensor System\"\n        }\n    ],\n    \"claims\": [\n        \"A chemical sensor comprising...\",\n        \"The sensor of claim 1, wherein...\",\n        \"A method for detecting a chemical...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69314", "text": "{\n    \"patent_title\": \"Method and System for Optimized Neural Network Training\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for optimizing the training of neural networks using a novel gradient descent algorithm. The system utilizes distributed computing to accelerate the training process and achieves higher accuracy compared to existing methods. The core idea is based on a dynamic learning rate adjustment strategy informed by network weights and biases.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"Prior art on gradient descent\"\n        }\n    ],\n    \"claims\": [\n        \"A method for training a neural network comprising...\",\n        \"A system for training a neural network...\",\n        \"The method of claim 1, wherein the learning rate is dynamically adjusted...\",\n        \"The system of claim 2, further comprising a distributed computing architecture...\",\n        \"The method of claim 1, wherein the neural network comprises at least one convolutional layer...\",\n        \"The system of claim 2, wherein the gradient descent algorithm is stochastic gradient descent...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69314", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla\"\n        }\n    ],\n    \"patent_number\": \"US10987654B2\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-03-15\",\n    \"issue_date\": \"2021-08-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a battery management system that improves the efficiency and lifespan of lithium-ion batteries. It incorporates advanced thermal management techniques and predictive algorithms to optimize charging and discharging cycles.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Prior art on battery thermal management\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"The battery management system of claim 1, further comprising a thermal control unit...\",\n        \"The system of claim 2, wherein the thermal control unit utilizes a heat sink...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69315", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Segmentation\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-14\",\n    \"issue_date\": \"2019-06-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method and system for enhanced image segmentation utilizing advanced image processing techniques. The method improves accuracy in identifying objects within images.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image segmentation comprising...\",\n        \"A system for implementing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69315", "text": "{\n    \"patent_title\": \"Improved Data Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US1234567B1\",\n    \"priority_date\": \"2012-05-10\",\n    \"filing_date\": \"2012-05-09\",\n    \"issue_date\": \"2020-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel data compression algorithm designed for high-efficiency data storage and transmission.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A method for compressing data comprising...\",\n        \"A system for utilizing the method of claim 1...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69316", "text": "{\n    \"patent_title\": \"High-Performance Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to novel electrode materials for lithium-ion batteries, providing enhanced energy density and cycle life. The materials comprise a unique composite structure enabling improved ion transport and reduced degradation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery electrode material comprising...\",\n        \"A method for manufacturing said electrode material...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69316", "text": "{\n    \"patent_title\": \"Battery Management System with Enhanced Thermal Control\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-03-15\",\n    \"filing_date\": \"2017-03-15\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) designed to optimize thermal regulation and improve the safety and lifespan of lithium-ion battery packs. The system incorporates advanced sensing and control algorithms to prevent overheating and overcharging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"cited as related to battery management\"\n        },\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for controlling temperature within a battery pack...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69317", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery with Enhanced Thermal Stability\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-05-15\",\n    \"filing_date\": \"2015-03-20\",\n    \"issue_date\": \"2019-07-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A lithium-ion battery design incorporating a novel electrolyte and separator structure to improve thermal stability and prevent dendrite formation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8123456B1\"\n        },\n        {\n            \"patent_number\": \"US7654321B2\"\n        },\n        {\n            \"patent_number\": \"US9012345B1\"\n        },\n        {\n            \"patent_number\": \"US8987654B2\"\n        },\n        {\n            \"patent_number\": \"US9123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69317", "text": "{\n    \"patent_title\": \"Advanced Polymer Electrolyte for Sodium-Ion Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2016-11-01\",\n    \"filing_date\": \"2017-05-10\",\n    \"issue_date\": \"2020-02-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A sodium-ion battery utilizing a novel polymer electrolyte to improve performance and safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\"\n        }\n    ],\n    \"claims\": [\n        \"A sodium-ion battery comprising...\",\n        \"A polymer electrolyte composition...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69318", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses novel electrode materials for lithium-ion batteries, enhancing energy density and cycle life. The materials are based on a modified nickel-manganese-cobalt oxide composition.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"prior art\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrode material...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69318", "text": "{\n    \"patent_title\": \"Advanced Polymer Electrolytes for Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"Caltech\"\n        },\n        {\n            \"name\": \"Bob Green\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2017-11-15\",\n    \"issue_date\": \"2020-03-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to novel polymer electrolytes designed for use in high-performance battery systems. The electrolytes exhibit improved ionic conductivity and thermal stability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A polymer electrolyte composition...\",\n        \"A battery comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69319", "text": "{\n    \"patent_title\": \"Neural Network Architecture for Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel neural network architecture is presented for improved image recognition performance. The system utilizes convolutional layers and recurrent neural networks to extract features and classify images with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition using a neural network.\",\n        \"A system comprising a convolutional neural network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69319", "text": "{\n    \"patent_title\": \"Wireless Communication System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Green\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-03-20\",\n    \"filing_date\": \"2017-03-20\",\n    \"issue_date\": \"2020-05-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a wireless communication system with improved signal processing capabilities. It provides efficient data transmission and minimizes interference.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication system comprising a transmitter and a receiver.\",\n        \"A method for transmitting data wirelessly.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69320", "text": "{\n    \"patent_title\": \"Image Processing Network with Enhanced Resolution\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel image processing network architecture for enhancing image resolution and reducing noise. The network utilizes convolutional layers and residual connections.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing image resolution comprising...\",\n        \"An image processing network comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69320", "text": "{\n    \"patent_title\": \"Advanced Video Compression Technique\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Microsoft Research\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-05-12\",\n    \"patent_office\": \"EPO\",\n    \"abstract\": \"A video compression technique that utilizes wavelet transforms and entropy coding to achieve high compression ratios.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9123456B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing video data comprising...\",\n        \"A video compression system comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69321", "text": "{\n    \"patent_title\": \"Deep Convolutional Neural Networks for Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Yann LeCun\",\n            \"affiliation\": \"New York University\"\n        },\n        {\n            \"name\": \"Geoffrey Hinton\",\n            \"affiliation\": \"University of Toronto\"\n        }\n    ],\n    \"patent_number\": \"US9876543\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a deep convolutional neural network architecture for robust and accurate image recognition. The network utilizes multiple convolutional layers, pooling layers, and fully connected layers to extract hierarchical features from images. Applications include object detection, image classification, and facial recognition.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760853\"\n        },\n        {\n            \"patent_number\": \"US9123456\"\n        },\n        {\n            \"patent_number\": \"US9234567\"\n        },\n        {\n            \"patent_number\": \"US9345678\"\n        },\n        {\n            \"patent_number\": \"US9456789\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69321", "text": "{\n    \"patent_title\": \"Method for Enhanced Audio Signal Processing\",\n    \"inventors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US10234567\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-06-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel method for processing audio signals, enhancing clarity and reducing noise. The method utilizes advanced filtering techniques and adaptive algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8901234\"\n        },\n        {\n            \"patent_number\": \"US9012345\"\n        }\n    ],\n    \"claims\": [\n        \"A method for audio signal processing comprising...\",\n        \"A system for audio signal processing comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69322", "text": "{\n    \"patent_title\": \"Method and System for Neural Network-Based Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2019-12-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2022-05-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for image recognition utilizing a deep neural network architecture. The system achieves high accuracy in identifying objects within images by employing convolutional layers and backpropagation algorithms.  The system is applicable to various fields including autonomous vehicles and medical image analysis.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising...\",\n        \"A system for image recognition...\",\n        \"The method of claim 1, wherein...\",\n        \"The system of claim 2, further comprising...\",\n        \"A computer-readable medium storing...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69322", "text": "{\n    \"patent_title\": \"Improved Algorithm for Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-11-01\",\n    \"filing_date\": \"2020-01-20\",\n    \"issue_date\": \"2021-10-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved algorithm for compressing data using Huffman coding. This algorithm reduces file size without significant loss of information. It is applicable in various data storage and transmission applications.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A method for data compression...\",\n        \"A system for data compression...\",\n        \"The method of claim 1, wherein...\",\n        \"The system of claim 2, further comprising...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69323", "text": "{\n    \"patent_title\": \"High-Density Lithium-Ion Battery with Enhanced Safety Features\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2014-11-15\",\n    \"filing_date\": \"2015-03-10\",\n    \"issue_date\": \"2018-01-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel lithium-ion battery design with improved energy density and enhanced safety features. The battery utilizes a new electrolyte composition and a modified electrode structure to prevent thermal runaway and dendrite formation.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8541029B2\",\n            \"relevance\": \"Related to battery materials\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising...\",\n        \"An electrolyte composition for a lithium-ion battery...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69323", "text": "{\n    \"patent_title\": \"Lithium-Ion Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2016-05-01\",\n    \"filing_date\": \"2017-02-15\",\n    \"issue_date\": \"2019-03-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system (BMS) designed specifically for lithium-ion batteries used in electric vehicles. The BMS optimizes battery performance, extends battery life, and ensures safe operation during charging and discharging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9124123B2\",\n            \"relevance\": \"Related to electric vehicle power systems\"\n        },\n        {\n            \"patent_number\": \"US8878645B2\",\n            \"relevance\": \"Related to EV charging infrastructure\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system for an electric vehicle...\",\n        \"A method for optimizing battery performance in an electric vehicle...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69324", "text": "{\n    \"patent_title\": \"System and Method for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2011-03-15\",\n    \"filing_date\": \"2011-03-15\",\n    \"issue_date\": \"2013-07-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a system and method for image recognition using artificial intelligence algorithms. The system utilizes convolutional neural networks to identify objects within images with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\",\n            \"kind\": \"cited_by\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising a neural network...\",\n        \"A method for identifying objects in an image using artificial intelligence...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69324", "text": "{\n    \"patent_title\": \"Improved Bicycle Brake System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Independent Inventor\"\n        }\n    ],\n    \"patent_number\": \"US98765432B1\",\n    \"priority_date\": \"2009-12-10\",\n    \"filing_date\": \"2009-12-10\",\n    \"issue_date\": \"2012-05-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved bicycle brake system designed for enhanced stopping power and reliability. The system utilizes a novel cable tensioning mechanism.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B1\",\n            \"kind\": \"cited_by\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle brake system comprising a cable tensioning mechanism...\",\n        \"A method for improving braking performance on a bicycle...\"\n    ]\n}"}
