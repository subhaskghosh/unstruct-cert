{"_id": "Academic--patents--n--66529", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Independent Inventor\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2019-11-20\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2021-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes an improved braking system for bicycles, enhancing safety and performance through a novel lever mechanism.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A bicycle braking system comprising...\",\n        \"A lever mechanism for enhanced braking force...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66530", "text": "{\n    \"patent_title\": \"Image Recognition System Using Convolutional Neural Networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-10\",\n    \"issue_date\": \"2021-08-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for image recognition using deep convolutional neural networks. The system is capable of identifying objects with high accuracy and efficiency.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Deep Learning Framework\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Object Detection Algorithm\"\n        },\n        {\n            \"patent_number\": \"US11345678B2\",\n            \"title\": \"Neural Network Architecture\"\n        },\n        {\n            \"patent_number\": \"US10456789B2\",\n            \"title\": \"Image Classification Method\"\n        },\n        {\n            \"patent_number\": \"US11567890B2\",\n            \"title\": \"Convolutional Neural Network Optimization\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for identifying objects in an image...\"\n    ]\n}"}
