{"_id": "Academic--patents--p--69075", "text": "{\n    \"patent_title\": \"Method and System for Enhanced Image Processing in Autonomous Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Tesla Inc.\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2017-11-15\",\n    \"filing_date\": \"2018-05-20\",\n    \"issue_date\": \"2021-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for enhancing image processing algorithms used in autonomous vehicles, improving object detection and scene understanding. It utilizes novel filtering techniques for noise reduction and edge enhancement.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing images captured by an autonomous vehicle.\",\n        \"A system for processing images in real-time.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69075", "text": "{\n    \"patent_title\": \"Medical Image Analysis System Using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2019-03-10\",\n    \"filing_date\": \"2019-09-25\",\n    \"issue_date\": \"2022-04-05\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system for analyzing medical images, such as X-rays and MRIs, using deep learning algorithms to assist in diagnosis and treatment planning.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A system for analyzing medical images.\",\n        \"A method for detecting anomalies in medical images.\"\n    ]\n}"}
{"_id": "Academic--patents--p--69076", "text": "{\n    \"patent_title\": \"Method and System for AI-Powered Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of AI Research\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-15\",\n    \"filing_date\": \"2016-05-15\",\n    \"issue_date\": \"2018-10-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a method and system for performing image recognition using artificial intelligence techniques, specifically deep learning convolutional neural networks. The system can identify objects in images with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Related prior art\"\n        }\n    ],\n    \"claims\": [\n        \"1. A method for image recognition comprising...\",\n        \"2. A system for image recognition comprising...\",\n        \"3. The method of claim 1, wherein...\",\n        \"4. The system of claim 2, wherein...\",\n        \"5. A computer-readable medium storing...\",\n        \"6. The method of claim 1, further comprising...\",\n        \"7. The system of claim 2, further comprising...\"\n    ]\n}"}
