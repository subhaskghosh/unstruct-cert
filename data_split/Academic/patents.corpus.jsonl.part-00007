{"_id": "Academic--patents--p--66187", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Recognition using Deep Learning\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2021-11-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing image recognition accuracy using deep convolutional neural networks. The system incorporates attention mechanisms to focus on salient features within an image.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image Classification using Convolutional Neural Networks\"\n        },\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"title\": \"Attention Mechanisms in Deep Learning\"\n        },\n        {\n            \"patent_number\": \"US11098765B1\",\n            \"title\": \"Real-time Image Recognition System\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image recognition comprising...\",\n        \"A method for enhancing image recognition accuracy...\"\n    ]\n}"}
