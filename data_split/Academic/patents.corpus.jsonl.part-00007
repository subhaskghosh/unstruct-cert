{"_id": "Academic--patents--n--66164", "text": "{\n    \"patent_title\": \"Improved Nickel-Metal Hydride Battery\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"California Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2009-12-01\",\n    \"filing_date\": \"2009-12-01\",\n    \"issue_date\": \"2018-05-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An improved nickel-metal hydride battery with increased energy density and longer lifespan. This invention utilizes a novel electrode material and cell design.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210B2\",\n            \"relevance\": \"Related prior art in electrode materials\"\n        }\n    ],\n    \"claims\": [\n        \"A nickel-metal hydride battery comprising...\",\n        \"An electrode material for a nickel-metal hydride battery...\",\n        \"A method for manufacturing a nickel-metal hydride battery...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66165", "text": "{\n    \"patent_title\": \"Miniature Wireless Pressure Sensor System\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-11-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2021-05-11\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A miniature wireless pressure sensor system is disclosed. The system utilizes a MEMS pressure sensor and a low-power wireless communication module for remote data acquisition. Applications include biomedical monitoring and industrial process control.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless pressure sensor system comprising...\",\n        \"A method for remote pressure monitoring...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66165", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2019-08-10\",\n    \"filing_date\": \"2020-03-05\",\n    \"issue_date\": \"2021-07-20\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel battery management system for electric vehicles, providing improved efficiency and safety.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery performance...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66166", "text": "{\n    \"patent_title\": \"Microfluidic Device with Integrated Sensor for Biomarker Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2019-05-21\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device integrating a novel electrochemical sensor for rapid and sensitive detection of biomarkers in biological samples. The sensor utilizes a graphene-based nanocomposite for enhanced signal amplification.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\"\n        },\n        {\n            \"patent_number\": \"US8123456B2\"\n        },\n        {\n            \"patent_number\": \"US8765432B2\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        },\n        {\n            \"patent_number\": \"US9234567B2\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising...\",\n        \"A sensor for detecting biomarkers...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66166", "text": "{\n    \"patent_title\": \"Method for Enhanced Data Compression\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10123456B2\",\n    \"priority_date\": \"2011-06-01\",\n    \"filing_date\": \"2011-06-01\",\n    \"issue_date\": \"2020-01-14\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A novel method for compressing digital data using a modified Huffman coding algorithm. This method improves compression ratios while maintaining acceptable decoding speeds.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7890123B2\"\n        },\n        {\n            \"patent_number\": \"US8901234B2\"\n        },\n        {\n            \"patent_number\": \"US9012345B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for compressing digital data comprising...\",\n        \"An apparatus for decoding compressed data...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66167", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Image Processing in Autonomous Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Innovations Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US12345678B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2018-09-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhanced image processing in autonomous vehicles, improving object detection and scene understanding. The system utilizes novel algorithms to reduce noise and enhance image clarity, leading to improved performance in challenging environmental conditions.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A system for image processing in an autonomous vehicle...\",\n        \"A method for enhancing image clarity...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66167", "text": "{\n    \"patent_title\": \"Medical Image Processing System for Tumor Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"Medical Imaging Solutions\"\n        },\n        {\n            \"name\": \"David Wilson\",\n            \"affiliation\": \"Massachusetts General Hospital\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2015-05-20\",\n    \"filing_date\": \"2015-05-20\",\n    \"issue_date\": \"2017-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A medical image processing system for the detection of tumors in MRI and CT scans.  The system uses advanced image processing techniques to identify potential cancerous tissues with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B2\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A medical image processing system for tumor detection...\",\n        \"A method for identifying cancerous tissues...\"\n    ]\n}"}
