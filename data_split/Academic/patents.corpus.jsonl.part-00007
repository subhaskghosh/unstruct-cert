{"_id": "Academic--patents--p--66311", "text": "{\n    \"patent_title\": \"System and method for object recognition using deep convolutional neural networks\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-20\",\n    \"issue_date\": \"2021-01-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for accurately recognizing objects in images using deep convolutional neural networks. The system is optimized for real-time performance and high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\",\n            \"title\": \"Image recognition using support vector machines\"\n        }\n    ],\n    \"claims\": [\n        \"A system for object recognition comprising...\",\n        \"A method for training a convolutional neural network...\",\n        \"The system of claim 1, wherein the convolutional neural network...\",\n        \"The method of claim 2, further comprising...\",\n        \"A non-transitory computer-readable medium storing...\",\n        \"The system of claim 1, further comprising a processing unit...\"\n    ]\n}"}
