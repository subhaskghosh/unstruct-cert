{"_id": "Academic--patents--n--66026", "text": "{\n    \"patent_title\": \"Improved Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"John Doe\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Jane Smith\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-08-10\",\n    \"issue_date\": \"2022-03-18\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An advanced battery management system (BMS) for electric vehicles, optimizing charging and discharging cycles for increased battery life and performance.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\",\n            \"relevance\": \"related art\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66027", "text": "{\n    \"patent_title\": \"Deep Learning for Image Segmentation\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-01-29\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides a method for image segmentation using deep learning techniques. A convolutional neural network is trained to identify objects within an image with high accuracy.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760789\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image segmentation comprising...\",\n        \"A system for implementing the method...\"\n    ]\n}"}
{"_id": "Academic--patents--n--66027", "text": "{\n    \"patent_title\": \"Improved Image Compression Algorithm\",\n    \"inventors\": [\n        {\n            \"name\": \"David Donoho\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Ingrid Daubechies\",\n            \"affiliation\": \"Princeton University\"\n        }\n    ],\n    \"patent_number\": \"US9234567\",\n    \"priority_date\": \"2014-11-20\",\n    \"filing_date\": \"2014-11-20\",\n    \"issue_date\": \"2016-01-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention details a novel image compression algorithm based on wavelet transforms. It achieves high compression ratios while maintaining acceptable image quality.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321\"\n        }\n    ],\n    \"claims\": [\n        \"An image compression method utilizing wavelet transforms...\",\n        \"A system for implementing the image compression method...\"\n    ]\n}"}
{"_id": "Academic--patents--p--66028", "text": "{\n    \"patent_title\": \"Method and System for Deep Learning-Based Image Recognition\",\n    \"inventors\": [\n        {\n            \"name\": \"Fei-Fei Li\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Justin Johnson\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-14\",\n    \"issue_date\": \"2019-01-22\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for image recognition using deep convolutional neural networks. The system utilizes a large dataset of labeled images to train the network for accurate classification.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8760871\"\n        }\n    ],\n    \"claims\": [\n        \"A method for image recognition comprising: training a deep convolutional neural network using a labeled image dataset; and classifying an input image using the trained network.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66028", "text": "{\n    \"patent_title\": \"Wireless Communication System with Adaptive Modulation\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"UC Berkeley\"\n        }\n    ],\n    \"patent_number\": \"US7654321\",\n    \"priority_date\": \"2005-11-01\",\n    \"filing_date\": \"2005-10-31\",\n    \"issue_date\": \"2008-05-06\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless communication system that adaptively modulates signals to optimize data transmission rates and minimize interference.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US6543210\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless communication system comprising: a transmitter configured to adaptively modulate signals; and a receiver configured to demodulate the signals.\"\n    ]\n}"}
