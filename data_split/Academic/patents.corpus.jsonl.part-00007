{"_id": "Academic--patents--p--66315", "text": "{\n    \"patent_title\": \"System and Method for Enhanced Data Security in Cloud Storage\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A system and method for enhancing data security in cloud storage by employing a multi-layered encryption approach.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B1\"\n        }\n    ],\n    \"claims\": [\n        \"A method for encrypting data prior to storage in a cloud environment.\",\n        \"A system comprising an encryption module and a storage module.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66315", "text": "{\n    \"patent_title\": \"Improved Bicycle Braking System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Acme Corporation\"\n        }\n    ],\n    \"patent_number\": \"US8765432B1\",\n    \"priority_date\": \"2011-05-20\",\n    \"filing_date\": \"2011-05-20\",\n    \"issue_date\": \"2017-12-12\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A new braking system for bicycles offering increased stopping power and reliability.\",\n    \"citations\": [],\n    \"claims\": [\n        \"A bicycle brake lever configured to provide enhanced braking force.\",\n        \"A braking system utilizing a novel pad material.\"\n    ]\n}"}
{"_id": "Academic--patents--p--66316", "text": "{\n    \"patent_title\": \"Microfluidic Device with Integrated Sensor for Biomarker Detection\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"MIT\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2010-03-15\",\n    \"filing_date\": \"2010-03-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A microfluidic device incorporating an integrated optical sensor for rapid and sensitive detection of biomarkers in biological samples. The sensor utilizes surface plasmon resonance to quantify target analytes.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"relevance\": \"Related art in microfluidics\"\n        }\n    ],\n    \"claims\": [\n        \"A microfluidic device comprising an integrated sensor.\",\n        \"The device of claim 1, wherein the sensor is an optical sensor.\"\n    ]\n}"}
{"_id": "Academic--patents--n--66316", "text": "{\n    \"patent_title\": \"Improved Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2009-12-10\",\n    \"filing_date\": \"2009-12-10\",\n    \"issue_date\": \"2019-05-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A battery management system designed to optimize energy storage and discharge. The system incorporates advanced algorithms for predicting battery life and preventing overcharging.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\",\n            \"relevance\": \"Previous battery management techniques\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising a control unit.\",\n        \"The system of claim 1, wherein the control unit utilizes predictive algorithms.\"\n    ]\n}"}
