{"_id": "Academic--patents--n--69078", "text": "{\n    \"patent_title\": \"Enhanced Lead-Acid Battery Technology\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Green\",\n            \"affiliation\": \"Texas A&M University\"\n        }\n    ],\n    \"patent_number\": \"US87654321B1\",\n    \"priority_date\": \"2019-01-10\",\n    \"filing_date\": \"2019-04-05\",\n    \"issue_date\": \"2021-11-01\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes improvements to lead-acid battery technology, focusing on reducing sulfation and increasing lifespan. The technology uses a novel electrolyte additive...\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US76543210B2\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A lead-acid battery comprising...\",\n        \"An electrolyte additive...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69079", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Materials\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Lawrence Berkeley National Laboratory\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2019-07-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to novel electrode materials for lithium-ion batteries, offering improved energy density and cycle life. The materials comprise a modified lithium metal oxide composition.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US7654321B2\",\n            \"type\": \"prior_art\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode material...\",\n        \"The electrode material of claim 1, wherein the material...\",\n        \"A method of manufacturing the electrode material...\",\n        \"The method of claim 3, wherein...\",\n        \"A device utilizing the lithium-ion battery of claim 1.\",\n        \"The device of claim 5, wherein the device is a portable electronic device.\"\n    ]\n}"}
{"_id": "Academic--patents--n--69079", "text": "{\n    \"patent_title\": \"Enhanced Lithium-Ion Battery Management System\",\n    \"inventors\": [\n        {\n            \"name\": \"Park Ji-hoon\",\n            \"affiliation\": \"Samsung SDI\"\n        },\n        {\n            \"name\": \"Kim Min-su\",\n            \"affiliation\": \"Samsung Electronics\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2012-11-01\",\n    \"filing_date\": \"2012-11-01\",\n    \"issue_date\": \"2020-03-17\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention describes a battery management system for lithium-ion batteries, focusing on improved safety and performance monitoring.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8987654B2\",\n            \"type\": \"related\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"The system of claim 1, further comprising...\",\n        \"A method for controlling a lithium-ion battery...\",\n        \"The method of claim 3, wherein...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69080", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode Material\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Dr. Bob Williams\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-03-15\",\n    \"filing_date\": \"2016-03-15\",\n    \"issue_date\": \"2019-04-23\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention discloses a novel electrode material for lithium-ion batteries with enhanced energy density and cycle life. The material comprises a modified lithium metal oxide with improved structural stability.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B2\",\n            \"relevance\": \"Prior art related to lithium-ion battery electrodes.\"\n        }\n    ],\n    \"claims\": [\n        \"A lithium-ion battery comprising an electrode material...\",\n        \"The electrode material of claim 1, wherein the material comprises...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69080", "text": "{\n    \"patent_title\": \"Novel Polymer Electrolyte for Batteries\",\n    \"inventors\": [\n        {\n            \"name\": \"Dr. Carol Davis\",\n            \"affiliation\": \"General Electric\"\n        }\n    ],\n    \"patent_number\": \"US10245678B1\",\n    \"priority_date\": \"2017-05-20\",\n    \"filing_date\": \"2017-05-20\",\n    \"issue_date\": \"2020-11-10\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention concerns a new polymer electrolyte material for use in various battery technologies, offering improved ionic conductivity and safety. The electrolyte is based on a polyether structure.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B2\",\n            \"relevance\": \"Related work on battery electrolytes.\"\n        }\n    ],\n    \"claims\": [\n        \"A battery comprising a polymer electrolyte...\",\n        \"The polymer electrolyte of claim 1, comprising a polyether structure...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69081", "text": "{\n    \"patent_title\": \"Wireless Temperature Sensor Network for Industrial Applications\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Tech Solutions Inc.\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"University of Engineering\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2011-05-15\",\n    \"filing_date\": \"2011-05-15\",\n    \"issue_date\": \"2018-07-24\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A wireless sensor network for monitoring temperature in industrial environments. The system utilizes low-power sensors and a robust communication protocol to provide real-time data.  The system incorporates a sensor to detect temperature variations.\",\n    \"citations\": [\n        {\n            \"title\": \"Low-Power Wireless Communication Protocols\"\n        },\n        {\n            \"title\": \"Industrial Temperature Monitoring Systems\"\n        }\n    ],\n    \"claims\": [\n        \"A wireless sensor network comprising...\",\n        \"A temperature sensor configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69081", "text": "{\n    \"patent_title\": \"Implantable Glucose Sensor with Wireless Communication\",\n    \"inventors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"BioTech Innovations\"\n        }\n    ],\n    \"patent_number\": \"US10234567B1\",\n    \"priority_date\": \"2012-03-10\",\n    \"filing_date\": \"2012-03-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"An implantable glucose sensor for continuous monitoring of blood glucose levels. The sensor wirelessly transmits data to an external receiver. This sensor is designed for medical use.\",\n    \"citations\": [\n        {\n            \"title\": \"Miniaturized Implantable Sensors\"\n        },\n        {\n            \"title\": \"Wireless Communication for Medical Devices\"\n        },\n        {\n            \"title\": \"Continuous Glucose Monitoring Systems\"\n        }\n    ],\n    \"claims\": [\n        \"An implantable glucose sensor comprising...\",\n        \"A wireless communication module configured to...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69082", "text": "{\n    \"patent_title\": \"Advanced Battery Management System for Electric Vehicles\",\n    \"inventors\": [\n        {\n            \"name\": \"Li Wei\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Maria Rodriguez\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"patent_number\": \"US11234567B2\",\n    \"priority_date\": \"2019-05-15\",\n    \"filing_date\": \"2020-02-28\",\n    \"issue_date\": \"2021-03-16\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention provides an advanced battery management system for electric vehicles, improving battery life and performance through optimized charging and discharging algorithms.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US9876543B1\"\n        }\n    ],\n    \"claims\": [\n        \"A battery management system comprising...\",\n        \"A method for optimizing battery charging...\"\n    ]\n}"}
{"_id": "Academic--patents--n--69082", "text": "{\n    \"patent_title\": \"Improved Lithium-Ion Battery Electrode\",\n    \"inventors\": [\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"patent_number\": \"US11987654B2\",\n    \"priority_date\": \"2018-11-01\",\n    \"filing_date\": \"2020-04-10\",\n    \"issue_date\": \"2021-05-25\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"This invention relates to a novel lithium-ion battery electrode material with enhanced energy density and cycle life.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US10123456B1\"\n        }\n    ],\n    \"claims\": [\n        \"An electrode material comprising...\",\n        \"A lithium-ion battery cell including the electrode...\"\n    ]\n}"}
{"_id": "Academic--patents--p--69083", "text": "{\n    \"patent_title\": \"Method and System for Real-Time Image Enhancement\",\n    \"inventors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Adobe Systems\"\n        }\n    ],\n    \"patent_number\": \"US9876543B2\",\n    \"priority_date\": \"2016-05-10\",\n    \"filing_date\": \"2016-05-10\",\n    \"issue_date\": \"2019-01-15\",\n    \"patent_office\": \"USPTO\",\n    \"abstract\": \"A method and system for enhancing the quality of digital images in real-time using a novel filtering algorithm.\",\n    \"citations\": [\n        {\n            \"patent_number\": \"US8765432B1\"\n        },\n        {\n            \"patent_number\": \"US9012345B2\"\n        },\n        {\n            \"patent_number\": \"US9123456B2\"\n        },\n        {\n            \"patent_number\": \"US9234567B2\"\n        },\n        {\n            \"patent_number\": \"US9345678B2\"\n        }\n    ],\n    \"claims\": [\n        \"A method for enhancing an image comprising...\",\n        \"A system for real-time image enhancement...\"\n    ]\n}"}
