{"_id": "Academic--academic_profile--p--67910", "text": "{\n    \"name\": \"Dr. Eleanor Vance\",\n    \"institution\": \"Massachusetts Institute of Technology\",\n    \"department\": \"Electrical Engineering and Computer Science\",\n    \"research_interests\": [\n        \"Machine Learning\",\n        \"Deep Learning\",\n        \"Natural Language Processing\",\n        \"Computational Linguistics\"\n    ],\n    \"publications\": [\n        {\n            \"title\": \"Attention is All You Need\",\n            \"year\": 2017,\n            \"venue\": \"NeurIPS\"\n        },\n        {\n            \"title\": \"BERT: Pre-training of Deep Bidirectional Transformers for Language Understanding\",\n            \"year\": 2018,\n            \"venue\": \"NAACL\"\n        },\n        {\n            \"title\": \"Generative Pre-trained Transformer 2\",\n            \"year\": 2019,\n            \"venue\": \"ICLR\"\n        },\n        {\n            \"title\": \"Scaling Laws for Neural Language Models\",\n            \"year\": 2020,\n            \"venue\": \"arXiv\"\n        },\n        {\n            \"title\": \"Improving Language Understanding by Generative Pre-Training\",\n            \"year\": 2018,\n            \"venue\": \"ACL\"\n        },\n        {\n            \"title\": \"A Neural Probabilistic Language Model\",\n            \"year\": 2003,\n            \"venue\": \"HRI\"\n        },\n        {\n            \"title\": \"Large Language Models are Few-Shot Learners\",\n            \"year\": 2020,\n            \"venue\": \"NeurIPS\"\n        },\n        {\n            \"title\": \"Language Models are Unsupervised Multitask Learners\",\n            \"year\": 2019,\n            \"venue\": \"arXiv\"\n        },\n        {\n            \"title\": \"Training language models to follow instructions with human feedback\",\n            \"year\": 2022,\n            \"venue\": \"NeurIPS\"\n        },\n        {\n            \"title\": \"InstructGPT: Training Language Models to Follow Instructions with Human Feedback\",\n            \"year\": 2022,\n            \"venue\": \"arXiv\"\n        },\n        {\n            \"title\": \"Chain-of-Thought Prompting Elicits Reasoning in Large Language Models\",\n            \"year\": 2022,\n            \"venue\": \"NeurIPS\"\n        }\n    ],\n    \"contact_email\": \"evance@mit.edu\",\n    \"office_location\": \"32-D463\",\n    \"profile_url\": \"https://www.mit.edu/~evance/\",\n    \"education\": [\n        {\n            \"degree\": \"PhD\",\n            \"university\": \"Stanford University\",\n            \"year\": 2016,\n            \"field\": \"Computer Science\"\n        },\n        {\n            \"degree\": \"MS\",\n            \"university\": \"Stanford University\",\n            \"year\": 2013,\n            \"field\": \"Computer Science\"\n        }\n    ]\n}"}
