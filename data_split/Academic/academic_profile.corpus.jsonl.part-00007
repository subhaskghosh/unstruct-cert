{"_id": "Academic--academic_profile--p--70967", "text": "{\n    \"name\": \"Andrew Ng\",\n    \"institution\": \"Stanford University\",\n    \"department\": \"Computer Science\",\n    \"research_interests\": [\n        \"Machine Learning\",\n        \"Deep Learning\",\n        \"Artificial Intelligence\",\n        \"Robotics\"\n    ],\n    \"publications\": [\n        {\n            \"title\": \"Deep Learning\",\n            \"authors\": [\n                \"Andrew Ng\",\n                \"Jeff Dean\"\n            ],\n            \"year\": 2018\n        },\n        {\n            \"title\": \"On Large-Scale Distributed Training of Deep Networks\",\n            \"authors\": [\n                \"Andrew Ng\",\n                \"Christopher Ré\"\n            ],\n            \"year\": 2015\n        },\n        {\n            \"title\": \"The ImageNet Classification with Deep Convolutional Neural Networks\",\n            \"authors\": [\n                \"Alex Krizhevsky\",\n                \"Ilya Sutskever\",\n                \"Geoffrey Hinton\",\n                \"Andrew Ng\"\n            ],\n            \"year\": 2012\n        },\n        {\n            \"title\": \"Learning Deep Architectures for AI\",\n            \"authors\": [\n                \"Andrew Ng\"\n            ],\n            \"year\": 2019\n        },\n        {\n            \"title\": \"Generative Adversarial Networks\",\n            \"authors\": [\n                \"Ian Goodfellow\",\n                \"Jean Pouget-Abadie\",\n                \"Mehdi Mirza\",\n                \"Bing Xu\",\n                \"David Warde-Farley\",\n                \"Sherjil Hasan\",\n                \"Ian Zemel\",\n                \"Ryan Ozdemir\",\n                \"Andrew Ng\"\n            ],\n            \"year\": 2014\n        },\n        {\n            \"title\": \"Scalable Deep Learning with Parallel SGD\",\n            \"authors\": [\n                \"Andrew Ng\",\n                \"Jonathan Shlens\"\n            ],