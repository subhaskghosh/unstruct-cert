{"_id": "Academic--academic_profile--p--68007", "text": "{\n    \"name\": \"Dr. Anya Sharma\",\n    \"institution\": \"Massachusetts Institute of Technology\",\n    \"department\": \"Electrical Engineering and Computer Science\",\n    \"research_interests\": [\n        \"Artificial Intelligence\",\n        \"Machine Learning\",\n        \"Computer Vision\",\n        \"Robotics\"\n    ],\n    \"publications\": [\n        {\n            \"title\": \"Real-time Object Detection in Autonomous Vehicles\",\n            \"year\": 2023,\n            \"venue\": \"IEEE International Conference on Robotics and Automation\",\n            \"abstract\": \"This paper presents a novel approach to real-time object detection using deep learning for autonomous vehicle applications.\",\n            \"keywords\": [\n                \"deep learning\",\n                \"object detection\",\n                \"autonomous vehicles\",\n                \"computer vision\"\n            ]\n        },\n        {\n            \"title\": \"A Machine Learning Framework for Predictive Maintenance\",\n            \"year\": 2022,\n            \"venue\": \"Journal of Machine Learning Research\",\n            \"abstract\": \"We propose a machine learning framework for predicting equipment failures in industrial settings, leading to improved maintenance scheduling and reduced downtime.\",\n            \"keywords\": [\n                \"machine learning\",\n                \"predictive maintenance\",\n                \"time series analysis\",\n                \"industrial automation\"\n            ]\n        }\n    ],\n    \"contact_email\": \"a.sharma@mit.edu\",\n    \"office_location\": \"Building 6, Room 305\",\n    \"profile_url\": \"https://www.mit.edu/~a.sharma/\",\n    \"education\": [\n        {\n            \"degree\": \"PhD\",\n            \"university\": \"Stanford University\",\n            \"year\": 2020,\n            \"field\": \"Computer Science\"\n        },\n        {\n            \"degree\": \"MS\",\n            \"university\": \"Stanford University\",\n            \"year\": 2017,\n            \"field\": \"Computer Science\"\n        }\n    ]\n}"}
{"_id": "Academic--academic_profile--n--68007", "text": "{\n    \"name\": \"Professor David Chen\",\n    \"institution\": \"California Institute of Technology\",\n    \"department\": \"Mathematics\",\n    \"research_interests\": [\n        \"Theoretical Computer Science\",\n        \"Cryptography\",\n        \"Number Theory\"\n    ],\n    \"publications\": [\n        {\n            \"title\": \"New Bounds on the Complexity of Integer Factorization\",\n            \"year\": 2021,\n            \"venue\": \"Journal of Number Theory\",\n            \"abstract\": \"This paper presents new theoretical results on the computational complexity of integer factorization problems.\",\n            \"keywords\": [\n                \"number theory\",\n                \"cryptography\",\n                \"complexity theory\",\n                \"integer factorization\"\n            ]\n        },\n        {\n            \"title\": \"A Novel Proof of the Riemann Hypothesis\",\n            \"year\": 2023,\n            \"venue\": \"Annals of Mathematics\",\n            \"abstract\": \"A completely novel proof is presented for the Riemann hypothesis.\",\n            \"keywords\": [\n                \"Riemann Hypothesis\",\n                \"Number theory\",\n                \"Complex Analysis\"\n            ]\n        }\n    ],\n    \"contact_email\": \"d.chen@caltech.edu\",\n    \"office_location\": \"Knapp Hall 321\",\n    \"profile_url\": \"https://www.caltech.edu/~d.chen/\",\n    \"education\": [\n        {\n            \"degree\": \"PhD\",\n            \"university\": \"Princeton University\",\n            \"year\": 1995,\n            \"field\": \"Mathematics\"\n        }\n    ]\n}"}
