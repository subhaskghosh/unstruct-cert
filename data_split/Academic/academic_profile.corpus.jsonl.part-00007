{"_id": "Academic--academic_profile--p--71796", "text": "{\n    \"name\": \"Dr. Anya Sharma\",\n    \"institution\": \"Massachusetts Institute of Technology\",\n    \"department\": \"Electrical Engineering and Computer Science\",\n    \"research_interests\": [\n        \"Artificial Intelligence\",\n        \"Robotics\",\n        \"Machine Learning\",\n        \"Computer Vision\"\n    ],\n    \"publications\": [\n        {\n            \"title\": \"Real-time Object Detection for Autonomous Vehicles\",\n            \"year\": 2023,\n            \"abstract\": \"This paper presents a novel approach to real-time object detection using deep learning for autonomous driving applications. We demonstrate significant improvements in accuracy and speed on benchmark datasets.\",\n            \"keywords\": [\n                \"autonomous vehicles\",\n                \"deep learning\",\n                \"object detection\",\n                \"real-time\"\n            ]\n        },\n        {\n            \"title\": \"A Reinforcement Learning Framework for Robotic Manipulation\",\n            \"year\": 2022,\n            \"abstract\": \"We propose a new reinforcement learning framework for teaching robots complex manipulation tasks. The framework is designed to be robust to noisy sensor data and variations in the environment.\",\n            \"keywords\": [\n                \"reinforcement learning\",\n                \"robotics\",\n                \"manipulation\",\n                \"artificial intelligence\"\n            ]\n        }\n    ],\n    \"contact_email\": \"anya.sharma@mit.edu\",\n    \"office_location\": \"Building 3, Room 215\",\n    \"profile_url\": \"https://www.mit.edu/~anya.sharma/\",\n    \"education\": [\n        {\n            \"degree\": \"PhD\",\n            \"university\": \"Stanford University\",\n            \"year\": 2018,\n            \"field_of_study\": \"Computer Science\"\n        },\n        {\n            \"degree\": \"MS\",\n            \"university\": \"Stanford University\",\n            \"year\": 2016,\n            \"field_of_study\": \"Computer Science\"\n        },\n        {\n            \"degree\": \"BS\",\n            \"university\": \"University of California, Berkeley\",\n            \"year\": 2014,\n            \"field_of_study\": \"Electrical Engineering\"\n        }\n    ]\n}"}
{"_id": "Academic--academic_profile--n--71796", "text": "{\n    \"name\": \"Dr. Ben Carter\",\n    \"institution\": \"California Institute of Technology\",\n    \"department\": \"Theoretical Physics\",\n    \"research_interests\": [\n        \"String Theory\",\n        \"Quantum Field Theory\",\n        \"Cosmology\"\n    ],\n    \"publications\": [\n        {\n            \"title\": \"On the Nature of Spacetime Singularities\",\n            \"year\": 2023,\n            \"abstract\": \"This paper investigates the mathematical properties of spacetime singularities in the context of general relativity.\",\n            \"keywords\": [\n                \"string theory\",\n                \"general relativity\",\n                \"spacetime\",\n                \"singularity\"\n            ]\n        },\n        {\n            \"title\": \"A Novel Approach to Quantum Gravity\",\n            \"year\": 2022,\n            \"abstract\": \"We propose a new theoretical framework for unifying quantum mechanics and gravity. The framework is based on non-commutative geometry and topological field theory.\",\n            \"keywords\": [\n                \"quantum gravity\",\n                \"non-commutative geometry\",\n                \"topological field theory\"\n            ]\n        }\n    ],\n    \"contact_email\": \"ben.carter@caltech.edu\",\n    \"office_location\": \"Building 4, Room 302\",\n    \"profile_url\": \"https://www.caltech.edu/~bcarter/\",\n    \"education\": [\n        {\n            \"degree\": \"PhD\",\n            \"university\": \"Princeton University\",\n            \"year\": 2010,\n            \"field_of_study\": \"Theoretical Physics\"\n        },\n        {\n            \"degree\": \"MS\",\n            \"university\": \"Princeton University\",\n            \"year\": 2008,\n            \"field_of_study\": \"Physics\"\n        },\n        {\n            \"degree\": \"BS\",\n            \"university\": \"Harvard University\",\n            \"year\": 2006,\n            \"field_of_study\": \"Physics\"\n        }\n    ]\n}"}
