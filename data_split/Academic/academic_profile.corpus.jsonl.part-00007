{"_id": "Academic--academic_profile--n--68811", "text": "{\n    \"name\": \"Dr. Arthur Jenkins\",\n    \"institution\": \"University of California, Berkeley\",\n    \"department\": \"Mathematics\",\n    \"research_interests\": [\n        \"Number Theory\",\n        \"Algebraic Geometry\",\n        \"Topology\"\n    ],\n    \"publications\": [\n        {\n            \"title\": \"A New Proof of Fermat's Last Theorem\",\n            \"year\": 2023,\n            \"venue\": \"Annals of Mathematics\"\n        },\n        {\n            \"title\": \"Geometric Structures on Manifolds\",\n            \"year\": 2022,\n            \"venue\": \"Journal of Differential Geometry\"\n        }\n    ],\n    \"contact_email\": \"arthur.jenkins@berkeley.edu\",\n    \"office_location\": \"Evans Hall, Room 721\",\n    \"profile_url\": \"https://math.berkeley.edu/~jenkins/\",\n    \"education\": [\n        {\n            \"degree\": \"PhD\",\n            \"university\": \"Princeton University\",\n            \"year\": 2017\n        }\n    ]\n}"}
{"_id": "Academic--academic_profile--p--68812", "text": "{\n    \"name\": \"Dr. Anya Sharma\",\n    \"institution\": \"Massachusetts Institute of Technology\",\n    \"department\": \"Electrical Engineering and Computer Science\",\n    \"research_interests\": [\n        \"Artificial Intelligence\",\n        \"Machine Learning\",\n        \"Computer Vision\",\n        \"Robotics\"\n    ],\n    \"publications\": [\n        {\n            \"title\": \"Real-Time Object Detection with Deep Learning\",\n            \"year\": 2023,\n            \"venue\": \"Conference on Computer Vision and Pattern Recognition (CVPR)\",\n            \"abstract\": \"This paper presents a novel approach to real-time object detection using a lightweight deep learning model. The model is designed for efficient deployment on edge devices.\"\n        },\n        {\n            \"title\": \"Reinforcement Learning for Autonomous Navigation\",\n            \"year\": 2022,\n            \"venue\": \"International Conference on Robotics and Automation (ICRA)\",\n            \"abstract\": \"We propose a reinforcement learning framework for training robots to navigate complex environments. The framework utilizes a reward function that encourages safe and efficient navigation.\"\n        }\n    ],\n    \"contact_email\": \"anya.sharma@mit.edu\",\n    \"office_location\": \"Building 3, Room 205\",\n    \"profile_url\": \"https://www.mit.edu/~anya_sharma/\",\n    \"education\": [\n        {\n            \"degree\": \"PhD\",\n            \"institution\": \"Stanford University\",\n            \"year\": 2018,\n            \"field\": \"Computer Science\"\n        },\n        {\n            \"degree\": \"MS\",\n            \"institution\": \"Stanford University\",\n            \"year\": 2015,\n            \"field\": \"Computer Science\"\n        }\n    ]\n}"}
{"_id": "Academic--academic_profile--n--68812", "text": "{\n    \"name\": \"Professor David Chen\",\n    \"institution\": \"University of California, Berkeley\",\n    \"department\": \"Mathematics\",\n    \"research_interests\": [\n        \"Theoretical Computer Science\",\n        \"Cryptography\",\n        \"Number Theory\"\n    ],\n    \"publications\": [\n        {\n            \"title\": \"A New Proof of Fermat's Last Theorem\",\n            \"year\": 2023,\n            \"venue\": \"Annals of Mathematics\",\n            \"abstract\": \"This paper presents a novel proof of Fermat's Last Theorem using advanced techniques from algebraic geometry.\"\n        },\n        {\n            \"title\": \"The Complexity of Integer Factorization\",\n            \"year\": 2022,\n            \"venue\": \"Journal of the American Mathematical Society\",\n            \"abstract\": \"We analyze the computational complexity of integer factorization and establish new bounds on the running time of known algorithms.\"\n        }\n    ],\n    \"contact_email\": \"david.chen@berkeley.edu\",\n    \"office_location\": \"Evans Hall, Room 721\",\n    \"profile_url\": \"https://math.berkeley.edu/~dchen/\",\n    \"education\": [\n        {\n            \"degree\": \"PhD\",\n            \"institution\": \"Harvard University\",\n            \"year\": 2010,\n            \"field\": \"Mathematics\"\n        },\n        {\n            \"degree\": \"BS\",\n            \"institution\": \"California Institute of Technology\",\n            \"year\": 2006,\n            \"field\": \"Mathematics\"\n        }\n    ]\n}"}
