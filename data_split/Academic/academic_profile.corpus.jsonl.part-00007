{"_id": "Academic--academic_profile--p--68397", "text": "{\n    \"name\": \"Dr. Anya Sharma\",\n    \"institution\": \"Massachusetts Institute of Technology\",\n    \"department\": \"Mechanical Engineering\",\n    \"research_interests\": [\n        \"Sustainable Energy Systems\",\n        \"Machine Learning\",\n        \"Renewable Energy\",\n        \"Energy Storage\"\n    ],\n    \"publications\": [\n        {\n            \"title\": \"Machine Learning for Predictive Maintenance in Wind Turbines\",\n            \"year\": 2023,\n            \"authors\": [\n                \"Anya Sharma\",\n                \"Ben Carter\"\n            ]\n        },\n        {\n            \"title\": \"Optimizing Solar Panel Placement with AI\",\n            \"year\": 2022,\n            \"authors\": [\n                \"Anya Sharma\",\n                \"Chloe Davis\"\n            ]\n        },\n        {\n            \"title\": \"A Novel Energy Storage System Design Using Deep Reinforcement Learning\",\n            \"year\": 2021,\n            \"authors\": [\n                \"Anya Sharma\",\n                \"David Evans\"\n            ]\n        },\n        {\n            \"title\": \"The Role of Machine Learning in Grid Modernization\",\n            \"year\": 2020,\n            \"authors\": [\n                \"Anya Sharma\",\n                \"Emily Foster\"\n            ]\n        },\n        {\n            \"title\": \"Advanced Control Strategies for Hybrid Renewable Energy Systems\",\n            \"year\": 2019,\n            \"authors\": [\n                \"Anya Sharma\",\n                \"Frank Green\"\n            ]\n        },\n        {\n            \"title\": \"Impact of Weather Forecasting Accuracy on Renewable Energy Integration\",\n            \"year\": 2018,\n            \"authors\": [\n                \"Anya Sharma\",\n                \"Grace Hill\"\n            ]\n        },\n        {\n            \"title\": \"Data-Driven Approaches for Demand Response Optimization\",\n            \"year\": 2017,\n            \"authors\": [\n                \"Anya Sharma\",\n                \"Henry Ito\"\n            ]\n        },\n        {\n            \"title\": \"Real-Time Energy Management Using Machine Learning Techniques\",\n            \"year\": 2016,\n            \"authors\": [\n                \"Anya Sharma\",\n                \"Ivy Jones\"\n            ]\n        },\n        {\n            \"title\": \"Predictive Modeling of Renewable Energy Generation\",\n            \"year\": 2015,\n            \"authors\": [\n                \"Anya Sharma\",\n                \"Jack King\"\n            ]\n        },\n        {\n            \"title\": \"The Application of Machine Learning in Smart Grids\",\n            \"year\": 2014,\n            \"authors\": [\n                \"Anya Sharma\",\n                \"Kelly Lee\"\n            ]\n        },\n        {\n            \"title\": \"Energy Consumption Prediction Using Neural Networks\",\n            \"year\": 2013,\n            \"authors\": [\n                \"Anya Sharma\",\n                \"Liam Moore\"\n            ]\n        },\n        {\n            \"title\": \"Renewable Energy Integration Challenges and Solutions\",\n            \"year\": 2012,\n            \"authors\": [\n                \"Anya Sharma\",\n                \"Mia Nelson\"\n            ]\n        },\n        {\n            \"title\": \"Advanced Control Algorithms for Wind Power Systems\",\n            \"year\": 2011,\n            \"authors\": [\n                \"Anya Sharma\",\n                \"Noah Owen\"\n            ]\n        },\n        {\n            \"title\": \"Optimizing Energy Efficiency in Buildings\",\n            \"year\": 2010,\n            \"authors\": [\n                \"Anya Sharma\",\n                \"Olivia Perez\"\n            ]\n        },\n        {\n            \"title\": \"The Future of Renewable Energy Technologies\",\n            \"year\": 2009,\n            \"authors\": [\n                \"Anya Sharma\",\n                \"Peter Quinn\"\n            ]\n        },\n        {\n            \"title\": \"Energy Storage Solutions for Intermittent Renewable Sources\",\n            \"year\": 2008,\n            \"authors\": [\n                \"Anya Sharma\",\n                \"Rachel Roberts\"\n            ]\n        },\n        {\n            \"title\": \"Smart Grid Technologies for Enhanced Reliability\",\n            \"year\": 2007,\n            \"authors\": [\n                \"Anya Sharma\",\n                \"Sam Smith\"\n            ]\n        },\n        {\n            \"title\": \"Power System Stability Analysis with Renewable Energy Integration\",\n            \"year\": 2006,\n            \"authors\": [\n                \"Anya Sharma\",\n                \"Tina Taylor\"\n            ]\n        },\n        {\n            \"title\": \"Advanced Metering Infrastructure and its Impact on Energy Management\",\n            \"year\": 2005,\n            \"authors\": [\n                \"Anya Sharma\",\n                \"Ulysses Vance\"\n            ]\n        },\n        {\n            \"title\": \"The Role of Distributed Generation in Modern Power Systems\",\n            \"year\": 2004,\n            \"authors\": [\n                \"Anya Sharma\",\n                \"Victoria White\"\n            ]\n        }\n    ],\n    \"contact_email\": \"anya.sharma@mit.edu\",\n    \"office_location\": \"Building 24, Room 310\",\n    \"profile_url\": \"https://www.mit.edu/people/anya-sharma\",\n    \"education\": [\n        {\n            \"degree\": \"Ph.D. in Mechanical Engineering\",\n            \"university\": \"Stanford University\",\n            \"year\": 2008\n        }\n    ]\n}"}
