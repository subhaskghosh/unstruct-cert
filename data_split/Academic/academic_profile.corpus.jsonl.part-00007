{"_id": "Academic--academic_profile--p--71139", "text": "{\n    \"name\": \"Dr. Anya Sharma\",\n    \"institution\": \"Massachusetts Institute of Technology\",\n    \"department\": \"Mechanical Engineering\",\n    \"research_interests\": [\n        \"Sustainable Energy\",\n        \"AI-driven Optimization\",\n        \"Robotics\",\n        \"Energy Storage\"\n    ],\n    \"publications\": [\n        {\n            \"title\": \"Efficient Energy Harvesting with AI-Controlled Micro-Robots\",\n            \"year\": 2023,\n            \"type\": \"Journal Article\",\n            \"abstract\": \"This paper presents a novel approach to energy harvesting using AI-controlled micro-robots, demonstrating significant improvements in efficiency and scalability.\"\n        },\n        {\n            \"title\": \"Optimization of Wind Turbine Placement using Deep Reinforcement Learning\",\n            \"year\": 2022,\n            \"type\": \"Conference Paper\",\n            \"abstract\": \"A deep reinforcement learning algorithm is used to optimize the placement of wind turbines in complex terrains, maximizing energy production.\"\n        }\n    ],\n    \"contact_email\": \"a.sharma@mit.edu\",\n    \"office_location\": \"Building 3, Room 210\",\n    \"profile_url\": \"https://www.mit.edu/people/anya-sharma\",\n    \"education\": [\n        {\n            \"degree\": \"PhD\",\n            \"institution\": \"Stanford University\",\n            \"year\": 2019,\n            \"field\": \"Mechanical Engineering\"\n        },\n        {\n            \"degree\": \"MS\",\n            \"institution\": \"Stanford University\",\n            \"year\": 2016,\n            \"field\": \"Mechanical Engineering\"\n        }\n    ]\n}"}
{"_id": "Academic--academic_profile--n--71139", "text": "{\n    \"name\": \"Dr. Ben Carter\",\n    \"institution\": \"California Institute of Technology\",\n    \"department\": \"Electrical Engineering\",\n    \"research_interests\": [\n        \"Signal Processing\",\n        \"Communication Systems\",\n        \"Network Theory\"\n    ],\n    \"publications\": [\n        {\n            \"title\": \"A Novel Approach to Signal Reconstruction in Noisy Channels\",\n            \"year\": 2024,\n            \"type\": \"Journal Article\",\n            \"abstract\": \"This paper presents a theoretical framework for signal reconstruction in the presence of noise, providing bounds on achievable performance.\"\n        },\n        {\n            \"title\": \"Asymptotic Analysis of Communication Networks\",\n            \"year\": 2023,\n            \"type\": \"Conference Paper\",\n            \"abstract\": \"The asymptotic behavior of large-scale communication networks is investigated, revealing fundamental limitations on throughput.\"\n        }\n    ],\n    \"contact_email\": \"b.carter@caltech.edu\",\n    \"office_location\": \"Building 468, Room 102\",\n    \"profile_url\": \"https://www.caltech.edu/people/ben-carter\",\n    \"education\": [\n        {\n            \"degree\": \"PhD\",\n            \"institution\": \"University of California, Berkeley\",\n            \"year\": 2018,\n            \"field\": \"Electrical Engineering\"\n        },\n        {\n            \"degree\": \"BS\",\n            \"institution\": \"University of California, Berkeley\",\n            \"year\": 2014,\n            \"field\": \"Electrical Engineering\"\n        }\n    ]\n}"}
