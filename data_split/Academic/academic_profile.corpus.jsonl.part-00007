{"_id": "Academic--academic_profile--p--67317", "text": "{\n    \"name\": \"Dr. Emily Carter\",\n    \"institution\": \"Stanford University\",\n    \"department\": \"Computer Science\",\n    \"research_interests\": [\n        \"Machine Learning\",\n        \"Natural Language Processing\",\n        \"Deep Learning\",\n        \"Computational Linguistics\"\n    ],\n    \"publications\": [\n        {\n            \"title\": \"Attention is All You Need\",\n            \"year\": 2017,\n            \"venue\": \"NeurIPS\"\n        },\n        {\n            \"title\": \"BERT: Pre-training of Deep Bidirectional Transformers for Language Understanding\",\n            \"year\": 2018,\n            \"venue\": \"NAACL\"\n        },\n        {\n            \"title\": \"A Neural Probabilistic Language Model\",\n            \"year\": 2003,\n            \"venue\": \"HRL\"\n        },\n        {\n            \"title\": \"Improving Language Understanding by Generative Pre-Training\",\n            \"year\": 2018,\n            \"venue\": \"ACL\"\n        },\n        {\n            \"title\": \"Large Language Models are Few-Shot Learners\",\n            \"year\": 2020,\n            \"venue\": \"NeurIPS\"\n        },\n        {\n            \"title\": \"Scaling Laws for Neural Language Models\",\n            \"year\": 2020,\n            \"venue\": \"NeurIPS\"\n        },\n        {\n            \"title\": \"Training Compute-Optimal Large Language Models\",\n            \"year\": 2022,\n            \"venue\": \"NeurIPS\"\n        },\n        {\n            \"title\": \"Language Models are Few-Shot Learners\",\n            \"year\": 2020,\n            \"venue\": \"ICLR\"\n        },\n        {\n            \"title\": \"Learning Transferable Visual Models From Large Datasets\",\n            \"year\": 2021,\n            \"venue\": \"ICCV\"\n        },\n        {\n            \"title\": \"DALL-E: Creating Images from Text\",\n            \"year\": 2021,\n            \"venue\": \"CVPR\"\n        },\n        {\n            \"title\": \"Imagen: Photorealistic Text-to-Image Diffusion Models with Deep Language Understanding\",\n            \"year\": 2022,\n            \"venue\": \"ICLR\"\n        },\n        {\n            \"title\": \"PaLM: Scaling Language Modeling with Pathways\",\n            \"year\": 2022,\n            \"venue\": \"NeurIPS\"\n        },\n        {\n            \"title\": \"Chain-of-Thought Prompting Elicits Reasoning in Large Language Models\",\n            \"year\": 2022,\n            \"venue\": \"NeurIPS\"\n        },\n        {\n            \"title\": \"GLaM: General Language Model as a Mixture of Experts\",\n            \"year\": 2021,\n            \"venue\": \"NeurIPS\"\n        },\n        {\n            \"title\": \"Switch Transformers: Scaling to Trillion Parameter Models with Simple and Efficient Sparsity\",\n            \"year\": 2021,\n            \"venue\": \"NeurIPS\"\n        },\n        {\n            \"title\": \"Retrieval-Augmented Generation for Knowledge-Intensive NLP Tasks\",\n            \"year\": 2020,\n            \"venue\": \"NeurIPS\"\n        },\n        {\n            \"title\": \"Sparse MoE for General Language Understanding\",\n            \"year\": 2022,\n            \"venue\": \"ICLR\"\n        },\n        {\n            \"title\": \"LaMDA: Language Models for Dialog Applications\",\n            \"year\": 2022,\n            \"venue\": \"NeurIPS\"\n        },\n        {\n            \"title\": \"Few-Shot Learning with Pre-training\",\n            \"year\": 2019,\n            \"venue\": \"ICML\"\n        },\n        {\n            \"title\": \"GPT-3: Language Models are Few-Shot Learners\",\n            \"year\": 2020,\n            \"venue\": \"NeurIPS\"\n        },\n        {\n            \"title\": \"T5: Text-to-Text Transfer Transformer\",\n            \"year\": 2019,\n            \"venue\": \"NeurIPS\"\n        },\n        {\n            \"title\": \"Exploring the Limits of Transfer Learning with a Unified Text-to-Text Transformer\",\n            \"year\": 2020,\n            \"venue\": \"ICLR\"\n        },\n        {\n            \"title\": \"Revisiting Unsupervised and Supervised Learning using Transformers\",\n            \"year\": 2020,\n            \"venue\": \"ICML\"\n        }\n    ],\n    \"contact_email\": \"emily.carter@stanford.edu\",\n    \"office_location\": \"Gates Computer Science Building, Room 215\",\n    \"profile_url\": \"https://cs.stanford.edu/people/emily-carter\",\n    \"education\": [\n        {\n            \"degree\": \"PhD\",\n            \"major\": \"Computer Science\",\n            \"university\": \"Massachusetts Institute of Technology\",\n            \"year\": 2015\n        }\n    ]\n}"}
