{"_id": "Academic--academic_profile--p--67997", "text": "{\n    \"name\": \"Dr. Anya Sharma\",\n    \"institution\": \"Massachusetts Institute of Technology\",\n    \"department\": \"Mechanical Engineering\",\n    \"research_interests\": [\n        \"Sustainable Energy Systems\",\n        \"Renewable Energy\",\n        \"Energy Storage\",\n        \"Thermofluids\"\n    ],\n    \"publications\": [\n        {\n            \"title\": \"High-Efficiency Solar Cell Designs using Perovskite Materials\",\n            \"year\": 2023,\n            \"type\": \"Journal Article\",\n            \"abstract\": \"This paper presents novel designs for perovskite solar cells focusing on maximizing energy conversion efficiency through material optimization and device engineering.\",\n            \"keywords\": [\n                \"solar cells\",\n                \"perovskite\",\n                \"renewable energy\",\n                \"efficiency\"\n            ]\n        },\n        {\n            \"title\": \"Advanced Battery Management Systems for Electric Vehicles\",\n            \"year\": 2022,\n            \"type\": \"Conference Proceeding\",\n            \"abstract\": \"We demonstrate a new battery management system that extends the life and performance of lithium-ion batteries in electric vehicle applications.\",\n            \"keywords\": [\n                \"battery management\",\n                \"electric vehicles\",\n                \"lithium-ion\",\n                \"energy storage\"\n            ]\n        }\n    ],\n    \"contact_email\": \"anya.sharma@mit.edu\",\n    \"office_location\": \"Building 24, Room 412\",\n    \"profile_url\": \"https://www.mit.edu/~anyasharma/\",\n    \"education\": [\n        {\n            \"degree\": \"PhD\",\n            \"university\": \"Stanford University\",\n            \"field\": \"Mechanical Engineering\",\n            \"year\": 2018\n        },\n        {\n            \"degree\": \"MS\",\n            \"university\": \"University of California, Berkeley\",\n            \"field\": \"Engineering\",\n            \"year\": 2015\n        }\n    ]\n}"}
{"_id": "Academic--academic_profile--n--67997", "text": "{\n    \"name\": \"Dr. Ben Carter\",\n    \"institution\": \"University of Cambridge\",\n    \"department\": \"Theoretical Physics\",\n    \"research_interests\": [\n        \"Quantum Field Theory\",\n        \"String Theory\",\n        \"Cosmology\",\n        \"Black Holes\"\n    ],\n    \"publications\": [\n        {\n            \"title\": \"Entanglement Entropy in Conformal Field Theories\",\n            \"year\": 2023,\n            \"type\": \"Journal Article\",\n            \"abstract\": \"A rigorous derivation of entanglement entropy formulas in various conformal field theories.\",\n            \"keywords\": [\n                \"quantum field theory\",\n                \"entanglement\",\n                \"conformal field theory\"\n            ]\n        },\n        {\n            \"title\": \"The Holographic Principle and Black Hole Thermodynamics\",\n            \"year\": 2022,\n            \"type\": \"Conference Proceeding\",\n            \"abstract\": \"Exploring the connections between black hole thermodynamics and the holographic principle.\",\n            \"keywords\": [\n                \"black holes\",\n                \"holographic principle\",\n                \"thermodynamics\"\n            ]\n        }\n    ],\n    \"contact_email\": \"b.carter@cam.ac.uk\",\n    \"office_location\": \"Cavendish Laboratory, Room 305\",\n    \"profile_url\": \"https://www.cam.ac.uk/~bc227/\",\n    \"education\": [\n        {\n            \"degree\": \"PhD\",\n            \"university\": \"University of Oxford\",\n            \"field\": \"Theoretical Physics\",\n            \"year\": 2019\n        },\n        {\n            \"degree\": \"MS\",\n            \"university\": \"University of Cambridge\",\n            \"field\": \"Physics\",\n            \"year\": 2016\n        }\n    ]\n}"}
