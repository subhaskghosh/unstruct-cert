{"_id": "Academic--academic_profile--p--68034", "text": "{\n    \"name\": \"Dr. Anya Sharma\",\n    \"institution\": \"Massachusetts Institute of Technology\",\n    \"department\": \"Mechanical Engineering\",\n    \"research_interests\": [\n        \"Sustainable Energy\",\n        \"Solar Power\",\n        \"Energy Storage\",\n        \"Materials Science\"\n    ],\n    \"publications\": [\n        {\n            \"title\": \"High-Efficiency Perovskite Solar Cells for Urban Environments\",\n            \"year\": 2023,\n            \"type\": \"Journal Article\",\n            \"abstract\": \"This research details a novel perovskite solar cell design for implementation in urban settings, addressing efficiency and stability concerns.\",\n            \"keywords\": [\n                \"perovskite\",\n                \"solar cells\",\n                \"renewable energy\",\n                \"urban applications\"\n            ]\n        },\n        {\n            \"title\": \"Scalable Manufacturing of Solid-State Batteries\",\n            \"year\": 2022,\n            \"type\": \"Conference Paper\",\n            \"abstract\": \"Presents a cost-effective method for producing solid-state batteries, focusing on scalability and practical implementation.\",\n            \"keywords\": [\n                \"solid-state batteries\",\n                \"manufacturing\",\n                \"energy storage\",\n                \"scalability\"\n            ]\n        }\n    ],\n    \"contact_email\": \"anya.sharma@mit.edu\",\n    \"office_location\": \"Building 24, Room 312\",\n    \"profile_url\": \"https://www.mit.edu/people/anya-sharma\",\n    \"education\": [\n        {\n            \"degree\": \"PhD\",\n            \"university\": \"Stanford University\",\n            \"field_of_study\": \"Materials Science\",\n            \"year\": 2018\n        },\n        {\n            \"degree\": \"MS\",\n            \"university\": \"Stanford University\",\n            \"field_of_study\": \"Mechanical Engineering\",\n            \"year\": 2015\n        }\n    ]\n}"}
