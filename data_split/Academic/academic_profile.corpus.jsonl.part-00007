{"_id": "Academic--academic_profile--p--70128", "text": "{\n    \"name\": \"Dr. Anya Sharma\",\n    \"institution\": \"Stanford University\",\n    \"department\": \"Computer Science\",\n    \"research_interests\": [\n        \"Machine Learning\",\n        \"Artificial Intelligence\",\n        \"Fairness in AI\",\n        \"Explainable AI\"\n    ],\n    \"publications\": [\n        {\n            \"title\": \"Mitigating Bias in Facial Recognition Systems\",\n            \"year\": 2023,\n            \"abstract\": \"This paper presents a novel approach to reducing algorithmic bias in facial recognition, focusing on dataset augmentation and fairness metrics.\",\n            \"keywords\": [\n                \"AI Ethics\",\n                \"Bias Detection\",\n                \"Machine Learning\"\n            ]\n        },\n        {\n            \"title\": \"A Framework for Evaluating the Ethical Implications of AI-Driven Healthcare\",\n            \"year\": 2022,\n            \"abstract\": \"We propose a comprehensive framework for assessing the ethical risks associated with AI applications in healthcare.\",\n            \"keywords\": [\n                \"AI Ethics\",\n                \"Healthcare\",\n                \"Ethical Frameworks\"\n            ]\n        }\n    ],\n    \"contact_email\": \"anya.sharma@stanford.edu\",\n    \"office_location\": \"Gates Computer Science Building, Room 210\",\n    \"profile_url\": \"https://cs.stanford.edu/people/anya-sharma\",\n    \"education\": [\n        {\n            \"degree\": \"PhD\",\n            \"major\": \"Computer Science\",\n            \"university\": \"Massachusetts Institute of Technology\",\n            \"year\": 2018\n        },\n        {\n            \"degree\": \"MS\",\n            \"major\": \"Computer Science\",\n            \"university\": \"Massachusetts Institute of Technology\",\n            \"year\": 2016\n        }\n    ]\n}"}
