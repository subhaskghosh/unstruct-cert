{"_id": "Academic--academic_profile--n--71329", "text": "{\n    \"name\": \"Dr. Ben Carter\",\n    \"institution\": \"University of California, Berkeley\",\n    \"department\": \"Mathematics\",\n    \"research_interests\": [\n        \"Theoretical Physics\",\n        \"Mathematical Modeling\",\n        \"Quantum Mechanics\"\n    ],\n    \"publications\": [\n        {\n            \"title\": \"On the Foundations of Quantum Field Theory\",\n            \"year\": 2020,\n            \"venue\": \"Journal of Mathematical Physics\"\n        },\n        {\n            \"title\": \"A New Approach to String Theory\",\n            \"year\": 2022,\n            \"venue\": \"Communications in Mathematical Physics\"\n        }\n    ],\n    \"contact_email\": \"b.carter@berkeley.edu\",\n    \"office_location\": \"Evans Hall, Room 801\",\n    \"profile_url\": \"https://www.berkeley.edu/people/ben-carter\",\n    \"education\": [\n        {\n            \"degree\": \"PhD\",\n            \"university\": \"Princeton University\",\n            \"year\": 2017\n        },\n        {\n            \"degree\": \"MS\",\n            \"university\": \"Harvard University\",\n            \"year\": 2015\n        },\n        {\n            \"degree\": \"BS\",\n            \"university\": \"Yale University\",\n            \"year\": 2013\n        }\n    ]\n}"}
{"_id": "Academic--academic_profile--p--71330", "text": "{\n    \"name\": \"Dr. Anya Sharma\",\n    \"institution\": \"Massachusetts Institute of Technology\",\n    \"department\": \"Electrical Engineering and Computer Science\",\n    \"research_interests\": [\n        \"Robotics\",\n        \"Artificial Intelligence\",\n        \"Machine Learning\",\n        \"Control Systems\"\n    ],\n    \"publications\": [\n        {\n            \"title\": \"Reinforcement Learning for Robotic Manipulation\",\n            \"year\": 2023,\n            \"authors\": [\n                \"Anya Sharma\",\n                \"David Lee\"\n            ],\n            \"abstract\": \"This paper explores the use of reinforcement learning algorithms for training robots to perform complex manipulation tasks.\"\n        },\n        {\n            \"title\": \"A Novel Approach to Path Planning in Dynamic Environments\",\n            \"year\": 2022,\n            \"authors\": [\n                \"Anya Sharma\",\n                \"Sarah Chen\"\n            ],\n            \"abstract\": \"We present a new path planning algorithm that is robust to changes in the environment.\"\n        }\n    ],\n    \"contact_email\": \"anya.sharma@mit.edu\",\n    \"office_location\": \"Building 24, Room 201 (near main library)\",\n    \"profile_url\": \"https://www.mit.edu/~anya.sharma/\",\n    \"education\": [\n        {\n            \"degree\": \"PhD\",\n            \"major\": \"Electrical Engineering\",\n            \"institution\": \"Stanford University\",\n            \"year\": 2014\n        },\n        {\n            \"degree\": \"MS\",\n            \"major\": \"Electrical Engineering\",\n            \"institution\": \"Stanford University\",\n            \"year\": 2011\n        }\n    ]\n}"}
{"_id": "Academic--academic_profile--n--71330", "text": "{\n    \"name\": \"Dr. Ben Carter\",\n    \"institution\": \"Carnegie Mellon University\",\n    \"department\": \"Robotics Institute\",\n    \"research_interests\": [\n        \"Computer Vision\",\n        \"Machine Learning\",\n        \"Robotics\",\n        \"Image Processing\"\n    ],\n    \"publications\": [\n        {\n            \"title\": \"Deep Learning for Image Segmentation\",\n            \"year\": 2023,\n            \"authors\": [\n                \"Ben Carter\",\n                \"Emily Davis\"\n            ],\n            \"abstract\": \"This paper presents a deep learning model for accurately segmenting images.\"\n        },\n        {\n            \"title\": \"Real-time Object Detection in Video Streams\",\n            \"year\": 2022,\n            \"authors\": [\n                \"Ben Carter\",\n                \"John Wilson\"\n            ],\n            \"abstract\": \"We developed a system for detecting objects in real-time video streams using convolutional neural networks.\"\n        }\n    ],\n    \"contact_email\": \"ben.carter@cmu.edu\",\n    \"office_location\": \"Wean Hall, Room 300\",\n    \"profile_url\": \"https://www.cmu.edu/~ben.carter/\",\n    \"education\": [\n        {\n            \"degree\": \"PhD\",\n            \"major\": \"Robotics\",\n            \"institution\": \"University of Pennsylvania\",\n            \"year\": 2005\n        },\n        {\n            \"degree\": \"MS\",\n            \"major\": \"Computer Science\",\n            \"institution\": \"University of Pennsylvania\",\n            \"year\": 2002\n        }\n    ]\n}"}
