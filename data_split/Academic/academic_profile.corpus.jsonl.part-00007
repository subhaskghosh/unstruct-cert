{"_id": "Academic--academic_profile--p--68810", "text": "{\n    \"name\": \"Dr. Anya Sharma\",\n    \"institution\": \"Massachusetts Institute of Technology\",\n    \"department\": \"Electrical Engineering and Computer Science\",\n    \"research_interests\": [\n        \"Machine Learning\",\n        \"Deep Learning\",\n        \"Computer Vision\",\n        \"Robotics\"\n    ],\n    \"publications\": [\n        {\n            \"title\": \"Real-time Object Detection for Autonomous Vehicles\",\n            \"year\": 2022,\n            \"venue\": \"IEEE International Conference on Robotics and Automation\",\n            \"abstract\": \"This paper presents a novel approach to real-time object detection for use in autonomous vehicles...\"\n        },\n        {\n            \"title\": \"A Practical Guide to Implementing Deep Reinforcement Learning\",\n            \"year\": 2021,\n            \"venue\": \"Journal of Machine Learning Research\",\n            \"abstract\": \"This article details a practical approach to implementing deep reinforcement learning algorithms...\"\n        }\n    ],\n    \"contact_email\": \"a.sharma@mit.edu\",\n    \"office_location\": \"Building 32, Room 212\",\n    \"profile_url\": \"https://www.mit.edu/~a.sharma/\",\n    \"education\": [\n        {\n            \"degree\": \"PhD\",\n            \"institution\": \"Stanford University\",\n            \"year\": 2015,\n            \"field\": \"Computer Science\"\n        },\n        {\n            \"degree\": \"MS\",\n            \"institution\": \"Stanford University\",\n            \"year\": 2012,\n            \"field\": \"Computer Science\"\n        }\n    ]\n}"}
{"_id": "Academic--academic_profile--n--68810", "text": "{\n    \"name\": \"Dr. Benjamin Carter\",\n    \"institution\": \"University of California, Berkeley\",\n    \"department\": \"Mathematics\",\n    \"research_interests\": [\n        \"Theoretical Computer Science\",\n        \"Computational Complexity\",\n        \"Algorithm Design\"\n    ],\n    \"publications\": [\n        {\n            \"title\": \"On the Limits of Efficient Computation\",\n            \"year\": 2020,\n            \"venue\": \"Symposium on Theory of Computing\",\n            \"abstract\": \"This paper explores fundamental limits in the efficiency of computation...\"\n        },\n        {\n            \"title\": \"A New Proof of the NP-Completeness of SAT\",\n            \"year\": 2018,\n            \"venue\": \"Journal of the ACM\",\n            \"abstract\": \"We present a novel and simplified proof of the NP-completeness of the satisfiability problem...\"\n        }\n    ],\n    \"contact_email\": \"b.carter@berkeley.edu\",\n    \"office_location\": \"Evans Hall, Room 600\",\n    \"profile_url\": \"https://www.berkeley.edu/~b.carter/\",\n    \"education\": [\n        {\n            \"degree\": \"PhD\",\n            \"institution\": \"Harvard University\",\n            \"year\": 2008,\n            \"field\": \"Mathematics\"\n        },\n        {\n            \"degree\": \"MS\",\n            \"institution\": \"Harvard University\",\n            \"year\": 2005,\n            \"field\": \"Mathematics\"\n        }\n    ]\n}"}
