{"_id": "Academic--academic_profile--p--70768", "text": "{\n    \"name\": \"Dr. Anya Sharma\",\n    \"institution\": \"Massachusetts Institute of Technology\",\n    \"department\": \"Electrical Engineering and Computer Science\",\n    \"research_interests\": [\n        \"Robotics\",\n        \"Artificial Intelligence\",\n        \"Machine Learning\",\n        \"Computer Vision\"\n    ],\n    \"publications\": [\n        {\n            \"title\": \"Real-time Object Recognition for Autonomous Navigation\",\n            \"year\": 2023,\n            \"type\": \"Journal Article\",\n            \"abstract\": \"This paper presents a novel approach to real-time object recognition using deep learning techniques, applied to the problem of autonomous robot navigation.\"\n        },\n        {\n            \"title\": \"A Framework for Human-Robot Collaboration in Manufacturing\",\n            \"year\": 2022,\n            \"type\": \"Conference Paper\",\n            \"abstract\": \"We introduce a collaborative framework allowing robots to effectively work alongside humans in manufacturing environments, improving efficiency and safety.\"\n        }\n    ],\n    \"contact_email\": \"a.sharma@mit.edu\",\n    \"office_location\": \"Building 32, Room 246\",\n    \"profile_url\": \"https://www.mit.edu/people/anya-sharma\",\n    \"education\": [\n        {\n            \"degree\": \"PhD\",\n            \"institution\": \"Stanford University\",\n            \"year\": 2018,\n            \"field_of_study\": \"Computer Science\"\n        },\n        {\n            \"degree\": \"MS\",\n            \"institution\": \"Stanford University\",\n            \"year\": 2015,\n            \"field_of_study\": \"Computer Science\"\n        }\n    ]\n}"}
{"_id": "Academic--academic_profile--n--70768", "text": "{\n    \"name\": \"Dr. Ben Carter\",\n    \"institution\": \"University of California, Berkeley\",\n    \"department\": \"Mathematics\",\n    \"research_interests\": [\n        \"Theoretical Physics\",\n        \"Quantum Mechanics\",\n        \"String Theory\"\n    ],\n    \"publications\": [\n        {\n            \"title\": \"On the Mathematical Foundations of String Theory\",\n            \"year\": 2023,\n            \"type\": \"Journal Article\",\n            \"abstract\": \"This paper explores the mathematical underpinnings of string theory, focusing on advanced concepts in topology and geometry.\"\n        },\n        {\n            \"title\": \"A Novel Approach to Quantum Entanglement\",\n            \"year\": 2022,\n            \"type\": \"Conference Paper\",\n            \"abstract\": \"We present a theoretical analysis of quantum entanglement, examining its implications for fundamental physics.\"\n        }\n    ],\n    \"contact_email\": \"b.carter@berkeley.edu\",\n    \"office_location\": \"Evans Hall, Room 721\",\n    \"profile_url\": \"https://www.berkeley.edu/people/ben-carter\",\n    \"education\": [\n        {\n            \"degree\": \"PhD\",\n            \"institution\": \"University of Cambridge\",\n            \"year\": 2017,\n            \"field_of_study\": \"Mathematics\"\n        },\n        {\n            \"degree\": \"MS\",\n            \"institution\": \"University of Cambridge\",\n            \"year\": 2014,\n            \"field_of_study\": \"Mathematics\"\n        }\n    ]\n}"}
