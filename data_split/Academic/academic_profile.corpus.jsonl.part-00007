{"_id": "Academic--academic_profile--p--68180", "text": "{\n    \"name\": \"Dr. Anya Sharma\",\n    \"institution\": \"Massachusetts Institute of Technology\",\n    \"department\": \"Mechanical Engineering\",\n    \"research_interests\": [\n        \"Sustainable Energy\",\n        \"Robotics\",\n        \"AI-Driven Design\",\n        \"Manufacturing\"\n    ],\n    \"publications\": [\n        {\n            \"title\": \"AI-Optimized Wind Turbine Blade Design for Enhanced Energy Capture\",\n            \"year\": 2023,\n            \"type\": \"Journal Article\",\n            \"abstract\": \"This paper presents a novel approach to wind turbine blade design using reinforcement learning algorithms, resulting in a 15% increase in energy capture efficiency. The design focuses on practical implementation and cost-effectiveness.\"\n        },\n        {\n            \"title\": \"A Novel Robotic System for Precision Agriculture\",\n            \"year\": 2022,\n            \"type\": \"Conference Proceeding\",\n            \"abstract\": \"This work details the development of a robotic system for automated weed control and fertilizer application, improving crop yields and reducing environmental impact.\"\n        }\n    ],\n    \"contact_email\": \"anya.sharma@mit.edu\",\n    \"office_location\": \"Building 3, Room 205\",\n    \"profile_url\": \"https://www.mit.edu/people/anya-sharma\",\n    \"education\": [\n        {\n            \"degree\": \"PhD\",\n            \"institution\": \"Stanford University\",\n            \"field_of_study\": \"Mechanical Engineering\",\n            \"year\": 2018\n        },\n        {\n            \"degree\": \"MS\",\n            \"institution\": \"Stanford University\",\n            \"field_of_study\": \"Mechanical Engineering\",\n            \"year\": 2015\n        }\n    ]\n}"}
{"_id": "Academic--academic_profile--n--68180", "text": "{\n    \"name\": \"Dr. Ben Carter\",\n    \"institution\": \"California Institute of Technology\",\n    \"department\": \"Theoretical Physics\",\n    \"research_interests\": [\n        \"String Theory\",\n        \"Quantum Field Theory\",\n        \"Cosmology\"\n    ],\n    \"publications\": [\n        {\n            \"title\": \"Higher-Dimensional String Compactifications and Their Implications\",\n            \"year\": 2023,\n            \"type\": \"Journal Article\",\n            \"abstract\": \"This paper explores the mathematical properties of higher-dimensional string compactifications, focusing on the geometric constraints and topological invariants.\"\n        },\n        {\n            \"title\": \"A New Approach to Quantum Gravity\",\n            \"year\": 2022,\n            \"type\": \"Conference Proceeding\",\n            \"abstract\": \"This work presents a theoretical framework for reconciling quantum mechanics with general relativity, based on novel mathematical structures.\"\n        }\n    ],\n    \"contact_email\": \"ben.carter@caltech.edu\",\n    \"office_location\": \"Millikan Library, Room 401\",\n    \"profile_url\": \"https://www.caltech.edu/people/ben-carter\",\n    \"education\": [\n        {\n            \"degree\": \"PhD\",\n            \"institution\": \"Princeton University\",\n            \"field_of_study\": \"Physics\",\n            \"year\": 2017\n        },\n        {\n            \"degree\": \"MS\",\n            \"institution\": \"Princeton University\",\n            \"field_of_study\": \"Physics\",\n            \"year\": 2014\n        }\n    ]\n}"}
