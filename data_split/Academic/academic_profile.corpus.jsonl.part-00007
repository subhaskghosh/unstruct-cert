{"_id": "Academic--academic_profile--p--68236", "text": "{\n    \"name\": \"Dr. Anya Sharma\",\n    \"institution\": \"Massachusetts Institute of Technology\",\n    \"department\": \"Mechanical Engineering\",\n    \"research_interests\": [\n        \"Sustainable Energy Systems\",\n        \"Energy Storage\",\n        \"Thermoelectric Materials\",\n        \"Fluid Dynamics\"\n    ],\n    \"publications\": [\n        {\n            \"title\": \"Novel Thermoelectric Materials for Waste Heat Recovery\",\n            \"year\": 2022,\n            \"type\": \"Journal Article\",\n            \"abstract\": \"A theoretical and experimental study of new thermoelectric materials...\",\n            \"keywords\": [\n                \"thermoelectric\",\n                \"waste heat\",\n                \"materials science\"\n            ]\n        },\n        {\n            \"title\": \"Design and Optimization of a Grid-Scale Energy Storage System\",\n            \"year\": 2023,\n            \"type\": \"Conference Proceeding\",\n            \"abstract\": \"Applied research on energy storage for grid stabilization...\",\n            \"keywords\": [\n                \"energy storage\",\n                \"grid stability\",\n                \"optimization\"\n            ]\n        }\n    ],\n    \"contact_email\": \"a.sharma@mit.edu\",\n    \"office_location\": \"Building 24, Room 302\",\n    \"profile_url\": \"https://www.mit.edu/~a.sharma/\",\n    \"education\": [\n        {\n            \"degree\": \"PhD\",\n            \"major\": \"Mechanical Engineering\",\n            \"university\": \"Stanford University\",\n            \"year\": 2018\n        }\n    ]\n}"}
