{"_id": "Academic--academic_profile--p--67403", "text": "{\n    \"name\": \"Dr. Anya Sharma\",\n    \"institution\": \"Stanford University\",\n    \"department\": \"Computer Science\",\n    \"research_interests\": [\n        \"Machine Learning\",\n        \"Natural Language Processing\",\n        \"Deep Learning\",\n        \"Computer Vision\"\n    ],\n    \"publications\": [\n        {\n            \"title\": \"Attention is All You Need\",\n            \"authors\": [\n                \"Vaswani et al.\"\n            ],\n            \"year\": 2017,\n            \"abstract\": \"This paper introduces the Transformer model, a novel neural network architecture based on the attention mechanism for sequence-to-sequence tasks. Deep learning techniques are central to this work.\"\n        },\n        {\n            \"title\": \"BERT: Pre-training of Deep Bidirectional Transformers for Language Understanding\",\n            \"authors\": [\n                \"Devlin et al.\"\n            ],\n            \"year\": 2018,\n            \"abstract\": \"BERT is a new language representation model based on Transformers. It achieves state-of-the-art results on a wide range of NLP tasks leveraging deep learning.\"\n        }\n    ],\n    \"contact_email\": \"anya.sharma@stanford.edu\",\n    \"office_location\": \"Gates Computer Science Building, Room 215\",\n    \"profile_url\": \"https://cs.stanford.edu/people/anya-sharma\",\n    \"education\": [\n        {\n            \"degree\": \"PhD\",\n            \"institution\": \"Massachusetts Institute of Technology\",\n            \"year\": 2015\n        }\n    ]\n}"}
{"_id": "Academic--academic_profile--n--67403", "text": "{\n    \"name\": \"Dr. Ben Carter\",\n    \"institution\": \"University of California, Berkeley\",\n    \"department\": \"Electrical Engineering and Computer Sciences\",\n    \"research_interests\": [\n        \"Computer Networks\",\n        \"Distributed Systems\",\n        \"Data Mining\"\n    ],\n    \"publications\": [\n        {\n            \"title\": \"A Scalable Protocol for Data Dissemination in Wireless Networks\",\n            \"authors\": [\n                \"Carter et al.\"\n            ],\n            \"year\": 2020,\n            \"abstract\": \"This paper presents a novel protocol for efficiently distributing data in large-scale wireless networks.\"\n        },\n        {\n            \"title\": \"Optimizing Resource Allocation in Cloud Computing Environments\",\n            \"authors\": [\n                \"Lee et al.\"\n            ],\n            \"year\": 2022,\n            \"abstract\": \"We investigate methods for optimizing resource allocation in cloud computing systems to improve performance and reduce costs.\"\n        }\n    ],\n    \"contact_email\": \"ben.carter@berkeley.edu\",\n    \"office_location\": \"Sutardja Center for Entrepreneurship & Technology, Room 304\",\n    \"profile_url\": \"https://eecs.berkeley.edu/people/ben-carter\",\n    \"education\": [\n        {\n            \"degree\": \"PhD\",\n            \"institution\": \"Carnegie Mellon University\",\n            \"year\": 2018\n        }\n    ]\n}"}
