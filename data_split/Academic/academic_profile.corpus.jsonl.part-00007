{"_id": "Academic--academic_profile--p--68535", "text": "{\n    \"name\": \"Dr. Anya Sharma\",\n    \"institution\": \"Massachusetts Institute of Technology\",\n    \"department\": \"Electrical Engineering and Computer Science\",\n    \"research_interests\": [\n        \"Robotics\",\n        \"Artificial Intelligence\",\n        \"Computer Vision\",\n        \"Machine Learning\"\n    ],\n    \"publications\": [\n        {\n            \"title\": \"Real-Time Object Detection for Autonomous Navigation\",\n            \"year\": 2023,\n            \"type\": \"Journal Article\",\n            \"abstract\": \"This paper presents a novel algorithm for real-time object detection using deep learning, designed for use in autonomous vehicles. Experimental results demonstrate significant improvements in accuracy and speed.\"\n        },\n        {\n            \"title\": \"A Framework for Collaborative Robotics in Manufacturing\",\n            \"year\": 2022,\n            \"type\": \"Conference Paper\",\n            \"abstract\": \"Describes a robotic system implemented in a factory setting for collaborative tasks.\"\n        }\n    ],\n    \"contact_email\": \"a.sharma@mit.edu\",\n    \"office_location\": \"Building 32, Room 212\",\n    \"profile_url\": \"https://www.mit.edu/~a.sharma/\",\n    \"education\": [\n        {\n            \"degree\": \"PhD\",\n            \"university\": \"Stanford University\",\n            \"year\": 2015,\n            \"field\": \"Electrical Engineering\"\n        }\n    ]\n}"}
