{"_id": "Academic--academic_profile--p--71227", "text": "{\n    \"name\": \"Dr. Anya Sharma\",\n    \"institution\": \"Massachusetts Institute of Technology\",\n    \"department\": \"Electrical Engineering and Computer Science\",\n    \"research_interests\": [\n        \"Artificial Intelligence\",\n        \"Robotics\",\n        \"Machine Learning\",\n        \"Computer Vision\"\n    ],\n    \"publications\": [\n        {\n            \"title\": \"Real-Time Object Detection for Autonomous Vehicles\",\n            \"year\": 2022,\n            \"abstract\": \"This paper presents a novel algorithm for real-time object detection in autonomous driving scenarios, focusing on practical implementation and performance.\",\n            \"type\": \"Journal Article\"\n        },\n        {\n            \"title\": \"A Robotic System for Automated Crop Harvesting\",\n            \"year\": 2020,\n            \"abstract\": \"Describes the development and field testing of a robotic system for harvesting crops, emphasizing its practical benefits for farmers.\",\n            \"type\": \"Conference Paper\"\n        }\n    ],\n    \"contact_email\": \"anya.sharma@mit.edu\",\n    \"office_location\": \"Building 32, Room 212\",\n    \"profile_url\": \"https://www.mit.edu/people/anya-sharma\",\n    \"education\": [\n        {\n            \"degree\": \"PhD\",\n            \"institution\": \"Stanford University\",\n            \"year\": 2018\n        },\n        {\n            \"degree\": \"MS\",\n            \"institution\": \"Stanford University\",\n            \"year\": 2016\n        }\n    ]\n}"}
