{"_id": "Academic--digital_learning--p--71827", "text": "{\n    \"platform_name\": \"SkillForge\",\n    \"developer\": \"EduTech Solutions Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Project-based learning\",\n        \"Personalized learning paths\",\n        \"Community forums\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Freemium with premium plans\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Python for Data Science\",\n            \"level\": \"Beginner to Advanced\",\n            \"duration\": \"12 weeks\",\n            \"price\": 99.99\n        },\n        {\n            \"course_name\": \"Web Development Bootcamp\",\n            \"level\": \"Beginner to Intermediate\",\n            \"duration\": \"16 weeks\",\n            \"price\": 149.99\n        }\n    ],\n    \"launch_date\": \"2021-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform! The UI is intuitive and the course content is very well structured.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great learning experience. Highly recommended for anyone looking to upskill.\"\n        }\n    ],\n    \"access_url\": \"https://www.skillforge.com\"\n}"}
{"_id": "Academic--digital_learning--n--71827", "text": "{\n    \"platform_name\": \"LearnBase\",\n    \"developer\": \"StartupEd Technologies\",\n    \"features\": [\n        \"Video lectures\",\n        \"Quizzes\",\n        \"Downloadable resources\",\n        \"Discussion boards\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Completely Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to History\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\",\n            \"price\": 0\n        },\n        {\n            \"course_name\": \"Basic Algebra\",\n            \"level\": \"Beginner\",\n            \"duration\": \"6 weeks\",\n            \"price\": 0\n        }\n    ],\n    \"launch_date\": \"2022-03-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Decent platform, but the interface could be improved.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"Content is good, but the website is a bit clunky.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnbase.org\"\n}"}
{"_id": "Academic--digital_learning--p--71828", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp BV\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Projects\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-05-16\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science skills. Very practical exercises.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Excellent resources for both beginners and experienced data scientists.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71828", "text": "{\n    \"platform_name\": \"LearnFusion\",\n    \"developer\": \"EduTech Solutions Inc.\",\n    \"features\": [\n        \"Pre-recorded video lectures\",\n        \"Downloadable course materials\",\n        \"Quizzes\",\n        \"Discussion boards\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Theoretical Statistics\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Advanced Calculus\",\n            \"level\": \"Advanced\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning Foundations\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2019-11-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Good content but a bit too theoretical. Lacks hands-on practice.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"The interface is clunky and difficult to navigate.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnfusion.edu\"\n}"}
{"_id": "Academic--digital_learning--p--71829", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill tracks\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscription tiers\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"12 months\"\n        }\n    ],\n    \"launch_date\": \"2016-02-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science skills. The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"456\",\n            \"rating\": 4,\n            \"comment\": \"Great courses and supportive community.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71829", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lessons\",\n        \"Practice exercises\",\n        \"Personalized learning\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\",\n        \"Parents\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Algebra I\",\n            \"level\": \"Beginner\",\n            \"duration\": \"Self-paced\"\n        },\n        {\n            \"course_name\": \"Calculus AB\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"Self-paced\"\n        },\n        {\n            \"course_name\": \"Statistics and Probability\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"Self-paced\"\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"789\",\n            \"rating\": 5,\n            \"comment\": \"Amazing resource for free education! Very clear and concise explanations.\"\n        },\n        {\n            \"user_id\": \"101\",\n            \"rating\": 4,\n            \"comment\": \"Helped me a lot with my math classes.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
{"_id": "Academic--digital_learning--p--71830", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Analysts\",\n        \"Engineers\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Data Visualization with Tableau\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science skills. The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great content and well-structured courses. Would recommend to anyone starting out.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71830", "text": "{\n    \"platform_name\": \"Codecademy\",\n    \"developer\": \"Codecademy\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Project-based learning\",\n        \"Career paths\",\n        \"Quizzes\"\n    ],\n    \"user_types\": [\n        \"Beginners\",\n        \"Students\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to HTML & CSS\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Learn JavaScript\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"6 weeks\"\n        }\n    ],\n    \"launch_date\": \"2011-08-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Good for basic coding skills, but doesn't go deep enough into advanced topics.\"\n        },\n        {\n            \"user_id\": \"user101\",\n            \"rating\": 2,\n            \"comment\": \"Interface is cluttered and can be confusing.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com\"\n}"}
{"_id": "Academic--digital_learning--p--71831", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp BV\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill tracks\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Educators\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Python basics\",\n                \"Data types\",\n                \"Control flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Regression\",\n                \"Classification\",\n                \"Clustering\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"difficulty\": \"Advanced\",\n            \"topics\": [\n                \"Statistical Modeling\",\n                \"Data Visualization\",\n                \"Big Data\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-03-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science. Very interactive and engaging.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great resources and well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71831", "text": "{\n    \"platform_name\": \"LearnVerse\",\n    \"developer\": \"EduTech Solutions\",\n    \"features\": [\n        \"Pre-recorded video lectures\",\n        \"Downloadable course materials\",\n        \"Quizzes and assignments\",\n        \"Discussion boards\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Calculus I\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Limits\",\n                \"Derivatives\",\n                \"Integrals\"\n            ]\n        },\n        {\n            \"course_name\": \"Linear Algebra\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Vectors\",\n                \"Matrices\",\n                \"Eigenvalues\"\n            ]\n        },\n        {\n            \"course_name\": \"Statistics 101\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Data Analysis\",\n                \"Probability\",\n                \"Hypothesis Testing\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2022-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Decent platform, but feels a bit outdated. The course materials are very similar to traditional textbooks.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"The interface is not very user-friendly.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnverse.edu\"\n}"}
{"_id": "Academic--digital_learning--p--71832", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp, Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscription tiers\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science! Very interactive and engaging.\"\n        },\n        {\n            \"user\": \"Bob\",\n            \"rating\": 4,\n            \"comment\": \"Helpful courses, but could use more advanced content.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71832", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Peer assessments\",\n        \"Quizzes\",\n        \"Discussion forums\",\n        \"Certificates\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Subscription and individual course purchase\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"5 courses\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"3 courses\"\n        }\n    ],\n    \"launch_date\": \"2012-02-17\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Charlie\",\n            \"rating\": 3,\n            \"comment\": \"Good courses, but can be quite expensive.\"\n        },\n        {\n            \"user\": \"David\",\n            \"rating\": 4,\n            \"comment\": \"Helpful for career advancement.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org\"\n}"}
{"_id": "Academic--digital_learning--p--71833", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lessons\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions (starting at $25/month)\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Python syntax\",\n                \"Data types\",\n                \"Control flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Regression\",\n                \"Classification\",\n                \"Clustering\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"difficulty\": \"Advanced\",\n            \"topics\": [\n                \"Statistical Modeling\",\n                \"Data Visualization\",\n                \"Big Data\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-02-03\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science! The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great resource, but some courses could be updated more frequently.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71833", "text": "{\n    \"platform_name\": \"LearnVerse\",\n    \"developer\": \"EdTech Solutions Inc.\",\n    \"features\": [\n        \"Pre-recorded video lectures\",\n        \"Downloadable course materials\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Lifelong Learners\"\n    ],\n    \"subscription_model\": \"Paid subscriptions (starting at $99/month)\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Fundamentals of History\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Ancient Civilizations\",\n                \"Medieval Europe\",\n                \"Modern History\"\n            ]\n        },\n        {\n            \"course_name\": \"Introduction to Literature\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Poetry\",\n                \"Drama\",\n                \"Novel\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2022-05-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"The content is good, but the platform is a bit clunky and lacks interactivity.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"Too expensive for what it offers. There are better alternatives.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnverse.edu\"\n}"}
{"_id": "Academic--digital_learning--p--71834", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill assessments\",\n        \"Career tracks\",\n        \"Project-based learning\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscription tiers\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"subject\": \"Programming\"\n        },\n        {\n            \"course_name\": \"Machine Learning with scikit-learn\",\n            \"level\": \"Intermediate\",\n            \"subject\": \"Machine Learning\"\n        },\n        {\n            \"course_name\": \"Data Visualization with R\",\n            \"level\": \"Intermediate\",\n            \"subject\": \"Data Science\"\n        }\n    ],\n    \"launch_date\": \"2016-02-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science skills!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Interactive exercises are very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71834", "text": "{\n    \"platform_name\": \"ABCmouse.com\",\n    \"developer\": \"Age of Learning, Inc.\",\n    \"features\": [\n        \"Educational games\",\n        \"Interactive stories\",\n        \"Printable worksheets\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Children\",\n        \"Parents\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Paid subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Reading and Language Arts\",\n            \"level\": \"Early Learning\",\n            \"subject\": \"Literacy\"\n        },\n        {\n            \"course_name\": \"Mathematics\",\n            \"level\": \"Early Learning\",\n            \"subject\": \"Math\"\n        }\n    ],\n    \"launch_date\": \"2010-09-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"parent789\",\n            \"rating\": 4,\n            \"comment\": \"My child loves playing the games and learning!\"\n        }\n    ],\n    \"access_url\": \"https://www.abcmouse.com\"\n}"}
{"_id": "Academic--digital_learning--p--71835", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Project-based learning\",\n        \"Real-time feedback\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Python basics\",\n                \"Data types\",\n                \"Control flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Regression\",\n                \"Classification\",\n                \"Clustering\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"difficulty\": \"Advanced\",\n            \"topics\": [\n                \"Statistical modeling\",\n                \"Data visualization\",\n                \"Big data\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-02-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science. Very interactive and practical.\"\n        },\n        {\n            \"user_id\": \"456\",\n            \"rating\": 4,\n            \"comment\": \"Great resources and helpful community.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71835", "text": "{\n    \"platform_name\": \"LearnChemE\",\n    \"developer\": \"LearnChemE LLC\",\n    \"features\": [\n        \"Video lectures\",\n        \"Problem solving examples\",\n        \"Course materials\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Chemical Engineering Professionals\"\n    ],\n    \"subscription_model\": \"Paid subscriptions (Individual & Institutional)\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Chemical Engineering Thermodynamics\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Thermodynamic properties\",\n                \"Phase equilibrium\",\n                \"Chemical reactions\"\n            ]\n        },\n        {\n            \"course_name\": \"Transport Phenomena\",\n            \"difficulty\": \"Advanced\",\n            \"topics\": [\n                \"Heat transfer\",\n                \"Mass transfer\",\n                \"Momentum transfer\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2014-11-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"789\",\n            \"rating\": 4,\n            \"comment\": \"Good for focused chemical engineering topics.\"\n        },\n        {\n            \"user_id\": \"101\",\n            \"rating\": 3,\n            \"comment\": \"Could use more interactive features.\"\n        }\n    ],\n    \"access_url\": \"https://learncheme.com\"\n}"}
