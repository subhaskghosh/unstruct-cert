{"_id": "Academic--digital_learning--p--70251", "text": "{\n    \"platform_name\": \"DataLearn Pro\",\n    \"developer\": \"AI EdTech Solutions\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Personalized learning paths\",\n        \"Real-time feedback\",\n        \"Community forums\",\n        \"Project-based learning\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Data Science\",\n            \"level\": \"Beginner\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"16 weeks\"\n        },\n        {\n            \"course_name\": \"Deep Learning with Python\",\n            \"level\": \"Advanced\",\n            \"duration\": \"20 weeks\"\n        }\n    ],\n    \"launch_date\": \"2022-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform with a very intuitive interface and great courses!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Helpful platform for learning data science concepts.\"\n        }\n    ],\n    \"access_url\": \"https://www.datalearnpro.com\"\n}"}
{"_id": "Academic--digital_learning--n--70251", "text": "{\n    \"platform_name\": \"CodeMasters Academy\",\n    \"developer\": \"TechLearn Inc.\",\n    \"features\": [\n        \"Code challenges\",\n        \"Automated grading\",\n        \"Video lectures\",\n        \"Peer review\",\n        \"Advanced algorithm analysis\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Software Engineers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Java Programming\",\n            \"level\": \"Beginner\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"Web Development with React\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"14 weeks\"\n        },\n        {\n            \"course_name\": \"Mobile App Development with Swift\",\n            \"level\": \"Advanced\",\n            \"duration\": \"18 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-03-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Good platform, but the interface is a bit clunky.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4,\n            \"comment\": \"Helpful for improving coding skills.\"\n        }\n    ],\n    \"access_url\": \"https://www.codemastersacademy.net\"\n}"}
