{"_id": "Academic--digital_learning--n--70950", "text": "{\n    \"platform_name\": \"Stanford Online\",\n    \"developer\": \"Stanford University\",\n    \"features\": [\n        \"Video lectures\",\n        \"Assignments\",\n        \"Online forums\",\n        \"Graded exams\",\n        \"Certificate upon completion\"\n    ],\n    \"user_types\": [\n        \"Professional learners\",\n        \"Graduate students\",\n        \"Lifelong learners\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"level\": \"Advanced\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"Statistical Learning\",\n            \"level\": \"Advanced\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2012-05-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Rigorous coursework with high academic standards.\"\n        }\n    ],\n    \"access_url\": \"https://online.stanford.edu\"\n}"}
