{"_id": "Academic--digital_learning--n--70047", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lessons\",\n        \"Practice exercises\",\n        \"Progress tracking\",\n        \"Personalized learning\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Algebra I\",\n            \"level\": \"Beginner\",\n            \"duration\": \"1 semester\"\n        },\n        {\n            \"course_name\": \"Calculus\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"1 year\"\n        },\n        {\n            \"course_name\": \"Statistics\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"1 semester\"\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Jane Smith\",\n            \"rating\": 4,\n            \"comment\": \"Excellent resource for math and science!\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org/\"\n}"}
{"_id": "Academic--digital_learning--p--70048", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill tracks\",\n        \"Project-based learning\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"3 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-20\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice\",\n            \"rating\": 5,\n            \"comment\": \"Great for beginners! Really helped me learn the basics of Python.\"\n        },\n        {\n            \"user\": \"Bob\",\n            \"rating\": 4,\n            \"comment\": \"Good resource for practicing data science skills.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--70048", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Peer-graded assignments\",\n        \"Specializations\",\n        \"Degrees\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Lifelong learners\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"5 courses\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"5 courses\"\n        }\n    ],\n    \"launch_date\": \"2012-05-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Charlie\",\n            \"rating\": 4,\n            \"comment\": \"Excellent courses from top universities.\"\n        },\n        {\n            \"user\": \"David\",\n            \"rating\": 3,\n            \"comment\": \"Can be expensive, but worth it for the quality of education.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org/\"\n}"}
