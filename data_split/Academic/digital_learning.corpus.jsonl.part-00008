{"_id": "Academic--digital_learning--n--70661", "text": "{\n    \"platform_name\": \"LearnSQL.com\",\n    \"developer\": \"Vertical Loom\",\n    \"features\": [\n        \"Interactive SQL tutorials\",\n        \"Real-world database examples\",\n        \"Certification exams\"\n    ],\n    \"user_types\": [\n        \"Database Administrators\",\n        \"Data Analysts\",\n        \"Software Developers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_title\": \"SQL Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"3 weeks\"\n        },\n        {\n            \"course_title\": \"Advanced SQL Techniques\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2019-11-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Decent tutorials but the interface feels a bit dated.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4,\n            \"comment\": \"Good for learning SQL basics.\"\n        }\n    ],\n    \"access_url\": \"https://learnsql.com\"\n}"}
{"_id": "Academic--digital_learning--p--70662", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill tracks\",\n        \"Career tracks\",\n        \"Project portfolio\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"difficulty\": \"Intermediate\",\n            \"duration\": \"6 months\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"difficulty\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science skills. The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great content and well-structured courses. Recommended for beginners.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70662", "text": "{\n    \"platform_name\": \"LearnStreet\",\n    \"developer\": \"LearnStreet Inc.\",\n    \"features\": [\n        \"Code challenges\",\n        \"Mentorship program\",\n        \"Peer learning\",\n        \"Code reviews\"\n    ],\n    \"user_types\": [\n        \"Web Developers\",\n        \"Software Engineers\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"JavaScript Fundamentals\",\n            \"difficulty\": \"Beginner\",\n            \"duration\": \"3 weeks\"\n        },\n        {\n            \"course_name\": \"Advanced Python\",\n            \"difficulty\": \"Intermediate\",\n            \"duration\": \"5 weeks\"\n        }\n    ],\n    \"launch_date\": \"2014-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 2,\n            \"comment\": \"The mentorship program was not very responsive, and the content felt outdated.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3,\n            \"comment\": \"Some useful code challenges, but the overall experience was lacking.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnstreet.com\"\n}"}
{"_id": "Academic--digital_learning--p--70663", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Project-based learning\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"category\": \"Data Science\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Scikit-learn\",\n            \"level\": \"Intermediate\",\n            \"category\": \"Machine Learning\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science!\"\n        },\n        {\n            \"user_id\": \"456\",\n            \"rating\": 4,\n            \"comment\": \"Great interactive exercises.\"\n        },\n        {\n            \"user_id\": \"789\",\n            \"rating\": 5,\n            \"comment\": \"Highly recommend for anyone looking to upskill.\"\n        },\n        {\n            \"user_id\": \"101\",\n            \"rating\": 3,\n            \"comment\": \"Sometimes the explanations are a bit brief.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--70663", "text": "{\n    \"platform_name\": \"LearnWorlds\",\n    \"developer\": \"LearnWorlds Ltd.\",\n    \"features\": [\n        \"Course creation tools\",\n        \"Video hosting\",\n        \"Interactive video\",\n        \"Assessments\",\n        \"Marketing integrations\"\n    ],\n    \"user_types\": [\n        \"Educators\",\n        \"Businesses\",\n        \"Subject Matter Experts\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Digital Marketing Fundamentals\",\n            \"level\": \"Beginner\",\n            \"category\": \"Marketing\"\n        },\n        {\n            \"course_name\": \"Web Development Basics\",\n            \"level\": \"Beginner\",\n            \"category\": \"Web Development\"\n        }\n    ],\n    \"launch_date\": \"2014-09-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"202\",\n            \"rating\": 4,\n            \"comment\": \"Easy to use course builder.\"\n        },\n        {\n            \"user_id\": \"203\",\n            \"rating\": 5,\n            \"comment\": \"Great support team.\"\n        },\n        {\n            \"user_id\": \"204\",\n            \"rating\": 3,\n            \"comment\": \"Could use more customization options.\"\n        },\n        {\n            \"user_id\": \"205\",\n            \"rating\": 2,\n            \"comment\": \"Pricing is a bit high for smaller businesses.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnworlds.com/\"\n}"}
{"_id": "Academic--digital_learning--p--70664", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Scientist with Python\",\n            \"duration\": \"6 months\",\n            \"level\": \"Beginner to Intermediate\"\n        },\n        {\n            \"course_name\": \"Data Analyst with R\",\n            \"duration\": \"4 months\",\n            \"level\": \"Beginner to Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science. Very interactive and practical.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good content and well-structured courses. Helpful for career advancement.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
