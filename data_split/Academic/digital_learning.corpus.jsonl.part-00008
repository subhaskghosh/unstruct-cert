{"_id": "Academic--digital_learning--n--71708", "text": "{\n    \"platform_name\": \"Udacity\",\n    \"developer\": \"Coursera\",\n    \"features\": [\n        \"Nanodegree programs\",\n        \"Mentorship\",\n        \"Project reviews\",\n        \"Career services\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Paid Nanodegree subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Self-Driving Car Engineer Nanodegree\",\n            \"topic\": \"Artificial Intelligence\",\n            \"level\": \"Advanced\"\n        },\n        {\n            \"course_name\": \"Data Analyst Nanodegree\",\n            \"topic\": \"Data Science\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2011-01-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"789\",\n            \"rating\": 3,\n            \"comment\": \"Good content but very expensive. The mentorship is helpful, but not worth the price for some.\"\n        },\n        {\n            \"user_id\": \"101\",\n            \"rating\": 4,\n            \"comment\": \"Excellent program if you can afford it. The projects are challenging and rewarding.\"\n        }\n    ],\n    \"access_url\": \"https://www.udacity.com\"\n}"}
