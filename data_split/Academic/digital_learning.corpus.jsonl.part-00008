{"_id": "Academic--digital_learning--n--71910", "text": "{\n    \"platform_name\": \"Kaplan\",\n    \"developer\": \"Kaplan, Inc.\",\n    \"features\": [\n        \"Live online classes\",\n        \"On-demand video lessons\",\n        \"Practice tests\",\n        \"Personalized study plans\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Test-takers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"SAT Prep\",\n            \"level\": \"High School\",\n            \"description\": \"Comprehensive preparation for the SAT exam.\"\n        },\n        {\n            \"course_name\": \"GRE Prep\",\n            \"level\": \"Graduate\",\n            \"description\": \"Prepare for the GRE exam and improve your score.\"\n        },\n        {\n            \"course_name\": \"LSAT Prep\",\n            \"level\": \"Professional\",\n            \"description\": \"Study materials for the LSAT exam.\"\n        }\n    ],\n    \"launch_date\": \"2010-05-20\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Jane Smith\",\n            \"rating\": 4,\n            \"comment\": \"Good resources for test preparation.\"\n        }\n    ],\n    \"access_url\": \"https://www.kaptest.com\"\n}"}
{"_id": "Academic--digital_learning--p--71911", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Scikit-learn\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Data Visualization with Tableau\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science skills!\"\n        },\n        {\n            \"user_id\": \"456\",\n            \"rating\": 4,\n            \"comment\": \"Very practical and hands-on.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--71911", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lessons\",\n        \"Practice exercises\",\n        \"Progress tracking\",\n        \"Personalized learning\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\",\n        \"Parents\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Calculus 1\",\n            \"level\": \"Beginner\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"Linear Algebra\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Statistics and Probability\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"789\",\n            \"rating\": 5,\n            \"comment\": \"Great resource for basic math and science.\"\n        },\n        {\n            \"user_id\": \"101\",\n            \"rating\": 4,\n            \"comment\": \"Helped me understand difficult concepts.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org/\"\n}"}
{"_id": "Academic--digital_learning--p--71912", "text": "{\n    \"platform_name\": \"Codecademy Pro\",\n    \"developer\": \"Codecademy\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Project-based learning\",\n        \"Career paths\",\n        \"Real-world projects\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Freemium with paid Pro access\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Learn Python 3\",\n            \"level\": \"Beginner\",\n            \"duration\": \"30 hours\"\n        },\n        {\n            \"course_name\": \"Web Development Bootcamp\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"60 hours\"\n        }\n    ],\n    \"launch_date\": \"2018-04-17\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.5,\n            \"comment\": \"Great platform for learning to code, very interactive.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4.2,\n            \"comment\": \"Helped me land my first job as a web developer!\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com/pro\"\n}"}
{"_id": "Academic--digital_learning--n--71912", "text": "{\n    \"platform_name\": \"LearnCloud\",\n    \"developer\": \"EduTech Solutions\",\n    \"features\": [\n        \"Video lectures\",\n        \"Downloadable resources\",\n        \"Quizzes\",\n        \"Discussion boards\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Researchers\"\n    ],\n    \"subscription_model\": \"Paid - Tiered Plans\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Science Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"40 hours\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"50 hours\"\n        }\n    ],\n    \"launch_date\": \"2019-09-22\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3.8,\n            \"comment\": \"Good content, but the interface is a bit clunky.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3.5,\n            \"comment\": \"The quizzes are not very challenging.\"\n        }\n    ],\n    \"access_url\": \"https://www.learncloud.com\"\n}"}
{"_id": "Academic--digital_learning--p--71913", "text": "{\n    \"platform_name\": \"Codecademy Pro\",\n    \"developer\": \"Codecademy\",\n    \"features\": [\n        \"Interactive coding lessons\",\n        \"Project-based learning\",\n        \"Skill paths\",\n        \"Real-world projects\",\n        \"Code editor\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Freemium with Pro subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"30 hours\"\n        },\n        {\n            \"course_name\": \"Web Development Fundamentals\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"50 hours\"\n        }\n    ],\n    \"launch_date\": \"2011-08-24\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Very user-friendly and the projects are really helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com/\"\n}"}
{"_id": "Academic--digital_learning--n--71913", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Quizzes\",\n        \"Peer-graded assignments\",\n        \"Certificates\",\n        \"Specializations\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Lifelong learners\"\n    ],\n    \"subscription_model\": \"Paid courses and specializations\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"60 hours\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"120 hours\"\n        }\n    ],\n    \"launch_date\": \"2012-04-17\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good content, but can be a bit academic.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org/\"\n}"}
