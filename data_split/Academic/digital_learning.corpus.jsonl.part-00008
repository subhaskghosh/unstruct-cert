{"_id": "Academic--digital_learning--n--71297", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lessons\",\n        \"Practice exercises\",\n        \"Progress tracking\",\n        \"Personalized learning\",\n        \"Dashboard for educators\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\",\n        \"Parents\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Algebra I\",\n            \"instructor\": \"Sal Khan\",\n            \"level\": \"Beginner\",\n            \"duration\": \"30 hours\"\n        },\n        {\n            \"course_name\": \"AP Calculus AB\",\n            \"instructor\": \"Sal Khan\",\n            \"level\": \"Advanced\",\n            \"duration\": \"60 hours\"\n        }\n    ],\n    \"launch_date\": \"2006-09-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 5,\n            \"comment\": \"Fantastic resource for K-12 education!  Helped my child immensely.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4,\n            \"comment\": \"Excellent free math resources.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org/\"\n}"}
