{"_id": "Academic--digital_learning--n--71211", "text": "{\n    \"platform_name\": \"ExamPrep Pro\",\n    \"developer\": \"TestMasters Inc.\",\n    \"features\": [\n        \"Practice Exams\",\n        \"Detailed Answer Explanations\",\n        \"Performance Analytics\",\n        \"Timed Mock Tests\"\n    ],\n    \"user_types\": [\n        \"Students\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"SAT Preparation\",\n            \"level\": \"High School\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"ACT Preparation\",\n            \"level\": \"High School\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"GRE Preparation\",\n            \"level\": \"Graduate\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-09-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4,\n            \"comment\": \"Great resource for test preparation. Helped me improve my score!\"\n        },\n        {\n            \"user_id\": \"user101\",\n            \"rating\": 3,\n            \"comment\": \"Could use more variety in the practice questions.\"\n        }\n    ],\n    \"access_url\": \"https://www.exampreppro.com\"\n}"}
{"_id": "Academic--digital_learning--p--71212", "text": "{\n    \"platform_name\": \"SkillBridge\",\n    \"developer\": \"InnovateEd Solutions\",\n    \"features\": [\n        \"Interactive video lectures\",\n        \"Peer-to-peer learning forums\",\n        \"Skill assessments\",\n        \"Personalized learning paths\",\n        \"Project-based assignments\"\n    ],\n    \"user_types\": [\n        \"Professionals\",\n        \"Managers\",\n        \"Career Changers\"\n    ],\n    \"subscription_model\": \"Subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Science Bootcamp\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Project Management Essentials\",\n            \"level\": \"Beginner\",\n            \"duration\": \"6 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for upskilling! Very easy to navigate and the courses are practical.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great content and helpful community. The interactive features really enhance the learning experience.\"\n        }\n    ],\n    \"access_url\": \"https://www.skillbridge.com\"\n}"}
{"_id": "Academic--digital_learning--n--71212", "text": "{\n    \"platform_name\": \"KidsLearn Online\",\n    \"developer\": \"Bright Futures Education\",\n    \"features\": [\n        \"Animated lessons\",\n        \"Interactive games\",\n        \"Progress tracking\",\n        \"Parental controls\"\n    ],\n    \"user_types\": [\n        \"Children\",\n        \"Teachers\",\n        \"Parents\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Reading for Beginners\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Introduction to Math\",\n            \"level\": \"Beginner\",\n            \"duration\": \"6 weeks\"\n        }\n    ],\n    \"launch_date\": \"2022-03-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"parent789\",\n            \"rating\": 4,\n            \"comment\": \"My child loves this platform! The games are engaging and make learning fun.\"\n        },\n        {\n            \"user_id\": \"teacher101\",\n            \"rating\": 5,\n            \"comment\": \"A great resource for supplementing classroom learning. The progress tracking is very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.kidslearnonline.com\"\n}"}
