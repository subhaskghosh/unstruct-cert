{"_id": "Academic--digital_learning--p--71612", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Science Track\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Python\",\n                \"R\",\n                \"Statistics\",\n                \"Data Visualization\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Supervised Learning\",\n                \"Unsupervised Learning\",\n                \"Deep Learning\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-03-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Jane Doe\",\n            \"rating\": 4.5,\n            \"comment\": \"Very user-friendly and practical. The interactive exercises are great!\"\n        },\n        {\n            \"user\": \"John Smith\",\n            \"rating\": 4.0,\n            \"comment\": \"Excellent platform for learning data science. The community is very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71612", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Assignments\",\n        \"Peer assessments\",\n        \"Certificates\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning by Andrew Ng\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Linear Regression\",\n                \"Logistic Regression\",\n                \"Neural Networks\"\n            ]\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"level\": \"Advanced\",\n            \"topics\": [\n                \"Convolutional Neural Networks\",\n                \"Recurrent Neural Networks\",\n                \"Sequence Models\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2012-05-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice Johnson\",\n            \"rating\": 3.5,\n            \"comment\": \"Good content, but the interface can be a bit clunky.\"\n        },\n        {\n            \"user\": \"Bob Williams\",\n            \"rating\": 4.0,\n            \"comment\": \"Great courses, but some specializations are quite expensive.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org\"\n}"}
{"_id": "Academic--digital_learning--p--71613", "text": "{\n    \"platform_name\": \"SciLearn Pro\",\n    \"developer\": \"NovaTech Education\",\n    \"features\": [\n        \"Interactive simulations\",\n        \"Personalized learning paths\",\n        \"Progress tracking\",\n        \"Expert Q&A forums\",\n        \"Gamified learning\"\n    ],\n    \"user_types\": [\n        \"High school students\",\n        \"College students\",\n        \"Lifelong learners\"\n    ],\n    \"subscription_model\": \"Subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Advanced Physics\",\n            \"level\": \"Advanced\",\n            \"description\": \"A comprehensive course covering advanced topics in physics.\"\n        },\n        {\n            \"course_name\": \"Calculus II\",\n            \"level\": \"Advanced\",\n            \"description\": \"Building on Calculus I, this course explores advanced integration techniques and series.\"\n        },\n        {\n            \"course_name\": \"Biochemistry Fundamentals\",\n            \"level\": \"Intermediate\",\n            \"description\": \"An introduction to the principles of biochemistry.\"\n        }\n    ],\n    \"launch_date\": \"2022-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"rating\": 5,\n            \"comment\": \"Highly engaging and well-structured courses!\"\n        },\n        {\n            \"user_id\": \"456\",\n            \"rating\": 4,\n            \"comment\": \"Excellent platform for STEM subjects.\"\n        }\n    ],\n    \"access_url\": \"https://www.scilearnpro.com\"\n}"}
{"_id": "Academic--digital_learning--n--71613", "text": "{\n    \"platform_name\": \"CodeMaster Academy\",\n    \"developer\": \"ByteSolutions Inc.\",\n    \"features\": [\n        \"Code editor\",\n        \"Debugging tools\",\n        \"Project-based learning\",\n        \"Code reviews\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Beginner programmers\",\n        \"Intermediate developers\",\n        \"Experienced coders\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Python for Beginners\",\n            \"level\": \"Beginner\",\n            \"description\": \"An introductory course to Python programming.\"\n        },\n        {\n            \"course_name\": \"JavaScript Fundamentals\",\n            \"level\": \"Beginner\",\n            \"description\": \"Learn the basics of JavaScript.\"\n        },\n        {\n            \"course_name\": \"Data Structures and Algorithms\",\n            \"level\": \"Intermediate\",\n            \"description\": \"Explore common data structures and algorithms.\"\n        }\n    ],\n    \"launch_date\": \"2021-11-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"789\",\n            \"rating\": 4,\n            \"comment\": \"Great for learning to code.\"\n        },\n        {\n            \"user_id\": \"101\",\n            \"rating\": 5,\n            \"comment\": \"Excellent resource for developers.\"\n        }\n    ],\n    \"access_url\": \"https://www.codemasteracademy.com\"\n}"}
{"_id": "Academic--digital_learning--p--71614", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"John Doe\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science. The interactive exercises are very helpful.\"\n        },\n        {\n            \"user\": \"Jane Smith\",\n            \"rating\": 4,\n            \"comment\": \"Good content and well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
