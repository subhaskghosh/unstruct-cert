{"_id": "Academic--digital_learning--p--70776", "text": "{\n    \"platform_name\": \"DataLearn Pro\",\n    \"developer\": \"InnovateEd Tech\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Community forums\",\n        \"Personalized learning paths\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Data Science\",\n            \"level\": \"Beginner\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"16 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.8,\n            \"comment\": \"Excellent platform, very intuitive and well-structured!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4.5,\n            \"comment\": \"Great courses and helpful community.\"\n        }\n    ],\n    \"access_url\": \"https://www.datalearnpro.com\"\n}"}
{"_id": "Academic--digital_learning--n--70776", "text": "{\n    \"platform_name\": \"CodeMaster Academy\",\n    \"developer\": \"DevSkills Inc.\",\n    \"features\": [\n        \"Live coding sessions\",\n        \"Code reviews\",\n        \"Mentorship programs\",\n        \"Career guidance\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Software Engineers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Web Development Bootcamp\",\n            \"level\": \"Beginner\",\n            \"duration\": \"20 weeks\"\n        },\n        {\n            \"course_name\": \"Advanced JavaScript\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"10 weeks\"\n        }\n    ],\n    \"launch_date\": \"2022-03-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3.5,\n            \"comment\": \"The courses are okay, but the platform is a bit clunky.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3.0,\n            \"comment\": \"The interface could be improved.\"\n        }\n    ],\n    \"access_url\": \"https://www.codemasteracademy.net\"\n}"}
{"_id": "Academic--digital_learning--p--70777", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp BV\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Real-world projects\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Scientist with Python\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 months\"\n        },\n        {\n            \"course_name\": \"Machine Learning Scientist with R\",\n            \"level\": \"Advanced\",\n            \"duration\": \"9 months\"\n        }\n    ],\n    \"launch_date\": \"2016-04-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science. The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good content and well-structured courses. A bit expensive, but worth it.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--70777", "text": "{\n    \"platform_name\": \"Udemy\",\n    \"developer\": \"Udemy, Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Course marketplace\",\n        \"Q&A forums\",\n        \"Downloadable resources\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Experts\"\n    ],\n    \"subscription_model\": \"Pay-per-course\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Complete Python Bootcamp\",\n            \"level\": \"Beginner\",\n            \"duration\": \"20 hours\"\n        },\n        {\n            \"course_name\": \"Machine Learning A-Z\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"40 hours\"\n        }\n    ],\n    \"launch_date\": \"2010-05-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"A lot of courses available, but the quality varies significantly.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4,\n            \"comment\": \"Good for learning specific skills, but not a structured learning path.\"\n        }\n    ],\n    \"access_url\": \"https://www.udemy.com/\"\n}"}
{"_id": "Academic--digital_learning--p--70778", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill tracks\",\n        \"Assessment quizzes\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"subject\": \"Data Science\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"subject\": \"Machine Learning\"\n        },\n        {\n            \"course_name\": \"Data Visualization with Tableau\",\n            \"level\": \"Beginner\",\n            \"subject\": \"Data Science\"\n        }\n    ],\n    \"launch_date\": \"2016-02-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science skills.\"\n        },\n        {\n            \"user\": \"Bob\",\n            \"rating\": 4,\n            \"comment\": \"Very interactive and practical.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70778", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video tutorials\",\n        \"Practice exercises\",\n        \"Personalized learning\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Calculus I\",\n            \"level\": \"Beginner\",\n            \"subject\": \"Mathematics\"\n        },\n        {\n            \"course_name\": \"Linear Algebra\",\n            \"level\": \"Intermediate\",\n            \"subject\": \"Mathematics\"\n        },\n        {\n            \"course_name\": \"Statistics and Probability\",\n            \"level\": \"Beginner\",\n            \"subject\": \"Mathematics\"\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Charlie\",\n            \"rating\": 5,\n            \"comment\": \"Excellent resource for math education.\"\n        },\n        {\n            \"user\": \"David\",\n            \"rating\": 4,\n            \"comment\": \"Free and accessible learning.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
{"_id": "Academic--digital_learning--p--70779", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscription tiers\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Science with Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science. Very practical and engaging.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great resources and a well-structured curriculum.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70779", "text": "{\n    \"platform_name\": \"LearnMathOnline\",\n    \"developer\": \"Math Education Group\",\n    \"features\": [\n        \"Pre-recorded video lessons\",\n        \"Practice quizzes\",\n        \"Downloadable worksheets\"\n    ],\n    \"user_types\": [\n        \"Students\"\n    ],\n    \"subscription_model\": \"Paid subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Calculus I\",\n            \"level\": \"Beginner\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Linear Algebra\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"10 weeks\"\n        }\n    ],\n    \"launch_date\": \"2019-11-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Decent platform for basic math concepts, but could be more interactive.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"The subscription is quite expensive for the content offered.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnmathonline.com\"\n}"}
