{"_id": "Academic--digital_learning--n--71988", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lessons\",\n        \"Practice exercises\",\n        \"Personalized learning\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Lifelong learners\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Statistics and Probability\",\n            \"duration\": \"Self-paced\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Calculus\",\n            \"duration\": \"Self-paced\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4,\n            \"comment\": \"Great resource for basic math and science concepts.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3,\n            \"comment\": \"Sometimes the explanations are a bit too simplistic.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
{"_id": "Academic--digital_learning--p--71989", "text": "{\n    \"platform_name\": \"Codecademy Pro\",\n    \"developer\": \"Codecademy\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Real-world projects\",\n        \"Skill paths\",\n        \"Career paths\",\n        \"Code editor\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Freemium (Pro version)\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Bootcamp\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"24 weeks\"\n        },\n        {\n            \"course_name\": \"Full-Stack Web Development\",\n            \"level\": \"Advanced\",\n            \"duration\": \"36 weeks\"\n        }\n    ],\n    \"launch_date\": \"2011-08-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning to code. Very interactive and well-structured.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great resource for brushing up on skills or learning something new.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com/\"\n}"}
{"_id": "Academic--digital_learning--n--71989", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lectures\",\n        \"Practice exercises\",\n        \"Progress tracking\",\n        \"Personalized learning\",\n        \"Articles\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Calculus 1\",\n            \"level\": \"Beginner\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"Linear Algebra\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"15 weeks\"\n        },\n        {\n            \"course_name\": \"Statistics and Probability\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 5,\n            \"comment\": \"A fantastic resource for free education!  Very helpful for understanding complex concepts.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4,\n            \"comment\": \"Great for supplementing schoolwork.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org/\"\n}"}
{"_id": "Academic--digital_learning--p--71990", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp, Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill tracks\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"description\": \"Learn the basics of Python programming.\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"description\": \"Learn data science using the R programming language.\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"description\": \"Learn machine learning algorithms using Python.\",\n            \"level\": \"Advanced\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"John Doe\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science. Very interactive and engaging.\"\n        },\n        {\n            \"user\": \"Jane Smith\",\n            \"rating\": 4,\n            \"comment\": \"Good resources and well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--71990", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lectures\",\n        \"Practice exercises\",\n        \"Personalized learning\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\",\n        \"Parents\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Algebra I\",\n            \"description\": \"Introduction to algebra concepts.\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Calculus AB\",\n            \"description\": \"Calculus course for high school students.\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Statistics and Probability\",\n            \"description\": \"Fundamentals of statistics and probability.\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice Brown\",\n            \"rating\": 4,\n            \"comment\": \"Great resource for math and science. Very helpful for students.\"\n        },\n        {\n            \"user\": \"Bob Williams\",\n            \"rating\": 3,\n            \"comment\": \"Good explanations, but could use more challenging exercises.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org/\"\n}"}
