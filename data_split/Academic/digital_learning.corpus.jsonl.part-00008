{"_id": "Academic--digital_learning--p--70920", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill tracks\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"title\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Python basics\",\n                \"Data types\",\n                \"Control flow\"\n            ]\n        },\n        {\n            \"title\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Regression\",\n                \"Classification\",\n                \"Clustering\"\n            ]\n        },\n        {\n            \"title\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"topics\": [\n                \"Statistical Inference\",\n                \"Machine Learning\",\n                \"Data Visualization\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-07-13\",\n    \"user_feedback\": [\n        {\n            \"user\": \"John Doe\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science. The interactive exercises are really helpful.\"\n        },\n        {\n            \"user\": \"Jane Smith\",\n            \"rating\": 4,\n            \"comment\": \"Very user-friendly and well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--70920", "text": "{\n    \"platform_name\": \"Codecademy\",\n    \"developer\": \"Codecademy\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Project-based learning\",\n        \"Career paths\",\n        \"Quizzes\"\n    ],\n    \"user_types\": [\n        \"Beginners\",\n        \"Students\",\n        \"Software Developers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"title\": \"Learn HTML\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"HTML tags\",\n                \"HTML attributes\",\n                \"Document structure\"\n            ]\n        },\n        {\n            \"title\": \"Learn Python 3\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Variables\",\n                \"Loops\",\n                \"Functions\"\n            ]\n        },\n        {\n            \"title\": \"Data Science Career Path\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Data Manipulation\",\n                \"Data Visualization\",\n                \"Machine Learning\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2011-08-29\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice Brown\",\n            \"rating\": 3,\n            \"comment\": \"Good for beginners, but can feel a bit outdated.\"\n        },\n        {\n            \"user\": \"Bob Green\",\n            \"rating\": 4,\n            \"comment\": \"Helpful for learning basic coding concepts.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com/\"\n}"}
