{"_id": "Academic--digital_learning--n--71671", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lessons\",\n        \"Practice exercises\",\n        \"Progress tracking\",\n        \"Personalized learning\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\",\n        \"Parents\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Calculus 1\",\n            \"level\": \"Beginner\",\n            \"duration\": \"Self-paced\"\n        },\n        {\n            \"course_name\": \"Statistics and Probability\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"Self-paced\"\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"11223\",\n            \"rating\": 5,\n            \"comment\": \"A fantastic resource for learning math and science!\"\n        },\n        {\n            \"user_id\": \"44556\",\n            \"rating\": 4,\n            \"comment\": \"Great for foundational knowledge, but doesn't cover advanced topics.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
{"_id": "Academic--digital_learning--p--71672", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Manipulation with pandas\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"3 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with scikit-learn\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Data Visualization with ggplot2\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Statistical Inference\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"5 weeks\"\n        },\n        {\n            \"course_name\": \"Deep Learning with TensorFlow\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"John Doe\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science!\"\n        },\n        {\n            \"user\": \"Jane Smith\",\n            \"rating\": 4,\n            \"comment\": \"Very interactive and well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
