{"_id": "Academic--digital_learning--n--70904", "text": "{\n    \"platform_name\": \"LearnAI\",\n    \"developer\": \"AI Startups Ltd.\",\n    \"features\": [\n        \"AI-powered learning paths\",\n        \"Personalized feedback\",\n        \"Community forums\"\n    ],\n    \"user_types\": [\n        \"AI Engineers\",\n        \"Machine Learning Researchers\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Deep Learning Fundamentals\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Neural Networks\",\n                \"TensorFlow\",\n                \"Keras\"\n            ]\n        },\n        {\n            \"course_name\": \"Natural Language Processing\",\n            \"difficulty\": \"Advanced\",\n            \"topics\": [\n                \"Sentiment Analysis\",\n                \"Text Summarization\",\n                \"Machine Translation\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2019-05-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Interesting platform, but still in development.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4,\n            \"comment\": \"Good for specific AI topics, but lacks broader coverage.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnai.com\"\n}"}
{"_id": "Academic--digital_learning--p--70905", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill tracks\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Python Syntax\",\n                \"Data Types\",\n                \"Control Flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"R Programming\",\n                \"Data Visualization\",\n                \"Statistical Modeling\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Advanced\",\n            \"topics\": [\n                \"Supervised Learning\",\n                \"Unsupervised Learning\",\n                \"Deep Learning\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-07-12\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science. The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good content and well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
