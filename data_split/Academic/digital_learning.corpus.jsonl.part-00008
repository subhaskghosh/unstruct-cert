{"_id": "Academic--digital_learning--p--70067", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill assessments\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"course_level\": \"Beginner\",\n            \"course_duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"course_level\": \"Intermediate\",\n            \"course_duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"course_level\": \"Advanced\",\n            \"course_duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-07-18\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"12345\",\n            \"rating\": 4.5,\n            \"comment\": \"Excellent platform for learning data science. Very interactive and practical.\"\n        },\n        {\n            \"user_id\": \"67890\",\n            \"rating\": 4.0,\n            \"comment\": \"Good resource, but could use more advanced courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70067", "text": "{\n    \"platform_name\": \"Codecademy\",\n    \"developer\": \"Codecademy\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Project-based learning\",\n        \"Career paths\",\n        \"Code challenges\"\n    ],\n    \"user_types\": [\n        \"Beginners\",\n        \"Web Developers\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Learn HTML\",\n            \"course_level\": \"Beginner\",\n            \"course_duration\": \"2 weeks\"\n        },\n        {\n            \"course_name\": \"JavaScript Basics\",\n            \"course_level\": \"Beginner\",\n            \"course_duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Introduction to Machine Learning\",\n            \"course_level\": \"Beginner\",\n            \"course_duration\": \"5 weeks\"\n        }\n    ],\n    \"launch_date\": \"2011-08-25\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"abc12\",\n            \"rating\": 3.0,\n            \"comment\": \"A decent platform for beginners, but I found the support lacking.\"\n        },\n        {\n            \"user_id\": \"def34\",\n            \"rating\": 3.8,\n            \"comment\": \"Good for learning the basics, but not very in-depth.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com\"\n}"}
