{"_id": "Academic--digital_learning--n--70684", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Assignments\",\n        \"Peer assessments\",\n        \"Specializations\",\n        \"Degrees\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Lifelong Learners\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"5 courses\"\n        },\n        {\n            \"course_name\": \"Data Science Methodology\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        }\n    ],\n    \"launch_date\": \"2012-04-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good quality courses, but can be expensive.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org\"\n}"}
{"_id": "Academic--digital_learning--p--70685", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python for Data Science\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-04-22\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"rating\": 5,\n            \"comment\": \"DataCamp is an innovative platform that made learning data science fun and accessible!\"\n        },\n        {\n            \"user_id\": \"456\",\n            \"rating\": 4,\n            \"comment\": \"Excellent resource for upskilling in data analysis.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70685", "text": "{\n    \"platform_name\": \"Udemy\",\n    \"developer\": \"Udemy, Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Downloadable resources\",\n        \"Quizzes\",\n        \"Certificates of completion\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Lifelong Learners\"\n    ],\n    \"subscription_model\": \"Paid Levels\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Complete Python Bootcamp\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science A-Z\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"10 weeks\"\n        }\n    ],\n    \"launch_date\": \"2010-05-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"789\",\n            \"rating\": 3,\n            \"comment\": \"Udemy has a wide range of courses, but the quality can vary.\"\n        },\n        {\n            \"user_id\": \"012\",\n            \"rating\": 4,\n            \"comment\": \"Good value for the price, but not always the most cutting-edge content.\"\n        }\n    ],\n    \"access_url\": \"https://www.udemy.com\"\n}"}
{"_id": "Academic--digital_learning--p--70686", "text": "{\n    \"platform_name\": \"DataLearn Pro\",\n    \"developer\": \"InnovateEd Inc.\",\n    \"features\": [\n        \"Interactive Coding Exercises\",\n        \"Personalized Learning Paths\",\n        \"Project-Based Learning\",\n        \"Community Forums\",\n        \"Progress Tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Science Professionals\",\n        \"Researchers\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Data Science\",\n            \"level\": \"Beginner\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"16 weeks\"\n        },\n        {\n            \"course_name\": \"Deep Learning with Python\",\n            \"level\": \"Advanced\",\n            \"duration\": \"20 weeks\"\n        }\n    ],\n    \"launch_date\": \"2022-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.5,\n            \"comment\": \"Very user-friendly interface and excellent content. The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 5.0,\n            \"comment\": \"A great platform for learning data science. The instructors are knowledgeable and the courses are well-structured.\"\n        }\n    ],\n    \"access_url\": \"https://www.datalearnpro.com\"\n}"}
{"_id": "Academic--digital_learning--n--70686", "text": "{\n    \"platform_name\": \"TradeSkills Academy\",\n    \"developer\": \"SkillsFuture Ltd.\",\n    \"features\": [\n        \"Hands-on Workshops\",\n        \"Certification Exams\",\n        \"Job Placement Assistance\",\n        \"Industry Expert Instructors\",\n        \"Career Counseling\"\n    ],\n    \"user_types\": [\n        \"Job Seekers\",\n        \"Career Changers\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Analytics Bootcamp\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"SQL for Data Professionals\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-11-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4.0,\n            \"comment\": \"Excellent for quickly gaining job-ready skills. The career services are very helpful.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3.5,\n            \"comment\": \"Good platform for those looking to upskill for a specific job role.\"\n        }\n    ],\n    \"access_url\": \"https://www.tradeskillsacademy.com\"\n}"}
