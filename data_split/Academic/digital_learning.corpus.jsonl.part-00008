{"_id": "Academic--digital_learning--n--70671", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lectures\",\n        \"Practice exercises\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\",\n        \"Lifelong Learners\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Statistics and Probability\",\n            \"level\": \"Beginner\",\n            \"duration\": \"Self-paced\"\n        },\n        {\n            \"course_name\": \"Calculus 1\",\n            \"level\": \"Beginner\",\n            \"duration\": \"Self-paced\"\n        },\n        {\n            \"course_name\": \"Linear Algebra\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"Self-paced\"\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 5,\n            \"comment\": \"Amazing resource for free education!\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4,\n            \"comment\": \"Very helpful for understanding complex concepts.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
{"_id": "Academic--digital_learning--p--70672", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Project-based learning\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Data scientists\",\n        \"Data analysts\",\n        \"Engineers\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Scientist with Python\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 months\",\n            \"topics\": [\n                \"Python\",\n                \"Data analysis\",\n                \"Machine learning\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning Scientist with R\",\n            \"level\": \"Advanced\",\n            \"duration\": \"9 months\",\n            \"topics\": [\n                \"R\",\n                \"Statistical modeling\",\n                \"Deep learning\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-02-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science skills. The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good content and well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70672", "text": "{\n    \"platform_name\": \"Codecademy\",\n    \"developer\": \"Codecademy, Inc.\",\n    \"features\": [\n        \"Interactive coding tutorials\",\n        \"Career paths\",\n        \"Projects\",\n        \"Quizzes\"\n    ],\n    \"user_types\": [\n        \"Beginners\",\n        \"Students\",\n        \"Career changers\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"2 months\",\n            \"topics\": [\n                \"Python basics\",\n                \"Data types\",\n                \"Control flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"3 months\",\n            \"topics\": [\n                \"Data analysis\",\n                \"Visualization\",\n                \"Statistics\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2011-08-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4,\n            \"comment\": \"Great for getting started with coding.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3,\n            \"comment\": \"Some courses are a bit too basic.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com\"\n}"}
{"_id": "Academic--digital_learning--p--70673", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscription tiers\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Advanced\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science skills. The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good content, but could use more real-world case studies.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--70673", "text": "{\n    \"platform_name\": \"LearnMath\",\n    \"developer\": \"Math Solutions Ltd.\",\n    \"features\": [\n        \"Video tutorials\",\n        \"Practice problems\",\n        \"Quizzes\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Paid subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Algebra 1\",\n            \"level\": \"Beginner\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Calculus II\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"Geometry\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2018-11-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4,\n            \"comment\": \"A solid resource for math students. Clear explanations and helpful practice problems.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3,\n            \"comment\": \"The interface is a bit outdated and clunky.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnmath.org/\"\n}"}
