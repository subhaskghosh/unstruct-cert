{"_id": "Academic--digital_learning--n--71177", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lectures\",\n        \"Practice exercises\",\n        \"Personalized learning\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"K-12 Students\",\n        \"Teachers\",\n        \"Lifelong Learners\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Calculus\",\n            \"level\": \"High School\",\n            \"duration\": \"1 year\"\n        },\n        {\n            \"course_name\": \"Linear Algebra\",\n            \"level\": \"College\",\n            \"duration\": \"1 semester\"\n        },\n        {\n            \"course_name\": \"Statistics and Probability\",\n            \"level\": \"High School\",\n            \"duration\": \"1 semester\"\n        }\n    ],\n    \"launch_date\": \"2006-09-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Charlie\",\n            \"rating\": 5,\n            \"comment\": \"Excellent resource for students of all ages.\"\n        },\n        {\n            \"user\": \"David\",\n            \"rating\": 4,\n            \"comment\": \"Clear and concise explanations.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
{"_id": "Academic--digital_learning--p--71178", "text": "{\n    \"platform_name\": \"SkillForge\",\n    \"developer\": \"InnovateEd Solutions\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Peer-to-peer learning\",\n        \"Project-based assignments\",\n        \"Personalized learning paths\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Working professionals\",\n        \"Career changers\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Python for Data Science\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\",\n            \"price\": 99.99\n        },\n        {\n            \"course_name\": \"Digital Marketing Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\",\n            \"price\": 79.99\n        }\n    ],\n    \"launch_date\": \"2021-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.5,\n            \"comment\": \"Excellent platform for upskilling. The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 5.0,\n            \"comment\": \"Great content and supportive community!\"\n        }\n    ],\n    \"access_url\": \"https://www.skillforge.com\"\n}"}
{"_id": "Academic--digital_learning--n--71178", "text": "{\n    \"platform_name\": \"EduSpark\",\n    \"developer\": \"LearnBright Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Quizzes\",\n        \"Downloadable resources\",\n        \"Teacher dashboards\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\",\n        \"Parents\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Elementary Math\",\n            \"level\": \"Beginner\",\n            \"duration\": \"1 semester\",\n            \"price\": 49.99\n        },\n        {\n            \"course_name\": \"Introduction to Science\",\n            \"level\": \"Beginner\",\n            \"duration\": \"1 semester\",\n            \"price\": 59.99\n        }\n    ],\n    \"launch_date\": \"2022-03-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4.0,\n            \"comment\": \"Good resource for elementary school students.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3.5,\n            \"comment\": \"Could use more interactive elements.\"\n        }\n    ],\n    \"access_url\": \"https://www.eduspark.org\"\n}"}
{"_id": "Academic--digital_learning--p--71179", "text": "{\n    \"platform_name\": \"SkillForge\",\n    \"developer\": \"LearnTech Solutions\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Project-based learning\",\n        \"Personalized learning paths\",\n        \"Community forum\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Freemium with premium tiers\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Science Bootcamp\",\n            \"description\": \"A comprehensive course on data science fundamentals and applications.\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Web Development Masterclass\",\n            \"description\": \"Learn full-stack web development with modern frameworks.\",\n            \"level\": \"Advanced\"\n        }\n    ],\n    \"launch_date\": \"2021-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.5,\n            \"comment\": \"SkillForge helped me land a job in data science. The projects were very relevant to real-world scenarios.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4.0,\n            \"comment\": \"Great platform for practical learning. The interface is user-friendly and the support is responsive.\"\n        }\n    ],\n    \"access_url\": \"https://www.skillforge.com\"\n}"}
{"_id": "Academic--digital_learning--n--71179", "text": "{\n    \"platform_name\": \"EduCentral\",\n    \"developer\": \"Global Education Group\",\n    \"features\": [\n        \"Video lectures\",\n        \"Quizzes\",\n        \"Discussion boards\",\n        \"Resource library\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Paid subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Ancient History 101\",\n            \"description\": \"A survey of ancient civilizations.\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Shakespearean Literature\",\n            \"description\": \"An in-depth study of Shakespeare's plays.\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2022-11-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3.0,\n            \"comment\": \"Good course selection, but the platform is a bit outdated and complex to navigate.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3.5,\n            \"comment\": \"The content is good, but the interface could be more intuitive.\"\n        }\n    ],\n    \"access_url\": \"https://www.educentral.org\"\n}"}
{"_id": "Academic--digital_learning--p--71180", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Individual learners\",\n        \"Corporate teams\",\n        \"Data scientists\",\n        \"Data analysts\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Python fundamentals\",\n                \"Data structures\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Regression\",\n                \"Classification\",\n                \"Clustering\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"difficulty\": \"Advanced\",\n            \"topics\": [\n                \"Statistical inference\",\n                \"Data visualization\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science skills. The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good value for the price. The courses are well-structured and engaging.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71180", "text": "{\n    \"platform_name\": \"LearnMath\",\n    \"developer\": \"Math Education Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Practice problems\",\n        \"Homework assignments\",\n        \"Quizzes\",\n        \"Discussion boards\"\n    ],\n    \"user_types\": [\n        \"High school students\",\n        \"College students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Algebra I\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Linear equations\",\n                \"Inequalities\"\n            ]\n        },\n        {\n            \"course_name\": \"Calculus II\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Integration\",\n                \"Series\"\n            ]\n        },\n        {\n            \"course_name\": \"Geometry\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Shapes\",\n                \"Angles\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2019-05-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Decent platform for math, but the user interface is a bit clunky.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4,\n            \"comment\": \"Helpful for reviewing concepts, but not very engaging.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnmath.org\"\n}"}
{"_id": "Academic--digital_learning--p--71181", "text": "{\n    \"platform_name\": \"DataLearn Pro\",\n    \"developer\": \"InnovateEd Solutions\",\n    \"features\": [\n        \"Interactive Coding Exercises\",\n        \"Video Lectures\",\n        \"Project-Based Learning\",\n        \"Personalized Learning Paths\",\n        \"Community Forums\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium with Paid Pro Access\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Data Science\",\n            \"instructor\": \"Dr. Emily Carter\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"instructor\": \"David Lee\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"Python for Data Analysis\",\n            \"instructor\": \"Sarah Chen\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Deep Learning with TensorFlow\",\n            \"instructor\": \"Dr. John Smith\",\n            \"duration\": \"15 weeks\"\n        },\n        {\n            \"course_name\": \"Data Visualization with Tableau\",\n            \"instructor\": \"Maria Rodriguez\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Advanced Machine Learning\",\n            \"instructor\": \"Dr. Emily Carter\",\n            \"duration\": \"14 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great courses and helpful instructors.\"\n        }\n    ],\n    \"access_url\": \"https://www.datalearnpro.com\"\n}"}
{"_id": "Academic--digital_learning--n--71181", "text": "{\n    \"platform_name\": \"EduTech Hub\",\n    \"developer\": \"Global Learning Inc.\",\n    \"features\": [\n        \"Live Classes\",\n        \"Study Materials\",\n        \"Exam Preparation\",\n        \"Teacher-Student Communication\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Tiered Subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Algebra I\",\n            \"instructor\": \"Mr. Johnson\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"Calculus II\",\n            \"instructor\": \"Ms. Williams\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Physics for Beginners\",\n            \"instructor\": \"Dr. Brown\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Chemistry Essentials\",\n            \"instructor\": \"Mrs. Davis\",\n            \"duration\": \"9 weeks\"\n        }\n    ],\n    \"launch_date\": \"2022-03-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Decent platform, but could be improved.\"\n        },\n        {\n            \"user_id\": \"user101\",\n            \"rating\": 2,\n            \"comment\": \"The interface is not very user-friendly.\"\n        }\n    ],\n    \"access_url\": \"https://www.edutechhub.org\"\n}"}
