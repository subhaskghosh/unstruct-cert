{"_id": "Academic--digital_learning--n--71947", "text": "{\n    \"platform_name\": \"LearnEasy\",\n    \"developer\": \"SmallTech Innovations\",\n    \"features\": [\n        \"Video Lectures\",\n        \"Quizzes\",\n        \"Downloadable Resources\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Beginners\"\n    ],\n    \"subscription_model\": \"Paid (Monthly)\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Basic Web Development\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        }\n    ],\n    \"launch_date\": \"2022-01-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Decent platform, but a bit basic for advanced learners.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"The interface could be more appealing.\"\n        }\n    ],\n    \"access_url\": \"https://www.learneasy.net\"\n}"}
{"_id": "Academic--digital_learning--p--71948", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Individual learners\",\n        \"Educational institutions\",\n        \"Data Scientists\",\n        \"Data Analysts\"\n    ],\n    \"subscription_model\": \"Freemium with paid tiers\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"subject\": \"Data Science\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Machine Learning with scikit-learn\",\n            \"subject\": \"Machine Learning\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"John Doe\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science!\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71948", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lectures\",\n        \"Practice exercises\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Algebra I\",\n            \"subject\": \"Mathematics\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"US History\",\n            \"subject\": \"History\",\n            \"level\": \"Beginner\"\n        }\n    ],\n    \"launch_date\": \"2006-09-16\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Jane Smith\",\n            \"rating\": 4,\n            \"comment\": \"Great resource for basic education.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
{"_id": "Academic--digital_learning--p--71949", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Python Syntax\",\n                \"Data Structures\",\n                \"Control Flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with scikit-learn\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Regression\",\n                \"Classification\",\n                \"Clustering\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"topics\": [\n                \"Statistics\",\n                \"Data Visualization\",\n                \"Machine Learning\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science! The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Excellent course content and well-structured learning paths.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--71949", "text": "{\n    \"platform_name\": \"LearnCentral\",\n    \"developer\": \"EduTech Solutions Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Downloadable resources\",\n        \"Discussion forums\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Statistics\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Descriptive Statistics\",\n                \"Probability\",\n                \"Inferential Statistics\"\n            ]\n        },\n        {\n            \"course_name\": \"Web Development Fundamentals\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"HTML\",\n                \"CSS\",\n                \"JavaScript\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2022-11-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"The platform is alright, but I experienced several bugs with the video player and the interface feels outdated.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"I found the course content to be somewhat shallow and the support team was unresponsive.\"\n        }\n    ],\n    \"access_url\": \"https://www.learncentral.org/\"\n}"}
{"_id": "Academic--digital_learning--p--71950", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Instructors\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"subject\": \"Data Science\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"subject\": \"Machine Learning\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Data Visualization with Tableau\",\n            \"subject\": \"Data Science\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2016-01-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.5,\n            \"comment\": \"Great platform for learning data science!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4.0,\n            \"comment\": \"Helpful and engaging courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71950", "text": "{\n    \"platform_name\": \"ArtHistoryOnline\",\n    \"developer\": \"Academic Arts Institute\",\n    \"features\": [\n        \"Video lectures\",\n        \"Reading materials\",\n        \"Online quizzes\",\n        \"Discussion forums\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Art Historians\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Renaissance Art\",\n            \"subject\": \"Art History\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Modern Art Movements\",\n            \"subject\": \"Art History\",\n            \"level\": \"Advanced\"\n        }\n    ],\n    \"launch_date\": \"2019-12-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"artlover789\",\n            \"rating\": 3.5,\n            \"comment\": \"Good content, but the interface is a bit outdated.\"\n        }\n    ],\n    \"access_url\": \"https://www.arthistoryonline.org\"\n}"}
{"_id": "Academic--digital_learning--p--71951", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill tracks\",\n        \"Project-based learning\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"category\": \"Data Science\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"category\": \"Artificial Intelligence\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Data Visualization with Tableau\",\n            \"category\": \"Data Science\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science skills! The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good value for money and a wide range of courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71951", "text": "{\n    \"platform_name\": \"LearnAdvancedMath\",\n    \"developer\": \"MathPro Solutions\",\n    \"features\": [\n        \"Pre-recorded video lectures\",\n        \"Practice problems\",\n        \"Downloadable resources\",\n        \"Advanced mathematical concepts\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Researchers\",\n        \"Engineers\"\n    ],\n    \"subscription_model\": \"Paid levels\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Advanced Calculus\",\n            \"category\": \"Mathematics\",\n            \"level\": \"Advanced\"\n        },\n        {\n            \"course_name\": \"Linear Algebra\",\n            \"category\": \"Mathematics\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Differential Equations\",\n            \"category\": \"Mathematics\",\n            \"level\": \"Advanced\"\n        }\n    ],\n    \"launch_date\": \"2019-11-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Useful for advanced math, but the interface is a bit clunky.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"Very expensive for the content provided.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnadvancedmath.com\"\n}"}
{"_id": "Academic--digital_learning--p--71952", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lessons\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Educators\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"title\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"title\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"title\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science. Very interactive and practical.\"\n        },\n        {\n            \"user\": \"Bob\",\n            \"rating\": 4,\n            \"comment\": \"Excellent courses and well-structured curriculum.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71952", "text": "{\n    \"platform_name\": \"LearnVerse\",\n    \"developer\": \"EduTech Solutions Inc.\",\n    \"features\": [\n        \"Pre-recorded video lectures\",\n        \"Downloadable course materials\",\n        \"Discussion forums\",\n        \"Quizzes\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Researchers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"title\": \"Fundamentals of Statistics\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"title\": \"Advanced Calculus\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"10 weeks\"\n        }\n    ],\n    \"launch_date\": \"2020-05-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Charlie\",\n            \"rating\": 3,\n            \"comment\": \"The course content is good, but the platform is a bit outdated.\"\n        },\n        {\n            \"user\": \"David\",\n            \"rating\": 2,\n            \"comment\": \"Difficult to navigate and lacking interactive features.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnverse.edu\"\n}"}
{"_id": "Academic--digital_learning--p--71953", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice\",\n            \"rating\": 5,\n            \"comment\": \"DataCamp is great for beginners! The interactive exercises really help you learn.\"\n        },\n        {\n            \"user\": \"Bob\",\n            \"rating\": 4,\n            \"comment\": \"Easy to use and well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71953", "text": "{\n    \"platform_name\": \"LearnAI\",\n    \"developer\": \"AI Innovations Ltd.\",\n    \"features\": [\n        \"Advanced machine learning algorithms\",\n        \"Research papers\",\n        \"Expert lectures\",\n        \"Collaborative coding environment\"\n    ],\n    \"user_types\": [\n        \"Researchers\",\n        \"Advanced Data Scientists\",\n        \"Engineers\"\n    ],\n    \"subscription_model\": \"Paid Levels\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Deep Learning with TensorFlow\",\n            \"level\": \"Advanced\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Reinforcement Learning\",\n            \"level\": \"Expert\",\n            \"duration\": \"16 weeks\"\n        }\n    ],\n    \"launch_date\": \"2019-05-20\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Charlie\",\n            \"rating\": 4,\n            \"comment\": \"Excellent resource for advanced AI concepts.\"\n        },\n        {\n            \"user\": \"David\",\n            \"rating\": 3,\n            \"comment\": \"A bit complex for beginners.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnai.com\"\n}"}
{"_id": "Academic--digital_learning--p--71954", "text": "{\n    \"platform_name\": \"SkillForge\",\n    \"developer\": \"InnovateEd Solutions\",\n    \"features\": [\n        \"Interactive Coding Challenges\",\n        \"Project-Based Learning\",\n        \"Personalized Learning Paths\",\n        \"Code Review\",\n        \"Community Forums\"\n    ],\n    \"user_types\": [\n        \"Professionals\",\n        \"Students\",\n        \"Career Changers\"\n    ],\n    \"subscription_model\": \"Freemium with Premium Plans\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Advanced Python for Data Science\",\n            \"duration\": \"12 weeks\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Full Stack JavaScript Development\",\n            \"duration\": \"16 weeks\",\n            \"level\": \"Beginner\"\n        }\n    ],\n    \"launch_date\": \"2019-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for hands-on learning! The coding challenges are very effective.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great resource for upskilling. The community support is fantastic.\"\n        }\n    ],\n    \"access_url\": \"https://www.skillforge.com\"\n}"}
{"_id": "Academic--digital_learning--n--71954", "text": "{\n    \"platform_name\": \"EduStream\",\n    \"developer\": \"Global Learning Inc.\",\n    \"features\": [\n        \"Live Video Lectures\",\n        \"Recorded Sessions\",\n        \"Downloadable Resources\",\n        \"Quizzes\",\n        \"Discussion Boards\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Lifelong Learners\"\n    ],\n    \"subscription_model\": \"Paid Subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Machine Learning\",\n            \"duration\": \"8 weeks\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Data Analysis with Excel\",\n            \"duration\": \"6 weeks\",\n            \"level\": \"Beginner\"\n        }\n    ],\n    \"launch_date\": \"2020-07-22\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4,\n            \"comment\": \"Good content, but mostly based on watching videos.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3,\n            \"comment\": \"Lectures are well-presented, but I wish there were more practical exercises.\"\n        }\n    ],\n    \"access_url\": \"https://www.edustream.net\"\n}"}
{"_id": "Academic--digital_learning--p--71955", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill tracks\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"description\": \"Learn the basics of Python programming.\"\n        },\n        {\n            \"course_name\": \"Machine Learning with scikit-learn\",\n            \"level\": \"Intermediate\",\n            \"description\": \"Build and deploy machine learning models using scikit-learn.\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Intermediate\",\n            \"description\": \"Comprehensive data science curriculum.\"\n        }\n    ],\n    \"launch_date\": \"2016-02-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Interactive exercises are very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71955", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Peer assessments\",\n        \"Quizzes\",\n        \"Certification programs\",\n        \"Specializations\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Lifelong Learners\"\n    ],\n    \"subscription_model\": \"Paid Levels\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"level\": \"Beginner\",\n            \"description\": \"Andrew Ng's popular machine learning course.\"\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"level\": \"Intermediate\",\n            \"description\": \"A series of courses on deep learning.\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Intermediate\",\n            \"description\": \"Comprehensive data science curriculum from Johns Hopkins University.\"\n        }\n    ],\n    \"launch_date\": \"2012-05-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4,\n            \"comment\": \"Excellent course quality but can be expensive.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3,\n            \"comment\": \"Good content, but the peer grading can be inconsistent.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org\"\n}"}
{"_id": "Academic--digital_learning--p--71956", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Paid levels (monthly, annual, enterprise)\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"subject\": \"Programming\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"subject\": \"Data Science\"\n        },\n        {\n            \"course_name\": \"Data Visualization with Tableau\",\n            \"level\": \"Intermediate\",\n            \"subject\": \"Data Analysis\"\n        }\n    ],\n    \"launch_date\": \"2016-02-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Jane Doe\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science skills!\"\n        },\n        {\n            \"user\": \"John Smith\",\n            \"rating\": 4,\n            \"comment\": \"Very interactive and engaging courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71956", "text": "{\n    \"platform_name\": \"Codecademy\",\n    \"developer\": \"Codecademy\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Project-based learning\",\n        \"Quizzes\",\n        \"Career paths\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Beginners\"\n    ],\n    \"subscription_model\": \"Freemium (basic courses free, Pro subscription for full access)\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to HTML\",\n            \"level\": \"Beginner\",\n            \"subject\": \"Web Development\"\n        },\n        {\n            \"course_name\": \"Learn JavaScript\",\n            \"level\": \"Beginner\",\n            \"subject\": \"Web Development\"\n        },\n        {\n            \"course_name\": \"Data Science Fundamentals\",\n            \"level\": \"Beginner\",\n            \"subject\": \"Data Science\"\n        }\n    ],\n    \"launch_date\": \"2011-08-22\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice Johnson\",\n            \"rating\": 3,\n            \"comment\": \"Good for basic learning, but lacks depth.\"\n        },\n        {\n            \"user\": \"Bob Williams\",\n            \"rating\": 4,\n            \"comment\": \"User-friendly interface and clear explanations.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com\"\n}"}
{"_id": "Academic--digital_learning--p--71957", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Project-based learning\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science. The interactive exercises are very helpful.\"\n        },\n        {\n            \"user\": \"Bob\",\n            \"rating\": 4,\n            \"comment\": \"Good content and well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71957", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lectures\",\n        \"Practice exercises\",\n        \"Personalized learning\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Statistics and Probability\",\n            \"level\": \"Beginner\",\n            \"duration\": \"Self-paced\"\n        },\n        {\n            \"course_name\": \"Calculus\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"Self-paced\"\n        },\n        {\n            \"course_name\": \"AP Computer Science Principles\",\n            \"level\": \"High School\",\n            \"duration\": \"Year-long\"\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Charlie\",\n            \"rating\": 4,\n            \"comment\": \"Great resource for free education!\"\n        },\n        {\n            \"user\": \"David\",\n            \"rating\": 3,\n            \"comment\": \"Good introductory material, but not very in-depth.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
