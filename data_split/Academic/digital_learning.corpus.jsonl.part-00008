{"_id": "Academic--digital_learning--n--70652", "text": "{\n    \"platform_name\": \"LearnWorlds\",\n    \"developer\": \"LearnWorlds\",\n    \"features\": [\n        \"Course creation tools\",\n        \"Interactive video\",\n        \"Community features\",\n        \"Analytics\"\n    ],\n    \"user_types\": [\n        \"Educators\",\n        \"Course Creators\",\n        \"Businesses\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Digital Marketing Fundamentals\",\n            \"difficulty\": \"Beginner\",\n            \"category\": \"Marketing\"\n        },\n        {\n            \"course_name\": \"Web Development Bootcamp\",\n            \"difficulty\": \"Intermediate\",\n            \"category\": \"Technology\"\n        }\n    ],\n    \"launch_date\": \"2014-03-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3.8,\n            \"comment\": \"Good platform for creating online courses.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4.0,\n            \"comment\": \"Easy to use but limited customization options.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnworlds.com/\"\n}"}
{"_id": "Academic--digital_learning--p--70653", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill assessments\",\n        \"Project-based learning\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"difficulty\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"difficulty\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-04-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science. The interactive exercises are very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--70653", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lectures\",\n        \"Practice exercises\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Calculus I\",\n            \"difficulty\": \"Beginner\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"Linear Algebra\",\n            \"difficulty\": \"Intermediate\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Statistics and Probability\",\n            \"difficulty\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great resource for math and science. Very accessible.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org/\"\n}"}
{"_id": "Academic--digital_learning--p--70654", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Scientist with Python\",\n            \"difficulty\": \"Intermediate\",\n            \"duration\": \"6 months\"\n        },\n        {\n            \"course_name\": \"Data Engineer with SQL\",\n            \"difficulty\": \"Beginner\",\n            \"duration\": \"3 months\"\n        }\n    ],\n    \"launch_date\": \"2016-05-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science. The interactive exercises are very helpful.\"\n        },\n        {\n            \"user\": \"Bob\",\n            \"rating\": 4,\n            \"comment\": \"Good content, but the interface could be more modern.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70654", "text": "{\n    \"platform_name\": \"CodeCombat\",\n    \"developer\": \"CodeCombat\",\n    \"features\": [\n        \"Game-based learning\",\n        \"Coding challenges\",\n        \"Multiplayer modes\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Paid subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Programming\",\n            \"difficulty\": \"Beginner\",\n            \"duration\": \"Self-paced\"\n        },\n        {\n            \"course_name\": \"Python Basics\",\n            \"difficulty\": \"Beginner\",\n            \"duration\": \"Self-paced\"\n        }\n    ],\n    \"launch_date\": \"2013-01-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Charlie\",\n            \"rating\": 4,\n            \"comment\": \"My kids love this platform! It makes learning to code fun.\"\n        },\n        {\n            \"user\": \"David\",\n            \"rating\": 3,\n            \"comment\": \"Could use more advanced content.\"\n        }\n    ],\n    \"access_url\": \"https://codecombat.com\"\n}"}
{"_id": "Academic--digital_learning--p--70655", "text": "{\n    \"platform_name\": \"SkillForge\",\n    \"developer\": \"LearnTech Solutions Inc.\",\n    \"features\": [\n        \"Interactive lessons\",\n        \"Progress tracking\",\n        \"Mobile app\",\n        \"Personalized learning paths\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Professionals\",\n        \"Students\",\n        \"Managers\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"title\": \"Project Management Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"title\": \"Data Analytics with Python\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-03-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice Smith\",\n            \"rating\": 5,\n            \"comment\": \"The mobile app is fantastic! Very easy to use and well-designed.\"\n        },\n        {\n            \"user\": \"Bob Johnson\",\n            \"rating\": 4,\n            \"comment\": \"Great courses for upskilling, and the free tier is generous.\"\n        }\n    ],\n    \"access_url\": \"https://www.skillforge.com\"\n}"}
{"_id": "Academic--digital_learning--n--70655", "text": "{\n    \"platform_name\": \"EduCentral\",\n    \"developer\": \"Global Education Group\",\n    \"features\": [\n        \"Video lectures\",\n        \"Quizzes\",\n        \"Downloadable resources\",\n        \"Certificate of completion\"\n    ],\n    \"user_types\": [\n        \"High school students\",\n        \"College students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"title\": \"Algebra I\",\n            \"level\": \"Beginner\",\n            \"duration\": \"1 semester\"\n        },\n        {\n            \"title\": \"World History\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"1 year\"\n        }\n    ],\n    \"launch_date\": \"2022-09-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Charlie Brown\",\n            \"rating\": 3,\n            \"comment\": \"The website is okay, but the mobile app is buggy and needs improvement.\"\n        },\n        {\n            \"user\": \"Diana Davis\",\n            \"rating\": 2,\n            \"comment\": \"Content is good, but the app constantly crashes.\"\n        }\n    ],\n    \"access_url\": \"https://www.educentral.org\"\n}"}
{"_id": "Academic--digital_learning--p--70656", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp BV\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill assessments\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"comment\": \"Great platform for learning data science, very easy to follow along.\"\n        },\n        {\n            \"user_id\": \"456\",\n            \"comment\": \"The interactive exercises are very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
