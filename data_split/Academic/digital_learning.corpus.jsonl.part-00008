{"_id": "Academic--digital_learning--p--70559", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp, Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Students\",\n        \"Business Professionals\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"title\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Python basics\",\n                \"Data types\",\n                \"Control flow\"\n            ]\n        },\n        {\n            \"title\": \"Machine Learning with scikit-learn\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Supervised learning\",\n                \"Unsupervised learning\",\n                \"Model evaluation\"\n            ]\n        },\n        {\n            \"title\": \"Data Visualization with ggplot2\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"ggplot2 syntax\",\n                \"Data aesthetics\",\n                \"Statistical graphics\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"rating\": 5,\n            \"comment\": \"Highly engaging and effective for learning data science skills.\"\n        },\n        {\n            \"user_id\": \"456\",\n            \"rating\": 4,\n            \"comment\": \"The interactive exercises are a great way to practice.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
