{"_id": "Academic--digital_learning--p--71917", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Project-based learning\",\n        \"Real-time feedback\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"course_level\": \"Beginner\",\n            \"course_duration\": \"3 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning Scientist with Python\",\n            \"course_level\": \"Intermediate/Advanced\",\n            \"course_duration\": \"6 months\"\n        },\n        {\n            \"course_name\": \"Data Visualization with R\",\n            \"course_level\": \"Beginner\",\n            \"course_duration\": \"2 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science skills. The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great content and well-structured courses. I highly recommend it!\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
