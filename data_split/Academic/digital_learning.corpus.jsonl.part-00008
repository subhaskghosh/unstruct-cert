{"_id": "Academic--digital_learning--p--70069", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill assessments\",\n        \"Project-based learning\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"subject\": \"Programming\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"subject\": \"Data Science\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Data Visualization with Tableau\",\n            \"subject\": \"Data Science\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.5,\n            \"comment\": \"Excellent platform for learning data science skills. Helped me land a job!\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
