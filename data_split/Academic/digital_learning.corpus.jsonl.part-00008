{"_id": "Academic--digital_learning--p--71607", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill assessments\",\n        \"Project-based learning\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscription tiers\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Python basics\",\n                \"Data manipulation\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Supervised learning\",\n                \"Unsupervised learning\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"topics\": [\n                \"Statistical Modeling\",\n                \"Data Visualization\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-02-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"comment\": \"Great platform for hands-on practice with real-world datasets!\",\n            \"rating\": 5\n        },\n        {\n            \"user_id\": \"user456\",\n            \"comment\": \"The interactive exercises are incredibly practical and helpful for learning.\",\n            \"rating\": 4\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
