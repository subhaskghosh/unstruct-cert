{"_id": "Academic--digital_learning--p--70925", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Project-based learning\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium (limited access) / Paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Scientist with Python\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Python\",\n                \"Data Analysis\",\n                \"Machine Learning\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Supervised Learning\",\n                \"Unsupervised Learning\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-01-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"12345\",\n            \"rating\": 4.5,\n            \"comment\": \"Great platform for learning data science skills interactively.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
