{"_id": "Academic--digital_learning--p--71312", "text": "{\n    \"platform_name\": \"TechSkills Academy\",\n    \"developer\": \"Innovate Learning Solutions\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Project-based learning\",\n        \"Personalized learning paths\",\n        \"Community forum\",\n        \"Certification programs\"\n    ],\n    \"user_types\": [\n        \"Working professionals\",\n        \"Career changers\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Tiered subscription (Basic, Premium, Pro)\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Python for Data Science\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Full Stack Web Development\",\n            \"level\": \"Advanced\",\n            \"duration\": \"16 weeks\"\n        },\n        {\n            \"course_name\": \"Cloud Computing Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for upskilling! The courses are well-structured and the instructors are knowledgeable.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great content, but the UI could be a bit more intuitive.\"\n        }\n    ],\n    \"access_url\": \"https://www.techskillsacademy.com\"\n}"}
{"_id": "Academic--digital_learning--n--71312", "text": "{\n    \"platform_name\": \"EduWorld\",\n    \"developer\": \"Global Education Network\",\n    \"features\": [\n        \"Video lectures\",\n        \"Quizzes\",\n        \"Discussion boards\",\n        \"Downloadable resources\"\n    ],\n    \"user_types\": [\n        \"High school students\",\n        \"College students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Algebra I\",\n            \"level\": \"Beginner\",\n            \"duration\": \"1 semester\"\n        },\n        {\n            \"course_name\": \"World History\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"1 year\"\n        },\n        {\n            \"course_name\": \"Biology\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"1 semester\"\n        }\n    ],\n    \"launch_date\": \"2022-03-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Decent platform for basic subjects, but lacks advanced topics.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"The website is cluttered and difficult to navigate.\"\n        }\n    ],\n    \"access_url\": \"https://www.eduworld.org\"\n}"}
