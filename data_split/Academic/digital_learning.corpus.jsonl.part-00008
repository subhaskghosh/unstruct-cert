{"_id": "Academic--digital_learning--n--71484", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lessons\",\n        \"Practice exercises\",\n        \"Progress tracking\",\n        \"Personalized learning\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Algebra I\",\n            \"level\": \"Beginner\",\n            \"topic\": \"Mathematics\"\n        },\n        {\n            \"course_name\": \"AP Calculus AB\",\n            \"level\": \"Advanced\",\n            \"topic\": \"Calculus\"\n        },\n        {\n            \"course_name\": \"US History\",\n            \"level\": \"Intermediate\",\n            \"topic\": \"History\"\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4.5,\n            \"comment\": \"Fantastic resource for K-12 students.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 5,\n            \"comment\": \"Helped me understand math concepts much better.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
{"_id": "Academic--digital_learning--p--71485", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Project-based learning\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscription tiers\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"subject\": \"Programming\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"subject\": \"Data Science\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"subject\": \"Machine Learning\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2016-01-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.5,\n            \"comment\": \"Great interactive platform for learning data science!\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71485", "text": "{\n    \"platform_name\": \"MIT OpenCourseware\",\n    \"developer\": \"Massachusetts Institute of Technology\",\n    \"features\": [\n        \"Lecture videos\",\n        \"Course materials\",\n        \"Assignments\",\n        \"Exams\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Self-learners\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"6.0001 Introduction to Computer Science and Programming in Python\",\n            \"subject\": \"Computer Science\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"18.06 Linear Algebra\",\n            \"subject\": \"Mathematics\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"6.036 Introduction to Machine Learning\",\n            \"subject\": \"Machine Learning\",\n            \"level\": \"Advanced\"\n        }\n    ],\n    \"launch_date\": \"2001-01-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4.0,\n            \"comment\": \"Excellent resource for accessing high-quality course materials.\"\n        }\n    ],\n    \"access_url\": \"https://ocw.mit.edu\"\n}"}
{"_id": "Academic--digital_learning--p--71486", "text": "{\n    \"platform_name\": \"SciLearn Pro\",\n    \"developer\": \"NovaTech Education\",\n    \"features\": [\n        \"Interactive Simulations\",\n        \"Personalized Learning Paths\",\n        \"Progress Tracking\",\n        \"Gamified Learning\",\n        \"Collaborative Projects\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Researchers\"\n    ],\n    \"subscription_model\": \"Freemium with Premium Options\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Advanced Physics\",\n            \"level\": \"University\",\n            \"instructor\": \"Dr. Anya Sharma\"\n        },\n        {\n            \"course_name\": \"Data Science Bootcamp\",\n            \"level\": \"Intermediate\",\n            \"instructor\": \"Ben Carter\"\n        }\n    ],\n    \"launch_date\": \"2023-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for in-depth STEM learning!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Very engaging and helpful for understanding complex concepts.\"\n        }\n    ],\n    \"access_url\": \"https://www.scilearnpro.com\"\n}"}
{"_id": "Academic--digital_learning--n--71486", "text": "{\n    \"platform_name\": \"LearnBasic\",\n    \"developer\": \"SimpleEd Solutions\",\n    \"features\": [\n        \"Video Lectures\",\n        \"Quiz Assessments\",\n        \"Basic Exercises\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Parents\"\n    ],\n    \"subscription_model\": \"Paid Subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Algebra\",\n            \"level\": \"High School\",\n            \"instructor\": \"Sarah Johnson\"\n        },\n        {\n            \"course_name\": \"Basic Grammar\",\n            \"level\": \"Elementary\",\n            \"instructor\": \"David Lee\"\n        }\n    ],\n    \"launch_date\": \"2022-11-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Good for beginners, but lacks advanced content.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"The platform feels outdated and the UI is clunky.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnbasic.net\"\n}"}
{"_id": "Academic--digital_learning--p--71487", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Project-based learning\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Students\",\n        \"Business Professionals\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"course_level\": \"Beginner\",\n            \"course_duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"course_level\": \"Intermediate\",\n            \"course_duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"course_level\": \"Advanced\",\n            \"course_duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science!\"\n        },\n        {\n            \"user_id\": \"456\",\n            \"rating\": 4,\n            \"comment\": \"Excellent interactive courses.\"\n        },\n        {\n            \"user_id\": \"789\",\n            \"rating\": 5,\n            \"comment\": \"Highly recommend for anyone looking to upskill.\"\n        },\n        {\n            \"user_id\": \"101\",\n            \"rating\": 4,\n            \"comment\": \"Practical and well-structured learning paths.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71487", "text": "{\n    \"platform_name\": \"LearnHistoryOnline\",\n    \"developer\": \"HistoryEd LLC\",\n    \"features\": [\n        \"Video lectures\",\n        \"Reading materials\",\n        \"Quizzes\",\n        \"Discussion forums\"\n    ],\n    \"user_types\": [\n        \"History Students\",\n        \"History Enthusiasts\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Ancient Rome\",\n            \"course_level\": \"Beginner\",\n            \"course_duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"World War II\",\n            \"course_level\": \"Intermediate\",\n            \"course_duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"The Renaissance\",\n            \"course_level\": \"Advanced\",\n            \"course_duration\": \"15 weeks\"\n        }\n    ],\n    \"launch_date\": \"2018-05-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"111\",\n            \"rating\": 3,\n            \"comment\": \"Good content, but a bit dry.\"\n        },\n        {\n            \"user_id\": \"222\",\n            \"rating\": 2,\n            \"comment\": \"Website is outdated and difficult to navigate.\"\n        },\n        {\n            \"user_id\": \"333\",\n            \"rating\": 4,\n            \"comment\": \"The lectures are informative.\"\n        },\n        {\n            \"user_id\": \"444\",\n            \"rating\": 1,\n            \"comment\": \"Poor customer support.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnhistoryonline.com\"\n}"}
{"_id": "Academic--digital_learning--p--71488", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill tracks\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Python basics\",\n                \"Data types\",\n                \"Control flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"R programming\",\n                \"Statistical analysis\",\n                \"Data visualization\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Supervised learning\",\n                \"Unsupervised learning\",\n                \"Model evaluation\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-01-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science! The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good content and well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
