{"_id": "Academic--digital_learning--n--71848", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lessons\",\n        \"Practice exercises\",\n        \"Personalized learning\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Algebra I\",\n            \"subject\": \"Mathematics\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Calculus\",\n            \"subject\": \"Mathematics\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"AP Statistics\",\n            \"subject\": \"Statistics\",\n            \"level\": \"Advanced\"\n        }\n    ],\n    \"launch_date\": \"2006-09-16\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"789\",\n            \"rating\": 5,\n            \"comment\": \"Amazing resource for free education!\"\n        },\n        {\n            \"user_id\": \"101\",\n            \"rating\": 4,\n            \"comment\": \"Excellent explanations and practice problems.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
{"_id": "Academic--digital_learning--p--71849", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill assessments\",\n        \"Project-based learning\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Python Basics\",\n                \"Data Structures\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Regression\",\n                \"Classification\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"topics\": [\n                \"Statistical Modeling\",\n                \"Big Data\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.5,\n            \"comment\": \"Great platform for learning data science in a hands-on way.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--71849", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Quizzes\",\n        \"Peer assignments\",\n        \"Certificates\",\n        \"Discussion forums\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Lifelong learners\"\n    ],\n    \"subscription_model\": \"Paid levels\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Theoretical Physics I\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Classical Mechanics\",\n                \"Electromagnetism\"\n            ]\n        },\n        {\n            \"course_name\": \"History of Art\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Renaissance\",\n                \"Baroque\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2012-04-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4.0,\n            \"comment\": \"Excellent courses, but some can be quite challenging and require strong foundational knowledge.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org/\"\n}"}
{"_id": "Academic--digital_learning--p--71850", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"subject\": \"Data Science\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Machine Learning with scikit-learn\",\n            \"subject\": \"Artificial Intelligence\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Deep Learning with TensorFlow\",\n            \"subject\": \"Artificial Intelligence\",\n            \"level\": \"Advanced\"\n        }\n    ],\n    \"launch_date\": \"2016-01-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science! The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great content and well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71850", "text": "{\n    \"platform_name\": \"SimpleLearnKids\",\n    \"developer\": \"Educational Games Inc.\",\n    \"features\": [\n        \"Basic math games\",\n        \"Alphabet learning\",\n        \"Coloring activities\"\n    ],\n    \"user_types\": [\n        \"Children\",\n        \"Parents\",\n        \"Early Childhood Educators\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Counting to 10\",\n            \"subject\": \"Mathematics\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"ABC Song\",\n            \"subject\": \"Literacy\",\n            \"level\": \"Beginner\"\n        }\n    ],\n    \"launch_date\": \"2022-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"parent789\",\n            \"rating\": 3,\n            \"comment\": \"Good for very young children, but not challenging enough for older kids.\"\n        }\n    ],\n    \"access_url\": \"https://www.simplelearnkids.com\"\n}"}
{"_id": "Academic--digital_learning--p--71851", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp, Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill tracks\",\n        \"Project-based learning\",\n        \"Real-time feedback\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python for Data Science\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science! Very interactive and well-structured.\"\n        },\n        {\n            \"user\": \"Bob\",\n            \"rating\": 4,\n            \"comment\": \"Great courses and helpful community.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--71851", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lessons\",\n        \"Practice exercises\",\n        \"Personalized learning dashboards\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Calculus 1\",\n            \"level\": \"Beginner\",\n            \"duration\": \"Self-paced\"\n        },\n        {\n            \"course_name\": \"Statistics\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"Self-paced\"\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Charlie\",\n            \"rating\": 5,\n            \"comment\": \"A wonderful resource for learning math and science.\"\n        },\n        {\n            \"user\": \"David\",\n            \"rating\": 4,\n            \"comment\": \"Very helpful and accessible educational content.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org/\"\n}"}
{"_id": "Academic--digital_learning--p--71852", "text": "{\n    \"platform_name\": \"Codecademy Pro\",\n    \"developer\": \"Codecademy\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career paths\",\n        \"Real-world projects\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Freemium with Pro options (up to $49.99/month)\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Learn Python 3\",\n            \"difficulty\": \"Beginner\",\n            \"duration\": \"30 hours\"\n        },\n        {\n            \"course_name\": \"Data Science Path\",\n            \"difficulty\": \"Intermediate\",\n            \"duration\": \"100 hours\"\n        }\n    ],\n    \"launch_date\": \"2011-04-05\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning to code!\"\n        },\n        {\n            \"user\": \"Bob\",\n            \"rating\": 4,\n            \"comment\": \"Helpful and engaging courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com/\"\n}"}
{"_id": "Academic--digital_learning--n--71852", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Assignments\",\n        \"Peer assessments\",\n        \"Certificates\",\n        \"Specializations\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Lifelong Learners\"\n    ],\n    \"subscription_model\": \"Subscription based (varying levels, some exceeding $50/month)\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"difficulty\": \"Intermediate\",\n            \"duration\": \"50 hours\"\n        },\n        {\n            \"course_name\": \"Financial Markets\",\n            \"difficulty\": \"Advanced\",\n            \"duration\": \"60 hours\"\n        }\n    ],\n    \"launch_date\": \"2012-05-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Charlie\",\n            \"rating\": 4,\n            \"comment\": \"Good course selection, but can be expensive.\"\n        },\n        {\n            \"user\": \"David\",\n            \"rating\": 3,\n            \"comment\": \"Some courses are very theoretical.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org/\"\n}"}
