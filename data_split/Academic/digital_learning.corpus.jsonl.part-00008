{"_id": "Academic--digital_learning--p--71965", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Community forum\",\n        \"Skill assessments\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Subscription (various tiers)\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with scikit-learn\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 months\"\n        }\n    ],\n    \"launch_date\": \"2016-01-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"John Doe\",\n            \"rating\": 4.5,\n            \"comment\": \"Great platform for learning data science!\"\n        },\n        {\n            \"user\": \"Jane Smith\",\n            \"rating\": 4.0,\n            \"comment\": \"Practical exercises are very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--71965", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Assignments\",\n        \"Peer assessments\",\n        \"Discussion forums\",\n        \"Certificates\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Lifelong Learners\"\n    ],\n    \"subscription_model\": \"Freemium / Paid Courses\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"5 courses\"\n        },\n        {\n            \"course_name\": \"Data Science Ethics\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        }\n    ],\n    \"launch_date\": \"2012-05-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice Brown\",\n            \"rating\": 4.2,\n            \"comment\": \"Good range of courses, but some are expensive.\"\n        },\n        {\n            \"user\": \"Bob Wilson\",\n            \"rating\": 3.8,\n            \"comment\": \"Excellent instructors, but the platform can be a bit slow.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org/\"\n}"}
{"_id": "Academic--digital_learning--p--71966", "text": "{\n    \"platform_name\": \"LearnSphere\",\n    \"developer\": \"EduTech Innovations Inc.\",\n    \"features\": [\n        \"Interactive Video Lectures\",\n        \"Personalized Learning Paths\",\n        \"Peer-to-Peer Collaboration\",\n        \"Progress Tracking\",\n        \"Gamified Quizzes\"\n    ],\n    \"user_types\": [\n        \"University Students\",\n        \"Professors\",\n        \"Lifelong Learners\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Psychology\",\n            \"level\": \"Undergraduate\",\n            \"instructor\": \"Dr. Emily Carter\"\n        },\n        {\n            \"course_name\": \"Calculus I\",\n            \"level\": \"Undergraduate\",\n            \"instructor\": \"Dr. David Lee\"\n        }\n    ],\n    \"launch_date\": \"2021-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent course quality and engaging learning experience!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Very helpful platform for understanding complex concepts.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnsphere.com\"\n}"}
{"_id": "Academic--digital_learning--n--71966", "text": "{\n    \"platform_name\": \"CodeCraft Academy\",\n    \"developer\": \"TechSkills Ltd.\",\n    \"features\": [\n        \"Live Coding Sessions\",\n        \"Project-Based Learning\",\n        \"Code Review\",\n        \"Career Services\"\n    ],\n    \"user_types\": [\n        \"Aspiring Developers\",\n        \"Career Changers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Full Stack Web Development\",\n            \"level\": \"Intermediate\",\n            \"instructor\": \"John Smith\"\n        },\n        {\n            \"course_name\": \"Data Science Bootcamp\",\n            \"level\": \"Advanced\",\n            \"instructor\": \"Alice Johnson\"\n        }\n    ],\n    \"launch_date\": \"2022-05-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4,\n            \"comment\": \"Great for learning practical coding skills.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecraftacademy.com\"\n}"}
{"_id": "Academic--digital_learning--p--71967", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp BV\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill tracks\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Analysts\",\n        \"Engineers\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"description\": \"Learn the basics of Python programming.\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"description\": \"Build and evaluate machine learning models using R.\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"description\": \"A comprehensive data science curriculum.\",\n            \"level\": \"Advanced\"\n        }\n    ],\n    \"launch_date\": \"2016-02-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"John Doe\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science!\"\n        },\n        {\n            \"user\": \"Jane Smith\",\n            \"rating\": 4,\n            \"comment\": \"Great interactive exercises.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71967", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lessons\",\n        \"Practice exercises\",\n        \"Personalized learning\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\",\n        \"Parents\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Algebra I\",\n            \"description\": \"Introduction to algebraic concepts.\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Calculus AB\",\n            \"description\": \"Calculus course for high school students.\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"AP Physics\",\n            \"description\": \"Advanced physics course.\",\n            \"level\": \"Advanced\"\n        }\n    ],\n    \"launch_date\": \"2006-09-10\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice Brown\",\n            \"rating\": 5,\n            \"comment\": \"Wonderful resource for students!\"\n        },\n        {\n            \"user\": \"Bob Green\",\n            \"rating\": 4,\n            \"comment\": \"Helpful for understanding math concepts.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
{"_id": "Academic--digital_learning--p--71968", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium/Paid subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Python Syntax\",\n                \"Data Structures\",\n                \"Control Flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Data Wrangling\",\n                \"Statistical Modeling\",\n                \"Machine Learning\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Supervised Learning\",\n                \"Unsupervised Learning\",\n                \"Deep Learning\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-01-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science from scratch! Very engaging and well-structured courses.\"\n        },\n        {\n            \"user\": \"Bob\",\n            \"rating\": 4,\n            \"comment\": \"Excellent resource for practicing coding skills.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71968", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Quizzes\",\n        \"Peer assessments\",\n        \"Certificates\",\n        \"Specializations\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Paid subscription/Individual course purchase\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Regression\",\n                \"Classification\",\n                \"Clustering\"\n            ]\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"level\": \"Advanced\",\n            \"topics\": [\n                \"Neural Networks\",\n                \"Convolutional Neural Networks\",\n                \"Recurrent Neural Networks\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Ethics\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Bias in Algorithms\",\n                \"Data Privacy\",\n                \"Responsible AI\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2012-05-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Charlie\",\n            \"rating\": 4,\n            \"comment\": \"Good course selection, but can be expensive.\"\n        },\n        {\n            \"user\": \"David\",\n            \"rating\": 3,\n            \"comment\": \"Some courses are outdated.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org\"\n}"}
