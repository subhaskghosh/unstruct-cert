{"_id": "Academic--digital_learning--p--70391", "text": "{\n    \"platform_name\": \"LearnSphere\",\n    \"developer\": \"EduTech Solutions Inc.\",\n    \"features\": [\n        \"Interactive video lectures\",\n        \"Personalized learning paths\",\n        \"Collaborative discussion forums\",\n        \"Progress tracking\",\n        \"Certificate of completion\"\n    ],\n    \"user_types\": [\n        \"University students\",\n        \"Professors\",\n        \"Lifelong learners\"\n    ],\n    \"subscription_model\": \"Freemium with premium course access\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Data Science\",\n            \"level\": \"Beginner\",\n            \"instructor\": \"Dr. Anya Sharma\"\n        },\n        {\n            \"course_name\": \"Advanced Calculus II\",\n            \"level\": \"Intermediate\",\n            \"instructor\": \"Professor Ben Carter\"\n        }\n    ],\n    \"launch_date\": \"2021-05-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice Johnson\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform! The community is incredibly supportive.\"\n        },\n        {\n            \"user\": \"Bob Williams\",\n            \"rating\": 4,\n            \"comment\": \"Great courses and easy to use.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnsphere.com\"\n}"}
{"_id": "Academic--digital_learning--n--70391", "text": "{\n    \"platform_name\": \"SkillUp Now\",\n    \"developer\": \"Global Learning Corp\",\n    \"features\": [\n        \"On-demand video tutorials\",\n        \"Skill assessments\",\n        \"Job board integration\",\n        \"Coding challenges\"\n    ],\n    \"user_types\": [\n        \"Professionals\",\n        \"Job seekers\",\n        \"Corporate trainers\"\n    ],\n    \"subscription_model\": \"Paid monthly subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Python for Beginners\",\n            \"level\": \"Beginner\",\n            \"instructor\": \"Jane Doe\"\n        },\n        {\n            \"course_name\": \"Digital Marketing Fundamentals\",\n            \"level\": \"Intermediate\",\n            \"instructor\": \"John Smith\"\n        }\n    ],\n    \"launch_date\": \"2022-11-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Charlie Brown\",\n            \"rating\": 3,\n            \"comment\": \"Good content, but lacking in community interaction.\"\n        },\n        {\n            \"user\": \"Diana Miller\",\n            \"rating\": 4,\n            \"comment\": \"Helpful for career development.\"\n        }\n    ],\n    \"access_url\": \"https://www.skillupnow.net\"\n}"}
