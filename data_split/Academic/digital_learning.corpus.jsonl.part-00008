{"_id": "Academic--digital_learning--n--70427", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Peer assessments\",\n        \"Quizzes\",\n        \"Projects\",\n        \"Certifications\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Lifelong Learners\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"difficulty\": \"Advanced\",\n            \"topics\": [\n                \"Neural Networks\",\n                \"Deep Learning\",\n                \"Reinforcement Learning\"\n            ]\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"difficulty\": \"Advanced\",\n            \"topics\": [\n                \"Convolutional Networks\",\n                \"Recurrent Networks\",\n                \"LSTMs\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Data Mining\",\n                \"Statistical Inference\",\n                \"Regression Models\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2012-05-10\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice Brown\",\n            \"rating\": 4,\n            \"comment\": \"High-quality courses from top universities.\"\n        },\n        {\n            \"user\": \"Bob White\",\n            \"rating\": 3,\n            \"comment\": \"Can be expensive but worth it for the certifications.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org\"\n}"}
