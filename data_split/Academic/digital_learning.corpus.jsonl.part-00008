{"_id": "Academic--digital_learning--p--71823", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill tracks\",\n        \"Project-based learning\",\n        \"Data visualization tools\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"30 hours\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"40 hours\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"100 hours\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"rating\": 4.5,\n            \"comment\": \"Excellent platform for learning data science!\"\n        },\n        {\n            \"user_id\": \"456\",\n            \"rating\": 4.2,\n            \"comment\": \"Very interactive and engaging courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71823", "text": "{\n    \"platform_name\": \"LearnVerse\",\n    \"developer\": \"EduTech Solutions Inc.\",\n    \"features\": [\n        \"Pre-recorded video lectures\",\n        \"Downloadable course materials\",\n        \"Basic quizzes\",\n        \"Forum discussions\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Python Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"20 hours\"\n        },\n        {\n            \"course_name\": \"Introduction to Machine Learning\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"30 hours\"\n        }\n    ],\n    \"launch_date\": \"2021-05-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"789\",\n            \"rating\": 2.8,\n            \"comment\": \"Content is outdated and the interface is clunky.\"\n        },\n        {\n            \"user_id\": \"101\",\n            \"rating\": 3.1,\n            \"comment\": \"The quizzes are too easy and don't test understanding.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnverse.org\"\n}"}
{"_id": "Academic--digital_learning--p--71824", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Python basics\",\n                \"Data types\",\n                \"Control flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Regression\",\n                \"Classification\",\n                \"Clustering\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"topics\": [\n                \"Data mining\",\n                \"Statistical modeling\",\n                \"Big data\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science. The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4.8,\n            \"comment\": \"Great content and well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71824", "text": "{\n    \"platform_name\": \"LearnPhysicsOnline\",\n    \"developer\": \"Physics Education Group\",\n    \"features\": [\n        \"Video lectures\",\n        \"Practice problems\",\n        \"Online quizzes\",\n        \"Forum discussions\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Classical Mechanics\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Newton's laws\",\n                \"Energy\",\n                \"Momentum\"\n            ]\n        },\n        {\n            \"course_name\": \"Electromagnetism\",\n            \"level\": \"Advanced\",\n            \"topics\": [\n                \"Electric fields\",\n                \"Magnetic fields\",\n                \"Maxwell's equations\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2021-05-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4,\n            \"comment\": \"Good platform for physics students, but could use more interactive elements.\"\n        },\n        {\n            \"user_id\": \"user101\",\n            \"rating\": 3.5,\n            \"comment\": \"Helpful, but sometimes the explanations are a bit too dense.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnphysicsonline.com\"\n}"}
