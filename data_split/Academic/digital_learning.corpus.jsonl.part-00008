{"_id": "Academic--digital_learning--p--70790", "text": "{\n    \"platform_name\": \"SkillForge\",\n    \"developer\": \"InnovateEd Solutions\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Project-based learning\",\n        \"Personalized learning paths\",\n        \"Community forums\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Professionals\",\n        \"Students\",\n        \"Career changers\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Python for Data Science\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Project Management Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"6 weeks\"\n        }\n    ],\n    \"launch_date\": \"2018-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"SkillForge helped me gain practical skills in data analysis. The projects were very relevant to my work.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great platform for learning new technologies. The interactive exercises are very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.skillforge.com\"\n}"}
{"_id": "Academic--digital_learning--n--70790", "text": "{\n    \"platform_name\": \"EduCentral\",\n    \"developer\": \"Global Learning Corp\",\n    \"features\": [\n        \"Video lectures\",\n        \"Quizzes\",\n        \"Downloadable resources\",\n        \"Discussion boards\"\n    ],\n    \"user_types\": [\n        \"High school students\",\n        \"College students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"AP Calculus\",\n            \"level\": \"Advanced\",\n            \"duration\": \"1 semester\"\n        },\n        {\n            \"course_name\": \"World History\",\n            \"level\": \"Beginner\",\n            \"duration\": \"1 year\"\n        }\n    ],\n    \"launch_date\": \"2016-03-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Good for exam preparation but lacks real-world applications.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4,\n            \"comment\": \"The course materials are well-organized and easy to follow.\"\n        }\n    ],\n    \"access_url\": \"https://www.educentral.org\"\n}"}
{"_id": "Academic--digital_learning--p--70791", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp, Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Advanced\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science!\"\n        },\n        {\n            \"user_id\": \"456\",\n            \"rating\": 4,\n            \"comment\": \"Interactive exercises are very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
