{"_id": "Academic--digital_learning--p--71097", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill tracks\",\n        \"Project-based learning\",\n        \"Assessment quizzes\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Educators\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Python basics\",\n                \"Data structures\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Regression\",\n                \"Classification\",\n                \"Clustering\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"difficulty\": \"Advanced\",\n            \"topics\": [\n                \"Data mining\",\n                \"Statistical modeling\",\n                \"Big data\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.5,\n            \"comment\": \"Great platform for learning data science!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4.2,\n            \"comment\": \"Interactive exercises are very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71097", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lessons\",\n        \"Practice exercises\",\n        \"Progress tracking\",\n        \"Personalized learning\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\",\n        \"Parents\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Statistics and probability\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Data analysis\",\n                \"Probability\"\n            ]\n        },\n        {\n            \"course_name\": \"Calculus 1\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Limits\",\n                \"Derivatives\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4.8,\n            \"comment\": \"Excellent free resource for learning.\"\n        },\n        {\n            \"user_id\": \"user101\",\n            \"rating\": 4.6,\n            \"comment\": \"Very helpful for understanding basic concepts.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
{"_id": "Academic--digital_learning--p--71098", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill assessments\",\n        \"Career tracks\",\n        \"Project portfolio\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Freemium with paid tiers\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"subject\": \"Data Science\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"difficulty\": \"Intermediate\",\n            \"subject\": \"Data Science\"\n        },\n        {\n            \"course_name\": \"Full Stack Web Development\",\n            \"difficulty\": \"Intermediate\",\n            \"subject\": \"Software Engineering\"\n        }\n    ],\n    \"launch_date\": \"2016-02-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science! Very practical.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great interactive courses.  A bit pricey, but worth it.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71098", "text": "{\n    \"platform_name\": \"LearnCentral\",\n    \"developer\": \"EduTech Solutions\",\n    \"features\": [\n        \"Pre-recorded video lectures\",\n        \"Downloadable course materials\",\n        \"Basic quizzes\"\n    ],\n    \"user_types\": [\n        \"Students\"\n    ],\n    \"subscription_model\": \"Paid subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introductory Statistics\",\n            \"difficulty\": \"Beginner\",\n            \"subject\": \"Mathematics\"\n        },\n        {\n            \"course_name\": \"Basic Programming Concepts\",\n            \"difficulty\": \"Beginner\",\n            \"subject\": \"Computer Science\"\n        }\n    ],\n    \"launch_date\": \"2019-11-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Content is a bit outdated and the interface is clunky.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"Not very engaging.  Lacks interactive elements.\"\n        }\n    ],\n    \"access_url\": \"https://www.learncentral.org\"\n}"}
{"_id": "Academic--digital_learning--p--71099", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill tracks\",\n        \"Career tracks\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Individual Learners\",\n        \"Corporate Training\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Python syntax\",\n                \"Data types\",\n                \"Control flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Regression\",\n                \"Classification\",\n                \"Clustering\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"topics\": [\n                \"Statistics\",\n                \"Data visualization\",\n                \"Big data\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"John Doe\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science! Very interactive and user-friendly.\"\n        },\n        {\n            \"user\": \"Jane Smith\",\n            \"rating\": 4,\n            \"comment\": \"Excellent course selection and a helpful community.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71099", "text": "{\n    \"platform_name\": \"Codecademy\",\n    \"developer\": \"Codecademy\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Project-based learning\",\n        \"Career paths\"\n    ],\n    \"user_types\": [\n        \"Individual Learners\"\n    ],\n    \"subscription_model\": \"Paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Learn HTML\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"HTML tags\",\n                \"HTML attributes\",\n                \"Document structure\"\n            ]\n        },\n        {\n            \"course_name\": \"Learn CSS\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"CSS selectors\",\n                \"CSS properties\",\n                \"Layout\"\n            ]\n        },\n        {\n            \"course_name\": \"Introduction to JavaScript\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Variables\",\n                \"Data types\",\n                \"Functions\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2011-08-03\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice Johnson\",\n            \"rating\": 3,\n            \"comment\": \"Good for beginners, but lacks depth in more advanced topics.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com\"\n}"}
{"_id": "Academic--digital_learning--p--71100", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Skill tracks\",\n        \"Project-based learning\",\n        \"Real-world datasets\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topic\": \"Programming\"\n        },\n        {\n            \"course_name\": \"Data Science A-Z\",\n            \"level\": \"Intermediate\",\n            \"topic\": \"Data Science\"\n        },\n        {\n            \"course_name\": \"Machine Learning Scientist with Python\",\n            \"level\": \"Advanced\",\n            \"topic\": \"Machine Learning\"\n        }\n    ],\n    \"launch_date\": \"2016-01-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.5,\n            \"comment\": \"Excellent platform for learning data science. Very interactive and practical.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4.2,\n            \"comment\": \"Great for getting hands-on experience with data science tools.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--71100", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Assignments\",\n        \"Peer assessments\",\n        \"Certificates\",\n        \"Specializations\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Lifelong Learners\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"level\": \"Intermediate\",\n            \"topic\": \"Machine Learning\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Intermediate\",\n            \"topic\": \"Data Science\"\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"level\": \"Advanced\",\n            \"topic\": \"Deep Learning\"\n        }\n    ],\n    \"launch_date\": \"2012-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3.8,\n            \"comment\": \"Good content, but can be a bit too theoretical. Primarily lecture-based.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4.0,\n            \"comment\": \"Wide range of courses available.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org/\"\n}"}
{"_id": "Academic--digital_learning--p--71101", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscription tiers\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science! The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great content and easy to follow. I've learned a lot!\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71101", "text": "{\n    \"platform_name\": \"EduSpark\",\n    \"developer\": \"LearnTech Solutions\",\n    \"features\": [\n        \"Live lectures\",\n        \"Downloadable resources\",\n        \"Forum discussions\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Paid subscription - monthly/annual\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Digital Marketing Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"3 weeks\"\n        },\n        {\n            \"course_name\": \"Web Development Bootcamp\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Advanced Accounting\",\n            \"level\": \"Advanced\",\n            \"duration\": \"10 weeks\"\n        }\n    ],\n    \"launch_date\": \"2019-12-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"The platform is okay, but the interface is a bit clunky and the content could be more engaging.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"I found the courses to be a bit outdated and the support was slow to respond.\"\n        }\n    ],\n    \"access_url\": \"https://www.eduspark.com\"\n}"}
{"_id": "Academic--digital_learning--p--71102", "text": "{\n    \"platform_name\": \"SkillForge\",\n    \"developer\": \"LearnTech Solutions\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Project-based learning\",\n        \"Collaborative coding environment\",\n        \"Peer review\",\n        \"Mentorship program\"\n    ],\n    \"user_types\": [\n        \"Professionals\",\n        \"Students\",\n        \"Career changers\"\n    ],\n    \"subscription_model\": \"Freemium with paid Pro subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Python for Data Science\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Full Stack Web Development\",\n            \"level\": \"Beginner\",\n            \"duration\": \"16 weeks\"\n        }\n    ],\n    \"launch_date\": \"2022-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning practical skills. The collaborative environment is a huge plus!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great courses and supportive community.\"\n        }\n    ],\n    \"access_url\": \"https://www.skillforge.com\"\n}"}
{"_id": "Academic--digital_learning--n--71102", "text": "{\n    \"platform_name\": \"EduWorld\",\n    \"developer\": \"Global Education Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Reading materials\",\n        \"Quizzes\",\n        \"Discussion forums\"\n    ],\n    \"user_types\": [\n        \"High school students\",\n        \"College students\"\n    ],\n    \"subscription_model\": \"Paid subscription (monthly/annual)\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"AP Calculus\",\n            \"level\": \"Advanced\",\n            \"duration\": \"1 semester\"\n        },\n        {\n            \"course_name\": \"World History\",\n            \"level\": \"Beginner\",\n            \"duration\": \"1 year\"\n        }\n    ],\n    \"launch_date\": \"2018-11-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Good resource for academic subjects.\"\n        }\n    ],\n    \"access_url\": \"https://www.eduworld.org\"\n}"}
{"_id": "Academic--digital_learning--p--71103", "text": "{\n    \"platform_name\": \"SkillForge\",\n    \"developer\": \"TechEd Solutions Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Project-based learning\",\n        \"Personalized learning paths\",\n        \"Community forums\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Professionals\",\n        \"Students\",\n        \"Career changers\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Python for Data Science\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Web Development Bootcamp\",\n            \"level\": \"Beginner\",\n            \"duration\": \"16 weeks\"\n        }\n    ],\n    \"launch_date\": \"2018-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.5,\n            \"comment\": \"Excellent platform for learning new skills. The projects are really helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4.0,\n            \"comment\": \"Great content and supportive community.\"\n        }\n    ],\n    \"access_url\": \"https://www.skillforge.com\"\n}"}
{"_id": "Academic--digital_learning--n--71103", "text": "{\n    \"platform_name\": \"EduKids Online\",\n    \"developer\": \"Bright Futures Learning\",\n    \"features\": [\n        \"Animated lessons\",\n        \"Interactive quizzes\",\n        \"Parent dashboards\",\n        \"Progress reports\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\",\n        \"Parents\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Elementary Math\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Reading Comprehension\",\n            \"level\": \"Elementary\",\n            \"duration\": \"6 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-09-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"parent789\",\n            \"rating\": 3.8,\n            \"comment\": \"Good resource for my child's homework.\"\n        },\n        {\n            \"user_id\": \"teacher101\",\n            \"rating\": 4.2,\n            \"comment\": \"Helpful for reinforcing classroom concepts.\"\n        }\n    ],\n    \"access_url\": \"https://www.edukidsonline.com\"\n}"}
{"_id": "Academic--digital_learning--p--71104", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill assessments\",\n        \"Project-based learning\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"topic\": \"Python Programming\"\n        },\n        {\n            \"course_name\": \"Data Science Fundamentals\",\n            \"topic\": \"Data Science\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"topic\": \"Machine Learning\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"John Doe\",\n            \"rating\": 4.5,\n            \"comment\": \"Great platform for learning data science skills!\"\n        },\n        {\n            \"user\": \"Jane Smith\",\n            \"rating\": 4.0,\n            \"comment\": \"Interactive exercises are very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71104", "text": "{\n    \"platform_name\": \"Coursera for Business\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Assignments\",\n        \"Peer review\",\n        \"Certificates\",\n        \"Enterprise reporting\"\n    ],\n    \"user_types\": [\n        \"Enterprises\",\n        \"Employees\",\n        \"Universities\"\n    ],\n    \"subscription_model\": \"Enterprise subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"topic\": \"Machine Learning\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"topic\": \"Data Science\"\n        }\n    ],\n    \"launch_date\": \"2018-06-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Company HR\",\n            \"rating\": 4.2,\n            \"comment\": \"Excellent platform for employee training.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org/for-business\"\n}"}
{"_id": "Academic--digital_learning--p--71105", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lessons\",\n        \"Skill assessments\",\n        \"Project-based learning\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Instructors\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Python Syntax\",\n                \"Data Structures\",\n                \"Functions\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Data Manipulation\",\n                \"Visualization\",\n                \"Statistical Analysis\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Advanced\",\n            \"topics\": [\n                \"Supervised Learning\",\n                \"Unsupervised Learning\",\n                \"Deep Learning\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-02-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"12345\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science! Very interactive and practical.\"\n        },\n        {\n            \"user_id\": \"67890\",\n            \"rating\": 4,\n            \"comment\": \"Good resource, but some courses could be more in-depth.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71105", "text": "{\n    \"platform_name\": \"LearnXYZ\",\n    \"developer\": \"GlobalEdTech Solutions\",\n    \"features\": [\n        \"Pre-recorded video lectures\",\n        \"Downloadable course materials\",\n        \"Quizzes\",\n        \"Discussion boards\",\n        \"Advanced statistical modeling tools\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Researchers\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Paid access – tiered plans\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Quantum Computing Fundamentals\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Qubits\",\n                \"Quantum Gates\",\n                \"Algorithms\"\n            ]\n        },\n        {\n            \"course_name\": \"Advanced Astrophysics\",\n            \"level\": \"Advanced\",\n            \"topics\": [\n                \"Black Holes\",\n                \"Cosmology\",\n                \"Galaxies\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2020-05-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"11223\",\n            \"rating\": 3,\n            \"comment\": \"The content is good, but the interface is very confusing and not user-friendly.\"\n        },\n        {\n            \"user_id\": \"44556\",\n            \"rating\": 2,\n            \"comment\": \"Too many complex features. Hard to navigate.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnxyz.com\"\n}"}
{"_id": "Academic--digital_learning--p--71106", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp, Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill tracks\",\n        \"Project-based learning\",\n        \"Real-world datasets\",\n        \"Collaboration tools\"\n    ],\n    \"user_types\": [\n        \"Individual learners\",\n        \"Data science teams\",\n        \"Business analysts\"\n    ],\n    \"subscription_model\": \"Freemium with paid tiers\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Scientist with Python\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 months\",\n            \"price\": 25.0\n        },\n        {\n            \"course_name\": \"Data Engineer with Python\",\n            \"level\": \"Advanced\",\n            \"duration\": \"9 months\",\n            \"price\": 35.0\n        }\n    ],\n    \"launch_date\": \"2016-02-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.5,\n            \"comment\": \"Great platform for learning data science. Exercises are challenging and helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4.0,\n            \"comment\": \"Good content, but the interface can be a bit clunky.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71106", "text": "{\n    \"platform_name\": \"LearnSphere\",\n    \"developer\": \"EduTech Solutions\",\n    \"features\": [\n        \"Video lectures\",\n        \"Downloadable resources\",\n        \"Discussion forums\",\n        \"Quizzes\",\n        \"Certification programs\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Researchers\"\n    ],\n    \"subscription_model\": \"Paid subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Machine Learning\",\n            \"level\": \"Beginner\",\n            \"duration\": \"3 months\",\n            \"price\": 49.99\n        },\n        {\n            \"course_name\": \"Web Development Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"2 months\",\n            \"price\": 39.99\n        }\n    ],\n    \"launch_date\": \"2019-11-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3.0,\n            \"comment\": \"The courses are decent, but customer support is incredibly slow and unhelpful.  I submitted a ticket a week ago and haven't received a response.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2.5,\n            \"comment\": \"Content is outdated and not very engaging.  The website also crashes frequently.\"\n        },\n        {\n            \"user_id\": \"user345\",\n            \"rating\": 1.0,\n            \"comment\": \"Terrible customer service, unresponsive and unhelpful. Cancelled my subscription.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnsphere.org\"\n}"}
{"_id": "Academic--digital_learning--p--71107", "text": "{\n    \"platform_name\": \"DataLearn Pro\",\n    \"developer\": \"InnovateEd Solutions\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Personalized learning paths\",\n        \"Community forums\",\n        \"Project-based learning\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Career Changers\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Data Science\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\",\n            \"instructor\": \"Dr. Anya Sharma\"\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\",\n            \"instructor\": \"Prof. Ben Carter\"\n        }\n    ],\n    \"launch_date\": \"2021-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform! Great support and well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datalearnpro.com\"\n}"}
{"_id": "Academic--digital_learning--n--71107", "text": "{\n    \"platform_name\": \"UniSkills\",\n    \"developer\": \"HigherEd Tech Group\",\n    \"features\": [\n        \"Lecture recordings\",\n        \"Online quizzes\",\n        \"Assignment submission\",\n        \"Gradebook access\"\n    ],\n    \"user_types\": [\n        \"University Students\",\n        \"Professors\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Advanced Statistical Modeling\",\n            \"level\": \"Advanced\",\n            \"duration\": \"16 weeks\",\n            \"instructor\": \"Dr. Emily Davis\"\n        },\n        {\n            \"course_name\": \"Data Mining Techniques\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"10 weeks\",\n            \"instructor\": \"Prof. David Wilson\"\n        }\n    ],\n    \"launch_date\": \"2022-03-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good resource for university courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.uniskills.edu\"\n}"}
{"_id": "Academic--digital_learning--p--71108", "text": "{\n    \"platform_name\": \"SciLearn Pro\",\n    \"developer\": \"NovaTech Education\",\n    \"features\": [\n        \"Interactive Simulations\",\n        \"Personalized Learning Paths\",\n        \"Progress Tracking\",\n        \"Collaborative Projects\",\n        \"AI-Powered Tutoring\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Researchers\"\n    ],\n    \"subscription_model\": \"Freemium with Premium Access\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python Programming\",\n            \"level\": \"Beginner\",\n            \"subject\": \"Computer Science\"\n        },\n        {\n            \"course_name\": \"Calculus I\",\n            \"level\": \"Intermediate\",\n            \"subject\": \"Mathematics\"\n        },\n        {\n            \"course_name\": \"Physics Fundamentals\",\n            \"level\": \"Beginner\",\n            \"subject\": \"Physics\"\n        }\n    ],\n    \"launch_date\": \"2021-03-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice Johnson\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform! The simulations are very helpful for understanding complex concepts.\"\n        },\n        {\n            \"user\": \"Bob Williams\",\n            \"rating\": 4,\n            \"comment\": \"Great resource for students and teachers alike.\"\n        }\n    ],\n    \"access_url\": \"https://www.scilearnpro.com\"\n}"}
{"_id": "Academic--digital_learning--n--71108", "text": "{\n    \"platform_name\": \"EduWorld\",\n    \"developer\": \"Global Learning Solutions\",\n    \"features\": [\n        \"Video Lectures\",\n        \"Quizzes\",\n        \"Forum Discussions\",\n        \"Basic Progress Reports\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Parents\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"World History\",\n            \"level\": \"Beginner\",\n            \"subject\": \"History\"\n        },\n        {\n            \"course_name\": \"English Literature\",\n            \"level\": \"Intermediate\",\n            \"subject\": \"Literature\"\n        }\n    ],\n    \"launch_date\": \"2022-05-20\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Carol Davis\",\n            \"rating\": 3,\n            \"comment\": \"It's a decent starting point, but lacks advanced features.\"\n        }\n    ],\n    \"access_url\": \"https://www.eduworld.org\"\n}"}
{"_id": "Academic--digital_learning--p--71109", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill assessments\",\n        \"Career tracks\",\n        \"Project-based learning\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\",\n        \"Business Professionals\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Advanced\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-02-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science skills!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great interactive exercises and clear explanations.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71109", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lessons\",\n        \"Practice exercises\",\n        \"Personalized learning dashboards\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\",\n        \"Parents\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Algebra I\",\n            \"level\": \"Beginner\",\n            \"duration\": \"Self-paced\"\n        },\n        {\n            \"course_name\": \"Calculus AB\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"Self-paced\"\n        },\n        {\n            \"course_name\": \"Statistics and Probability\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"Self-paced\"\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 5,\n            \"comment\": \"Incredible resource for free education!\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4,\n            \"comment\": \"Helped me understand math concepts that I struggled with.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
