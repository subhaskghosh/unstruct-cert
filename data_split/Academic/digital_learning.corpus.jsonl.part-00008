{"_id": "Academic--digital_learning--n--70233", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Peer assessments\",\n        \"Quizzes\",\n        \"Discussion forums\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Researchers\",\n        \"Lifelong Learners\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"level\": \"Intermediate\",\n            \"topic\": \"Machine Learning\"\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"level\": \"Advanced\",\n            \"topic\": \"Deep Learning\"\n        }\n    ],\n    \"launch_date\": \"2012-05-10\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Bob\",\n            \"rating\": 4,\n            \"comment\": \"Good quality courses from top universities.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org/\"\n}"}
{"_id": "Academic--digital_learning--p--70234", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Data Science\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Very engaging and practical! The interactive exercises really helped me learn.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great platform for learning data science skills. The content is well-structured and easy to follow.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70234", "text": "{\n    \"platform_name\": \"LearnMath\",\n    \"developer\": \"MathEd Solutions\",\n    \"features\": [\n        \"Video lectures\",\n        \"Practice problems\",\n        \"Quizzes\",\n        \"Textbook integration\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Calculus I\",\n            \"level\": \"Beginner\",\n            \"duration\": \"15 weeks\"\n        },\n        {\n            \"course_name\": \"Linear Algebra\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"10 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-07-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Good resource for math practice, but a bit dry.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"The video quality is not great, and the explanations are sometimes unclear.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnmath.org\"\n}"}
{"_id": "Academic--digital_learning--p--70235", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill tracks\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science! The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good content and well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
