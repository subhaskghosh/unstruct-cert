{"_id": "Academic--digital_learning--n--71308", "text": "{\n    \"platform_name\": \"HistoryHub\",\n    \"developer\": \"Past Insights Inc.\",\n    \"features\": [\n        \"Historical document archive\",\n        \"Expert lectures\",\n        \"Timeline visualization\",\n        \"Interactive maps\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Researchers\"\n    ],\n    \"subscription_model\": \"Paid Subscription ($60/month)\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Ancient Roman History\",\n            \"subject\": \"History\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"World War II\",\n            \"subject\": \"History\",\n            \"level\": \"Advanced\"\n        }\n    ],\n    \"launch_date\": \"2022-09-01\",\n    \"user_feedback\": [\n        {\n            \"user_type\": \"Student\",\n            \"rating\": 4,\n            \"comment\": \"A very thorough archive of historical materials.\"\n        },\n        {\n            \"user_type\": \"Researcher\",\n            \"rating\": 5,\n            \"comment\": \"Invaluable resource for my research.\"\n        }\n    ],\n    \"access_url\": \"https://www.historyhub.org\"\n}"}
{"_id": "Academic--digital_learning--p--71309", "text": "{\n    \"platform_name\": \"DataLearn Pro\",\n    \"developer\": \"Insightful EdTech Solutions\",\n    \"features\": [\n        \"Interactive Coding Exercises\",\n        \"Real-world Projects\",\n        \"Personalized Learning Paths\",\n        \"Community Forums\",\n        \"Progress Tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Data Science\",\n            \"level\": \"Beginner\",\n            \"duration\": \"12 weeks\",\n            \"instructor\": \"Dr. Anya Sharma\"\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"16 weeks\",\n            \"instructor\": \"David Lee\"\n        }\n    ],\n    \"launch_date\": \"2022-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science. The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good course content, well-structured. The community forum is a great resource.\"\n        }\n    ],\n    \"access_url\": \"https://www.datalearnpro.com\"\n}"}
{"_id": "Academic--digital_learning--n--71309", "text": "{\n    \"platform_name\": \"KidsCode Academy\",\n    \"developer\": \"Bright Future Learning\",\n    \"features\": [\n        \"Gamified Learning\",\n        \"Animated Tutorials\",\n        \"Drag-and-Drop Coding\",\n        \"Parental Controls\"\n    ],\n    \"user_types\": [\n        \"Students (ages 6-12)\",\n        \"Parents\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Coding for Kids: Intro to Scratch\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\",\n            \"instructor\": \"Ms. Emily Carter\"\n        },\n        {\n            \"course_name\": \"Robotics with LEGO\",\n            \"level\": \"Beginner\",\n            \"duration\": \"10 weeks\",\n            \"instructor\": \"Mr. Ben Williams\"\n        }\n    ],\n    \"launch_date\": \"2021-11-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"kidcoder1\",\n            \"rating\": 5,\n            \"comment\": \"I love coding with Scratch! It's so fun!\"\n        },\n        {\n            \"user_id\": \"parent123\",\n            \"rating\": 4,\n            \"comment\": \"My child is really enjoying the coding lessons. The platform is easy to use.\"\n        }\n    ],\n    \"access_url\": \"https://www.kidscodeacademy.com\"\n}"}
