{"_id": "Academic--digital_learning--n--71656", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Quizzes\",\n        \"Assignments\",\n        \"Peer review\",\n        \"Certificates\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Lifelong Learners\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"5 courses\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"3 courses\"\n        }\n    ],\n    \"launch_date\": \"2012-05-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"11223\",\n            \"rating\": 4,\n            \"comment\": \"Good courses but can be expensive.\"\n        },\n        {\n            \"user_id\": \"44556\",\n            \"rating\": 3,\n            \"comment\": \"Content is good, but the interface is a bit clunky.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org\"\n}"}
{"_id": "Academic--digital_learning--p--71657", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"course_level\": \"Beginner\",\n            \"topics\": [\n                \"Python basics\",\n                \"Data types\",\n                \"Control flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"course_level\": \"Intermediate\",\n            \"topics\": [\n                \"Supervised learning\",\n                \"Unsupervised learning\",\n                \"Model evaluation\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"course_level\": \"Advanced\",\n            \"topics\": [\n                \"Data visualization\",\n                \"Statistical inference\",\n                \"Big data\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-02-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science! Very practical and engaging.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Excellent resources and a helpful community.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71657", "text": "{\n    \"platform_name\": \"LearnCloud\",\n    \"developer\": \"GlobalEd Tech\",\n    \"features\": [\n        \"Live webinars\",\n        \"Downloadable materials\",\n        \"Discussion boards\",\n        \"Certification programs\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Researchers\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Theoretical Statistics\",\n            \"course_level\": \"Intermediate\",\n            \"topics\": [\n                \"Probability theory\",\n                \"Hypothesis testing\",\n                \"Regression analysis\"\n            ]\n        },\n        {\n            \"course_name\": \"Quantum Computing Fundamentals\",\n            \"course_level\": \"Beginner\",\n            \"topics\": [\n                \"Qubits\",\n                \"Quantum gates\",\n                \"Quantum algorithms\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2021-05-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"The courses are informative, but the price is a bit high.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"The platform is okay, but lacks practical exercises.\"\n        }\n    ],\n    \"access_url\": \"https://www.learncloud.org\"\n}"}
