{"_id": "Academic--digital_learning--p--70334", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Projects\",\n        \"Certifications\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"subject\": \"Programming\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"subject\": \"Data Science\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"subject\": \"Machine Learning\",\n            \"level\": \"Advanced\"\n        }\n    ],\n    \"launch_date\": \"2016-02-04\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"DataCamp has been incredibly helpful in boosting my data science skills. The interactive exercises are fantastic!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great platform for learning data analysis. The projects are very practical.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70334", "text": "{\n    \"platform_name\": \"LearnCodeAcademy\",\n    \"developer\": \"Code Academy LLC\",\n    \"features\": [\n        \"Interactive courses\",\n        \"Project-based learning\",\n        \"Code editor\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Beginners\",\n        \"Students\",\n        \"Career Changers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to HTML\",\n            \"subject\": \"Web Development\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"JavaScript Algorithms and Data Structures\",\n            \"subject\": \"Programming\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"SQL Fundamentals\",\n            \"subject\": \"Database\",\n            \"level\": \"Beginner\"\n        }\n    ],\n    \"launch_date\": \"2011-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"The courses are okay, but not as in-depth as I expected. Good for a quick overview.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"The interface is a bit clunky and the support is slow.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com\"\n}"}
