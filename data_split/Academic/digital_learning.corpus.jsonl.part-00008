{"_id": "Academic--digital_learning--n--71575", "text": "{\n    \"platform_name\": \"Coding Dojo\",\n    \"developer\": \"Coding Dojo\",\n    \"features\": [\n        \"Immersive coding bootcamps\",\n        \"Pair programming\",\n        \"Career services\",\n        \"Mentorship\"\n    ],\n    \"user_types\": [\n        \"Career changers\",\n        \"Aspiring developers\"\n    ],\n    \"subscription_model\": \"Paid (Bootcamp)\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Full Stack Web Development\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Bootcamp\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"14 weeks\"\n        }\n    ],\n    \"launch_date\": \"2014-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 3.8,\n            \"comment\": \"Intensive bootcamp, but can be overwhelming. Good for a quick career transition.\"\n        }\n    ],\n    \"access_url\": \"https://www.codingdojo.com\"\n}"}
{"_id": "Academic--digital_learning--p--71576", "text": "{\n    \"platform_name\": \"DataLearn Academy\",\n    \"developer\": \"InnovEd Solutions\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Community forum\",\n        \"Personalized learning paths\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Data Science\",\n            \"level\": \"Beginner\",\n            \"instructor\": \"Dr. Emily Carter\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Intermediate\",\n            \"instructor\": \"David Lee\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"U123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent course quality and very easy to use platform!\"\n        },\n        {\n            \"user_id\": \"U456\",\n            \"rating\": 4,\n            \"comment\": \"Great learning experience. The instructors are knowledgeable and helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datalearnacademy.com\"\n}"}
{"_id": "Academic--digital_learning--n--71576", "text": "{\n    \"platform_name\": \"GlobalSkills Hub\",\n    \"developer\": \"TechGiant Corp\",\n    \"features\": [\n        \"Live webinars\",\n        \"Downloadable resources\",\n        \"Certification programs\",\n        \"Skill assessments\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Science Fundamentals\",\n            \"level\": \"Beginner\",\n            \"instructor\": \"Dr. Anya Sharma\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Advanced Machine Learning Techniques\",\n            \"level\": \"Advanced\",\n            \"instructor\": \"Michael Chen\",\n            \"duration\": \"10 weeks\"\n        }\n    ],\n    \"launch_date\": \"2022-08-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"U789\",\n            \"rating\": 3,\n            \"comment\": \"The content is good, but the platform can be a bit clunky.\"\n        },\n        {\n            \"user_id\": \"U012\",\n            \"rating\": 4,\n            \"comment\": \"Useful for upskilling, but the price is a bit high.\"\n        }\n    ],\n    \"access_url\": \"https://www.globalskillshub.com\"\n}"}
{"_id": "Academic--digital_learning--p--71577", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill tracks\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\",\n        \"Engineers\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Scientist with Python\",\n            \"duration\": \"6 months\",\n            \"level\": \"Beginner to Intermediate\",\n            \"topics\": [\n                \"Python\",\n                \"Data Analysis\",\n                \"Machine Learning\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Engineer with Python\",\n            \"duration\": \"4 months\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Python\",\n                \"SQL\",\n                \"Data Pipelines\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"University Student\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science. The interactive exercises are very helpful.\"\n        },\n        {\n            \"user\": \"Professional Analyst\",\n            \"rating\": 4,\n            \"comment\": \"Great way to upskill and learn new technologies.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--71577", "text": "{\n    \"platform_name\": \"LearnMathOnline\",\n    \"developer\": \"Math Education LLC\",\n    \"features\": [\n        \"Pre-recorded video lectures\",\n        \"Practice quizzes\",\n        \"Downloadable worksheets\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"High School Students\",\n        \"College Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Calculus I\",\n            \"duration\": \"1 semester\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Limits\",\n                \"Derivatives\",\n                \"Integrals\"\n            ]\n        },\n        {\n            \"course_name\": \"Linear Algebra\",\n            \"duration\": \"1 semester\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Vectors\",\n                \"Matrices\",\n                \"Eigenvalues\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2018-05-20\",\n    \"user_feedback\": [\n        {\n            \"user\": \"High School Student\",\n            \"rating\": 4,\n            \"comment\": \"Good resource for practicing math problems.\"\n        },\n        {\n            \"user\": \"College Student\",\n            \"rating\": 3,\n            \"comment\": \"Helpful, but could be more engaging.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnmathonline.com/\"\n}"}
{"_id": "Academic--digital_learning--p--71578", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill assessments\",\n        \"Career tracks\",\n        \"Project-based learning\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Instructors\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\",\n            \"topics\": [\n                \"Syntax\",\n                \"Data Structures\",\n                \"Functions\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\",\n            \"topics\": [\n                \"Regression\",\n                \"Classification\",\n                \"Clustering\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"12 weeks\",\n            \"topics\": [\n                \"Statistics\",\n                \"Data Visualization\",\n                \"Big Data\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-02-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"John Doe\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science. The interactive exercises are very helpful.\"\n        },\n        {\n            \"user\": \"Jane Smith\",\n            \"rating\": 4,\n            \"comment\": \"Great resources and well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71578", "text": "{\n    \"platform_name\": \"ArtHistoryOnline\",\n    \"developer\": \"Historical Education Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Reading materials\",\n        \"Quizzes\",\n        \"Discussion forums\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Art Historians\",\n        \"Researchers\"\n    ],\n    \"subscription_model\": \"Paid - Tiered\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Renaissance Art\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\",\n            \"topics\": [\n                \"Painting\",\n                \"Sculpture\",\n                \"Architecture\"\n            ]\n        },\n        {\n            \"course_name\": \"Ancient Egyptian Art\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\",\n            \"topics\": [\n                \"Hieroglyphs\",\n                \"Pyramids\",\n                \"Tombs\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2022-05-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice Johnson\",\n            \"rating\": 4,\n            \"comment\": \"Very informative lectures on art history.\"\n        },\n        {\n            \"user\": \"Bob Williams\",\n            \"rating\": 3,\n            \"comment\": \"Good for basic understanding, but could use more visual aids.\"\n        }\n    ],\n    \"access_url\": \"https://www.arthistoryonline.com\"\n}"}
{"_id": "Academic--digital_learning--p--71579", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill tracks\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium, with paid tiers\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topic\": \"Python Programming\"\n        },\n        {\n            \"course_name\": \"Machine Learning with scikit-learn\",\n            \"level\": \"Intermediate\",\n            \"topic\": \"Machine Learning\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"topic\": \"Data Science\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science! Very interactive and easy to follow.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Excellent resources and a supportive community.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71579", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Assignments\",\n        \"Quizzes\",\n        \"Peer-graded assignments\",\n        \"Certificates\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Lifelong Learners\"\n    ],\n    \"subscription_model\": \"Individual courses or subscription packages\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"level\": \"Intermediate\",\n            \"topic\": \"Machine Learning\"\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"level\": \"Advanced\",\n            \"topic\": \"Deep Learning\"\n        },\n        {\n            \"course_name\": \"Data Science Ethics\",\n            \"level\": \"Beginner\",\n            \"topic\": \"Data Science\"\n        }\n    ],\n    \"launch_date\": \"2012-04-12\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Good course content, but the platform can be a bit clunky to navigate.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4,\n            \"comment\": \"Excellent professors and a wide range of courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org\"\n}"}
{"_id": "Academic--digital_learning--p--71580", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill tracks\",\n        \"Data science focused courses\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"title\": \"Introduction to Python\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Python fundamentals\",\n                \"Data manipulation\"\n            ]\n        },\n        {\n            \"title\": \"Machine Learning with scikit-learn\",\n            \"level\": \"Advanced\",\n            \"topics\": [\n                \"Supervised learning\",\n                \"Unsupervised learning\"\n            ]\n        },\n        {\n            \"title\": \"Data Visualization with Tableau\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Tableau Desktop\",\n                \"Data storytelling\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"John Doe\",\n            \"rating\": 4.5,\n            \"comment\": \"Great platform for learning data science skills.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71580", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lectures\",\n        \"Practice exercises\",\n        \"Progress tracking\",\n        \"Personalized learning\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"title\": \"Introduction to Statistics\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Descriptive statistics\",\n                \"Probability\"\n            ]\n        },\n        {\n            \"title\": \"Algebra I\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Linear equations\",\n                \"Inequalities\"\n            ]\n        },\n        {\n            \"title\": \"Calculus 1\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Limits\",\n                \"Derivatives\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Jane Smith\",\n            \"rating\": 4.0,\n            \"comment\": \"Excellent resource for learning math and science.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
{"_id": "Academic--digital_learning--p--71581", "text": "{\n    \"platform_name\": \"DataCamp Academy\",\n    \"developer\": \"DataCamp\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Collaborative workspaces\",\n        \"Skill assessments\",\n        \"Certification preparation tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Scientist with Python\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Python\",\n                \"Data Analysis\",\n                \"Machine Learning\"\n            ]\n        },\n        {\n            \"course_name\": \"Cybersecurity Fundamentals\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Network Security\",\n                \"Cryptography\",\n                \"Ethical Hacking\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2019-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science! The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Easy to navigate and the collaborative features are great for working with others.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/academy\"\n}"}
{"_id": "Academic--digital_learning--n--71581", "text": "{\n    \"platform_name\": \"LearnCodeX\",\n    \"developer\": \"TechEd Solutions\",\n    \"features\": [\n        \"Video lectures\",\n        \"Quizzes\",\n        \"Downloadable resources\",\n        \"Offline access\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Beginners\",\n        \"Hobbyists\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Web Development\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"HTML\",\n                \"CSS\",\n                \"JavaScript\"\n            ]\n        },\n        {\n            \"course_name\": \"Game Development with Unity\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"C#\",\n                \"Unity Engine\",\n                \"Game Design\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2017-11-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Good introductory courses, but could use more advanced content.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"The interface is a bit clunky and difficult to use.\"\n        }\n    ],\n    \"access_url\": \"https://www.learncodex.com\"\n}"}
