{"_id": "Academic--digital_learning--n--71789", "text": "{\n    \"platform_name\": \"ExamMaster Prep\",\n    \"developer\": \"TestPrep Solutions Inc.\",\n    \"features\": [\n        \"Practice exams\",\n        \"Flashcards\",\n        \"Progress tracking\",\n        \"Detailed explanations\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Paid subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"SAT Math Prep\",\n            \"level\": \"High School\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"ACT Science Prep\",\n            \"level\": \"High School\",\n            \"duration\": \"6 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-11-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4,\n            \"comment\": \"Very helpful for test preparation.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3,\n            \"comment\": \"Good resource, but can be a bit repetitive.\"\n        }\n    ],\n    \"access_url\": \"https://www.exammasterprep.com\"\n}"}
{"_id": "Academic--digital_learning--p--71790", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-07-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science!\"\n        },\n        {\n            \"user_id\": \"456\",\n            \"rating\": 4,\n            \"comment\": \"Very engaging and practical.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71790", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lessons\",\n        \"Practice exercises\",\n        \"Progress tracking\",\n        \"Personalized learning\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Algebra I\",\n            \"level\": \"Beginner\",\n            \"duration\": \"Self-paced\"\n        },\n        {\n            \"course_name\": \"AP Calculus\",\n            \"level\": \"Advanced\",\n            \"duration\": \"Self-paced\"\n        },\n        {\n            \"course_name\": \"SAT Preparation\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"Self-paced\"\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"789\",\n            \"rating\": 5,\n            \"comment\": \"Excellent resource for learning math and science.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
{"_id": "Academic--digital_learning--p--71791", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Individual learners\",\n        \"Corporate training\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Scientist with Python\",\n            \"duration\": \"6 months\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Data Engineer with SQL\",\n            \"duration\": \"4 months\",\n            \"level\": \"Beginner\"\n        }\n    ],\n    \"launch_date\": \"2016-05-16\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.5,\n            \"comment\": \"Great platform for learning data science skills!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4.2,\n            \"comment\": \"Very interactive and engaging courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71791", "text": "{\n    \"platform_name\": \"LearnSQL.com\",\n    \"developer\": \"Vertical Loom\",\n    \"features\": [\n        \"Interactive SQL tutorials\",\n        \"SQL exercises\",\n        \"Real-world datasets\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Individual learners\",\n        \"Data Analysts\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"SQL for Data Analysis\",\n            \"duration\": \"2 months\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Advanced SQL Techniques\",\n            \"duration\": \"3 months\",\n            \"level\": \"Advanced\"\n        }\n    ],\n    \"launch_date\": \"2018-11-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3.8,\n            \"comment\": \"Good for learning SQL, but could be more engaging.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3.5,\n            \"comment\": \"The interface is a bit clunky.\"\n        }\n    ],\n    \"access_url\": \"https://learnsql.com\"\n}"}
{"_id": "Academic--digital_learning--p--71792", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill tracks\",\n        \"Project portfolio\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Analysts\",\n        \"Students\",\n        \"Beginners\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"topic\": \"Programming\"\n        },\n        {\n            \"course_name\": \"Data Science Foundations\",\n            \"difficulty\": \"Beginner\",\n            \"topic\": \"Data Science\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"difficulty\": \"Intermediate\",\n            \"topic\": \"Artificial Intelligence\"\n        }\n    ],\n    \"launch_date\": \"2016-02-01\",\n    \"user_feedback\": [\n        {\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science from scratch!\"\n        },\n        {\n            \"rating\": 4,\n            \"comment\": \"Great interactive exercises and clear explanations.\"\n        },\n        {\n            \"rating\": 5,\n            \"comment\": \"Helped me land my first data analyst job.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
