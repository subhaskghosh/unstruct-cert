{"_id": "Academic--digital_learning--n--70714", "text": "{\n    \"platform_name\": \"LearnChemE\",\n    \"developer\": \"LearnChemE\",\n    \"features\": [\n        \"Video lectures\",\n        \"Problem sets\",\n        \"Interactive simulations\",\n        \"Course materials\"\n    ],\n    \"user_types\": [\n        \"Chemical Engineering Students\",\n        \"Chemical Engineers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Chemical Reaction Engineering\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"Thermodynamics\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2020-05-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Useful for supplementary material, but can be a bit dry.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4,\n            \"comment\": \"Good for practicing problem solving.\"\n        }\n    ],\n    \"access_url\": \"https://www.learncheme.com/\"\n}"}
{"_id": "Academic--digital_learning--p--70715", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill tracks\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\",\n        \"Engineers\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-04-21\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science skills. Very interactive and practical.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good content, well-structured courses. Would recommend for beginners.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70715", "text": "{\n    \"platform_name\": \"LearnPython.org\",\n    \"developer\": \"LearnPython.org\",\n    \"features\": [\n        \"Interactive tutorials\",\n        \"Code examples\",\n        \"Basic exercises\"\n    ],\n    \"user_types\": [\n        \"Beginners\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Python Basics\",\n            \"level\": \"Beginner\",\n            \"duration\": \"2 weeks\"\n        },\n        {\n            \"course_name\": \"Python Functions\",\n            \"level\": \"Beginner\",\n            \"duration\": \"1 week\"\n        }\n    ],\n    \"launch_date\": \"2011-09-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"A good starting point, but lacks depth for more advanced learners.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4,\n            \"comment\": \"Simple and easy to follow tutorials.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnpython.org\"\n}"}
