{"_id": "Academic--digital_learning--n--70335", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lessons\",\n        \"Practice exercises\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\",\n        \"Lifelong learners\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Calculus 1\",\n            \"course_level\": \"Beginner\",\n            \"course_duration\": \"1 semester\"\n        },\n        {\n            \"course_name\": \"Linear Algebra\",\n            \"course_level\": \"Intermediate\",\n            \"course_duration\": \"1 semester\"\n        },\n        {\n            \"course_name\": \"Statistics and Probability\",\n            \"course_level\": \"Intermediate\",\n            \"course_duration\": \"1 semester\"\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"11223\",\n            \"rating\": 5,\n            \"comment\": \"Khan Academy is a fantastic resource for students of all ages.\"\n        },\n        {\n            \"user_id\": \"44556\",\n            \"rating\": 4,\n            \"comment\": \"Very helpful for understanding complex concepts.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org/\"\n}"}
