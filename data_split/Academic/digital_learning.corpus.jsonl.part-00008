{"_id": "Academic--digital_learning--p--71742", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning Foundations\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science interactively.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good content, well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--71742", "text": "{\n    \"platform_name\": \"Coding Dojo\",\n    \"developer\": \"Coding Dojo\",\n    \"features\": [\n        \"Intensive coding bootcamp\",\n        \"Project-based learning\",\n        \"Career services\",\n        \"Mentorship program\"\n    ],\n    \"user_types\": [\n        \"Career changers\",\n        \"Aspiring developers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Full Stack Web Development\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Bootcamp\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"14 weeks\"\n        }\n    ],\n    \"launch_date\": \"2014-06-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4,\n            \"comment\": \"Fast-paced and effective bootcamp.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3,\n            \"comment\": \"Challenging but rewarding experience.\"\n        }\n    ],\n    \"access_url\": \"https://www.codingdojo.com/\"\n}"}
{"_id": "Academic--digital_learning--p--71743", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"Posit\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill assessments\",\n        \"Project-based learning\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for hands-on learning! The interactive coding exercises are really helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great resources for data science professionals.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71743", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Quizzes\",\n        \"Assignments\",\n        \"Peer assessments\",\n        \"Certificates\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Lifelong Learners\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"5 courses\"\n        }\n    ],\n    \"launch_date\": \"2012-05-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4,\n            \"comment\": \"Good courses, but can be expensive.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3,\n            \"comment\": \"Assignments are sometimes poorly graded.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org\"\n}"}
{"_id": "Academic--digital_learning--p--71744", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill assessments\",\n        \"Career tracks\",\n        \"Project-based learning\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.5,\n            \"comment\": \"Very user-friendly and great for learning data science basics!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4.0,\n            \"comment\": \"Excellent interactive exercises. A good platform for beginners.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71744", "text": "{\n    \"platform_name\": \"StatQuest\",\n    \"developer\": \"Josh Starmer\",\n    \"features\": [\n        \"Video lectures\",\n        \"Statistical concepts explained simply\",\n        \"Visualizations\",\n        \"Practice problems\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Researchers\",\n        \"Statisticians\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Statistics Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"Self-paced\"\n        },\n        {\n            \"course_name\": \"Machine Learning Explained\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"Self-paced\"\n        }\n    ],\n    \"launch_date\": \"2011-05-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 5.0,\n            \"comment\": \"Clear and concise explanations of complex statistical concepts.\"\n        },\n        {\n            \"user_id\": \"user101\",\n            \"rating\": 4.8,\n            \"comment\": \"Excellent resource for understanding the intuition behind statistical methods.\"\n        }\n    ],\n    \"access_url\": \"https://statquest.org\"\n}"}
{"_id": "Academic--digital_learning--p--71745", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Collaboration tools\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium with paid tiers\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"rating\": 4.5,\n            \"comment\": \"Great platform for learning data science!\"\n        },\n        {\n            \"user_id\": \"456\",\n            \"rating\": 4.0,\n            \"comment\": \"Interactive exercises are very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71745", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lectures\",\n        \"Practice exercises\",\n        \"Personalized learning\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Algebra I\",\n            \"level\": \"Beginner\",\n            \"duration\": \"Self-paced\"\n        },\n        {\n            \"course_name\": \"Calculus AB\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"Self-paced\"\n        },\n        {\n            \"course_name\": \"Statistics and Probability\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"Self-paced\"\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"789\",\n            \"rating\": 4.8,\n            \"comment\": \"Excellent resource for free education.\"\n        },\n        {\n            \"user_id\": \"101\",\n            \"rating\": 4.2,\n            \"comment\": \"Very helpful for students of all ages.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
{"_id": "Academic--digital_learning--p--71746", "text": "{\n    \"platform_name\": \"Codecademy Pro\",\n    \"developer\": \"Codecademy\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Real-world projects\",\n        \"Personalized learning paths\",\n        \"Progress tracking\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Self-learners\"\n    ],\n    \"subscription_model\": \"Freemium with paid Pro access\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"subject_area\": \"Computer Science\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Data Science Fundamentals\",\n            \"subject_area\": \"Data Science\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Web Development with JavaScript\",\n            \"subject_area\": \"Computer Science\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2011-08-29\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning to code. The interactive exercises are very helpful.\"\n        },\n        {\n            \"user\": \"Bob\",\n            \"rating\": 4,\n            \"comment\": \"Good content and a great community. Occasionally, some exercises can be a bit buggy.\"\n        },\n        {\n            \"user\": \"Charlie\",\n            \"rating\": 5,\n            \"comment\": \"I've learned so much from Codecademy! Highly recommended.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com/\"\n}"}
{"_id": "Academic--digital_learning--n--71746", "text": "{\n    \"platform_name\": \"Artful Academy\",\n    \"developer\": \"Creative Minds Inc.\",\n    \"features\": [\n        \"Digital painting tutorials\",\n        \"Sculpting lessons\",\n        \"Art history courses\",\n        \"Portfolio building tools\",\n        \"Live workshops\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Artists\"\n    ],\n    \"subscription_model\": \"Paid levels - Basic, Premium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Oil Painting\",\n            \"subject_area\": \"Fine Arts\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Digital Sculpture with ZBrush\",\n            \"subject_area\": \"Sculpture\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Renaissance Art History\",\n            \"subject_area\": \"Art History\",\n            \"level\": \"Beginner\"\n        }\n    ],\n    \"launch_date\": \"2018-05-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"David\",\n            \"rating\": 4,\n            \"comment\": \"Great for learning art techniques, but could use more focus on practical application.\"\n        },\n        {\n            \"user\": \"Emily\",\n            \"rating\": 5,\n            \"comment\": \"Excellent instructors and a supportive community.\"\n        },\n        {\n            \"user\": \"Frank\",\n            \"rating\": 3,\n            \"comment\": \"The interface is a bit clunky, but the content is good.\"\n        }\n    ],\n    \"access_url\": \"https://www.artfulacademy.com/\"\n}"}
