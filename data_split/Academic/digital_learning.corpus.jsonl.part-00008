{"_id": "Academic--digital_learning--n--70582", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Reading materials\",\n        \"Quizzes\",\n        \"Peer assessments\",\n        \"Certificates\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Paid levels\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"level\": \"Beginner\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"5 courses\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"5 courses\"\n        }\n    ],\n    \"launch_date\": \"2012-05-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"67890\",\n            \"rating\": 4,\n            \"comment\": \"Good platform, but some courses are more theoretical than practical.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org/\"\n}"}
{"_id": "Academic--digital_learning--p--70583", "text": "{\n    \"platform_name\": \"LearnSphere\",\n    \"developer\": \"EduTech Solutions Inc.\",\n    \"features\": [\n        \"Interactive lessons\",\n        \"Progress tracking\",\n        \"Personalized learning paths\",\n        \"Collaborative projects\",\n        \"AI-powered tutoring\"\n    ],\n    \"user_types\": [\n        \"students\",\n        \"educators\"\n    ],\n    \"subscription_model\": \"Freemium with premium tiers\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python Programming\",\n            \"level\": \"Beginner\",\n            \"instructor\": \"Dr. Emily Carter\"\n        },\n        {\n            \"course_name\": \"Advanced Calculus\",\n            \"level\": \"Advanced\",\n            \"instructor\": \"Professor David Lee\"\n        }\n    ],\n    \"launch_date\": \"2021-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"LearnSphere has significantly improved my understanding of complex concepts. The interactive lessons are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"A great platform for both students and teachers. The progress tracking features are fantastic.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnsphere.com\"\n}"}
{"_id": "Academic--digital_learning--n--70583", "text": "{\n    \"platform_name\": \"QuickStudy\",\n    \"developer\": \"FastLearn Ltd.\",\n    \"features\": [\n        \"Pre-recorded video lectures\",\n        \"Quiz questions\",\n        \"Downloadable resources\"\n    ],\n    \"user_types\": [\n        \"students\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Basic Algebra\",\n            \"level\": \"Beginner\",\n            \"instructor\": \"Mr. John Smith\"\n        },\n        {\n            \"course_name\": \"World History 101\",\n            \"level\": \"Beginner\",\n            \"instructor\": \"Ms. Jane Doe\"\n        }\n    ],\n    \"launch_date\": \"2022-11-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"It's a decent platform for quick revision, but not much depth.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"The content is a bit shallow and doesn't really help with deeper understanding.\"\n        }\n    ],\n    \"access_url\": \"https://www.quickstudy.org\"\n}"}
