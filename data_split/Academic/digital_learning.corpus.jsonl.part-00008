{"_id": "Academic--digital_learning--n--71294", "text": "{\n    \"platform_name\": \"Google Cloud Skills Boost\",\n    \"developer\": \"Google\",\n    \"features\": [\n        \"Video courses\",\n        \"Hands-on labs\",\n        \"Quests\",\n        \"Skill badges\"\n    ],\n    \"user_types\": [\n        \"Cloud engineers\",\n        \"Data scientists\",\n        \"Developers\"\n    ],\n    \"subscription_model\": \"Freemium with paid tiers\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Google Cloud Platform\",\n            \"level\": \"Beginner\",\n            \"duration\": \"2 weeks\"\n        },\n        {\n            \"course_name\": \"Data Engineering on Google Cloud\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-05-10\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice Johnson\",\n            \"rating\": 4,\n            \"comment\": \"Good resources for learning Google Cloud technologies.\"\n        },\n        {\n            \"user\": \"Bob Williams\",\n            \"rating\": 3,\n            \"comment\": \"Some courses are outdated.\"\n        }\n    ],\n    \"access_url\": \"https://www.cloudskillsboost.google/\"\n}"}
{"_id": "Academic--digital_learning--p--71295", "text": "{\n    \"platform_name\": \"CodeSpark Academy\",\n    \"developer\": \"CodeSpark Inc.\",\n    \"features\": [\n        \"Gamified learning\",\n        \"Block-based coding\",\n        \"Progress tracking\",\n        \"Teacher dashboard\",\n        \"Interactive lessons\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"The Foos\",\n            \"subject\": \"Computer Science\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"A Giggle of Bugs\",\n            \"subject\": \"Coding Fundamentals\",\n            \"level\": \"Beginner\"\n        }\n    ],\n    \"launch_date\": \"2018-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_type\": \"Parent\",\n            \"rating\": 5,\n            \"comment\": \"My child loves this platform! It's a great introduction to coding.\"\n        },\n        {\n            \"user_type\": \"Educator\",\n            \"rating\": 4,\n            \"comment\": \"Easy to integrate into the classroom and keeps students engaged.\"\n        }\n    ],\n    \"access_url\": \"https://www.codesparkacademy.com/\"\n}"}
{"_id": "Academic--digital_learning--n--71295", "text": "{\n    \"platform_name\": \"LearnChemE\",\n    \"developer\": \"LearnChemE LLC\",\n    \"features\": [\n        \"Video lectures\",\n        \"Practice problems\",\n        \"Simulations\",\n        \"Interactive modules\",\n        \"Forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Researchers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Chemical Engineering Thermodynamics\",\n            \"subject\": \"Chemical Engineering\",\n            \"level\": \"Advanced\"\n        },\n        {\n            \"course_name\": \"Transport Phenomena\",\n            \"subject\": \"Chemical Engineering\",\n            \"level\": \"Advanced\"\n        }\n    ],\n    \"launch_date\": \"2021-03-10\",\n    \"user_feedback\": [\n        {\n            \"user_type\": \"Student\",\n            \"rating\": 4,\n            \"comment\": \"Very detailed lectures, but requires a strong foundation in math.\"\n        },\n        {\n            \"user_type\": \"Researcher\",\n            \"rating\": 5,\n            \"comment\": \"Excellent resource for staying up-to-date with the latest research.\"\n        }\n    ],\n    \"access_url\": \"https://learncheme.com/\"\n}"}
{"_id": "Academic--digital_learning--p--71296", "text": "{\n    \"platform_name\": \"DataSec Academy\",\n    \"developer\": \"CyberSkills Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Real-world projects\",\n        \"Mentorship programs\",\n        \"Progress tracking\",\n        \"Collaboration forums\",\n        \"Self-paced learning modules\"\n    ],\n    \"user_types\": [\n        \"University Students\",\n        \"Professionals\",\n        \"Career Changers\"\n    ],\n    \"subscription_model\": \"Freemium with tiered access\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Science Bootcamp\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\",\n            \"price\": 999\n        },\n        {\n            \"course_name\": \"Cybersecurity Foundations\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\",\n            \"price\": 499\n        }\n    ],\n    \"launch_date\": \"2022-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform! The data science course was very comprehensive and practical.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great for self-paced learning. The cybersecurity modules are well-structured.\"\n        }\n    ],\n    \"access_url\": \"https://www.datasecacademy.com\"\n}"}
{"_id": "Academic--digital_learning--n--71296", "text": "{\n    \"platform_name\": \"LearnFast\",\n    \"developer\": \"EduTech Solutions\",\n    \"features\": [\n        \"Video lectures\",\n        \"Quizzes\",\n        \"Discussion boards\",\n        \"Certificate of completion\"\n    ],\n    \"user_types\": [\n        \"High School Students\",\n        \"College Students\"\n    ],\n    \"subscription_model\": \"One-time purchase per course\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"6 weeks\",\n            \"price\": 199\n        },\n        {\n            \"course_name\": \"Web Development Basics\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\",\n            \"price\": 149\n        }\n    ],\n    \"launch_date\": \"2018-11-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Decent course, but a bit basic.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"The platform felt outdated and lacked interaction.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnfast.edu\"\n}"}
