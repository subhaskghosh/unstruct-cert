{"_id": "Academic--digital_learning--p--71770", "text": "{\n    \"platform_name\": \"DataLearn Pro\",\n    \"developer\": \"InnovateEd Solutions\",\n    \"features\": [\n        \"Interactive coding environments\",\n        \"Personalized learning paths\",\n        \"Project-based learning\",\n        \"Community forums\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium with premium subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Data Science\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2022-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform! The courses are well-structured and the instructors are knowledgeable.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great for learning data science basics. The community support is helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datalearnpro.com\"\n}"}
{"_id": "Academic--digital_learning--n--71770", "text": "{\n    \"platform_name\": \"EduCentral\",\n    \"developer\": \"Global Education Tech\",\n    \"features\": [\n        \"Video lectures\",\n        \"Quizzes\",\n        \"Assignments\",\n        \"Discussion boards\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Paid levels\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Basic Statistics\",\n            \"level\": \"Beginner\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Calculus I\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2019-11-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Decent platform, but the content is a bit outdated.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4,\n            \"comment\": \"Good for traditional subjects, but lacks advanced topics.\"\n        }\n    ],\n    \"access_url\": \"https://www.educentral.org\"\n}"}
{"_id": "Academic--digital_learning--p--71771", "text": "{\n    \"platform_name\": \"DataLearn Pro\",\n    \"developer\": \"InnovateEd Tech\",\n    \"features\": [\n        \"Interactive Coding Exercises\",\n        \"Video Lectures\",\n        \"Personalized Learning Paths\",\n        \"Project-Based Learning\",\n        \"Community Forum\",\n        \"AI-Powered Tutoring\",\n        \"Progress Tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium with Paid Pro Levels\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Data Science\",\n            \"level\": \"Beginner\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"16 weeks\"\n        },\n        {\n            \"course_name\": \"Deep Learning Fundamentals\",\n            \"level\": \"Advanced\",\n            \"duration\": \"20 weeks\"\n        }\n    ],\n    \"launch_date\": \"2022-05-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice Smith\",\n            \"date\": \"2024-01-20\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform! The courses are well-structured and the AI tutoring is very helpful.\"\n        },\n        {\n            \"user\": \"Bob Johnson\",\n            \"date\": \"2023-11-10\",\n            \"rating\": 4,\n            \"comment\": \"Good resource for learning data science. The community forum is active.\"\n        }\n    ],\n    \"access_url\": \"https://www.datalearnpro.com\"\n}"}
{"_id": "Academic--digital_learning--n--71771", "text": "{\n    \"platform_name\": \"EduCentral\",\n    \"developer\": \"Global Education Solutions\",\n    \"features\": [\n        \"Live Webinars\",\n        \"Course Materials\",\n        \"Quizzes\",\n        \"Discussion Boards\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Enterprise Subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Basic Statistics\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Introduction to Programming\",\n            \"level\": \"Beginner\",\n            \"duration\": \"10 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-03-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Charlie Brown\",\n            \"date\": \"2021-05-12\",\n            \"rating\": 3,\n            \"comment\": \"It's okay, but a bit outdated.\"\n        }\n    ],\n    \"access_url\": \"https://www.educentral.org\"\n}"}
{"_id": "Academic--digital_learning--p--71772", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Project portfolio\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Manipulation with Pandas\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with scikit-learn\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science! Very interactive and practical.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great courses and a supportive community.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71772", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lessons\",\n        \"Practice exercises\",\n        \"Personalized learning\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\",\n        \"Parents\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Algebra I\",\n            \"level\": \"Beginner\",\n            \"duration\": \"Full Year\"\n        },\n        {\n            \"course_name\": \"Calculus\",\n            \"level\": \"Advanced\",\n            \"duration\": \"Full Year\"\n        },\n        {\n            \"course_name\": \"Statistics and probability\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"Semester\"\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4,\n            \"comment\": \"Great resource for K-12 education.\"\n        },\n        {\n            \"user_id\": \"user101\",\n            \"rating\": 5,\n            \"comment\": \"Helped my child succeed in math!\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
{"_id": "Academic--digital_learning--p--71773", "text": "{\n    \"platform_name\": \"Codecademy Pro\",\n    \"developer\": \"Codecademy\",\n    \"features\": [\n        \"Interactive coding environment\",\n        \"Project-based learning\",\n        \"Skill paths\",\n        \"Real-world projects\",\n        \"Code hints and feedback\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Learn Python 3\",\n            \"duration\": \"30 hours\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Variables\",\n                \"Loops\",\n                \"Functions\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Path\",\n            \"duration\": \"60 hours\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Python\",\n                \"SQL\",\n                \"Machine Learning\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2018-04-17\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.5,\n            \"comment\": \"Great platform for learning to code interactively.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 5.0,\n            \"comment\": \"Excellent skill paths and projects.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com/pro\"\n}"}
