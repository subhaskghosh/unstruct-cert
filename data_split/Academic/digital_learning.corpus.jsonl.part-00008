{"_id": "Academic--digital_learning--n--70278", "text": "{\n    \"platform_name\": \"LearnWell\",\n    \"developer\": \"EduTech Solutions Inc.\",\n    \"features\": [\n        \"Pre-recorded video lectures\",\n        \"Downloadable course materials\",\n        \"Quizzes\",\n        \"Discussion forums\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\",\n        \"Lifelong learners\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Calculus\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Limits\",\n                \"Derivatives\",\n                \"Integrals\"\n            ]\n        },\n        {\n            \"course_name\": \"Linear Algebra\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Vectors\",\n                \"Matrices\",\n                \"Eigenvalues\"\n            ]\n        },\n        {\n            \"course_name\": \"Statistics 101\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Descriptive statistics\",\n                \"Probability\",\n                \"Inferential statistics\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2019-12-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"789\",\n            \"rating\": 3,\n            \"comment\": \"The course content is good, but the platform feels a bit outdated.\"\n        },\n        {\n            \"user_id\": \"101\",\n            \"rating\": 2,\n            \"comment\": \"The interface is clunky and difficult to navigate.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnwell.edu\"\n}"}
{"_id": "Academic--digital_learning--p--70279", "text": "{\n    \"platform_name\": \"LearnSphere\",\n    \"developer\": \"EduTech Innovations Inc.\",\n    \"features\": [\n        \"Interactive video lessons\",\n        \"Personalized learning paths\",\n        \"Progress tracking\",\n        \"Gamified quizzes\",\n        \"Collaborative projects\",\n        \"Live Q&A sessions\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Parents\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"AP Calculus AB\",\n            \"level\": \"Advanced\",\n            \"duration\": \"16 weeks\"\n        },\n        {\n            \"course_name\": \"Creative Writing Workshop\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"10 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform with a wide range of courses and engaging content!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Very helpful for my students. The personalized learning paths are a great feature.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnsphere.com\"\n}"}
