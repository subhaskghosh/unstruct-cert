{"_id": "Academic--digital_learning--n--70061", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Peer-graded assignments\",\n        \"Quizzes\",\n        \"Specializations\",\n        \"Degrees\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Lifelong learners\"\n    ],\n    \"subscription_model\": \"Paid courses and subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"6 months\"\n        },\n        {\n            \"course_name\": \"Python for Everybody\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2012-04-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"comment\": \"Excellent course variety and instructors from top universities.\",\n            \"rating\": 4\n        },\n        {\n            \"user_id\": \"user012\",\n            \"comment\": \"The course materials are rigorous and require a strong foundation.\",\n            \"rating\": 3\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org\"\n}"}
