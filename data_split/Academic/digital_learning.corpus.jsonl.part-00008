{"_id": "Academic--digital_learning--n--70036", "text": "{\n    \"platform_name\": \"HistoryHub\",\n    \"developer\": \"Past Insights Inc.\",\n    \"features\": [\n        \"Historical document archive\",\n        \"Expert lectures\",\n        \"Timeline visualizations\",\n        \"Discussion forums\"\n    ],\n    \"user_types\": [\n        \"students\",\n        \"researchers\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Ancient Civilizations\",\n            \"level\": \"Beginner\",\n            \"subject\": \"History\"\n        },\n        {\n            \"course_name\": \"World War II\",\n            \"level\": \"Intermediate\",\n            \"subject\": \"History\"\n        }\n    ],\n    \"launch_date\": \"2022-03-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4.0,\n            \"comment\": \"Excellent resource for history buffs.\"\n        }\n    ],\n    \"access_url\": \"https://www.historyhub.org\"\n}"}
{"_id": "Academic--digital_learning--p--70037", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Project-based learning\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Very helpful and interactive.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--70037", "text": "{\n    \"platform_name\": \"LearnIt\",\n    \"developer\": \"Tech Solutions Inc.\",\n    \"features\": [\n        \"Live lectures\",\n        \"Discussion forums\",\n        \"Assignment submissions\",\n        \"Personalized feedback\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Web Development Basics\",\n            \"level\": \"Beginner\",\n            \"duration\": \"5 weeks\"\n        },\n        {\n            \"course_name\": \"Digital Marketing Strategies\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"7 weeks\"\n        },\n        {\n            \"course_name\": \"Intro to Data Analysis\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-03-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Okay platform, could be better.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"Assignments were not well structured.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnitnow.com/\"\n}"}
{"_id": "Academic--digital_learning--p--70038", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Project portfolio\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 months\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science skills. The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good content, but the interface could be improved.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70038", "text": "{\n    \"platform_name\": \"LearnWorlds\",\n    \"developer\": \"LearnWorlds\",\n    \"features\": [\n        \"Course creation tools\",\n        \"Video hosting\",\n        \"Interactive video\",\n        \"Community features\",\n        \"Marketing tools\"\n    ],\n    \"user_types\": [\n        \"Educators\",\n        \"Entrepreneurs\",\n        \"Companies\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Digital Marketing Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"3 weeks\"\n        },\n        {\n            \"course_name\": \"Creative Writing Workshop\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"5 weeks\"\n        }\n    ],\n    \"launch_date\": \"2014-05-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4,\n            \"comment\": \"A great platform for creating and selling online courses.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3,\n            \"comment\": \"The customer support could be more responsive.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnworlds.com\"\n}"}
{"_id": "Academic--digital_learning--p--70039", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill assessments\",\n        \"Project-based learning\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science! The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good content and a supportive community.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70039", "text": "{\n    \"platform_name\": \"LearnSQL.com\",\n    \"developer\": \"LearnSQL.com\",\n    \"features\": [\n        \"Interactive SQL tutorials\",\n        \"Real-world case studies\",\n        \"Coding challenges\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Data Analysts\",\n        \"Database Administrators\",\n        \"Developers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"SQL for Beginners\",\n            \"level\": \"Beginner\",\n            \"duration\": \"2 weeks\"\n        },\n        {\n            \"course_name\": \"Advanced SQL Techniques\",\n            \"level\": \"Advanced\",\n            \"duration\": \"4 weeks\"\n        }\n    ],\n    \"launch_date\": \"2018-05-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4,\n            \"comment\": \"Great for learning SQL, but could use more variety in exercises.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3,\n            \"comment\": \"Good resource, but the interface is a bit outdated.\"\n        }\n    ],\n    \"access_url\": \"https://learnsql.com\"\n}"}
