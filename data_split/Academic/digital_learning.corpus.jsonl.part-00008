{"_id": "Academic--digital_learning--p--71760", "text": "{\n    \"platform_name\": \"Skillshare\",\n    \"developer\": \"Skillshare Inc.\",\n    \"features\": [\n        \"Project-based learning\",\n        \"Community forums\",\n        \"Offline access\",\n        \"Expert instructors\",\n        \"Skill paths\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Creatives\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Graphic Design Basics\",\n            \"instructor\": \"Louise Fili\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Data Science Fundamentals\",\n            \"instructor\": \"Dr. Emily Carter\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2010-11-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"12345\",\n            \"rating\": 5,\n            \"comment\": \"Great mobile app, very easy to learn on the go!\"\n        },\n        {\n            \"user_id\": \"67890\",\n            \"rating\": 4,\n            \"comment\": \"Excellent courses for professional skills.\"\n        }\n    ],\n    \"access_url\": \"https://www.skillshare.com\"\n}"}
