{"_id": "Academic--digital_learning--p--71334", "text": "{\n    \"platform_name\": \"DataLearnPro\",\n    \"developer\": \"InnovateEd Solutions\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Personalized learning paths\",\n        \"Community forums\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Data Science\",\n            \"description\": \"A beginner-friendly course covering the fundamentals of data science.\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"description\": \"Hands-on course on implementing machine learning algorithms using Python.\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform! The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great content and well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datalearnpro.com\"\n}"}
{"_id": "Academic--digital_learning--n--71334", "text": "{\n    \"platform_name\": \"GlobalEdu\",\n    \"developer\": \"TechGiant Corp\",\n    \"features\": [\n        \"Video lectures\",\n        \"Quizzes\",\n        \"Downloadable resources\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Science Fundamentals\",\n            \"description\": \"An introductory course to the concepts of data science.\",\n            \"level\": \"Beginner\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Advanced Statistics\",\n            \"description\": \"A comprehensive course on statistical methods.\",\n            \"level\": \"Advanced\",\n            \"duration\": \"10 weeks\"\n        }\n    ],\n    \"launch_date\": \"2022-03-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Decent platform, but the interface feels a bit outdated.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4,\n            \"comment\": \"Good selection of courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.globaledu.org\"\n}"}
{"_id": "Academic--digital_learning--p--71335", "text": "{\n    \"platform_name\": \"Codecademy Pro\",\n    \"developer\": \"Codecademy\",\n    \"features\": [\n        \"Interactive coding challenges\",\n        \"Project-based learning\",\n        \"Real-world scenarios\",\n        \"Code editor\",\n        \"Progress tracking\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Learn Python 3\",\n            \"description\": \"A comprehensive course on Python programming.\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Web Development Fundamentals\",\n            \"description\": \"Learn HTML, CSS, and JavaScript.\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2011-03-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning to code! Very interactive and easy to understand.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great resource for beginners. The project-based learning is very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com/\"\n}"}
{"_id": "Academic--digital_learning--n--71335", "text": "{\n    \"platform_name\": \"HistoryOnline\",\n    \"developer\": \"Academic Publishers Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Reading materials\",\n        \"Quizzes\",\n        \"Discussion forums\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Researchers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Ancient Roman History\",\n            \"description\": \"A detailed exploration of the Roman Empire.\",\n            \"level\": \"Advanced\"\n        },\n        {\n            \"course_name\": \"Medieval European History\",\n            \"description\": \"The history of Europe during the Middle Ages.\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2021-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Good content, but the platform is a bit outdated.\"\n        }\n    ],\n    \"access_url\": \"https://historyonline.edu/\"\n}"}
{"_id": "Academic--digital_learning--p--71336", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp, Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscription tiers\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science!\"\n        },\n        {\n            \"user\": \"Bob\",\n            \"rating\": 4,\n            \"comment\": \"Interactive exercises are very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71336", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lectures\",\n        \"Practice exercises\",\n        \"Personalized learning dashboard\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Calculus I\",\n            \"level\": \"Beginner\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"Linear Algebra\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Statistics and Probability\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Charlie\",\n            \"rating\": 4,\n            \"comment\": \"Excellent resource for math education.\"\n        },\n        {\n            \"user\": \"David\",\n            \"rating\": 5,\n            \"comment\": \"Helped me understand difficult concepts.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
{"_id": "Academic--digital_learning--p--71337", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp BV\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill assessments\",\n        \"Project-based learning\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscription tiers\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Data types\",\n                \"Loops\",\n                \"Functions\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Regression\",\n                \"Classification\",\n                \"Clustering\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"topics\": [\n                \"Deep Learning\",\n                \"Big Data\",\n                \"Statistical Modeling\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-01-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"rating\": 5,\n            \"comment\": \"Highly engaging and practical. The interactive exercises are fantastic!\"\n        },\n        {\n            \"user_id\": \"456\",\n            \"rating\": 4,\n            \"comment\": \"Great for learning data science fundamentals.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
