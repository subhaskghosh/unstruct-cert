{"_id": "Academic--digital_learning--n--71621", "text": "{\n    \"platform_name\": \"PrepExpert\",\n    \"developer\": \"PrepExpert Education\",\n    \"features\": [\n        \"Live instruction\",\n        \"Practice exams\",\n        \"Score reports\",\n        \"Personalized study plans\"\n    ],\n    \"user_types\": [\n        \"Students\"\n    ],\n    \"subscription_model\": \"Paid Levels\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"SAT Prep\",\n            \"level\": \"All Levels\",\n            \"duration\": \"Variable\"\n        },\n        {\n            \"course_name\": \"ACT Prep\",\n            \"level\": \"All Levels\",\n            \"duration\": \"Variable\"\n        }\n    ],\n    \"launch_date\": \"2019-01-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice Johnson\",\n            \"rating\": 4,\n            \"comment\": \"Excellent for test preparation. Instructors are knowledgeable and helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.prepexpert.com\"\n}"}
{"_id": "Academic--digital_learning--p--71622", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Project-based learning\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science. Very interactive and well-structured.\"\n        },\n        {\n            \"user\": \"Bob\",\n            \"rating\": 4,\n            \"comment\": \"Helpful for upskilling. The projects are relevant and practical.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71622", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lessons\",\n        \"Practice exercises\",\n        \"Personalized learning\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Algebra I\",\n            \"level\": \"Beginner\",\n            \"duration\": \"Semester\"\n        },\n        {\n            \"course_name\": \"Calculus 1\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"Semester\"\n        },\n        {\n            \"course_name\": \"Statistics and Probability\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"Semester\"\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Charlie\",\n            \"rating\": 4,\n            \"comment\": \"A great resource for free education. Very comprehensive and easy to understand.\"\n        },\n        {\n            \"user\": \"David\",\n            \"rating\": 5,\n            \"comment\": \"Helped me a lot with my math classes. Highly recommended!\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
{"_id": "Academic--digital_learning--p--71623", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lessons\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium (limited access) / Paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"description\": \"Learn the fundamentals of Python programming.\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"description\": \"A comprehensive course on data science using R.\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"description\": \"Introduction to machine learning algorithms using Python.\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2016-07-12\",\n    \"user_feedback\": [\n        {\n            \"user\": \"John Doe\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science skills!\"\n        },\n        {\n            \"user\": \"Jane Smith\",\n            \"rating\": 4,\n            \"comment\": \"The hands-on projects are very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71623", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Assignments\",\n        \"Peer-graded assessments\",\n        \"Discussion forums\",\n        \"Certificates\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Lifelong learners\"\n    ],\n    \"subscription_model\": \"Individual courses / Specializations / Coursera Plus\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"description\": \"Introduction to machine learning concepts.\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"description\": \"A series of courses on deep learning.\",\n            \"level\": \"Advanced\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"description\": \"A comprehensive series of courses covering data science.\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2012-05-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice Brown\",\n            \"rating\": 4,\n            \"comment\": \"Good quality courses from top universities.\"\n        },\n        {\n            \"user\": \"Bob Johnson\",\n            \"rating\": 3,\n            \"comment\": \"Can be expensive depending on the specialization.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org\"\n}"}
