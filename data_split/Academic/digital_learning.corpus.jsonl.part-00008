{"_id": "Academic--digital_learning--p--70767", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Projects\",\n        \"Certification\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"subject\": \"Programming\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"subject\": \"Data Science\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Advanced\",\n            \"subject\": \"Machine Learning\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science. Very practical!\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--70767", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Peer assessments\",\n        \"Quizzes\",\n        \"Course certificates\",\n        \"Specializations\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Lifelong Learners\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"level\": \"Intermediate\",\n            \"subject\": \"Machine Learning\"\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"level\": \"Advanced\",\n            \"subject\": \"Machine Learning\"\n        },\n        {\n            \"course_name\": \"Theoretical Statistics\",\n            \"level\": \"Advanced\",\n            \"subject\": \"Statistics\"\n        }\n    ],\n    \"launch_date\": \"2012-05-10\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Bob\",\n            \"rating\": 4,\n            \"comment\": \"Excellent academic courses, very thorough.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org/\"\n}"}
{"_id": "Academic--digital_learning--p--70768", "text": "{\n    \"platform_name\": \"DataPro Academy\",\n    \"developer\": \"SkillUp Technologies\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Personalized learning paths\",\n        \"Project-based learning\",\n        \"Mentorship program\",\n        \"Certificate upon completion\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Career Changers\"\n    ],\n    \"subscription_model\": \"Freemium with premium tiers\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Science Bootcamp\",\n            \"description\": \"Comprehensive program covering data analysis, machine learning, and data visualization.\",\n            \"level\": \"Intermediate/Advanced\",\n            \"price\": 999\n        },\n        {\n            \"course_name\": \"Cybersecurity Fundamentals\",\n            \"description\": \"Introduction to cybersecurity principles and practices.\",\n            \"level\": \"Beginner\",\n            \"price\": 499\n        }\n    ],\n    \"launch_date\": \"2022-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.5,\n            \"comment\": \"Excellent platform for upskilling in data science.\"\n        }\n    ],\n    \"access_url\": \"https://www.dataprocademy.com\"\n}"}
{"_id": "Academic--digital_learning--n--70768", "text": "{\n    \"platform_name\": \"KidsLearn Online\",\n    \"developer\": \"EduFun Inc.\",\n    \"features\": [\n        \"Animated video lessons\",\n        \"Interactive games\",\n        \"Progress tracking\",\n        \"Parental controls\"\n    ],\n    \"user_types\": [\n        \"Children\",\n        \"Parents\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Basic Math\",\n            \"description\": \"Introduction to fundamental math concepts.\",\n            \"level\": \"Beginner\",\n            \"price\": 0\n        },\n        {\n            \"course_name\": \"Reading Comprehension\",\n            \"description\": \"Developing reading skills.\",\n            \"level\": \"Beginner\",\n            \"price\": 0\n        }\n    ],\n    \"launch_date\": \"2021-11-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4.0,\n            \"comment\": \"Great for my kids to learn basic skills!\"\n        }\n    ],\n    \"access_url\": \"https://www.kidslearnonline.com\"\n}"}
{"_id": "Academic--digital_learning--p--70769", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Projects\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Syntax\",\n                \"Data Structures\",\n                \"Control Flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with scikit-learn\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Regression\",\n                \"Classification\",\n                \"Clustering\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-02-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"DataCamp is very easy to use and the interactive exercises are great for learning.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"I found the courses well-structured and focused on practical application.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70769", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Assignments\",\n        \"Peer assessments\",\n        \"Discussion forums\",\n        \"Certificates\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Lifelong Learners\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Supervised Learning\",\n                \"Unsupervised Learning\",\n                \"Deep Learning\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"difficulty\": \"Advanced\",\n            \"topics\": [\n                \"Statistics\",\n                \"Data Analysis\",\n                \"Visualization\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2012-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4,\n            \"comment\": \"Coursera provides high-quality courses from top universities.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3,\n            \"comment\": \"The platform can be a bit complex to navigate.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org\"\n}"}
{"_id": "Academic--digital_learning--p--70770", "text": "{\n    \"platform_name\": \"DataLearn Pro\",\n    \"developer\": \"InnovateEd Tech\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Personalized learning paths\",\n        \"AI-powered tutoring\",\n        \"Project-based learning\",\n        \"Community forums\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"title\": \"Introduction to Data Science\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Python\",\n                \"Statistics\",\n                \"Data Visualization\"\n            ]\n        },\n        {\n            \"title\": \"Advanced Machine Learning\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Deep Learning\",\n                \"Reinforcement Learning\",\n                \"Natural Language Processing\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2021-05-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform! The AI tutor is incredibly helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datalearnpro.com\"\n}"}
{"_id": "Academic--digital_learning--n--70770", "text": "{\n    \"platform_name\": \"EduCentral\",\n    \"developer\": \"Global Education Solutions\",\n    \"features\": [\n        \"Video lectures\",\n        \"Quizzes\",\n        \"Discussion boards\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Paid - Tiered\",\n    \"courses_available\": [\n        {\n            \"title\": \"Fundamentals of History\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Ancient Civilizations\",\n                \"World Wars\"\n            ]\n        },\n        {\n            \"title\": \"Introductory Biology\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Cell Biology\",\n                \"Genetics\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2022-03-10\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Bob\",\n            \"rating\": 4,\n            \"comment\": \"Good resource, but could use more interactive elements.\"\n        }\n    ],\n    \"access_url\": \"https://www.educentral.org\"\n}"}
{"_id": "Academic--digital_learning--p--70771", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill tracks\",\n        \"Community forum\",\n        \"Project-based learning\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"subject\": \"Programming\"\n        },\n        {\n            \"course_name\": \"Machine Learning with scikit-learn\",\n            \"level\": \"Intermediate\",\n            \"subject\": \"Machine Learning\"\n        },\n        {\n            \"course_name\": \"Data Visualization with ggplot2\",\n            \"level\": \"Intermediate\",\n            \"subject\": \"Data Science\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Jane Doe\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science! The community is incredibly helpful.\"\n        },\n        {\n            \"user\": \"John Smith\",\n            \"rating\": 4,\n            \"comment\": \"Great interactive exercises and well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70771", "text": "{\n    \"platform_name\": \"Codecademy\",\n    \"developer\": \"Codecademy, Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Project-based learning\",\n        \"Career paths\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Beginners\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Learn HTML\",\n            \"level\": \"Beginner\",\n            \"subject\": \"Web Development\"\n        },\n        {\n            \"course_name\": \"Learn Python 3\",\n            \"level\": \"Beginner\",\n            \"subject\": \"Programming\"\n        },\n        {\n            \"course_name\": \"Introduction to SQL\",\n            \"level\": \"Beginner\",\n            \"subject\": \"Databases\"\n        }\n    ],\n    \"launch_date\": \"2011-08-03\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice Johnson\",\n            \"rating\": 3,\n            \"comment\": \"Good for basic introductions, but lacks advanced content.\"\n        },\n        {\n            \"user\": \"Bob Williams\",\n            \"rating\": 2,\n            \"comment\": \"The community forum isn't very active.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com\"\n}"}
