{"_id": "Academic--digital_learning--n--70802", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lessons\",\n        \"Practice exercises\",\n        \"Personalized learning dashboards\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Calculus 1\",\n            \"level\": \"High School\",\n            \"duration\": \"1 semester\"\n        },\n        {\n            \"course_name\": \"Linear Algebra\",\n            \"level\": \"College\",\n            \"duration\": \"1 semester\"\n        }\n    ],\n    \"launch_date\": \"2006-09-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Charlie\",\n            \"rating\": 5,\n            \"comment\": \"Excellent resource for free education.\"\n        },\n        {\n            \"user\": \"David\",\n            \"rating\": 4,\n            \"comment\": \"Helped me understand math concepts.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
{"_id": "Academic--digital_learning--p--70803", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_type\": \"Educator\",\n            \"rating\": 5,\n            \"comment\": \"Excellent resource for hands-on data science learning.  Very innovative approach.\"\n        },\n        {\n            \"user_type\": \"Student\",\n            \"rating\": 4,\n            \"comment\": \"Great platform for learning new skills.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--70803", "text": "{\n    \"platform_name\": \"Udemy\",\n    \"developer\": \"Udemy, Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Course marketplace\",\n        \"Q&A forums\",\n        \"Assignments\",\n        \"Certificates of completion\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Instructors\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Complete Python Bootcamp\",\n            \"level\": \"Beginner\",\n            \"duration\": \"30 hours\"\n        },\n        {\n            \"course_name\": \"The Data Science Course 2023: Complete Data Science Bootcamp\",\n            \"level\": \"Beginner\",\n            \"duration\": \"45 hours\"\n        },\n        {\n            \"course_name\": \"Machine Learning A-Z™: Hands-On Python & R In Data Science\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"40 hours\"\n        }\n    ],\n    \"launch_date\": \"2010-05-01\",\n    \"user_feedback\": [\n        {\n            \"user_type\": \"Student\",\n            \"rating\": 4,\n            \"comment\": \"Good value for money, but the quality of courses varies.\"\n        },\n        {\n            \"user_type\": \"Educator\",\n            \"rating\": 3,\n            \"comment\": \"Helpful for quick skills, but not the most cutting-edge platform.\"\n        }\n    ],\n    \"access_url\": \"https://www.udemy.com/\"\n}"}
