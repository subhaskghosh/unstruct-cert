{"_id": "Academic--digital_learning--n--71115", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lessons\",\n        \"Practice exercises\",\n        \"Progress tracking\",\n        \"Personalized learning\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\",\n        \"Parents\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"title\": \"Algebra I\",\n            \"level\": \"Beginner\",\n            \"topic\": \"Mathematics\"\n        },\n        {\n            \"title\": \"Calculus\",\n            \"level\": \"Intermediate\",\n            \"topic\": \"Mathematics\"\n        },\n        {\n            \"title\": \"AP Physics\",\n            \"level\": \"Advanced\",\n            \"topic\": \"Physics\"\n        }\n    ],\n    \"launch_date\": \"2006-09-16\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice Brown\",\n            \"rating\": 5,\n            \"comment\": \"A fantastic resource for K-12 education!\"\n        },\n        {\n            \"user\": \"Bob Green\",\n            \"rating\": 4,\n            \"comment\": \"Very helpful for understanding complex concepts.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
{"_id": "Academic--digital_learning--p--71116", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice Smith\",\n            \"rating\": 4.5,\n            \"comment\": \"Great platform for learning data science from scratch!\"\n        },\n        {\n            \"user\": \"Bob Johnson\",\n            \"rating\": 4.0,\n            \"comment\": \"Interactive exercises are very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71116", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Peer-graded assignments\",\n        \"Quizzes\",\n        \"Specializations\",\n        \"Degrees\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Lifelong learners\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"5 courses\"\n        }\n    ],\n    \"launch_date\": \"2012-05-10\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Charlie Brown\",\n            \"rating\": 3.5,\n            \"comment\": \"Good courses, but can be expensive.\"\n        },\n        {\n            \"user\": \"Diana Davis\",\n            \"rating\": 4.2,\n            \"comment\": \"Excellent instructors and high-quality content.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org\"\n}"}
{"_id": "Academic--digital_learning--p--71117", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Python syntax\",\n                \"Data types\",\n                \"Control flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Regression\",\n                \"Classification\",\n                \"Clustering\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"difficulty\": \"Advanced\",\n            \"topics\": [\n                \"Deep Learning\",\n                \"Big Data\",\n                \"Statistical Modeling\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-02-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science! The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"456\",\n            \"rating\": 4,\n            \"comment\": \"Good content, but could use more advanced courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71117", "text": "{\n    \"platform_name\": \"LearnWorlds\",\n    \"developer\": \"LearnWorlds\",\n    \"features\": [\n        \"Course builder\",\n        \"Video hosting\",\n        \"Interactive video\",\n        \"Community features\",\n        \"Marketing tools\"\n    ],\n    \"user_types\": [\n        \"Educators\",\n        \"Subject Matter Experts\",\n        \"Training Managers\"\n    ],\n    \"subscription_model\": \"Paid Plans\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Digital Marketing Fundamentals\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"SEO\",\n                \"Social Media Marketing\",\n                \"Email Marketing\"\n            ]\n        },\n        {\n            \"course_name\": \"Photography Masterclass\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Composition\",\n                \"Lighting\",\n                \"Editing\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2014-09-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"789\",\n            \"rating\": 4,\n            \"comment\": \"Great platform for creating and selling online courses.\"\n        },\n        {\n            \"user_id\": \"101\",\n            \"rating\": 3,\n            \"comment\": \"A bit complex to use at first, but powerful once you get the hang of it.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnworlds.com\"\n}"}
