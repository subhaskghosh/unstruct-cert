{"_id": "Academic--digital_learning--p--70330", "text": "{\n    \"platform_name\": \"DataLearn Pro\",\n    \"developer\": \"InnovateEd Technologies\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Personalized learning paths\",\n        \"Real-time collaboration\",\n        \"Project-based learning\",\n        \"AI-powered tutoring\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Data Science\",\n            \"level\": \"Beginner\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"16 weeks\"\n        },\n        {\n            \"course_name\": \"Deep Learning Fundamentals\",\n            \"level\": \"Advanced\",\n            \"duration\": \"20 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Extremely engaging and well-structured courses! The interactive exercises make learning so much fun.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great platform for learning data science. The personalized learning paths are very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datalearnpro.com\"\n}"}
