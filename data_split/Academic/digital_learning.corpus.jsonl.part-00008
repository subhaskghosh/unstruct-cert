{"_id": "Academic--digital_learning--n--71124", "text": "{\n    \"platform_name\": \"EduNexus\",\n    \"developer\": \"Global Education Tech\",\n    \"features\": [\n        \"Lecture recordings\",\n        \"Online quizzes\",\n        \"Discussion boards\",\n        \"Research paper database\",\n        \"Virtual laboratory simulations\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Researchers\",\n        \"Professors\"\n    ],\n    \"subscription_model\": \"Annual Subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Theoretical Physics\",\n            \"subject\": \"Physics\",\n            \"level\": \"Advanced\",\n            \"duration\": \"16 weeks\"\n        },\n        {\n            \"course_name\": \"Advanced Calculus\",\n            \"subject\": \"Mathematics\",\n            \"level\": \"Advanced\",\n            \"duration\": \"14 weeks\"\n        }\n    ],\n    \"launch_date\": \"2017-11-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3.5,\n            \"comment\": \"Content is comprehensive but the interface can be a bit complex.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3.0,\n            \"comment\": \"Good resources, but lacks practical application.\"\n        }\n    ],\n    \"access_url\": \"https://www.edunexus.org\"\n}"}
{"_id": "Academic--digital_learning--p--71125", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp BV\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill assessments\",\n        \"Career tracks\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python for Data Science\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with scikit-learn\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science! The community is very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good content and well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--71125", "text": "{\n    \"platform_name\": \"ABC Learning\",\n    \"developer\": \"ABC Education\",\n    \"features\": [\n        \"Basic video lectures\",\n        \"Simple quizzes\",\n        \"Downloadable notes\"\n    ],\n    \"user_types\": [\n        \"High School Students\",\n        \"Middle School Students\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Algebra\",\n            \"level\": \"Beginner\",\n            \"duration\": \"3 weeks\"\n        },\n        {\n            \"course_name\": \"Basic Geometry\",\n            \"level\": \"Beginner\",\n            \"duration\": \"2 weeks\"\n        }\n    ],\n    \"launch_date\": \"2022-05-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Okay for basic learning, but not very advanced.\"\n        }\n    ],\n    \"access_url\": \"https://www.abc-learning.com/\"\n}"}
{"_id": "Academic--digital_learning--p--71126", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-02-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"12345\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science!\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
