{"_id": "Academic--digital_learning--p--70254", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Project-based learning\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Very user-friendly and effective for learning data science.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great platform with lots of resources.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70254", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Assignments\",\n        \"Peer assessments\",\n        \"Specializations\",\n        \"Degrees\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Lifelong learners\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"5 courses\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"4 courses\"\n        }\n    ],\n    \"launch_date\": \"2012-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4,\n            \"comment\": \"Good course variety, but the interface can be a bit complex.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3,\n            \"comment\": \"Content is good, but the platform isn't as intuitive as others.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org\"\n}"}
{"_id": "Academic--digital_learning--p--70255", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science! Very interactive and engaging.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great resource for beginners. The exercises are helpful and the content is well-structured.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--70255", "text": "{\n    \"platform_name\": \"LearnCloud\",\n    \"developer\": \"Global Tech Solutions\",\n    \"features\": [\n        \"Pre-recorded video lectures\",\n        \"Downloadable course materials\",\n        \"Basic quizzes\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Statistics\",\n            \"level\": \"Beginner\",\n            \"duration\": \"5 weeks\"\n        },\n        {\n            \"course_name\": \"Web Development Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"7 weeks\"\n        },\n        {\n            \"course_name\": \"Data Analysis with Excel\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"4 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Decent content, but the platform feels a bit outdated and not very interactive.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"The video quality is poor and the quizzes are too easy.\"\n        }\n    ],\n    \"access_url\": \"https://www.learncloud.org/\"\n}"}
{"_id": "Academic--digital_learning--p--70256", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Project portfolio\",\n        \"Real-time feedback\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium (limited access), Paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-02-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science skills. The interactive exercises are very helpful!\"\n        },\n        {\n            \"user\": \"Bob\",\n            \"rating\": 4,\n            \"comment\": \"Good value for money. Lots of content and good support.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
