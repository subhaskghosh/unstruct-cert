{"_id": "Academic--digital_learning--n--71276", "text": "{\n    \"platform_name\": \"EduCentral\",\n    \"developer\": \"Global Education Group\",\n    \"features\": [\n        \"Video lectures\",\n        \"Downloadable resources\",\n        \"Quizzes\",\n        \"Discussion boards\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Paid - Tiered Levels\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to History\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Advanced Literature Analysis\",\n            \"level\": \"Advanced\",\n            \"duration\": \"10 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-09-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Decent content, but could be more engaging.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4,\n            \"comment\": \"Good for foundational knowledge.\"\n        }\n    ],\n    \"access_url\": \"https://www.educentral.org\"\n}"}
{"_id": "Academic--digital_learning--p--71277", "text": "{\n    \"platform_name\": \"SkillForge\",\n    \"developer\": \"LearnUp Technologies\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Project-based learning\",\n        \"Personalized learning paths\",\n        \"Career coaching\",\n        \"Industry certifications\"\n    ],\n    \"user_types\": [\n        \"Adult learners\",\n        \"Professionals\",\n        \"Career changers\"\n    ],\n    \"subscription_model\": \"Freemium with premium tiers\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Python for Data Science\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\",\n            \"price\": 99.99\n        },\n        {\n            \"course_name\": \"Digital Marketing Mastery\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\",\n            \"price\": 149.99\n        }\n    ],\n    \"launch_date\": \"2023-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for upskilling! The projects are very relevant to real-world jobs.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great content and helpful instructors. A bit pricey, but worth it.\"\n        }\n    ],\n    \"access_url\": \"https://www.skillforge.com\"\n}"}
{"_id": "Academic--digital_learning--n--71277", "text": "{\n    \"platform_name\": \"EduWorld\",\n    \"developer\": \"Global Education Group\",\n    \"features\": [\n        \"Video lectures\",\n        \"Quizzes\",\n        \"Discussion forums\",\n        \"Basic learning management system\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Lifelong Learners\"\n    ],\n    \"subscription_model\": \"Paid subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Algebra\",\n            \"level\": \"Beginner\",\n            \"duration\": \"6 weeks\",\n            \"price\": 49.99\n        },\n        {\n            \"course_name\": \"World History 101\",\n            \"level\": \"Beginner\",\n            \"duration\": \"10 weeks\",\n            \"price\": 69.99\n        }\n    ],\n    \"launch_date\": \"2022-11-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Good for basic courses, but not very in-depth.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"The platform is a bit outdated and the content isn't very engaging.\"\n        }\n    ],\n    \"access_url\": \"https://www.eduworld.org\"\n}"}
{"_id": "Academic--digital_learning--p--71278", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill assessments\",\n        \"Project-based learning\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscription tiers\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-07-12\",\n    \"user_feedback\": [\n        {\n            \"user\": \"John Doe\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science!\"\n        },\n        {\n            \"user\": \"Jane Smith\",\n            \"rating\": 4,\n            \"comment\": \"Very practical and hands-on.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71278", "text": "{\n    \"platform_name\": \"OpenLearn\",\n    \"developer\": \"The Open University\",\n    \"features\": [\n        \"Free courses\",\n        \"Study materials\",\n        \"Discussion forums\"\n    ],\n    \"user_types\": [\n        \"Lifelong learners\",\n        \"Students\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Cyber Security\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Understanding Finance\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"10 weeks\"\n        }\n    ],\n    \"launch_date\": \"2006-01-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice Brown\",\n            \"rating\": 3,\n            \"comment\": \"Good for basic learning, but lacks interactivity.\"\n        },\n        {\n            \"user\": \"Bob White\",\n            \"rating\": 4,\n            \"comment\": \"A great resource for free education.\"\n        }\n    ],\n    \"access_url\": \"https://www.open.edu/openlearn/\"\n}"}
{"_id": "Academic--digital_learning--p--71279", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Mobile app access\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Python Fundamentals\",\n                \"Data Structures\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Regression\",\n                \"Classification\",\n                \"Clustering\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Data Wrangling\",\n                \"Data Visualization\",\n                \"Statistical Analysis\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science skills. The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Mobile app works well and allows me to learn on the go.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71279", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lessons\",\n        \"Practice exercises\",\n        \"Progress tracking\",\n        \"Personalized learning\",\n        \"Free access\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Calculus 1\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Limits\",\n                \"Derivatives\",\n                \"Integrals\"\n            ]\n        },\n        {\n            \"course_name\": \"Linear Algebra\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Vectors\",\n                \"Matrices\",\n                \"Eigenvalues\"\n            ]\n        },\n        {\n            \"course_name\": \"Statistics and Probability\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Data Analysis\",\n                \"Probability Distributions\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 5,\n            \"comment\": \"Excellent resource for free education. Very clear explanations.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4,\n            \"comment\": \"Helpful for supplementing classroom learning.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
{"_id": "Academic--digital_learning--p--71280", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Real-world projects\",\n        \"Skill tracks\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Python basics\",\n                \"Data types\",\n                \"Control flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with scikit-learn\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Supervised learning\",\n                \"Unsupervised learning\",\n                \"Model evaluation\"\n            ]\n        },\n        {\n            \"course_name\": \"Deep Learning with TensorFlow\",\n            \"level\": \"Advanced\",\n            \"topics\": [\n                \"Neural networks\",\n                \"Convolutional neural networks\",\n                \"Recurrent neural networks\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science skills.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great interactive exercises and projects.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71280", "text": "{\n    \"platform_name\": \"LearnSQL\",\n    \"developer\": \"Slickytech\",\n    \"features\": [\n        \"Interactive SQL tutorials\",\n        \"SQL exercises\",\n        \"SQL practice database\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Database Administrators\",\n        \"Data Analysts\"\n    ],\n    \"subscription_model\": \"Paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to SQL\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"SELECT statements\",\n                \"WHERE clauses\",\n                \"JOINs\"\n            ]\n        },\n        {\n            \"course_name\": \"Advanced SQL\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Window functions\",\n                \"Stored procedures\",\n                \"Triggers\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2018-05-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4,\n            \"comment\": \"Good for learning SQL basics.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3,\n            \"comment\": \"Could use more advanced content.\"\n        }\n    ],\n    \"access_url\": \"https://learnsql.com\"\n}"}
{"_id": "Academic--digital_learning--p--71281", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill assessments\",\n        \"Career tracks\",\n        \"Project-based learning\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\",\n        \"Engineers\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science. Very interactive and practical.\"\n        },\n        {\n            \"user_id\": \"456\",\n            \"rating\": 4,\n            \"comment\": \"Good resource for beginners. The exercises are very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71281", "text": "{\n    \"platform_name\": \"LearnVerse\",\n    \"developer\": \"Global Education Tech\",\n    \"features\": [\n        \"Pre-recorded video lectures\",\n        \"Downloadable resources\",\n        \"Forum discussions\",\n        \"Quizzes\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Lifelong Learners\"\n    ],\n    \"subscription_model\": \"Paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"History of Art\",\n            \"level\": \"Beginner\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"Introductory Psychology\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Web Development Basics\",\n            \"level\": \"Beginner\",\n            \"duration\": \"6 weeks\"\n        }\n    ],\n    \"launch_date\": \"2023-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"789\",\n            \"rating\": 3,\n            \"comment\": \"Decent courses, but not very engaging.\"\n        },\n        {\n            \"user_id\": \"101\",\n            \"rating\": 2,\n            \"comment\": \"The video quality is poor.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnverse.edu\"\n}"}
{"_id": "Academic--digital_learning--p--71282", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Project-based learning\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Paid levels\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topic\": \"Data Science\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"topic\": \"Machine Learning\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"John Doe\",\n            \"rating\": 4.5,\n            \"comment\": \"The interface is very intuitive and the courses are well-structured.\"\n        },\n        {\n            \"user\": \"Jane Smith\",\n            \"rating\": 5.0,\n            \"comment\": \"Great for learning data science at your own pace!\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--71282", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lessons\",\n        \"Practice exercises\",\n        \"Personalized learning\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Statistics and probability\",\n            \"level\": \"Beginner\",\n            \"topic\": \"Mathematics\"\n        },\n        {\n            \"course_name\": \"Calculus 1\",\n            \"level\": \"Intermediate\",\n            \"topic\": \"Mathematics\"\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice Brown\",\n            \"rating\": 4.0,\n            \"comment\": \"Excellent resource for free learning.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org/\"\n}"}
{"_id": "Academic--digital_learning--p--71283", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill assessments\",\n        \"Project-based learning\",\n        \"Collaboration features\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Students\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Scientist with Python\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 months\"\n        },\n        {\n            \"course_name\": \"Data Analyst with R\",\n            \"level\": \"Beginner\",\n            \"duration\": \"3 months\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science! Very interactive and practical.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good content, but could use more advanced courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
