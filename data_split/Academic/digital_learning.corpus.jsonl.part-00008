{"_id": "Academic--digital_learning--p--70975", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill assessments\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-02-29\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"date\": \"2024-01-15\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science! The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"date\": \"2024-02-20\",\n            \"rating\": 4,\n            \"comment\": \"I appreciate the wide range of courses available. Updates are frequent.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70975", "text": "{\n    \"platform_name\": \"LearnHistoryOnline\",\n    \"developer\": \"Historical Education Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Documentaries\",\n        \"Quizzes\",\n        \"Historical timelines\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"History Enthusiasts\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Ancient Rome\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"World War II\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"10 weeks\"\n        }\n    ],\n    \"launch_date\": \"2019-12-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"date\": \"2021-05-01\",\n            \"rating\": 3,\n            \"comment\": \"Good course content, but the website feels outdated.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnhistoryonline.com\"\n}"}
{"_id": "Academic--digital_learning--p--70976", "text": "{\n    \"platform_name\": \"DataSpark Academy\",\n    \"developer\": \"InnovateEd Solutions\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Personalized learning paths\",\n        \"Project-based learning\",\n        \"Community forums\",\n        \"Real-time feedback\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Paid levels\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Data Science\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Data Visualization with Tableau\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science! The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great course content and supportive community.\"\n        }\n    ],\n    \"access_url\": \"https://www.datasparkacademy.com\"\n}"}
{"_id": "Academic--digital_learning--n--70976", "text": "{\n    \"platform_name\": \"LearnWise\",\n    \"developer\": \"EduTech Innovations\",\n    \"features\": [\n        \"Video lectures\",\n        \"Quizzes\",\n        \"Discussion boards\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Science Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"Statistical Analysis\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"7 weeks\"\n        }\n    ],\n    \"launch_date\": \"2022-03-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Good basic courses, but the free content is limited.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4,\n            \"comment\": \"Helpful for introductory concepts.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnwise.org\"\n}"}
{"_id": "Academic--digital_learning--p--70977", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"subject\": \"Data Science\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"subject\": \"Machine Learning\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2016-02-29\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70977", "text": "{\n    \"platform_name\": \"ChemCollective\",\n    \"developer\": \"Carnegie Mellon University\",\n    \"features\": [\n        \"Virtual labs\",\n        \"Simulations\",\n        \"Molecular modeling\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"General Chemistry I\",\n            \"subject\": \"Chemistry\",\n            \"level\": \"Introductory\"\n        },\n        {\n            \"course_name\": \"Organic Chemistry II\",\n            \"subject\": \"Chemistry\",\n            \"level\": \"Advanced\"\n        }\n    ],\n    \"launch_date\": \"2008-09-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Bob\",\n            \"rating\": 4,\n            \"comment\": \"Great resource for chemistry students.\"\n        }\n    ],\n    \"access_url\": \"https://chemcollective.org\"\n}"}
{"_id": "Academic--digital_learning--p--70978", "text": "{\n    \"platform_name\": \"SkillShape\",\n    \"developer\": \"LearnForward Inc.\",\n    \"features\": [\n        \"Interactive lessons\",\n        \"Progress tracking\",\n        \"Personalized learning paths\",\n        \"Community forums\",\n        \"Certificate of completion\"\n    ],\n    \"user_types\": [\n        \"Professionals\",\n        \"Managers\",\n        \"HR Professionals\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Leadership Essentials\",\n            \"description\": \"Develop core leadership skills for effective team management.\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Business Communication\",\n            \"description\": \"Mastering effective written and verbal communication in a business setting.\",\n            \"level\": \"Beginner\"\n        }\n    ],\n    \"launch_date\": \"2018-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Very user-friendly interface and great content for professional growth.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Helpful for improving my communication skills. Easy to navigate.\"\n        }\n    ],\n    \"access_url\": \"https://www.skillshape.com\"\n}"}
{"_id": "Academic--digital_learning--n--70978", "text": "{\n    \"platform_name\": \"CodeMasters\",\n    \"developer\": \"TechEdu Solutions\",\n    \"features\": [\n        \"Code editor\",\n        \"Debugging tools\",\n        \"Project-based learning\",\n        \"Coding challenges\",\n        \"Peer code review\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Software Developers\",\n        \"IT Professionals\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Python Fundamentals\",\n            \"description\": \"Learn the basics of Python programming.\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"JavaScript Web Development\",\n            \"description\": \"Build interactive web applications with JavaScript.\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2016-11-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4,\n            \"comment\": \"Excellent platform for learning to code!\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 5,\n            \"comment\": \"Really helped me improve my coding skills.\"\n        }\n    ],\n    \"access_url\": \"https://www.codemasters.net\"\n}"}
{"_id": "Academic--digital_learning--p--70979", "text": "{\n    \"platform_name\": \"DataLearn Pro\",\n    \"developer\": \"InnovateEd Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Personalized learning paths\",\n        \"Project-based learning\",\n        \"Community forum\",\n        \"AI-powered tutoring\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Data Science\",\n            \"level\": \"Beginner\",\n            \"instructor\": \"Dr. Emily Carter\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Intermediate\",\n            \"instructor\": \"David Lee\"\n        }\n    ],\n    \"launch_date\": \"2021-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"date\": \"2024-01-20\",\n            \"comment\": \"Great platform! The interactive exercises are really helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"date\": \"2024-02-10\",\n            \"comment\": \"Excellent resources for learning data science.\"\n        }\n    ],\n    \"access_url\": \"https://www.datalearnpro.com\"\n}"}
