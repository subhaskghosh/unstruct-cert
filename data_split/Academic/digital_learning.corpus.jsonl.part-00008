{"_id": "Academic--digital_learning--p--71272", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill tracks\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Python Syntax\",\n                \"Data Types\",\n                \"Control Flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Data Manipulation\",\n                \"Statistical Modeling\",\n                \"Data Visualization\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Supervised Learning\",\n                \"Unsupervised Learning\",\n                \"Model Evaluation\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-02-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science. Very beginner-friendly!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great courses and interactive exercises. Highly recommended.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71272", "text": "{\n    \"platform_name\": \"Kaplan\",\n    \"developer\": \"Kaplan, Inc.\",\n    \"features\": [\n        \"Live online classes\",\n        \"On-demand video lectures\",\n        \"Practice questions\",\n        \"Full-length practice exams\",\n        \"Score reports\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Test Takers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"SAT Prep\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Reading Comprehension\",\n                \"Math\",\n                \"Writing\"\n            ]\n        },\n        {\n            \"course_name\": \"ACT Prep\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"English\",\n                \"Math\",\n                \"Science\",\n                \"Reading\"\n            ]\n        },\n        {\n            \"course_name\": \"GRE Prep\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Verbal Reasoning\",\n                \"Quantitative Reasoning\",\n                \"Analytical Writing\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2018-05-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Helpful for test preparation, but expensive.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"Too focused on test-taking strategies.\"\n        }\n    ],\n    \"access_url\": \"https://www.kaplan.com\"\n}"}
{"_id": "Academic--digital_learning--p--71273", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill assessments\",\n        \"Project-based learning\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"course_level\": \"Beginner\",\n            \"topics_covered\": [\n                \"Python Syntax\",\n                \"Data Structures\",\n                \"Control Flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"course_level\": \"Intermediate\",\n            \"topics_covered\": [\n                \"Regression\",\n                \"Classification\",\n                \"Clustering\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"course_level\": \"Advanced\",\n            \"topics_covered\": [\n                \"Statistical Modeling\",\n                \"Data Visualization\",\n                \"Big Data\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-02-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science. Very practical and easy to follow.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good content, but can be a bit expensive.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71273", "text": "{\n    \"platform_name\": \"ABC Mouse\",\n    \"developer\": \"Age of Learning, Inc.\",\n    \"features\": [\n        \"Interactive Games\",\n        \"Educational Videos\",\n        \"Progress Tracking\",\n        \"Parent Dashboard\"\n    ],\n    \"user_types\": [\n        \"Children\",\n        \"Parents\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Reading with ABC Mouse\",\n            \"course_level\": \"Early Reader\",\n            \"topics_covered\": [\n                \"Phonics\",\n                \"Sight Words\",\n                \"Reading Comprehension\"\n            ]\n        },\n        {\n            \"course_name\": \"Math with ABC Mouse\",\n            \"course_level\": \"Early Math\",\n            \"topics_covered\": [\n                \"Counting\",\n                \"Shapes\",\n                \"Numbers\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2014-09-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"parent789\",\n            \"rating\": 4,\n            \"comment\": \"My child loves this platform! Great for early learning.\"\n        }\n    ],\n    \"access_url\": \"https://www.abcmouse.com\"\n}"}
{"_id": "Academic--digital_learning--p--71274", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lessons\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"difficulty\": \"Intermediate/Advanced\",\n            \"duration\": \"6 months\"\n        }\n    ],\n    \"launch_date\": \"2016-07-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.5,\n            \"comment\": \"Great platform for learning data science!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4.2,\n            \"comment\": \"Very practical and hands-on.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--71274", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Peer assessments\",\n        \"Assignments\",\n        \"Discussion forums\",\n        \"Certificates\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Lifelong learners\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"difficulty\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"difficulty\": \"Advanced\",\n            \"duration\": \"5 courses\"\n        }\n    ],\n    \"launch_date\": \"2012-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3.8,\n            \"comment\": \"Good courses, but can be expensive.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4.0,\n            \"comment\": \"Helpful for career advancement.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org/\"\n}"}
{"_id": "Academic--digital_learning--p--71275", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp BV\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\"\n    ],\n    \"subscription_model\": \"Paid subscription tiers\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Scientist with Python\",\n            \"duration\": \"6 months\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"duration\": \"3 months\",\n            \"level\": \"Beginner\"\n        }\n    ],\n    \"launch_date\": \"2016-01-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice\",\n            \"comment\": \"DataCamp has been instrumental in upskilling my data science knowledge. The interactive exercises are very effective!\"\n        },\n        {\n            \"user\": \"Bob\",\n            \"comment\": \"Excellent platform, keeps me up-to-date with the latest machine learning techniques. Innovative approach.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--71275", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lessons\",\n        \"Practice exercises\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\",\n        \"Parents\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Algebra I\",\n            \"duration\": \"1 year\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Calculus\",\n            \"duration\": \"1 year\",\n            \"level\": \"Advanced\"\n        }\n    ],\n    \"launch_date\": \"2008-09-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Charlie\",\n            \"comment\": \"Great resource for learning basic math concepts.\"\n        },\n        {\n            \"user\": \"Diana\",\n            \"comment\": \"Helped my child improve their math grades.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org/\"\n}"}
