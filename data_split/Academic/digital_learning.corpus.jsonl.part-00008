{"_id": "Academic--digital_learning--p--71113", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Python fundamentals\",\n                \"Data types\",\n                \"Control flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Supervised learning\",\n                \"Unsupervised learning\",\n                \"Model evaluation\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"difficulty\": \"Advanced\",\n            \"topics\": [\n                \"Statistical modeling\",\n                \"Data visualization\",\n                \"Big data analysis\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-01-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science skills!\"\n        },\n        {\n            \"user\": \"Bob\",\n            \"rating\": 4,\n            \"comment\": \"Interactive exercises are very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71113", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Peer assessments\",\n        \"Assignments\",\n        \"Discussion forums\",\n        \"Certificates\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Lifelong learners\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Regression\",\n                \"Classification\",\n                \"Neural Networks\"\n            ]\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"difficulty\": \"Advanced\",\n            \"topics\": [\n                \"Convolutional Neural Networks\",\n                \"Recurrent Neural Networks\",\n                \"TensorFlow\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2012-05-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Charlie\",\n            \"rating\": 4,\n            \"comment\": \"Good content, but can be expensive.\"\n        },\n        {\n            \"user\": \"David\",\n            \"rating\": 3,\n            \"comment\": \"Assignments are challenging.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org\"\n}"}
{"_id": "Academic--digital_learning--p--71114", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Python basics\",\n                \"Data structures\",\n                \"Control flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Regression\",\n                \"Classification\",\n                \"Clustering\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"topics\": [\n                \"Statistical modeling\",\n                \"Data visualization\",\n                \"Big data technologies\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science! The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good courses and a supportive community.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
