{"_id": "Academic--digital_learning--n--70399", "text": "{\n    \"platform_name\": \"Codecademy\",\n    \"developer\": \"Codecademy, Inc.\",\n    \"features\": [\n        \"Interactive coding\",\n        \"Project-based learning\",\n        \"Career paths\",\n        \"Certificate programs\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Beginners\"\n    ],\n    \"subscription_model\": \"Paid subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Learn Python 3\",\n            \"difficulty\": \"Beginner\",\n            \"duration\": \"3 months\"\n        },\n        {\n            \"course_name\": \"Introduction to Data Science\",\n            \"difficulty\": \"Beginner\",\n            \"duration\": \"2 months\"\n        }\n    ],\n    \"launch_date\": \"2011-08-29\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good for starting to code but lacks advanced features.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com/\"\n}"}
{"_id": "Academic--digital_learning--p--70400", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science! The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"A great way to upskill in data analysis. Highly recommend.\"\n        },\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 5,\n            \"comment\": \"Very user-friendly and comprehensive. I've learned a lot.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--70400", "text": "{\n    \"platform_name\": \"Codecademy\",\n    \"developer\": \"Codecademy, Inc.\",\n    \"features\": [\n        \"Interactive coding tutorials\",\n        \"Career paths\",\n        \"Projects\",\n        \"Quizzes\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Beginners\",\n        \"Career Switchers\"\n    ],\n    \"subscription_model\": \"Freemium with paid Pro access\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Learn HTML\",\n            \"level\": \"Beginner\",\n            \"duration\": \"2 weeks\"\n        },\n        {\n            \"course_name\": \"Learn Python 3\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Path\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 months\"\n        }\n    ],\n    \"launch_date\": \"2011-08-21\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user101\",\n            \"rating\": 3,\n            \"comment\": \"Good for basic coding skills but lacks depth for advanced topics.\"\n        },\n        {\n            \"user_id\": \"user102\",\n            \"rating\": 2,\n            \"comment\": \"The interface can be clunky and frustrating at times.\"\n        },\n        {\n            \"user_id\": \"user103\",\n            \"rating\": 4,\n            \"comment\": \"Helpful for getting started, but needs more real-world projects.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com/\"\n}"}
