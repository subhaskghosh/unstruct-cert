{"_id": "Academic--digital_learning--p--70489", "text": "{\n    \"platform_name\": \"DataLearn Pro\",\n    \"developer\": \"InnovateEd Technologies\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Personalized learning paths\",\n        \"Real-world projects\",\n        \"Community forums\",\n        \"AI-powered feedback\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Data Science\",\n            \"level\": \"Beginner\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"16 weeks\"\n        },\n        {\n            \"course_name\": \"Deep Learning Fundamentals\",\n            \"level\": \"Advanced\",\n            \"duration\": \"20 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science. The interactive exercises are very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datalearnpro.com\"\n}"}
{"_id": "Academic--digital_learning--n--70489", "text": "{\n    \"platform_name\": \"EduCentral\",\n    \"developer\": \"Global Education Systems\",\n    \"features\": [\n        \"Video lectures\",\n        \"Quizzes\",\n        \"Downloadable resources\",\n        \"Discussion boards\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Paid - Tiered\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Algebra I\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"World History\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"Introductory Physics\",\n            \"level\": \"Beginner\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2022-01-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good platform for general academic subjects.\"\n        }\n    ],\n    \"access_url\": \"https://www.educentral.org\"\n}"}
{"_id": "Academic--digital_learning--p--70490", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Python basics\",\n                \"Data types\",\n                \"Control flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Regression\",\n                \"Classification\",\n                \"Clustering\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"difficulty\": \"Advanced\",\n            \"topics\": [\n                \"Statistical inference\",\n                \"Data visualization\",\n                \"Big data analysis\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science! Very interactive and well-structured.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Helpful for brushing up on my skills.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70490", "text": "{\n    \"platform_name\": \"Skillshare\",\n    \"developer\": \"Skillshare Inc.\",\n    \"features\": [\n        \"Video courses\",\n        \"Project-based learning\",\n        \"Community challenges\",\n        \"Offline access\"\n    ],\n    \"user_types\": [\n        \"Creatives\",\n        \"Entrepreneurs\",\n        \"Lifelong Learners\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Graphic Design Basics\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Color theory\",\n                \"Typography\",\n                \"Layout design\"\n            ]\n        },\n        {\n            \"course_name\": \"Introduction to Marketing\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Social media marketing\",\n                \"Content marketing\",\n                \"Email marketing\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Analysis with Excel\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Pivot tables\",\n                \"Charts\",\n                \"Formulas\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2010-03-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Good range of courses, but quality varies.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4,\n            \"comment\": \"Inspiring and creative courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.skillshare.com\"\n}"}
{"_id": "Academic--digital_learning--p--70491", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"category\": \"Data Science\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Scikit-learn\",\n            \"category\": \"Machine Learning\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2016-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science! Regularly updated with new content.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great for beginners, the interactive exercises are very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70491", "text": "{\n    \"platform_name\": \"LearnHistoryOnline\",\n    \"developer\": \"HistoryEd LLC\",\n    \"features\": [\n        \"Video lectures\",\n        \"Historical document analysis\",\n        \"Interactive timelines\",\n        \"Quizzes\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"History Enthusiasts\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Ancient Roman Civilization\",\n            \"category\": \"History\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"World War II\",\n            \"category\": \"History\",\n            \"level\": \"Advanced\"\n        }\n    ],\n    \"launch_date\": \"2021-03-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Good content, but the website feels a bit outdated.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"The platform hasn't been updated in a while.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnhistoryonline.com\"\n}"}
{"_id": "Academic--digital_learning--p--70492", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp BV\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lessons\",\n        \"Project-based learning\",\n        \"Skill assessments\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Syntax\",\n                \"Data Structures\",\n                \"Control Flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Regression\",\n                \"Classification\",\n                \"Clustering\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-02-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science skills. The interactive exercises are very helpful.\"\n        },\n        {\n            \"user\": \"Bob\",\n            \"rating\": 4,\n            \"comment\": \"Excellent content, easy to follow.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
