{"_id": "Academic--digital_learning--n--70469", "text": "{\n    \"platform_name\": \"EduCentral\",\n    \"developer\": \"Global Education Group\",\n    \"features\": [\n        \"Video lectures\",\n        \"Quizzes\",\n        \"Downloadable resources\",\n        \"Live Q&A sessions\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to History\",\n            \"subject\": \"History\",\n            \"level\": \"Beginner\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Basic English Grammar\",\n            \"subject\": \"English\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        }\n    ],\n    \"launch_date\": \"2022-01-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Decent platform, but lacks advanced features.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"The website is slow and unresponsive.\"\n        }\n    ],\n    \"access_url\": \"https://www.educentral.org\"\n}"}
{"_id": "Academic--digital_learning--p--70470", "text": "{\n    \"platform_name\": \"DataLearn Pro\",\n    \"developer\": \"InnovateEd Tech\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Personalized learning paths\",\n        \"Real-world projects\",\n        \"Community forums\",\n        \"AI-powered tutoring\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Data Science\",\n            \"level\": \"Beginner\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"16 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform! The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great content and well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datalearnpro.com\"\n}"}
{"_id": "Academic--digital_learning--n--70470", "text": "{\n    \"platform_name\": \"StudyBasic\",\n    \"developer\": \"Legacy Learning Solutions\",\n    \"features\": [\n        \"Video lectures\",\n        \"Downloadable notes\",\n        \"Basic quizzes\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introductory Statistics\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Data Analysis Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"6 weeks\"\n        }\n    ],\n    \"launch_date\": \"2018-11-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"The platform is functional, but the interface feels dated.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"Limited features and not very engaging.\"\n        }\n    ],\n    \"access_url\": \"https://www.studybasic.net\"\n}"}
{"_id": "Academic--digital_learning--p--70471", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill tracks\",\n        \"Project portfolio\",\n        \"Career guidance\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"course_level\": \"Beginner\",\n            \"course_duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"course_level\": \"Intermediate\",\n            \"course_duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"course_level\": \"Advanced\",\n            \"course_duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.5,\n            \"comment\": \"Great platform for learning data science!\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70471", "text": "{\n    \"platform_name\": \"Codecademy\",\n    \"developer\": \"Codecademy\",\n    \"features\": [\n        \"Interactive coding lessons\",\n        \"Project-based learning\",\n        \"Code editor\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Beginners\",\n        \"Web Developers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to HTML\",\n            \"course_level\": \"Beginner\",\n            \"course_duration\": \"2 weeks\"\n        },\n        {\n            \"course_name\": \"JavaScript Fundamentals\",\n            \"course_level\": \"Intermediate\",\n            \"course_duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Analysis with Python\",\n            \"course_level\": \"Intermediate\",\n            \"course_duration\": \"6 weeks\"\n        }\n    ],\n    \"launch_date\": \"2011-08-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4.0,\n            \"comment\": \"Good for learning basic web development.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com\"\n}"}
{"_id": "Academic--digital_learning--p--70472", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp BV\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Project portfolio\",\n        \"Real-world datasets\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-02-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science skills. Very practical and hands-on.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70472", "text": "{\n    \"platform_name\": \"LearnVerse\",\n    \"developer\": \"EduTech Solutions Inc.\",\n    \"features\": [\n        \"Pre-recorded video lectures\",\n        \"Downloadable course materials\",\n        \"Quizzes\",\n        \"Discussion forums\"\n    ],\n    \"user_types\": [\n        \"High School Students\",\n        \"College Students\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Calculus I\",\n            \"level\": \"Beginner\",\n            \"duration\": \"16 weeks\"\n        },\n        {\n            \"course_name\": \"Organic Chemistry\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"14 weeks\"\n        },\n        {\n            \"course_name\": \"Linear Algebra\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2022-05-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"student456\",\n            \"rating\": 4,\n            \"comment\": \"Good for supplementing school coursework, but not much focus on real-world application.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnverse.org\"\n}"}
{"_id": "Academic--digital_learning--p--70473", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill assessments\",\n        \"Project-based learning\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-02-17\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"rating\": 4.5,\n            \"comment\": \"Excellent platform for learning data science.\"\n        },\n        {\n            \"user_id\": \"456\",\n            \"rating\": 4.2,\n            \"comment\": \"Very interactive and engaging courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--70473", "text": "{\n    \"platform_name\": \"LearnSQL.com\",\n    \"developer\": \"SQLCourse LLC\",\n    \"features\": [\n        \"Interactive SQL tutorials\",\n        \"Quizzes\",\n        \"Certificate upon completion\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Database Administrators\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"SQL Basics\",\n            \"level\": \"Beginner\",\n            \"duration\": \"2 weeks\"\n        },\n        {\n            \"course_name\": \"Advanced SQL\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"4 weeks\"\n        }\n    ],\n    \"launch_date\": \"2018-05-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"789\",\n            \"rating\": 3.2,\n            \"comment\": \"Good for learning SQL, but could be more engaging.\"\n        },\n        {\n            \"user_id\": \"101\",\n            \"rating\": 3.0,\n            \"comment\": \"A bit too basic for experienced users.\"\n        }\n    ],\n    \"access_url\": \"https://learnsql.com/\"\n}"}
{"_id": "Academic--digital_learning--p--70474", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp BV\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill tracks\",\n        \"Projects\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Python basics\",\n                \"Data structures\",\n                \"Control flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with scikit-learn\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Supervised learning\",\n                \"Unsupervised learning\",\n                \"Model evaluation\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Manipulation with pandas\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Data cleaning\",\n                \"Data transformation\",\n                \"Data analysis\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-02-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science. The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good content and well-structured courses.\"\n        },\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 5,\n            \"comment\": \"Highly recommend for anyone looking to upskill in data science.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70474", "text": "{\n    \"platform_name\": \"LearnJavaOnline\",\n    \"developer\": \"Java Tutorials Inc.\",\n    \"features\": [\n        \"Video tutorials\",\n        \"Code examples\",\n        \"Quizzes\",\n        \"Downloadable resources\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Beginner Programmers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Java Fundamentals\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Java syntax\",\n                \"Object-oriented programming\",\n                \"Data types\"\n            ]\n        },\n        {\n            \"course_name\": \"Advanced Java Concepts\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Multithreading\",\n                \"Networking\",\n                \"Databases\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2019-12-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user101\",\n            \"rating\": 3,\n            \"comment\": \"Decent tutorials, but the website looks outdated.\"\n        },\n        {\n            \"user_id\": \"user102\",\n            \"rating\": 2,\n            \"comment\": \"The quizzes are not very challenging.\"\n        },\n        {\n            \"user_id\": \"user103\",\n            \"rating\": 3,\n            \"comment\": \"Some videos are low quality.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnjavaonline.com\"\n}"}
