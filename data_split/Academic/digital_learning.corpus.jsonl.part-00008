{"_id": "Academic--digital_learning--n--71151", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Google\",\n    \"features\": [\n        \"Video lectures\",\n        \"Assignments\",\n        \"Peer-graded assessments\",\n        \"Specializations\",\n        \"Certificates\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Lifelong learners\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"5 courses\"\n        },\n        {\n            \"course_name\": \"Python for Everybody\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2012-02-18\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4,\n            \"comment\": \"Good platform, but can be expensive.\"\n        },\n        {\n            \"user_id\": \"user101\",\n            \"rating\": 3,\n            \"comment\": \"Content is good but interface could be improved.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org/\"\n}"}
