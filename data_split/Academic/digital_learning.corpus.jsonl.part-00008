{"_id": "Academic--digital_learning--p--71016", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Project-based learning\",\n        \"Real-world datasets\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium (with paid subscriptions for full access)\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Scientist with Python\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Python\",\n                \"Data Analysis\",\n                \"Machine Learning\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"difficulty\": \"Advanced\",\n            \"topics\": [\n                \"Statistics\",\n                \"R\",\n                \"Data Visualization\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-02-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"rating\": 4.5,\n            \"comment\": \"Excellent platform for learning data science skills.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
