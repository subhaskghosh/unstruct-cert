{"_id": "Academic--digital_learning--n--71315", "text": "{\n    \"platform_name\": \"AcademiaNexus\",\n    \"developer\": \"University Learning Consortium\",\n    \"features\": [\n        \"Lecture videos\",\n        \"Reading materials\",\n        \"Discussion boards\",\n        \"Quizzes\",\n        \"Research paper repository\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Researchers\",\n        \"Professors\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Classical Literature Analysis\",\n            \"duration\": \"15 weeks\",\n            \"level\": \"Advanced\"\n        },\n        {\n            \"course_name\": \"Theoretical Physics\",\n            \"duration\": \"18 weeks\",\n            \"level\": \"Graduate\"\n        }\n    ],\n    \"launch_date\": \"2022-03-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Good resource for academic research, but a bit dry for casual learners.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4,\n            \"comment\": \"Comprehensive collection of academic materials.\"\n        }\n    ],\n    \"access_url\": \"https://www.academicianexus.org\"\n}"}
{"_id": "Academic--digital_learning--p--71316", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Project-based learning\",\n        \"Real-time feedback\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"3 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science! The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good value for the price. I've learned a lot.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71316", "text": "{\n    \"platform_name\": \"ABC Learning\",\n    \"developer\": \"ABC Educational Solutions\",\n    \"features\": [\n        \"Pre-recorded lectures\",\n        \"Basic quizzes\",\n        \"Downloadable resources\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Paid monthly\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Computer Basics\",\n            \"level\": \"Beginner\",\n            \"duration\": \"2 weeks\"\n        },\n        {\n            \"course_name\": \"Microsoft Office Suite\",\n            \"level\": \"Beginner\",\n            \"duration\": \"1 week\"\n        }\n    ],\n    \"launch_date\": \"2018-07-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Okay for basic learning, but not very in-depth.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"Content is very simplistic.\"\n        }\n    ],\n    \"access_url\": \"https://www.abclearning.com\"\n}"}
{"_id": "Academic--digital_learning--p--71317", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill assessments\",\n        \"Career tracks\",\n        \"Project-based learning\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\",\n        \"Data Analysts\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscription tiers\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"category\": \"Data Science\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"difficulty\": \"Intermediate\",\n            \"category\": \"Machine Learning\"\n        },\n        {\n            \"course_name\": \"Data Visualization with Tableau\",\n            \"difficulty\": \"Intermediate\",\n            \"category\": \"Data Science\"\n        }\n    ],\n    \"launch_date\": \"2016-02-08\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science! The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great resource, but could use more advanced courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71317", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lectures\",\n        \"Practice exercises\",\n        \"Personalized learning\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Algebra I\",\n            \"difficulty\": \"Beginner\",\n            \"category\": \"Mathematics\"\n        },\n        {\n            \"course_name\": \"Calculus I\",\n            \"difficulty\": \"Intermediate\",\n            \"category\": \"Mathematics\"\n        },\n        {\n            \"course_name\": \"Statistics and Probability\",\n            \"difficulty\": \"Intermediate\",\n            \"category\": \"Mathematics\"\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 5,\n            \"comment\": \"A fantastic free resource for learning! Very helpful for students.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4,\n            \"comment\": \"Great for foundational concepts, but lacks depth in specialized areas.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
{"_id": "Academic--digital_learning--p--71318", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Data visualization tools\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Educators\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Python basics\",\n                \"Data structures\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Regression\",\n                \"Classification\",\n                \"Clustering\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"topics\": [\n                \"Deep Learning\",\n                \"Big Data\",\n                \"Statistical Modeling\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-02-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science! Very interactive and practical.\"\n        },\n        {\n            \"user\": \"Bob\",\n            \"rating\": 4,\n            \"comment\": \"Good content and well-structured courses. The user interface is intuitive.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71318", "text": "{\n    \"platform_name\": \"ABCmouse\",\n    \"developer\": \"Age of Learning, Inc.\",\n    \"features\": [\n        \"Educational games\",\n        \"Interactive stories\",\n        \"Progress tracking\",\n        \"Parent dashboards\"\n    ],\n    \"user_types\": [\n        \"Preschoolers\",\n        \"Kindergarteners\",\n        \"Parents\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Paid Subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Early Math\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Counting\",\n                \"Shapes\"\n            ]\n        },\n        {\n            \"course_name\": \"Reading Readiness\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Phonics\",\n                \"Sight Words\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2010-09-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Carol\",\n            \"rating\": 4,\n            \"comment\": \"My child loves this platform! It's a fun way to learn.\"\n        },\n        {\n            \"user\": \"David\",\n            \"rating\": 3,\n            \"comment\": \"Good for early learners, but not much beyond kindergarten level.\"\n        }\n    ],\n    \"access_url\": \"https://www.abcmouse.com\"\n}"}
{"_id": "Academic--digital_learning--p--71319", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp BV\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\",\n        \"Data Analysts\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Python basics\",\n                \"Data structures\",\n                \"Control flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"R programming\",\n                \"Data visualization\",\n                \"Statistical modeling\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"topics\": [\n                \"Machine Learning\",\n                \"Deep Learning\",\n                \"Data Mining\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-02-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.5,\n            \"comment\": \"Great platform for learning data science skills. Very interactive and practical.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4.2,\n            \"comment\": \"Easy to use and the courses are well-structured.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71319", "text": "{\n    \"platform_name\": \"LearnSwift\",\n    \"developer\": \"KodeSwift\",\n    \"features\": [\n        \"Video tutorials\",\n        \"Coding challenges\",\n        \"Community forum\",\n        \"Project templates\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Developers\"\n    ],\n    \"subscription_model\": \"Paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"SwiftUI Fundamentals\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"SwiftUI layout\",\n                \"UI components\",\n                \"Data binding\"\n            ]\n        },\n        {\n            \"course_name\": \"Advanced Swift Programming\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Concurrency\",\n                \"Networking\",\n                \"Data persistence\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2021-05-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3.8,\n            \"comment\": \"Good resource for learning Swift, but the interface could be more intuitive.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4.1,\n            \"comment\": \"Helpful tutorials and a supportive community.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnswift.com\"\n}"}
{"_id": "Academic--digital_learning--p--71320", "text": "{\n    \"platform_name\": \"SkillBridge\",\n    \"developer\": \"InnovateEd Solutions\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Project-based learning\",\n        \"Personalized learning paths\",\n        \"Community forums\",\n        \"Progress tracking\",\n        \"Live mentorship sessions\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Python for Data Science\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\",\n            \"price\": 99.99\n        },\n        {\n            \"course_name\": \"Web Development Bootcamp\",\n            \"level\": \"Beginner\",\n            \"duration\": \"16 weeks\",\n            \"price\": 149.99\n        }\n    ],\n    \"launch_date\": \"2021-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.8,\n            \"comment\": \"Excellent platform for hands-on learning! The projects are really practical.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4.5,\n            \"comment\": \"Great resources and supportive community.\"\n        }\n    ],\n    \"access_url\": \"https://www.skillbridge.com\"\n}"}
{"_id": "Academic--digital_learning--n--71320", "text": "{\n    \"platform_name\": \"EduCentral\",\n    \"developer\": \"Global Education Tech\",\n    \"features\": [\n        \"Video lectures\",\n        \"Downloadable course materials\",\n        \"Quizzes\",\n        \"Discussion boards\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Parents\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Algebra\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\",\n            \"price\": 49.99\n        },\n        {\n            \"course_name\": \"World History\",\n            \"level\": \"High School\",\n            \"duration\": \"10 weeks\",\n            \"price\": 79.99\n        }\n    ],\n    \"launch_date\": \"2022-03-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3.5,\n            \"comment\": \"Decent content, but the interface feels a bit outdated.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3.0,\n            \"comment\": \"Could use more interactive elements.\"\n        }\n    ],\n    \"access_url\": \"https://www.educentral.org\"\n}"}
{"_id": "Academic--digital_learning--p--71321", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium (limited access), Paid Subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"3 weeks\",\n            \"topics\": [\n                \"Variables\",\n                \"Data Types\",\n                \"Control Flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Foundations\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\",\n            \"topics\": [\n                \"Data Visualization\",\n                \"Statistical Analysis\",\n                \"Machine Learning Basics\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science. The support team is very responsive and helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great interactive exercises, makes learning fun!\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71321", "text": "{\n    \"platform_name\": \"MIT OpenCourseWare\",\n    \"developer\": \"Massachusetts Institute of Technology\",\n    \"features\": [\n        \"Video lectures\",\n        \"Course materials\",\n        \"Assignments\",\n        \"Exams\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Researchers\",\n        \"Lifelong Learners\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Machine Learning\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"1 semester\",\n            \"topics\": [\n                \"Linear Regression\",\n                \"Logistic Regression\",\n                \"Neural Networks\"\n            ]\n        },\n        {\n            \"course_name\": \"Mathematics for Computer Science\",\n            \"level\": \"Advanced\",\n            \"duration\": \"1 semester\",\n            \"topics\": [\n                \"Logic\",\n                \"Proof Techniques\",\n                \"Discrete Mathematics\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2001-01-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4,\n            \"comment\": \"High quality materials, but can be very theoretical.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3,\n            \"comment\": \"Great resource, but requires a strong mathematical background.\"\n        }\n    ],\n    \"access_url\": \"https://ocw.mit.edu\"\n}"}
{"_id": "Academic--digital_learning--p--71322", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill tracks\",\n        \"Career paths\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Data types\",\n                \"Control flow\",\n                \"Functions\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Supervised learning\",\n                \"Unsupervised learning\",\n                \"Model evaluation\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"difficulty\": \"Advanced\",\n            \"topics\": [\n                \"Statistical inference\",\n                \"Data visualization\",\n                \"Big data analytics\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-01-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.5,\n            \"comment\": \"Great platform for learning data science skills. The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 5.0,\n            \"comment\": \"Excellent course content and a supportive community.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71322", "text": "{\n    \"platform_name\": \"LearnChessOnline\",\n    \"developer\": \"ChessMaster Inc.\",\n    \"features\": [\n        \"Interactive lessons\",\n        \"Puzzle solving\",\n        \"Game analysis\",\n        \"Live tournaments\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Chess Enthusiasts\"\n    ],\n    \"subscription_model\": \"Paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Chess Fundamentals\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Piece movement\",\n                \"Basic tactics\",\n                \"Opening principles\"\n            ]\n        },\n        {\n            \"course_name\": \"Advanced Chess Strategy\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Positional play\",\n                \"Endgame technique\",\n                \"Opening repertoire\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2022-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4.0,\n            \"comment\": \"Good platform for improving chess skills.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3.5,\n            \"comment\": \"The interface is a bit clunky, but the lessons are helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnchessonline.com\"\n}"}
{"_id": "Academic--digital_learning--p--71323", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp BV\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscription tiers (up to $25/month)\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"category\": \"Data Science\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"category\": \"Machine Learning\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2016-01-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"12345\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science. Very supportive community and well-structured courses.\"\n        },\n        {\n            \"user_id\": \"67890\",\n            \"rating\": 4,\n            \"comment\": \"I found the interactive coding exercises very helpful. The pace is good for beginners.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--71323", "text": "{\n    \"platform_name\": \"LearnSQL.com\",\n    \"developer\": \"DataCamp BV\",\n    \"features\": [\n        \"Interactive SQL tutorials\",\n        \"Real-world case studies\",\n        \"Certification exams\"\n    ],\n    \"user_types\": [\n        \"Data Analysts\",\n        \"Database Administrators\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Paid subscription (around $35/month)\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"SQL for Beginners\",\n            \"category\": \"Database\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Advanced SQL\",\n            \"category\": \"Database\",\n            \"level\": \"Advanced\"\n        }\n    ],\n    \"launch_date\": \"2018-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"98765\",\n            \"rating\": 4,\n            \"comment\": \"Good for learning SQL, but could use more visual aids.\"\n        },\n        {\n            \"user_id\": \"54321\",\n            \"rating\": 3,\n            \"comment\": \"The courses are well-organized, but the interface feels a bit dated.\"\n        }\n    ],\n    \"access_url\": \"https://learnsql.com/\"\n}"}
{"_id": "Academic--digital_learning--p--71324", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill assessments\",\n        \"Project-based learning\",\n        \"Certification tracks\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium / Paid Subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Manipulation with Pandas\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Scikit-learn\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Data Visualization with Tableau\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"5 weeks\"\n        },\n        {\n            \"course_name\": \"Statistical Inference\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"7 weeks\"\n        },\n        {\n            \"course_name\": \"Deep Learning with TensorFlow\",\n            \"level\": \"Advanced\",\n            \"duration\": \"10 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science skills.\"\n        },\n        {\n            \"user_id\": \"456\",\n            \"rating\": 4,\n            \"comment\": \"Interactive exercises are very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
