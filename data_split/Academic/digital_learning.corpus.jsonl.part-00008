{"_id": "Academic--digital_learning--n--71788", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Assignments\",\n        \"Quizzes\",\n        \"Peer review\",\n        \"Certificates\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Lifelong learners\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Paid courses and Specializations\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"difficulty\": \"Intermediate\",\n            \"duration\": \"50 hours\"\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"difficulty\": \"Advanced\",\n            \"duration\": \"120 hours\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"difficulty\": \"Intermediate\",\n            \"duration\": \"100 hours\"\n        }\n    ],\n    \"launch_date\": \"2012-01-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice Johnson\",\n            \"rating\": 4,\n            \"comment\": \"Good quality courses, but can be expensive.\"\n        },\n        {\n            \"user\": \"Bob Williams\",\n            \"rating\": 3,\n            \"comment\": \"Sometimes the assignments are too difficult.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org\"\n}"}
