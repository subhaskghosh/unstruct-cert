{"_id": "Academic--digital_learning--n--71784", "text": "{\n    \"platform_name\": \"Google Cloud Skills Boost\",\n    \"developer\": \"Google\",\n    \"features\": [\n        \"On-demand courses\",\n        \"Hands-on labs\",\n        \"Skill badges\",\n        \"Certification prep\"\n    ],\n    \"user_types\": [\n        \"Cloud Engineers\",\n        \"Data Scientists\",\n        \"Developers\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning with TensorFlow\",\n            \"duration\": \"8 weeks\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Data Engineering on Google Cloud\",\n            \"duration\": \"6 weeks\",\n            \"level\": \"Advanced\"\n        }\n    ],\n    \"launch_date\": \"2018-05-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3.0,\n            \"comment\": \"Good introductory courses, but some labs are outdated.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3.8,\n            \"comment\": \"Useful for learning Google Cloud specific technologies.\"\n        }\n    ],\n    \"access_url\": \"https://cloudskillsboost.google\"\n}"}
