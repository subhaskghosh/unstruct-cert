{"_id": "Academic--digital_learning--n--70352", "text": "{\n    \"platform_name\": \"LearnXYZ\",\n    \"developer\": \"EduTech Solutions Inc.\",\n    \"features\": [\n        \"Pre-recorded video lectures\",\n        \"Downloadable resources\",\n        \"Forum discussions\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Web Development Basics\",\n            \"level\": \"Beginner\",\n            \"duration\": \"5 weeks\"\n        },\n        {\n            \"course_name\": \"Digital Marketing Strategies\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"7 weeks\"\n        },\n        {\n            \"course_name\": \"Data Analysis with Excel\",\n            \"level\": \"Beginner\",\n            \"duration\": \"3 weeks\"\n        }\n    ],\n    \"launch_date\": \"2023-05-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Decent platform, but a little dry and not very interactive.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"Lectures are good, but lack real-world application.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnxyz.com\"\n}"}
