{"_id": "Academic--digital_learning--n--70336", "text": "{\n    \"platform_name\": \"LearnNow\",\n    \"developer\": \"EducationTech Solutions\",\n    \"features\": [\n        \"Pre-recorded video lectures\",\n        \"Downloadable resources\",\n        \"Community forums\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Web Development Fundamentals\",\n            \"level\": \"Beginner\",\n            \"subject\": \"Web Development\"\n        },\n        {\n            \"course_name\": \"Digital Marketing Basics\",\n            \"level\": \"Beginner\",\n            \"subject\": \"Marketing\"\n        },\n        {\n            \"course_name\": \"Data Analysis with Excel\",\n            \"level\": \"Intermediate\",\n            \"subject\": \"Data Analysis\"\n        }\n    ],\n    \"launch_date\": \"2021-07-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 2,\n            \"comment\": \"Lectures were outdated and not very engaging.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3,\n            \"comment\": \"The platform is okay, but the support is slow.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnnow.org\"\n}"}
