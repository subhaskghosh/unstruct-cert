{"_id": "Academic--digital_learning--p--71094", "text": "{\n    \"platform_name\": \"Codecademy Pro\",\n    \"developer\": \"Codecademy\",\n    \"features\": [\n        \"Interactive coding lessons\",\n        \"Project-based learning\",\n        \"Real-world projects\",\n        \"Code challenges\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Learn Python 3\",\n            \"description\": \"A comprehensive introduction to Python programming.\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Web Development with React\",\n            \"description\": \"Build interactive web applications using React.\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2011-08-23\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning to code!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great interactive exercises and helpful community.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com/\"\n}"}
{"_id": "Academic--digital_learning--n--71094", "text": "{\n    \"platform_name\": \"Starfall\",\n    \"developer\": \"Starfall Education Foundation\",\n    \"features\": [\n        \"Phonics games\",\n        \"Reading activities\",\n        \"Math games\",\n        \"Animated stories\"\n    ],\n    \"user_types\": [\n        \"Preschoolers\",\n        \"Early Elementary Students\",\n        \"Parents\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"ABC's\",\n            \"description\": \"Learn the alphabet with fun games.\",\n            \"level\": \"Preschool\"\n        },\n        {\n            \"course_name\": \"Counting 123\",\n            \"description\": \"Introduction to numbers and counting.\",\n            \"level\": \"Kindergarten\"\n        }\n    ],\n    \"launch_date\": \"2002-09-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"parent789\",\n            \"rating\": 5,\n            \"comment\": \"My child loves this website!\"\n        },\n        {\n            \"user_id\": \"teacher101\",\n            \"rating\": 4,\n            \"comment\": \"A great resource for early literacy.\"\n        }\n    ],\n    \"access_url\": \"https://www.starfall.com/\"\n}"}
{"_id": "Academic--digital_learning--p--71095", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Real-world projects\",\n        \"Skill assessments\",\n        \"Video lectures\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Python basics\",\n                \"Data types\",\n                \"Control flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Data manipulation\",\n                \"Visualization\",\n                \"Statistical analysis\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Advanced\",\n            \"topics\": [\n                \"Supervised learning\",\n                \"Unsupervised learning\",\n                \"Deep learning\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"12345\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science skills. The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"67890\",\n            \"rating\": 4,\n            \"comment\": \"Good content and well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
