{"_id": "Academic--digital_learning--p--70862", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp BV\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill assessments\",\n        \"Project-based learning\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-02-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science skills. Helped me land a new job!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great interactive exercises and well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70862", "text": "{\n    \"platform_name\": \"LearnMusicOnline\",\n    \"developer\": \"Harmony Studios\",\n    \"features\": [\n        \"Video lessons\",\n        \"Sheet music access\",\n        \"Live workshops\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Musicians\",\n        \"Music students\",\n        \"Music teachers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Guitar for Beginners\",\n            \"level\": \"Beginner\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"Piano Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Vocal Training\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2019-11-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4,\n            \"comment\": \"A great resource for learning music. The instructors are very knowledgeable.\"\n        },\n        {\n            \"user_id\": \"user101\",\n            \"rating\": 3,\n            \"comment\": \"Good quality videos but the platform could use some improvements.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnmusiconline.com\"\n}"}
{"_id": "Academic--digital_learning--p--70863", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Python Basics\",\n                \"Data Types\",\n                \"Control Flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"R Programming\",\n                \"Data Manipulation\",\n                \"Data Visualization\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"difficulty\": \"Advanced\",\n            \"topics\": [\n                \"Supervised Learning\",\n                \"Unsupervised Learning\",\n                \"Model Evaluation\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-02-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science! The community is very helpful and supportive.\"\n        },\n        {\n            \"user\": \"Bob\",\n            \"rating\": 4,\n            \"comment\": \"Good content and interactive exercises. I learned a lot.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--70863", "text": "{\n    \"platform_name\": \"Codecademy\",\n    \"developer\": \"Codecademy\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Project-based learning\",\n        \"Career paths\",\n        \"Code challenges\"\n    ],\n    \"user_types\": [\n        \"Beginner programmers\",\n        \"Web developers\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Learn HTML\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"HTML tags\",\n                \"Attributes\",\n                \"Forms\"\n            ]\n        },\n        {\n            \"course_name\": \"Learn Python 3\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Python Basics\",\n                \"Data Structures\",\n                \"Functions\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Career Path\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Data Analysis\",\n                \"Machine Learning\",\n                \"SQL\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2011-08-23\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Charlie\",\n            \"rating\": 3,\n            \"comment\": \"Good for learning the basics, but the projects could be more challenging.\"\n        },\n        {\n            \"user\": \"David\",\n            \"rating\": 2,\n            \"comment\": \"Sometimes the exercises are buggy.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com/\"\n}"}
