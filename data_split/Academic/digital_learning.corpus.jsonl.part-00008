{"_id": "Academic--digital_learning--n--71293", "text": "{\n    \"platform_name\": \"LearnQuantum\",\n    \"developer\": \"Quantum Dynamics Inc.\",\n    \"features\": [\n        \"Quantum computing tutorials\",\n        \"Simulations\",\n        \"Research papers\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Researchers\",\n        \"Students\",\n        \"Quantum Physicists\"\n    ],\n    \"subscription_model\": \"Paid subscriptions (tiered)\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Quantum Mechanics Fundamentals\",\n            \"level\": \"Beginner\",\n            \"subject\": \"Quantum Physics\"\n        },\n        {\n            \"course_name\": \"Quantum Algorithm Development\",\n            \"level\": \"Advanced\",\n            \"subject\": \"Quantum Computing\"\n        }\n    ],\n    \"launch_date\": \"2022-11-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4.0,\n            \"comment\": \"Excellent resource for quantum computing knowledge.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnquantum.org\"\n}"}
