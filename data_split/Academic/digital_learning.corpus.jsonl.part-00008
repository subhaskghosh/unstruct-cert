{"_id": "Academic--digital_learning--n--70420", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Assignments\",\n        \"Quizzes\",\n        \"Peer-graded assignments\",\n        \"Certificates\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Lifelong learners\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"5 courses\"\n        },\n        {\n            \"course_name\": \"Data Science: R Basics\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        }\n    ],\n    \"launch_date\": \"2012-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"11223\",\n            \"rating\": 4,\n            \"comment\": \"High-quality courses, but the interface can be overwhelming at times.\"\n        },\n        {\n            \"user_id\": \"44556\",\n            \"rating\": 3,\n            \"comment\": \"Good content, but requires a strong understanding of academic concepts.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org/\"\n}"}
