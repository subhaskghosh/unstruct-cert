{"_id": "Academic--digital_learning--p--70728", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp BV\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Project-based learning\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science skills. Very interactive and engaging.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great content and well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--70728", "text": "{\n    \"platform_name\": \"LearnAI\",\n    \"developer\": \"AI Education Inc.\",\n    \"features\": [\n        \"Pre-recorded video lectures\",\n        \"Downloadable course materials\",\n        \"Quizzes\",\n        \"Forum discussions\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Deep Learning Fundamentals\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"Natural Language Processing\",\n            \"level\": \"Advanced\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2019-12-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 2,\n            \"comment\": \"The course content is outdated and the instructors aren't very responsive.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3,\n            \"comment\": \"Okay but a bit dry. Could use more examples.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnai.org/\"\n}"}
{"_id": "Academic--digital_learning--p--70729", "text": "{\n    \"platform_name\": \"DataLearn Pro\",\n    \"developer\": \"InnovateEd Solutions\",\n    \"features\": [\n        \"Interactive coding environments\",\n        \"Personalized learning paths\",\n        \"Real-world project simulations\",\n        \"Progress tracking and analytics\",\n        \"Community forums\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Data Science with Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Deep Learning with TensorFlow\",\n            \"level\": \"Advanced\",\n            \"duration\": \"16 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science! The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great content and well-structured courses. Highly recommended!\"\n        }\n    ],\n    \"access_url\": \"https://www.datalearnpro.com\"\n}"}
{"_id": "Academic--digital_learning--n--70729", "text": "{\n    \"platform_name\": \"EduWorld\",\n    \"developer\": \"Global Education Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Downloadable resources\",\n        \"Quizzes and assignments\",\n        \"Discussion boards\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Analysis Basics\",\n            \"level\": \"Beginner\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Statistics for Business\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"10 weeks\"\n        }\n    ],\n    \"launch_date\": \"2022-03-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Decent platform, but could use more interactive features.\"\n        }\n    ],\n    \"access_url\": \"https://www.eduworld.org\"\n}"}
{"_id": "Academic--digital_learning--p--70730", "text": "{\n    \"platform_name\": \"DataLearn Pro\",\n    \"developer\": \"InnovateEd Solutions\",\n    \"features\": [\n        \"Interactive Coding Exercises\",\n        \"Personalized Learning Paths\",\n        \"Community Forums\",\n        \"Progress Tracking\",\n        \"Live Q&A Sessions\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Data Science\",\n            \"level\": \"Beginner\",\n            \"instructor\": \"Dr. Emily Carter\"\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"level\": \"Intermediate\",\n            \"instructor\": \"David Lee\"\n        }\n    ],\n    \"launch_date\": \"2021-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"This platform is incredibly engaging! The interactive exercises really help me learn.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great resource for data science learners. The community is very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datalearnpro.com\"\n}"}
{"_id": "Academic--digital_learning--n--70730", "text": "{\n    \"platform_name\": \"SkillUp Academy\",\n    \"developer\": \"GlobalTech Learning\",\n    \"features\": [\n        \"Video Lectures\",\n        \"Downloadable Resources\",\n        \"Quizzes\",\n        \"Certificate of Completion\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Science Essentials\",\n            \"level\": \"Beginner\",\n            \"instructor\": \"Professor Alan Turing\"\n        },\n        {\n            \"course_name\": \"Advanced Data Analytics\",\n            \"level\": \"Expert\",\n            \"instructor\": \"Jane Doe\"\n        }\n    ],\n    \"launch_date\": \"2022-03-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Decent platform, but a bit dry and not very interactive.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4,\n            \"comment\": \"Good quality content, but the interface could be improved.\"\n        }\n    ],\n    \"access_url\": \"https://www.skillupacademy.net\"\n}"}
{"_id": "Academic--digital_learning--p--70731", "text": "{\n    \"platform_name\": \"DataLearn Institute\",\n    \"developer\": \"InnovateEd Technologies\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Real-world projects\",\n        \"Personalized learning paths\",\n        \"Community forum\",\n        \"Expert mentoring\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Data Science\",\n            \"level\": \"Beginner\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"16 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-05-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice Smith\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science!\"\n        }\n    ],\n    \"access_url\": \"https://www.datalearninstitute.com\"\n}"}
