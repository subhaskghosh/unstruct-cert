{"_id": "Academic--digital_learning--p--70138", "text": "{\n    \"platform_name\": \"CodeSpark Academy Plus\",\n    \"developer\": \"CodeSpark\",\n    \"features\": [\n        \"Game-based learning\",\n        \"Progress tracking\",\n        \"Coding challenges\",\n        \"Teacher dashboard\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"One-time purchase\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Coding with The Foos\",\n            \"subject\": \"Technology\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Advanced Coding Challenges\",\n            \"subject\": \"Technology\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2021-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_type\": \"Educator\",\n            \"rating\": 5,\n            \"comment\": \"Highly engaging platform! Students love learning to code through the games.\"\n        },\n        {\n            \"user_type\": \"Student\",\n            \"rating\": 4,\n            \"comment\": \"Fun and easy to learn coding!\"\n        }\n    ],\n    \"access_url\": \"https://www.codespark.com/academyplus\"\n}"}
