{"_id": "Academic--digital_learning--n--71248", "text": "{\n    \"platform_name\": \"LearnTheoretical\",\n    \"developer\": \"TheoryFirst Inc.\",\n    \"features\": [\n        \"Lecture videos\",\n        \"Reading materials\",\n        \"Quizzes\",\n        \"Discussion boards\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Researchers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Advanced Statistical Theory\",\n            \"level\": \"Advanced\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Mathematical Foundations of Machine Learning\",\n            \"level\": \"Advanced\",\n            \"duration\": \"10 weeks\"\n        }\n    ],\n    \"launch_date\": \"2019-12-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Good for in-depth theoretical knowledge, but lacks practical application.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"Very academic, not suitable for beginners.\"\n        }\n    ],\n    \"access_url\": \"https://www.learntheoretical.com\"\n}"}
