{"_id": "Academic--digital_learning--p--71593", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill tracks\",\n        \"Project-based learning\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Python basics\",\n                \"Data structures\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Regression\",\n                \"Classification\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"difficulty\": \"Advanced\",\n            \"topics\": [\n                \"Statistics\",\n                \"Machine Learning\",\n                \"Data Visualization\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science! The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good content and well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71593", "text": "{\n    \"platform_name\": \"LearnWorlds\",\n    \"developer\": \"LearnWorlds\",\n    \"features\": [\n        \"Course creation tools\",\n        \"Video hosting\",\n        \"Interactive video\",\n        \"Assessments\",\n        \"Community features\"\n    ],\n    \"user_types\": [\n        \"Educators\",\n        \"Course Creators\",\n        \"Subject Matter Experts\"\n    ],\n    \"subscription_model\": \"Paid subscription plans\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Digital Marketing Fundamentals\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"SEO\",\n                \"Social Media Marketing\"\n            ]\n        },\n        {\n            \"course_name\": \"Web Development Bootcamp\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"HTML\",\n                \"CSS\",\n                \"JavaScript\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2014-03-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4,\n            \"comment\": \"Great platform for creating and selling online courses.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3,\n            \"comment\": \"Reliable but lacks certain advanced features.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnworlds.com\"\n}"}
{"_id": "Academic--digital_learning--p--71594", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill tracks\",\n        \"Project-based learning\",\n        \"Real-time feedback\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium (with paid premium access)\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 months\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Advanced\",\n            \"duration\": \"3 months\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science skills in a practical way.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great interactive courses, helped me land a data analyst job.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71594", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lessons\",\n        \"Practice exercises\",\n        \"Personalized learning dashboard\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Calculus I\",\n            \"level\": \"Beginner\",\n            \"duration\": \"1 semester\"\n        },\n        {\n            \"course_name\": \"Linear Algebra\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"1 semester\"\n        },\n        {\n            \"course_name\": \"Statistics and Probability\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"1 semester\"\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 5,\n            \"comment\": \"Fantastic resource for learning math and science!\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4,\n            \"comment\": \"Helped me understand difficult concepts.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
{"_id": "Academic--digital_learning--p--71595", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill assessments\",\n        \"Project-based learning\",\n        \"Data visualization tools\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Data Visualization with Tableau\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science skills!\"\n        },\n        {\n            \"user\": \"Bob\",\n            \"rating\": 4,\n            \"comment\": \"Interactive exercises are very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71595", "text": "{\n    \"platform_name\": \"Codecademy\",\n    \"developer\": \"Codecademy\",\n    \"features\": [\n        \"Interactive coding environment\",\n        \"Project building\",\n        \"Career paths\",\n        \"Skill paths\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Beginners\",\n        \"Career Changers\"\n    ],\n    \"subscription_model\": \"Paid Subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Learn Python 3\",\n            \"level\": \"Beginner\",\n            \"duration\": \"30 hours\"\n        },\n        {\n            \"course_name\": \"Full-Stack Engineer Career Path\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"200 hours\"\n        },\n        {\n            \"course_name\": \"Data Science Career Path\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"150 hours\"\n        }\n    ],\n    \"launch_date\": \"2011-08-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Charlie\",\n            \"rating\": 4,\n            \"comment\": \"Good for getting started with coding.\"\n        },\n        {\n            \"user\": \"Diana\",\n            \"rating\": 3,\n            \"comment\": \"A bit too basic for advanced learners.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com\"\n}"}
{"_id": "Academic--digital_learning--p--71596", "text": "{\n    \"platform_name\": \"Skillshare\",\n    \"developer\": \"Skillshare Inc.\",\n    \"features\": [\n        \"Project-based learning\",\n        \"Unlimited access to courses\",\n        \"Community forum\",\n        \"Offline access\"\n    ],\n    \"user_types\": [\n        \"Adult learners\",\n        \"Professionals\",\n        \"Creatives\"\n    ],\n    \"subscription_model\": \"Freemium with premium tiers\",\n    \"courses_available\": [\n        {\n            \"course_title\": \"Data Science Fundamentals\",\n            \"instructor\": \"Dr. Emily Carter\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_title\": \"Graphic Design Masterclass\",\n            \"instructor\": \"John Smith\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2010-07-27\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"12345\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning new skills!\"\n        }\n    ],\n    \"access_url\": \"https://www.skillshare.com/\"\n}"}
{"_id": "Academic--digital_learning--n--71596", "text": "{\n    \"platform_name\": \"Google Classroom\",\n    \"developer\": \"Google\",\n    \"features\": [\n        \"Assignment submission\",\n        \"Grade management\",\n        \"Communication tools\",\n        \"Integration with Google Workspace\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_title\": \"Introduction to Python\",\n            \"instructor\": \"Jane Doe\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_title\": \"Algebra I\",\n            \"instructor\": \"Peter Jones\",\n            \"duration\": \"1 semester\"\n        }\n    ],\n    \"launch_date\": \"2017-08-30\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"67890\",\n            \"rating\": 4,\n            \"comment\": \"Easy to use and integrates well with other Google tools.\"\n        }\n    ],\n    \"access_url\": \"https://classroom.google.com/\"\n}"}
{"_id": "Academic--digital_learning--p--71597", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium with paid levels\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"topic\": \"Data Science\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Intermediate SQL\",\n            \"topic\": \"Data Science\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"topic\": \"Machine Learning\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Data Visualization with Python\",\n            \"topic\": \"Data Science\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Deep Learning Fundamentals\",\n            \"topic\": \"Machine Learning\",\n            \"level\": \"Advanced\"\n        },\n        {\n            \"course_name\": \"Statistical Modeling\",\n            \"topic\": \"Data Science\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice\",\n            \"rating\": 5,\n            \"comment\": \"The interactive exercises are really helpful for learning.\"\n        },\n        {\n            \"user\": \"Bob\",\n            \"rating\": 4,\n            \"comment\": \"Good content, well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
