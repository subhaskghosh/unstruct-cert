{"_id": "Academic--digital_learning--p--70993", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"12 months\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good content, but could use more advanced topics.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70993", "text": "{\n    \"platform_name\": \"LearnMath\",\n    \"developer\": \"Math Experts Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Practice problems\",\n        \"Quizzes\",\n        \"Personalized learning paths\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\",\n        \"Parents\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Algebra I\",\n            \"level\": \"Beginner\",\n            \"duration\": \"1 semester\"\n        },\n        {\n            \"course_name\": \"Calculus II\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"1 semester\"\n        },\n        {\n            \"course_name\": \"Geometry\",\n            \"level\": \"Beginner\",\n            \"duration\": \"1 semester\"\n        }\n    ],\n    \"launch_date\": \"2018-05-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4,\n            \"comment\": \"Helpful for improving math skills.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3,\n            \"comment\": \"Some topics are not explained very well.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnmath.org\"\n}"}
{"_id": "Academic--digital_learning--p--70994", "text": "{\n    \"platform_name\": \"DataCamp University\",\n    \"developer\": \"DataCamp\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skills assessments\",\n        \"Personalized learning paths\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Paid subscription with tiered access\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Science with Python\",\n            \"level\": \"Intermediate\",\n            \"average_rating\": 4.7\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Advanced\",\n            \"average_rating\": 4.6\n        }\n    ],\n    \"launch_date\": \"2021-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for hands-on data science learning!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great content, well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/university\"\n}"}
{"_id": "Academic--digital_learning--n--70994", "text": "{\n    \"platform_name\": \"LearnMathOnline\",\n    \"developer\": \"MathEd Solutions\",\n    \"features\": [\n        \"Pre-recorded video lectures\",\n        \"Practice quizzes\",\n        \"Downloadable worksheets\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Tutors\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Calculus I\",\n            \"level\": \"Beginner\",\n            \"average_rating\": 4.2\n        },\n        {\n            \"course_name\": \"Linear Algebra\",\n            \"level\": \"Intermediate\",\n            \"average_rating\": 3.8\n        }\n    ],\n    \"launch_date\": \"2022-05-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Good for basic concepts, but lacks advanced topics.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4,\n            \"comment\": \"Helpful for students struggling with math.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnmathonline.com\"\n}"}
{"_id": "Academic--digital_learning--p--70995", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill assessments\",\n        \"Project-based learning\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Students\",\n        \"Career Switchers\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"rating\": 5,\n            \"comment\": \"Great for learning data science skills quickly!\"\n        },\n        {\n            \"user_id\": \"456\",\n            \"rating\": 4,\n            \"comment\": \"Lots of hands-on practice.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70995", "text": "{\n    \"platform_name\": \"LearnChemE\",\n    \"developer\": \"University of Colorado Boulder\",\n    \"features\": [\n        \"Interactive simulations\",\n        \"Video lectures\",\n        \"Module quizzes\",\n        \"Problem-solving tools\"\n    ],\n    \"user_types\": [\n        \"Chemical Engineering Students\",\n        \"Chemical Engineers\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Thermodynamics\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"Fluid Mechanics\",\n            \"level\": \"Advanced\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2018-09-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"789\",\n            \"rating\": 4,\n            \"comment\": \"Excellent resource for ChemE students.\"\n        },\n        {\n            \"user_id\": \"101\",\n            \"rating\": 3,\n            \"comment\": \"Helpful simulations.\"\n        }\n    ],\n    \"access_url\": \"https://learncheme.com\"\n}"}
{"_id": "Academic--digital_learning--p--70996", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Project-based learning\",\n        \"Certification paths\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-02-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science! Very practical.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great content and well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--70996", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lessons\",\n        \"Practice exercises\",\n        \"Personalized learning\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Calculus\",\n            \"level\": \"High School\",\n            \"duration\": \"Variable\"\n        },\n        {\n            \"course_name\": \"Statistics and Probability\",\n            \"level\": \"High School\",\n            \"duration\": \"Variable\"\n        },\n        {\n            \"course_name\": \"Linear Algebra\",\n            \"level\": \"College\",\n            \"duration\": \"Variable\"\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 5,\n            \"comment\": \"A fantastic resource for free education!\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4,\n            \"comment\": \"Helpful videos and practice problems.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org/\"\n}"}
