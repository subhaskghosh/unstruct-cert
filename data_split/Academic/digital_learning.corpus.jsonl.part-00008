{"_id": "Academic--digital_learning--n--71560", "text": "{\n    \"platform_name\": \"EduWorld\",\n    \"developer\": \"Global Education Systems\",\n    \"features\": [\n        \"Video lectures\",\n        \"Quizzes\",\n        \"Discussion boards\",\n        \"E-books\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\",\n        \"Researchers\"\n    ],\n    \"subscription_model\": \"Paid subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Theoretical Physics\",\n            \"duration\": \"1 year\",\n            \"level\": \"Advanced\",\n            \"price\": 99.99\n        },\n        {\n            \"course_name\": \"Shakespearean Literature\",\n            \"duration\": \"1 semester\",\n            \"level\": \"Intermediate\",\n            \"price\": 79.99\n        }\n    ],\n    \"launch_date\": \"2022-05-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Good resource for academic study.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"Not very engaging, mostly lectures.\"\n        }\n    ],\n    \"access_url\": \"https://www.eduworld.org\"\n}"}
{"_id": "Academic--digital_learning--p--71561", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lessons\",\n        \"Project-based learning\",\n        \"Skill tracks\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Freemium (with paid subscriptions for full access)\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"subject\": \"Data Science\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"subject\": \"Machine Learning\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2016-01-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice\",\n            \"rating\": 5,\n            \"comment\": \"Very easy to learn and apply new skills. Highly engaging content!\"\n        },\n        {\n            \"user\": \"Bob\",\n            \"rating\": 4,\n            \"comment\": \"Great for beginners, the interactive exercises are fantastic.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--71561", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lessons\",\n        \"Practice exercises\",\n        \"Personalized learning dashboards\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Calculus 1\",\n            \"subject\": \"Mathematics\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"AP Statistics\",\n            \"subject\": \"Statistics\",\n            \"level\": \"Advanced\"\n        }\n    ],\n    \"launch_date\": \"2006-09-16\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Charlie\",\n            \"rating\": 5,\n            \"comment\": \"Excellent resource for learning, completely free!\"\n        },\n        {\n            \"user\": \"David\",\n            \"rating\": 4,\n            \"comment\": \"Helpful and accessible for all learners.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org/\"\n}"}
