{"_id": "Academic--digital_learning--p--71751", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill tracks\",\n        \"Project-based learning\",\n        \"Assessment quizzes\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Python Syntax\",\n                \"Data Structures\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Regression\",\n                \"Classification\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"topics\": [\n                \"Deep Learning\",\n                \"Big Data\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-02-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science skills!\"\n        },\n        {\n            \"user_id\": \"456\",\n            \"rating\": 4,\n            \"comment\": \"Good interactive exercises and clear explanations.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71751", "text": "{\n    \"platform_name\": \"LearnMathFaster\",\n    \"developer\": \"Math Education Solutions Inc.\",\n    \"features\": [\n        \"Video tutorials\",\n        \"Practice problems\",\n        \"Worksheets\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Algebra I\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Linear Equations\",\n                \"Inequalities\"\n            ]\n        },\n        {\n            \"course_name\": \"Calculus I\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Limits\",\n                \"Derivatives\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2019-05-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"789\",\n            \"rating\": 3,\n            \"comment\": \"Decent platform, but could use more interactive features.\"\n        },\n        {\n            \"user_id\": \"101\",\n            \"rating\": 2,\n            \"comment\": \"The explanations were hard to follow.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnmathfaster.com\"\n}"}
