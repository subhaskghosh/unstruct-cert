{"_id": "Academic--digital_learning--n--71001", "text": "{\n    \"platform_name\": \"LearnAI\",\n    \"developer\": \"TechSolutions Ltd.\",\n    \"features\": [\n        \"AI-powered personalized learning\",\n        \"Expert-led webinars\",\n        \"Code review services\",\n        \"Career coaching\"\n    ],\n    \"user_types\": [\n        \"Professionals\",\n        \"Researchers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Deep Learning Fundamentals\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"50 hours\"\n        },\n        {\n            \"course_name\": \"Reinforcement Learning Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"80 hours\"\n        }\n    ],\n    \"launch_date\": \"2022-05-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"98765\",\n            \"rating\": 4,\n            \"comment\": \"Excellent in-depth content, but the interface can be a bit complex.\"\n        },\n        {\n            \"user_id\": \"43210\",\n            \"rating\": 3,\n            \"comment\": \"The webinars are valuable, but the price is quite high.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnai.org\"\n}"}
{"_id": "Academic--digital_learning--p--71002", "text": "{\n    \"platform_name\": \"SkillUp Academy\",\n    \"developer\": \"InnovateEd Solutions\",\n    \"features\": [\n        \"Interactive Video Lectures\",\n        \"Collaborative Discussion Forums\",\n        \"Progress Tracking\",\n        \"Mobile App Access\",\n        \"Live Q&A Sessions\"\n    ],\n    \"user_types\": [\n        \"Professionals\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Project Management Fundamentals\",\n            \"duration\": \"8 weeks\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Data Analytics with Python\",\n            \"duration\": \"12 weeks\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2021-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"U123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform with a great mobile app! Very easy to use and the collaborative forums are very helpful.\"\n        },\n        {\n            \"user_id\": \"U456\",\n            \"rating\": 4,\n            \"comment\": \"Good course selection and the instructors are knowledgeable. The mobile app could be improved but it's functional.\"\n        }\n    ],\n    \"access_url\": \"https://www.skillupacademy.com\"\n}"}
{"_id": "Academic--digital_learning--n--71002", "text": "{\n    \"platform_name\": \"EduWorld\",\n    \"developer\": \"Global Learning Technologies\",\n    \"features\": [\n        \"Pre-recorded Lectures\",\n        \"Quiz Assessments\",\n        \"Certificate of Completion\",\n        \"Offline Download\",\n        \"Personalized Learning Paths\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Paid - Tiered\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Calculus\",\n            \"duration\": \"10 weeks\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"World History 101\",\n            \"duration\": \"15 weeks\",\n            \"level\": \"Beginner\"\n        }\n    ],\n    \"launch_date\": \"2022-09-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"U789\",\n            \"rating\": 3,\n            \"comment\": \"The courses are well-structured, but the interface feels outdated. The mobile app is buggy and crashes frequently.\"\n        },\n        {\n            \"user_id\": \"U012\",\n            \"rating\": 2,\n            \"comment\": \"Expensive for what you get, and customer support is unresponsive.\"\n        }\n    ],\n    \"access_url\": \"https://www.eduworld.org\"\n}"}
