{"_id": "Academic--digital_learning--n--71224", "text": "{\n    \"platform_name\": \"GlobalSkills Hub\",\n    \"developer\": \"TechGiant Corp\",\n    \"features\": [\n        \"Video Lectures\",\n        \"Quizzes\",\n        \"Downloadable Resources\",\n        \"Certificate of Completion\",\n        \"Mobile App\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Analysis with Python\",\n            \"level\": \"Beginner\",\n            \"instructor\": \"Professor John Smith\"\n        },\n        {\n            \"course_name\": \"Artificial Intelligence for Business\",\n            \"level\": \"Intermediate\",\n            \"instructor\": \"Sarah Jones\"\n        }\n    ],\n    \"launch_date\": \"2022-01-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"The courses are good, but the mobile app is buggy and crashes frequently.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4,\n            \"comment\": \"Helpful courses, but a bit expensive.\"\n        }\n    ],\n    \"access_url\": \"https://www.globalskillshub.com\"\n}"}
