{"_id": "Academic--digital_learning--p--70539", "text": "{\n    \"platform_name\": \"DataLearn Pro\",\n    \"developer\": \"InnovateEd Tech\",\n    \"features\": [\n        \"Interactive Coding Exercises\",\n        \"Live Q&A Sessions\",\n        \"Project-Based Learning\",\n        \"Personalized Learning Paths\",\n        \"Progress Tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Data Science\",\n            \"level\": \"Beginner\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Python for Data Analysis\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Full Stack Web Development\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"16 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform! The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great courses and supportive community.\"\n        }\n    ],\n    \"access_url\": \"https://www.datalearnpro.com\"\n}"}
{"_id": "Academic--digital_learning--n--70539", "text": "{\n    \"platform_name\": \"CodeMastery\",\n    \"developer\": \"LearnCode Inc.\",\n    \"features\": [\n        \"Code Compilation\",\n        \"Syntax Highlighting\",\n        \"Automated Testing\",\n        \"Debugging Tools\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Software Developers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Advanced Algorithm Design\",\n            \"level\": \"Advanced\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with TensorFlow\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"14 weeks\"\n        }\n    ],\n    \"launch_date\": \"2019-11-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Good for advanced learners, but the interface is a bit clunky.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"Difficult to navigate. Poor support.\"\n        }\n    ],\n    \"access_url\": \"https://www.codemastery.net\"\n}"}
{"_id": "Academic--digital_learning--p--70540", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"difficulty\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"difficulty\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science! The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good content and well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
