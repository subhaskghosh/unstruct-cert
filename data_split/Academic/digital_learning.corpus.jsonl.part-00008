{"_id": "Academic--digital_learning--p--70221", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.5,\n            \"comment\": \"Great platform for learning data science! The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4.0,\n            \"comment\": \"Easy to pick up and start learning, even with no prior experience.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--70221", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Peer assessments\",\n        \"Assignments\",\n        \"Certificates\",\n        \"Specializations\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning by Andrew Ng\",\n            \"level\": \"Beginner\",\n            \"duration\": \"11 weeks\"\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"5 courses\"\n        }\n    ],\n    \"launch_date\": \"2012-05-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4.2,\n            \"comment\": \"Excellent courses, but can be quite challenging.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3.8,\n            \"comment\": \"Good content, but the platform can feel a bit overwhelming with so much available.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org/\"\n}"}
{"_id": "Academic--digital_learning--p--70222", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill assessments\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"rating\": 4.5,\n            \"comment\": \"Great platform for learning data science!\"\n        },\n        {\n            \"user_id\": \"456\",\n            \"rating\": 3.8,\n            \"comment\": \"Very interactive and helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70222", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Peer assessments\",\n        \"Quizzes\",\n        \"Discussion forums\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Lifelong learners\"\n    ],\n    \"subscription_model\": \"Paid levels\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"5 courses\"\n        }\n    ],\n    \"launch_date\": \"2012-05-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"789\",\n            \"rating\": 4.2,\n            \"comment\": \"High-quality courses from top universities.\"\n        },\n        {\n            \"user_id\": \"101\",\n            \"rating\": 3.9,\n            \"comment\": \"Good overall experience.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org\"\n}"}
{"_id": "Academic--digital_learning--p--70223", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill tracks\",\n        \"Career tracks\",\n        \"Project portfolio\",\n        \"Certification\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\",\n        \"Business Analysts\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Scientist with Python\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 months\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Advanced\",\n            \"duration\": \"9 months\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.5,\n            \"comment\": \"Great platform for learning data science!\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70223", "text": "{\n    \"platform_name\": \"Codecademy\",\n    \"developer\": \"Codecademy\",\n    \"features\": [\n        \"Interactive lessons\",\n        \"Project-based learning\",\n        \"Code editor\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Beginners\",\n        \"Students\",\n        \"Hobbyists\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to HTML\",\n            \"level\": \"Beginner\",\n            \"duration\": \"2 weeks\"\n        },\n        {\n            \"course_name\": \"Learn JavaScript\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"1 month\"\n        }\n    ],\n    \"launch_date\": \"2011-08-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4.0,\n            \"comment\": \"Good for learning basic coding skills.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com\"\n}"}
{"_id": "Academic--digital_learning--p--70224", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill tracks\",\n        \"Project-based learning\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Python syntax\",\n                \"Data structures\",\n                \"Control flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Supervised learning\",\n                \"Unsupervised learning\",\n                \"Model evaluation\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"topics\": [\n                \"Statistical Modeling\",\n                \"Data Visualization\",\n                \"Big Data\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-02-10\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science. The interactive exercises are very helpful.\"\n        },\n        {\n            \"user\": \"Bob\",\n            \"rating\": 4,\n            \"comment\": \"Good courses and a supportive community.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70224", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy, Inc.\",\n    \"features\": [\n        \"Video lessons\",\n        \"Practice exercises\",\n        \"Progress tracking\",\n        \"Personalized learning\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Algebra I\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Linear equations\",\n                \"Inequalities\",\n                \"Graphing\"\n            ]\n        },\n        {\n            \"course_name\": \"Calculus AB\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Limits\",\n                \"Derivatives\",\n                \"Integrals\"\n            ]\n        },\n        {\n            \"course_name\": \"Statistics and Probability\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Data analysis\",\n                \"Probability distributions\",\n                \"Hypothesis testing\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Charlie\",\n            \"rating\": 4,\n            \"comment\": \"A great resource for basic math and science concepts.\"\n        },\n        {\n            \"user\": \"Diana\",\n            \"rating\": 5,\n            \"comment\": \"Excellent for supplementing classroom learning.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
{"_id": "Academic--digital_learning--p--70225", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"12345\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science! Very interactive and easy to follow.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70225", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Peer assessments\",\n        \"Quizzes\",\n        \"Discussion forums\",\n        \"Certificates\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Lifelong Learners\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"5 courses\"\n        },\n        {\n            \"course_name\": \"Financial Markets\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        }\n    ],\n    \"launch_date\": \"2012-05-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"67890\",\n            \"rating\": 4,\n            \"comment\": \"Good course selection, but the interface can be a bit clunky.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org\"\n}"}
{"_id": "Academic--digital_learning--p--70226", "text": "{\n    \"platform_name\": \"DataLearn Pro\",\n    \"developer\": \"AI Innovations Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Personalized learning paths\",\n        \"Real-time project feedback\",\n        \"Community forum\",\n        \"AI-powered tutoring\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Data Science\",\n            \"level\": \"Beginner\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"16 weeks\"\n        },\n        {\n            \"course_name\": \"Deep Learning with Python\",\n            \"level\": \"Advanced\",\n            \"duration\": \"20 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science. The interactive exercises are very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datalearnpro.com\"\n}"}
{"_id": "Academic--digital_learning--n--70226", "text": "{\n    \"platform_name\": \"EduWorld\",\n    \"developer\": \"Global Education Systems\",\n    \"features\": [\n        \"Video lectures\",\n        \"Quizzes\",\n        \"Downloadable resources\",\n        \"Discussion boards\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to History\",\n            \"level\": \"Beginner\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"World Literature\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"14 weeks\"\n        }\n    ],\n    \"launch_date\": \"2022-03-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good platform for general education, but lacks advanced technical courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.eduworld.org\"\n}"}
{"_id": "Academic--digital_learning--p--70227", "text": "{\n    \"platform_name\": \"SkillUp Academy\",\n    \"developer\": \"LearnForward Inc.\",\n    \"features\": [\n        \"Interactive lessons\",\n        \"Personalized learning paths\",\n        \"Progress tracking\",\n        \"Community forums\",\n        \"Certificate programs\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Science Bootcamp\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Digital Marketing Masterclass\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Project Management Professional\",\n            \"level\": \"Advanced\",\n            \"duration\": \"10 weeks\"\n        }\n    ],\n    \"launch_date\": \"2023-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"rating\": 5,\n            \"comment\": \"This platform is incredibly engaging and helped me land a new job!\"\n        },\n        {\n            \"user_id\": \"456\",\n            \"rating\": 4,\n            \"comment\": \"Great courses and a supportive community.\"\n        }\n    ],\n    \"access_url\": \"https://www.skillupacademy.com\"\n}"}
{"_id": "Academic--digital_learning--n--70227", "text": "{\n    \"platform_name\": \"EduCentral\",\n    \"developer\": \"Global Education Solutions\",\n    \"features\": [\n        \"Video lectures\",\n        \"Quiz assessments\",\n        \"Downloadable resources\",\n        \"Instructor Q&A\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Psychology\",\n            \"level\": \"Beginner\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Calculus I\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"10 weeks\"\n        }\n    ],\n    \"launch_date\": \"2022-11-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"789\",\n            \"rating\": 3,\n            \"comment\": \"It's a decent platform, but a bit dry. Good for basic learning.\"\n        },\n        {\n            \"user_id\": \"101\",\n            \"rating\": 4,\n            \"comment\": \"Good resource for supplementary material.\"\n        }\n    ],\n    \"access_url\": \"https://www.educentral.org\"\n}"}
{"_id": "Academic--digital_learning--p--70228", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"rating\": 4.5,\n            \"comment\": \"Great platform for learning data science skills.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
