{"_id": "Academic--digital_learning--n--71654", "text": "{\n    \"platform_name\": \"LearnVerse\",\n    \"developer\": \"EdTech Solutions Inc.\",\n    \"features\": [\n        \"Pre-recorded lectures\",\n        \"Downloadable resources\",\n        \"Discussion forums\",\n        \"Certificate of completion\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Science Theory\",\n            \"level\": \"Beginner\",\n            \"duration\": \"5 weeks\"\n        },\n        {\n            \"course_name\": \"Statistical Analysis\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"7 weeks\"\n        }\n    ],\n    \"launch_date\": \"2019-05-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"11223\",\n            \"rating\": 3,\n            \"comment\": \"Lectures are informative but lack practical application.\"\n        },\n        {\n            \"user_id\": \"44556\",\n            \"rating\": 3,\n            \"comment\": \"Content is a bit too theoretical for my learning style.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnverse.edu\"\n}"}
