{"_id": "Academic--digital_learning--n--71752", "text": "{\n    \"platform_name\": \"LearnStreet\",\n    \"developer\": \"LearnStreet, Inc.\",\n    \"features\": [\n        \"Interactive lessons\",\n        \"Code challenges\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Beginner programmers\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to JavaScript\",\n            \"level\": \"Beginner\",\n            \"duration\": \"2 months\"\n        },\n        {\n            \"course_name\": \"Python Basics\",\n            \"level\": \"Beginner\",\n            \"duration\": \"1 month\"\n        }\n    ],\n    \"launch_date\": \"2013-11-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice Brown\",\n            \"rating\": 3,\n            \"comment\": \"Decent for beginners, but limited content.\"\n        },\n        {\n            \"user\": \"Bob Green\",\n            \"rating\": 2,\n            \"comment\": \"Not very engaging.\"\n        }\n    ],\n    \"access_url\": \"https://learnstreet.com\"\n}"}
{"_id": "Academic--digital_learning--p--71753", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Projects\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-04-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science. Very interactive and well-structured.\"\n        },\n        {\n            \"user_id\": \"456\",\n            \"rating\": 4,\n            \"comment\": \"Great resources, but could use more advanced topics.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71753", "text": "{\n    \"platform_name\": \"LearnData\",\n    \"developer\": \"Global Education Tech\",\n    \"features\": [\n        \"On-demand video lectures\",\n        \"Downloadable resources\",\n        \"Quizzes and assignments\",\n        \"Expert Q&A forums\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Paid - Tiered\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Python for Data Analysis\",\n            \"level\": \"Beginner\",\n            \"duration\": \"5 weeks\"\n        },\n        {\n            \"course_name\": \"Advanced Statistical Modeling\",\n            \"level\": \"Advanced\",\n            \"duration\": \"10 weeks\"\n        }\n    ],\n    \"launch_date\": \"2020-09-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"789\",\n            \"rating\": 3,\n            \"comment\": \"Content is okay, but the platform feels a bit clunky and outdated.\"\n        },\n        {\n            \"user_id\": \"012\",\n            \"rating\": 2,\n            \"comment\": \"Expensive for what you get.\"\n        }\n    ],\n    \"access_url\": \"https://www.learndata.org\"\n}"}
