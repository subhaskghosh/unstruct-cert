{"_id": "Academic--digital_learning--n--70230", "text": "{\n    \"platform_name\": \"Learnify\",\n    \"developer\": \"TechEd Solutions Inc.\",\n    \"features\": [\n        \"Pre-recorded video lectures\",\n        \"Downloadable course materials\",\n        \"Quizzes\",\n        \"Assignments\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Lifelong Learners\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Web Development Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"Data Analysis with Excel\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"5 weeks\"\n        },\n        {\n            \"course_name\": \"Cloud Computing Basics\",\n            \"level\": \"Beginner\",\n            \"duration\": \"7 weeks\"\n        }\n    ],\n    \"launch_date\": \"2019-05-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"The course content is okay, but I found it difficult to get assistance when I needed it.\"\n        },\n        {\n            \"user_id\": \"user101\",\n            \"rating\": 4,\n            \"comment\": \"Good value for the price.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnify.org/\"\n}"}
