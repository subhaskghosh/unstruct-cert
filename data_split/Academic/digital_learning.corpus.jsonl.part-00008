{"_id": "Academic--digital_learning--n--71618", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Assignments\",\n        \"Quizzes\",\n        \"Peer assessments\",\n        \"Discussion forums\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Lifelong learners\"\n    ],\n    \"subscription_model\": \"Paid courses and specializations\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"difficulty\": \"Intermediate\",\n            \"subject\": \"Machine Learning\"\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"difficulty\": \"Advanced\",\n            \"subject\": \"Deep Learning\"\n        },\n        {\n            \"course_name\": \"Theoretical Computer Science\",\n            \"difficulty\": \"Advanced\",\n            \"subject\": \"Computer Science\"\n        }\n    ],\n    \"launch_date\": \"2012-03-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"789\",\n            \"rating\": 3.8,\n            \"comment\": \"Good content, but can be very theoretical.\"\n        },\n        {\n            \"user_id\": \"101\",\n            \"rating\": 4.0,\n            \"comment\": \"Helpful for understanding foundational concepts.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org/\"\n}"}
{"_id": "Academic--digital_learning--p--71619", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill tracks\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Educators\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Python fundamentals\",\n                \"Data structures\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning Scientist with Python\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Supervised learning\",\n                \"Unsupervised learning\",\n                \"Model evaluation\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"difficulty\": \"Advanced\",\n            \"topics\": [\n                \"Statistical modeling\",\n                \"Data visualization\",\n                \"Big data\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-01-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science! The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great content and well-structured courses.  Highly recommend for beginners.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71619", "text": "{\n    \"platform_name\": \"LearnAI\",\n    \"developer\": \"Startup Innovations Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Quizzes\",\n        \"Discussion boards\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"AI Fundamentals\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Introduction to AI\",\n                \"Machine Learning Basics\"\n            ]\n        },\n        {\n            \"course_name\": \"Deep Learning with TensorFlow\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Neural Networks\",\n                \"TensorFlow implementation\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2022-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Content is okay, but feels a bit rushed.  Some lectures are hard to follow.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"Limited course selection and the interface is not very user-friendly.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnai.org\"\n}"}
