{"_id": "Academic--digital_learning--n--70086", "text": "{\n    \"platform_name\": \"Codecademy\",\n    \"developer\": \"Codecademy\",\n    \"features\": [\n        \"Interactive lessons\",\n        \"Project-based learning\",\n        \"Career paths\",\n        \"Quizzes\"\n    ],\n    \"user_types\": [\n        \"Beginners\",\n        \"Students\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to HTML\",\n            \"difficulty\": \"Beginner\",\n            \"subject\": \"Web Development\"\n        },\n        {\n            \"course_name\": \"Python\",\n            \"difficulty\": \"Beginner\",\n            \"subject\": \"Programming\"\n        },\n        {\n            \"course_name\": \"Data Science\",\n            \"difficulty\": \"Intermediate\",\n            \"subject\": \"Data Science\"\n        }\n    ],\n    \"launch_date\": \"2011-08-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"789\",\n            \"rating\": 3,\n            \"comment\": \"Good for basic concepts, but lacks depth.\"\n        },\n        {\n            \"user_id\": \"101\",\n            \"rating\": 4,\n            \"comment\": \"Helpful for getting started with coding.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com/\"\n}"}
{"_id": "Academic--digital_learning--p--70087", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Scientist with Python\",\n            \"description\": \"Learn the fundamentals of data science using Python, with a focus on real-world projects.\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Data Analyst with R\",\n            \"description\": \"Master data analysis techniques with R, including data visualization and statistical modeling.\",\n            \"level\": \"Beginner\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.5,\n            \"comment\": \"Great platform for learning data science through hands-on projects!\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--70087", "text": "{\n    \"platform_name\": \"Codecademy\",\n    \"developer\": \"Codecademy\",\n    \"features\": [\n        \"Interactive lessons\",\n        \"Coding challenges\",\n        \"Project portfolio\",\n        \"Career paths\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Beginners\",\n        \"Web Developers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Learn Python 3\",\n            \"description\": \"A comprehensive course on Python programming.\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Introduction to SQL\",\n            \"description\": \"Learn the basics of SQL for database management.\",\n            \"level\": \"Beginner\"\n        }\n    ],\n    \"launch_date\": \"2011-08-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4.0,\n            \"comment\": \"Good for getting started with coding.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com/\"\n}"}
{"_id": "Academic--digital_learning--p--70088", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"12 months\"\n        }\n    ],\n    \"launch_date\": \"2016-03-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science. The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great content and a user-friendly interface.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70088", "text": "{\n    \"platform_name\": \"LearnWorlds\",\n    \"developer\": \"LearnWorlds\",\n    \"features\": [\n        \"Course creation tools\",\n        \"Interactive video\",\n        \"Community building\",\n        \"Marketing features\",\n        \"Analytics\"\n    ],\n    \"user_types\": [\n        \"Educators\",\n        \"Subject Matter Experts\"\n    ],\n    \"subscription_model\": \"Subscription & one-time course purchases\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Digital Marketing Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"3 weeks\"\n        },\n        {\n            \"course_name\": \"Photography Masterclass\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2014-08-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4,\n            \"comment\": \"Powerful platform for creating and selling online courses.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3,\n            \"comment\": \"Good features but a bit complex to set up.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnworlds.com\"\n}"}
