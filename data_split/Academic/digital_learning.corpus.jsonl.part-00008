{"_id": "Academic--digital_learning--n--70634", "text": "{\n    \"platform_name\": \"LearnSwift\",\n    \"developer\": \"CodeSwift Inc.\",\n    \"features\": [\n        \"Video tutorials\",\n        \"Coding challenges\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"iOS Developers\",\n        \"Mobile App Developers\",\n        \"Beginners\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Swift Programming Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"iOS App Development with SwiftUI\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2019-12-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Good for learning Swift basics.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"Some tutorials are outdated.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnswift.com\"\n}"}
{"_id": "Academic--digital_learning--p--70635", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill tracks\",\n        \"Project portfolio\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Analysts\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science skills! Very interactive and practical.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good content, but can be a bit pricey.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70635", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lectures\",\n        \"Practice exercises\",\n        \"Personalized learning dashboards\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Calculus 1\",\n            \"level\": \"Beginner\",\n            \"duration\": \"Self-paced\"\n        },\n        {\n            \"course_name\": \"Linear Algebra\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"Self-paced\"\n        },\n        {\n            \"course_name\": \"Statistics and Probability\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"Self-paced\"\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 5,\n            \"comment\": \"Excellent resource for free education! Very helpful for understanding fundamental concepts.\"\n        },\n        {\n            \"user_id\": \"user101\",\n            \"rating\": 4,\n            \"comment\": \"Great for basics, but not enough depth for advanced topics.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
{"_id": "Academic--digital_learning--p--70636", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp BV\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Python fundamentals\",\n                \"Data types\",\n                \"Control flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"R programming\",\n                \"Data manipulation\",\n                \"Data visualization\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Foundations\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Data analysis\",\n                \"Machine learning basics\",\n                \"Statistical modeling\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-02-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science!\"\n        },\n        {\n            \"user\": \"Bob\",\n            \"rating\": 4,\n            \"comment\": \"Helpful and interactive courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70636", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lectures\",\n        \"Practice exercises\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Statistics and probability\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Descriptive statistics\",\n                \"Probability\",\n                \"Inferential statistics\"\n            ]\n        },\n        {\n            \"course_name\": \"Calculus 1\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Limits\",\n                \"Derivatives\",\n                \"Integrals\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Charlie\",\n            \"rating\": 5,\n            \"comment\": \"Excellent resource for learning.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
