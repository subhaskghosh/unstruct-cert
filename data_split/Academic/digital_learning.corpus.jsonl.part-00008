{"_id": "Academic--digital_learning--p--70327", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Community forums\",\n        \"Skill assessments\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Data Manipulation with Pandas\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Scikit-learn\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Data Visualization with Seaborn\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Statistical Inference\",\n            \"level\": \"Advanced\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"John Doe\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science!\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70327", "text": "{\n    \"platform_name\": \"LearnPython.org\",\n    \"developer\": \"LearnPython.org Team\",\n    \"features\": [\n        \"Interactive Python tutorial\",\n        \"Code examples\",\n        \"Basic concepts explanations\"\n    ],\n    \"user_types\": [\n        \"Beginner Python learners\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python 3\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Python for Beginners\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Intermediate Python\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2018-11-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Jane Smith\",\n            \"rating\": 4,\n            \"comment\": \"Good resource for learning the basics.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnpython.org\"\n}"}
{"_id": "Academic--digital_learning--p--70328", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"6 months\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science! The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good variety of courses, and the community is very active.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70328", "text": "{\n    \"platform_name\": \"Learnify\",\n    \"developer\": \"EdTech Solutions Inc.\",\n    \"features\": [\n        \"Pre-recorded video lectures\",\n        \"Downloadable course materials\",\n        \"Quizzes\",\n        \"Certificate of completion\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Paid subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Statistics\",\n            \"level\": \"Beginner\",\n            \"duration\": \"3 weeks\"\n        },\n        {\n            \"course_name\": \"Data Analysis Fundamentals\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-05-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"The course content is decent, but the platform lacks a strong community feel.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"Limited interaction with instructors.  The platform is fairly basic.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnify.com\"\n}"}
