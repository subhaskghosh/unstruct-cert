{"_id": "Academic--digital_learning--n--70351", "text": "{\n    \"platform_name\": \"CourseBuffet\",\n    \"developer\": \"Open Educational Resources Foundation\",\n    \"features\": [\n        \"Curated list of free courses\",\n        \"MOOC aggregation\",\n        \"Course recommendations\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Lifelong learners\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Statistics\",\n            \"difficulty\": \"Beginner\",\n            \"topic\": \"Statistics\"\n        },\n        {\n            \"course_name\": \"Calculus I\",\n            \"difficulty\": \"Beginner\",\n            \"topic\": \"Calculus\"\n        }\n    ],\n    \"launch_date\": \"2013-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Helpful for finding free courses, but the quality varies a lot.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"The interface is a bit outdated.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursebuffet.com\"\n}"}
