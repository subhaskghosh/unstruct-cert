{"_id": "Academic--digital_learning--n--71150", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lessons\",\n        \"Practice exercises\",\n        \"Progress tracking\",\n        \"Personalized learning\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\",\n        \"Parents\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Arithmetic\",\n            \"level\": \"Beginner\",\n            \"duration\": \"Self-paced\"\n        },\n        {\n            \"course_name\": \"Algebra I\",\n            \"level\": \"Beginner\",\n            \"duration\": \"Self-paced\"\n        },\n        {\n            \"course_name\": \"Calculus\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"Self-paced\"\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice Johnson\",\n            \"rating\": 5,\n            \"comment\": \"A fantastic resource for students of all ages.\"\n        },\n        {\n            \"user\": \"Bob Williams\",\n            \"rating\": 4,\n            \"comment\": \"Helped my child improve their math skills.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
