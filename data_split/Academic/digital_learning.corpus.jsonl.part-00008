{"_id": "Academic--digital_learning--p--70965", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Project-based learning\",\n        \"Real-world datasets\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Python Syntax\",\n                \"Data Structures\",\n                \"Control Flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with Scikit-learn\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Supervised Learning\",\n                \"Unsupervised Learning\",\n                \"Model Evaluation\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Visualization with Tableau\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Chart Types\",\n                \"Data Storytelling\",\n                \"Interactive Dashboards\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"12345\",\n            \"rating\": 5,\n            \"comment\": \"Very engaging platform! The interactive exercises are great for learning.\"\n        },\n        {\n            \"user_id\": \"67890\",\n            \"rating\": 4,\n            \"comment\": \"Good courses, but the subscription can be a bit expensive.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70965", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lectures\",\n        \"Practice exercises\",\n        \"Progress tracking\",\n        \"Personalized learning\",\n        \"Dashboard for educators\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\",\n        \"Parents\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Algebra I\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Linear Equations\",\n                \"Inequalities\",\n                \"Functions\"\n            ]\n        },\n        {\n            \"course_name\": \"Calculus\",\n            \"difficulty\": \"Advanced\",\n            \"topics\": [\n                \"Limits\",\n                \"Derivatives\",\n                \"Integrals\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"11223\",\n            \"rating\": 5,\n            \"comment\": \"Excellent resource for free education!\"\n        },\n        {\n            \"user_id\": \"44556\",\n            \"rating\": 4,\n            \"comment\": \"Great for basic concepts, but lacks advanced topics.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
{"_id": "Academic--digital_learning--p--70966", "text": "{\n    \"platform_name\": \"SkillUp Pro\",\n    \"developer\": \"InnovateEd Tech\",\n    \"features\": [\n        \"Interactive video lectures\",\n        \"Personalized learning paths\",\n        \"Progress tracking\",\n        \"Community forums\",\n        \"Certification upon completion\"\n    ],\n    \"user_types\": [\n        \"Professionals\",\n        \"Students\",\n        \"Lifelong Learners\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Science Bootcamp\",\n            \"duration\": \"12 weeks\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Project Management Fundamentals\",\n            \"duration\": \"6 weeks\",\n            \"level\": \"Beginner\"\n        }\n    ],\n    \"launch_date\": \"2021-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for upskilling!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Very engaging courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.skilluppro.com\"\n}"}
{"_id": "Academic--digital_learning--n--70966", "text": "{\n    \"platform_name\": \"EduWorld\",\n    \"developer\": \"Global Learning Solutions\",\n    \"features\": [\n        \"Live classes\",\n        \"Recorded lectures\",\n        \"Assignment submission\",\n        \"Gradebook\",\n        \"Parent-teacher communication\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\",\n        \"Parents\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Algebra I\",\n            \"duration\": \"1 semester\",\n            \"level\": \"High School\"\n        },\n        {\n            \"course_name\": \"World History\",\n            \"duration\": \"1 year\",\n            \"level\": \"High School\"\n        }\n    ],\n    \"launch_date\": \"2022-01-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Decent platform for basic subjects.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4,\n            \"comment\": \"Good for supplemental learning.\"\n        }\n    ],\n    \"access_url\": \"https://www.eduworld.org\"\n}"}
{"_id": "Academic--digital_learning--p--70967", "text": "{\n    \"platform_name\": \"DataLearn Pro\",\n    \"developer\": \"InnovateEd Tech\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Personalized learning paths\",\n        \"Project-based learning\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium with paid certifications\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Data Science\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Python\",\n                \"Statistics\",\n                \"Data Visualization\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Supervised Learning\",\n                \"Unsupervised Learning\",\n                \"Deep Learning\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2021-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"This platform was incredibly helpful for getting started with data science. The interactive exercises are fantastic!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great resources and a supportive community.\"\n        }\n    ],\n    \"access_url\": \"https://www.datalearnpro.com\"\n}"}
{"_id": "Academic--digital_learning--n--70967", "text": "{\n    \"platform_name\": \"EduGlobal\",\n    \"developer\": \"Global Education Solutions\",\n    \"features\": [\n        \"Video lectures\",\n        \"Downloadable resources\",\n        \"Quizzes\",\n        \"Discussion boards\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\",\n        \"Researchers\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Calculus\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Limits\",\n                \"Derivatives\",\n                \"Integrals\"\n            ]\n        },\n        {\n            \"course_name\": \"Linear Algebra Basics\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Vectors\",\n                \"Matrices\",\n                \"Eigenvalues\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2022-03-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Good basic materials, but lacking advanced topics.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"The website is a bit clunky and navigation could be improved.\"\n        }\n    ],\n    \"access_url\": \"https://www.eduglobal.org\"\n}"}
{"_id": "Academic--digital_learning--p--70968", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Syntax\",\n                \"Data Types\",\n                \"Control Flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with scikit-learn\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Regression\",\n                \"Classification\",\n                \"Clustering\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Visualization with Tableau\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Charts\",\n                \"Dashboards\",\n                \"Storytelling\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-02-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science. Very practical and hands-on.\"\n        },\n        {\n            \"user_id\": \"456\",\n            \"rating\": 4,\n            \"comment\": \"Helpful courses and a supportive community.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70968", "text": "{\n    \"platform_name\": \"CourseSphere\",\n    \"developer\": \"EduTech Solutions Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Downloadable materials\",\n        \"Quizzes\",\n        \"Discussion forums\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Researchers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Theoretical Physics I\",\n            \"level\": \"Undergraduate\",\n            \"topics\": [\n                \"Quantum Mechanics\",\n                \"Relativity\",\n                \"Electromagnetism\"\n            ]\n        },\n        {\n            \"course_name\": \"Advanced Calculus\",\n            \"level\": \"Graduate\",\n            \"topics\": [\n                \"Real Analysis\",\n                \"Complex Analysis\",\n                \"Differential Equations\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2021-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"789\",\n            \"rating\": 3,\n            \"comment\": \"Good for theoretical concepts, but lacks practical application.\"\n        },\n        {\n            \"user_id\": \"101\",\n            \"rating\": 2,\n            \"comment\": \"The website is difficult to navigate.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursesphere.edu\"\n}"}
