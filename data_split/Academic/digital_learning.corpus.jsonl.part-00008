{"_id": "Academic--digital_learning--n--70830", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Peer assessments\",\n        \"Quizzes\",\n        \"Certificates\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Lifelong Learners\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"5 courses\"\n        }\n    ],\n    \"launch_date\": \"2012-04-12\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Bob\",\n            \"rating\": 4,\n            \"comment\": \"Good courses, but can be expensive.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org/\"\n}"}
{"_id": "Academic--digital_learning--p--70831", "text": "{\n    \"platform_name\": \"DataLearn Pro\",\n    \"developer\": \"InnovateEd Technologies\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Personalized learning paths\",\n        \"Project-based learning\",\n        \"Community forum\",\n        \"Live Q&A sessions\"\n    ],\n    \"user_types\": [\n        \"students\",\n        \"educators\",\n        \"data scientists\"\n    ],\n    \"subscription_model\": \"Freemium with Premium tiers\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Data Science\",\n            \"level\": \"beginner\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"intermediate\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform! The courses are well-structured and the instructors are very knowledgeable.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great resource for learning data science. The community forum is very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datalearnpro.com\"\n}"}
{"_id": "Academic--digital_learning--n--70831", "text": "{\n    \"platform_name\": \"CodeMaster Academy\",\n    \"developer\": \"TechEd Solutions\",\n    \"features\": [\n        \"Video lectures\",\n        \"Coding challenges\",\n        \"Certificate of completion\",\n        \"Offline access\"\n    ],\n    \"user_types\": [\n        \"students\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Python Fundamentals\",\n            \"level\": \"beginner\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Web Development Basics\",\n            \"level\": \"beginner\",\n            \"duration\": \"4 weeks\"\n        }\n    ],\n    \"launch_date\": \"2022-03-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"It's a decent starting point for learning to code, but lacks depth.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"The content is very basic and doesn't cover advanced topics.\"\n        }\n    ],\n    \"access_url\": \"https://www.codemasteracademy.org\"\n}"}
