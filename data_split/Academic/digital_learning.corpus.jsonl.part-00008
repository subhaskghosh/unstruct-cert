{"_id": "Academic--digital_learning--n--70240", "text": "{\n    \"platform_name\": \"LearnSQL.com\",\n    \"developer\": \"Seryu LLC\",\n    \"features\": [\n        \"Interactive SQL tutorials\",\n        \"Real-world examples\",\n        \"SQL exercises\",\n        \"Database schema visualization\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Database Administrators\",\n        \"Data Analysts\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"SQL Fundamentals\",\n            \"course_level\": \"Beginner\",\n            \"course_duration\": \"2 weeks\"\n        },\n        {\n            \"course_name\": \"Advanced SQL Techniques\",\n            \"course_level\": \"Intermediate\",\n            \"course_duration\": \"4 weeks\"\n        }\n    ],\n    \"launch_date\": \"2018-09-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4,\n            \"comment\": \"Very effective for learning SQL quickly.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3,\n            \"comment\": \"Limited scope beyond SQL.\"\n        }\n    ],\n    \"access_url\": \"https://learnsql.com\"\n}"}
