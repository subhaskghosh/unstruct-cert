{"_id": "Academic--digital_learning--p--71662", "text": "{\n    \"platform_name\": \"DataLearn Pro\",\n    \"developer\": \"InnovateEd Solutions\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Project-based learning\",\n        \"Personalized learning paths\",\n        \"Community forums\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Paid levels\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Data Science\",\n            \"description\": \"A beginner-friendly course covering data analysis and visualization.\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"description\": \"Learn the core concepts of machine learning with practical examples.\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2019-06-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.5,\n            \"comment\": \"Excellent platform with hands-on exercises. Very practical.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4.8,\n            \"comment\": \"The personalized learning paths are very effective.\"\n        }\n    ],\n    \"access_url\": \"https://www.datalearnpro.com\"\n}"}
{"_id": "Academic--digital_learning--n--71662", "text": "{\n    \"platform_name\": \"VideoEdu\",\n    \"developer\": \"Global Learning Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Quizzes\",\n        \"Discussion boards\",\n        \"Downloadable resources\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Science Overview\",\n            \"description\": \"A high-level introduction to data science concepts, primarily through video lectures.\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Introduction to Machine Learning\",\n            \"description\": \"Fundamentals of machine learning explained with extensive video content.\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2018-11-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3.5,\n            \"comment\": \"Good content, but too much focus on video lectures.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3.2,\n            \"comment\": \"The interface is a bit clunky.\"\n        }\n    ],\n    \"access_url\": \"https://www.videoedu.net\"\n}"}
