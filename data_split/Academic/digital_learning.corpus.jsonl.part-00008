{"_id": "Academic--digital_learning--n--71183", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Google\",\n    \"features\": [\n        \"Video lectures\",\n        \"Peer assessments\",\n        \"Quizzes\",\n        \"Certificates\",\n        \"Specializations\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Lifelong learners\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Supervised Learning\",\n                \"Unsupervised Learning\",\n                \"Neural Networks\"\n            ]\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Convolutional Neural Networks\",\n                \"Recurrent Neural Networks\",\n                \"LSTMs\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2012-03-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3.8,\n            \"comment\": \"Good content, but can be expensive.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4.0,\n            \"comment\": \"Great instructors and well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org\"\n}"}
