{"_id": "Academic--digital_learning--n--70638", "text": "{\n    \"platform_name\": \"Udemy\",\n    \"developer\": \"Udemy, Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Downloadable resources\",\n        \"Q&A forums\",\n        \"Lifetime access to courses\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Instructors\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Complete Python Bootcamp\",\n            \"subject\": \"Data Science\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Machine Learning A-Z™\",\n            \"subject\": \"Machine Learning\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2010-05-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user111\",\n            \"rating\": 3,\n            \"comment\": \"Course content is good, but quality varies between instructors.\"\n        },\n        {\n            \"user_id\": \"user222\",\n            \"rating\": 4,\n            \"comment\": \"Lots of courses available at reasonable prices.\"\n        },\n        {\n            \"user_id\": \"user333\",\n            \"rating\": 2,\n            \"comment\": \"Some courses are outdated or poorly maintained.\"\n        },\n        {\n            \"user_id\": \"user444\",\n            \"rating\": 5,\n            \"comment\": \"I learned a lot from this course, and the instructor was great.\"\n        }\n    ],\n    \"access_url\": \"https://www.udemy.com\"\n}"}
