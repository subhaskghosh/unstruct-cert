{"_id": "Academic--digital_learning--n--71326", "text": "{\n    \"platform_name\": \"LearnWorlds\",\n    \"developer\": \"LearnWorlds Inc.\",\n    \"features\": [\n        \"Course creation tools\",\n        \"Video hosting\",\n        \"Interactive video\",\n        \"Community features\",\n        \"Analytics\"\n    ],\n    \"user_types\": [\n        \"Educators\",\n        \"Subject Matter Experts\",\n        \"Training Managers\"\n    ],\n    \"subscription_model\": \"Paid levels\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Digital Marketing Masterclass\",\n            \"duration\": \"10 weeks\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Photography Fundamentals\",\n            \"duration\": \"6 weeks\",\n            \"level\": \"Beginner\"\n        }\n    ],\n    \"launch_date\": \"2014-08-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"67890\",\n            \"rating\": 4.0,\n            \"comment\": \"Excellent platform for creating and selling online courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnworlds.com\"\n}"}
{"_id": "Academic--digital_learning--p--71327", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp BV\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Project-based learning\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topic\": \"Programming\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"topic\": \"Machine Learning\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"topic\": \"Data Science\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"John Doe\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science! Very beginner-friendly.\"\n        },\n        {\n            \"user\": \"Jane Smith\",\n            \"rating\": 4,\n            \"comment\": \"Helpful interactive exercises.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71327", "text": "{\n    \"platform_name\": \"LearnVerse\",\n    \"developer\": \"NovaTech Solutions\",\n    \"features\": [\n        \"Pre-recorded video lectures\",\n        \"Downloadable course materials\",\n        \"Q&A forums\",\n        \"Certificate of completion\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Paid - Lifetime Access\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Analysis Fundamentals\",\n            \"level\": \"Beginner\",\n            \"topic\": \"Data Analysis\"\n        },\n        {\n            \"course_name\": \"Advanced Machine Learning Techniques\",\n            \"level\": \"Advanced\",\n            \"topic\": \"Machine Learning\"\n        }\n    ],\n    \"launch_date\": \"2019-12-10\",\n    \"user_feedback\": [\n        {\n            \"user\": \"David Lee\",\n            \"rating\": 3,\n            \"comment\": \"The content is good, but the interface feels a bit outdated.\"\n        },\n        {\n            \"user\": \"Emily Chen\",\n            \"rating\": 4,\n            \"comment\": \"Good value for the price.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnverse.edu\"\n}"}
{"_id": "Academic--digital_learning--p--71328", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscription tiers\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Python basics\",\n                \"Data types\",\n                \"Control flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with Scikit-learn\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Regression\",\n                \"Classification\",\n                \"Clustering\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"topics\": [\n                \"Statistical Modeling\",\n                \"Data Visualization\",\n                \"Big Data\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science. Very interactive and easy to follow.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great resource for upskilling in Python and machine learning.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--71328", "text": "{\n    \"platform_name\": \"LearnVerse\",\n    \"developer\": \"Global Education Tech\",\n    \"features\": [\n        \"Pre-recorded video lectures\",\n        \"Downloadable course materials\",\n        \"Quizzes\",\n        \"Discussion boards\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Researchers\"\n    ],\n    \"subscription_model\": \"Tiered monthly subscriptions with bundled access.\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Classical Literature Analysis\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Shakespeare\",\n                \"Victorian Novels\",\n                \"Poetry\"\n            ]\n        },\n        {\n            \"course_name\": \"Advanced Quantum Physics\",\n            \"level\": \"Advanced\",\n            \"topics\": [\n                \"Quantum Mechanics\",\n                \"Relativity\",\n                \"String Theory\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2019-12-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Decent course materials, but the platform is a bit clunky and difficult to navigate.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"I found the content to be very theoretical and lacked practical application.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnverse.org/\"\n}"}
{"_id": "Academic--digital_learning--p--71329", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Project-based learning\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscription tiers\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Python basics\",\n                \"Data types\",\n                \"Control flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Regression\",\n                \"Classification\",\n                \"Clustering\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"topics\": [\n                \"Data wrangling\",\n                \"Data visualization\",\n                \"Statistical modeling\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science. Highly recommended!\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71329", "text": "{\n    \"platform_name\": \"LearnLegacy\",\n    \"developer\": \"Legacy Learning Systems\",\n    \"features\": [\n        \"Pre-recorded video lectures\",\n        \"Downloadable course materials\",\n        \"Quiz assessments\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Instructors\"\n    ],\n    \"subscription_model\": \"Paid subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Classical Physics 101\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Newtonian mechanics\",\n                \"Thermodynamics\",\n                \"Electromagnetism\"\n            ]\n        },\n        {\n            \"course_name\": \"Organic Chemistry Fundamentals\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Alkanes\",\n                \"Alkenes\",\n                \"Alkynes\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2018-05-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"456\",\n            \"rating\": 3,\n            \"comment\": \"Decent content, but the platform feels outdated.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnlegacy.edu\"\n}"}
{"_id": "Academic--digital_learning--p--71330", "text": "{\n    \"platform_name\": \"SkillForge\",\n    \"developer\": \"EduTech Solutions Inc.\",\n    \"features\": [\n        \"Interactive lessons\",\n        \"Progress tracking\",\n        \"Personalized learning paths\",\n        \"Community forums\",\n        \"Certification options\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Python for Data Science\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Digital Marketing Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Project Management Essentials\",\n            \"level\": \"Beginner\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Advanced JavaScript\",\n            \"level\": \"Advanced\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"Data Analytics with SQL\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"9 weeks\"\n        }\n    ],\n    \"launch_date\": \"2022-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"comment\": \"Very user-friendly interface and excellent course content!\",\n            \"rating\": 5\n        },\n        {\n            \"user_id\": \"user456\",\n            \"comment\": \"Great for upskilling and career advancement.\",\n            \"rating\": 4\n        }\n    ],\n    \"access_url\": \"https://www.skillforge.com\"\n}"}
{"_id": "Academic--digital_learning--n--71330", "text": "{\n    \"platform_name\": \"LearnSphere\",\n    \"developer\": \"InnovateEd Technologies\",\n    \"features\": [\n        \"Video lectures\",\n        \"Quiz assessments\",\n        \"Downloadable resources\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Researchers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Theoretical Physics I\",\n            \"level\": \"Undergraduate\",\n            \"duration\": \"16 weeks\"\n        },\n        {\n            \"course_name\": \"Organic Chemistry\",\n            \"level\": \"Undergraduate\",\n            \"duration\": \"14 weeks\"\n        },\n        {\n            \"course_name\": \"Linear Algebra\",\n            \"level\": \"Undergraduate\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-11-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"comment\": \"Comprehensive materials, but the interface is quite complex.\",\n            \"rating\": 3\n        },\n        {\n            \"user_id\": \"user012\",\n            \"comment\": \"Good for academic research.\",\n            \"rating\": 4\n        }\n    ],\n    \"access_url\": \"https://www.learnsphere.org\"\n}"}
{"_id": "Academic--digital_learning--p--71331", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill tracks\",\n        \"Project portfolio\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscription tiers\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"topic\": \"Programming\"\n        },\n        {\n            \"course_name\": \"Data Science Fundamentals\",\n            \"difficulty\": \"Intermediate\",\n            \"topic\": \"Data Science\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"difficulty\": \"Advanced\",\n            \"topic\": \"Machine Learning\"\n        },\n        {\n            \"course_name\": \"Deep Learning with TensorFlow\",\n            \"difficulty\": \"Advanced\",\n            \"topic\": \"Deep Learning\"\n        },\n        {\n            \"course_name\": \"SQL Fundamentals\",\n            \"difficulty\": \"Beginner\",\n            \"topic\": \"Databases\"\n        },\n        {\n            \"course_name\": \"Data Visualization with Tableau\",\n            \"difficulty\": \"Intermediate\",\n            \"topic\": \"Data Visualization\"\n        },\n        {\n            \"course_name\": \"Statistical Inference\",\n            \"difficulty\": \"Intermediate\",\n            \"topic\": \"Statistics\"\n        },\n        {\n            \"course_name\": \"Time Series Analysis\",\n            \"difficulty\": \"Advanced\",\n            \"topic\": \"Statistics\"\n        },\n        {\n            \"course_name\": \"Natural Language Processing\",\n            \"difficulty\": \"Advanced\",\n            \"topic\": \"Machine Learning\"\n        },\n        {\n            \"course_name\": \"Python for Data Science\",\n            \"difficulty\": \"Intermediate\",\n            \"topic\": \"Programming\"\n        },\n        {\n            \"course_name\": \"Feature Engineering\",\n            \"difficulty\": \"Intermediate\",\n            \"topic\": \"Machine Learning\"\n        },\n        {\n            \"course_name\": \"Model Evaluation\",\n            \"difficulty\": \"Intermediate\",\n            \"topic\": \"Machine Learning\"\n        },\n        {\n            \"course_name\": \"A/B Testing\",\n            \"difficulty\": \"Intermediate\",\n            \"topic\": \"Statistics\"\n        },\n        {\n            \"course_name\": \"Experiment Design\",\n            \"difficulty\": \"Intermediate\",\n            \"topic\": \"Statistics\"\n        },\n        {\n            \"course_name\": \"Bayesian Statistics\",\n            \"difficulty\": \"Advanced\",\n            \"topic\": \"Statistics\"\n        },\n        {\n            \"course_name\": \"Reinforcement Learning\",\n            \"difficulty\": \"Advanced\",\n            \"topic\": \"Machine Learning\"\n        },\n        {\n            \"course_name\": \"Computer Vision\",\n            \"difficulty\": \"Advanced\",\n            \"topic\": \"Machine Learning\"\n        },\n        {\n            \"course_name\": \"Big Data with Spark\",\n            \"difficulty\": \"Advanced\",\n            \"topic\": \"Data Engineering\"\n        },\n        {\n            \"course_name\": \"Cloud Computing with AWS\",\n            \"difficulty\": \"Intermediate\",\n            \"topic\": \"Cloud Computing\"\n        },\n        {\n            \"course_name\": \"Data Ethics\",\n            \"difficulty\": \"Beginner\",\n            \"topic\": \"Ethics\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Very user-friendly and effective for learning data science.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great platform, well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71331", "text": "{\n    \"platform_name\": \"Codecademy\",\n    \"developer\": \"Codecademy\",\n    \"features\": [\n        \"Interactive coding lessons\",\n        \"Project-based learning\",\n        \"Career paths\",\n        \"Code editor\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Beginners\"\n    ],\n    \"subscription_model\": \"Freemium with paid Pro access\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to HTML\",\n            \"difficulty\": \"Beginner\",\n            \"topic\": \"Web Development\"\n        },\n        {\n            \"course_name\": \"Introduction to JavaScript\",\n            \"difficulty\": \"Beginner\",\n            \"topic\": \"Web Development\"\n        },\n        {\n            \"course_name\": \"Learn Python 3\",\n            \"difficulty\": \"Beginner\",\n            \"topic\": \"Programming\"\n        },\n        {\n            \"course_name\": \"Data Science Path\",\n            \"difficulty\": \"Beginner\",\n            \"topic\": \"Data Science\"\n        },\n        {\n            \"course_name\": \"Introduction to SQL\",\n            \"difficulty\": \"Beginner\",\n            \"topic\": \"Databases\"\n        }\n    ],\n    \"launch_date\": \"2011-08-22\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Good for beginners, but lacks depth.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4,\n            \"comment\": \"Easy to learn, but could be more challenging.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com\"\n}"}
{"_id": "Academic--digital_learning--p--71332", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill tracks\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"title\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"title\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"title\": \"Machine Learning with Python\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"John Doe\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science! The interactive exercises are very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--71332", "text": "{\n    \"platform_name\": \"Codecademy\",\n    \"developer\": \"Codecademy\",\n    \"features\": [\n        \"Interactive coding\",\n        \"Career paths\",\n        \"Skill paths\",\n        \"Projects\",\n        \"Quizzes\"\n    ],\n    \"user_types\": [\n        \"Beginners\",\n        \"Students\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"title\": \"Learn HTML\",\n            \"level\": \"Beginner\",\n            \"duration\": \"2 weeks\"\n        },\n        {\n            \"title\": \"Learn CSS\",\n            \"level\": \"Beginner\",\n            \"duration\": \"2 weeks\"\n        },\n        {\n            \"title\": \"Learn JavaScript\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"4 weeks\"\n        }\n    ],\n    \"launch_date\": \"2011-08-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Jane Smith\",\n            \"rating\": 4,\n            \"comment\": \"Good for basic coding skills, but lacks depth in advanced topics.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com/\"\n}"}
{"_id": "Academic--digital_learning--p--71333", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Instructors\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscription tiers\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"category\": \"Data Science\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"category\": \"Machine Learning\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"John Doe\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science!\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
