{"_id": "Academic--digital_learning--p--71714", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill assessments\",\n        \"Career tracks\",\n        \"Project-based learning\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topic\": \"Data Science\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"topic\": \"Artificial Intelligence\"\n        }\n    ],\n    \"launch_date\": \"2016-02-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Jane Doe\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science skills. The interactive exercises are very helpful, and the course quality is top-notch.\"\n        },\n        {\n            \"user\": \"John Smith\",\n            \"rating\": 4,\n            \"comment\": \"Great resource for upskilling in data science. The subscription is worth the price.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71714", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lessons\",\n        \"Practice exercises\",\n        \"Progress tracking\",\n        \"Personalized learning\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Algebra I\",\n            \"level\": \"Beginner\",\n            \"topic\": \"Mathematics\"\n        },\n        {\n            \"course_name\": \"AP Calculus AB\",\n            \"level\": \"Advanced\",\n            \"topic\": \"Mathematics\"\n        }\n    ],\n    \"launch_date\": \"2008-09-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice Brown\",\n            \"rating\": 4,\n            \"comment\": \"A fantastic resource for K-12 education. My kids have benefited greatly from the free courses.\"\n        },\n        {\n            \"user\": \"Bob Green\",\n            \"rating\": 5,\n            \"comment\": \"Excellent free resource for students of all ages.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
{"_id": "Academic--digital_learning--p--71715", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Project-based learning\",\n        \"Data science community\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium with paid tiers\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with scikit-learn\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Data Visualization with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"5 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for hands-on learning. The interactive exercises are very effective.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good variety of courses. The instructors are knowledgeable and the content is up-to-date.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71715", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lessons\",\n        \"Practice exercises\",\n        \"Personalized learning dashboard\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\",\n        \"Parents\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Algebra I\",\n            \"level\": \"Beginner\",\n            \"duration\": \"Self-paced\"\n        },\n        {\n            \"course_name\": \"Calculus I\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"Self-paced\"\n        },\n        {\n            \"course_name\": \"Statistics and Probability\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"Self-paced\"\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 5,\n            \"comment\": \"Fantastic resource for students. Completely free and covers a wide range of topics.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4,\n            \"comment\": \"Helpful for reinforcing concepts learned in class.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
{"_id": "Academic--digital_learning--p--71716", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Project-based learning\",\n        \"Real-time feedback\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"difficulty\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science!\"\n        },\n        {\n            \"user_id\": \"456\",\n            \"rating\": 4,\n            \"comment\": \"Good interactive exercises.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--71716", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Assignments\",\n        \"Peer assessments\",\n        \"Specializations\",\n        \"Degree programs\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Lifelong Learners\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Paid levels\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"difficulty\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"difficulty\": \"Advanced\",\n            \"duration\": \"5 courses\"\n        }\n    ],\n    \"launch_date\": \"2012-05-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"789\",\n            \"rating\": 4,\n            \"comment\": \"Great courses, but can be expensive.\"\n        },\n        {\n            \"user_id\": \"101\",\n            \"rating\": 3,\n            \"comment\": \"Content is good, but the platform is not always easy to navigate.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org/\"\n}"}
{"_id": "Academic--digital_learning--p--71717", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill tracks\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"subject\": \"Computer Science\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"subject\": \"Data Science\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2016-01-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Jane Doe\",\n            \"rating\": 5,\n            \"comment\": \"Very intuitive and easy to learn from. The interactive exercises are excellent.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71717", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Peer assessments\",\n        \"Quizzes\",\n        \"Specializations\",\n        \"Degree programs\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Paid subscriptions, course-by-course purchase\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"subject\": \"Computer Science\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Financial Markets\",\n            \"subject\": \"Finance\",\n            \"level\": \"Beginner\"\n        }\n    ],\n    \"launch_date\": \"2012-05-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"John Smith\",\n            \"rating\": 4,\n            \"comment\": \"Good content, but sometimes the interface can be clunky.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org\"\n}"}
{"_id": "Academic--digital_learning--p--71718", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill tracks\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\",\n        \"Engineers\"\n    ],\n    \"subscription_model\": \"Freemium/Paid Subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Scientist with Python\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 months\"\n        },\n        {\n            \"course_name\": \"Machine Learning Scientist with R\",\n            \"level\": \"Advanced\",\n            \"duration\": \"9 months\"\n        }\n    ],\n    \"launch_date\": \"2016-01-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"rating\": 4.5,\n            \"comment\": \"Excellent platform for learning data science skills.\"\n        },\n        {\n            \"user_id\": \"456\",\n            \"rating\": 4.2,\n            \"comment\": \"Interactive exercises are very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71718", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lessons\",\n        \"Practice exercises\",\n        \"Personalized learning\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\",\n        \"Parents\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Calculus 1\",\n            \"level\": \"Beginner\",\n            \"duration\": \"1 semester\"\n        },\n        {\n            \"course_name\": \"Statistics\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"1 semester\"\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"789\",\n            \"rating\": 4.8,\n            \"comment\": \"Great resource for learning foundational math concepts.\"\n        },\n        {\n            \"user_id\": \"101\",\n            \"rating\": 4.6,\n            \"comment\": \"Very helpful for students of all ages.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
{"_id": "Academic--digital_learning--p--71719", "text": "{\n    \"platform_name\": \"DataLearn Pro\",\n    \"developer\": \"InnovateEd Solutions\",\n    \"features\": [\n        \"Interactive Coding Exercises\",\n        \"Personalized Learning Paths\",\n        \"Community Forums\",\n        \"Project-Based Learning\",\n        \"Real-Time Collaboration\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Data Science\",\n            \"level\": \"Beginner\",\n            \"instructor\": \"Dr. Emily Carter\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Intermediate\",\n            \"instructor\": \"David Lee\"\n        }\n    ],\n    \"launch_date\": \"2021-03-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice Johnson\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science! The interactive exercises are very helpful.\"\n        },\n        {\n            \"user\": \"Bob Williams\",\n            \"rating\": 4,\n            \"comment\": \"Good courses and a supportive community.\"\n        }\n    ],\n    \"access_url\": \"https://www.datalearnpro.com\"\n}"}
{"_id": "Academic--digital_learning--n--71719", "text": "{\n    \"platform_name\": \"KidsCode Academy\",\n    \"developer\": \"EduFun Inc.\",\n    \"features\": [\n        \"Gamified Learning\",\n        \"Drag-and-Drop Coding\",\n        \"Animated Tutorials\",\n        \"Progress Tracking\"\n    ],\n    \"user_types\": [\n        \"Students (K-12)\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Paid - Monthly\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Coding for Kids - Scratch\",\n            \"level\": \"Beginner\",\n            \"instructor\": \"Ms. Sarah Green\"\n        },\n        {\n            \"course_name\": \"Intro to Robotics\",\n            \"level\": \"Elementary\",\n            \"instructor\": \"Mr. John Brown\"\n        }\n    ],\n    \"launch_date\": \"2022-05-20\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Parent123\",\n            \"rating\": 5,\n            \"comment\": \"My child loves this platform! It makes learning to code fun and engaging.\"\n        },\n        {\n            \"user\": \"Teacher456\",\n            \"rating\": 4,\n            \"comment\": \"Great resource for introducing coding concepts to young students.\"\n        }\n    ],\n    \"access_url\": \"https://www.kidscodeacademy.com\"\n}"}
{"_id": "Academic--digital_learning--p--71720", "text": "{\n    \"platform_name\": \"SkillForge\",\n    \"developer\": \"TechEd Solutions Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Project-based learning\",\n        \"Live Q&A sessions\",\n        \"Peer code review\",\n        \"Personalized learning paths\"\n    ],\n    \"user_types\": [\n        \"University Students\",\n        \"Career Changers\",\n        \"Software Developers\"\n    ],\n    \"subscription_model\": \"Paid tiers with free trial\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Full Stack Web Development\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\",\n            \"price\": 299\n        },\n        {\n            \"course_name\": \"Data Science Bootcamp\",\n            \"level\": \"Advanced\",\n            \"duration\": \"16 weeks\",\n            \"price\": 499\n        },\n        {\n            \"course_name\": \"Introduction to Machine Learning\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\",\n            \"price\": 199\n        }\n    ],\n    \"launch_date\": \"2023-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform! The interactive exercises really helped me solidify my understanding.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great course content and helpful instructors.\"\n        }\n    ],\n    \"access_url\": \"https://www.skillforge.com\"\n}"}
{"_id": "Academic--digital_learning--n--71720", "text": "{\n    \"platform_name\": \"KidsLearn Academy\",\n    \"developer\": \"EduFun Corp\",\n    \"features\": [\n        \"Animated lessons\",\n        \"Gamified quizzes\",\n        \"Story-based learning\",\n        \"Progress tracking\",\n        \"Parental controls\"\n    ],\n    \"user_types\": [\n        \"Elementary School Students\",\n        \"Preschoolers\",\n        \"Parents\"\n    ],\n    \"subscription_model\": \"Freemium with in-app purchases\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Basic Math for Kids\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\",\n            \"price\": 0\n        },\n        {\n            \"course_name\": \"Reading Adventures\",\n            \"level\": \"Easy\",\n            \"duration\": \"6 weeks\",\n            \"price\": 0\n        }\n    ],\n    \"launch_date\": \"2021-11-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"parent789\",\n            \"rating\": 4,\n            \"comment\": \"My child loves this app! It's a fun way to learn.\"\n        },\n        {\n            \"user_id\": \"parent101\",\n            \"rating\": 5,\n            \"comment\": \"Highly recommend for young learners.\"\n        }\n    ],\n    \"access_url\": \"https://www.kidslearnacademy.com\"\n}"}
{"_id": "Academic--digital_learning--p--71721", "text": "{\n    \"platform_name\": \"SciLearn Pro\",\n    \"developer\": \"InnovateEd Technologies\",\n    \"features\": [\n        \"Interactive simulations\",\n        \"Personalized learning paths\",\n        \"Progress tracking\",\n        \"Gamified quizzes\",\n        \"Peer-to-peer learning forums\"\n    ],\n    \"user_types\": [\n        \"University students\",\n        \"College professors\",\n        \"Independent learners\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Calculus I\",\n            \"subject\": \"Mathematics\",\n            \"level\": \"Undergraduate\"\n        },\n        {\n            \"course_name\": \"Introduction to Physics\",\n            \"subject\": \"Physics\",\n            \"level\": \"Undergraduate\"\n        },\n        {\n            \"course_name\": \"Data Structures and Algorithms\",\n            \"subject\": \"Computer Science\",\n            \"level\": \"Undergraduate\"\n        },\n        {\n            \"course_name\": \"Organic Chemistry\",\n            \"subject\": \"Chemistry\",\n            \"level\": \"Undergraduate\"\n        },\n        {\n            \"course_name\": \"Linear Algebra\",\n            \"subject\": \"Mathematics\",\n            \"level\": \"Undergraduate\"\n        },\n        {\n            \"course_name\": \"Introduction to Biology\",\n            \"subject\": \"Biology\",\n            \"level\": \"Undergraduate\"\n        }\n    ],\n    \"launch_date\": \"2020-03-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform! The simulations really helped me understand complex concepts.\"\n        },\n        {\n            \"user\": \"Bob\",\n            \"rating\": 4,\n            \"comment\": \"Great resource for STEM courses. User interface is very intuitive.\"\n        }\n    ],\n    \"access_url\": \"https://www.scilearnpro.com\"\n}"}
