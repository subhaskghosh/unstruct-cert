{"_id": "Academic--digital_learning--n--70462", "text": "{\n    \"platform_name\": \"LearnGenetics\",\n    \"developer\": \"University of Utah\",\n    \"features\": [\n        \"Interactive simulations\",\n        \"Educational videos\",\n        \"Problem-solving exercises\",\n        \"Genetic concepts explained\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Researchers\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Mendelian Genetics\",\n            \"level\": \"Beginner\",\n            \"duration\": \"2 weeks\"\n        },\n        {\n            \"course_name\": \"Population Genetics\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"4 weeks\"\n        }\n    ],\n    \"launch_date\": \"2003-03-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"789\",\n            \"rating\": 4,\n            \"comment\": \"Very helpful resource for understanding genetics.\"\n        },\n        {\n            \"user_id\": \"101\",\n            \"rating\": 5,\n            \"comment\": \"Great interactive simulations.\"\n        }\n    ],\n    \"access_url\": \"https://learn.genetics.utah.edu/\"\n}"}
