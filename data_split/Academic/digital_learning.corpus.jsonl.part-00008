{"_id": "Academic--digital_learning--n--70096", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Reading materials\",\n        \"Quizzes\",\n        \"Peer assessments\",\n        \"Specializations\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Lifelong Learners\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"level\": \"Beginner\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"5 courses\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"4 courses\"\n        }\n    ],\n    \"launch_date\": \"2012-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"The courses are good but can be quite academic and lack hands-on practice.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4,\n            \"comment\": \"Wide range of courses available from top universities.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org\"\n}"}
