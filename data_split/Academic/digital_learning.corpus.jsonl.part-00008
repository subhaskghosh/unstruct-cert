{"_id": "Academic--digital_learning--n--70300", "text": "{\n    \"platform_name\": \"LearnWorlds\",\n    \"developer\": \"LearnWorlds Ltd.\",\n    \"features\": [\n        \"Course builder\",\n        \"Video hosting\",\n        \"Community features\",\n        \"Marketing tools\"\n    ],\n    \"user_types\": [\n        \"Educators\",\n        \"Entrepreneurs\"\n    ],\n    \"subscription_model\": \"Paid levels\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Digital Marketing Fundamentals\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"SEO\",\n                \"Social Media\",\n                \"Email Marketing\"\n            ]\n        },\n        {\n            \"course_name\": \"Web Development with Javascript\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Front-end Development\",\n                \"Back-end Development\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2018-05-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4,\n            \"comment\": \"Good for creating online courses.\"\n        },\n        {\n            \"user_id\": \"user101\",\n            \"rating\": 3,\n            \"comment\": \"The interface can be a bit clunky.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnworlds.com\"\n}"}
{"_id": "Academic--digital_learning--p--70301", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Project-based learning\",\n        \"Certification\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Analysts\",\n        \"Students\",\n        \"Career Changers\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"John Doe\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science from scratch.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
