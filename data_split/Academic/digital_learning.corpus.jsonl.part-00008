{"_id": "Academic--digital_learning--p--71057", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill tracks\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Python basics\",\n                \"Data types\",\n                \"Control flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Supervised learning\",\n                \"Unsupervised learning\",\n                \"Model evaluation\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"difficulty\": \"Advanced\",\n            \"topics\": [\n                \"Data mining\",\n                \"Statistical modeling\",\n                \"Data visualization\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science! The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great courses and a user-friendly interface. Highly recommend!\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71057", "text": "{\n    \"platform_name\": \"LearnGenetics\",\n    \"developer\": \"University of Utah\",\n    \"features\": [\n        \"Interactive simulations\",\n        \"Educational videos\",\n        \"Detailed explanations\",\n        \"Assessments\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Mendelian Genetics\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Inheritance\",\n                \"Genes\",\n                \"Chromosomes\"\n            ]\n        },\n        {\n            \"course_name\": \"Molecular Biology\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"DNA\",\n                \"RNA\",\n                \"Protein synthesis\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2004-09-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4,\n            \"comment\": \"A fantastic resource for learning genetics! Clear and concise explanations.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 5,\n            \"comment\": \"Excellent simulations that help visualize complex concepts.\"\n        }\n    ],\n    \"access_url\": \"https://learn.genetics.utah.edu/\"\n}"}
