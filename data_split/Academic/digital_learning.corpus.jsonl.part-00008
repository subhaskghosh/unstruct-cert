{"_id": "Academic--digital_learning--n--70445", "text": "{\n    \"platform_name\": \"LearnLaTeX\",\n    \"developer\": \"The LearnLaTeX Team\",\n    \"features\": [\n        \"LaTeX tutorial\",\n        \"Example code\",\n        \"Online editor\",\n        \"Forum support\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Researchers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"LaTeX Basics\",\n            \"level\": \"Beginner\",\n            \"subject\": \"Mathematics\"\n        },\n        {\n            \"course_name\": \"Advanced LaTeX Techniques\",\n            \"level\": \"Advanced\",\n            \"subject\": \"Mathematics\"\n        }\n    ],\n    \"launch_date\": \"2018-11-01\",\n    \"user_feedback\": [\n        {\n            \"user_type\": \"Student\",\n            \"rating\": 4,\n            \"comment\": \"A useful resource for learning LaTeX, but a bit dry.\"\n        },\n        {\n            \"user_type\": \"Researcher\",\n            \"rating\": 5,\n            \"comment\": \"Essential tool for writing scientific papers.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnlatex.org/\"\n}"}
