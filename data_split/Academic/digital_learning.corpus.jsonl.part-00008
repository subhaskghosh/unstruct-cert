{"_id": "Academic--digital_learning--p--70082", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Manipulation with Pandas\",\n            \"difficulty\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Data Visualization with Tableau\",\n            \"difficulty\": \"Intermediate\",\n            \"duration\": \"5 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Scikit-learn\",\n            \"difficulty\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Statistical Inference\",\n            \"difficulty\": \"Intermediate\",\n            \"duration\": \"5 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-07-12\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Very engaging and practical! Helped me land a job.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Excellent content and well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70082", "text": "{\n    \"platform_name\": \"Codecademy\",\n    \"developer\": \"Codecademy\",\n    \"features\": [\n        \"Interactive lessons\",\n        \"Project building\",\n        \"Career paths\",\n        \"Skill paths\",\n        \"Certificates\"\n    ],\n    \"user_types\": [\n        \"Beginners\",\n        \"Students\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to HTML\",\n            \"difficulty\": \"Beginner\",\n            \"duration\": \"2 weeks\"\n        },\n        {\n            \"course_name\": \"Introduction to JavaScript\",\n            \"difficulty\": \"Beginner\",\n            \"duration\": \"3 weeks\"\n        },\n        {\n            \"course_name\": \"Learn Python 3\",\n            \"difficulty\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        }\n    ],\n    \"launch_date\": \"2011-08-22\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Good for beginners, but can be a bit basic.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4,\n            \"comment\": \"The projects are fun and help reinforce the concepts.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com\"\n}"}
{"_id": "Academic--digital_learning--p--70083", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill assessments\",\n        \"Project-based learning\"\n    ],\n    \"user_types\": [\n        \"students\",\n        \"educators\",\n        \"data scientists\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Very user-friendly and interactive! Great for learning data science.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Excellent platform with a wide range of courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
