{"_id": "Academic--digital_learning--p--71473", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Projects\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Python syntax\",\n                \"Data types\",\n                \"Control flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Machine Learning\",\n                \"Data Visualization\",\n                \"Statistical Modeling\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-02-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science. The interactive exercises are very helpful!\"\n        },\n        {\n            \"user_id\": \"456\",\n            \"rating\": 4,\n            \"comment\": \"Good course quality and a lot of practical exercises.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--71473", "text": "{\n    \"platform_name\": \"LearnWorlds\",\n    \"developer\": \"LearnWorlds\",\n    \"features\": [\n        \"Course Creation Tools\",\n        \"Video Hosting\",\n        \"Interactive Videos\",\n        \"Quizzes\",\n        \"Community Features\"\n    ],\n    \"user_types\": [\n        \"Educators\",\n        \"Businesses\"\n    ],\n    \"subscription_model\": \"Paid plans\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Digital Marketing Fundamentals\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"SEO\",\n                \"Social Media Marketing\",\n                \"Email Marketing\"\n            ]\n        },\n        {\n            \"course_name\": \"Photography Masterclass\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Lighting\",\n                \"Composition\",\n                \"Editing\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2014-08-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"789\",\n            \"rating\": 4,\n            \"comment\": \"Great platform for building and selling online courses.\"\n        },\n        {\n            \"user_id\": \"101\",\n            \"rating\": 5,\n            \"comment\": \"Excellent support and a wide range of features.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnworlds.com/\"\n}"}
{"_id": "Academic--digital_learning--p--71474", "text": "{\n    \"platform_name\": \"SkillSprint\",\n    \"developer\": \"EduNova Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Live Q&A sessions\",\n        \"Personalized learning paths\",\n        \"Project-based learning\",\n        \"Certificate of completion\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Python for Data Science\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Digital Marketing Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Business Analytics with Excel\",\n            \"level\": \"Beginner\",\n            \"duration\": \"6 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"A very user-friendly platform with innovative approaches to learning! I really enjoyed the interactive exercises.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great content and well-structured courses. The personalized learning paths are very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.skillsprint.com\"\n}"}
{"_id": "Academic--digital_learning--n--71474", "text": "{\n    \"platform_name\": \"GlobalLearn Pro\",\n    \"developer\": \"TechGiant Corp.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Downloadable resources\",\n        \"Discussion forums\",\n        \"Progress tracking\",\n        \"Mobile app access\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Programming\",\n            \"level\": \"Beginner\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"Principles of Management\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"14 weeks\"\n        }\n    ],\n    \"launch_date\": \"2022-01-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"It's a decent platform, but feels a bit outdated.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4,\n            \"comment\": \"Good variety of courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.globallearnpro.com\"\n}"}
{"_id": "Academic--digital_learning--p--71475", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill tracks\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"subject\": \"Data Science\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"subject\": \"Artificial Intelligence\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science!\"\n        },\n        {\n            \"user_id\": \"456\",\n            \"rating\": 4,\n            \"comment\": \"Great interactive exercises.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--71475", "text": "{\n    \"platform_name\": \"LearnAll\",\n    \"developer\": \"EduTech Solutions\",\n    \"features\": [\n        \"Video lectures\",\n        \"Downloadable resources\",\n        \"Quizzes\",\n        \"Discussion forums\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introductory Statistics\",\n            \"subject\": \"Mathematics\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Data Analysis Basics\",\n            \"subject\": \"Data Science\",\n            \"level\": \"Beginner\"\n        }\n    ],\n    \"launch_date\": \"2018-05-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"789\",\n            \"rating\": 3,\n            \"comment\": \"Decent platform, but nothing special.\"\n        },\n        {\n            \"user_id\": \"012\",\n            \"rating\": 3,\n            \"comment\": \"The video quality could be better.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnall.edu/\"\n}"}
{"_id": "Academic--digital_learning--p--71476", "text": "{\n    \"platform_name\": \"SkillShare\",\n    \"developer\": \"Skillshare Inc.\",\n    \"features\": [\n        \"Project-based learning\",\n        \"Collaborative classes\",\n        \"Skill workshops\",\n        \"Offline access\",\n        \"Community forums\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Instructors\"\n    ],\n    \"subscription_model\": \"Freemium with premium subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Illustration Basics\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"6 weeks\"\n        }\n    ],\n    \"launch_date\": \"2010-04-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning new skills quickly and connecting with other creatives.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Lots of practical courses and a supportive community.\"\n        }\n    ],\n    \"access_url\": \"https://www.skillshare.com\"\n}"}
{"_id": "Academic--digital_learning--n--71476", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Assignments\",\n        \"Peer review\",\n        \"Quizzes\",\n        \"Certificates\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Universities\",\n        \"Instructors\"\n    ],\n    \"subscription_model\": \"Subscription or pay-per-course\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Quantum Mechanics\",\n            \"level\": \"Advanced\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Organic Chemistry\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"10 weeks\"\n        }\n    ],\n    \"launch_date\": \"2012-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4,\n            \"comment\": \"Excellent academic courses from top universities.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3,\n            \"comment\": \"Good platform for formal education but can be expensive.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org\"\n}"}
{"_id": "Academic--digital_learning--p--71477", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp BV\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium / Paid Subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"description\": \"Learn the basics of Python programming.\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Machine Learning with scikit-learn\",\n            \"description\": \"Build and deploy machine learning models using scikit-learn.\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science skills. The interactive exercises are very helpful.\"\n        },\n        {\n            \"user\": \"Bob\",\n            \"rating\": 4,\n            \"comment\": \"Good resource for beginners. The courses are well-structured.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71477", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Assignments\",\n        \"Peer reviews\",\n        \"Certificates\",\n        \"Specializations\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Lifelong Learners\"\n    ],\n    \"subscription_model\": \"Paid Subscriptions (courses & specializations)\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"description\": \"A comprehensive introduction to machine learning algorithms.\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"description\": \"A series of courses covering deep learning concepts and applications.\",\n            \"level\": \"Advanced\"\n        }\n    ],\n    \"launch_date\": \"2012-05-10\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Charlie\",\n            \"rating\": 3,\n            \"comment\": \"Good courses, but can be quite expensive.\"\n        },\n        {\n            \"user\": \"David\",\n            \"rating\": 4,\n            \"comment\": \"Great learning experience, but requires a lot of self-discipline.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org\"\n}"}
{"_id": "Academic--digital_learning--p--71478", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill tracks\",\n        \"Project-based learning\",\n        \"Career tracks\",\n        \"Assessment\",\n        \"Community forums\"\n    ],\n    \"user_types\": [\n        \"Individual learners\",\n        \"Corporate training programs\",\n        \"Data Scientists\",\n        \"Data Analysts\"\n    ],\n    \"subscription_model\": \"Freemium / Paid Subscription\",\n    \"courses_available\": [\n        {\n            \"title\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"title\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"title\": \"Cybersecurity Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"6 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.5,\n            \"comment\": \"Great platform for learning data science interactively.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4.0,\n            \"comment\": \"Very helpful for upskilling my data analysis skills.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--71478", "text": "{\n    \"platform_name\": \"LearnWorlds\",\n    \"developer\": \"LearnWorlds Inc.\",\n    \"features\": [\n        \"Course Builder\",\n        \"Interactive Video\",\n        \"Assessment Engine\",\n        \"Community\",\n        \"Marketing Tools\",\n        \"Analytics\"\n    ],\n    \"user_types\": [\n        \"Individual instructors\",\n        \"Businesses\",\n        \"Educational institutions\"\n    ],\n    \"subscription_model\": \"Paid Subscription\",\n    \"courses_available\": [\n        {\n            \"title\": \"Photography Masterclass\",\n            \"level\": \"Beginner\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"title\": \"Yoga and Mindfulness\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"title\": \"Digital Marketing Basics\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        }\n    ],\n    \"launch_date\": \"2014-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3.8,\n            \"comment\": \"Good for creating and selling online courses, but lacks depth in specific tech skills.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4.2,\n            \"comment\": \"Easy to use course builder and good support.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnworlds.com/\"\n}"}
{"_id": "Academic--digital_learning--p--71479", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Python basics\",\n                \"Data structures\",\n                \"Control flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with Scikit-learn\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Supervised learning\",\n                \"Unsupervised learning\",\n                \"Model evaluation\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Manipulation with Pandas\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Data cleaning\",\n                \"Data transformation\",\n                \"Data analysis\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science skills!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Very interactive and practical courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71479", "text": "{\n    \"platform_name\": \"Coursera Kids\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Animated lessons\",\n        \"Interactive games\",\n        \"Progress tracking\",\n        \"Parental controls\"\n    ],\n    \"user_types\": [\n        \"Children\",\n        \"Parents\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Basic Shapes\",\n            \"level\": \"Preschool\",\n            \"topics\": [\n                \"Circles\",\n                \"Squares\",\n                \"Triangles\"\n            ]\n        },\n        {\n            \"course_name\": \"Introduction to Counting\",\n            \"level\": \"Kindergarten\",\n            \"topics\": [\n                \"Numbers 1-10\",\n                \"Counting objects\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2021-03-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"parent789\",\n            \"rating\": 4,\n            \"comment\": \"My child loves the interactive games!\"\n        },\n        {\n            \"user_id\": \"parent101\",\n            \"rating\": 3,\n            \"comment\": \"Good for basic skills, but limited content.\"\n        }\n    ],\n    \"access_url\": \"https://www.courserakids.com\"\n}"}
{"_id": "Academic--digital_learning--p--71480", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill assessments\",\n        \"Project-based learning\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscription tiers\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Fundamentals\",\n                \"Data Structures\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with scikit-learn\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Regression\",\n                \"Classification\",\n                \"Clustering\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Visualization with Tableau\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Charts\",\n                \"Dashboards\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science! The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Easy to use and good content. I've been able to build a strong portfolio.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
