{"_id": "Academic--digital_learning--p--70576", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill tracks\",\n        \"Career paths\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-02-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"DataCamp is a fantastic platform for learning data science. The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"I found the skill tracks to be very well-structured and effective.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--70576", "text": "{\n    \"platform_name\": \"LearnVerse\",\n    \"developer\": \"EduTech Solutions Inc.\",\n    \"features\": [\n        \"Pre-recorded video lectures\",\n        \"Downloadable course materials\",\n        \"Quizzes\",\n        \"Discussion forums\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Basic Statistics\",\n            \"level\": \"Beginner\",\n            \"duration\": \"3 weeks\"\n        },\n        {\n            \"course_name\": \"Web Development 101\",\n            \"level\": \"Beginner\",\n            \"duration\": \"5 weeks\"\n        },\n        {\n            \"course_name\": \"Introduction to History\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        }\n    ],\n    \"launch_date\": \"2019-12-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"The course materials are good, but the platform is a bit outdated.\"\n        },\n        {\n            \"user_id\": \"user101\",\n            \"rating\": 2,\n            \"comment\": \"The discussion forums are not very active.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnverse.edu/\"\n}"}
{"_id": "Academic--digital_learning--p--70577", "text": "{\n    \"platform_name\": \"Codecademy Pro\",\n    \"developer\": \"Codecademy\",\n    \"features\": [\n        \"Interactive coding lessons\",\n        \"Project-based learning\",\n        \"Code editor in browser\",\n        \"Career paths\",\n        \"Skill assessments\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Paid subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Learn Python 3\",\n            \"category\": \"STEM\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Data Science Path\",\n            \"category\": \"STEM\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Web Development Fundamentals\",\n            \"category\": \"STEM\",\n            \"level\": \"Beginner\"\n        }\n    ],\n    \"launch_date\": \"2011-02-14\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning to code!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good course selection and well-structured lessons.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com/pro\"\n}"}
{"_id": "Academic--digital_learning--n--70577", "text": "{\n    \"platform_name\": \"HistoryHub\",\n    \"developer\": \"Historical Society Inc.\",\n    \"features\": [\n        \"Historical document archive\",\n        \"Interactive timelines\",\n        \"Expert articles\",\n        \"Discussion forums\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Researchers\",\n        \"History Enthusiasts\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Ancient Civilizations\",\n            \"category\": \"History\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"World War II\",\n            \"category\": \"History\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2021-05-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"historybuff1\",\n            \"rating\": 4,\n            \"comment\": \"A great resource for history lovers.\"\n        },\n        {\n            \"user_id\": \"student789\",\n            \"rating\": 3,\n            \"comment\": \"Useful for research, but could use more interactive elements.\"\n        }\n    ],\n    \"access_url\": \"https://www.historyhub.org\"\n}"}
{"_id": "Academic--digital_learning--p--70578", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill assessments\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"title\": \"Introduction to Python for Data Science\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"title\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science!\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
