{"_id": "Academic--digital_learning--p--71052", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscription levels\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Machine Learning with scikit-learn\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Deep Learning with TensorFlow\",\n            \"level\": \"Advanced\"\n        },\n        {\n            \"course_name\": \"Data Visualization with R\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2016-02-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science! Very interactive and practical.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good content, but the interface could be improved.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
