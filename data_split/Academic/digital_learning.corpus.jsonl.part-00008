{"_id": "Academic--digital_learning--p--70628", "text": "{\n    \"platform_name\": \"DataWise Academy\",\n    \"developer\": \"LearnTech Solutions Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Personalized learning paths\",\n        \"Project-based learning\",\n        \"Community forums\",\n        \"Certification tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Career Changers\"\n    ],\n    \"subscription_model\": \"Freemium with premium subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Science Bootcamp\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 months\",\n            \"price\": 1999\n        },\n        {\n            \"course_name\": \"Cybersecurity Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"3 months\",\n            \"price\": 999\n        }\n    ],\n    \"launch_date\": \"2021-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"This platform is incredibly easy to use and the data science course is very helpful for my career transition.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great platform! The cybersecurity course is well-structured and the instructors are knowledgeable.\"\n        },\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 5,\n            \"comment\": \"Really helpful and easy to follow. The projects are relevant to real-world scenarios.\"\n        }\n    ],\n    \"access_url\": \"https://www.datawiseacademy.com\"\n}"}
