{"_id": "Academic--digital_learning--n--71888", "text": "{\n    \"platform_name\": \"ABC Mouse\",\n    \"developer\": \"Age of Learning, Inc.\",\n    \"features\": [\n        \"Interactive games\",\n        \"Educational videos\",\n        \"Progress tracking\",\n        \"Personalized learning paths\"\n    ],\n    \"user_types\": [\n        \"Children\",\n        \"Parents\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Paid subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Reading with Milo\",\n            \"level\": \"Early Reader\",\n            \"duration\": \"Ongoing\"\n        },\n        {\n            \"course_name\": \"Math Adventures\",\n            \"level\": \"Preschool\",\n            \"duration\": \"Ongoing\"\n        }\n    ],\n    \"launch_date\": \"2018-03-10\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Carol\",\n            \"rating\": 4,\n            \"comment\": \"My child loves playing the games and learning new things!\"\n        },\n        {\n            \"user\": \"David\",\n            \"rating\": 5,\n            \"comment\": \"A great way to get kids excited about learning.\"\n        }\n    ],\n    \"access_url\": \"https://www.abcmouse.com\"\n}"}
