{"_id": "Academic--digital_learning--p--71901", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium/Paid Subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"course_level\": \"Beginner\",\n            \"course_topics\": [\n                \"Python basics\",\n                \"Data types\",\n                \"Control flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"course_level\": \"Intermediate\",\n            \"course_topics\": [\n                \"R programming\",\n                \"Data visualization\",\n                \"Statistical modeling\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"course_level\": \"Intermediate\",\n            \"course_topics\": [\n                \"Supervised learning\",\n                \"Unsupervised learning\",\n                \"Model evaluation\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.5,\n            \"comment\": \"Great platform for learning data science. The interactive exercises are really helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4.0,\n            \"comment\": \"Good content and well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--71901", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Assignments\",\n        \"Peer reviews\",\n        \"Certificates\",\n        \"Specializations\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Lifelong learners\"\n    ],\n    \"subscription_model\": \"Paid Subscription/Individual Course Purchase\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"course_level\": \"Intermediate\",\n            \"course_topics\": [\n                \"Regression\",\n                \"Classification\",\n                \"Clustering\"\n            ]\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"course_level\": \"Advanced\",\n            \"course_topics\": [\n                \"Neural networks\",\n                \"Convolutional neural networks\",\n                \"Recurrent neural networks\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2012-05-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3.8,\n            \"comment\": \"Good variety of courses, but can be expensive.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4.2,\n            \"comment\": \"High-quality content from top universities.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org/\"\n}"}
