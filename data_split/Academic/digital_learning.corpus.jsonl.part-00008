{"_id": "Academic--digital_learning--n--70498", "text": "{\n    \"platform_name\": \"LearnSwift\",\n    \"developer\": \"Swift Development Group\",\n    \"features\": [\n        \"Video tutorials\",\n        \"Coding challenges\",\n        \"Community forum\",\n        \"Project ideas\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Developers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Swift Programming Basics\",\n            \"subject\": \"Software Development\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"iOS App Development\",\n            \"subject\": \"Software Development\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2021-05-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Good for learning Swift, but the interface could be better.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"Some outdated information in the courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnswift.io\"\n}"}
{"_id": "Academic--digital_learning--p--70499", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill assessments\",\n        \"Project-based learning\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"difficulty\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"difficulty\": \"Advanced\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Interactive exercises are very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
