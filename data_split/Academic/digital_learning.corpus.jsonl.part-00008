{"_id": "Academic--digital_learning--n--70829", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Assignments\",\n        \"Peer assessment\",\n        \"Certificates\",\n        \"Specializations\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professional Learners\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"difficulty\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"difficulty\": \"Advanced\",\n            \"duration\": \"6 months\"\n        }\n    ],\n    \"launch_date\": \"2012-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3.8,\n            \"comment\": \"Good course content but the platform can be a bit clunky at times.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4.2,\n            \"comment\": \"High-quality courses, but the user interface isn't the most intuitive.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org\"\n}"}
