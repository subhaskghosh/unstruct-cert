{"_id": "Academic--digital_learning--n--70915", "text": "{\n    \"platform_name\": \"HistoryOnline\",\n    \"developer\": \"Historical Society Inc.\",\n    \"features\": [\n        \"Video Lectures\",\n        \"Historical Documents\",\n        \"Discussion Forums\",\n        \"Quizzes\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Researchers\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Ancient Roman History\",\n            \"duration\": \"40 hours\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"The Renaissance\",\n            \"duration\": \"30 hours\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2022-01-20\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Jane Smith\",\n            \"rating\": 4,\n            \"comment\": \"A good resource for history buffs, but could use more interactive elements.\"\n        }\n    ],\n    \"access_url\": \"https://www.historyonline.org\"\n}"}
