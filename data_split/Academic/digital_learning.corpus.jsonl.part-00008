{"_id": "Academic--digital_learning--n--71046", "text": "{\n    \"platform_name\": \"EduGlobal\",\n    \"developer\": \"Global Learning Solutions\",\n    \"features\": [\n        \"Live Online Classes\",\n        \"Downloadable Resources\",\n        \"Expert Instructors\",\n        \"Certificate Programs\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Researchers\"\n    ],\n    \"subscription_model\": \"Paid Subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Advanced Calculus\",\n            \"level\": \"Advanced\",\n            \"duration\": \"14 weeks\"\n        },\n        {\n            \"course_name\": \"Organic Chemistry\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"16 weeks\"\n        }\n    ],\n    \"launch_date\": \"2022-03-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3.0,\n            \"comment\": \"Good resource, but could be more engaging.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3.5,\n            \"comment\": \"Helpful for exam preparation.\"\n        }\n    ],\n    \"access_url\": \"https://www.eduglobal.org\"\n}"}
{"_id": "Academic--digital_learning--p--71047", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Skill tracks\",\n        \"Career tracks\",\n        \"Project portfolio\",\n        \"Live workshops\"\n    ],\n    \"user_types\": [\n        \"Individual learners\",\n        \"Businesses\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2013-12-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science hands-on!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great interactive exercises and well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71047", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Quizzes\",\n        \"Peer assignments\",\n        \"Discussion forums\",\n        \"Certificates\"\n    ],\n    \"user_types\": [\n        \"Individual learners\",\n        \"Universities\",\n        \"Businesses\"\n    ],\n    \"subscription_model\": \"Paid subscriptions, course-by-course purchase\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"level\": \"Beginner\",\n            \"duration\": \"11 weeks\"\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"5 courses\"\n        },\n        {\n            \"course_name\": \"Data Science Methodology\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2012-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4,\n            \"comment\": \"Good quality courses, but can be a bit passive.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3,\n            \"comment\": \"Mostly video lectures, not much hands-on practice.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org\"\n}"}
{"_id": "Academic--digital_learning--p--71048", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Python syntax\",\n                \"Data structures\",\n                \"Functions\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Machine Learning\",\n                \"Statistical Modeling\",\n                \"Data Visualization\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.5,\n            \"comment\": \"Great platform for learning data science!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4.0,\n            \"comment\": \"Interactive exercises are very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71048", "text": "{\n    \"platform_name\": \"LearnChemE\",\n    \"developer\": \"LearnChemE, Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Practice problems\",\n        \"Simulation tools\",\n        \"Course materials\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Chemical Engineers\"\n    ],\n    \"subscription_model\": \"Paid - Tiered\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Chemical Engineering Thermodynamics\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Thermodynamic properties\",\n                \"Phase equilibrium\",\n                \"Chemical reactions\"\n            ]\n        },\n        {\n            \"course_name\": \"Process Control\",\n            \"level\": \"Advanced\",\n            \"topics\": [\n                \"PID control\",\n                \"System identification\",\n                \"Process dynamics\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2014-11-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4.2,\n            \"comment\": \"Excellent resource for chemical engineering students.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3.8,\n            \"comment\": \"Helpful simulations.\"\n        }\n    ],\n    \"access_url\": \"https://learncheme.com\"\n}"}
{"_id": "Academic--digital_learning--p--71049", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill assessments\",\n        \"Project-based learning\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscription tiers\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Python fundamentals\",\n                \"Data types\",\n                \"Control flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with scikit-learn\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Supervised learning\",\n                \"Unsupervised learning\",\n                \"Model evaluation\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"difficulty\": \"Advanced\",\n            \"topics\": [\n                \"Statistics\",\n                \"Probability\",\n                \"Data Visualization\",\n                \"Machine Learning\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-01-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.5,\n            \"comment\": \"Great platform for learning data science skills. Interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4.0,\n            \"comment\": \"Well-structured courses and a good community forum.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71049", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lectures\",\n        \"Practice exercises\",\n        \"Progress tracking\",\n        \"Personalized learning\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\",\n        \"Parents\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Calculus 1\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Limits\",\n                \"Derivatives\",\n                \"Integrals\"\n            ]\n        },\n        {\n            \"course_name\": \"Linear Algebra\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Vectors\",\n                \"Matrices\",\n                \"Eigenvalues\"\n            ]\n        },\n        {\n            \"course_name\": \"Statistics and Probability\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Descriptive statistics\",\n                \"Probability distributions\",\n                \"Hypothesis testing\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4.8,\n            \"comment\": \"Excellent resource for students of all ages. The videos are clear and concise.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4.2,\n            \"comment\": \"Helped me understand math concepts that I struggled with in school.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
