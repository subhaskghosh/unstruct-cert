{"_id": "Academic--digital_learning--n--71890", "text": "{\n    \"platform_name\": \"EduWorld Pro\",\n    \"developer\": \"Global Education Inc.\",\n    \"features\": [\n        \"Live Classes\",\n        \"Assignments\",\n        \"Gradebook\",\n        \"Resource Library\"\n    ],\n    \"user_types\": [\n        \"K-12 Students\",\n        \"Teachers\",\n        \"School Administrators\"\n    ],\n    \"subscription_model\": \"Paid Subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Algebra I\",\n            \"instructor\": \"Sarah Johnson\",\n            \"duration\": \"1 semester\"\n        },\n        {\n            \"course_name\": \"World History\",\n            \"instructor\": \"Michael Brown\",\n            \"duration\": \"1 year\"\n        }\n    ],\n    \"launch_date\": \"2016-09-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Decent platform, but a bit complex for younger students.\"\n        },\n        {\n            \"user_id\": \"user101\",\n            \"rating\": 4,\n            \"comment\": \"Good resource for teachers, but the annual subscription is quite expensive at $500.\"\n        }\n    ],\n    \"access_url\": \"https://www.eduworldpro.org\"\n}"}
