{"_id": "Academic--digital_learning--p--70786", "text": "{\n    \"platform_name\": \"LearnZenith\",\n    \"developer\": \"InnovateEd Solutions\",\n    \"features\": [\n        \"Interactive Video Lessons\",\n        \"Personalized Learning Paths\",\n        \"Progress Tracking\",\n        \"Gamified Quizzes\",\n        \"Collaborative Projects\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Administrators\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python Programming\",\n            \"level\": \"Beginner\",\n            \"instructor\": \"Dr. Anya Sharma\",\n            \"rating\": 4.8\n        },\n        {\n            \"course_name\": \"Advanced Calculus\",\n            \"level\": \"Advanced\",\n            \"instructor\": \"Professor Ben Carter\",\n            \"rating\": 4.5\n        }\n    ],\n    \"launch_date\": \"2022-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"This platform is incredibly engaging! The interactive lessons make learning fun.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great resource for both students and teachers. Very intuitive interface.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnzenith.com\"\n}"}
{"_id": "Academic--digital_learning--n--70786", "text": "{\n    \"platform_name\": \"EduCore\",\n    \"developer\": \"Traditional Learning Inc.\",\n    \"features\": [\n        \"Static Text-Based Lessons\",\n        \"Basic Assessments\",\n        \"Gradebook\",\n        \"Forum Discussions\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Paid - Tiered\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Basic Algebra\",\n            \"level\": \"Beginner\",\n            \"instructor\": \"Mr. David Lee\",\n            \"rating\": 3.5\n        },\n        {\n            \"course_name\": \"World History\",\n            \"level\": \"Intermediate\",\n            \"instructor\": \"Ms. Sarah Johnson\",\n            \"rating\": 3.2\n        }\n    ],\n    \"launch_date\": \"2021-11-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"A decent platform, but a bit outdated. Lessons are rather dry.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"The interface feels clunky and not very user-friendly.\"\n        }\n    ],\n    \"access_url\": \"https://www.educore.org\"\n}"}
{"_id": "Academic--digital_learning--p--70787", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp, Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"category\": \"Data Science\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Data Visualization with R\",\n            \"category\": \"Data Science\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"category\": \"Technology\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science! Very user-friendly and the interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great content, easy to follow. Highly recommended.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70787", "text": "{\n    \"platform_name\": \"LearnWorlds\",\n    \"developer\": \"LearnWorlds\",\n    \"features\": [\n        \"Course creation tools\",\n        \"Video hosting\",\n        \"Interactive videos\",\n        \"Community features\",\n        \"Marketing integrations\"\n    ],\n    \"user_types\": [\n        \"Educators\",\n        \"Subject Matter Experts\",\n        \"Entrepreneurs\"\n    ],\n    \"subscription_model\": \"Paid Plans\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Digital Marketing Mastery\",\n            \"category\": \"Marketing\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Creative Writing Workshop\",\n            \"category\": \"Arts\",\n            \"level\": \"Beginner\"\n        }\n    ],\n    \"launch_date\": \"2014-05-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4,\n            \"comment\": \"Powerful platform, but requires some technical knowledge to set up.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3,\n            \"comment\": \"Good for creating courses, but the interface can be a bit clunky.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnworlds.com\"\n}"}
