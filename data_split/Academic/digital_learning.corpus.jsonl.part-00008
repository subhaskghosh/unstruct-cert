{"_id": "Academic--digital_learning--p--71123", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp, Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill assessments\",\n        \"Project-based learning\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Python fundamentals\",\n                \"Data manipulation\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with Scikit-learn\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Regression\",\n                \"Classification\",\n                \"Clustering\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science skills. Very practical and hands-on.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good content, well-structured courses. Freemium option is great to get started.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
