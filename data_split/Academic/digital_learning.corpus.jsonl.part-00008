{"_id": "Academic--digital_learning--n--71291", "text": "{\n    \"platform_name\": \"LearnArt\",\n    \"developer\": \"Creative Studios Inc.\",\n    \"features\": [\n        \"Video tutorials\",\n        \"Downloadable resources\",\n        \"Artist profiles\",\n        \"Community gallery\",\n        \"Live workshops\"\n    ],\n    \"user_types\": [\n        \"Art Students\",\n        \"Hobbyists\",\n        \"Art Teachers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Digital Painting Fundamentals\",\n            \"difficulty\": \"Beginner\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Sculpting with Clay\",\n            \"difficulty\": \"Intermediate\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"Art History 101\",\n            \"difficulty\": \"Beginner\",\n            \"duration\": \"6 weeks\"\n        }\n    ],\n    \"launch_date\": \"2018-05-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"artist1\",\n            \"rating\": 4,\n            \"comment\": \"Great for learning new techniques, but the website is a bit slow.\"\n        },\n        {\n            \"user_id\": \"artist2\",\n            \"rating\": 3,\n            \"comment\": \"The course content is good, but the instructors are not very responsive.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnart.com\"\n}"}
{"_id": "Academic--digital_learning--p--71292", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Students\",\n        \"Researchers\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"subject\": \"Programming\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"subject\": \"Machine Learning\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"subject\": \"Data Science\"\n        }\n    ],\n    \"launch_date\": \"2016-01-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"John Doe\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science. Very easy to use and well-structured courses.\"\n        },\n        {\n            \"user\": \"Jane Smith\",\n            \"rating\": 4,\n            \"comment\": \"Great for brushing up on skills and learning new technologies.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--71292", "text": "{\n    \"platform_name\": \"ABCmouse\",\n    \"developer\": \"Age of Learning, Inc.\",\n    \"features\": [\n        \"Interactive games\",\n        \"Educational videos\",\n        \"Progress tracking\",\n        \"Parent dashboard\"\n    ],\n    \"user_types\": [\n        \"Preschoolers\",\n        \"Kindergarteners\",\n        \"Early Elementary Students\",\n        \"Parents\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Reading Readiness\",\n            \"level\": \"Beginner\",\n            \"subject\": \"Literacy\"\n        },\n        {\n            \"course_name\": \"Math Basics\",\n            \"level\": \"Beginner\",\n            \"subject\": \"Mathematics\"\n        }\n    ],\n    \"launch_date\": \"2010-09-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Parent123\",\n            \"rating\": 4,\n            \"comment\": \"My child loves using ABCmouse! It's a great way to make learning fun.\"\n        },\n        {\n            \"user\": \"Teacher456\",\n            \"rating\": 3,\n            \"comment\": \"Useful for reinforcing basic concepts.\"\n        }\n    ],\n    \"access_url\": \"https://www.abcmouse.com/\"\n}"}
