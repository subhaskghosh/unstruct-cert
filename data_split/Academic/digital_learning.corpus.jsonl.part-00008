{"_id": "Academic--digital_learning--p--71809", "text": "{\n    \"platform_name\": \"SkillSpark\",\n    \"developer\": \"LearnTech Solutions Inc.\",\n    \"features\": [\n        \"Interactive Coding Exercises\",\n        \"Project-Based Learning\",\n        \"Personalized Learning Paths\",\n        \"Progress Tracking\",\n        \"Community Forums\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Python for Data Science\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Web Development Bootcamp\",\n            \"level\": \"Beginner\",\n            \"duration\": \"16 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"SkillSpark significantly improved my coding skills. The projects are very practical!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great platform for learning new skills quickly.\"\n        }\n    ],\n    \"access_url\": \"https://www.skillspark.com\"\n}"}
{"_id": "Academic--digital_learning--n--71809", "text": "{\n    \"platform_name\": \"EduTheory\",\n    \"developer\": \"Academic Publishers Ltd.\",\n    \"features\": [\n        \"Video Lectures\",\n        \"Reading Materials\",\n        \"Quizzes\",\n        \"Discussion Boards\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Researchers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Advanced Calculus\",\n            \"level\": \"Advanced\",\n            \"duration\": \"14 weeks\"\n        },\n        {\n            \"course_name\": \"Theoretical Physics\",\n            \"level\": \"Graduate\",\n            \"duration\": \"16 weeks\"\n        }\n    ],\n    \"launch_date\": \"2022-03-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Good resource for understanding complex theoretical concepts.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"A bit too abstract for practical application.\"\n        }\n    ],\n    \"access_url\": \"https://www.edutheory.org\"\n}"}
{"_id": "Academic--digital_learning--p--71810", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill tracks\",\n        \"Project portfolio\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"topic\": \"Programming\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"topic\": \"Data Science\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Data Visualization with Tableau\",\n            \"topic\": \"Data Science\",\n            \"level\": \"Beginner\"\n        }\n    ],\n    \"launch_date\": \"2016-01-01\",\n    \"user_feedback\": [\n        {\n            \"user_type\": \"Student\",\n            \"rating\": 4.5,\n            \"comment\": \"Great for learning data science fundamentals!\"\n        },\n        {\n            \"user_type\": \"Professional\",\n            \"rating\": 4.0,\n            \"comment\": \"Helped me upskill quickly.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
