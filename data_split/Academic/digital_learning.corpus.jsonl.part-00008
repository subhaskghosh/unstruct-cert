{"_id": "Academic--digital_learning--p--71447", "text": "{\n    \"platform_name\": \"Codecademy Pro\",\n    \"developer\": \"Codecademy\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Project-based learning\",\n        \"Real-world projects\",\n        \"Code review\",\n        \"Career paths\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"subject\": \"Computer Science\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Data Science Bootcamp\",\n            \"subject\": \"Data Science\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Web Development Fundamentals\",\n            \"subject\": \"Computer Science\",\n            \"level\": \"Beginner\"\n        }\n    ],\n    \"launch_date\": \"2011-08-04\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning to code! Very interactive and well-structured.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great resources and helpful community.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com/\"\n}"}
{"_id": "Academic--digital_learning--n--71447", "text": "{\n    \"platform_name\": \"HistoryOnline\",\n    \"developer\": \"Academic Archives Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Primary source documents\",\n        \"Discussion forums\",\n        \"Expert Q&A\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Researchers\",\n        \"Lifelong Learners\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Ancient Roman History\",\n            \"subject\": \"History\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Medieval European History\",\n            \"subject\": \"History\",\n            \"level\": \"Advanced\"\n        },\n        {\n            \"course_name\": \"American Civil War\",\n            \"subject\": \"History\",\n            \"level\": \"Beginner\"\n        }\n    ],\n    \"launch_date\": \"2018-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Good content, but the website is a bit outdated.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4,\n            \"comment\": \"Very detailed lectures and helpful primary sources.\"\n        }\n    ],\n    \"access_url\": \"https://www.historyonline.edu/\"\n}"}
{"_id": "Academic--digital_learning--p--71448", "text": "{\n    \"platform_name\": \"DataLearn Pro\",\n    \"developer\": \"InnovateEd Solutions\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Personalized learning paths\",\n        \"Project-based assignments\",\n        \"Community forums\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium with paid tiers\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Data Science\",\n            \"level\": \"Beginner\",\n            \"duration\": \"12 weeks\",\n            \"price\": 29.99\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"16 weeks\",\n            \"price\": 49.99\n        }\n    ],\n    \"launch_date\": \"2021-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.8,\n            \"comment\": \"Excellent platform with engaging content! The instructors are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4.5,\n            \"comment\": \"I learned a lot from this platform. The projects were challenging and rewarding.\"\n        }\n    ],\n    \"access_url\": \"https://www.datalearnpro.com\"\n}"}
{"_id": "Academic--digital_learning--n--71448", "text": "{\n    \"platform_name\": \"TradeSkills Online\",\n    \"developer\": \"Vocational Training Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Downloadable resources\",\n        \"Assessment quizzes\",\n        \"Certification preparation\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Trade Professionals\"\n    ],\n    \"subscription_model\": \"Paid subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Welding Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\",\n            \"price\": 39.99\n        },\n        {\n            \"course_name\": \"HVAC Technician Certification\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\",\n            \"price\": 59.99\n        }\n    ],\n    \"launch_date\": \"2022-05-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4.2,\n            \"comment\": \"Good platform for learning practical skills.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3.8,\n            \"comment\": \"The courses are well-structured and easy to follow.\"\n        }\n    ],\n    \"access_url\": \"https://www.tradeskills.com\"\n}"}
{"_id": "Academic--digital_learning--p--71449", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"category\": \"Data Science\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"category\": \"Artificial Intelligence\"\n        }\n    ],\n    \"launch_date\": \"2016-01-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science skills.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Interactive exercises are very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71449", "text": "{\n    \"platform_name\": \"ExamPrepPro\",\n    \"developer\": \"TestMasters Inc.\",\n    \"features\": [\n        \"Practice exams\",\n        \"Progress tracking\",\n        \"Personalized study plans\",\n        \"Detailed answer explanations\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Test Takers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"SAT Preparation\",\n            \"level\": \"All Levels\",\n            \"category\": \"Test Preparation\"\n        },\n        {\n            \"course_name\": \"GRE Quantitative Reasoning\",\n            \"level\": \"Intermediate\",\n            \"category\": \"Test Preparation\"\n        }\n    ],\n    \"launch_date\": \"2021-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4,\n            \"comment\": \"Good for practicing exam questions.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3,\n            \"comment\": \"Helpful but can be repetitive.\"\n        }\n    ],\n    \"access_url\": \"https://www.exampreppro.com\"\n}"}
{"_id": "Academic--digital_learning--p--71450", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Career tracks\",\n        \"Project portfolio\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\",\n        \"Business Professionals\"\n    ],\n    \"subscription_model\": \"Freemium (with paid tiers)\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Python Syntax\",\n                \"Data Types\",\n                \"Control Flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Regression\",\n                \"Classification\",\n                \"Clustering\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"difficulty\": \"Advanced\",\n            \"topics\": [\n                \"Data Wrangling\",\n                \"Data Visualization\",\n                \"Statistical Modeling\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.5,\n            \"comment\": \"Great platform for learning data science skills!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4.0,\n            \"comment\": \"Interactive exercises are very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71450", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lessons\",\n        \"Practice exercises\",\n        \"Personalized learning\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"K-12 Students\",\n        \"Teachers\",\n        \"Parents\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Algebra I\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Linear Equations\",\n                \"Quadratic Equations\",\n                \"Polynomials\"\n            ]\n        },\n        {\n            \"course_name\": \"Calculus AB\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Limits\",\n                \"Derivatives\",\n                \"Integrals\"\n            ]\n        },\n        {\n            \"course_name\": \"Statistics and Probability\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Data Analysis\",\n                \"Probability Distributions\",\n                \"Hypothesis Testing\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4.8,\n            \"comment\": \"Excellent resource for students!\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4.2,\n            \"comment\": \"Helped me understand algebra concepts.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
{"_id": "Academic--digital_learning--p--71451", "text": "{\n    \"platform_name\": \"SkillForge\",\n    \"developer\": \"InnovateEd Tech\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Project-based learning\",\n        \"Personalized learning paths\",\n        \"Community forums\",\n        \"Career guidance resources\"\n    ],\n    \"user_types\": [\n        \"Professionals\",\n        \"Students\",\n        \"Career changers\"\n    ],\n    \"subscription_model\": \"Freemium with premium plans starting at $39/month\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Science Bootcamp\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\",\n            \"description\": \"A comprehensive bootcamp covering data analysis, machine learning, and data visualization.\"\n        },\n        {\n            \"course_name\": \"Full Stack Web Development\",\n            \"level\": \"Beginner\",\n            \"duration\": \"16 weeks\",\n            \"description\": \"Learn to build modern web applications with React, Node.js, and MongoDB.\"\n        }\n    ],\n    \"launch_date\": \"2021-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"SkillForge helped me land a job as a data scientist! The practical projects were invaluable.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great platform for upskilling. The instructors are knowledgeable and the community is supportive.\"\n        }\n    ],\n    \"access_url\": \"https://www.skillforge.com\"\n}"}
{"_id": "Academic--digital_learning--n--71451", "text": "{\n    \"platform_name\": \"EduClassic\",\n    \"developer\": \"OldSchool Learning Inc.\",\n    \"features\": [\n        \"Pre-recorded video lectures\",\n        \"Downloadable course materials\",\n        \"Basic quizzes\",\n        \"Discussion boards\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Lifelong learners\"\n    ],\n    \"subscription_model\": \"Paid, $49.99/month\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to History\",\n            \"level\": \"Beginner\",\n            \"duration\": \"10 weeks\",\n            \"description\": \"A survey of world history from ancient times to the present.\"\n        },\n        {\n            \"course_name\": \"Classical Literature\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\",\n            \"description\": \"An exploration of the great works of classical literature.\"\n        }\n    ],\n    \"launch_date\": \"2018-11-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"The lectures are informative, but the platform feels outdated.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"Difficult to navigate and the quizzes are too easy.\"\n        }\n    ],\n    \"access_url\": \"https://www.educlassic.org\"\n}"}
