{"_id": "Academic--digital_learning--n--70497", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Assignments\",\n        \"Peer assessments\",\n        \"Discussion forums\",\n        \"Certificates\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Lifelong learners\"\n    ],\n    \"subscription_model\": \"Paid (Course-by-course or subscription)\",\n    \"courses_available\": [\n        {\n            \"title\": \"Machine Learning\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"title\": \"Deep Learning Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"5 courses\"\n        },\n        {\n            \"title\": \"Python for Everybody Specialization\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 courses\"\n        }\n    ],\n    \"launch_date\": \"2012-05-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice Brown\",\n            \"rating\": 4,\n            \"comment\": \"Good quality courses from reputable universities.\"\n        },\n        {\n            \"user\": \"Bob White\",\n            \"rating\": 3,\n            \"comment\": \"Some courses can be quite theoretical.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org\"\n}"}
