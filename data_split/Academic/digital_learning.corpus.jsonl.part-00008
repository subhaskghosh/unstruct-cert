{"_id": "Academic--digital_learning--p--70833", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Python Syntax\",\n                \"Data Structures\",\n                \"Control Flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with Scikit-learn\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Supervised Learning\",\n                \"Unsupervised Learning\",\n                \"Model Evaluation\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"difficulty\": \"Advanced\",\n            \"topics\": [\n                \"Data Mining\",\n                \"Statistical Modeling\",\n                \"Data Visualization\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-03-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science skills!\"\n        },\n        {\n            \"user_id\": \"456\",\n            \"rating\": 4.8,\n            \"comment\": \"Very engaging and practical courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70833", "text": "{\n    \"platform_name\": \"LearnAI\",\n    \"developer\": \"AI Education Inc.\",\n    \"features\": [\n        \"Video tutorials\",\n        \"Discussion forums\",\n        \"Coding challenges\",\n        \"Personalized learning paths\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Researchers\",\n        \"Engineers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Deep Learning Fundamentals\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Neural Networks\",\n                \"Convolutional Networks\",\n                \"Recurrent Networks\"\n            ]\n        },\n        {\n            \"course_name\": \"Natural Language Processing\",\n            \"difficulty\": \"Advanced\",\n            \"topics\": [\n                \"Text Mining\",\n                \"Sentiment Analysis\",\n                \"Machine Translation\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2022-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"789\",\n            \"rating\": 4.0,\n            \"comment\": \"Good content, but a bit pricey.\"\n        },\n        {\n            \"user_id\": \"101\",\n            \"rating\": 3.5,\n            \"comment\": \"Could use more interactive exercises.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnai.org\"\n}"}
{"_id": "Academic--digital_learning--p--70834", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill tracks\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science! The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good content and well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70834", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Assignments\",\n        \"Peer-graded assignments\",\n        \"Quizzes\",\n        \"Certificates\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Lifelong Learners\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Individual course purchase or subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"5 courses\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"4 courses\"\n        }\n    ],\n    \"launch_date\": \"2012-05-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4,\n            \"comment\": \"Good overall platform, but some courses are quite expensive.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3,\n            \"comment\": \"Assignments can be time-consuming.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org\"\n}"}
{"_id": "Academic--digital_learning--p--70835", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"title\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Python basics\",\n                \"Data types\",\n                \"Control flow\"\n            ]\n        },\n        {\n            \"title\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Regression\",\n                \"Classification\",\n                \"Clustering\"\n            ]\n        },\n        {\n            \"title\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"topics\": [\n                \"Data mining\",\n                \"Statistical modeling\",\n                \"Big data\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"John Doe\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science!\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
