{"_id": "Academic--digital_learning--n--71161", "text": "{\n    \"platform_name\": \"KidLearn Academy\",\n    \"developer\": \"Bright Future Education\",\n    \"features\": [\n        \"Animated lessons\",\n        \"Gamified learning\",\n        \"Interactive quizzes\",\n        \"Parental control features\"\n    ],\n    \"user_types\": [\n        \"Children\",\n        \"Teachers\",\n        \"Parents\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Math Basics for Kids\",\n            \"level\": \"Elementary\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Reading Comprehension\",\n            \"level\": \"Primary\",\n            \"duration\": \"6 weeks\"\n        }\n    ],\n    \"launch_date\": \"2022-03-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"parent789\",\n            \"rating\": 4.8,\n            \"comment\": \"My child loves this platform!\"\n        },\n        {\n            \"user_id\": \"teacher101\",\n            \"rating\": 4.6,\n            \"comment\": \"Great tool for supplementing classroom learning.\"\n        }\n    ],\n    \"access_url\": \"https://www.kidlearnacademy.com\"\n}"}
{"_id": "Academic--digital_learning--p--71162", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill assessments\",\n        \"Career tracks\",\n        \"Project portfolio\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium with paid tiers\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.5,\n            \"comment\": \"Excellent platform for learning data science!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4.2,\n            \"comment\": \"Very interactive and practical courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71162", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lessons\",\n        \"Practice exercises\",\n        \"Progress tracking\",\n        \"Personalized learning\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\",\n        \"Parents\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Algebra I\",\n            \"level\": \"Beginner\",\n            \"duration\": \"Self-paced\"\n        },\n        {\n            \"course_name\": \"Calculus\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"Self-paced\"\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4.7,\n            \"comment\": \"Great resource for K-12 education!\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4.3,\n            \"comment\": \"Helped me understand math concepts better.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
{"_id": "Academic--digital_learning--p--71163", "text": "{\n    \"platform_name\": \"SkillUp Academy\",\n    \"developer\": \"TechForward Solutions\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Project-based learning\",\n        \"Personalized learning paths\",\n        \"Community forums\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Professionals\",\n        \"Career changers\",\n        \"Lifelong learners\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Python for Data Science\",\n            \"duration\": \"12 weeks\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Digital Marketing Fundamentals\",\n            \"duration\": \"8 weeks\",\n            \"level\": \"Beginner\"\n        }\n    ],\n    \"launch_date\": \"2021-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"This platform significantly improved my data analysis skills. The projects were very practical and relevant to my work.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great platform for learning new skills. The interactive exercises are engaging.\"\n        }\n    ],\n    \"access_url\": \"https://www.skillupacademy.com\"\n}"}
{"_id": "Academic--digital_learning--n--71163", "text": "{\n    \"platform_name\": \"EduWorld\",\n    \"developer\": \"LearnWise Inc.\",\n    \"features\": [\n        \"Live classes\",\n        \"Homework assignments\",\n        \"Parent-teacher communication\",\n        \"Standardized test preparation\",\n        \"Gradebook\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\",\n        \"Parents\"\n    ],\n    \"subscription_model\": \"Paid - Tiered\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"8th Grade Math\",\n            \"duration\": \"Full year\",\n            \"level\": \"Middle School\"\n        },\n        {\n            \"course_name\": \"High School Biology\",\n            \"duration\": \"Full year\",\n            \"level\": \"High School\"\n        }\n    ],\n    \"launch_date\": \"2022-09-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"parent789\",\n            \"rating\": 4,\n            \"comment\": \"Excellent resource for my child's education. The teachers are very dedicated.\"\n        },\n        {\n            \"user_id\": \"student101\",\n            \"rating\": 3,\n            \"comment\": \"It's a good platform but can be a bit repetitive.\"\n        }\n    ],\n    \"access_url\": \"https://www.eduworld.net\"\n}"}
{"_id": "Academic--digital_learning--p--71164", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Very practical and hands-on.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
