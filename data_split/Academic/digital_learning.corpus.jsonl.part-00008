{"_id": "Academic--digital_learning--n--70446", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Reading materials\",\n        \"Quizzes\",\n        \"Peer assessments\",\n        \"Course certificates\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Lifelong learners\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Supervised learning\",\n                \"Unsupervised learning\",\n                \"Neural networks\"\n            ]\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"difficulty\": \"Advanced\",\n            \"topics\": [\n                \"Convolutional neural networks\",\n                \"Recurrent neural networks\",\n                \"TensorFlow\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2012-05-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good courses, but can be expensive. Lots of theoretical content.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org/\"\n}"}
