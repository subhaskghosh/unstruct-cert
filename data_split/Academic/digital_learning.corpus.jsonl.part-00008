{"_id": "Academic--digital_learning--p--70508", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill tracks\",\n        \"Projects\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Python Syntax\",\n                \"Data Structures\",\n                \"Control Flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with scikit-learn\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Supervised Learning\",\n                \"Unsupervised Learning\",\n                \"Model Evaluation\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Manipulation with pandas\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Data Cleaning\",\n                \"Data Transformation\",\n                \"Data Aggregation\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science skills.\"\n        },\n        {\n            \"user_id\": \"456\",\n            \"rating\": 4,\n            \"comment\": \"Interactive exercises are very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70508", "text": "{\n    \"platform_name\": \"Codecademy\",\n    \"developer\": \"Codecademy, Inc.\",\n    \"features\": [\n        \"Interactive lessons\",\n        \"Project-based learning\",\n        \"Career paths\",\n        \"Certifications\"\n    ],\n    \"user_types\": [\n        \"Beginners\",\n        \"Students\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to HTML\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"HTML Tags\",\n                \"HTML Attributes\",\n                \"HTML Structure\"\n            ]\n        },\n        {\n            \"course_name\": \"JavaScript Fundamentals\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Variables\",\n                \"Data Types\",\n                \"Functions\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Regression\",\n                \"Classification\",\n                \"Clustering\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2011-08-22\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"789\",\n            \"rating\": 3,\n            \"comment\": \"Good for basic concepts, but lacks depth.\"\n        },\n        {\n            \"user_id\": \"101\",\n            \"rating\": 4,\n            \"comment\": \"Helpful for getting started with coding.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com\"\n}"}
{"_id": "Academic--digital_learning--p--70509", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lessons\",\n        \"Skill tracks\",\n        \"Career tracks\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science!\"\n        },\n        {\n            \"user_id\": \"456\",\n            \"rating\": 4,\n            \"comment\": \"Interactive exercises are very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70509", "text": "{\n    \"platform_name\": \"Codecademy\",\n    \"developer\": \"Codecademy, Inc.\",\n    \"features\": [\n        \"Interactive lessons\",\n        \"Project-based learning\",\n        \"Career paths\",\n        \"Code editor\"\n    ],\n    \"user_types\": [\n        \"Beginner Coders\",\n        \"Web Developers\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Learn HTML\",\n            \"level\": \"Beginner\",\n            \"duration\": \"2 weeks\"\n        },\n        {\n            \"course_name\": \"Learn Python 3\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Path\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 months\"\n        }\n    ],\n    \"launch_date\": \"2011-08-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"789\",\n            \"rating\": 3,\n            \"comment\": \"Good for learning the basics.\"\n        },\n        {\n            \"user_id\": \"101\",\n            \"rating\": 4,\n            \"comment\": \"Projects are engaging.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com\"\n}"}
{"_id": "Academic--digital_learning--p--70510", "text": "{\n    \"platform_name\": \"DataLearn Pro\",\n    \"developer\": \"Insightful Education Solutions\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Personalized learning paths\",\n        \"Community forums\",\n        \"Project-based learning\",\n        \"Certification tracks\"\n    ],\n    \"user_types\": [\n        \"students\",\n        \"educators\",\n        \"data scientists\"\n    ],\n    \"subscription_model\": \"freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Data Science\",\n            \"level\": \"beginner\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"level\": \"intermediate\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.8,\n            \"comment\": \"Excellent platform for learning data science! The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4.2,\n            \"comment\": \"Great content and well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datalearnpro.com\"\n}"}
{"_id": "Academic--digital_learning--n--70510", "text": "{\n    \"platform_name\": \"EduSpark\",\n    \"developer\": \"Bright Futures Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Quizzes\",\n        \"Downloadable resources\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"students\",\n        \"parents\"\n    ],\n    \"subscription_model\": \"paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"AP Calculus\",\n            \"level\": \"advanced\",\n            \"duration\": \"1 semester\"\n        },\n        {\n            \"course_name\": \"Introduction to Statistics\",\n            \"level\": \"beginner\",\n            \"duration\": \"10 weeks\"\n        }\n    ],\n    \"launch_date\": \"2022-03-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3.2,\n            \"comment\": \"Good basic courses, but could use more interactive elements.\"\n        },\n        {\n            \"user_id\": \"user101\",\n            \"rating\": 2.8,\n            \"comment\": \"The interface is a bit clunky.\"\n        }\n    ],\n    \"access_url\": \"https://www.eduspark.org\"\n}"}
