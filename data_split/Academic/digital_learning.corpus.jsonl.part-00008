{"_id": "Academic--digital_learning--p--71410", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp BV\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill tracks\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"6 months\"\n        }\n    ],\n    \"launch_date\": \"2016-02-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"DataCamp is incredibly effective for learning data science skills quickly. The interactive exercises are fantastic!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great platform, although some courses could be more in-depth.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--71410", "text": "{\n    \"platform_name\": \"ABCmouse.com\",\n    \"developer\": \"Age of Learning, Inc.\",\n    \"features\": [\n        \"Interactive games\",\n        \"Educational videos\",\n        \"Progress tracking\",\n        \"Curriculum aligned with standards\"\n    ],\n    \"user_types\": [\n        \"Early Learners\",\n        \"Parents\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Paid subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Reading Readiness\",\n            \"level\": \"Pre-K\",\n            \"duration\": \"Ongoing\"\n        },\n        {\n            \"course_name\": \"Math Basics\",\n            \"level\": \"Kindergarten\",\n            \"duration\": \"Ongoing\"\n        }\n    ],\n    \"launch_date\": \"2010-09-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"parent789\",\n            \"rating\": 4,\n            \"comment\": \"My child loves ABCmouse! It's a great way to supplement their learning.\"\n        }\n    ],\n    \"access_url\": \"https://www.abcmouse.com/\"\n}"}
{"_id": "Academic--digital_learning--p--71411", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Real-world projects\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium with paid levels\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topic\": \"Programming\"\n        },\n        {\n            \"course_name\": \"Machine Learning with scikit-learn\",\n            \"level\": \"Intermediate\",\n            \"topic\": \"Machine Learning\"\n        },\n        {\n            \"course_name\": \"Data Visualization with Tableau\",\n            \"level\": \"Intermediate\",\n            \"topic\": \"Data Visualization\"\n        }\n    ],\n    \"launch_date\": \"2016-02-03\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science skills!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great interactive exercises and helpful content.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
