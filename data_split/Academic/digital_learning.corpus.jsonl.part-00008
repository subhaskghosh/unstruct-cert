{"_id": "Academic--digital_learning--n--71937", "text": "{\n    \"platform_name\": \"Khan Academy Kids\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Interactive stories\",\n        \"Educational games\",\n        \"Character-based learning\",\n        \"Parent dashboards\"\n    ],\n    \"user_types\": [\n        \"Children\",\n        \"Parents\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Early Literacy\",\n            \"instructor\": \"Khan Academy\",\n            \"duration\": \"Self-paced\",\n            \"level\": \"Preschool\"\n        },\n        {\n            \"course_name\": \"Early Math\",\n            \"instructor\": \"Khan Academy\",\n            \"duration\": \"Self-paced\",\n            \"level\": \"Kindergarten\"\n        }\n    ],\n    \"launch_date\": \"2018-02-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"11223\",\n            \"rating\": 4,\n            \"comment\": \"My child loves using this app to learn!\"\n        },\n        {\n            \"user_id\": \"44556\",\n            \"rating\": 5,\n            \"comment\": \"A fantastic resource for young learners.\"\n        }\n    ],\n    \"access_url\": \"https://learn.khanacademy.org/kids/\"\n}"}
