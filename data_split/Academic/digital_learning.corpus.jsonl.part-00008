{"_id": "Academic--digital_learning--p--70149", "text": "{\n    \"platform_name\": \"Codecademy Pro\",\n    \"developer\": \"Codecademy\",\n    \"features\": [\n        \"Interactive Coding Exercises\",\n        \"Real-world Projects\",\n        \"Personalized Learning Paths\",\n        \"Code Review\",\n        \"Career Paths\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Beginners\"\n    ],\n    \"subscription_model\": \"Freemium with paid Pro access\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Bootcamp\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Full Stack Engineer Path\",\n            \"level\": \"Advanced\",\n            \"duration\": \"24 weeks\"\n        }\n    ],\n    \"launch_date\": \"2011-08-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning to code! Very easy to use and well-structured.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great interactive exercises and projects. The UI is very intuitive.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com/pro\"\n}"}
{"_id": "Academic--digital_learning--n--70149", "text": "{\n    \"platform_name\": \"LearnPhysicsOnline\",\n    \"developer\": \"Physics Education Inc.\",\n    \"features\": [\n        \"Video Lectures\",\n        \"Practice Problems\",\n        \"Online Quizzes\",\n        \"Forum Discussions\"\n    ],\n    \"user_types\": [\n        \"High School Students\",\n        \"Undergraduate Students\"\n    ],\n    \"subscription_model\": \"Paid Subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Classical Mechanics\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"Quantum Physics\",\n            \"level\": \"Advanced\",\n            \"duration\": \"15 weeks\"\n        }\n    ],\n    \"launch_date\": \"2018-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Good content, but the website is a bit clunky and not very user-friendly.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"The interface is difficult to navigate, and the lectures aren't very engaging.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnphysicsonline.com\"\n}"}
{"_id": "Academic--digital_learning--p--70150", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Syntax\",\n                \"Data Structures\",\n                \"Control Flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Regression\",\n                \"Classification\",\n                \"Clustering\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"difficulty\": \"Advanced\",\n            \"topics\": [\n                \"Statistics\",\n                \"Probability\",\n                \"Data Visualization\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science skills. The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good content, but the interface could be improved.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
