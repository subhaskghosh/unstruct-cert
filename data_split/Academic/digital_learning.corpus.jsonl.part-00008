{"_id": "Academic--digital_learning--p--71375", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-02-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science skills in an interactive way!\"\n        },\n        {\n            \"user\": \"Bob\",\n            \"rating\": 4,\n            \"comment\": \"Good courses, but the UI could be improved.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71375", "text": "{\n    \"platform_name\": \"LearnChemE\",\n    \"developer\": \"LearnChemE, Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Problem solving tutorials\",\n        \"Course materials\",\n        \"Discussion forums\"\n    ],\n    \"user_types\": [\n        \"Chemical Engineering Students\",\n        \"Chemical Engineers\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Paid subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Chemical Engineering Thermodynamics\",\n            \"level\": \"Undergraduate\",\n            \"duration\": \"1 semester\"\n        },\n        {\n            \"course_name\": \"Transport Phenomena\",\n            \"level\": \"Graduate\",\n            \"duration\": \"1 semester\"\n        }\n    ],\n    \"launch_date\": \"2019-11-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Carol\",\n            \"rating\": 4,\n            \"comment\": \"Very helpful for understanding complex chemical engineering concepts.\"\n        },\n        {\n            \"user\": \"David\",\n            \"rating\": 3,\n            \"comment\": \"Content is good, but the platform is a bit outdated.\"\n        }\n    ],\n    \"access_url\": \"https://learncheme.com\"\n}"}
{"_id": "Academic--digital_learning--p--71376", "text": "{\n    \"platform_name\": \"Codecademy Pro\",\n    \"developer\": \"Codecademy\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Project-based learning\",\n        \"Code review\",\n        \"Skill paths\",\n        \"Career paths\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Higher Education\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Learn Python 3\",\n            \"difficulty\": \"Beginner/Intermediate\",\n            \"category\": \"Programming\"\n        },\n        {\n            \"course_name\": \"Data Science Path\",\n            \"difficulty\": \"Intermediate/Advanced\",\n            \"category\": \"Data Science\"\n        },\n        {\n            \"course_name\": \"Web Development Path\",\n            \"difficulty\": \"Beginner/Intermediate\",\n            \"category\": \"Web Development\"\n        }\n    ],\n    \"launch_date\": \"2011-08-29\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice\",\n            \"rating\": 5,\n            \"comment\": \"Very engaging and hands-on. Helped me land a job!\"\n        },\n        {\n            \"user\": \"Bob\",\n            \"rating\": 4,\n            \"comment\": \"Innovative approach to learning to code.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com/pro\"\n}"}
