{"_id": "Academic--digital_learning--n--71924", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lessons\",\n        \"Practice exercises\",\n        \"Personalized learning\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\",\n        \"Parents\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Algebra I\",\n            \"level\": \"Beginner\",\n            \"duration\": \"Self-paced\"\n        },\n        {\n            \"course_name\": \"Calculus 1\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"Self-paced\"\n        },\n        {\n            \"course_name\": \"AP Biology\",\n            \"level\": \"Advanced\",\n            \"duration\": \"Self-paced\"\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"A great resource for students of all ages.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
{"_id": "Academic--digital_learning--p--71925", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill assessments\",\n        \"Project-based learning\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Very engaging and practical. I learned a lot!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great for beginners, the interactive exercises are really helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71925", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Assignments\",\n        \"Peer assessments\",\n        \"Discussion forums\",\n        \"Certificates\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Lifelong learners\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"5 courses\"\n        },\n        {\n            \"course_name\": \"Python for Everybody\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2012-05-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4,\n            \"comment\": \"Good quality courses, but can be quite expensive.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3,\n            \"comment\": \"The courses are in-depth but require significant prior knowledge.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org\"\n}"}
{"_id": "Academic--digital_learning--p--71926", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"title\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Python Fundamentals\",\n                \"Data Structures\"\n            ]\n        },\n        {\n            \"title\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"R Programming\",\n                \"Statistical Analysis\"\n            ]\n        },\n        {\n            \"title\": \"Machine Learning with Python\",\n            \"level\": \"Advanced\",\n            \"topics\": [\n                \"Supervised Learning\",\n                \"Unsupervised Learning\"\n            ]\n        },\n        {\n            \"title\": \"Data Visualization with Tableau\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Tableau Basics\",\n                \"Data Storytelling\"\n            ]\n        },\n        {\n            \"title\": \"SQL Fundamentals\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"SQL Queries\",\n                \"Database Management\"\n            ]\n        },\n        {\n            \"title\": \"Machine Learning Explainability\",\n            \"level\": \"Advanced\",\n            \"topics\": [\n                \"SHAP\",\n                \"LIME\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice\",\n            \"rating\": 4.5,\n            \"comment\": \"Great platform for learning data science!\"\n        },\n        {\n            \"user\": \"Bob\",\n            \"rating\": 4.0,\n            \"comment\": \"The interactive exercises are very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71926", "text": "{\n    \"platform_name\": \"Code Basics\",\n    \"developer\": \"Innovate EdTech\",\n    \"features\": [\n        \"Pre-recorded video lectures\",\n        \"Downloadable course materials\",\n        \"Basic quizzes\"\n    ],\n    \"user_types\": [\n        \"Students\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"title\": \"Introduction to Programming\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Basic Concepts\",\n                \"Variables\"\n            ]\n        },\n        {\n            \"title\": \"Web Development Fundamentals\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"HTML\",\n                \"CSS\"\n            ]\n        },\n        {\n            \"title\": \"Python for Beginners\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Python Syntax\",\n                \"Data Types\"\n            ]\n        },\n        {\n            \"title\": \"Java Fundamentals\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Object-Oriented Programming\",\n                \"Java Basics\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2018-05-20\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Charlie\",\n            \"rating\": 3.0,\n            \"comment\": \"Okay platform, but a bit basic.\"\n        },\n        {\n            \"user\": \"David\",\n            \"rating\": 2.5,\n            \"comment\": \"Not very engaging.\"\n        }\n    ],\n    \"access_url\": \"https://www.codebasics.org\"\n}"}
