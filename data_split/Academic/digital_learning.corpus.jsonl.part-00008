{"_id": "Academic--digital_learning--n--71556", "text": "{\n    \"platform_name\": \"LearnData Basics\",\n    \"developer\": \"SimpleEd Tech\",\n    \"features\": [\n        \"Video lectures\",\n        \"Quiz assessments\",\n        \"Downloadable resources\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Beginners\"\n    ],\n    \"subscription_model\": \"Paid - Monthly subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Data Science\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Python for Data Science - Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"6 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-11-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Good for getting started, but lacks depth for more advanced topics.\"\n        },\n        {\n            \"user_id\": \"user101\",\n            \"rating\": 4,\n            \"comment\": \"Clear explanations, perfect for complete beginners.\"\n        }\n    ],\n    \"access_url\": \"https://www.learndatabasics.org\"\n}"}
{"_id": "Academic--digital_learning--p--71557", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill tracks\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Python syntax\",\n                \"Data types\",\n                \"Control flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with scikit-learn\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Supervised learning\",\n                \"Unsupervised learning\",\n                \"Model evaluation\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-02-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science! Very interactive and easy to follow.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good content, but sometimes the exercises can be a bit challenging.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71557", "text": "{\n    \"platform_name\": \"LearnVerse\",\n    \"developer\": \"EduTech Solutions\",\n    \"features\": [\n        \"Live webinars\",\n        \"Downloadable resources\",\n        \"Quizzes\",\n        \"Discussion boards\"\n    ],\n    \"user_types\": [\n        \"High School Students\",\n        \"College Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"AP Calculus\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Limits\",\n                \"Derivatives\",\n                \"Integrals\"\n            ]\n        },\n        {\n            \"course_name\": \"Introductory Physics\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Mechanics\",\n                \"Thermodynamics\",\n                \"Electromagnetism\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2018-09-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"student789\",\n            \"rating\": 3,\n            \"comment\": \"Decent platform, but the interface feels a little outdated.\"\n        },\n        {\n            \"user_id\": \"teacher101\",\n            \"rating\": 4,\n            \"comment\": \"Helpful resources for teaching high school science.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnverse.org\"\n}"}
{"_id": "Academic--digital_learning--p--71558", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Project-based learning\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscription tiers\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Advanced\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science skills. Very interactive and engaging.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good content, but could use more advanced courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--71558", "text": "{\n    \"platform_name\": \"EduNext\",\n    \"developer\": \"Global Education Technologies\",\n    \"features\": [\n        \"Pre-recorded video lectures\",\n        \"Downloadable course materials\",\n        \"Quizzes\",\n        \"Discussion boards\"\n    ],\n    \"user_types\": [\n        \"High School Students\",\n        \"College Students\"\n    ],\n    \"subscription_model\": \"Annual subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"AP Calculus\",\n            \"level\": \"High School\",\n            \"duration\": \"1 semester\"\n        },\n        {\n            \"course_name\": \"Introductory Physics\",\n            \"level\": \"College\",\n            \"duration\": \"1 semester\"\n        },\n        {\n            \"course_name\": \"Data Analysis Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"6 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Decent platform for basic courses, but lacks depth.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"Videos are outdated and the interface is clunky.\"\n        }\n    ],\n    \"access_url\": \"https://www.edunext.org/\"\n}"}
