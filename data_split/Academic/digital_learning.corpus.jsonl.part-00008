{"_id": "Academic--digital_learning--p--71604", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Business Intelligence Professionals\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Scientist with Python\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 months\"\n        },\n        {\n            \"course_name\": \"Data Analyst with R\",\n            \"level\": \"Beginner\",\n            \"duration\": \"3 months\"\n        },\n        {\n            \"course_name\": \"Marketing Analytics\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"4 months\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science skills.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Very practical and hands-on approach to learning.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--71604", "text": "{\n    \"platform_name\": \"MIT OpenCourseWare\",\n    \"developer\": \"Massachusetts Institute of Technology\",\n    \"features\": [\n        \"Video lectures\",\n        \"Course notes\",\n        \"Assignments\",\n        \"Exams\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Researchers\",\n        \"Lifelong learners\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Algorithms\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"1 semester\"\n        },\n        {\n            \"course_name\": \"Linear Algebra\",\n            \"level\": \"Beginner\",\n            \"duration\": \"1 semester\"\n        },\n        {\n            \"course_name\": \"Theory of Computation\",\n            \"level\": \"Advanced\",\n            \"duration\": \"1 semester\"\n        }\n    ],\n    \"launch_date\": \"2001-03-30\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4,\n            \"comment\": \"Great resource for in-depth theoretical knowledge.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 5,\n            \"comment\": \"High-quality course materials from MIT.\"\n        }\n    ],\n    \"access_url\": \"https://ocw.mit.edu/\"\n}"}
{"_id": "Academic--digital_learning--p--71605", "text": "{\n    \"platform_name\": \"SkillForge\",\n    \"developer\": \"InnovateEd Tech\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Project-based learning\",\n        \"Personalized learning paths\",\n        \"Community forum\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Career changers\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Python for Data Science\",\n            \"level\": \"Beginner to Advanced\",\n            \"duration\": \"12 weeks\",\n            \"instructor\": \"Dr. Eleanor Vance\"\n        },\n        {\n            \"course_name\": \"Web Development Bootcamp\",\n            \"level\": \"Beginner to Intermediate\",\n            \"duration\": \"16 weeks\",\n            \"instructor\": \"James Harrison\"\n        }\n    ],\n    \"launch_date\": \"2021-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform! The hands-on projects really helped me solidify my skills.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great resources and a supportive community.\"\n        }\n    ],\n    \"access_url\": \"https://www.skillforge.com\"\n}"}
{"_id": "Academic--digital_learning--n--71605", "text": "{\n    \"platform_name\": \"EduKids\",\n    \"developer\": \"BrightStart Learning\",\n    \"features\": [\n        \"Animated lessons\",\n        \"Interactive quizzes\",\n        \"Progress reports for parents\",\n        \"Gamified learning\",\n        \"Curriculum aligned with national standards\"\n    ],\n    \"user_types\": [\n        \"Students (K-12)\",\n        \"Teachers\",\n        \"Parents\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Elementary Math\",\n            \"level\": \"Grade 3\",\n            \"duration\": \"Semester\",\n            \"instructor\": \"Ms. Johnson\"\n        },\n        {\n            \"course_name\": \"Reading Comprehension\",\n            \"level\": \"Grade 5\",\n            \"duration\": \"Semester\",\n            \"instructor\": \"Mr. Davis\"\n        }\n    ],\n    \"launch_date\": \"2022-03-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"parent789\",\n            \"rating\": 4,\n            \"comment\": \"My child enjoys using this platform, and I can see their progress.\"\n        },\n        {\n            \"user_id\": \"teacher101\",\n            \"rating\": 5,\n            \"comment\": \"A valuable resource for supplementing classroom instruction.\"\n        }\n    ],\n    \"access_url\": \"https://www.edukids.org\"\n}"}
{"_id": "Academic--digital_learning--p--71606", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill assessments\",\n        \"Career tracks\",\n        \"Project portfolio\",\n        \"Collaboration tools\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Subscription - tiered pricing\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Scientist with Python\",\n            \"difficulty\": \"Intermediate\",\n            \"duration\": \"6 months\"\n        },\n        {\n            \"course_name\": \"Data Analyst with R\",\n            \"difficulty\": \"Beginner\",\n            \"duration\": \"3 months\"\n        }\n    ],\n    \"launch_date\": \"2016-02-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science! The interactive exercises are very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
