{"_id": "Academic--digital_learning--n--70547", "text": "{\n    \"platform_name\": \"EduWorld\",\n    \"developer\": \"Global Education Solutions\",\n    \"features\": [\n        \"Video lectures\",\n        \"Quizzes\",\n        \"Discussion forums\",\n        \"Downloadable resources\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Statistics\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Basic Data Analysis\",\n            \"level\": \"Beginner\",\n            \"duration\": \"6 weeks\"\n        }\n    ],\n    \"launch_date\": \"2022-03-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good platform for basic education. Content is well-organized.\"\n        }\n    ],\n    \"access_url\": \"https://www.eduworld.org\"\n}"}
{"_id": "Academic--digital_learning--p--70548", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"12345\",\n            \"rating\": 4.5,\n            \"comment\": \"Great platform for learning data science!\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70548", "text": "{\n    \"platform_name\": \"Codecademy\",\n    \"developer\": \"Codecademy\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Project-based learning\",\n        \"Career paths\",\n        \"Skill paths\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Beginner Developers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to HTML\",\n            \"level\": \"Beginner\",\n            \"duration\": \"2 weeks\"\n        },\n        {\n            \"course_name\": \"JavaScript Basics\",\n            \"level\": \"Beginner\",\n            \"duration\": \"3 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        }\n    ],\n    \"launch_date\": \"2011-08-22\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"67890\",\n            \"rating\": 4.0,\n            \"comment\": \"Good for learning the basics of coding.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com\"\n}"}
{"_id": "Academic--digital_learning--p--70549", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp BV\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Career tracks\",\n        \"Project portfolio\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"course_level\": \"Beginner\",\n            \"course_category\": \"Programming\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"course_level\": \"Intermediate\",\n            \"course_category\": \"Data Science\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"course_level\": \"Advanced\",\n            \"course_category\": \"Machine Learning\"\n        }\n    ],\n    \"launch_date\": \"2016-02-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.5,\n            \"comment\": \"Great platform for learning data science. Interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4.0,\n            \"comment\": \"Good content, but the subscription can be a bit expensive.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70549", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lectures\",\n        \"Practice exercises\",\n        \"Personalized learning\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\",\n        \"Lifelong learners\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Calculus 1\",\n            \"course_level\": \"Beginner\",\n            \"course_category\": \"Mathematics\"\n        },\n        {\n            \"course_name\": \"Statistics\",\n            \"course_level\": \"Intermediate\",\n            \"course_category\": \"Statistics\"\n        },\n        {\n            \"course_name\": \"AP Computer Science\",\n            \"course_level\": \"Advanced\",\n            \"course_category\": \"Computer Science\"\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4.8,\n            \"comment\": \"Excellent resource for learning math and science.\"\n        },\n        {\n            \"user_id\": \"user101\",\n            \"rating\": 4.2,\n            \"comment\": \"Free and accessible learning for everyone.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
{"_id": "Academic--digital_learning--p--70550", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Project-based learning\",\n        \"Real-time feedback\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-02-17\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science skills!\"\n        },\n        {\n            \"user_id\": \"456\",\n            \"rating\": 4,\n            \"comment\": \"Very interactive and engaging courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70550", "text": "{\n    \"platform_name\": \"LearnVerse\",\n    \"developer\": \"EdTech Solutions\",\n    \"features\": [\n        \"Pre-recorded lectures\",\n        \"Downloadable resources\",\n        \"Discussion forums\",\n        \"Quizzes\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Analysis Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Introduction to Machine Learning\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"Web Development Bootcamp\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-05-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"789\",\n            \"rating\": 3,\n            \"comment\": \"Content is okay, but the platform is a bit clunky.\"\n        },\n        {\n            \"user_id\": \"101\",\n            \"rating\": 3,\n            \"comment\": \"Could use more interactive elements.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnverse.org\"\n}"}
{"_id": "Academic--digital_learning--p--70551", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill assessments\",\n        \"Project-based learning\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Students\",\n        \"Engineers\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-02-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"DataCamp is fantastic! The interactive exercises make learning data science so much easier. Very practical and easy to use.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great platform for quickly upskilling in data science. The courses are well-structured and the content is relevant.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70551", "text": "{\n    \"platform_name\": \"Codecademy\",\n    \"developer\": \"Codecademy\",\n    \"features\": [\n        \"Interactive lessons\",\n        \"Coding challenges\",\n        \"Project portfolio\",\n        \"Career paths\"\n    ],\n    \"user_types\": [\n        \"Beginners\",\n        \"Web Developers\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Learn Python 3\",\n            \"level\": \"Beginner\",\n            \"duration\": \"30 hours\"\n        },\n        {\n            \"course_name\": \"Data Science Bootcamp\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"40 hours\"\n        },\n        {\n            \"course_name\": \"Introduction to Machine Learning\",\n            \"level\": \"Advanced\",\n            \"duration\": \"50 hours\"\n        }\n    ],\n    \"launch_date\": \"2011-08-22\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4,\n            \"comment\": \"Good for learning the basics of coding.  A bit too much hand-holding for experienced developers.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3,\n            \"comment\": \"The course content is okay, but the interface could be more intuitive.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com\"\n}"}
{"_id": "Academic--digital_learning--p--70552", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Real-world projects\",\n        \"Skill assessments\",\n        \"Career tracks\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-03-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science. The interactive exercises are very helpful.\"\n        },\n        {\n            \"user\": \"Bob\",\n            \"rating\": 4,\n            \"comment\": \"Good content, but could use more advanced courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--70552", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Quizzes\",\n        \"Assignments\",\n        \"Peer assessments\",\n        \"Discussion forums\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Lifelong Learners\"\n    ],\n    \"subscription_model\": \"Paid subscriptions and individual course purchases\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"level\": \"Beginner\",\n            \"duration\": \"11 weeks\"\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"5 courses\"\n        }\n    ],\n    \"launch_date\": \"2012-04-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Charlie\",\n            \"rating\": 4,\n            \"comment\": \"Great courses from top universities, but can be quite passive.\"\n        },\n        {\n            \"user\": \"David\",\n            \"rating\": 3,\n            \"comment\": \"Good value for the money, but some courses are outdated.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org/\"\n}"}
{"_id": "Academic--digital_learning--p--70553", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill assessments\",\n        \"Project-based learning\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscription levels\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Scientist with Python\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 months\",\n            \"topics\": [\n                \"Python\",\n                \"Data Analysis\",\n                \"Machine Learning\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Engineer with SQL\",\n            \"level\": \"Beginner\",\n            \"duration\": \"3 months\",\n            \"topics\": [\n                \"SQL\",\n                \"Database Management\",\n                \"ETL\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.5,\n            \"comment\": \"Excellent platform for learning data science through hands-on practice.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70553", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Reading materials\",\n        \"Quizzes\",\n        \"Peer-graded assignments\",\n        \"Certificates\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Subscription and individual course purchases\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Theoretical Foundations of Machine Learning\",\n            \"level\": \"Advanced\",\n            \"duration\": \"12 weeks\",\n            \"topics\": [\n                \"Statistical Learning Theory\",\n                \"Optimization Algorithms\",\n                \"Probability\"\n            ]\n        },\n        {\n            \"course_name\": \"Introduction to Quantum Computing\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\",\n            \"topics\": [\n                \"Quantum Mechanics\",\n                \"Qubits\",\n                \"Quantum Algorithms\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2012-05-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4.0,\n            \"comment\": \"Great for in-depth theoretical knowledge, but lacks practical coding exercises.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org\"\n}"}
{"_id": "Academic--digital_learning--p--70554", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Project portfolio\",\n        \"Data science assessments\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Python Syntax\",\n                \"Data Structures\",\n                \"Control Flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science A-Z\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Data Cleaning\",\n                \"Data Visualization\",\n                \"Machine Learning\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"difficulty\": \"Advanced\",\n            \"topics\": [\n                \"Regression\",\n                \"Classification\",\n                \"Clustering\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science skills.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good interactive exercises.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
