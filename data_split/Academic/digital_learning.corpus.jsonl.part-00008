{"_id": "Academic--digital_learning--p--70698", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill tracks\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-03-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"rating\": 5,\n            \"comment\": \"DataCamp is incredibly engaging and has helped me land a data science job.\"\n        },\n        {\n            \"user_id\": \"456\",\n            \"rating\": 4,\n            \"comment\": \"The interactive exercises are great for learning by doing.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70698", "text": "{\n    \"platform_name\": \"LearnSphere\",\n    \"developer\": \"Global Education Inc.\",\n    \"features\": [\n        \"Pre-recorded video lectures\",\n        \"Downloadable course materials\",\n        \"Quizzes\",\n        \"Assignments\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Statistics\",\n            \"level\": \"Beginner\",\n            \"duration\": \"5 weeks\"\n        },\n        {\n            \"course_name\": \"Business Analytics Fundamentals\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"7 weeks\"\n        },\n        {\n            \"course_name\": \"Python for Beginners\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        }\n    ],\n    \"launch_date\": \"2019-12-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"789\",\n            \"rating\": 3,\n            \"comment\": \"The content is good, but the platform feels a bit outdated.\"\n        },\n        {\n            \"user_id\": \"012\",\n            \"rating\": 4,\n            \"comment\": \"Decent course selection and quality.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnsphere.org\"\n}"}
