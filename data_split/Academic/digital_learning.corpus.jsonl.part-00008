{"_id": "Academic--digital_learning--n--70537", "text": "{\n    \"platform_name\": \"PrepMaster\",\n    \"developer\": \"Educational Resources Inc.\",\n    \"features\": [\n        \"Practice tests\",\n        \"Detailed score reports\",\n        \"Adaptive learning\",\n        \"Exam simulations\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Test takers\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"SAT Preparation\",\n            \"level\": \"All Levels\",\n            \"duration\": \"Self-paced\"\n        },\n        {\n            \"course_name\": \"ACT Preparation\",\n            \"level\": \"All Levels\",\n            \"duration\": \"Self-paced\"\n        },\n        {\n            \"course_name\": \"GRE Preparation\",\n            \"level\": \"All Levels\",\n            \"duration\": \"Self-paced\"\n        }\n    ],\n    \"launch_date\": \"2021-03-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Very helpful for test prep. Lots of practice materials.\"\n        }\n    ],\n    \"access_url\": \"https://www.prepmaster.edu\"\n}"}
{"_id": "Academic--digital_learning--p--70538", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill tracks\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"subject\": \"Data Science\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Scikit-learn\",\n            \"subject\": \"Artificial Intelligence\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.5,\n            \"comment\": \"Great platform for learning data science!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4.2,\n            \"comment\": \"Very practical and hands-on.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
