{"_id": "Academic--digital_learning--n--70166", "text": "{\n    \"platform_name\": \"Codecademy\",\n    \"developer\": \"Codecademy\",\n    \"features\": [\n        \"Interactive coding\",\n        \"Project-based learning\",\n        \"Career paths\",\n        \"Skill paths\"\n    ],\n    \"user_types\": [\n        \"Beginners\",\n        \"Students\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to HTML\",\n            \"difficulty\": \"Beginner\",\n            \"category\": \"Web Development\"\n        },\n        {\n            \"course_name\": \"Learn JavaScript\",\n            \"difficulty\": \"Intermediate\",\n            \"category\": \"Web Development\"\n        },\n        {\n            \"course_name\": \"Data Science Fundamentals\",\n            \"difficulty\": \"Beginner\",\n            \"category\": \"Data Science\"\n        }\n    ],\n    \"launch_date\": \"2011-08-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Good for basic concepts, but lacks depth.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4,\n            \"comment\": \"Helpful for learning the fundamentals of web development.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com\"\n}"}
{"_id": "Academic--digital_learning--p--70167", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science!\"\n        },\n        {\n            \"user_id\": \"456\",\n            \"rating\": 4,\n            \"comment\": \"Great interactive exercises.\"\n        },\n        {\n            \"user_id\": \"789\",\n            \"rating\": 5,\n            \"comment\": \"Helped me land a data science job.\"\n        },\n        {\n            \"user_id\": \"101\",\n            \"rating\": 4,\n            \"comment\": \"Good content, but could use more advanced topics.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70167", "text": "{\n    \"platform_name\": \"Codecademy\",\n    \"developer\": \"Codecademy\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Project-based learning\",\n        \"Career paths\",\n        \"Skill paths\"\n    ],\n    \"user_types\": [\n        \"Beginner Coders\",\n        \"Students\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Learn Python 3\",\n            \"level\": \"Beginner\",\n            \"duration\": \"30 hours\"\n        },\n        {\n            \"course_name\": \"Data Science Bootcamp\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"40 hours\"\n        },\n        {\n            \"course_name\": \"Machine Learning\",\n            \"level\": \"Advanced\",\n            \"duration\": \"50 hours\"\n        }\n    ],\n    \"launch_date\": \"2011-08-22\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"202\",\n            \"rating\": 3,\n            \"comment\": \"Okay platform, but a bit too basic.\"\n        },\n        {\n            \"user_id\": \"203\",\n            \"rating\": 2,\n            \"comment\": \"The exercises are repetitive.\"\n        },\n        {\n            \"user_id\": \"204\",\n            \"rating\": 4,\n            \"comment\": \"Good for beginners.\"\n        },\n        {\n            \"user_id\": \"205\",\n            \"rating\": 3,\n            \"comment\": \"Limited project options.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com\"\n}"}
