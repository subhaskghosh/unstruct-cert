{"_id": "Academic--digital_learning--n--71889", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Google\",\n    \"features\": [\n        \"Video lectures\",\n        \"Peer-graded assignments\",\n        \"Quizzes\",\n        \"Discussion forums\",\n        \"Certificate programs\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Lifelong Learners\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"5 courses\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"5 courses\"\n        }\n    ],\n    \"launch_date\": \"2012-05-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Good content but can be expensive.\"\n        },\n        {\n            \"user_id\": \"user101\",\n            \"rating\": 4,\n            \"comment\": \"Helpful for career advancement.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org\"\n}"}
