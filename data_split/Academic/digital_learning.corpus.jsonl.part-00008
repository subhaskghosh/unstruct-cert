{"_id": "Academic--digital_learning--p--71342", "text": "{\n    \"platform_name\": \"CodeCraft University\",\n    \"developer\": \"InnovateEd Solutions\",\n    \"features\": [\n        \"Interactive Coding Exercises\",\n        \"Project-Based Learning\",\n        \"Personalized Learning Paths\",\n        \"Code Review\",\n        \"Community Forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Career Changers\"\n    ],\n    \"subscription_model\": \"Freemium with paid premium tiers\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Bootcamp\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Full Stack Web Development\",\n            \"level\": \"Advanced\",\n            \"duration\": \"16 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-03-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice Johnson\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform! The interactive exercises really helped me grasp the concepts.\"\n        },\n        {\n            \"user\": \"Bob Smith\",\n            \"rating\": 4,\n            \"comment\": \"Great for upskilling. The project-based learning is very practical.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecraftuniversity.com\"\n}"}
{"_id": "Academic--digital_learning--n--71342", "text": "{\n    \"platform_name\": \"ClassicLearn Institute\",\n    \"developer\": \"Traditional Education Corp\",\n    \"features\": [\n        \"Video Lectures\",\n        \"Downloadable Course Materials\",\n        \"Quizzes\",\n        \"Assignments\",\n        \"Gradebook\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\",\n        \"School Administrators\"\n    ],\n    \"subscription_model\": \"Annual License\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Fundamentals of Computer Science\",\n            \"level\": \"Introductory\",\n            \"duration\": \"15 weeks\"\n        },\n        {\n            \"course_name\": \"Advanced Algorithms\",\n            \"level\": \"Advanced\",\n            \"duration\": \"10 weeks\"\n        }\n    ],\n    \"launch_date\": \"2018-11-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Charlie Brown\",\n            \"rating\": 3,\n            \"comment\": \"A solid platform for traditional learning, but not very engaging.\"\n        },\n        {\n            \"user\": \"Diana Davis\",\n            \"rating\": 2,\n            \"comment\": \"The interface is outdated and difficult to navigate.\"\n        }\n    ],\n    \"access_url\": \"https://www.classiclearn.edu\"\n}"}
