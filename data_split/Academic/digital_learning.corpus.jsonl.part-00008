{"_id": "Academic--digital_learning--n--70658", "text": "{\n    \"platform_name\": \"Codecademy\",\n    \"developer\": \"Codecademy, Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Career paths\",\n        \"Skill paths\",\n        \"Projects\",\n        \"Quizzes\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Career Changers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to HTML\",\n            \"subject\": \"Web Development\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Learn JavaScript\",\n            \"subject\": \"Web Development\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Data Science Fundamentals\",\n            \"subject\": \"Data Science\",\n            \"level\": \"Beginner\"\n        }\n    ],\n    \"launch_date\": \"2011-08-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"11223\",\n            \"rating\": 3,\n            \"comment\": \"Good for basic concepts, but feels a bit hand-holdy.\"\n        },\n        {\n            \"user_id\": \"44556\",\n            \"rating\": 4,\n            \"comment\": \"Helpful for getting started with coding.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com/\"\n}"}
