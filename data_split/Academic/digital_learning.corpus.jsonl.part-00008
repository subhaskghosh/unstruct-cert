{"_id": "Academic--digital_learning--n--70501", "text": "{\n    \"platform_name\": \"LearnSQL.com\",\n    \"developer\": \"Scolaroo\",\n    \"features\": [\n        \"Interactive SQL tutorials\",\n        \"Real-world examples\",\n        \"Code editor\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Database Administrators\",\n        \"Data Analysts\",\n        \"Developers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"SQL Basics\",\n            \"level\": \"Beginner\",\n            \"duration\": \"2 weeks\"\n        },\n        {\n            \"course_name\": \"Intermediate SQL\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"4 weeks\"\n        }\n    ],\n    \"launch_date\": \"2018-05-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Good for learning SQL, but could use more advanced content.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"The interface is a bit clunky.\"\n        }\n    ],\n    \"access_url\": \"https://learnsql.com/\"\n}"}
