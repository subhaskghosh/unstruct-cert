{"_id": "Academic--digital_learning--p--71682", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill assessments\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Python basics\",\n                \"Data manipulation\",\n                \"Data visualization\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Supervised learning\",\n                \"Unsupervised learning\",\n                \"Model evaluation\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"topics\": [\n                \"Statistical modeling\",\n                \"Data mining\",\n                \"Big data\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science. Very interactive and engaging!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great for brushing up on skills and learning new technologies.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71682", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lessons\",\n        \"Practice exercises\",\n        \"Personalized learning\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\",\n        \"Parents\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Arithmetic\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Addition\",\n                \"Subtraction\",\n                \"Multiplication\",\n                \"Division\"\n            ]\n        },\n        {\n            \"course_name\": \"Algebra I\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Linear equations\",\n                \"Inequalities\",\n                \"Graphing\"\n            ]\n        },\n        {\n            \"course_name\": \"Calculus\",\n            \"level\": \"Advanced\",\n            \"topics\": [\n                \"Derivatives\",\n                \"Integrals\",\n                \"Limits\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 5,\n            \"comment\": \"Wonderful resource for K-12 students. Helps build a strong foundation.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4,\n            \"comment\": \"Excellent free educational content.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
{"_id": "Academic--digital_learning--p--71683", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp BV\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Visualization with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.5,\n            \"comment\": \"Great for learning data science skills quickly.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4.2,\n            \"comment\": \"Hands-on exercises are very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71683", "text": "{\n    \"platform_name\": \"MIT OpenCourseWare\",\n    \"developer\": \"Massachusetts Institute of Technology\",\n    \"features\": [\n        \"Lecture videos\",\n        \"Course notes\",\n        \"Assignments\",\n        \"Exams\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Self-learners\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"6.0001 Introduction to Computer Science and Programming in Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"1 semester\"\n        },\n        {\n            \"course_name\": \"6.042J Mathematics for Computer Science\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"1 semester\"\n        }\n    ],\n    \"launch_date\": \"2001-01-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4.8,\n            \"comment\": \"Excellent resource for in-depth understanding of computer science concepts.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4.6,\n            \"comment\": \"Very comprehensive and well-structured.\"\n        }\n    ],\n    \"access_url\": \"https://ocw.mit.edu\"\n}"}
{"_id": "Academic--digital_learning--p--71684", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp, Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill tracks\",\n        \"Project-based learning\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Subscription (various tiers)\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"John Doe\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science. The interactive exercises are really helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71684", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Peer assessments\",\n        \"Assignments\",\n        \"Specializations\",\n        \"Degrees\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Lifelong Learners\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Freemium (courses can be audited for free, full access requires payment)\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"5 courses\"\n        }\n    ],\n    \"launch_date\": \"2012-04-10\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Jane Smith\",\n            \"rating\": 4,\n            \"comment\": \"Good range of courses, but can be quite academic.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org\"\n}"}
{"_id": "Academic--digital_learning--p--71685", "text": "{\n    \"platform_name\": \"DataLearn Pro\",\n    \"developer\": \"InnovateEd Tech\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Project-based learning\",\n        \"Personalized learning paths\",\n        \"Community forums\",\n        \"Certification programs\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Paid levels\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python for Data Science\",\n            \"level\": \"Beginner\",\n            \"instructor\": \"Dr. Emily Carter\"\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"level\": \"Intermediate\",\n            \"instructor\": \"Dr. David Lee\"\n        },\n        {\n            \"course_name\": \"Deep Learning with TensorFlow\",\n            \"level\": \"Advanced\",\n            \"instructor\": \"Dr. Sarah Chen\"\n        },\n        {\n            \"course_name\": \"Data Visualization with Tableau\",\n            \"level\": \"Intermediate\",\n            \"instructor\": \"Mr. John Smith\"\n        },\n        {\n            \"course_name\": \"Big Data Analytics with Spark\",\n            \"level\": \"Advanced\",\n            \"instructor\": \"Ms. Alice Brown\"\n        },\n        {\n            \"course_name\": \"Statistical Modeling\",\n            \"level\": \"Intermediate\",\n            \"instructor\": \"Dr. Robert Jones\"\n        },\n        {\n            \"course_name\": \"Data Mining Techniques\",\n            \"level\": \"Intermediate\",\n            \"instructor\": \"Dr. Carol White\"\n        },\n        {\n            \"course_name\": \"Data Engineering Fundamentals\",\n            \"level\": \"Beginner\",\n            \"instructor\": \"Mr. Kevin Green\"\n        },\n        {\n            \"course_name\": \"Time Series Analysis\",\n            \"level\": \"Advanced\",\n            \"instructor\": \"Ms. Lisa Black\"\n        },\n        {\n            \"course_name\": \"Natural Language Processing\",\n            \"level\": \"Advanced\",\n            \"instructor\": \"Dr. Michael Gray\"\n        },\n        {\n            \"course_name\": \"Reinforcement Learning\",\n            \"level\": \"Advanced\",\n            \"instructor\": \"Dr. Susan Purple\"\n        }\n    ],\n    \"launch_date\": \"2021-05-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"This platform is incredibly engaging and helped me land a data science job!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Innovative approach to learning complex topics.\"\n        }\n    ],\n    \"access_url\": \"https://www.datalearnpro.com\"\n}"}
{"_id": "Academic--digital_learning--n--71685", "text": "{\n    \"platform_name\": \"LearnSimple\",\n    \"developer\": \"EasyLearning Solutions\",\n    \"features\": [\n        \"Video lectures\",\n        \"Quizzes\",\n        \"Downloadable resources\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Data Analysis\",\n            \"level\": \"Beginner\",\n            \"instructor\": \"Professor Johnson\"\n        },\n        {\n            \"course_name\": \"Data Science Basics\",\n            \"level\": \"Beginner\",\n            \"instructor\": \"Dr. Williams\"\n        }\n    ],\n    \"launch_date\": \"2022-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Good for basic concepts, but lacks depth.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnsimple.net\"\n}"}
{"_id": "Academic--digital_learning--p--71686", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Peer assessments\",\n        \"Quizzes\",\n        \"Certificates\",\n        \"Specializations\",\n        \"Degree programs\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Freemium with paid certificates and specializations\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"instructor\": \"Andrew Ng\",\n            \"level\": \"Beginner\",\n            \"duration\": \"11 weeks\"\n        },\n        {\n            \"course_name\": \"Python for Everybody\",\n            \"instructor\": \"Charles Severance\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2012-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform with high-quality courses.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great learning experience, especially for career advancement.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org/\"\n}"}
{"_id": "Academic--digital_learning--n--71686", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lectures\",\n        \"Practice exercises\",\n        \"Progress tracking\",\n        \"Personalized learning\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Algebra I\",\n            \"instructor\": \"Sal Khan\",\n            \"level\": \"Beginner\",\n            \"duration\": \"Self-paced\"\n        },\n        {\n            \"course_name\": \"Calculus 1\",\n            \"instructor\": \"Sal Khan\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"Self-paced\"\n        }\n    ],\n    \"launch_date\": \"2006-09-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 5,\n            \"comment\": \"Fantastic resource for learning math and science!\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4,\n            \"comment\": \"Helped me improve my understanding of complex topics.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org/\"\n}"}
{"_id": "Academic--digital_learning--p--71687", "text": "{\n    \"platform_name\": \"DataLearn Pro\",\n    \"developer\": \"EduFuture Inc.\",\n    \"features\": [\n        \"Interactive lessons\",\n        \"Project-based learning\",\n        \"Personalized learning paths\",\n        \"Progress tracking\",\n        \"Community forums\",\n        \"Certificate programs\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Data Science\",\n            \"level\": \"Beginner\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"16 weeks\"\n        },\n        {\n            \"course_name\": \"Deep Learning Fundamentals\",\n            \"level\": \"Advanced\",\n            \"duration\": \"20 weeks\"\n        }\n    ],\n    \"launch_date\": \"2022-03-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice Smith\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science! The courses are well-structured and the instructors are knowledgeable.\"\n        },\n        {\n            \"user\": \"Bob Johnson\",\n            \"rating\": 4,\n            \"comment\": \"Good value for the price. The free content is a great way to get started.\"\n        }\n    ],\n    \"access_url\": \"https://www.datalearnpro.com\"\n}"}
{"_id": "Academic--digital_learning--n--71687", "text": "{\n    \"platform_name\": \"CodeCrafters Academy\",\n    \"developer\": \"Tech Solutions Ltd.\",\n    \"features\": [\n        \"Live coding sessions\",\n        \"Pair programming\",\n        \"Career coaching\",\n        \"Portfolio building\",\n        \"Job placement assistance\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Career Changers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Full Stack Web Development\",\n            \"level\": \"Beginner\",\n            \"duration\": \"24 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Bootcamp\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Mobile App Development\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"16 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-05-20\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Charlie Brown\",\n            \"rating\": 4,\n            \"comment\": \"Great bootcamp for quickly learning coding skills.\"\n        },\n        {\n            \"user\": \"Diana Davis\",\n            \"rating\": 5,\n            \"comment\": \"The instructors were very helpful and supportive.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecraftersacademy.com\"\n}"}
{"_id": "Academic--digital_learning--p--71688", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python for Data Science\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.5,\n            \"comment\": \"Excellent platform for learning data science skills!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4.0,\n            \"comment\": \"The interactive exercises are very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71688", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lessons\",\n        \"Practice exercises\",\n        \"Progress tracking\",\n        \"Personalized learning\",\n        \"Interactive challenges\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\",\n        \"Parents\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Calculus 1\",\n            \"level\": \"Beginner\",\n            \"duration\": \"Self-paced\"\n        },\n        {\n            \"course_name\": \"Linear Algebra\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"Self-paced\"\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4.8,\n            \"comment\": \"Great resource for learning math and science!\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4.2,\n            \"comment\": \"Very helpful for students struggling with math.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
{"_id": "Academic--digital_learning--p--71689", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp BV\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill assessments\",\n        \"Project-based learning\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Freemium/Paid Subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Python syntax\",\n                \"Data types\",\n                \"Control flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Regression\",\n                \"Classification\",\n                \"Clustering\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"topics\": [\n                \"Statistical Inference\",\n                \"Data Visualization\",\n                \"Machine Learning Algorithms\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"John Doe\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science!\"\n        },\n        {\n            \"user\": \"Jane Smith\",\n            \"rating\": 4,\n            \"comment\": \"Interactive exercises are very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71689", "text": "{\n    \"platform_name\": \"LearnSphere\",\n    \"developer\": \"EduTech Innovations\",\n    \"features\": [\n        \"Pre-recorded video lectures\",\n        \"Downloadable course materials\",\n        \"Quizzes\",\n        \"Discussion boards\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Lifelong Learners\"\n    ],\n    \"subscription_model\": \"Paid Subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to History\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Ancient Civilizations\",\n                \"Medieval Europe\",\n                \"World War II\"\n            ]\n        },\n        {\n            \"course_name\": \"Creative Writing\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Poetry\",\n                \"Short Stories\",\n                \"Novel Writing\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2019-12-20\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice Johnson\",\n            \"rating\": 3,\n            \"comment\": \"Good content, but the platform is a bit outdated.\"\n        },\n        {\n            \"user\": \"Bob Williams\",\n            \"rating\": 2,\n            \"comment\": \"Not very interactive.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnsphere.org\"\n}"}
