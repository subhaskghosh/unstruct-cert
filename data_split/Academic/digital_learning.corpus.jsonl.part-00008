{"_id": "Academic--digital_learning--n--70689", "text": "{\n    \"platform_name\": \"HistoryOnline\",\n    \"developer\": \"Academic Publishers Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Reading materials\",\n        \"Discussion forums\",\n        \"Quizzes\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Researchers\",\n        \"History Enthusiasts\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Ancient Roman History\",\n            \"subject\": \"History\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Modern European History\",\n            \"subject\": \"History\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2022-05-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Excellent resource for history buffs.\"\n        }\n    ],\n    \"access_url\": \"https://www.historyonline.edu/\"\n}"}
{"_id": "Academic--digital_learning--p--70690", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill assessments\",\n        \"Career tracks\",\n        \"Project portfolio building\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Paid subscription tiers\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with scikit-learn\",\n            \"difficulty\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Data Visualization with Tableau\",\n            \"difficulty\": \"Beginner\",\n            \"duration\": \"3 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for hands-on learning. The content is up-to-date and the exercises are very practical.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Good resource for beginners. I wish there were more advanced courses available.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--70690", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lectures\",\n        \"Practice exercises\",\n        \"Personalized learning dashboards\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\",\n        \"Parents\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Calculus 1\",\n            \"difficulty\": \"Beginner\",\n            \"duration\": \"Self-paced\"\n        },\n        {\n            \"course_name\": \"Statistics and probability\",\n            \"difficulty\": \"Intermediate\",\n            \"duration\": \"Self-paced\"\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4,\n            \"comment\": \"Great for foundational knowledge! A valuable resource for students.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 5,\n            \"comment\": \"Excellent free resource, especially for math.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org/\"\n}"}
{"_id": "Academic--digital_learning--p--70691", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lessons\",\n        \"Skill tracks\",\n        \"Project-based learning\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Python fundamentals\",\n                \"Data types\",\n                \"Control flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Regression\",\n                \"Classification\",\n                \"Clustering\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"difficulty\": \"Advanced\",\n            \"topics\": [\n                \"Statistical inference\",\n                \"Data visualization\",\n                \"Machine Learning algorithms\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform! The community forum is incredibly helpful for getting unstuck and learning from others.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great interactive lessons and a supportive learning environment.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--70691", "text": "{\n    \"platform_name\": \"CodeCombat\",\n    \"developer\": \"CodeCombat\",\n    \"features\": [\n        \"Game-based learning\",\n        \"Coding challenges\",\n        \"Multiplayer modes\",\n        \"Level editor\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Paid levels\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to JavaScript\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Variables\",\n                \"Loops\",\n                \"Functions\"\n            ]\n        },\n        {\n            \"course_name\": \"Python Foundations\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Basic Syntax\",\n                \"Data Structures\",\n                \"Control Flow\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2015-09-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4,\n            \"comment\": \"My son loves learning to code through the game! It's a fun way to introduce programming concepts.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 3,\n            \"comment\": \"Good for kids, but not advanced enough for serious data science studies.\"\n        }\n    ],\n    \"access_url\": \"https://codecombat.com/\"\n}"}
{"_id": "Academic--digital_learning--p--70692", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill assessments\",\n        \"Career tracks\",\n        \"Project portfolio\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.5,\n            \"comment\": \"Great platform for learning data science! Very practical and hands-on.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4.2,\n            \"comment\": \"Helped me land a job as a data analyst.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70692", "text": "{\n    \"platform_name\": \"LearnWorlds\",\n    \"developer\": \"LearnWorlds\",\n    \"features\": [\n        \"Course creation tools\",\n        \"Interactive video\",\n        \"Community features\",\n        \"Marketing integrations\"\n    ],\n    \"user_types\": [\n        \"Educators\",\n        \"Course Creators\",\n        \"Subject Matter Experts\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Digital Marketing Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"5 weeks\"\n        },\n        {\n            \"course_name\": \"Photography Masterclass\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Creative Writing Workshop\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        }\n    ],\n    \"launch_date\": \"2014-08-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3.8,\n            \"comment\": \"Good platform for creating and selling courses, but not specifically focused on data science.\"\n        },\n        {\n            \"user_id\": \"user101\",\n            \"rating\": 4.0,\n            \"comment\": \"Easy to use and customize.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnworlds.com\"\n}"}
{"_id": "Academic--digital_learning--p--70693", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill tracks\",\n        \"Project-based learning\",\n        \"Real-world datasets\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"subject\": \"Data Science\"\n        },\n        {\n            \"course_name\": \"Cybersecurity Fundamentals\",\n            \"level\": \"Intermediate\",\n            \"subject\": \"Cybersecurity\"\n        }\n    ],\n    \"launch_date\": \"2016-07-14\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.5,\n            \"comment\": \"Great for learning data science skills quickly.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70693", "text": "{\n    \"platform_name\": \"LearnTheory\",\n    \"developer\": \"Academica Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Reading materials\",\n        \"Quizzes\",\n        \"Discussion forums\",\n        \"Theoretical assessments\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Researchers\",\n        \"Academics\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Advanced Statistical Modeling\",\n            \"level\": \"Advanced\",\n            \"subject\": \"Statistics\"\n        },\n        {\n            \"course_name\": \"Network Security Principles\",\n            \"level\": \"Intermediate\",\n            \"subject\": \"Cybersecurity\"\n        }\n    ],\n    \"launch_date\": \"2021-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 3.8,\n            \"comment\": \"Excellent in-depth coverage of theoretical concepts.\"\n        }\n    ],\n    \"access_url\": \"https://www.learntheory.edu\"\n}"}
{"_id": "Academic--digital_learning--p--70694", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill assessments\",\n        \"Project-based learning\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Syntax\",\n                \"Data Types\",\n                \"Control Flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Manipulation with pandas\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"DataFrames\",\n                \"Data Cleaning\",\n                \"Data Transformation\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with scikit-learn\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Regression\",\n                \"Classification\",\n                \"Clustering\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Visualization with ggplot2\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Histograms\",\n                \"Scatter Plots\",\n                \"Bar Charts\"\n            ]\n        },\n        {\n            \"course_name\": \"Deep Learning with TensorFlow\",\n            \"difficulty\": \"Advanced\",\n            \"topics\": [\n                \"Neural Networks\",\n                \"Convolutional Neural Networks\",\n                \"Recurrent Neural Networks\"\n            ]\n        },\n        {\n            \"course_name\": \"SQL Fundamentals\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"SELECT Statements\",\n                \"JOINs\",\n                \"WHERE Clauses\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-01-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science!\"\n        },\n        {\n            \"user_id\": \"456\",\n            \"rating\": 4,\n            \"comment\": \"Helpful and well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70694", "text": "{\n    \"platform_name\": \"Google Cloud Skills Boost\",\n    \"developer\": \"Google\",\n    \"features\": [\n        \"On-demand labs\",\n        \"Skill badges\",\n        \"Guided learning paths\",\n        \"Integration with Google Cloud products\"\n    ],\n    \"user_types\": [\n        \"Developers\",\n        \"IT Professionals\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning on Google Cloud\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"TensorFlow\",\n                \"Cloud AI Platform\",\n                \"AutoML\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Engineering on Google Cloud\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"BigQuery\",\n                \"Dataflow\",\n                \"Dataproc\"\n            ]\n        },\n        {\n            \"course_name\": \"Introduction to Kubernetes\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Containers\",\n                \"Orchestration\",\n                \"Deployment\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2020-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"789\",\n            \"rating\": 4,\n            \"comment\": \"Good for learning Google Cloud technologies.\"\n        }\n    ],\n    \"access_url\": \"https://www.cloudskillsboost.google/\"\n}"}
{"_id": "Academic--digital_learning--p--70695", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lessons\",\n        \"Skill tracks\",\n        \"Project portfolio\",\n        \"Real-time feedback\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"3 hours\"\n        },\n        {\n            \"course_name\": \"Data Manipulation with Pandas\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"5 hours\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Scikit-learn\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 hours\"\n        },\n        {\n            \"course_name\": \"Data Visualization with Matplotlib\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 hours\"\n        },\n        {\n            \"course_name\": \"Statistical Inference\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 hours\"\n        },\n        {\n            \"course_name\": \"Deep Learning with TensorFlow\",\n            \"level\": \"Advanced\",\n            \"duration\": \"10 hours\"\n        },\n        {\n            \"course_name\": \"R Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"3 hours\"\n        },\n        {\n            \"course_name\": \"SQL Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 hours\"\n        },\n        {\n            \"course_name\": \"Time Series Analysis\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"7 hours\"\n        },\n        {\n            \"course_name\": \"Bayesian Statistics\",\n            \"level\": \"Advanced\",\n            \"duration\": \"9 hours\"\n        },\n        {\n            \"course_name\": \"Data Engineering\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 hours\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.5,\n            \"comment\": \"Very user-friendly and a great way to learn data science.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 5.0,\n            \"comment\": \"Excellent platform with high-quality content.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70695", "text": "{\n    \"platform_name\": \"Codecademy\",\n    \"developer\": \"Codecademy, Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Project-based learning\",\n        \"Career paths\",\n        \"Code editor\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Beginners\",\n        \"Students\",\n        \"Career changers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to HTML\",\n            \"level\": \"Beginner\",\n            \"duration\": \"2 hours\"\n        },\n        {\n            \"course_name\": \"Introduction to CSS\",\n            \"level\": \"Beginner\",\n            \"duration\": \"3 hours\"\n        },\n        {\n            \"course_name\": \"Introduction to JavaScript\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 hours\"\n        },\n        {\n            \"course_name\": \"Learn Python 3\",\n            \"level\": \"Beginner\",\n            \"duration\": \"5 hours\"\n        },\n        {\n            \"course_name\": \"Data Science Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"6 hours\"\n        }\n    ],\n    \"launch_date\": \"2011-08-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3.8,\n            \"comment\": \"Good for beginners but can get repetitive.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4.0,\n            \"comment\": \"Solid platform, well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com\"\n}"}
