{"_id": "Academic--digital_learning--n--70566", "text": "{\n    \"platform_name\": \"EduCentral\",\n    \"developer\": \"Learning Solutions Ltd.\",\n    \"features\": [\n        \"Video Lectures\",\n        \"Quiz Assessments\",\n        \"Downloadable Resources\",\n        \"Discussion Boards\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Science Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"Statistics for Beginners\",\n            \"level\": \"Beginner\",\n            \"duration\": \"6 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-03-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Good basic content, but could be more interactive.\"\n        }\n    ],\n    \"access_url\": \"https://www.educentral.org\"\n}"}
{"_id": "Academic--digital_learning--p--70567", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill tracks\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with scikit-learn\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-02-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"12345\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science. Very practical and hands-on.\"\n        },\n        {\n            \"user_id\": \"67890\",\n            \"rating\": 4,\n            \"comment\": \"Good resource for brushing up on skills. The interactive exercises are very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70567", "text": "{\n    \"platform_name\": \"Codecademy\",\n    \"developer\": \"Codecademy, Inc.\",\n    \"features\": [\n        \"Interactive coding tutorials\",\n        \"Project-based learning\",\n        \"Career paths\",\n        \"Skill paths\"\n    ],\n    \"user_types\": [\n        \"Beginner programmers\",\n        \"Students\",\n        \"Career changers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Learn HTML\",\n            \"level\": \"Beginner\",\n            \"duration\": \"2 weeks\"\n        },\n        {\n            \"course_name\": \"Learn JavaScript\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"6 weeks\"\n        }\n    ],\n    \"launch_date\": \"2011-08-24\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"11223\",\n            \"rating\": 3,\n            \"comment\": \"Good for basic coding concepts, but lacks depth for advanced topics.\"\n        },\n        {\n            \"user_id\": \"44556\",\n            \"rating\": 4,\n            \"comment\": \"Helpful for getting started with programming.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com\"\n}"}
{"_id": "Academic--digital_learning--p--70568", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lessons\",\n        \"Skill tracks\",\n        \"Project-based learning\",\n        \"Real-time feedback\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Students\",\n        \"Business Professionals\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"category\": \"Programming\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"category\": \"Data Science\",\n            \"level\": \"Intermediate\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"category\": \"Machine Learning\",\n            \"level\": \"Advanced\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 4.8,\n            \"comment\": \"Excellent platform for learning data science skills. The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4.5,\n            \"comment\": \"Great content and well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70568", "text": "{\n    \"platform_name\": \"LearnMathOnline\",\n    \"developer\": \"Math Education Group\",\n    \"features\": [\n        \"Video lectures\",\n        \"Practice problems\",\n        \"Quizzes\",\n        \"Forum discussions\"\n    ],\n    \"user_types\": [\n        \"High School Students\",\n        \"College Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Algebra I\",\n            \"category\": \"Mathematics\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Calculus II\",\n            \"category\": \"Mathematics\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2021-03-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3.9,\n            \"comment\": \"Decent platform for learning math basics, but could use more interactive content.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4.0,\n            \"comment\": \"Good for supplemental learning, but not a replacement for a teacher.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnmathonline.com\"\n}"}
{"_id": "Academic--digital_learning--p--70569", "text": "{\n    \"platform_name\": \"CodeCraft Pro\",\n    \"developer\": \"TechEd Solutions Inc.\",\n    \"features\": [\n        \"Interactive Coding Exercises\",\n        \"Project-Based Learning\",\n        \"Peer Code Review\",\n        \"Mentorship Program\",\n        \"Job Placement Assistance\"\n    ],\n    \"user_types\": [\n        \"Software Developers\",\n        \"Data Scientists\",\n        \"IT Professionals\"\n    ],\n    \"subscription_model\": \"Paid - Tiered\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Advanced Python Programming\",\n            \"level\": \"Intermediate/Advanced\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Beginner/Intermediate\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for upskilling! The community is very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great courses and supportive instructors.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecraftpro.com\"\n}"}
