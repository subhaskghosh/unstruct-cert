{"_id": "Academic--digital_learning--p--70266", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lessons\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"123\",\n            \"rating\": 5,\n            \"comment\": \"DataCamp is an excellent platform for learning data science. The interactive exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"456\",\n            \"rating\": 4,\n            \"comment\": \"A really innovative approach to learning, I've upskilled so quickly!\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
