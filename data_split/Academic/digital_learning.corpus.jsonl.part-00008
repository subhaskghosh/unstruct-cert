{"_id": "Academic--digital_learning--n--70231", "text": "{\n    \"platform_name\": \"Codecademy\",\n    \"developer\": \"Codecademy\",\n    \"features\": [\n        \"Interactive coding tutorials\",\n        \"Project-based learning\",\n        \"Career paths\",\n        \"Quizzes\"\n    ],\n    \"user_types\": [\n        \"Beginners\",\n        \"Students\",\n        \"Developers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Learn Python 3\",\n            \"level\": \"Beginner\",\n            \"duration\": \"30 hours\"\n        },\n        {\n            \"course_name\": \"Data Science\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"40 hours\"\n        }\n    ],\n    \"launch_date\": \"2011-08-24\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"456\",\n            \"rating\": 4,\n            \"comment\": \"Good for learning basic programming concepts.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com\"\n}"}
{"_id": "Academic--digital_learning--p--70232", "text": "{\n    \"platform_name\": \"DataLearn Pro\",\n    \"developer\": \"InnovateEd Technologies\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Community forum\",\n        \"Personalized learning paths\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Data Science\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-05-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice Johnson\",\n            \"rating\": 5,\n            \"comment\": \"Very user-friendly interface and excellent content!\"\n        },\n        {\n            \"user\": \"Bob Smith\",\n            \"rating\": 4,\n            \"comment\": \"Great platform for learning data science.\"\n        }\n    ],\n    \"access_url\": \"https://www.datalearnpro.com\"\n}"}
{"_id": "Academic--digital_learning--n--70232", "text": "{\n    \"platform_name\": \"CodeMaster Academy\",\n    \"developer\": \"TechSolutions Inc.\",\n    \"features\": [\n        \"Live coding sessions\",\n        \"Advanced algorithm tutorials\",\n        \"Competitive programming challenges\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Experienced Developers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Advanced Python Programming\",\n            \"level\": \"Expert\",\n            \"duration\": \"16 weeks\"\n        },\n        {\n            \"course_name\": \"Data Structures and Algorithms\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"10 weeks\"\n        }\n    ],\n    \"launch_date\": \"2022-03-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Charlie Brown\",\n            \"rating\": 3,\n            \"comment\": \"Challenging content, but the interface could be more intuitive.\"\n        },\n        {\n            \"user\": \"Diana Davis\",\n            \"rating\": 5,\n            \"comment\": \"Excellent resource for advanced programmers.\"\n        }\n    ],\n    \"access_url\": \"https://www.codemasteracademy.net\"\n}"}
