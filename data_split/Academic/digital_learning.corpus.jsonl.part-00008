{"_id": "Academic--digital_learning--p--71011", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill tracks\",\n        \"Project-based learning\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Data scientists\",\n        \"Analysts\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"title\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"title\": \"Data Manipulation with Pandas\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"3 weeks\"\n        },\n        {\n            \"title\": \"Machine Learning with scikit-learn\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"5 weeks\"\n        },\n        {\n            \"title\": \"Data Visualization with ggplot2\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"title\": \"Statistical Inference\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"3 weeks\"\n        },\n        {\n            \"title\": \"Deep Learning with TensorFlow\",\n            \"level\": \"Advanced\",\n            \"duration\": \"6 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-03-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science skills!\"\n        },\n        {\n            \"user\": \"Bob\",\n            \"rating\": 4,\n            \"comment\": \"Very practical and hands-on.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--71011", "text": "{\n    \"platform_name\": \"TheoryHub\",\n    \"developer\": \"Academia Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Reading materials\",\n        \"Quizzes\",\n        \"Discussion forums\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Researchers\",\n        \"Academics\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"title\": \"Mathematical Foundations of Machine Learning\",\n            \"level\": \"Advanced\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"title\": \"Advanced Statistical Theory\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"title\": \"Probabilistic Modeling\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        }\n    ],\n    \"launch_date\": \"2022-05-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Charlie\",\n            \"rating\": 3,\n            \"comment\": \"Good for theoretical understanding, but lacks practical application.\"\n        },\n        {\n            \"user\": \"David\",\n            \"rating\": 2,\n            \"comment\": \"Too abstract and difficult to apply to real-world problems.\"\n        }\n    ],\n    \"access_url\": \"https://www.theoryhub.edu/\"\n}"}
