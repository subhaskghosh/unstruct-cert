{"_id": "Academic--digital_learning--n--71980", "text": "{\n    \"platform_name\": \"Khan Academy\",\n    \"developer\": \"Khan Academy\",\n    \"features\": [\n        \"Video lectures\",\n        \"Practice exercises\",\n        \"Personalized learning\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"K-12 Students\",\n        \"Teachers\",\n        \"Parents\"\n    ],\n    \"subscription_model\": \"Free\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Algebra I\",\n            \"level\": \"Beginner\",\n            \"topic\": \"Mathematics\"\n        },\n        {\n            \"course_name\": \"Calculus AB\",\n            \"level\": \"Intermediate\",\n            \"topic\": \"Mathematics\"\n        },\n        {\n            \"course_name\": \"AP Statistics\",\n            \"level\": \"Advanced\",\n            \"topic\": \"Statistics\"\n        }\n    ],\n    \"launch_date\": \"2008-09-16\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"student789\",\n            \"rating\": 4.8,\n            \"comment\": \"Excellent resource for learning math.\"\n        },\n        {\n            \"user_id\": \"teacher012\",\n            \"rating\": 4.6,\n            \"comment\": \"Very helpful for classroom instruction.\"\n        }\n    ],\n    \"access_url\": \"https://www.khanacademy.org\"\n}"}
{"_id": "Academic--digital_learning--p--71981", "text": "{\n    \"platform_name\": \"Codecademy Pro\",\n    \"developer\": \"Codecademy\",\n    \"features\": [\n        \"Interactive coding lessons\",\n        \"Project-based learning\",\n        \"Real-world projects\",\n        \"Skill paths\",\n        \"Code editor\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Self-learners\"\n    ],\n    \"subscription_model\": \"Freemium with paid Pro subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Learn Python 3\",\n            \"difficulty\": \"Beginner\",\n            \"duration\": \"30 hours\"\n        },\n        {\n            \"course_name\": \"Web Development Fundamentals\",\n            \"difficulty\": \"Intermediate\",\n            \"duration\": \"50 hours\"\n        }\n    ],\n    \"launch_date\": \"2011-08-25\",\n    \"user_feedback\": [\n        {\n            \"user\": \"JohnDoe\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning to code! Very interactive and helpful.\"\n        },\n        {\n            \"user\": \"JaneSmith\",\n            \"rating\": 4,\n            \"comment\": \"Good resources and well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecademy.com/\"\n}"}
{"_id": "Academic--digital_learning--n--71981", "text": "{\n    \"platform_name\": \"Starfall\",\n    \"developer\": \"Starfall Education Foundation\",\n    \"features\": [\n        \"Phonics games\",\n        \"Reading activities\",\n        \"Math games\",\n        \"Animated videos\"\n    ],\n    \"user_types\": [\n        \"Preschoolers\",\n        \"Kindergarteners\",\n        \"Early learners\"\n    ],\n    \"subscription_model\": \"Freemium with paid membership\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"ABC's\",\n            \"difficulty\": \"Beginner\",\n            \"duration\": \"Ongoing\"\n        },\n        {\n            \"course_name\": \"Learn to Read\",\n            \"difficulty\": \"Beginner\",\n            \"duration\": \"Ongoing\"\n        }\n    ],\n    \"launch_date\": \"2002-01-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Parent123\",\n            \"rating\": 4,\n            \"comment\": \"My child loves playing these games and is learning to read!\"\n        },\n        {\n            \"user\": \"Teacher456\",\n            \"rating\": 5,\n            \"comment\": \"Excellent resource for early literacy.\"\n        }\n    ],\n    \"access_url\": \"https://www.starfall.com/\"\n}"}
{"_id": "Academic--digital_learning--p--71982", "text": "{\n    \"platform_name\": \"SkillForge\",\n    \"developer\": \"InnovateEd Solutions\",\n    \"features\": [\n        \"Interactive Video Lessons\",\n        \"Personalized Learning Paths\",\n        \"Project-Based Assignments\",\n        \"Peer Collaboration Forums\",\n        \"Skill Assessments\",\n        \"Progress Tracking\",\n        \"Career Counseling Resources\"\n    ],\n    \"user_types\": [\n        \"Professionals\",\n        \"Students\",\n        \"Career Changers\"\n    ],\n    \"subscription_model\": \"Tiered Subscription (Basic, Premium, Pro)\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Science Bootcamp\",\n            \"level\": \"Intermediate/Advanced\",\n            \"duration\": \"12 weeks\",\n            \"price\": 999\n        },\n        {\n            \"course_name\": \"Project Management Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"6 weeks\",\n            \"price\": 499\n        },\n        {\n            \"course_name\": \"Digital Marketing Mastery\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\",\n            \"price\": 799\n        }\n    ],\n    \"launch_date\": \"2021-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"SkillForge's Data Science Bootcamp significantly improved my analytical skills and helped me land a new job!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"The project-based learning approach is excellent. I've gained practical skills I can immediately apply to my work.\"\n        }\n    ],\n    \"access_url\": \"https://www.skillforge.com\"\n}"}
{"_id": "Academic--digital_learning--n--71982", "text": "{\n    \"platform_name\": \"EduSpark\",\n    \"developer\": \"Global Learning Inc.\",\n    \"features\": [\n        \"Pre-recorded Video Lectures\",\n        \"Downloadable Resources\",\n        \"Quizzes\",\n        \"Basic Discussion Forums\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Lifelong Learners\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to History\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\",\n            \"price\": 0\n        },\n        {\n            \"course_name\": \"Basic Algebra\",\n            \"level\": \"Beginner\",\n            \"duration\": \"5 weeks\",\n            \"price\": 0\n        },\n        {\n            \"course_name\": \"World Geography\",\n            \"level\": \"Beginner\",\n            \"duration\": \"6 weeks\",\n            \"price\": 0\n        }\n    ],\n    \"launch_date\": \"2022-03-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Good introductory courses, but not very in-depth.\"\n        },\n        {\n            \"user_id\": \"user101\",\n            \"rating\": 2,\n            \"comment\": \"The free content is okay, but it doesn't provide enough support for serious learning.\"\n        }\n    ],\n    \"access_url\": \"https://www.eduspark.org\"\n}"}
