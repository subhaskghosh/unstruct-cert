{"_id": "Academic--digital_learning--n--71938", "text": "{\n    \"platform_name\": \"CodeCrafters\",\n    \"developer\": \"DevSkills Ltd.\",\n    \"features\": [\n        \"Code editor\",\n        \"Debugging tools\",\n        \"Interactive tutorials\",\n        \"Code challenges\",\n        \"Version control integration\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Developers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Python for Data Science\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"JavaScript Frameworks\",\n            \"level\": \"Advanced\",\n            \"duration\": \"10 weeks\"\n        }\n    ],\n    \"launch_date\": \"2022-03-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 4,\n            \"comment\": \"A fantastic resource for learning to code.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 5,\n            \"comment\": \"The challenges really helped me solidify my understanding.\"\n        }\n    ],\n    \"access_url\": \"https://www.codecrafters.io\"\n}"}
