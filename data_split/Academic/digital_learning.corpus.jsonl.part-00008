{"_id": "Academic--digital_learning--n--70164", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Peer assessments\",\n        \"Quizzes\",\n        \"Assignments\",\n        \"Certificates\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Lifelong learners\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Supervised learning\",\n                \"Unsupervised learning\"\n            ]\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"level\": \"Advanced\",\n            \"topics\": [\n                \"Neural Networks\",\n                \"Convolutional Neural Networks\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2012-04-18\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Charlie\",\n            \"rating\": 4,\n            \"comment\": \"Excellent content, but the platform can be a bit complex.\"\n        },\n        {\n            \"user\": \"David\",\n            \"rating\": 5,\n            \"comment\": \"High-quality courses from top universities.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org\"\n}"}
{"_id": "Academic--digital_learning--p--70165", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill tracks\",\n        \"Project-based learning\",\n        \"Certification paths\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Advanced\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science skills!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"The interactive exercises are very helpful.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70165", "text": "{\n    \"platform_name\": \"LearnNow\",\n    \"developer\": \"EdTech Solutions\",\n    \"features\": [\n        \"Pre-recorded video lectures\",\n        \"Downloadable course materials\",\n        \"Quizzes\",\n        \"Discussion forums\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\",\n        \"Lifelong Learners\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Basic Statistics\",\n            \"level\": \"Beginner\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Web Development Fundamentals\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"Introduction to AI\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        }\n    ],\n    \"launch_date\": \"2018-07-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"The course materials are good, but the platform is a bit outdated.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"The discussion forums are not very active.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnnow.org\"\n}"}
