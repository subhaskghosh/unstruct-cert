{"_id": "Academic--digital_learning--p--70095", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp, Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Students\",\n        \"Researchers\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Python Syntax\",\n                \"Data Types\",\n                \"Control Flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Data Manipulation\",\n                \"Statistical Analysis\",\n                \"Data Visualization\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Supervised Learning\",\n                \"Unsupervised Learning\",\n                \"Model Evaluation\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"John Doe\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for learning data science. Very interactive and beginner-friendly.\"\n        },\n        {\n            \"user\": \"Jane Smith\",\n            \"rating\": 4,\n            \"comment\": \"Good resource, but some courses could be more in-depth.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--70095", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Assignments\",\n        \"Peer-graded assessments\",\n        \"Specializations\",\n        \"Degree programs\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Lifelong learners\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Machine Learning by Andrew Ng\",\n            \"difficulty\": \"Intermediate\",\n            \"topics\": [\n                \"Linear Regression\",\n                \"Logistic Regression\",\n                \"Neural Networks\"\n            ]\n        },\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"difficulty\": \"Advanced\",\n            \"topics\": [\n                \"Convolutional Neural Networks\",\n                \"Recurrent Neural Networks\",\n                \"Sequence Models\"\n            ]\n        },\n        {\n            \"course_name\": \"Financial Markets\",\n            \"difficulty\": \"Beginner\",\n            \"topics\": [\n                \"Stock Valuation\",\n                \"Risk Management\",\n                \"Portfolio Optimization\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2012-03-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice Brown\",\n            \"rating\": 4,\n            \"comment\": \"High-quality courses from top universities.\"\n        },\n        {\n            \"user\": \"Bob Williams\",\n            \"rating\": 3,\n            \"comment\": \"Can be expensive, but worth it for the credentials.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org/\"\n}"}
