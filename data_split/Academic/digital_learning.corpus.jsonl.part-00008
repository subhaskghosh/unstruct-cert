{"_id": "Academic--digital_learning--p--70437", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill tracks\",\n        \"Project-based learning\",\n        \"Community forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"level\": \"Advanced\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science! Very interactive and practical.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great courses and a supportive community.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70437", "text": "{\n    \"platform_name\": \"LearnCloud\",\n    \"developer\": \"EduTech Solutions Inc.\",\n    \"features\": [\n        \"Pre-recorded video lectures\",\n        \"Downloadable course materials\",\n        \"Quizzes\",\n        \"Certificate of completion\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Researchers\"\n    ],\n    \"subscription_model\": \"Paid subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Data Analytics Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"5 weeks\"\n        },\n        {\n            \"course_name\": \"Advanced Statistical Modeling\",\n            \"level\": \"Advanced\",\n            \"duration\": \"10 weeks\"\n        }\n    ],\n    \"launch_date\": \"2019-12-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Content is okay, but the platform feels outdated.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"Poor user interface and limited support.\"\n        }\n    ],\n    \"access_url\": \"https://www.learncloud.edu\"\n}"}
