{"_id": "Academic--digital_learning--n--70614", "text": "{\n    \"platform_name\": \"LearnMath\",\n    \"developer\": \"SmallTech Solutions\",\n    \"features\": [\n        \"Video tutorials\",\n        \"Practice problems\",\n        \"Quizzes\",\n        \"Progress tracking\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Calculus I\",\n            \"level\": \"Beginner\",\n            \"topic\": \"Mathematics\",\n            \"rating\": 4.2\n        },\n        {\n            \"course_name\": \"Linear Algebra\",\n            \"level\": \"Intermediate\",\n            \"topic\": \"Mathematics\",\n            \"rating\": 4.0\n        }\n    ],\n    \"launch_date\": \"2022-05-10\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice Brown\",\n            \"comment\": \"Good platform for math practice, but a bit dry.\",\n            \"rating\": 3\n        },\n        {\n            \"user\": \"Bob Green\",\n            \"comment\": \"Decent course materials, but could be more interactive.\",\n            \"rating\": 3\n        }\n    ],\n    \"access_url\": \"https://www.learnmath.org\"\n}"}
{"_id": "Academic--digital_learning--p--70615", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill tracks\",\n        \"Career tracks\",\n        \"Project portfolio\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Analysts\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscription levels\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"subject\": \"Data Science\",\n            \"level\": \"Beginner\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"subject\": \"Machine Learning\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2016-03-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice\",\n            \"rating\": 4,\n            \"comment\": \"Great for beginners! Very hands-on.\"\n        },\n        {\n            \"user\": \"Bob\",\n            \"rating\": 5,\n            \"comment\": \"Excellent resource for learning data science skills.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--70615", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Peer assessments\",\n        \"Assignments\",\n        \"Specializations\",\n        \"Degrees\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\",\n        \"Lifelong Learners\"\n    ],\n    \"subscription_model\": \"Paid subscription levels\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Deep Learning Specialization\",\n            \"subject\": \"Machine Learning\",\n            \"level\": \"Advanced\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"subject\": \"Data Science\",\n            \"level\": \"Intermediate\"\n        }\n    ],\n    \"launch_date\": \"2012-05-10\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Charlie\",\n            \"rating\": 3,\n            \"comment\": \"Good content, but can be quite challenging.\"\n        },\n        {\n            \"user\": \"David\",\n            \"rating\": 4,\n            \"comment\": \"Useful for professional development.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org/\"\n}"}
{"_id": "Academic--digital_learning--p--70616", "text": "{\n    \"platform_name\": \"DataLearn Pro\",\n    \"developer\": \"InnovateEd Tech\",\n    \"features\": [\n        \"Interactive Coding Exercises\",\n        \"Video Lectures\",\n        \"Personalized Learning Paths\",\n        \"Project-Based Learning\",\n        \"Community Forum\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Data Science\",\n            \"level\": \"Beginner\",\n            \"duration\": \"12 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"16 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-05-10\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for self-paced learning! The exercises are very helpful.\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great resources and a supportive community.\"\n        }\n    ],\n    \"access_url\": \"https://www.datalearnpro.com\"\n}"}
{"_id": "Academic--digital_learning--n--70616", "text": "{\n    \"platform_name\": \"EduTech Hub\",\n    \"developer\": \"Global Learning Solutions\",\n    \"features\": [\n        \"Live Classes\",\n        \"Quizzes\",\n        \"Assignment Submission\",\n        \"Gradebook\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Teachers\"\n    ],\n    \"subscription_model\": \"Paid - Tiered\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Advanced Calculus\",\n            \"level\": \"Advanced\",\n            \"duration\": \"18 weeks\"\n        },\n        {\n            \"course_name\": \"Organic Chemistry\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"14 weeks\"\n        }\n    ],\n    \"launch_date\": \"2022-03-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Good for traditional classroom style learning.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"Not very flexible for independent study.\"\n        }\n    ],\n    \"access_url\": \"https://www.edutechhub.org\"\n}"}
{"_id": "Academic--digital_learning--p--70617", "text": "{\n    \"platform_name\": \"DataLearn Pro\",\n    \"developer\": \"InnovateEd Tech\",\n    \"features\": [\n        \"Interactive Coding Exercises\",\n        \"Video Lectures\",\n        \"Community Forums\",\n        \"Project-Based Learning\",\n        \"Personalized Learning Paths\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Data Scientists\"\n    ],\n    \"subscription_model\": \"Freemium with Premium tiers\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Data Science with Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning Fundamentals\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2021-05-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science! Very engaging and well-structured.\"\n        },\n        {\n            \"user\": \"Bob\",\n            \"rating\": 4,\n            \"comment\": \"Great resource, especially the hands-on projects.\"\n        }\n    ],\n    \"access_url\": \"https://www.datalearnpro.com\"\n}"}
{"_id": "Academic--digital_learning--n--70617", "text": "{\n    \"platform_name\": \"EduWorld\",\n    \"developer\": \"Global Learning Solutions\",\n    \"features\": [\n        \"Live Classes\",\n        \"Study Materials\",\n        \"Exam Preparation Tools\",\n        \"Teacher Collaboration Features\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"School Administrators\"\n    ],\n    \"subscription_model\": \"Paid Subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"AP Calculus\",\n            \"level\": \"High School\",\n            \"duration\": \"1 semester\"\n        },\n        {\n            \"course_name\": \"Data Analytics for Beginners\",\n            \"level\": \"Beginner\",\n            \"duration\": \"6 weeks\"\n        }\n    ],\n    \"launch_date\": \"2022-03-10\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Charlie\",\n            \"rating\": 3,\n            \"comment\": \"Decent platform, but the interface is a bit clunky.\"\n        },\n        {\n            \"user\": \"David\",\n            \"rating\": 2,\n            \"comment\": \"Customer support is slow to respond.\"\n        }\n    ],\n    \"access_url\": \"https://www.eduworld.org\",\n    \"subscription_cost_monthly\": 80\n}"}
{"_id": "Academic--digital_learning--p--70618", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp, Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"8 weeks\"\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-01-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science skills. The interactive exercises are very helpful.\"\n        },\n        {\n            \"user\": \"Bob\",\n            \"rating\": 4,\n            \"comment\": \"Good content, well-structured courses.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70618", "text": "{\n    \"platform_name\": \"LearnWorlds\",\n    \"developer\": \"LearnWorlds Inc.\",\n    \"features\": [\n        \"Course creation tools\",\n        \"Interactive video\",\n        \"Assessment features\",\n        \"Community features\"\n    ],\n    \"user_types\": [\n        \"Instructors\",\n        \"Educators\",\n        \"Businesses\"\n    ],\n    \"subscription_model\": \"Paid Plans\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Digital Marketing Fundamentals\",\n            \"level\": \"Beginner\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Web Development Bootcamp\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"10 weeks\"\n        }\n    ],\n    \"launch_date\": \"2014-05-20\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Charlie\",\n            \"rating\": 3,\n            \"comment\": \"Decent platform for creating and selling courses, but can be buggy at times.\"\n        },\n        {\n            \"user\": \"David\",\n            \"rating\": 2,\n            \"comment\": \"Customer support is slow to respond.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnworlds.com\"\n}"}
{"_id": "Academic--digital_learning--p--70619", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp Inc.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Skill tracks\",\n        \"Project-based learning\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Python Syntax\",\n                \"Data Structures\",\n                \"Control Flow\"\n            ]\n        },\n        {\n            \"course_name\": \"Machine Learning with R\",\n            \"level\": \"Intermediate\",\n            \"topics\": [\n                \"Regression\",\n                \"Classification\",\n                \"Clustering\"\n            ]\n        },\n        {\n            \"course_name\": \"Data Science Specialization\",\n            \"level\": \"Advanced\",\n            \"topics\": [\n                \"Statistical Inference\",\n                \"Data Visualization\",\n                \"Big Data\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2016-02-01\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user123\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science!\"\n        },\n        {\n            \"user_id\": \"user456\",\n            \"rating\": 4,\n            \"comment\": \"Great interactive exercises.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--70619", "text": "{\n    \"platform_name\": \"LearnNow\",\n    \"developer\": \"EdTech Solutions\",\n    \"features\": [\n        \"Pre-recorded video lectures\",\n        \"Downloadable resources\",\n        \"Quizzes\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Professionals\"\n    ],\n    \"subscription_model\": \"Paid\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Data Analysis\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"Excel\",\n                \"Data Cleaning\",\n                \"Basic Statistics\"\n            ]\n        },\n        {\n            \"course_name\": \"Web Development Fundamentals\",\n            \"level\": \"Beginner\",\n            \"topics\": [\n                \"HTML\",\n                \"CSS\",\n                \"JavaScript\"\n            ]\n        }\n    ],\n    \"launch_date\": \"2021-05-15\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Decent content, but a bit expensive.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 2,\n            \"comment\": \"The quizzes are not very challenging.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnnow.org\"\n}"}
{"_id": "Academic--digital_learning--p--70620", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video lectures\",\n        \"Project-based learning\",\n        \"Skill assessments\",\n        \"Career tracks\"\n    ],\n    \"user_types\": [\n        \"Data Scientists\",\n        \"Data Analysts\",\n        \"Engineers\",\n        \"Students\"\n    ],\n    \"subscription_model\": \"Freemium with paid subscriptions\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"level\": \"Beginner\",\n            \"duration\": \"4 weeks\"\n        },\n        {\n            \"course_name\": \"Machine Learning Scientist with Python\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"12 months\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"level\": \"Beginner\",\n            \"duration\": \"8 weeks\"\n        }\n    ],\n    \"launch_date\": \"2016-02-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice\",\n            \"rating\": 5,\n            \"comment\": \"Great platform for hands-on learning!\"\n        },\n        {\n            \"user\": \"Bob\",\n            \"rating\": 4,\n            \"comment\": \"Excellent course structure and content.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com/\"\n}"}
{"_id": "Academic--digital_learning--n--70620", "text": "{\n    \"platform_name\": \"Coursera\",\n    \"developer\": \"Coursera Inc.\",\n    \"features\": [\n        \"Video lectures\",\n        \"Assignments\",\n        \"Peer assessment\",\n        \"Quizzes\",\n        \"Discussion forums\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Educators\",\n        \"Lifelong learners\"\n    ],\n    \"subscription_model\": \"Freemium with paid courses and specializations\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Calculus 1\",\n            \"level\": \"Beginner\",\n            \"duration\": \"10 weeks\"\n        },\n        {\n            \"course_name\": \"Introduction to Philosophy\",\n            \"level\": \"Beginner\",\n            \"duration\": \"6 weeks\"\n        },\n        {\n            \"course_name\": \"Organic Chemistry\",\n            \"level\": \"Intermediate\",\n            \"duration\": \"15 weeks\"\n        }\n    ],\n    \"launch_date\": \"2012-05-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Charlie\",\n            \"rating\": 4,\n            \"comment\": \"Good academic courses, but can be a bit theoretical.\"\n        },\n        {\n            \"user\": \"David\",\n            \"rating\": 3,\n            \"comment\": \"Assignments are challenging.\"\n        }\n    ],\n    \"access_url\": \"https://www.coursera.org/\"\n}"}
