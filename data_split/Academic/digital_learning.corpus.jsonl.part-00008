{"_id": "Academic--digital_learning--n--71203", "text": "{\n    \"platform_name\": \"LearnIT\",\n    \"developer\": \"GlobalTech Solutions\",\n    \"features\": [\n        \"Live webinars\",\n        \"Downloadable resources\",\n        \"Expert Q&A sessions\",\n        \"Certification programs\"\n    ],\n    \"user_types\": [\n        \"Professionals\",\n        \"IT Managers\"\n    ],\n    \"subscription_model\": \"Enterprise-level subscription only\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Advanced Cybersecurity\",\n            \"course_level\": \"Expert\",\n            \"course_duration\": \"16 weeks\"\n        },\n        {\n            \"course_name\": \"Cloud Computing Architectures\",\n            \"course_level\": \"Advanced\",\n            \"course_duration\": \"12 weeks\"\n        }\n    ],\n    \"launch_date\": \"2022-05-20\",\n    \"user_feedback\": [\n        {\n            \"user_id\": \"user789\",\n            \"rating\": 3,\n            \"comment\": \"Useful content, but expensive for individual use.\"\n        },\n        {\n            \"user_id\": \"user012\",\n            \"rating\": 4,\n            \"comment\": \"Good for team training, but not accessible to individuals.\"\n        }\n    ],\n    \"access_url\": \"https://www.learnit.com/\"\n}"}
{"_id": "Academic--digital_learning--p--71204", "text": "{\n    \"platform_name\": \"DataCamp\",\n    \"developer\": \"DataCamp B.V.\",\n    \"features\": [\n        \"Interactive coding exercises\",\n        \"Video tutorials\",\n        \"Skill assessments\",\n        \"Career tracks\",\n        \"Real-world projects\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Data Scientists\",\n        \"Educators\"\n    ],\n    \"subscription_model\": \"Freemium with paid tiers\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Introduction to Python\",\n            \"difficulty\": \"Beginner\",\n            \"topic\": \"Programming\"\n        },\n        {\n            \"course_name\": \"Data Science with R\",\n            \"difficulty\": \"Intermediate\",\n            \"topic\": \"Data Science\"\n        },\n        {\n            \"course_name\": \"Machine Learning with Python\",\n            \"difficulty\": \"Advanced\",\n            \"topic\": \"Machine Learning\"\n        }\n    ],\n    \"launch_date\": \"2016-02-01\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Alice\",\n            \"rating\": 5,\n            \"comment\": \"Excellent platform for learning data science! Very interactive and practical.\"\n        },\n        {\n            \"user\": \"Bob\",\n            \"rating\": 4,\n            \"comment\": \"Good content, but some courses could be more up-to-date.\"\n        }\n    ],\n    \"access_url\": \"https://www.datacamp.com\"\n}"}
{"_id": "Academic--digital_learning--n--71204", "text": "{\n    \"platform_name\": \"LearnChemE\",\n    \"developer\": \"University of Colorado Boulder\",\n    \"features\": [\n        \"Interactive simulations\",\n        \"Video lectures\",\n        \"Problem sets\",\n        \"Module quizzes\"\n    ],\n    \"user_types\": [\n        \"Students\",\n        \"Chemical Engineering Educators\"\n    ],\n    \"subscription_model\": \"Paid subscription\",\n    \"courses_available\": [\n        {\n            \"course_name\": \"Chemical Engineering Thermodynamics\",\n            \"difficulty\": \"Intermediate\",\n            \"topic\": \"Chemical Engineering\"\n        },\n        {\n            \"course_name\": \"Fluid Mechanics\",\n            \"difficulty\": \"Advanced\",\n            \"topic\": \"Chemical Engineering\"\n        }\n    ],\n    \"launch_date\": \"2018-09-15\",\n    \"user_feedback\": [\n        {\n            \"user\": \"Carol\",\n            \"rating\": 4,\n            \"comment\": \"Very helpful for understanding complex concepts in chemical engineering.\"\n        },\n        {\n            \"user\": \"David\",\n            \"rating\": 3,\n            \"comment\": \"Could use more examples and practice problems.\"\n        }\n    ],\n    \"access_url\": \"https://learncheme.com\"\n}"}
