{"_id": "Academic--journal_articles--n--67043", "text": "{\n    \"title\": \"A Deep Learning Approach to Image Classification with Convolutional Neural Networks\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of Oxford, UK\"\n        }\n    ],\n    \"publication_date\": \"2022-11-20\",\n    \"journal_name\": \"IEEE Transactions on Image Processing\",\n    \"volume\": 31,\n    \"issue\": 12,\n    \"pages\": \"4567-4578\",\n    \"doi\": \"10.1109/TIP.2022.3234567\",\n    \"keywords\": [\n        \"image classification\",\n        \"convolutional neural networks\",\n        \"deep learning\",\n        \"image recognition\"\n    ],\n    \"abstract\": \"We propose a new convolutional neural network architecture for improving image classification accuracy on benchmark datasets.\",\n    \"references\": []\n}"}
{"_id": "Academic--journal_articles--p--67044", "text": "{\n    \"title\": \"Machine Learning-Driven Diagnosis of Diabetic Retinopathy from Fundus Images\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI Healthcare\"\n        }\n    ],\n    \"publication_date\": \"2024-03-15\",\n    \"journal_name\": \"Journal of Biomedical Informatics\",\n    \"volume\": 12,\n    \"issue\": 2,\n    \"pages\": \"250-265\",\n    \"doi\": \"10.1016/j.jbi.2024.104250\",\n    \"keywords\": [\n        \"machine learning\",\n        \"diabetic retinopathy\",\n        \"fundus images\",\n        \"diagnosis\",\n        \"healthcare\"\n    ],\n    \"abstract\": \"This paper presents a novel machine learning approach for the automated diagnosis of diabetic retinopathy using fundus images. The proposed system achieves state-of-the-art performance and demonstrates the potential for improved patient care.\",\n    \"references\": []\n}"}
{"_id": "Academic--journal_articles--n--67044", "text": "{\n    \"title\": \"A Review of Machine Learning Applications in Healthcare\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"publication_date\": \"2023-11-01\",\n    \"journal_name\": \"Healthcare Technology Letters\",\n    \"volume\": 8,\n    \"issue\": 5,\n    \"pages\": \"120-135\",\n    \"doi\": \"10.1049/htl.2023.0123\",\n    \"keywords\": [\n        \"machine learning\",\n        \"healthcare\",\n        \"review\",\n        \"artificial intelligence\"\n    ],\n    \"abstract\": \"This article provides a comprehensive overview of the current state of machine learning applications in healthcare. It discusses various techniques and their potential benefits and limitations.\",\n    \"references\": []\n}"}
