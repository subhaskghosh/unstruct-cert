{"_id": "Academic--journal_articles--n--67050", "text": "{\n    \"title\": \"The Role of Genetics in Human Disease\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"publication_date\": \"2022-11-20\",\n    \"journal_name\": \"Nature\",\n    \"volume\": 608,\n    \"issue\": 7923,\n    \"pages\": \"123-135\",\n    \"doi\": \"10.1038/s41586-022-05289-x\",\n    \"keywords\": [\n        \"genetics\",\n        \"disease\",\n        \"human genome\",\n        \"molecular biology\"\n    ],\n    \"abstract\": \"This review examines the latest advances in understanding the genetic basis of human diseases. We discuss the challenges and opportunities for personalized medicine.\",\n    \"references\": []\n}"}
