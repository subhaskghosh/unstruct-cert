{"_id": "Academic--journal_articles--p--67071", "text": "{\n    \"title\": \"Deep Learning for Early Detection of Cardiovascular Disease\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"publication_date\": \"2023-05-15\",\n    \"journal_name\": \"Journal of Biomedical Informatics\",\n    \"volume\": 75,\n    \"issue\": 3,\n    \"pages\": \"101-115\",\n    \"doi\": \"10.1016/j.jbi.2023.104000\",\n    \"keywords\": [\n        \"deep learning\",\n        \"cardiovascular disease\",\n        \"healthcare\",\n        \"machine learning\",\n        \"early detection\"\n    ],\n    \"abstract\": \"This study explores the application of deep learning techniques for the early detection of cardiovascular disease using electronic health records. We demonstrate improved accuracy compared to traditional methods.\",\n    \"references\": [\n        {\n            \"title\": \"Reference Article 1\",\n            \"author\": \"Author A\"\n        },\n        {\n            \"title\": \"Reference Article 2\",\n            \"author\": \"Author B\"\n        },\n        {\n            \"title\": \"Reference Article 3\",\n            \"author\": \"Author C\"\n        },\n        {\n            \"title\": \"Reference Article 4\",\n            \"author\": \"Author D\"\n        },\n        {\n            \"title\": \"Reference Article 5\",\n            \"author\": \"Author E\"\n        },\n        {\n            \"title\": \"Reference Article 6\",\n            \"author\": \"Author F\"\n        }\n    ]\n}"}
{"_id": "Academic--journal_articles--n--67071", "text": "{\n    \"title\": \"Artificial Intelligence in Radiographic Image Analysis\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"publication_date\": \"2022-11-20\",\n    \"journal_name\": \"Radiology: Artificial Intelligence\",\n    \"volume\": 4,\n    \"issue\": 1,\n    \"pages\": \"50-65\",\n    \"doi\": \"10.1148/ryai.220050\",\n    \"keywords\": [\n        \"artificial intelligence\",\n        \"radiology\",\n        \"image analysis\",\n        \"machine learning\"\n    ],\n    \"abstract\": \"This article reviews recent advances in artificial intelligence for analyzing radiographic images. It focuses on applications in detecting lung nodules and other abnormalities.\",\n    \"references\": [\n        {\n            \"title\": \"Reference Article 1\",\n            \"author\": \"Author X\"\n        },\n        {\n            \"title\": \"Reference Article 2\",\n            \"author\": \"Author Y\"\n        }\n    ]\n}"}
{"_id": "Academic--journal_articles--p--67072", "text": "{\n    \"title\": \"Deep Learning for Enhanced Medical Image Analysis\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"publication_date\": \"2023-05-15\",\n    \"journal_name\": \"Nature\",\n    \"volume\": 617,\n    \"issue\": 7942,\n    \"pages\": \"456-465\",\n    \"doi\": \"10.1038/s41586-023-06123-x\",\n    \"keywords\": [\n        \"deep learning\",\n        \"medical imaging\",\n        \"artificial intelligence\",\n        \"image analysis\",\n        \"diagnosis\"\n    ],\n    \"abstract\": \"This article presents a novel deep learning approach for improved medical image analysis, specifically in the detection of cancerous tissues.  The method demonstrates significant improvements in accuracy and efficiency compared to existing techniques, with potential for real-world clinical application.\",\n    \"references\": []\n}"}
{"_id": "Academic--journal_articles--n--67072", "text": "{\n    \"title\": \"Theoretical Foundations of Recurrent Neural Networks\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"publication_date\": \"2022-11-20\",\n    \"journal_name\": \"Nature\",\n    \"volume\": 608,\n    \"issue\": 7924,\n    \"pages\": \"234-245\",\n    \"doi\": \"10.1038/s41586-022-05289-y\",\n    \"keywords\": [\n        \"recurrent neural networks\",\n        \"theoretical computer science\",\n        \"artificial intelligence\",\n        \"mathematical modeling\"\n    ],\n    \"abstract\": \"This paper explores the theoretical underpinnings of recurrent neural networks, focusing on the stability and convergence properties of different architectures. It provides a rigorous mathematical framework for understanding RNN behavior.\",\n    \"references\": []\n}"}
{"_id": "Academic--journal_articles--p--67073", "text": "{\n    \"title\": \"Deep Learning for Early Detection of Diabetic Retinopathy\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI Healthcare\"\n        }\n    ],\n    \"publication_date\": \"2022-05-15\",\n    \"journal_name\": \"Journal of Biomedical Informatics\",\n    \"volume\": 95,\n    \"issue\": 3,\n    \"pages\": \"456-468\",\n    \"doi\": \"10.1016/j.jbi.2022.104023\",\n    \"keywords\": [\n        \"deep learning\",\n        \"diabetic retinopathy\",\n        \"healthcare\",\n        \"image analysis\"\n    ],\n    \"abstract\": \"This study investigates the application of deep learning techniques for the early detection of diabetic retinopathy from retinal fundus images. The proposed model achieves high accuracy and shows promise for clinical translation.\",\n    \"references\": []\n}"}
