{"_id": "Academic--journal_articles--p--70185", "text": "{\n    \"title\": \"Deep Learning for Diabetic Retinopathy Detection\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"publication_date\": \"2023-05-15\",\n    \"journal_name\": \"IEEE Transactions on Medical Imaging\",\n    \"volume\": 12,\n    \"issue\": 3,\n    \"pages\": \"123-135\",\n    \"doi\": \"10.1109/TMI.2023.3278945\",\n    \"keywords\": [\n        \"Deep Learning\",\n        \"Diabetic Retinopathy\",\n        \"Medical Image Analysis\",\n        \"Healthcare\"\n    ],\n    \"abstract\": \"This paper presents a deep learning model for the automated detection of diabetic retinopathy from retinal fundus images.\",\n    \"references\": []\n}"}
