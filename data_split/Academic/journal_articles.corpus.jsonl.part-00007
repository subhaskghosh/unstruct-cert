{"_id": "Academic--journal_articles--p--66809", "text": "{\n    \"title\": \"Deep Learning for Early Detection of Diabetic Retinopathy\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Harvard Medical School\"\n        }\n    ],\n    \"publication_date\": \"2023-05-15\",\n    \"journal_name\": \"Journal of Biomedical Informatics\",\n    \"volume\": 85,\n    \"issue\": 2,\n    \"pages\": \"102-115\",\n    \"doi\": \"10.1016/j.jbi.2023.104152\",\n    \"keywords\": [\n        \"Deep Learning\",\n        \"Diabetic Retinopathy\",\n        \"Image Analysis\",\n        \"Healthcare\",\n        \"Diagnosis\"\n    ],\n    \"abstract\": \"This study explores the application of deep learning techniques for the early detection of diabetic retinopathy from retinal fundus images. Our results demonstrate a significant improvement in diagnostic accuracy compared to traditional methods.\",\n    \"references\": []\n}"}
{"_id": "Academic--journal_articles--n--66809", "text": "{\n    \"title\": \"Machine Learning for Personalized Medicine at Stanford\",\n    \"authors\": [\n        {\n            \"name\": \"Charlie Brown\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"David Davis\",\n            \"affiliation\": \"Stanford University\"\n        }\n    ],\n    \"publication_date\": \"2022-11-20\",\n    \"journal_name\": \"Nature Biotechnology\",\n    \"volume\": 40,\n    \"issue\": 10,\n    \"pages\": \"1500-1508\",\n    \"doi\": \"10.1038/s41587-022-01625-x\",\n    \"keywords\": [\n        \"Machine Learning\",\n        \"Personalized Medicine\",\n        \"Genomics\",\n        \"Healthcare\"\n    ],\n    \"abstract\": \"We present a machine learning framework for tailoring medical treatments based on individual patient genomics and clinical data. This approach shows promise for improving patient outcomes.\",\n    \"references\": []\n}"}
