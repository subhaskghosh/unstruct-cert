{"_id": "Academic--journal_articles--n--69744", "text": "{\n    \"title\": \"Genetic Factors Influencing Cardiovascular Disease\",\n    \"authors\": [\n        {\n            \"name\": \"Emily Carter\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"David Lee\",\n            \"affiliation\": \"University of California, San Francisco\"\n        }\n    ],\n    \"publication_date\": \"2022-11-01\",\n    \"journal_name\": \"Nature\",\n    \"volume\": 602,\n    \"issue\": 8,\n    \"pages\": \"543-550\",\n    \"doi\": \"10.1038/s41586-022-05345-z\",\n    \"keywords\": [\n        \"genetics\",\n        \"cardiovascular disease\",\n        \"risk factors\",\n        \"genome-wide association study\"\n    ],\n    \"abstract\": \"This research investigates the genetic determinants of cardiovascular disease, identifying novel gene variants associated with increased risk. We conducted a large-scale...\",\n    \"references\": [\n        {\n            \"title\": \"The Genetics of Heart Disease\",\n            \"author\": \"Anderson et al.\"\n        },\n        {\n            \"title\": \"Cardiovascular Risk Prediction\",\n            \"author\": \"Thompson et al.\"\n        },\n        {\n            \"title\": \"Genome-Wide Association Studies in Cardiology\",\n            \"author\": \"Miller et al.\"\n        },\n        {\n            \"title\": \"The Role of Inflammation in Heart Disease\",\n            \"author\": \"Jackson et al.\"\n        },\n        {\n            \"title\": \"Lifestyle Factors and Cardiovascular Health\",\n            \"author\": \"Moore et al.\"\n        },\n        {\n            \"title\": \"New Approaches to Treating Heart Failure\",\n            \"author\": \"Hall et al.\"\n        }\n    ]\n}"}
