{"_id": "Academic--journal_articles--p--66538", "text": "{\n    \"title\": \"Deep Learning for Early Detection of Diabetic Retinopathy\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Google AI Healthcare\"\n        }\n    ],\n    \"publication_date\": \"2024-03-15\",\n    \"journal_name\": \"Journal of Biomedical Informatics\",\n    \"volume\": 105,\n    \"issue\": 2,\n    \"pages\": \"220-235\",\n    \"doi\": \"10.1016/j.jbi.2024.104001\",\n    \"keywords\": [\n        \"deep learning\",\n        \"diabetic retinopathy\",\n        \"image analysis\",\n        \"healthcare\",\n        \"machine learning\"\n    ],\n    \"abstract\": \"This study presents a novel deep learning model for the early detection of diabetic retinopathy from retinal fundus images. Our results demonstrate improved accuracy and efficiency compared to existing methods.\",\n    \"references\": []\n}"}
{"_id": "Academic--journal_articles--n--66538", "text": "{\n    \"title\": \"Traditional Statistical Methods in Healthcare Data Analysis\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"David Miller\",\n            \"affiliation\": \"Kaiser Permanente\"\n        }\n    ],\n    \"publication_date\": \"2023-11-20\",\n    \"journal_name\": \"Health Statistics\",\n    \"volume\": 98,\n    \"issue\": 4,\n    \"pages\": \"350-365\",\n    \"doi\": \"10.1080/08879900.2023.1267890\",\n    \"keywords\": [\n        \"statistical analysis\",\n        \"healthcare data\",\n        \"regression\",\n        \"hypothesis testing\"\n    ],\n    \"abstract\": \"This article provides a comprehensive review of traditional statistical methods used in healthcare data analysis, focusing on their strengths and limitations.\",\n    \"references\": []\n}"}
{"_id": "Academic--journal_articles--p--66539", "text": "{\n    \"title\": \"Transformer-Based Models for Protein Structure Prediction\",\n    \"authors\": [\n        {\n            \"name\": \"Jane Doe\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"John Smith\",\n            \"affiliation\": \"Google AI\"\n        }\n    ],\n    \"publication_date\": \"2024-03-15\",\n    \"journal_name\": \"Science\",\n    \"volume\": 380,\n    \"issue\": 6642,\n    \"pages\": \"256-262\",\n    \"doi\": \"10.1126/science.adj8987\",\n    \"keywords\": [\n        \"machine learning\",\n        \"protein folding\",\n        \"transformers\",\n        \"deep learning\"\n    ],\n    \"abstract\": \"We present a novel approach to protein structure prediction using transformer-based models. Our method achieves state-of-the-art results on the CASP15 benchmark, demonstrating the potential of deep learning for solving this long-standing problem.\",\n    \"references\": [\n        {\n            \"title\": \"Attention is All You Need\",\n            \"authors\": [\n                \"Vaswani et al.\"\n            ]\n        },\n        {\n            \"title\": \"AlphaFold: Protein Structure Prediction with Deep Learning\",\n            \"authors\": [\n                \"Hassabis et al.\"\n            ]\n        },\n        {\n            \"title\": \"A Deep Learning Approach to Protein Structure Prediction\",\n            \"authors\": [\n                \"Senior et al.\"\n            ]\n        },\n        {\n            \"title\": \"RoseTTAFold: Accurate Prediction of Protein Structures and Interactions Using Deep Learning\",\n            \"authors\": [\n                \"Baker et al.\"\n            ]\n        },\n        {\n            \"title\": \"End-to-End Differentiable Protein Structure Prediction\",\n            \"authors\": [\n                \"Ingraham et al.\"\n            ]\n        },\n        {\n            \"title\": \"Improving Protein Structure Prediction with Evolutionary Scales\",\n            \"authors\": [\n                \"Jones et al.\"\n            ]\n        },\n        {\n            \"title\": \"DeepMind's AlphaFold revolutionizes structural biology\",\n            \"authors\": [\n                \"Jumper et al.\"\n            ]\n        }\n    ]\n}"}
{"_id": "Academic--journal_articles--n--66539", "text": "{\n    \"title\": \"A Novel Approach to Sentiment Analysis using Recurrent Neural Networks\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Brown\",\n            \"affiliation\": \"University of California, Berkeley\"\n        },\n        {\n            \"name\": \"Bob White\",\n            \"affiliation\": \"IBM Research\"\n        }\n    ],\n    \"publication_date\": \"2023-11-01\",\n    \"journal_name\": \"Nature\",\n    \"volume\": 625,\n    \"issue\": 7983,\n    \"pages\": \"101-108\",\n    \"doi\": \"10.1038/s41586-023-06789-x\",\n    \"keywords\": [\n        \"sentiment analysis\",\n        \"recurrent neural networks\",\n        \"natural language processing\",\n        \"machine learning\"\n    ],\n    \"abstract\": \"We propose a new method for sentiment analysis based on recurrent neural networks. Our approach achieves competitive results on standard benchmark datasets.\",\n    \"references\": [\n        {\n            \"title\": \"Long Short-Term Memory\",\n            \"authors\": [\n                \"Hochreiter & Schmidhuber\"\n            ]\n        },\n        {\n            \"title\": \"Word Embeddings\",\n            \"authors\": [\n                \"Mikolov et al.\"\n            ]\n        },\n        {\n            \"title\": \"Attention Mechanism\",\n            \"authors\": [\n                \"Bahdanau et al.\"\n            ]\n        }\n    ]\n}"}
{"_id": "Academic--journal_articles--p--66540", "text": "{\n    \"title\": \"Deep Learning for Automated Diagnosis of Pneumonia from Chest X-rays\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Johnson\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Williams\",\n            \"affiliation\": \"Massachusetts Institute of Technology\"\n        }\n    ],\n    \"publication_date\": \"2023-11-15\",\n    \"journal_name\": \"Medical Image Analysis\",\n    \"volume\": 105,\n    \"issue\": 2,\n    \"pages\": \"234-245\",\n    \"doi\": \"10.1016/j.media.2023.11.005\",\n    \"keywords\": [\n        \"deep learning\",\n        \"medical imaging\",\n        \"pneumonia\",\n        \"chest X-rays\",\n        \"diagnosis\"\n    ],\n    \"abstract\": \"This study investigates the use of deep convolutional neural networks for automated diagnosis of pneumonia from chest X-ray images. We present a novel architecture and demonstrate its superior performance compared to existing methods.\",\n    \"references\": [\n        {\n            \"title\": \"Reference Article 1\",\n            \"author\": \"Author A\"\n        },\n        {\n            \"title\": \"Reference Article 2\",\n            \"author\": \"Author B\"\n        },\n        {\n            \"title\": \"Reference Article 3\",\n            \"author\": \"Author C\"\n        },\n        {\n            \"title\": \"Reference Article 4\",\n            \"author\": \"Author D\"\n        },\n        {\n            \"title\": \"Reference Article 5\",\n            \"author\": \"Author E\"\n        },\n        {\n            \"title\": \"Reference Article 6\",\n            \"author\": \"Author F\"\n        },\n        {\n            \"title\": \"Reference Article 7\",\n            \"author\": \"Author G\"\n        },\n        {\n            \"title\": \"Reference Article 8\",\n            \"author\": \"Author H\"\n        },\n        {\n            \"title\": \"Reference Article 9\",\n            \"author\": \"Author I\"\n        },\n        {\n            \"title\": \"Reference Article 10\",\n            \"author\": \"Author J\"\n        },\n        {\n            \"title\": \"Reference Article 11\",\n            \"author\": \"Author K\"\n        }\n    ]\n}"}
{"_id": "Academic--journal_articles--n--66540", "text": "{\n    \"title\": \"Traditional Image Processing Techniques for Detecting Lung Nodules\",\n    \"authors\": [\n        {\n            \"name\": \"Carol Davis\",\n            \"affiliation\": \"University of California, Berkeley\"\n        }\n    ],\n    \"publication_date\": \"2024-05-20\",\n    \"journal_name\": \"Journal of Biomedical Engineering\",\n    \"volume\": 98,\n    \"issue\": 3,\n    \"pages\": \"150-160\",\n    \"doi\": \"10.1109/JBME.2024.3000001\",\n    \"keywords\": [\n        \"image processing\",\n        \"lung nodules\",\n        \"medical imaging\",\n        \"detection\"\n    ],\n    \"abstract\": \"This paper presents a review of traditional image processing techniques used for the detection of lung nodules in CT scans.\",\n    \"references\": [\n        {\n            \"title\": \"Reference Article 1\",\n            \"author\": \"Author A\"\n        },\n        {\n            \"title\": \"Reference Article 2\",\n            \"author\": \"Author B\"\n        },\n        {\n            \"title\": \"Reference Article 3\",\n            \"author\": \"Author C\"\n        },\n        {\n            \"title\": \"Reference Article 4\",\n            \"author\": \"Author D\"\n        },\n        {\n            \"title\": \"Reference Article 5\",\n            \"author\": \"Author E\"\n        }\n    ]\n}"}
