{"_id": "Academic--journal_articles--p--66817", "text": "{\n    \"title\": \"Explainable AI: A Survey of Methods and Applications\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Stanford University\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"publication_date\": \"2022-05-15\",\n    \"journal_name\": \"IEEE Transactions on Pattern Analysis and Machine Intelligence\",\n    \"volume\": 44,\n    \"issue\": 6,\n    \"pages\": \"1234-1245\",\n    \"doi\": \"10.1109/TPAMI.2022.3178923\",\n    \"keywords\": [\n        \"Explainable AI\",\n        \"Interpretability\",\n        \"Machine Learning\",\n        \"Model Understanding\"\n    ],\n    \"abstract\": \"This survey provides a comprehensive overview of recent advances in explainable AI (XAI), focusing on methods for improving the interpretability of machine learning models. We categorize and analyze various XAI techniques, highlighting their strengths and weaknesses.\",\n    \"references\": []\n}"}
