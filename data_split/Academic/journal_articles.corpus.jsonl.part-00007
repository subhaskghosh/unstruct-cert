{"_id": "Academic--journal_articles--p--68589", "text": "{\n    \"title\": \"Deep Learning for Diabetic Retinopathy Detection\",\n    \"authors\": [\n        {\n            \"name\": \"Alice Smith\",\n            \"affiliation\": \"Harvard Medical School\"\n        },\n        {\n            \"name\": \"Bob Johnson\",\n            \"affiliation\": \"MIT\"\n        }\n    ],\n    \"publication_date\": \"2023-11-15\",\n    \"journal_name\": \"Journal of Biomedical Informatics\",\n    \"volume\": 105,\n    \"issue\": 2,\n    \"pages\": \"250-265\",\n    \"doi\": \"10.1016/j.jbi.2023.104000\",\n    \"keywords\": [\n        \"deep learning\",\n        \"machine learning\",\n        \"diabetic retinopathy\",\n        \"healthcare\",\n        \"image analysis\"\n    ],\n    \"abstract\": \"This paper presents a novel deep learning approach for the automated detection of diabetic retinopathy from retinal fundus images. The system achieves high accuracy and demonstrates the potential to improve early diagnosis and treatment of this sight-threatening disease.\",\n    \"references\": []\n}"}
